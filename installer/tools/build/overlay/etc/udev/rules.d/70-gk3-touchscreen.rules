# 内置触摸屏（Himax）的触摸坐标跟随画面旋转，原因见/usr/lib/gaokun3/gk3-touch-matrix。
# 排在60-input-id.rules之后：要用到它设置的ID_INPUT_TOUCHSCREEN。
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TOUCHSCREEN}=="1", ATTRS{name}=="Himax Capacitive TouchScreen", IMPORT{program}="/usr/lib/gaokun3/gk3-touch-matrix"
