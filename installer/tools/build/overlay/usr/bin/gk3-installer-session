#!/bin/sh
# 跑在 cage 里（cage 的唯一客户端）：先设旋转与缩放，再启动图形安装器。
# 由 gk3-installer.service 拉起：cage -s -- /usr/bin/gk3-installer-session
#
# ★ 旋转与缩放只能在这里做：cage 0.2.0 没有旋转参数，但支持输出管理协议，
#   wlr-randr 实测能设模式与缩放（installer/tools/test/test-render.sh）。
#
# 可以在启动项的 cmdline 上改：
#   gk3.rotate=270    输出变换。面板是竖屏、平板横着用，内容要相对面板顺时针转90°（与fbcon=rotate:1一致），
#                     wl_output的变换按协议是逆时针，所以是270。触摸的校准矩阵也按这个参数计算
#                     （/usr/lib/gaokun3/gk3-touch-matrix），两处的默认值必须一致。
#   gk3.scale=2       面板 2560×1600 → 1280×800 逻辑像素（安装器的逻辑画布就是 1280×800）
#   gk3.renderer=skia 关 Impeller（Flutter 3.47.2 在 Linux 默认是 Impeller）
#   gk3.soak=1        进浸泡页，并每 5 秒把 RSS 记到介质上（M0 的"帧率 + RSS 曲线"）
#   gk3.lang=en       界面语言的默认（zh / en，v1.0 计划 GUI-19）。用户在安装器里切过语言就以那次为准：
#                     记在介质上的 gaokun3/installer-lang（只读时在 /run/gk3-installer/lang），见 lib/backend/platform_io.dart
arg() { tr ' ' '\n' < /proc/cmdline | sed -n "s/^$1=//p" | tail -1; }

# 日志优先写回启动介质 —— 这台机器可能既没网也没串口，介质上那份是唯一能事后读到的东西
LOG=/run/gk3-installer/installer.log
if mount -o remount,rw /media/gk3 2>/dev/null; then
    mkdir -p /media/gk3/gaokun3/diag 2>/dev/null && LOG=/media/gk3/gaokun3/diag/installer.log
fi
echo "=== $(date) session start | $(tr '\n' ' ' < /etc/gaokun3-release 2>/dev/null)| $(cat /proc/cmdline)" >> "$LOG"

OUTNAME=$(wlr-randr 2>>"$LOG" | awk 'NR==1{print $1}')
ROT=$(arg gk3.rotate); SCALE=$(arg gk3.scale)
if [ -n "$OUTNAME" ]; then
    wlr-randr --output "$OUTNAME" --transform "${ROT:-270}" --scale "${SCALE:-2}" >>"$LOG" 2>&1 \
        && echo "output ${OUTNAME}: transform ${ROT:-270} scale ${SCALE:-2}" >>"$LOG" \
        || echo "WARNING: wlr-randr could not set the rotation / scale of $OUTNAME" >>"$LOG"
    wlr-randr >>"$LOG" 2>&1
else
    echo "WARNING: wlr-randr lists no outputs" >>"$LOG"
fi

[ "$(arg gk3.renderer)" = skia ] && export GK3_RENDERER=skia
LANG_ARG=$(arg gk3.lang); [ -n "$LANG_ARG" ] && export GK3_LANG="$LANG_ARG"
if [ "$(arg gk3.soak)" = 1 ]; then
    export GK3_SOAK=1
    SOAKLOG=${LOG%/*}/soak-${GK3_RENDERER:-impeller}-$(date +%Y%m%d-%H%M%S).log
    # exec 之后安装器沿用这个 shell 的 pid（$$），所以可以先起监视再 exec
    ( while kill -0 $$ 2>/dev/null; do
          echo "$(date +%s) rss_kib=$(ps -o rss= -p $$ | tr -d ' ') $(grep -h '^SOAK' "$LOG" 2>/dev/null | tail -1)"
          sync; sleep 5
      done ) >> "$SOAKLOG" 2>&1 &
fi
exec /usr/bin/gk3-installer >> "$LOG" 2>&1
