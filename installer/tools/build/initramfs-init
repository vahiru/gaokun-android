#!/bin/sh
# gaokun3 LiveCD initramfs.
#
# 一份 init 同时服务两种介质：
#   * U 盘（LiveCD）：squashfs 就在那个 FAT 分区上
#   * 内置盘（免 U 盘的安装器分区 GK3LIVE）：squashfs 同样在 gaokun3/ 下，读进内存后卸下分区（见下面 gk3.toram）
# 所以【不靠分区标签、不靠 UUID】—— 挨个挂上去找那个文件。
# 配置越少，越不会因为"换了台机器"而失效。
#
# cmdline 参数：
#   gk3.squash=<路径>   squashfs 在介质上的路径（默认 /gaokun3/live.squashfs）
#   gk3.dev=<设备>      跳过搜索，直接用这个块设备
#   gk3.toram=0|1       介质读不读进内存（默认：内置盘读，U 盘不读）
#   gk3.debug           出错时给一个 shell，而不是重启
#
# 读进内存（介质在内置盘上：免 U 盘的安装器分区 GK3LIVE）：gaokun3/ 整个复制进 tmpfs、卸下介质分区，
#   tmpfs 挂到 /media/gk3（路径与 U 盘时相同）。安装器因此可以在清除整个磁盘时保留这个分区、装完把它删掉并入 /data
#   （installer/backend/src/linux/live.h）。内存不够（gaokun3/ 的大小加 2 GiB）或复制失败时照旧直接挂着用。
#   U 盘不读：拔掉 U 盘就是退出，而且读进内存要多花时间。
# 介质记在 /run/gaokun3/medium（gk3l 据此认介质，见 installer/backend/src/linux/lx.h）：
#   part=<分区名> disk=<盘名> start= size=（sysfs 的 512 字节单位） ram=yes|no
#
# ⚠️ 失败时【默认重启】而不是停在 shell：这台机器没有串口，停住就等于要人到
#    机器旁按电源键。重启会回到 systemd-boot 菜单 → 15 秒 → default(Android)，
#    也就是回到一个能远程接入的系统。

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

SQUASH=/gaokun3/live.squashfs
FORCE_DEV=
DEBUG=
TORAM=auto

say()  { echo "[gk3] $*"; }
fail() {
    echo
    echo "============= gaokun3 LiveCD: boot failed ============="
    echo "Reason: $*"
    echo
    echo "Known block devices:"
    ls /sys/class/block 2>/dev/null | tr '\n' ' '; echo
    echo "cmdline: $(cat /proc/cmdline 2>/dev/null)"
    echo "======================================================="
    if [ -n "$DEBUG" ]; then
        echo "gk3.debug is set: starting a shell. The system reboots after exit."
        sh
    else
        echo "Rebooting in 60 seconds (back to the boot menu; add gk3.debug to stop here instead)"
        sleep 60
    fi
    reboot -f
    # reboot -f 万一没生效
    while : ; do sleep 60; done
}

mkdir -p /proc /sys /dev /mnt /lower /upper /newroot /ram /run
mount -t proc     proc     /proc  || fail "mounting /proc failed"
mount -t sysfs    sysfs    /sys   || fail "mounting /sys failed"
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev

for arg in $(cat /proc/cmdline); do
    case "$arg" in
        gk3.squash=*) SQUASH="${arg#gk3.squash=}" ;;
        gk3.dev=*)    FORCE_DEV="${arg#gk3.dev=}" ;;
        gk3.toram=*)  TORAM="${arg#gk3.toram=}" ;;
        gk3.debug)    DEBUG=1 ;;
    esac
done

# devtmpfs 已经把节点建好了；没有的话用 mdev 兜底
[ -e /dev/null ] || /bin/busybox mdev -s

say "looking for $SQUASH"

MEDIA=
try_dev() {
    d=$1
    [ -b "$d" ] || return 1
    mount -o ro "$d" /mnt 2>/dev/null || return 1
    if [ -f "/mnt$SQUASH" ]; then
        say "found on $d"
        MEDIA=$d
        return 0
    fi
    umount /mnt 2>/dev/null
    return 1
}

# ★ "还没出现"和"不存在"是两回事：
#   NVMe 的命名空间是异步 probe 出来的，/init 开始跑的时候块设备未必到齐。
#   原先两条路都只看一眼就下结论 —— Alpine 版 M0 靠扫描找到了 p3，可能只是时序碰巧。
if [ -n "$FORCE_DEV" ]; then
    i=0; while [ ! -b "$FORCE_DEV" ] && [ $i -lt 15 ]; do sleep 1; i=$((i + 1)); done
    [ -b "$FORCE_DEV" ] || fail "gk3.dev=$FORCE_DEV is still not a block device after 15 seconds"
    try_dev "$FORCE_DEV" || fail "$SQUASH not found on gk3.dev=$FORCE_DEV"
else
    # ★ 先试可移动介质（U 盘），再试内置盘。
    #   理由：插着 LiveCD 启动时，用户想要的是【U 盘上那一份】，
    #   而不是内置盘上可能很旧的那一份。
    # 扫一遍没找到就等 2 秒再扫，最多 5 遍（理由见上面强制设备那一支）
    tries=0
    while [ -z "$MEDIA" ] && [ $tries -lt 5 ]; do
        [ $tries -gt 0 ] && { say "not found yet, scanning again in 2 seconds (pass $((tries + 1)))"; sleep 2; }
        for pass in removable fixed; do
            [ -n "$MEDIA" ] && break
            for sysdev in /sys/class/block/*; do
                name=$(basename "$sysdev")
                case "$name" in
                    loop*|ram*|dm-*|zram*) continue ;;
                esac
                # 只看分区（有 partition 属性的），整盘跳过
                [ -f "$sysdev/partition" ] || continue
                parent=$(basename "$(dirname "$(readlink -f "$sysdev")")")
                rm_flag=$(cat "/sys/class/block/$parent/removable" 2>/dev/null || echo 0)
                case "$pass" in
                    removable) [ "$rm_flag" = "1" ] || continue ;;
                    fixed)     [ "$rm_flag" = "1" ] && continue ;;
                esac
                try_dev "/dev/$name" && break
            done
        done
        tries=$((tries + 1))
    done
fi

[ -n "$MEDIA" ] || fail "$SQUASH not found on any partition"

# 介质所在的整块盘；内置盘 = 既不可移动、也不在 USB 上（有的 USB 固态硬盘报 removable=0）
MNAME=${MEDIA#/dev/}
MSYS=$(readlink -f "/sys/class/block/$MNAME")
MDISK=$(basename "$(dirname "$MSYS")")
INTERNAL=1
[ "$(cat "/sys/block/$MDISK/removable" 2>/dev/null || echo 0)" = 1 ] && INTERNAL=0
case "$MSYS" in */usb*) INTERNAL=0 ;; esac
case "$TORAM" in
    1|yes) WANT_RAM=1 ;;
    0|no)  WANT_RAM=0 ;;
    *)     WANT_RAM=$INTERNAL ;;
esac
# 只复制 gaokun3/：squashfs 不在里面就没法读进内存
case "$SQUASH" in /gaokun3/*) ;; *) WANT_RAM=0 ;; esac

RAM=
if [ "$WANT_RAM" = 1 ]; then
    NEED=$(du -sk /mnt/gaokun3 2>/dev/null | cut -f1)
    AVAIL=$(sed -n 's/^MemAvailable: *\([0-9]*\) kB$/\1/p' /proc/meminfo)
    if [ -n "$NEED" ] && [ -n "$AVAIL" ] && [ $((NEED + 2097152)) -le "$AVAIL" ]; then
        say "copying gaokun3/ ($((NEED / 1024)) MiB) into memory"
        # 多留 256 MiB 给之后写进去的日志与分区表备份
        if mount -t tmpfs -o "size=$((NEED + 262144))k,mode=0755" tmpfs /ram && cp -a /mnt/gaokun3 /ram/; then
            RAM=1
        else
            say "warning: copying into memory failed; running from the partition"
            umount /ram 2>/dev/null
        fi
    else
        say "not enough memory to copy gaokun3/ (need $((NEED / 1024)) MiB + 2 GiB, available $((AVAIL / 1024)) MiB); running from the partition"
    fi
fi
if [ -n "$RAM" ]; then
    umount /mnt || fail "unmounting the boot medium after copying it into memory failed"
    mount -o ro,loop "/ram$SQUASH" /lower || fail "mounting the squashfs failed (kernel without CONFIG_SQUASHFS?)"
else
    mount -o ro,loop "/mnt$SQUASH" /lower || fail "mounting the squashfs failed (kernel without CONFIG_SQUASHFS?)"
fi

# 整个系统跑在内存里：改动落在 tmpfs，介质保持只读。
# ⚠️ 这台机器 15.7 GiB 内存，50% 上限足够，而且留了一半给安装过程用。
mount -t tmpfs -o size=50%,mode=0755 tmpfs /upper || fail "mounting the tmpfs failed"
mkdir -p /upper/rw /upper/work
mount -t overlay overlay \
      -o lowerdir=/lower,upperdir=/upper/rw,workdir=/upper/work /newroot \
      || fail "mounting the overlayfs failed (kernel without CONFIG_OVERLAY_FS?)"

# 把介质本身也带进去：安装器要从 U 盘上读 super.img / boot.img（读进了内存的就是内存里那份）
mkdir -p /newroot/media/gk3
if [ -n "$RAM" ]; then
    mount --move /ram /newroot/media/gk3 2>/dev/null || say "warning: could not move the in-memory copy of the boot medium into the new root"
else
    mount --move /mnt /newroot/media/gk3 2>/dev/null || say "warning: could not move the boot medium into the new root"
fi

# 介质的记录放在 /run：先在这里挂好 tmpfs、写进去，再整个移进新根（systemd 见到 /run 已经挂着就沿用）
if mount -t tmpfs -o nosuid,nodev,mode=0755,size=10% tmpfs /run && mkdir -p /run/gaokun3; then
    {
        echo "part=$MNAME"
        echo "disk=$MDISK"
        echo "start=$(cat "/sys/class/block/$MNAME/start" 2>/dev/null)"
        echo "size=$(cat "/sys/class/block/$MNAME/size" 2>/dev/null)"
        if [ -n "$RAM" ]; then echo "ram=yes"; else echo "ram=no"; fi
    } > /run/gaokun3/medium
    mkdir -p /newroot/run
    mount --move /run /newroot/run || say "warning: could not move /run into the new root; the installer will not recognise the boot medium"
else
    say "warning: could not mount /run; the installer will not recognise the boot medium"
fi

mkdir -p /newroot/proc /newroot/sys /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys  /newroot/sys
mount --move /dev  /newroot/dev

[ -x /newroot/sbin/init ] || fail "/sbin/init not found in the new root"
say "switch_root"
exec switch_root /newroot /sbin/init
fail "switch_root failed"
