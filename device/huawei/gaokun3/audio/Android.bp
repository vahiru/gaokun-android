// 应用视角的录音冒烟测试（AAudio）：走 AudioFlinger → 音频策略 → HAL → ALSA 的真实路径
// （tinycap 绕过了 HAL 与策略，见 docs/dev/audio-video.md）。
// 不进镜像（不在 PRODUCT_PACKAGES 里），`m gaokun3-mic-smoke` 后 push 到 /data/local/tmp 跑。
// 不走 AOSP 树也能用 NDK 编（scripts/audio/mic-verify.sh 的文件头有命令）。
cc_binary {
    name: "gaokun3-mic-smoke",
    srcs: ["tools/mic-smoke.c"],
    shared_libs: ["libaaudio"],
    cflags: ["-Wall", "-Werror"],
}
