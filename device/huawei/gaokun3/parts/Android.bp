//
// gaokun3 设备设置：磁吸键盘开关 + 扬声器增强（试验功能）开关 + USB-C 口的提示通知（v1.0 PWR-4 / USB-1，UsbPortNotifier）
// + 待机开关（v1.0 PWR-16，StandbySettingsActivity）。
// 2026-09-28 用户要求：开关换成系统设置同款的 Material 3 Expressive 样式 ⇒ 改用 androidx.preference + SettingsLib。
//
// ★ platform_apis + certificate: "platform" 两个都必需：
//   前者才能用 android.os.SystemProperties（@hide），
//   后者才能拿 android.uid.system（写 persist.sys.* 需要 system uid）。
//
// ⚠️★ 装到 system（不写分区属性），不是 vendor 也不是 product：
//   * vendor：Treble 下 vendor 应用不允许共享 android.uid.system。
//   * product：本树设了 PRODUCT_ENFORCE_PRODUCT_PARTITION_INTERFACE，
//     product 分区的应用【必须】声明 sdk_version（用稳定 SDK），
//     而那样就用不了 platform_apis，也就拿不到 SystemProperties（@hide）。
//     2026-08-22 实测踩到：
//       error: sdk_version must have a value when the module is located at
//              vendor or product (only if
//              PRODUCT_ENFORCE_PRODUCT_PARTITION_INTERFACE is set)
//   ⇒ 只有 system 分区能同时满足 platform_apis + system uid。
//
android_app {
    name: "Gaokun3Parts",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    platform_apis: true,
    certificate: "platform",

    // 界面用 SettingsLib 那一套（与系统设置同一个观感，Material 3 Expressive）：
    // CollapsingToolbarBaseActivity 自己套 Theme_SubSettingsBase_Expressive、处理 edge-to-edge；
    // SettingsBasePreferenceFragment 给出圆角分组卡片；SwitchPreferenceCompat 在这个主题下是
    // MaterialSwitch（SettingsTheme/res/values-v36/styles_preference_expressive.xml）。
    // crDroid 16 的 SettingsThemeHelper.isExpressiveTheme() 恒为 true（2026-09-28 读源码）；crDroid 17.0 仍恒为 true
    // （构建机 frameworks/base/packages/SettingsLib/SettingsTheme/src/com/android/settingslib/widget/SettingsThemeHelper.kt:38-40），
    // 上面四个 static_libs 模块名在 17.0 树里都在（CollapsingToolbarBaseActivity/、FooterPreference/、SettingsTheme/ 的 Android.bp；
    // androidx.preference_preference 在 prebuilts/sdk/current/androidx/m2repository/androidx/preference/preference/1.3.0-alpha01/）。
    static_libs: [
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibFooterPreference",
        "SettingsLibSettingsTheme",
        // 手写笔设置的四档平滑滑块（Material 离散滑块，带刻度和两端文字）：frameworks/base/packages/SettingsLib/
        // SliderPreference/，crDroid 17.0 与 LineageOS 24.0 是同一版。这一版默认不画刻度，StylusSettingsActivity 里打开。
        "SettingsLibSliderPreference",
        "androidx.preference_preference",
    ],
    // ⚠️ 不设 privileged：我们没申请任何特权权限，
    //    放 priv-app 只会多一层 privapp 白名单约束。

    optimize: {
        enabled: false,
    },
}
