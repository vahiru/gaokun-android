<?xml version="1.0" encoding="utf-8"?>
<!--
  gaokun3 设备设置：磁吸键盘开关（系统页）+ 扬声器增强试验开关（声音页）+ 待机开关（电池页，v1.0 PWR-16）
  + 触摸手感 game / daily 开关（系统页与控制中心磁贴，2026-10-25）+ 手写笔设置（已连接的设备页）。

  ★ 为什么是独立应用而不是改 Settings：
    用 Android 的 "Settings 注入" 机制（com.android.settings.action.IA_SETTINGS
    + category meta-data），系统设置会自动把这一项收进「系统」页，
    【不需要】动 packages/apps/Settings，也不需要 LineageParts
    （实测这个 ROM 里根本没装 org.lineageos.lineageparts）。
    ⚠️ 2026-10-05 复核：这句与现在的构建对不上 —— vendor/lineage/config/common.mk:156 把 LineageParts 列进
    PRODUCT_PACKAGES，构建机 out/target/product/gaokun3/system_ext/priv-app/LineageParts/ 也在（10-04 的构建）。
    PWR-14 的充电上限入口就是它的「电池 → 充电控制」⇒ ⬜ 上机 `pm list packages org.lineageos.lineageparts` 核对一次。
    好处是每次跟 ROM 升级不会冲突，全部代码留在设备树里。

  ★ 主题用 SettingsLib 的 Theme.SubSettingsBase：Activity 继承 CollapsingToolbarBaseActivity，
    它在 onCreate 里再换成 Theme_SubSettingsBase_Expressive（与系统设置的子页一样，见 Android.bp）。

  ⚠️ sharedUserId=android.uid.system 是必需的：要写 persist.sys.* 属性
     （上下文 system_prop），只有 system uid 的应用有这个权限。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.huawei.gaokun3.parts"
    android:sharedUserId="android.uid.system">

    <!-- v1.0 PWR-4 / USB-1：开机拉起 UsbPortNotifier、发 USB-C 口的提示通知（2026-10-05 起还有 BootEntryNotifier）。
         POST_NOTIFICATIONS 对 system uid 本来就放行（见 UsbPortNotifier.java 顶部），照样声明，免得哪天检查方式变了。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 启动选项（S15）："重启到 Windows" / "重启到引导菜单" 调 PowerManager.reboot；REBOOT 是 signature 权限，本应用平台签名 -->
    <uses-permission android:name="android.permission.REBOOT" />
    <!-- LidBehaviorDefault writes Settings.Global.LID_BEHAVIOR. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_keyboard"
        android:allowBackup="false"
        android:theme="@style/Theme.SubSettingsBase">

        <!-- ⚠️ 写【全限定类名】而不是 ".KeyboardSettingsActivity"：
             2026-08-22 实测 `am start -n .../.KeyboardSettingsActivity` 报
             START_CLASS_NOT_FOUND（result code=-92），而 dex 里类在、
             manifest 里 activity 也在、PMS 的解析器表里也有这条 IA_SETTINGS
             过滤器。相对名的展开是唯一可疑处，写死全名就没有这个歧义。
             ⚠️ 同时补 DEFAULT category：没有它，隐式意图匹配不到。
             ⚠️ 再加一个 LAUNCHER 入口作退路 —— 万一 Settings 注入在这个 ROM
             上不生效，至少能从应用抽屉里打开。 -->
        <activity
            android:name="com.huawei.gaokun3.parts.KeyboardSettingsActivity"
            android:exported="true"
            android:label="@string/keyboard_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/keyboard_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/keyboard_summary" />
            <!-- 不给这条，设置里那一行就没有图标 -->
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_keyboard" />
        </activity>

        <!-- 扬声器增强（试验功能，PR #7）。注入到「设置 → 声音」页：
             category ia.sound = CategoryKey.CATEGORY_SOUND（frameworks/base
             SettingsLib CategoryKey.java:37，lineage-23.0），SoundSettings 按它取注入条目
             （Settings DashboardFragmentRegistry.java:92-93，crDroid 16.0；17.0 在 :98-99，CategoryKey 常量不变 :37）。
             ⬜ 「系统」页的注入实测过（#65），「声音」页还没在实机上看过。
             不加 LAUNCHER 入口：应用抽屉里已经有键盘那一个退路了，再加一个只会多一个同名图标。 -->
        <activity
            android:name="com.huawei.gaokun3.parts.SpeakerFxSettingsActivity"
            android:exported="true"
            android:label="@string/speaker_fx_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/speaker_fx_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/speaker_fx_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_speaker" />
        </activity>

        <!-- Microphone noise suppression (micarray/README.md), in Settings → Sound like the speaker
             entry above. -->
        <activity
            android:name="com.huawei.gaokun3.parts.NoiseSuppressionSettingsActivity"
            android:exported="true"
            android:label="@string/denoise_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/denoise_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/denoise_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_mic" />
        </activity>

        <!-- 触摸手感开关（2026-10-25）：game / daily，替代 touchmode.rc 顶上那条 adb setprop。
             注入「系统」页（同键盘那一项，#65 实测过注入生效）。不加 LAUNCHER 入口，理由同上。 -->
        <activity
            android:name="com.huawei.gaokun3.parts.TouchModeSettingsActivity"
            android:exported="true"
            android:label="@string/touch_mode_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/touch_mode_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/touch_mode_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_touch_game" />
        </activity>

        <!-- M-Pencil settings: ink smoothing and the side double-tap (stylus/gk3pend.rc). Injected into
             Settings → Connected devices: category ia.connect = CategoryKey.CATEGORY_CONNECT, which
             ConnectedDeviceDashboardFragment takes its injected entries from. -->
        <activity
            android:name="com.huawei.gaokun3.parts.StylusSettingsActivity"
            android:exported="true"
            android:label="@string/stylus_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.connect" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/stylus_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/stylus_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_stylus" />
        </activity>

        <!-- Kernel version spoofing (patches/kernel/core/0008). Same injection as the touch feel entry. -->
        <activity
            android:name="com.huawei.gaokun3.parts.AppKernelSettingsActivity"
            android:exported="true"
            android:label="@string/app_kernel_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/app_kernel_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/app_kernel_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_app_kernel" />
        </activity>

        <!-- 控制中心（快捷设置）里的开关。
             ⚠️ android:permission 必须是 BIND_QUICK_SETTINGS_TILE —— 那是给
                【系统】绑定这个服务用的权限声明，不是我们要申请的权限；
                写错了 SystemUI 直接不认这个磁贴，而且不报错。
             ⚠️ 磁贴不会自动出现在控制中心：用户要在快捷设置编辑页里手动加一次。
                这是 Android 的设计，不是缺陷。 -->
        <service
            android:name="com.huawei.gaokun3.parts.KeyboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_keyboard"
            android:label="@string/keyboard_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 游戏触摸磁贴（2026-10-25），注意事项同上面键盘磁贴。 -->
        <service
            android:name="com.huawei.gaokun3.parts.TouchModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_touch_game"
            android:label="@string/touch_mode_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- USB-C 口（port0）的两条提示（v1.0 PWR-4 / USB-1）：读 usbrole 设的
             vendor.gaokun3.usbrole.broken / .reversed，亮屏时每 3 秒看一次。
             两个都写全限定类名（理由同上面的 activity）；不导出 —— 只有本应用自己（与系统同一个 uid）会启动它。 -->
        <!-- directBootAware：锁屏解锁之前（LOCKED_BOOT_COMPLETED）就要能跑，见 BootReceiver 顶部（2026-10-05）。 -->
        <service
            android:name="com.huawei.gaokun3.parts.UsbPortNotifier"
            android:directBootAware="true"
            android:exported="false" />

        <!-- 统一启动入口的通知（2026-10-05，S9）：读 boot_control HAL 设的 vendor.gaokun3.bootentry.*，
             入口回落到旧槽（fallback）/ 绕过入口开机（bypassed）等。只在开机后跑一次，见类顶部。 -->
        <service
            android:name="com.huawei.gaokun3.parts.BootEntryNotifier"
            android:directBootAware="true"
            android:exported="false" />

        <!-- 键盘开关关着时，键盘盖拔下再插回仍保持关着（v1.0 DISP-15 / HW-11，2026-10-05），见类顶部。
             directBootAware：解锁之前（锁屏输密码时）插回键盘，也要按开关的状态处理。 -->
        <service
            android:name="com.huawei.gaokun3.parts.KeyboardReplugWatcher"
            android:directBootAware="true"
            android:exported="false" />

        <!-- BOOT_COMPLETED / LOCKED_BOOT_COMPLETED 都是系统（uid 1000）发的受保护广播；本应用也是 uid 1000，不导出照样收得到。
             ★ 2026-10-05 起 directBootAware 并收 LOCKED_BOOT_COMPLETED：有锁屏密码时，BOOT_COMPLETED 要等第一次
               解锁才发，解锁之前两个通知服务都起不来（TODO 里记过）。两个动作都要权限 RECEIVE_BOOT_COMPLETED（上面已声明）。 -->
        <receiver
            android:name="com.huawei.gaokun3.parts.BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 启动选项（统一启动入口 S15，2026-10-05）：重启到 Windows / 默认系统 / 重启到引导菜单，注入「系统」页。
             ★ 缺省 enabled="false"：只有 HAL 报了可用的项（vendor.gaokun3.bootentry.windows / .menu = 1）时，
               BootEntryNotifier 才启用它 —— 纯 Android、分派关着的机器上设置里看不到这一页。 -->
        <activity
            android:name="com.huawei.gaokun3.parts.BootOptionsActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/boot_options_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/boot_options_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/boot_options_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_boot" />
        </activity>
    </application>
</manifest>
