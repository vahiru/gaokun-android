<?xml version="1.0" encoding="utf-8"?>
<!--
  gaokun3 设备设置：磁吸键盘与手写笔设置（已连接的设备页）、防误触模式（显示页）、扬声器音效与
  麦克风降噪（提示音和振动页的「高级」分组）、性能模式（电池页）等，以及键盘、防误触两个控制中心磁贴。

  ★ 为什么是独立应用而不是改 Settings：
    用 Android 的 "Settings 注入" 机制（com.android.settings.action.IA_SETTINGS
    + category meta-data），系统设置会自动把这一项收进「系统」页，
    【不需要】动 packages/apps/Settings，也不需要 LineageParts
    （实测这个 ROM 里根本没装 org.lineageos.lineageparts）。
    ⚠️ 2026-10-05 复核：这句与现在的构建对不上 —— vendor/lineage/config/common.mk:156 把 LineageParts 列进
    PRODUCT_PACKAGES，构建机 out/target/product/gaokun3/system_ext/priv-app/LineageParts/ 也在（10-04 的构建）。
    PWR-14 的充电上限入口就是它的「电池 → 充电控制」⇒ ⬜ 上机 `pm list packages org.lineageos.lineageparts` 核对一次。
    好处是每次跟 ROM 升级不会冲突，全部代码留在设备树里。

  ★ 主题用 SettingsLib 的 Theme.SubSettingsBase：Activity 继承 CollapsingToolbarBaseActivity，
    它在 onCreate 里再换成 Theme_SubSettingsBase_Expressive（与系统设置的子页一样，见 Android.bp）。

  ⚠️ sharedUserId=android.uid.system 是必需的：要写 persist.sys.* 属性
     （上下文 system_prop），只有 system uid 的应用有这个权限。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.huawei.gaokun3.parts"
    android:sharedUserId="android.uid.system">

    <!-- v1.0 PWR-4 / USB-1：开机拉起 UsbPortNotifier、发 USB-C 口的提示通知（2026-10-05 起还有 BootEntryNotifier）。
         POST_NOTIFICATIONS 对 system uid 本来就放行（见 UsbPortNotifier.java 顶部），照样声明，免得哪天检查方式变了。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 启动选项（S15）："重启到 Windows" / "重启到引导菜单" 调 PowerManager.reboot；REBOOT 是 signature 权限，本应用平台签名 -->
    <uses-permission android:name="android.permission.REBOOT" />
    <!-- LidBehaviorDefault writes Settings.Global.LID_BEHAVIOR. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- 平行视界：读取并设置兼容框架的按应用覆盖，切换后结束该应用的进程。 -->
    <uses-permission android:name="android.permission.READ_COMPAT_CHANGE_CONFIG" />
    <uses-permission android:name="android.permission.LOG_COMPAT_CHANGE" />
    <uses-permission android:name="android.permission.OVERRIDE_COMPAT_CHANGE_CONFIG_ON_RELEASE_BUILD" />
    <uses-permission android:name="android.permission.KILL_UID" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_keyboard"
        android:allowBackup="false"
        android:theme="@style/Theme.SubSettingsBase">

        <!-- 磁吸键盘：「已连接的设备」页里的一个开关条目，没有单独的页面（KeyboardProvider.java）。
             注入方式与下面的性能模式相同；分类（ia.connect）在provider返回的条目数据里。
             本应用没有LAUNCHER入口，应用抽屉里不显示图标。 -->
        <provider
            android:name="com.huawei.gaokun3.parts.KeyboardProvider"
            android:authorities="com.huawei.gaokun3.parts.keyboard"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
        </provider>

        <!-- 防误触模式：「显示」页里的一个开关条目（TouchProtectionProvider.java，分类ia.display），
             注入方式同上。 -->
        <provider
            android:name="com.huawei.gaokun3.parts.TouchProtectionProvider"
            android:authorities="com.huawei.gaokun3.parts.touchprotection"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
        </provider>

        <!-- 「提示音和振动」页的「高级」分组标题，以及扬声器音效条目下方的当前选项（SoundEntriesProvider.java）。
             下面两个activity条目以com.android.settings.group_key放进这个分组。 -->
        <provider
            android:name="com.huawei.gaokun3.parts.SoundEntriesProvider"
            android:authorities="com.huawei.gaokun3.parts.sound"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
        </provider>

        <!-- 扬声器音效（试验功能，PR #7）：「提示音和振动」页里的一个条目，点开后是选择对话框
             （SpeakerFxDialogActivity，透明窗口），没有单独的页面。分类ia.sound = CategoryKey.CATEGORY_SOUND，
             SoundSettings按它取注入条目（Settings DashboardFragmentRegistry.java，crDroid 17.0）。
             条目说明是当前选项，由summary_uri向SoundEntriesProvider读取（有summary_uri时设置不用静态说明，
             所以不给com.android.settings.summary）。
             ⚠️ 写全限定类名而不是".SpeakerFxDialogActivity"：am start曾对相对名报START_CLASS_NOT_FOUND，
             写死全名就没有展开的歧义。
             ⚠️ 补DEFAULT category：没有它，隐式意图匹配不到。 -->
        <activity
            android:name="com.huawei.gaokun3.parts.SpeakerFxDialogActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/speaker_fx_title"
            android:theme="@style/Theme.Gaokun3Parts.DialogHost">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="gaokun3_speaker_fx" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="gaokun3_sound_advanced" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/speaker_fx_title" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://com.huawei.gaokun3.parts.sound/getDynamicSummary/gaokun3_speaker_fx" />
            <!-- 不给这条，设置里那一行就没有图标 -->
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_speaker" />
        </activity>

        <!-- Microphone noise suppression (micarray/README.md), in the Advanced group of Settings →
             Sound like the speaker entry above. -->
        <activity
            android:name="com.huawei.gaokun3.parts.NoiseSuppressionSettingsActivity"
            android:exported="true"
            android:label="@string/denoise_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="gaokun3_sound_advanced" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/denoise_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/denoise_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_mic" />
        </activity>

        <!-- 性能模式：电池页里的一个开关条目，没有单独的页面（PerformanceModeProvider.java）。
             设置按IA_SETTINGS查询provider，再从它读取标题、分类（ia.battery）和开关状态。
             受WRITE_SECURE_SETTINGS保护：只有设置等系统组件能读写这个开关。 -->
        <provider
            android:name="com.huawei.gaokun3.parts.PerformanceModeProvider"
            android:authorities="com.huawei.gaokun3.parts.performancemode"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
        </provider>

        <!-- M-Pencil settings: ink smoothing and the side double-tap (stylus/gk3pend.rc). Injected into
             Settings → Connected devices: category ia.connect = CategoryKey.CATEGORY_CONNECT, which
             ConnectedDeviceDashboardFragment takes its injected entries from. -->
        <activity
            android:name="com.huawei.gaokun3.parts.StylusSettingsActivity"
            android:exported="true"
            android:label="@string/stylus_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.connect" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/stylus_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/stylus_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_stylus" />
        </activity>

        <!-- Kernel version spoofing (patches/kernel/core/0008), injected into Settings → System. -->
        <activity
            android:name="com.huawei.gaokun3.parts.AppKernelSettingsActivity"
            android:exported="true"
            android:label="@string/app_kernel_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/app_kernel_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/app_kernel_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_app_kernel" />
        </activity>

        <!-- GPU驱动兼容：为选定的应用在GL_VERSION中报告高通驱动版本（frameworks-base/0002）。入口与内核版本伪装相同。 -->
        <activity
            android:name="com.huawei.gaokun3.parts.GlDriverVersionSettingsActivity"
            android:exported="true"
            android:label="@string/gl_driver_version_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/gl_driver_version_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/gl_driver_version_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_gl_driver_version" />
        </activity>

        <!-- 平行视界：按应用开启frameworks-base/0005–0006的分栏显示。入口在“设置 → 应用”。 -->
        <activity
            android:name="com.huawei.gaokun3.parts.ParallelViewSettingsActivity"
            android:exported="true"
            android:label="@string/parallel_view_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.apps" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/parallel_view_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/parallel_view_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_parallel_view" />
        </activity>

        <!-- 控制中心（快捷设置）里的开关。
             ⚠️ android:permission 必须是 BIND_QUICK_SETTINGS_TILE —— 那是给
                【系统】绑定这个服务用的权限声明，不是我们要申请的权限；
                写错了 SystemUI 直接不认这个磁贴，而且不报错。
             ⚠️ 磁贴不会自动出现在控制中心：用户要在快捷设置编辑页里手动加一次。
                这是 Android 的设计，不是缺陷。 -->
        <service
            android:name="com.huawei.gaokun3.parts.KeyboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_keyboard"
            android:label="@string/keyboard_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 防误触磁贴，注意事项同上面键盘磁贴。类名沿用TouchModeTileService，见类顶部。 -->
        <service
            android:name="com.huawei.gaokun3.parts.TouchModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_touch_protection"
            android:label="@string/touch_mode_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- USB-C 口（port0）的反向供电提示：读 USB 端口 HAL 设的 vendor.gaokun3.usbrole.reversed，亮屏时每 3 秒看一次。
             两个都写全限定类名（理由同上面的 activity）；不导出 —— 只有本应用自己（与系统同一个 uid）会启动它。 -->
        <!-- directBootAware：锁屏解锁之前（LOCKED_BOOT_COMPLETED）就要能跑，见 BootReceiver 顶部（2026-10-05）。 -->
        <service
            android:name="com.huawei.gaokun3.parts.UsbPortNotifier"
            android:directBootAware="true"
            android:exported="false" />

        <!-- 手写笔的未配对提示与配对完成通知：读 gk3pend 设的 vendor.gaokun3.pen_unpaired / pen_paired，亮屏时每 3 秒看一次。 -->
        <service
            android:name="com.huawei.gaokun3.parts.StylusNotifier"
            android:directBootAware="true"
            android:exported="false" />

        <!-- 统一启动入口的通知（2026-10-05，S9）：读 boot_control HAL 设的 vendor.gaokun3.bootentry.*，
             入口回落到旧槽（fallback）/ 绕过入口开机（bypassed）等。只在开机后跑一次，见类顶部。 -->
        <service
            android:name="com.huawei.gaokun3.parts.BootEntryNotifier"
            android:directBootAware="true"
            android:exported="false" />

        <!-- 键盘开关关着时，键盘盖拔下再插回仍保持关着（v1.0 DISP-15 / HW-11，2026-10-05），见类顶部。
             directBootAware：解锁之前（锁屏输密码时）插回键盘，也要按开关的状态处理。 -->
        <service
            android:name="com.huawei.gaokun3.parts.KeyboardReplugWatcher"
            android:directBootAware="true"
            android:exported="false" />

        <!-- BOOT_COMPLETED / LOCKED_BOOT_COMPLETED 都是系统（uid 1000）发的受保护广播；本应用也是 uid 1000，不导出照样收得到。
             ★ 2026-10-05 起 directBootAware 并收 LOCKED_BOOT_COMPLETED：有锁屏密码时，BOOT_COMPLETED 要等第一次
               解锁才发，解锁之前两个通知服务都起不来（TODO 里记过）。两个动作都要权限 RECEIVE_BOOT_COMPLETED（上面已声明）。 -->
        <receiver
            android:name="com.huawei.gaokun3.parts.BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 启动选项（统一启动入口 S15，2026-10-05）：重启到 Windows / 默认系统 / 重启到引导菜单，注入「系统」页。
             ★ 缺省 enabled="false"：只有 HAL 报了可用的项（vendor.gaokun3.bootentry.windows / .menu = 1）时，
               BootEntryNotifier 才启用它 —— 纯 Android、分派关着的机器上设置里看不到这一页。 -->
        <activity
            android:name="com.huawei.gaokun3.parts.BootOptionsActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/boot_options_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/boot_options_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/boot_options_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_boot" />
        </activity>
    </application>
</manifest>
