<resources>
    <string name="app_name">MateBook E Go</string>

    <!-- Settings home → MateBook E Go settings (DeviceSettingsActivity) -->
    <string name="device_settings_title">MateBook E Go settings</string>
    <string name="device_settings_summary">Stylus, detachable keyboard, performance mode</string>
    <string name="device_settings_category_input">Input</string>
    <string name="device_settings_category_sound">Sound</string>
    <string name="device_settings_category_performance">Performance</string>
    <string name="device_settings_category_apps">Apps</string>
    <string name="device_settings_category_boot">Startup</string>

    <string name="keyboard_title">Detachable keyboard</string>
    <string name="keyboard_summary">Enable or disable the detachable keyboard and touchpad</string>
    <string name="keyboard_error">Couldn\'t change the detachable keyboard setting</string>
    <string name="tile_on">On</string>
    <string name="tile_off">Off</string>
    <string name="sound_advanced_title">Advanced</string>
    <string name="speaker_fx_title">Speaker sound effects</string>
    <string name="speaker_fx_engine_title">Sound effect engine</string>
    <string name="speaker_fx_engine_bass">Bass enhancement</string>
    <string name="speaker_fx_engine_histen">Huawei Histen</string>
    <string name="speaker_fx_engine_off">Off</string>
    <!-- Options of the speaker sound effects dialog; the values match SpeakerFxDialogActivity. -->
    <string-array name="speaker_fx_engine_entries">
        <item>@string/speaker_fx_engine_off</item>
        <item>@string/speaker_fx_engine_bass</item>
        <item>@string/speaker_fx_engine_histen</item>
    </string-array>
    <string-array name="speaker_fx_engine_values" translatable="false">
        <item>off</item>
        <item>bass</item>
        <item>histen</item>
    </string-array>
    <string name="speaker_fx_note">Sound effects apply only to the built-in speakers. The Histen engine may be unable to process audio from some games.</string>
    <!-- Notifications about USB-C port issues -->
    <string name="usb_port_channel">USB-C port issues</string>
    <string name="usb_port_channel_desc">Notifications about USB-C port issues</string>
    <string name="usb_port_reversed_title">USB-C port is supplying power</string>
    <string name="usb_port_reversed_text">The tablet is supplying power to another device without a data connection.</string>
    <!-- Notifications about startup issues -->
    <string name="boot_entry_channel">Startup issues</string>
    <string name="boot_entry_channel_desc">Notifications about startup issues</string>
    <string name="boot_entry_fallback_title">System update failed</string>
    <string name="boot_entry_fallback_text">After the last system update, the new version failed to start, and the previous version was restored automatically. Please report this to the developers.</string>
    <string name="boot_entry_bypassed_title">This startup did not use the default boot entry</string>
    <string name="boot_entry_bypassed_text">If this notification keeps appearing, please report it to the developers.</string>
    <!-- Settings > Display > Accidental touch protection -->
    <string name="touch_mode_title">Accidental touch protection</string>
    <string name="touch_mode_summary">Reduce accidental palm touches, for example when writing with the M-Pencil</string>
    <string name="touch_mode_tile_label">Touch protection</string>
    <string name="touch_mode_error">Couldn\'t change accidental touch protection. Please report this to the developers.</string>

    <!-- Kernel version spoofing (AppKernelSettingsActivity), injected into Settings → System. -->
    <string name="app_kernel_title">Kernel version spoofing</string>
    <string name="app_kernel_summary">The kernel version reported to apps</string>
    <string name="app_kernel_switch_title">Report a different version to apps</string>
    <string name="app_kernel_switch_summary_on">Non-system apps will read the kernel version set here</string>
    <string name="app_kernel_switch_summary_off">Non-system apps will read the real kernel version</string>
    <string name="app_kernel_version_title">Version reported to non-system apps</string>
    <string name="app_kernel_version_invalid">Enter a version such as 6.6.30, using only letters, digits and . _ + -, at most 64 characters.</string>
    <string name="app_kernel_real_title">Real kernel version</string>
    <string name="app_kernel_note">Some apps only accept running on kernel 6.x or older. This setting only affects the kernel version number that non-system apps read; system components can still read the real version. Changes apply after a restart.</string>
    <string name="app_kernel_restart_message">Changes apply after a restart. Restart now?</string>
    <string name="app_kernel_restart_now">Restart</string>
    <string name="app_kernel_restart_later">Later</string>

    <!-- GPU driver compatibility (GlDriverVersionSettingsActivity) -->
    <string name="gl_driver_version_title">GPU driver compatibility</string>
    <string name="gl_driver_version_summary">Report a Qualcomm driver version to selected apps</string>
    <string name="gl_driver_version_intro">Some games, such as those built with Unreal Engine, use Vulkan only when they detect a Qualcomm GPU driver. When this is enabled for a game, the game detects a Qualcomm driver version. Do not enable it for browsers, or some WebGL pages will not display correctly. Changes apply the next time the app starts.</string>
    <string name="gl_driver_version_apps_title">Apps</string>
    <string name="gl_driver_version_no_apps">No installed apps found</string>

    <!-- Stylus settings, injected into Settings → Connected devices -->
    <string name="stylus_title">Stylus settings</string>
    <string name="stylus_summary">Ink smoothing and double-tap on the pen</string>
    <string name="stylus_smooth_title">Ink smoothing</string>
    <string-array name="stylus_smooth_levels">
        <item>Weak</item>
        <item>Medium weak</item>
        <item>Medium strong</item>
        <item>Strong</item>
    </string-array>
    <string name="stylus_side_title">Double-tap action</string>
    <string-array name="stylus_side_entries">
        <item>Toggle eraser</item>
        <item>Side button click</item>
        <item>Off</item>
    </string-array>
    <string-array name="stylus_side_values" translatable="false">
        <item>eraser</item>
        <item>button</item>
        <item>none</item>
    </string-array>
    <string name="stylus_note">Stronger smoothing gives smoother lines when zoomed in, but the ink trails further behind the pen tip while you write.</string>
    <string name="stylus_pen_connected">Connected to %1$s</string>
    <string name="stylus_pen_none">No M-Pencil is connected</string>
    <string name="stylus_unpair_title">Disconnect</string>
    <string name="stylus_unpair_dialog_title">Disconnect M-Pencil</string>
    <string name="stylus_unpair_dialog_text">%1$s will be disconnected. You can connect %1$s to the tablet again by attaching it to the charging area at the top of the tablet.</string>

    <!-- Stylus notifications (StylusNotifier) -->
    <string name="stylus_channel">Stylus</string>
    <string name="stylus_unpaired_title">Unpaired M-Pencil detected</string>
    <string name="stylus_unpaired_text">You may be writing with an M-Pencil that is not paired. Attach the M-Pencil to the charging area at the top of the tablet to pair it.</string>
    <string name="stylus_paired_title">Connected to %1$s</string>
    <string name="stylus_paired_text">%1$s is now paired with the tablet.</string>
    <string name="stylus_nib_title">Loose M-Pencil nib detected</string>
    <string name="stylus_nib_text">A loose nib may affect writing. Check and tighten the nib, or replace it if necessary.</string>

    <string name="denoise_title">Microphone noise suppression</string>
    <string name="denoise_summary">Reduce background noise picked up by the built-in microphones</string>
    <string name="denoise_call_title">Calls</string>
    <string name="denoise_call_summary">Voice and video calls</string>
    <string name="denoise_record_title">Recording</string>
    <string name="denoise_record_summary">Voice recorders and most apps that record sound</string>
    <string name="denoise_camcorder_title">Video recording</string>
    <string name="denoise_camcorder_summary">The sound of videos recorded with the camera</string>
    <string name="denoise_note">Only sound from the built-in microphones is processed. Noise suppression keeps speech and turns down other sounds, including music and ambient sound. Changes apply from the next call or recording.</string>

    <!-- Force activity embedding (ParallelViewSettingsActivity) -->
    <string name="parallel_view_title">Force activity embedding (experimental)</string>
    <string name="parallel_view_summary">Show app pages side by side in landscape</string>
    <string name="parallel_view_intro">When this is enabled for an app that provides split layouts, its pages are shown side by side in landscape. Changing this setting closes the app; the change applies the next time the app opens.</string>
    <string name="parallel_view_apps_title">Apps</string>
    <string name="parallel_view_no_apps">No apps with split layouts found</string>

    <!-- Performance mode (Settings → Battery) -->
    <string name="perf_mode_title">Performance mode</string>
    <string name="perf_mode_summary">Turn on to raise the temperature limits of the processor and GPU under heavy load, for long periods of heavy use such as games.</string>
    <string name="perf_mode_error">Couldn\'t change performance mode</string>
</resources>
