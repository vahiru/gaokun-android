        <item>弱</item>
        <item>较弱</item>
        <item>较强</item>
        <item>强</item>
    </string-array>
    <string name="stylus_side_title">双击笔身功能</string>
    <string-array name="stylus_side_entries">
        <item>切换橡皮擦</item>
        <item>侧键单击</item>
        <item>关</item>
    </string-array>
