  </array>

  <!-- ── 屏幕（11 英寸 2560×1600 LCD，HX83121A，120 Hz）：估计，未实测 ──────────────
       screen.on = 面板 + DSI 不含背光 ≈ 0.5 W；screen.full = 背光满亮额外 ≈ 2.0 W（框架按亮度线性插值）。
       没有息屏显示（AOD），ambient 给 0。显示器编号 0 = 内屏（PowerProfile.java:251-261 的 *.displayN）。 -->
  <item name="ambient.on.display0">0</item>
  <item name="screen.on.display0">65</item>
  <item name="screen.full.display0">260</item>

  <!-- ── 无线（WCN6855，ath11k）：估计 ──────────────────────────────────────
       wifi.controller.* 全给 0 ⇒ 框架不走"控制器能耗"那条路，按下面的 wifi.on / scan / active 估。
       ⬜ ath11k 在本机报不报 link layer stats / 控制器活动时间没核实。 -->
  <item name="wifi.on">2</item>
  <item name="wifi.scan">50</item>
  <item name="wifi.active">100</item>
  <item name="wifi.controller.idle">0</item>
  <item name="wifi.controller.rx">0</item>
  <item name="wifi.controller.tx">0</item>
  <array name="wifi.controller.tx_levels">
  </array>
  <item name="wifi.controller.voltage">0</item>
  <array name="wifi.batchedscan">
    <value>.0002</value>
    <value>.002</value>
    <value>.02</value>
    <value>.2</value>
    <value>2</value>
  </array>
  <!-- 蓝牙控制器的 idle / rx / tx / 电压留给 config.xml 的 config_bluetooth_*（PowerProfile.java getDefaultValuesFromConfig）。 -->
  <item name="bluetooth.on">0.1</item>
  <item name="bluetooth.active">5</item>

  <!-- ── 多媒体：估计 ──────────────────────────────────────────────────────
       audio：扬声器功放播放 ≈ 0.25 W；video：iris 硬解 ≈ 0.5 W（CPU / GPU 另算）；
       camera.avg：传感器 + camss ≈ 1.2 W（libcamera 软件 ISP 的 CPU 另算）；flashlight：后摄闪光灯 LED 常亮 ≈ 0.6 W。 -->
  <item name="audio">30</item>
  <item name="video">60</item>
  <item name="camera.avg">150</item>
  <item name="camera.flashlight">80</item>

  <!-- ── 没有的硬件：GPS、蜂窝基带（本机无 modem，见 docs/dev/hardware.md）—— 全 0 ──── -->
  <item name="gps.on">0</item>
  <array name="gps.signalqualitybased">
    <value>0</value>
    <value>0</value>
  </array>
  <item name="gps.voltage">0</item>
  <item name="radio.active">0</item>
  <item name="radio.scanning">0</item>
  <array name="radio.on">
    <value>0</value>
    <value>0</value>
  </array>
  <modem>
    <sleep>0</sleep>
    <idle>0</idle>
    <active rat="DEFAULT">
      <receive>0</receive>
      <transmit level="0">0</transmit>
      <transmit level="1">0</transmit>
      <transmit level="2">0</transmit>
      <transmit level="3">0</transmit>
      <transmit level="4">0</transmit>
    </active>
  </modem>
  <item name="modem.controller.voltage">0</item>

  <!-- 内存带宽：照 AOSP 默认（一个桶）。 -->
  <array name="memory.bandwidths">
    <value>22.7</value>
  </array>
</device>
