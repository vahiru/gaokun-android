  </array>
  <!-- 每核电流（mA），与上面逐档对应：满频 1.0 W / 7.7 V ≈ 130 mA。 -->
  <array name="cpu.core_power.cluster0">
    <value>4.8</value>
    <value>7.0</value>
    <value>9.3</value>
    <value>11.9</value>
    <value>14.7</value>
