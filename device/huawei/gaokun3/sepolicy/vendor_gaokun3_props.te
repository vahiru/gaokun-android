# gaokun3 自研属性的类型与访问规则。对应 sepolicy/property_contexts。
#
# 宏出处：system/sepolicy/public/te_macros:1042
#   define(`vendor_public_prop', `define_prop($1, vendor, public)')
# 展开成：type vendor_gaokun3_prop, property_type, vendor_property_type,
#                            vendor_public_property_type;
# ⚠️★ 类型名必须以 `vendor_` 开头 —— 这不是风格，是构建时的硬检查：
#    system/sepolicy/build/soong/selinux_contexts.go:391-397
#      allowedContextPrefixes = []string{"vendor_", "odm_"}
#    再由 tests/check_prop_prefix.py 逐行比对，--strict 下不匹配就构建失败。
#    同一处（:365-382）也给出了允许的【属性名】前缀清单，`persist.vendor.` 在里面
#    （`persist.gaokun3.` 不在，这正是必须改名的原因）。
#    ★ 我第一版把类型写成 gaokun3_prop，正会撞这条 —— 属性名合规不等于上下文名合规。
vendor_public_prop(vendor_gaokun3_prop)

# ⚠️★★★ 这里【曾经】有一条 `set_prop(shell, vendor_gaokun3_prop)`，想让
#    `adb shell setprop` 还能改这个开关。**它编不过去**，2026-09-18 构建机实测：
#
#      libsepol.report_failure: neverallow on line 488 of system/sepolicy/private/property.te
#        violated by allow shell vendor_gaokun3_prop:property_service { set };
#
#    规则本体（private/property.te:492-502，在 compatible_property_only 里）：
#      neverallow { coredomain -init -system_writes_vendor_properties_violators }
#                 { property_type -system_property_type -extended_core_property_type }
#                 :property_service set;
#    —— `shell` 是 coredomain，所以它【不能设任何 vendor 属性】，
#    与属性是不是 vendor_public_property_type 无关：public 那两条豁免管的是
#    property.te:192-203 的读/写，管不到这一条。
#    ★ 我上一轮"选 public 就能给 shell 开写权限"的推理是错的，**而且只有编译器
#      能证伪它** —— 读 neverallow 读漏了一条，实机在 permissive 下也永远不会报。
#
# ⚠️ 想留 shell 的写权限只有一条路：把 shell 挂上
#    `system_writes_vendor_properties_violators`（public/attributes:284）。
#    **没有这么做**：那是给整个 shell 域开的后门，为一个排查开关不值得。
#
# ★ 那排查时怎么改？用 root —— 本机 adb shell 实测就是 uid 0 且域是
#   `u:r:ksu:s0`（ReSukiSU 自己的域，不是 AOSP 的 su），也就是说
#   `adb shell setprop persist.vendor.gaokun3.allow_suspend 1` 本来走的就不是
#   shell 域。⬜ 未验证：enforcing 之后 ksu 域能不能设这个属性（那是 root
#   实现在运行期打的策略补丁，本仓管不到）。真不行就只剩"改 device.mk 重新构建"。
#
# ★ persist.sys.gaokun3.allow_suspend → persist.vendor.gaokun3.allow_suspend 镜像：
#   init.gaokun3.rc 两条字面值触发器在 vendor_init 里 setprop 成
#   persist.vendor.gaokun3.allow_suspend。【这里不需要新规则】：
#     · vendor rc 里 persist.sys.* 的触发器不被丢：sepolicy/vendor_init.te:16 的 get_prop(vendor_init, system_prop)；
#     · vendor_init 写本类型：下面的 set_prop(vendor_init, vendor_gaokun3_prop)。

# OTA 钩子读 persist.vendor.gaokun3.recovery_entry 决定要不要写 recovery 启动项。
# （见 bin/gaokun3-ota-postinstall.sh 与 sepolicy/postinstall.te）
get_prop(postinstall, vendor_gaokun3_prop)

# ★ v1.0 PWR-4 / USB-1（2026-10-05）：system_app 只给【读】—— Parts 的 UsbPortNotifier 亮屏时每 3 秒读
#    vendor.gaokun3.usbrole.broken / .reversed（gaokun3-usbrole.sh 与 USB 端口 HAL 设），据此发 USB-C 口的提示通知。
#    能读是因为 vendor_gaokun3_prop 是 vendor_public_property_type：core 侧那条"coredomain 不许读 vendor 属性"的
#    neverallow 对它有豁免（refs/lineage-sepolicy/private/property.te:193-198）。Parts 是 system_app
#    （seapp_contexts:180，user=system seinfo=platform）。⬜ 未编译。
#    写仍然不给、也给不了：coredomain 设 vendor 属性被 private/property.te 里带 system_writes_vendor_properties_violators 的那条 neverallow 禁（本文件顶上那次构建失败；public 类型的豁免只管 :193-203 那两条）。
#    system_server 仍然没有任何权限（用不到）。
#    键盘开关与触摸模式走的是 persist.sys.gaokun3.*（system_prop，AOSP 已经
#    allow system_app 写，见 private/system_app.te:43）——【那两个不要跟着改名】，
#    改了 Parts 应用反而写不了。#117 第 5 条。
get_prop(system_app, vendor_gaokun3_prop)

# 扬声器增强（试验功能，PR #7）的总开关镜像：etc/histen.rc 在 vendor 的 rc 里
# `setprop vendor.gaokun3.histen.on …`，动作跑在 vendor_init 域。
# ★ vendor_init 对 vendor 属性的笼统写权限只在 not_compatible_property 下才有
#   （private/vendor_init.te:258-264），本机是兼容属性模式 ⇒ 要显式给。
#   neverallow 那边只拦 coredomain 写 vendor 属性，vendor_init 不是 coredomain。
set_prop(vendor_init, vendor_gaokun3_prop)
# ↑ 2026-10-05 起也用于 boot HAL 的 rc：on property:sys.boot_completed=1 → setprop vendor.gaokun3.boot.done 1
#   （触发器那一半：vendor_init 读 boot_status_prop，refs/lineage-sepolicy/private/vendor_init.te:316）。

# ★ 统一启动入口（2026-10-05，S9；boot_control/Gk3Boot.cpp）：boot_control HAL 要
#   读：vendor.gaokun3.boot.done（上面那条 rc 设）、persist.vendor.gaokun3.gk3boot（off / observe / action，部署开关）；
#   写：vendor.gaokun3.bootentry.*（via / event / notify / bypassed / streak / mode / version / error / done）——
#       Parts（system_app）读它们发通知，上面那条 get_prop(system_app, …) 已经覆盖。
#   hal_bootctl_default 不是 coredomain，property.te 里拦 coredomain 写 vendor 属性的那条 neverallow 管不到它。⬜ 未编译。
get_prop(hal_bootctl_default, vendor_gaokun3_prop)
set_prop(hal_bootctl_default, vendor_gaokun3_prop)
