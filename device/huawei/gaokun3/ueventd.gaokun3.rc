# gaokun3 设备节点权限
#
# DRM 渲染节点：mesa/turnip 在**应用进程**里打开 /dev/dri/renderD128（GLES 经
# ANGLE→Vulkan 也一样），默认 0660 system:graphics 应用打不开，日志会刷
#   TU: tu_knl.cc: failed to open device /dev/dri/renderD128
#       (VK_ERROR_INCOMPATIBLE_DRIVER)
# 库存高通设备上对应的 /dev/kgsl-3d0 同样是 0666。
/dev/dri/renderD*         0666   system     graphics
# ★ v1.0 SEC-14（2026-10-05）：KMS 主节点 card* 0666 → 0660。应用只需要上面的 render 节点；
#   主节点（modeset / DRM master）原先任何 App 都能打开，攻击面比需要的大，enforcing 之后也照样靠 DAC 放行
#   （标签 gpu_device，核心策略给应用开着）。1.0.0-dev.1 实机逐进程查 /proc/*/fd：打开 card1 的只有 HWC
#   （android.hardware.composer.hwc3-service.drm，uid 1000 = 节点属主），SurfaceFlinger / 应用 / 相机只开 renderD128。
#   上机判据：ls -l /dev/dri/card1 = crw-rw---- system graphics；开机出画、亮灭屏、游戏（turnip）、录屏、相机预览照常。
/dev/dri/card*            0660   system     graphics

# FastRPC 到 SLPI 传感器 DSP。hexagonrpcd（上游自带的 hexagonrpcd-sdsp.rc）
# 跑在 user/group system 下，而 /dev/fastrpc-* 默认 root 独占 —— 不给权限就
# 打不开，服务会起不来。
# ★ 只放行 sdsp 这一个：adsp/cdsp/cdsp-secure 我们不用，不必授权。
# 用途与整条通路见 docs/stage4-findings.md #37。
/dev/fastrpc-sdsp         0660   system     system

# Venus 硬件视频编解码。v4l2_codec2 的服务
# （android.hardware.media.c2-service-v4l2）在自带的 .rc 里声明 `user media`，
# 而 /dev/video* 默认是 root:root 0600 —— 不改属主它连设备都打不开，
# 症状会是"服务起来了、IComponentStore/default 也注册了、但一个组件都没有"。
# 上游 README 给的就是这一条（0600 media media）。
# ⚠️★ 2026-09-13 更正：启用 camss 之后【不再只有两个节点】——camss 占了
#   video0-31，Venus 被挤到 video32/33（共 34 个，#81 预测的副作用实测发生了）。
#   属主组也从 media 改成 camera：相机 HAL 以 cameraserver 跑、在 camera 组里，
#   而 Venus 的 v4l2_codec2 服务以 media 用户跑、是文件属主，0660 两边都够。
/dev/video*               0660   media      camera

# ── 相机（camss + libcamera，2026-09-13）──
#
# ⚠️★ 没有这几条的症状极具误导性：相机 HAL 以 cameraserver 用户跑，而主线内核
#   建出来的 /dev/media0 默认是 `crw------- root root` —— 打不开。
#   于是 libcamera 报的是 **"发现 0 个相机"**，看起来像 camss 没 probe 或者
#   dtb 用错了；而 root 手跑同一个二进制能找到 1 个。
#   ★ 判据：同一个程序 root 跑得通、服务用户跑不通 ⇒ 先查节点权限，别查驱动。
/dev/media*               0660   media      camera
/dev/v4l-subdev*          0660   media      camera

# ── 后摄闪光灯（#110 / #111）──
# LED 在 PM8350C 闪光模块上，内核暴露成 /sys/class/leds/white:flash（patches/0036）。
# 相机 HAL 以 cameraserver 跑、在 camera 组里；节点默认 root 0644，HAL 写不了 brightness
# —— 症状会是应用里有闪光按钮、按了不亮，logcat 只有一条 EACCES。
# ★ ueventd 按 "/sys/class/<subsystem>/<basename>" 匹配（SysfsPermissions::MatchWithSubsystem），
#   所以这里可以写 class 路径而不用写 PMIC 那串真实设备路径。
/sys/class/leds/white:flash   brightness         0664   root   camera
/sys/class/leds/white:flash   flash_brightness   0664   root   camera
/sys/class/leds/white:flash   flash_strobe       0664   root   camera
/sys/class/leds/white:flash   flash_timeout      0664   root   camera

# 手写笔（M-Pencil）：触摸从片驱动（patches/0079）交出帧的节点，内核默认 root 独占。
# gk3pend 以 system 跑（stylus/gk3pend.rc）。
/dev/gk3_pen              0660   system     system

# USB 端口 HAL（usb/）以 system 跑：切 port0 的数据角色要写 role，对端拔掉后要写 soft_connect
# 让 UDC 断开再接上。两个节点默认 root 独占（role 0644、soft_connect 0200）。
# UDC 每次切回 device 都会重新创建，ueventd 处理它的 add 事件时会重新套用 soft_connect 那一行
# （system/core init/devices.cpp：HandleUevent → FixupSysPermissions）。
/sys/class/usb_role/a600000.usb-role-switch   role           0664   root   system
/sys/class/udc/a600000.usb                    soft_connect   0220   root   system
# 同一个 HAL 还把 gadget 的连接状态写给 UsbDeviceManager：patches/0096 的 android_usb 类，state 默认 0644 root。
/sys/class/android_usb/android0               state          0664   root   system
