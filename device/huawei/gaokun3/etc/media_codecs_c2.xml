<?xml version="1.0" encoding="utf-8" ?>
<!--
  gaokun3 硬件视频编解码（内核驱动 qcom-iris，经 external/v4l2_codec2）。
  ★ 2026-09-28 从 qcom-venus 换成 qcom-iris（docs/dev/audio-video.md），VP8 随之撤掉。

  ★ 这个文件是【必需】的，不是可选的：
    frameworks/av/media/codec2/sfplugin/Codec2InfoBuilder.cpp:543 里
        if (parser.getCodecMap().count(nameOrAlias) == 0) { ... continue; }
    —— HAL 枚举出来的组件，只要不在 XML 里就会被直接跳过。
  ★ 也【不需要】从 media_codecs.xml 里 <Include>：同一文件 :442-444 明确单独
    搜索 media_codecs_c2.xml。而且 APEX 的软解表在 :437-439 先解析，
    所以加这个文件不会顶掉那 66 个 c2.android.* 软解。

  ── 声明哪些编解码器：两边取交集，都是实测出来的 ──

  硬件：
    venus 时代（`tools/v4l2-probe` 实测 VIDIOC_ENUM_FMT）：解码 H264 VP80 VP90 HEVC MPG2，编码 H264 VP80 HEVC
    ★ iris gen1（iris_platform_vpu2.c 的格式表，#128）：解码 H264 HEVC VP90，编码 H264 HEVC
  v4l2_codec2 有组件的（v4l2/V4L2ComponentCommon.cpp）：
    解码avc/vp8/vp9/hevc/av1，编码avc/vp8/vp9，加上patches/android/v4l2-codec2/0005的hevc编码
  ⇒ 交集 = 解码avc/vp9/hevc，编码avc/hevc。
    ⚠️ VP8：iris 不解。这里要是还声明它，rank 压过软解，应用拿到失败而不是回退；
    ⚠️ AV1、VP9 编码硬件都没有 —— 对应属性必须保持 false。
  ⚠️ 不声明 *.decoder.secure：本机没有安全播放（无 Widevine L1）。

  ── 尺寸上限是【判断】，不是实测 ──
  ⚠️ 驱动不钳位：TRY_FMT 送 8192x8192 它照收（只把裸帧高度对齐到 32，
     1080→1088、2160→2176），所以拿不到真实上限。（venus 时代实测；iris 的 ENUM_FRAMESIZES
     报 128..8192，同样给不出真实解码能力。）
     这里按 Snapdragon 8cx Gen 3 公开规格取 4K，并遵循"宁可少报"——
     报小了应用退回软解（慢但能放），报大了应用把啃不动的流交给硬件（花屏）。
  min 128x128 则是实测值（ENUM_FRAMESIZES 报的下限，比上游模板的 16x16 大得多）。
-->
<MediaCodecs>
    <!-- 硬件编码：只能配合带CP非像素上下文的内核（patches/kernel/iommu/0001），条件见device.mk。
         concurrent-instances 1：编码器的ARP缓冲映射在一个固定IOVA上，同一时刻只有一个编码会话，
         两个编码器共用ro.vendor.v4l2_codec2.encode_concurrent_instances这一个计数。
         尺寸下限128x128是iris的帧尺寸下限（iris_platform_vpu2.c）。上限是判断，不是实测：
         实测做到1080p 30 fps；按4K30申报（3840x2176@30 = 979200块/秒），驱动的核心负载上限是
         4096x2176@60，编解码共用。码率下限32 kbps是驱动gen1编码器的下限，上限40 Mbps是
         HEVC 5.1级Main层级的码率上限，H.264取同一个值。
         码率模式只能由这里声明（Codec2InfoBuilder不向组件查询），不写时应用只看到VBR；
         组件和iris gen1都支持VBR与CBR。 -->
    <Encoders>
        <MediaCodec name="c2.v4l2.avc.encoder" type="video/avc">
            <Limit name="size" min="128x128" max="4096x2176" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" range="1-979200" />
            <Limit name="bitrate" range="32000-40000000" />
            <Limit name="concurrent-instances" max="1" />
            <Feature name="bitrate-modes" value="VBR,CBR" />
        </MediaCodec>
        <MediaCodec name="c2.v4l2.hevc.encoder" type="video/hevc">
            <Limit name="size" min="128x128" max="4096x2176" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" range="1-979200" />
            <Limit name="bitrate" range="32000-40000000" />
            <Limit name="concurrent-instances" max="1" />
            <Feature name="bitrate-modes" value="VBR,CBR" />
        </MediaCodec>
    </Encoders>

    <Decoders>
        <MediaCodec name="c2.v4l2.avc.decoder" type="video/avc">
            <Limit name="size" min="128x128" max="4096x2176" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="1879200" />
            <Limit name="bitrate" range="1-62500000" />
            <Limit name="concurrent-instances" max="8" />
            <Limit name="performance-point-3840x2160" range="30-30" />
            <Feature name="adaptive-playback" />
        </MediaCodec>

        <!-- HEVC：2026-08-23 之前这一条是撤掉的（组件能建会话但一帧不出）。
             根因已查明并修复在【用户态】：venus 固件收到「只有 VPS/SPS/PPS、
             又没打 CODECCONFIG 标志」的缓冲会报 H265_CONFIG_FLAG_MISSING，
             用默认 SPS 编造一张 pic 0，那张图要 YUV 输出缓冲，而主机在等
             SOURCE_CHANGE 才肯分配 —— 死锁。修法是让 v4l2_codec2 把 CSD 并进
             第一个帧缓冲（external/v4l2_codec2，属性 vendor.gaokun3.v4l2c2.merge_csd
             可关掉做 A/B）。详见 docs/dev/audio-video.md。
             ⚠️ 若这一版实测仍不出帧，把本条 MediaCodec 整段删掉再发版：
                留着的话 rank 压过软解，应用拿到的是失败而不是回退。 -->
        <MediaCodec name="c2.v4l2.hevc.decoder" type="video/hevc">
            <Limit name="size" min="128x128" max="4096x2176" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="1879200" />
            <Limit name="bitrate" range="1-62500000" />
            <Limit name="concurrent-instances" max="8" />
            <Limit name="performance-point-3840x2160" range="30-30" />
            <Feature name="adaptive-playback" />
        </MediaCodec>

        <!-- VP8：随 qcom-venus → qcom-iris（#128）撤掉。iris gen1 没有 VP8。 -->

        <MediaCodec name="c2.v4l2.vp9.decoder" type="video/x-vnd.on2.vp9">
            <Limit name="size" min="128x128" max="4096x2176" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="2073600" />
            <Limit name="bitrate" range="1-62500000" />
            <Limit name="concurrent-instances" max="8" />
            <Limit name="performance-point-3840x2160" range="30-30" />
            <Feature name="adaptive-playback" />
        </MediaCodec>
    </Decoders>
</MediaCodecs>
