# 挂起前把 USB role 切到 host —— 见 bin/gaokun3-usbrole.sh 与
# docs/dev/deep-sleep.md。
#
# 默认【启用】（device.mk：persist.vendor.gaokun3.allow_suspend=1；2026-09-18～09-24 开发期曾是 0）。
#   为 1 时 gaokun3_nosuspend 被放开，改由 gaokun3_usbrole 单独把关。
#   关（persist，重启不丢）：
#     · ★ 1.0 起（PWR-16）：「设置 → 电池 → 待机（睡眠）」的开关（Parts）写 persist.sys.gaokun3.allow_suspend，
#       init.gaokun3.rc 用两条字面值触发器镜像成 persist.vendor.gaokun3.allow_suspend；
#     · 排查用：开发构建 adb root 之后 adb shell setprop persist.vendor.gaokun3.allow_suspend 0；
#       发布构建（ro.debuggable=0，没有 adb root）给 Shell 授 root 后
#       adb shell su -c "setprop persist.vendor.gaokun3.allow_suspend 0"（⬜ 发布构建上的 su 路径未实测）。
#   ⚠️ 普通 adb shell（shell 域）设不了：coredomain 设 vendor 属性被 private/property.te:492-502 禁，
#      enforcing 下会 "Failed to set property"。开发机能直接设是因为 adbd 跑在 KernelSU 的 ksu 域。
#
# ⚠️ 屏幕状态属性的值是 Android 的 Display.STATE_*：**1 = OFF，2 = ON**，
#    不是 0/1（2026-08-22 实机核对过，差点按 0/1 写错）。
#
# ⚠️ 代价：息屏时会切到 host，于是 USB device-mode adb 断开，亮屏后恢复。
#    开发构建的 TCP adb（persist.adb.tcp.port=5555）不受影响；发布构建默认不开 TCP adb，
#    无线调试走 Wi-Fi，同样不受 USB 角色影响。

service gaokun3_role_host /vendor/bin/gaokun3-usbrole.sh host
    user root
    group root wakelock
    oneshot
    disabled

# 亮屏（下面的触发器）和开机（init.gaokun3.usb.rc 的两处 exec_start）都用它。
# port0 已是 host 且 xhci 下枚举着设备（U 盘 / 鼠标 / 扩展坞）时保持 host、不切 device（v1.0 PWR-5 / STOR-2）。
service gaokun3_role_device /vendor/bin/gaokun3-usbrole.sh device
    user root
    group root wakelock
    oneshot
    disabled

# 数据角色跟着"对面实际是什么"走（#118 §8）原先是这里的常驻服务 gaokun3_usbfollow（gaokun3-usbrole.sh 的
# follow 模式，每 2 秒轮询一次），现在由 USB 端口 HAL 按 uevent 做（usb/Follow.h）。

# 开机就把门关上：role 出厂是 device，未经确认一律不放行挂起。
on init
    write /sys/power/wake_lock gaokun3_usbrole

# 切 host 失败（A6：待机后回插 port0 坏口）时脚本置 vendor.gaokun3.usbrole.broken=1、成功时清 0 ——
# 失败就一直持有 wakelock，这次开机余下的时间整机不再睡（v1.0 PWR-4）。Parts 的 UsbPortNotifier 读它，亮屏时弹常驻通知请用户重启。
on property:persist.vendor.gaokun3.allow_suspend=1 && property:debug.tracing.screen_state=1
    start gaokun3_role_host

on property:persist.vendor.gaokun3.allow_suspend=1 && property:debug.tracing.screen_state=2
    # role_host 可能还在等拔线（插着主机时息屏，见 gaokun3-usbrole.sh），先停掉它。
    # init 的 stop 是 SIGKILL 整个进程组；role_device 一上来先拿 wakelock，不变量不受影响。
    stop gaokun3_role_host
    start gaokun3_role_device

# ── USB-2（v1.0，2026-10-05）：port0 在 host 时停掉 adbd 的 USB 传输 ──────────────
# 来龙去脉在 bin/gaokun3-usbrole.sh 的 USB-2 一段：adbd 等不到 FUNCTIONFS_BIND 就每秒重开 functionfs、
# 重设 sys.usb.ffs.ready=1，init.usb.configfs.rc 每秒重写 UDC 报 busy。上游给的开关是 sys.usb.adb.disabled，
# 由 system 的 init.usb.rc:23-24 从 vendor.sys.usb.adb.disabled 拷过去。
# 脚本和 USB 端口 HAL 只能设 vendor.gaokun3.*（vendor.sys.usb.adb.disabled 是 vendor_default_prop，只有 init / vendor_init 能设，
# refs/lineage-sepolicy/private/domain.te:802），所以这里转一手。用两条字面量而不是 ${…} 展开：
# 展开在 vendor_init 里做，它没有读 vendor_gaokun3_prop 的规则；触发条件由 init 自己判断，不受影响。
# 上机判据（⬜ 未上机）：port0 插 U 盘停在 host 时 `getprop sys.usb.adb.disabled` = 1、dmesg 不再每秒出现
#   "write … UDC … busy" / "read descriptors"；拔掉 U 盘换插 PC、切回 device 后 = 0，USB adb 2 秒左右回来；
#   开发构建 `adb root`（重启 adbd）之后照常。
on property:vendor.gaokun3.usbrole.adb_pause=1
    setprop vendor.sys.usb.adb.disabled 1

on property:vendor.gaokun3.usbrole.adb_pause=0
    setprop vendor.sys.usb.adb.disabled 0
