# 触摸手感模式。改一个属性就行：
#   setprop persist.sys.gaokun3.touch_mode game    # 不做手掌识别（默认）
#   setprop persist.sys.gaokun3.touch_mode daily   # 识别手掌
#   ⚠️ enforcing 下普通 adb shell 设不了 system_prop（policy-query：shell system_prop set DENY）：
#      开发构建先 adb root 再 setprop；发布构建（ro.debuggable=0，没有 adb root）装 ReSukiSU 管理器、
#      给 Shell（com.android.shell）授 root 后 adb shell su -c "setprop …"（⬜ 发布构建上的 su 路径未实测）。
#      ★ 用户不必走 adb：「设置 → 显示 → 防误触模式」（开启 = daily）与控制中心「防误触」磁贴改的就是这个属性
#      （parts/…/TouchProtectionProvider.java、TouchModeTileService.java）。
#
# ★ 用 persist.sys.* 与键盘开关同理：属性上下文是 system_prop，系统应用
#   （Settings，uid system）能直接 SystemProperties.set()，不必再造一个服务。
#
# ⚠️ 默认给 game（device.mk 里设）—— 这台机器的目标就是跑手游。两个预设只差手掌识别
#    （hand_enabled），不改任何信号处理门限；手掌常搭在屏幕上（写字、画画）时切 daily。

service gaokun3_touch_game /vendor/bin/gaokun3-touch-mode.sh game
    user root
    group root
    oneshot
    disabled

service gaokun3_touch_daily /vendor/bin/gaokun3-touch-mode.sh daily
    user root
    group root
    oneshot
    disabled

on property:persist.sys.gaokun3.touch_mode=game
    start gaokun3_touch_game

on property:persist.sys.gaokun3.touch_mode=daily
    start gaokun3_touch_daily

# 开机补一次：属性触发器在 init 早期不会重放，而触摸驱动 probe 也要时间。
on boot && property:persist.sys.gaokun3.touch_mode=game
    start gaokun3_touch_game

on boot && property:persist.sys.gaokun3.touch_mode=daily
    start gaokun3_touch_daily
