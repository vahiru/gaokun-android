#!/bin/sh
# ssh 起来之前把启动介质上的公钥并进 /root/.ssh/authorized_keys（ssh.service 的 ExecStartPre）。
#
# ★ 为什么是拷，而不是让 sshd 直接去认介质上那一份：sshd 的 StrictModes 会从公钥文件一路查到 /，
#   沿途任何一级目录属主不是 root、或组/他人可写，就【静默】拒绝这把钥匙。而介质是外来的文件系统，
#   属主和权限我们管不了 —— 2026-09-25 内置盘上的 p3 就是这样：根目录属 uid 1001（解包 Ubuntu
#   根文件系统留下的）、gaokun3/ 是 777，sshd 回的是
#   "Authentication refused: bad ownership or modes for directory /media/gk3/gaokun3"。
#   拷进来之后，要查的只剩 /root/.ssh 这一条我们自己造的路径。
# ★ 只追加、不覆盖：rescue 镜像构建时可以用 --ssh-key 自带一把（build-rootfs.sh）。
#   根目录是 tmpfs 上的 overlay，每次开机从镜像重来，所以重复启动 ssh 也不会越并越多（逐行查重）。
SRC=/media/gk3/gaokun3/authorized_keys
DST=/root/.ssh/authorized_keys
[ -f "$SRC" ] || exit 0
install -d -m 700 /root/.ssh
[ -f "$DST" ] || install -m 600 /dev/null "$DST"
# 去掉 \r：公钥可能是在 Windows 上写进 U 盘的
tr -d '\r' < "$SRC" | while IFS= read -r l; do
    case "$l" in ''|'#'*) continue ;; esac
    grep -qxF -- "$l" "$DST" || { printf '%s\n' "$l" >> "$DST"; echo "Added key $(echo "$l" | awk '{print $NF}')"; }
done
chmod 600 "$DST"
exit 0
