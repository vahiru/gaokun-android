#!/bin/sh
# 把启动诊断写回启动介质（由 gk3-diag.timer 在开机 45 秒后触发，也可以手动 systemctl start gk3-diag）。
#
# 为什么需要它：这台机器没有串口，LiveCD 里也没有网络。图形界面起不来时一点信息都拿不到，
#   所以系统必须自己把证据留在介质上，下次进 Windows / Android（或把 U 盘插到别的机器上）就能读。
MEDIA=/media/gk3
OUT=$MEDIA/gaokun3/diag
# 介质是只读挂的（initramfs 那边就是 -o ro）。临时改成读写，写完改回去 ——
# ⚠️ 但只在【本来是只读】时改回去：安装器会话（gk3-installer-session）也把它改成读写、并一直开着
#    installer.log 与浸泡日志。在它之后改回只读，最好的情况是 EBUSY 失败（有文件开着写），
#    差一点就是那些日志从第 45 秒起全部 EROFS。
WAS=$(awk -v m="$MEDIA" '$2 == m { split($4, o, ","); r = o[1] } END { print r }' /proc/mounts)
mount -o remount,rw "$MEDIA" 2>/dev/null || { echo "Cannot remount the boot medium read-write (write-protected USB drive?); skipping"; exit 0; }
mkdir -p "$OUT" 2>/dev/null
F=$OUT/boot-$(date +%Y%m%d-%H%M%S).log
{
    echo "=== Time / kernel ==="; date; uname -a; cat /proc/cmdline
    echo; echo "=== Failed units ==="; systemctl --failed --no-pager 2>&1
    echo; echo "=== gaokun3 services ==="
    systemctl status --no-pager -l gk3-installer seatd 2>&1 | head -60
    echo; echo "=== Mounts ==="; findmnt -o TARGET,SOURCE,FSTYPE,OPTIONS 2>&1 | head -40
    echo; echo "=== Boot medium ==="; cat /run/gaokun3/medium 2>&1
    echo; echo "=== Display outputs (DRM) ==="
    for c in /sys/class/drm/card*-*; do
        [ -e "$c/status" ] || continue
        echo "  $(basename "$c"): $(cat "$c/status" 2>/dev/null)"
        [ -f "$c/modes" ] && sed "s/^/    mode /" "$c/modes" 2>/dev/null | head -4
    done
    echo; echo "=== GPU / render nodes ==="
    ls -la /dev/dri/ 2>&1; dmesg 2>/dev/null | grep -iE "msm|adreno|a6xx|a690|gpu" | tail -20
    echo; echo "=== Input devices (touch / keyboard) ==="; grep -E "^N:|^H:" /proc/bus/input/devices 2>/dev/null | head -20
    echo; echo "=== Installer log ==="; tail -60 "$OUT/installer.log" 2>/dev/null
    echo; echo "=== Processes ==="; ps -eo pid,rss,args 2>&1 | head -50
    echo; echo "=== Firmware loading ==="; dmesg 2>/dev/null | grep -iE "firmware" | tail -20
    echo; echo "=== dmesg tail ==="; dmesg 2>/dev/null | tail -60
    echo; echo "=== journal (this boot, warning and above) ==="; journalctl -b -p warning --no-pager 2>&1 | tail -120
} > "$F" 2>&1
# 屏幕：装机失败时一张截图胜过一段描述（live 才有 grim 和合成器）
if command -v grim >/dev/null && [ -S /run/gk3-installer/wayland-0 ]; then
    XDG_RUNTIME_DIR=/run/gk3-installer WAYLAND_DISPLAY=wayland-0 grim "${F%.log}.png" 2>/dev/null
fi
sync
[ "$WAS" = ro ] && mount -o remount,ro "$MEDIA" 2>/dev/null
# 介质读进了内存（内置盘上的安装器分区）：上面写的是内存里那份，再写回分区本身（initramfs-init 的 gk3.toram）
if [ -x /usr/lib/gaokun3/gk3l ] && grep -qx 'ram=yes' /run/gaokun3/medium 2>/dev/null; then
    /usr/lib/gaokun3/gk3l persist-sync >/dev/null 2>&1 || echo "Could not copy the report back to the installer partition"
fi
echo "Diagnostics written to $F"
