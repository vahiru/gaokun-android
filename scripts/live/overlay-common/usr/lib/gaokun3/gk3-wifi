#!/bin/sh
# gaokun3 只有 WiFi，所以"上网"这件事必须开机自己完成，否则救援系统就是一台连不上的机器。
# 由 gk3-wifi.service 调用（Debian / systemd；Alpine 版是 /etc/init.d/gk3-wifi，逻辑相同）。
#
# 凭据来源，按优先级：
#   1. /media/gk3/gaokun3/wpa_supplicant.conf   ← 启动介质上（推荐）
#   2. /etc/wpa_supplicant/wpa_supplicant.conf  ← 构建时注入（build-rootfs.sh --wifi-conf）
#
# ★ 优先用介质上那份，是为了让【镜像本身不含任何凭据】：公开发布的 LiveCD 不能带
#   别人家的 WiFi 密码，而救援镜像也不该把密码焊死在只读的 squashfs 里。
#
# ★ 控制接口统一放在 /run/wpa_supplicant（wpa_cli 默认就找这里）。用户放在介质上的配置未必写了
#   ctrl_interface，所以这里先合成一份：统一的控制接口 + 用户配置里除 ctrl_interface 以外的全部内容。
# 无线网卡的名字：本应是 wlan0 —— overlay 屏蔽了 systemd 的可预测命名（/etc/systemd/network/99-default.link
# → /dev/null）。⚠️ 但不写死：M0 第一轮（2026-09-25）没屏蔽时 systemd-udevd 把它改名成了 wlP6p1s0，
# 这里只认 wlan0，于是以为 ath11k 没起来、跑去重绑。兜底认第一块有 wireless/ 的网卡。
# （与 installer-lib.sh 的 gk3__wifi_if 同一规则；这里不 source 它，因为这是开机就跑的服务，越少依赖越好）
wifi_if() {
    [ -e /sys/class/net/wlan0 ] && { echo wlan0; return; }
    for n in /sys/class/net/*; do [ -d "$n/wireless" ] && { echo "${n##*/}"; return; }; done
}
IFACE=$(wifi_if)
MEDIA_CONF=/media/gk3/gaokun3/wpa_supplicant.conf
IMAGE_CONF=/etc/wpa_supplicant/wpa_supplicant.conf
RUN_CONF=/run/gaokun3/wpa_supplicant.conf
CTRL=/run/wpa_supplicant

ip link set lo up 2>/dev/null

# 若 ath11k 因为任何原因 probe 失败，【重新绑定一次】—— 此刻 squashfs 已挂好，
#   /lib/firmware 里的固件一定拿得到。重绑之后 wlan0 出现 ⇒ 确实是"probe 时固件不可达"。
#   （内建 ath11k 在 initramfs 阶段 t≈1.19s 就 probe，所以固件也打进了 initramfs，
#    见 scripts/live/README.md。这里是第二道保险。）
if [ -z "$IFACE" ]; then
    echo "No wireless interface; trying to rebind ath11k_pci"
    DRV=/sys/bus/pci/drivers/ath11k_pci
    if [ -d "$DRV" ]; then
        for dev in /sys/bus/pci/devices/*; do
            # ⚠️ 只认高通的【网络控制器】（class 0x0280xx）。只看厂商号会把 PCIe 根端口也列进来 —— 它们也是
            #    0x17cb，而 0002:00:00.0 正是 NVMe 的上游。写进 ath11k_pci/unbind 对它们是空操作（没绑在这个
            #    驱动上），但"碰巧无害"不该是安全性的来源，何况 live 可能正从这块 NVMe 上跑。
            [ "$(cat "$dev/vendor" 2>/dev/null)" = "0x17cb" ] || continue
            case "$(cat "$dev/class" 2>/dev/null)" in 0x0280*) ;; *) continue ;; esac
            echo "$(basename "$dev")" > "$DRV/unbind" 2>/dev/null
            echo "$(basename "$dev")" > "$DRV/bind" 2>/dev/null
            echo "  rebound $(basename "$dev")"
        done
        i=0; while [ -z "$IFACE" ] && [ $i -lt 15 ]; do sleep 1; i=$((i+1)); IFACE=$(wifi_if); done
    else
        echo "  $DRV does not exist; is the driver built into the kernel?"
    fi
fi
if [ -z "$IFACE" ]; then
    echo "Still no wireless interface. See the gk3-diag report in /media/gk3/gaokun3/diag/"
    exit 1
fi
echo "Wireless interface: $IFACE"

CONF=
[ -f "$MEDIA_CONF" ] && CONF=$MEDIA_CONF
[ -z "$CONF" ] && [ -f "$IMAGE_CONF" ] && CONF=$IMAGE_CONF
mkdir -p /run/gaokun3
{ echo "ctrl_interface=$CTRL"; echo "update_config=0"
  [ -n "$CONF" ] && grep -v -E '^[[:space:]]*(ctrl_interface|update_config)[[:space:]]*=' "$CONF"; } > "$RUN_CONF"
chmod 600 "$RUN_CONF"
if [ -z "$CONF" ]; then
    # 没有凭据也照样起 wpa_supplicant（只带控制接口）：安装器的 WiFi 页要用它扫描、连网
    echo "No wpa_supplicant.conf found; starting the control interface only. Connect from the installer, or put a configuration at $MEDIA_CONF and reboot"
else
    echo "Starting Wi-Fi (configuration from ${CONF})"
fi
ip link set "$IFACE" up
wpa_supplicant -B -i "$IFACE" -c "$RUN_CONF" -P /run/wpa_supplicant.pid || exit 1
# dhcpcd 自己会等载波，不用我们轮询
dhcpcd -b "$IFACE"
exit 0
