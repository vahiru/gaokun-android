#!/bin/bash
# 救援 / live 系统里：让【下一次、且仅下一次】开机直接进 Android 的某个槽（v1.0 计划 INST-12）。
#
#   gk3-boot-android [a|b] [--reboot]    写 systemd-boot 的 LoaderEntryOneShot（不给槽：取 loader.conf 的 default 那个槽）
#   gk3-boot-android --list              只看：ESP 在哪、有哪些条目、default、现在的 OneShot
#   gk3-boot-android --clear             撤掉已写的 OneShot
#
# ★ 为什么要它：开机菜单里的条目 ID 以 machine-id 开头（<32 位十六进制>-android-a.conf），而救援系统自己的
#   /etc/machine-id 每次开机现生成、和它不是一回事 —— 原先的说明让人 `bootctl set-oneshot <id>`，id 得自己去查；
#   而且 live 镜像里根本没有 bootctl（Debian 13 把它放在 systemd-boot 包里，镜像只装了 systemd-boot-efi；
#   2026-10-05 在 09-27 构建的镜像里 command -v bootctl 为空）。这里按 *-android-<槽>.conf 的形状在 ESP 上找。
# ★ 选的是【直连条目】<machine-id>-android-<槽>.conf（安装器写的那条，linux 行直接指 ESP 上 slot_<槽> 的内核）：
# 统一启动入口的 gk3boot-android-<槽>.conf 也匹配这个通配，但 gk3boot 按 misc 里的 A/B 状态选槽、不看条目名里的
#   字母（见 tools/gk3boot/README.md）—— 要的是"进这个槽"，只有直连条目做得到。
#   不想指定槽、只想照常进 Android：直接 reboot（菜单 15 秒后走 default）。
# ★ 写法与 scripts/boot-oneshot.sh 相同（#42）：4 字节属性 0x07（NV|BS|RT，小端）+ 条目 ID 的 UTF-16LE + 双字节 NUL；
#   覆盖已有的变量之前先 chattr -i；写完回读核对。厂商 GUID 4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
#   （refs/systemd-v257/src/boot/efivars.h:12）。systemd-boot 读到 OneShot 就删掉它，按 fnmatch 匹配去掉计数后的 ID
#   （refs/systemd-v257/src/boot/boot.c:1637-1640、1771-1795、1362-1365）。
# ⚠️ 未在真机的救援系统里跑过（TODO V16）：efivarfs 在救援里能不能写（同一个内核，Android 侧能写，boot-oneshot.sh:9-11）。
#
# 测试用的开关：GK3_ESP_DIR=<目录>（当作已挂好的 ESP，不去找分区）、GK3_EFIVARS=<目录>（efivarfs 的位置）。
set -u
GUID=4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
EFIVARS=${GK3_EFIVARS:-/sys/firmware/efi/efivars}
VAR=$EFIVARS/LoaderEntryOneShot-$GUID
ESP_TYPE=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
die() { echo "!! $*" >&2; exit 1; }
say() { echo "$*" >&2; }

SLOT= ACT=set REBOOT=
for a in "$@"; do
    case "$a" in
        a|b|_a|_b) SLOT=${a#_} ;;
        --reboot|-r) REBOOT=1 ;;
        --list|-l) ACT=list ;;
        --clear) ACT=clear ;;
        -h|--help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) die "不认识的参数：${a}（用法：gk3-boot-android [a|b] [--reboot] | --list | --clear）" ;;
    esac
done

# ── 找 ESP：上面有 loader/entries/*-android-*.conf 的那个 FAT 分区（与 OTA postinstall 的 find_esp 同一个判据）──
MNT= OWN=
cleanup() { [ -n "$OWN" ] && { umount "$MNT" 2>/dev/null; rmdir "$MNT" 2>/dev/null; }; }
trap cleanup EXIT
find_esp() {
    if [ -n "${GK3_ESP_DIR:-}" ]; then MNT=$GK3_ESP_DIR; return 0; fi
    local s dev t m first=""
    for s in /sys/class/block/*; do
        [ -f "$s/partition" ] || continue
        dev=/dev/${s##*/}; [ -b "$dev" ] || continue
        [ "$(blkid -p -o value -s TYPE "$dev" 2>/dev/null)" = vfat ] || continue
        t=$(blkid -p -o value -s PART_ENTRY_TYPE "$dev" 2>/dev/null | tr 'A-F' 'a-f')
        [ "$t" = "$ESP_TYPE" ] || [ "${GK3_ANY_FAT:-0}" = 1 ] || continue
        m=$(findmnt -rno TARGET -S "$dev" 2>/dev/null | head -1)
        if [ -n "$m" ]; then
            ls "$m"/loader/entries/*-android-*.conf >/dev/null 2>&1 && { MNT=$m; say "ESP：${dev}（已挂在 ${m}）"; return 0; }
            continue
        fi
        m=$(mktemp -d /tmp/gk3-esp.XXXX)
        if mount -o ro -t vfat "$dev" "$m" 2>/dev/null; then
            if ls "$m"/loader/entries/*-android-*.conf >/dev/null 2>&1; then MNT=$m; OWN=1; say "ESP：$dev"; return 0; fi
            umount "$m"
        fi
        rmdir "$m"
    done
    return 1
}
find_esp || die "找不到装着 Android 启动项的 ESP（FAT、EFI System 类型、loader/entries/ 下有 *-android-*.conf）"
ENT=$MNT/loader/entries

# 直连条目：<32 位小写十六进制>-android-<槽>[+N[-M]].conf（与 postinstall 的 is_direct_entry、gk3boot.efi 的 direct_cb 同一规则，
# 再加上 systemd-boot 的启动计数后缀）。.conf.disabled 不算（systemd-boot 只读 *.conf）
direct_entries() {   # $1=槽 → 每行一个文件名
    local f n
    for f in "$ENT"/*-android-"$1"*.conf; do
        [ -f "$f" ] || continue
        n=${f##*/}
        [[ $n =~ ^[0-9a-f]{32}-android-$1(\+[0-9]+(-[0-9]+)?)?\.conf$ ]] && echo "$n"
    done
}
entry_id() { local n=$1; [[ $n =~ ^(.*)\+[0-9]+(-[0-9]+)?\.conf$ ]] && n=${BASH_REMATCH[1]}.conf; echo "$n"; }
default_slot() { sed -n 's/^default[[:space:]]*\*-android-\([ab]\)\.conf[[:space:]]*$/\1/p' "$MNT/loader/loader.conf" 2>/dev/null | head -1; }
read_var() { [ -f "$VAR" ] && tail -c +5 "$VAR" 2>/dev/null | tr -d '\0'; }

efivars_ready() {
    [ -n "$(ls -A "$EFIVARS" 2>/dev/null)" ] && return 0
    [ -n "${GK3_EFIVARS:-}" ] && return 0          # 测试的目录本来就是空的
    mount -t efivarfs efivarfs "$EFIVARS" 2>/dev/null
    [ -n "$(ls -A "$EFIVARS" 2>/dev/null)" ]
}

case "$ACT" in
list)
    echo "── ESP 上的启动项（${ENT}）"
    ls "$ENT" 2>/dev/null | sed 's/^/  /'
    echo "── loader.conf：$(grep -E '^default' "$MNT/loader/loader.conf" 2>/dev/null || echo '（没有 default 行）')"
    for s in a b; do echo "── 槽 $s 的直连条目：$(direct_entries "$s" | tr '\n' ' ')"; done
    echo "── 现在的 LoaderEntryOneShot：$(read_var || true)"
    exit 0 ;;
clear)
    efivars_ready || die "efivarfs 不可用（${EFIVARS}）"
    [ -e "$VAR" ] || { echo "没有 OneShot，不用撤"; exit 0; }
    chattr -i "$VAR" 2>/dev/null; rm -f "$VAR"
    [ -e "$VAR" ] && die "没撤掉 $VAR"
    echo "✓ OneShot 已撤掉（下次开机照常走 default）"; exit 0 ;;
esac

[ -n "$SLOT" ] || SLOT=$(default_slot)
[ -n "$SLOT" ] || die "没给槽，loader.conf 里也读不出 default 是哪个槽 —— 用 gk3-boot-android a 或 b"
# shellcheck disable=SC2207  # 文件名按上面的正则只含 [0-9a-f+.-] 与字母，不会被空白切开
CAND=($(direct_entries "$SLOT"))
case ${#CAND[@]} in
    1) ;;
    0) die "ESP 上没有槽 $SLOT 的直连条目（<machine-id>-android-$SLOT.conf）。看一眼：gk3-boot-android --list" ;;
    *) die "槽 $SLOT 的直连条目不止一个（${CAND[*]}）—— 不知道该进哪个。多出来的那个是以前装机留下的，改名成 .conf.disabled 再来" ;;
esac
FILE=${CAND[0]}; ID=$(entry_id "$FILE")
# 条目指的内核与 dtb 必须真在 ESP 上：不然写了 OneShot 也只是换一个起不来的开机
for k in linux devicetree; do
    p=$(sed -n "s/^$k[[:space:]][[:space:]]*//p" "$ENT/$FILE" | head -1 | tr -d '\r' | sed 's/[[:space:]]*$//')
    [ -n "$p" ] && [ -f "$MNT$p" ] || die "$FILE 的 $k 行指向 '${p}'，ESP 上没有这个文件 —— 这样开机会失败，不写"
done

efivars_ready || die "efivarfs 不可用（${EFIVARS} 挂不上）—— 只能在开机菜单里手选 $FILE"
TMP=$(mktemp /tmp/gk3-oneshot.XXXX)
{ printf '\007\000\000\000'; for ((i = 0; i < ${#ID}; i++)); do printf '%s\000' "${ID:i:1}"; done; printf '\000\000'; } > "$TMP"
[ -e "$VAR" ] && chattr -i "$VAR" 2>/dev/null
# 一次 write 写完（efivarfs 要求整个变量一次写入；cat 对几十字节就是一次 write）
cat "$TMP" > "$VAR" 2>/dev/null; rc=$?
rm -f "$TMP"
[ "$rc" = 0 ] || die "写 $VAR 失败 —— 只能在开机菜单里手选 $FILE"
GOT=$(read_var)
[ "$GOT" = "$ID" ] || die "回读是 '${GOT}'，期望 '${ID}' —— OneShot 没写对，先别重启（gk3-boot-android --clear 撤掉）"
echo "✓ 下一次开机进槽 ${SLOT}：LoaderEntryOneShot = ${ID}（回读一致；只管这一次，之后照常走 default）"
if [ -n "$REBOOT" ]; then
    cleanup; OWN=
    sync; systemctl reboot 2>/dev/null || reboot
else
    echo "  现在重启：reboot"
fi
