+                           mSensorInfo.type == SensorType::GYROSCOPE;
+    gaokun3::Sample sample;
+    if (sscVector) {
+        sample = mSensorInfo.type == SensorType::ACCELEROMETER
+                ? gaokun3::SscHub::Get().Accel() : gaokun3::SscHub::Get().Gyro();
+        if (!sample.valid) return events;
+    }
     Event event;
     event.sensorHandle = mSensorInfo.sensorHandle;
     event.sensorType = mSensorInfo.type;
