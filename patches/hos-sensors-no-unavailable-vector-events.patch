-    readEventPayload(event.payload);
+    if (sscVector) {
+        // Preserve legitimate zero vectors (stationary gyro/free fall) and the
+        // existing accuracy mapping. Only sample absence suppresses an event.
+        EventPayload::Vec3 vec3 = {
+                .x = sample.v[0],
+                .y = sample.v[1],
+                .z = sample.v[2],
+                .status = SscAccuracyToStatus(sample.accuracy),
+        };
+        event.payload.set<EventPayload::Tag::vec3>(vec3);
+    } else {
+        readEventPayload(event.payload);
+    }
     events.push_back(event);
