From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] wifi: ath11k: back off from a firmware crash loop, then give
 up

ath11k_core_reset() only counts resets that time out waiting for an
earlier one, and any restart that completes clears the count. So firmware
that crashes again after every restart is reset for as long as it keeps
doing that, and each reset keeps the system awake for the restart plus
ATH11K_RECOVERY_SETTLE_MS. On one standby of 8 h 50 min, batterystats showed
the ath11k_recovery wakeup source taken 944 times for 1 h 34 min, with two
activations to a completed reset, the system awake for 2 h 12 min, and
Wi-Fi was dead at the end. The kernel log of that one is lost, so why the
firmware crashed isn't known.

The limits that are there also lose the crash: after three failures, a
crash within 20 s of the last one just returns, and the firmware never
reports anything again.

Count the resets of a crash loop instead, whatever became of them: a crash
within ATH11K_RESET_LOOP_WINDOW_SEC of the previous reset continues the
loop. The first two resets run at once, so that a crash during a restart
costs nothing extra. After that a reset waits for 30 s from the previous
one, doubling each time, with the wakeup source released. The crash stays
pending meanwhile, so a suspend takes the same path as for a crash during a
suspend and leaves the crashed firmware alone. A resume finding the time
over resets it at once, and otherwise a delayed work does.

After six resets, give up and release the wakeup source. A suspend still
reloads the firmware if it powers the device down, which it does as the
firmware won't accept WoW. The count starts over
ATH11K_RESET_LOOP_WINDOW_SEC after the last reset or the give-up, in
boottime, so sleep counts. A hw-restart from debugfs starts it over too.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/net/wireless/ath/ath11k/core.c    | 83 +++++++++++++++++------
 drivers/net/wireless/ath/ath11k/core.h    | 19 ++++--
 drivers/net/wireless/ath/ath11k/debugfs.c |  1 +
 drivers/net/wireless/ath/ath11k/mac.c     |  1 -
 drivers/net/wireless/ath/ath11k/pci.c     |  2 +
 5 files changed, 79 insertions(+), 27 deletions(-)

diff --git a/drivers/net/wireless/ath/ath11k/core.c b/drivers/net/wireless/ath/ath11k/core.c
index a0e4ddf11..c016707d8 100644
--- a/drivers/net/wireless/ath/ath11k/core.c
+++ b/drivers/net/wireless/ath/ath11k/core.c
@@ -2558,7 +2558,6 @@ static void ath11k_core_end_reset_without_restart(struct ath11k_base *ab)
 	atomic_dec(&ab->reset_count);
 	complete(&ab->reset_complete);
 	ab->is_reset = false;
-	atomic_set(&ab->fail_cont_count, 0);
 	__pm_relax(ab->recovery_ws);
 }
 
@@ -2587,10 +2586,56 @@ static void ath11k_core_restart(struct work_struct *work)
 	complete(&ab->restart_completed);
 }
 
+/*
+ * Each reset reloads the firmware and keeps the system awake, so firmware that
+ * keeps crashing must not be reset for as long as it does. Past the first few
+ * resets of a crash loop, put the reset off, with the crash pending and the
+ * system free to suspend. After ATH11K_RESET_LOOP_MAX of them, give up: the
+ * next suspend that powers the device down then gives the firmware its next
+ * chance. The count starts over ATH11K_RESET_LOOP_WINDOW_SEC after the last
+ * reset, or after the last crash once it gave up.
+ */
+static bool ath11k_core_reset_allowed(struct ath11k_base *ab)
+{
+	time64_t now = ktime_get_boottime_seconds();
+	time64_t hold;
+
+	if (now - ab->reset_time >= ATH11K_RESET_LOOP_WINDOW_SEC)
+		ab->reset_loop = 0;
+
+	if (ab->reset_loop >= ATH11K_RESET_LOOP_MAX) {
+		ath11k_err(ab, "firmware crashed again after %u resets, giving up\n",
+			   ab->reset_loop);
+		ab->reset_time = now;
+		__pm_relax(ab->recovery_ws);
+		return false;
+	}
+
+	if (ab->reset_loop >= ATH11K_RESET_LOOP_FREE) {
+		hold = ab->reset_time - now +
+		       (ATH11K_RESET_LOOP_BACKOFF_SEC <<
+			(ab->reset_loop - ATH11K_RESET_LOOP_FREE));
+		if (hold > 0) {
+			ath11k_warn(ab, "firmware crashed again after %u resets, next one in %lld s\n",
+				    ab->reset_loop, hold);
+			set_bit(ATH11K_FLAG_CRASH_PENDING, &ab->dev_flags);
+			__pm_relax(ab->recovery_ws);
+			queue_delayed_work(ab->workqueue_aux, &ab->reset_retry_work,
+					   secs_to_jiffies(hold));
+			return false;
+		}
+	}
+
+	ab->reset_loop++;
+	ab->reset_time = now;
+
+	return true;
+}
+
 static void ath11k_core_reset(struct work_struct *work)
 {
 	struct ath11k_base *ab = container_of(work, struct ath11k_base, reset_work);
-	int reset_count, fail_cont_count;
+	int reset_count;
 
 	if (!(test_bit(ATH11K_FLAG_REGISTERED, &ab->dev_flags))) {
 		ath11k_warn(ab, "ignore reset dev flags 0x%lx\n", ab->dev_flags);
@@ -2599,16 +2644,7 @@ static void ath11k_core_reset(struct work_struct *work)
 
 	pm_wakeup_ws_event(ab->recovery_ws, ATH11K_RECOVERY_WAKEUP_MS, false);
 
-	/* Sometimes the recovery will fail and then the next all recovery fail,
-	 * this is to avoid infinite recovery since it can not recovery success.
-	 */
-	fail_cont_count = atomic_read(&ab->fail_cont_count);
-
-	if (fail_cont_count >= ATH11K_RESET_MAX_FAIL_COUNT_FINAL)
-		return;
-
-	if (fail_cont_count >= ATH11K_RESET_MAX_FAIL_COUNT_FIRST &&
-	    time_before(jiffies, ab->reset_fail_timeout))
+	if (!ath11k_core_reset_allowed(ab))
 		return;
 
 	reinit_completion(&ab->reset_complete);
@@ -2623,13 +2659,8 @@ static void ath11k_core_reset(struct work_struct *work)
 		 */
 		ath11k_warn(ab, "already resetting count %d\n", reset_count);
 
-		if (!wait_for_completion_timeout(&ab->reset_complete,
-						 ATH11K_RESET_TIMEOUT_HZ)) {
-			ab->reset_fail_timeout = jiffies + ATH11K_RESET_FAIL_TIMEOUT_HZ;
-			/* Record the continuous recovery fail count when recovery failed*/
-			atomic_inc(&ab->fail_cont_count);
-		}
-
+		wait_for_completion_timeout(&ab->reset_complete,
+					    ATH11K_RESET_TIMEOUT_HZ);
 		flush_work(&ab->restart_work);
 
 		/* A suspend got in during the wait: stay out of its way. */
@@ -2716,6 +2747,19 @@ void ath11k_core_schedule_reset(struct ath11k_base *ab)
 }
 EXPORT_SYMBOL(ath11k_core_schedule_reset);
 
+static void ath11k_core_reset_retry(struct work_struct *work)
+{
+	struct ath11k_base *ab = container_of(work, struct ath11k_base,
+					      reset_retry_work.work);
+
+	spin_lock_bh(&ab->base_lock);
+	/* A resume from a powered down suspend may have got there first. */
+	if (test_bit(ATH11K_FLAG_CRASH_PENDING, &ab->dev_flags) &&
+	    !test_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags))
+		ath11k_core_schedule_reset(ab);
+	spin_unlock_bh(&ab->base_lock);
+}
+
 static int ath11k_init_hw_params(struct ath11k_base *ab)
 {
 	const struct ath11k_hw_params *hw_params = NULL;
@@ -2908,6 +2952,7 @@ struct ath11k_base *ath11k_core_alloc(struct device *dev, size_t priv_size,
 	INIT_WORK(&ab->restart_work, ath11k_core_restart);
 	INIT_WORK(&ab->update_11d_work, ath11k_update_11d);
 	INIT_WORK(&ab->reset_work, ath11k_core_reset);
+	INIT_DELAYED_WORK(&ab->reset_retry_work, ath11k_core_reset_retry);
 	INIT_WORK(&ab->dump_work, ath11k_coredump_upload);
 	timer_setup(&ab->rx_replenish_retry, ath11k_ce_rx_replenish_retry, 0);
 	init_completion(&ab->htc_suspend);
diff --git a/drivers/net/wireless/ath/ath11k/core.h b/drivers/net/wireless/ath/ath11k/core.h
index c67055876..99b64befb 100644
--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -66,9 +66,13 @@ extern bool ath11k_ftm_mode;
 
 #define ATH11K_MON_TIMER_INTERVAL  10
 #define ATH11K_RESET_TIMEOUT_HZ (20 * HZ)
-#define ATH11K_RESET_MAX_FAIL_COUNT_FIRST 3
-#define ATH11K_RESET_MAX_FAIL_COUNT_FINAL 5
-#define ATH11K_RESET_FAIL_TIMEOUT_HZ (20 * HZ)
+/* A crash this soon after the previous reset continues a crash loop. */
+#define ATH11K_RESET_LOOP_WINDOW_SEC (10 * 60)
+/* Resets of a crash loop that run at once, and in total. */
+#define ATH11K_RESET_LOOP_FREE 2
+#define ATH11K_RESET_LOOP_MAX 6
+/* Past the free ones, the time from one reset to the next, doubling. */
+#define ATH11K_RESET_LOOP_BACKOFF_SEC 30
 #define ATH11K_RECONFIGURE_TIMEOUT_HZ (10 * HZ)
 #define ATH11K_RECOVER_START_TIMEOUT_HZ (20 * HZ)
 #define ATH11K_RECOVERY_WAKEUP_MS (60 * MSEC_PER_SEC)
@@ -294,7 +298,7 @@ enum ath11k_dev_flags {
 	ATH11K_FLAG_FTM_SEGMENTED,
 	/* from PM_SUSPEND_PREPARE until PM_POST_SUSPEND (or hibernation) */
 	ATH11K_FLAG_SYSTEM_SUSPEND,
-	/* the firmware crashed during a system suspend, not recovered yet */
+	/* a firmware crash waits for a system suspend to end, or for its reset */
 	ATH11K_FLAG_CRASH_PENDING,
 };
 
@@ -1038,9 +1042,10 @@ struct ath11k_base {
 	struct completion reset_complete;
 	struct completion reconfigure_complete;
 	struct completion recovery_start;
-	/* continuous recovery fail count */
-	atomic_t fail_cont_count;
-	unsigned long reset_fail_timeout;
+	struct delayed_work reset_retry_work;
+	/* resets in this crash loop, boottime of the last one or of a crash after it gave up */
+	unsigned int reset_loop;
+	time64_t reset_time;
 	struct {
 		/* protected by data_lock */
 		u32 fw_crash_counter;
diff --git a/drivers/net/wireless/ath/ath11k/debugfs.c b/drivers/net/wireless/ath/ath11k/debugfs.c
index fba86cc50..f45a07a10 100644
--- a/drivers/net/wireless/ath/ath11k/debugfs.c
+++ b/drivers/net/wireless/ath/ath11k/debugfs.c
@@ -410,6 +410,7 @@ static ssize_t ath11k_write_simulate_fw_crash(struct file *file,
 						   ATH11K_WMI_FW_HANG_DELAY);
 	} else if (!strcmp(buf, "hw-restart")) {
 		ath11k_info(ab, "user requested hw restart\n");
+		ab->reset_loop = 0;
 		ath11k_core_schedule_reset(ab);
 		ret = 0;
 	} else {
diff --git a/drivers/net/wireless/ath/ath11k/mac.c b/drivers/net/wireless/ath/ath11k/mac.c
index 83379b5a4..ef3fb5069 100644
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -9307,7 +9307,6 @@ ath11k_mac_op_reconfig_complete(struct ieee80211_hw *hw,
 			 */
 			if (recovery_count == ab->num_radios) {
 				ab->is_reset = false;
-				atomic_set(&ab->fail_cont_count, 0);
 				/*
 				 * Stay awake a little longer: WoW on firmware
 				 * that has only just restarted crashes it again,
diff --git a/drivers/net/wireless/ath/ath11k/pci.c b/drivers/net/wireless/ath/ath11k/pci.c
index a163168f3..6a35f5b18 100644
--- a/drivers/net/wireless/ath/ath11k/pci.c
+++ b/drivers/net/wireless/ath/ath11k/pci.c
@@ -1192,6 +1192,7 @@ static void ath11k_pci_remove(struct pci_dev *pdev)
 	set_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags);
 
 	cancel_work_sync(&ab->reset_work);
+	cancel_delayed_work_sync(&ab->reset_retry_work);
 	cancel_work_sync(&ab->dump_work);
 	ath11k_core_deinit(ab);
 
@@ -1220,6 +1221,7 @@ static void ath11k_pci_shutdown(struct pci_dev *pdev)
 	spin_unlock_bh(&ab->base_lock);
 
 	cancel_work_sync(&ab->reset_work);
+	cancel_delayed_work_sync(&ab->reset_retry_work);
 	cancel_work_sync(&ab->dump_work);
 
 	ath11k_pci_power_down(ab, false);
