diff --git a/hwc/HwcDisplay.cpp b/hwc/HwcDisplay.cpp
index 3b712bd..7c40df8 100644
--- a/hwc/HwcDisplay.cpp
+++ b/hwc/HwcDisplay.cpp
@@ -871,7 +871,22 @@ void HwcDisplay::GetHdrCapabilities(std::vector<ui::Hdr> *types,
                                     float *max_luminance,
                                     float *max_average_luminance,
                                     float *min_luminance) {
-  if (IsInHeadlessMode() || !hwc_->GetResMan().UseColorPipeline()) {
+  if (IsInHeadlessMode()) {
+    return;
+  }
+
+  // A panel without HDR metadata still shows HDR through SurfaceFlinger's tone
+  // mapping, with headroom from the backlight. Apps look at these types to
+  // decide whether to send HDR. Leaving the luminance at 0 keeps the default
+  // tone mapping target of SurfaceFlinger.
+  if (GetPipe().connector->Get()->IsInternal() &&
+      hwc_->GetResMan().ForceHdrSupport()) {
+    types->push_back(ui::Hdr::HDR10);
+    types->push_back(ui::Hdr::HLG);
+    return;
+  }
+
+  if (!hwc_->GetResMan().UseColorPipeline()) {
     return;
   }
 
@@ -1309,6 +1324,12 @@ bool HwcDisplay::ColorConversionByGpu(const HwcLayer *layer) const {
     return false;
   }
 
+  // SurfaceFlinger stops forcing HDR layers to the GPU once the display declares
+  // HDR types, but only the GPU path tone maps them.
+  if (layer->IsHdr()) {
+    return true;
+  }
+
   // Otherwise there is no per-plane gamut mapping, so scanning out a layer that
   // isn't already in the output's color space would show the wrong colors.
   const bool p3_layer = layer->GetColorspace() == Colorspace::kDciP3RgbD65;
