@@ -809,7 +811,8 @@ void ComposerClient::ExecuteDisplayCommand(const DisplayCommand& command) {
           display_handle,
           deep_target ? common::PixelFormat::RGBA_1010102
                       : common::PixelFormat::RGBA_8888,
-          common::Dataspace::SRGB);
+          display->IsP3Output() ? common::Dataspace::DISPLAY_P3
