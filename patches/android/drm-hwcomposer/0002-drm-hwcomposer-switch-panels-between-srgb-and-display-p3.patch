 auto HwcDisplay::GetColorModes() -> std::vector<ColorMode> {
-  if (IsInHeadlessMode() || !hwc_->GetResMan().UseColorPipeline()) {
+  if (IsInHeadlessMode()) {
+    return {ColorMode::kNative};
+  }
+
+  if (!hwc_->GetResMan().UseColorPipeline()) {
+    // The display driver follows the connector's colorspace property. sRGB
+    // has to be listed as well, or SurfaceFlinger would never leave P3, and
+    // every display has to support native.
+    auto *connector = GetPipe().connector->Get();
+    if (connector->IsInternal() && hwc_->GetResMan().ForceP3Support() &&
+        connector->GetColorspaceProperty()) {
+      return {ColorMode::kNative, ColorMode::kSrgb, ColorMode::kDisplayP3};
+    }
     return {ColorMode::kNative};
   }
 
@@ -1282,6 +1294,25 @@ std::shared_ptr<BindingOwner<DrmPlane>> HwcDisplay::GetCursorPlane() const {
   return pipeline_->GetUsablePlanes().second;
 }
 
+bool HwcDisplay::IsP3Output() const {
+  return colorspace_ == Colorspace::kDciP3RgbD65;
+}
+
+bool HwcDisplay::ColorConversionByGpu(const HwcLayer *layer) const {
+  // Planes with a color pipeline convert on their own.
+  if (hwc_->GetResMan().UseColorPipeline()) {
+    return false;
+  }
+
+  // Otherwise there is no per-plane gamut mapping, so scanning out a layer that
+  // isn't already in the output's color space would show the wrong colors.
+  const bool p3_layer = layer->GetColorspace() == Colorspace::kDciP3RgbD65;
+  if (IsP3Output()) {
+    return !p3_layer || layer->GetTransferFunction() != TransferFunction::kSrgb;
+  }
+  return colorspace_ == Colorspace::kBt709Ycc && p3_layer;
+}
+
 bool HwcDisplay::CtmByGpu() const {
   if (color_transform_is_identity_)
     return false;
