From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] drm_hwcomposer: request a 10-bit client target when 10-bit layers use client composition

SurfaceFlinger defaults its client composition framebuffer to RGBA_8888, which
truncates 10-bit video layers to 8-bit whenever they fall back to GPU
composition (such as during display rotation where the DPU cannot rotate in
hardware).

Request RGBA_1010102 via ClientTargetProperty whenever a 10-bit layer is
assigned to CLIENT composition, the client target sits at the bottommost plane
slot, and the primary plane advertises ABGR2101010. Explicitly request
RGBA_8888 when switching back to 8-bit, and force the validate path whenever
the requested client target format changes so SurfaceFlinger reads the updated
ClientTargetProperty. Keep the client target at 8-bit when it is blended above
another plane because RGBA_1010102 only provides 2-bit alpha.

Origin: local
Upstream-Status: Pending
---
diff --git a/hwc/HwcDisplay.cpp b/hwc/HwcDisplay.cpp
index 7f3b7ee..7a1a9d0 100644
--- a/hwc/HwcDisplay.cpp
+++ b/hwc/HwcDisplay.cpp
@@ -22,6 +22,7 @@
 #include <cstdint>
 #include <sstream>
 
+#include <drm_fourcc.h>
 #include <ui/ColorSpace.h>
 #include <ui/GraphicTypes.h>
 #include <utils/Trace.h>
@@ -39,6 +40,7 @@
 #include "drm/DrmDisplayPipeline.h"
 #include "drm/DrmFbImporter.h"
 #include "drm/DrmHwc.h"
+#include "drm/DrmPlane.h"
 #include "drm/VSyncWorker.h"
 #include "hwc/HwcLayer.h"
 #include "stats/DisplayConfigurationResultReporter.h"
@@ -58,6 +60,10 @@ using FlattenReason = CompositionPlanner::FlattenReason;
 
 namespace {
 
+#ifndef DRM_FORMAT_P010
+#define DRM_FORMAT_P010 fourcc_code('P', '0', '1', '0')
+#endif
+
 constexpr auto kFlatteningTimeout = 1s;
 constexpr auto kHdcpRetryTimeout = 1s;
 
@@ -75,6 +81,19 @@ bool TransformHasOffsetValue(const float *matrix) {
   return false;
 }
 
+bool IsDeepFormat(uint32_t format) {
+  switch (format) {
+    case DRM_FORMAT_ABGR2101010:
+    case DRM_FORMAT_XBGR2101010:
+    case DRM_FORMAT_ARGB2101010:
+    case DRM_FORMAT_XRGB2101010:
+    case DRM_FORMAT_P010:
+      return true;
+    default:
+      return false;
+  }
+}
+
 }  // namespace
 
 auto HwcDisplay::GetDisplayName() const -> std::string {
@@ -1415,6 +1434,33 @@ bool HwcDisplay::NeedsClientLayerUpdate() const {
   });
 }
 
+bool HwcDisplay::NeedsDeepClientTarget() const {
+  if (IsInHeadlessMode()) {
+    return false;
+  }
+
+  // RGBA_1010102 has 2 bits of alpha, too few to blend over a device plane, so
+  // the client target has to be the bottom of the stack.
+  const auto layers = GetOrderLayersByZPos();
+  if (layers.empty() ||
+      layers.front()->GetValidatedType() != CompositionType::kClient) {
+    return false;
+  }
+
+  const bool has_deep_layer = std::any_of(
+      layers_.begin(), layers_.end(), [](const auto &pair) {
+        const auto &layer = pair.second;
+        const auto &buffer_info = layer.GetLayerData().bi;
+        return layer.GetValidatedType() == CompositionType::kClient &&
+               buffer_info.has_value() && IsDeepFormat(buffer_info->format);
+      });
+
+  // The client target is scanned out, so the plane has to accept it.
+  return has_deep_layer &&
+         pipeline_->primary_plane->Get()->IsFormatSupported(
+             DRM_FORMAT_ABGR2101010);
+}
+
 std::optional<LayerData> HwcDisplay::GetModesetLayerData(
     const HwcDisplayConfig *new_config) {
   const uint32_t new_width = new_config->mode.GetRawMode().hdisplay;
diff --git a/hwc/HwcDisplay.h b/hwc/HwcDisplay.h
index efbeb49..0576a6e 100644
--- a/hwc/HwcDisplay.h
+++ b/hwc/HwcDisplay.h
@@ -282,6 +282,10 @@ class HwcDisplay : public ICompositorDisplay {
 
   bool NeedsClientLayerUpdate() const;
 
+  // Whether client composition should go to a 10-bit target to keep the depth
+  // of its layers. Only meaningful after ValidateStagedComposition().
+  bool NeedsDeepClientTarget() const;
+
   std::pair<uint32_t, uint32_t> GetSize() const override;
 
   // Enable or disable the display.
diff --git a/hwc3/CommandResultWriter.h b/hwc3/CommandResultWriter.h
index 43999c4..98b2615 100644
--- a/hwc3/CommandResultWriter.h
+++ b/hwc3/CommandResultWriter.h
@@ -17,6 +17,7 @@
 #include <unordered_map>
 #include <vector>
 
+#include <aidl/android/hardware/graphics/composer3/ClientTargetPropertyWithBrightness.h>
 #include <aidl/android/hardware/graphics/composer3/CommandError.h>
 #include <aidl/android/hardware/graphics/composer3/CommandResultPayload.h>
 #include <aidl/android/hardware/graphics/composer3/PresentFence.h>
@@ -127,6 +128,19 @@ class CommandResultWriter {
     }
   }
 
+  void AddClientTargetProperty(int64_t display_handle,
+                               common::PixelFormat format,
+                               common::Dataspace dataspace) {
+    ClientTargetPropertyWithBrightness property;
+    property.display = display_handle;
+    property.clientTargetProperty.pixelFormat = format;
+    property.clientTargetProperty.dataspace = dataspace;
+    property.brightness = 1.F;
+    property.dimmingStage = DimmingStage::NONE;
+
+    results_->emplace_back(property);
+  }
+
   void AddPresentOrValidateResult(int64_t display_handle,
                                   const PresentOrValidate::Result& pov_result) {
     PresentOrValidate pov_command;
diff --git a/hwc3/ComposerClient.cpp b/hwc3/ComposerClient.cpp
index 0e5d7d9..445bbaa 100644
--- a/hwc3/ComposerClient.cpp
+++ b/hwc3/ComposerClient.cpp
@@ -780,6 +780,7 @@ void ComposerClient::ExecuteDisplayCommand(const DisplayCommand& command) {
   }
 
   bool shall_present_now = false;
+  bool client_target_changed = false;
 
   DisplayChanges changes{};
   if (command.validateDisplay || command.presentOrValidateDisplay) {
@@ -798,6 +799,20 @@ void ComposerClient::ExecuteDisplayCommand(const DisplayCommand& command) {
     }
     cmd_result_writer_->AddChanges(changes);
     auto hwc3_display = DrmHwcThree::GetHwc3Display(*display);
+
+    // SF keeps the last requested format when none is sent, so the way back to
+    // 8 bits has to be requested too.
+    const bool deep_target = display->NeedsDeepClientTarget();
+    client_target_changed = deep_target != hwc3_display->deep_client_target;
+    if (deep_target || client_target_changed) {
+      cmd_result_writer_->AddClientTargetProperty(
+          display_handle,
+          deep_target ? common::PixelFormat::RGBA_1010102
+                      : common::PixelFormat::RGBA_8888,
+          common::Dataspace::SRGB);
+    }
+    hwc3_display->deep_client_target = deep_target;
+
     hwc_->ClearMustValidateDisplay(display_handle);
     hwc3_display->desired_present_time = AidlToPresentTimeNs(
         command.expectedPresentTime);
@@ -807,7 +822,8 @@ void ComposerClient::ExecuteDisplayCommand(const DisplayCommand& command) {
 
   if (command.presentOrValidateDisplay) {
     auto result = PresentOrValidate::Result::Validated;
-    if (!display->NeedsClientLayerUpdate() && !changes.HasAnyChanges()) {
+    if (!display->NeedsClientLayerUpdate() && !changes.HasAnyChanges() &&
+        !client_target_changed) {
       ALOGV("Skipping SF roundtrip for display %" PRId64, display_handle);
       result = PresentOrValidate::Result::Presented;
       shall_present_now = true;
diff --git a/hwc3/DrmHwcThree.h b/hwc3/DrmHwcThree.h
index 4b5670c..619a784 100644
--- a/hwc3/DrmHwcThree.h
+++ b/hwc3/DrmHwcThree.h
@@ -30,6 +30,7 @@ class Hwc3Display : public ::android::drm_hwcomposer::FrontendDisplayBase {
   // Desired present time for a composition that has been validated but not
   // yet presented. nullopt means it should be presented at the next vsync.
   std::optional<int64_t> desired_present_time = std::nullopt;
+  bool deep_client_target = false;
 
   int64_t next_layer_id = 1;
 };
