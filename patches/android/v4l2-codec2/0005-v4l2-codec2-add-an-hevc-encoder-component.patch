+// Copyright 2026 The gaokun-android contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef ANDROID_V4L2_CODEC2_COMMON_HEVC_H
+#define ANDROID_V4L2_CODEC2_COMMON_HEVC_H
+
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include <C2Config.h>
+
+#include <ui/Size.h>
+
+namespace android {
+
+// Tables A.8 and A.9 in the H.265 spec, Main tier. maxBR is CpbBrVclFactor (1000 for the Main
+// profile) times MaxBR.
+struct HEVCLevelLimits {
+    C2Config::level_t level;
+    uint64_t maxLumaPs;  // max luma picture size in samples
+    uint64_t maxLumaSr;  // max luma sample rate in samples per second
+    uint32_t maxBR;      // max video bitrate in bits per second
+};
+
+constexpr HEVCLevelLimits kHEVCLimits[] = {
+        {C2Config::LEVEL_HEVC_MAIN_1, 36864, 552960, 128000},
+        {C2Config::LEVEL_HEVC_MAIN_2, 122880, 3686400, 1500000},
+        {C2Config::LEVEL_HEVC_MAIN_2_1, 245760, 7372800, 3000000},
+        {C2Config::LEVEL_HEVC_MAIN_3, 552960, 16588800, 6000000},
+        {C2Config::LEVEL_HEVC_MAIN_3_1, 983040, 33177600, 10000000},
+        {C2Config::LEVEL_HEVC_MAIN_4, 2228224, 66846720, 12000000},
+        {C2Config::LEVEL_HEVC_MAIN_4_1, 2228224, 133693440, 20000000},
+        {C2Config::LEVEL_HEVC_MAIN_5, 8912896, 267386880, 25000000},
+        {C2Config::LEVEL_HEVC_MAIN_5_1, 8912896, 534773760, 40000000},
+        {C2Config::LEVEL_HEVC_MAIN_5_2, 8912896, 1069547520, 60000000},
+        {C2Config::LEVEL_HEVC_MAIN_6, 35651584, 1069547520, 60000000},
+        {C2Config::LEVEL_HEVC_MAIN_6_1, 35651584, 2139095040, 120000000},
+        {C2Config::LEVEL_HEVC_MAIN_6_2, 35651584, 4278190080, 240000000},
+};
+
+inline bool isHEVCProfile(C2Config::profile_t profile) {
+    return (profile >= C2Config::PROFILE_HEVC_MAIN && profile <= C2Config::PROFILE_HEVC_3D_MAIN);
+}
+
+// Luma samples of the coded picture: the encoder codes whole minimum coding blocks (8x8).
+uint64_t lumaPictureSizeHEVC(const ui::Size& videoSize);
+
+// Whether |videoSize| at |frameRate| and |bitrate| fits |limit|, including the A.4.1 bound on
+// each picture dimension (sqrt(MaxLumaPs * 8)).
+bool fitsLevelHEVC(const HEVCLevelLimits& limit, const ui::Size& videoSize, float frameRate,
+                   uint32_t bitrate);
+
+uint32_t maxFramerateForLevelHEVC(C2Config::level_t level, const ui::Size& videoSize);
+
+// Convert a Main tier C2 level to the V4L2 HEVC level control value.
+std::optional<uint8_t> c2LevelToV4L2LevelHEVC(C2Config::level_t level);
+
+// Find the VPS, SPS and PPS NAL units in |data|. Returns true only if all three are found.
+bool extractParamSetsHEVC(const uint8_t* data, size_t length, std::vector<uint8_t>* vps,
+                          std::vector<uint8_t>* sps, std::vector<uint8_t>* pps);
+
+// Extract the codec-specific data (VPS, SPS and PPS, each with a 4-byte start code) from the first
+// encoded buffer.
+bool extractCSDInfoHEVC(std::unique_ptr<C2StreamInitDataInfo::output>* const csd,
+                        const uint8_t* data, size_t length);
+
+// Copy |src| to |dst|, inserting the cached VPS, SPS and PPS before an IRAP picture (IDR or CRA)
+// that comes without them. Parameter sets found in |src| refresh the cache. Returns the size
+// written to |dst|, or 0 if it doesn't fit or nothing is cached yet.
+size_t prependParamSetsToIRAPHEVC(const uint8_t* src, size_t srcSize, uint8_t* dst, size_t dstSize,
+                                  std::vector<uint8_t>* vps, std::vector<uint8_t>* sps,
+                                  std::vector<uint8_t>* pps);
+
+}  // namespace android
+
+#endif  // ANDROID_V4L2_CODEC2_COMMON_HEVC_H
