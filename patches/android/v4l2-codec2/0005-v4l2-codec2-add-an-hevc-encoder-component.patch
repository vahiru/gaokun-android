+// Copyright 2026 The gaokun-android contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//#define LOG_NDEBUG 0
+#define LOG_TAG "HEVC"
+
+#include <v4l2_codec2/common/HEVC.h>
+
+#include <math.h>
+#include <string.h>
+
+#include <limits>
+
+#include <linux/videodev2.h>
+#include <log/log.h>
+
+#include <v4l2_codec2/common/HEVCNalParser.h>
+
+namespace android {
+
+namespace {
+
+// NAL unit types (Table 7-1 in the H.265 spec).
+constexpr uint8_t kIDRWRADLType = 19;
+constexpr uint8_t kIDRNLPType = 20;
+constexpr uint8_t kCRAType = 21;
+constexpr uint8_t kVPSType = 32;
+constexpr uint8_t kSPSType = 33;
+constexpr uint8_t kPPSType = 34;
+
+// Android frameworks need a 4-byte start code.
+constexpr uint8_t kStartCode[] = {0x00, 0x00, 0x00, 0x01};
+constexpr size_t kStartCodeSize = sizeof(kStartCode);
+
+bool copyNALUPrependingStartCode(const uint8_t* src, size_t srcSize, uint8_t** dst,
+                                 size_t* dstSize) {
+    size_t naluSize = srcSize + kStartCodeSize;
+    if (naluSize > *dstSize) {
+        ALOGE("Couldn't copy NAL unit, not enough space in destination buffer");
+        return false;
+    }
+    memcpy(*dst, kStartCode, kStartCodeSize);
+    memcpy(*dst + kStartCodeSize, src, srcSize);
+    *dst += naluSize;
+    *dstSize -= naluSize;
+    return true;
+}
+
+void cacheNALU(const HEVCNalParser& parser, std::vector<uint8_t>* cache) {
+    cache->assign(parser.data(), parser.data() + parser.length());
+}
+
+bool isIRAP(uint8_t type) {
+    return type == kIDRWRADLType || type == kIDRNLPType || type == kCRAType;
+}
+
+}  // namespace
+
+uint64_t lumaPictureSizeHEVC(const ui::Size& videoSize) {
+    return static_cast<uint64_t>((videoSize.width + 7) & ~7) * ((videoSize.height + 7) & ~7);
+}
+
+bool fitsLevelHEVC(const HEVCLevelLimits& limit, const ui::Size& videoSize, float frameRate,
+                   uint32_t bitrate) {
+    const uint64_t lumaPs = lumaPictureSizeHEVC(videoSize);
+    const double maxDimension = sqrt(static_cast<double>(limit.maxLumaPs) * 8);
+    return lumaPs <= limit.maxLumaPs && videoSize.width <= maxDimension &&
+           videoSize.height <= maxDimension &&
+           static_cast<double>(lumaPs) * frameRate <= static_cast<double>(limit.maxLumaSr) &&
+           bitrate <= limit.maxBR;
+}
+
+uint32_t maxFramerateForLevelHEVC(C2Config::level_t level, const ui::Size& videoSize) {
+    const uint64_t lumaPs = lumaPictureSizeHEVC(videoSize);
+    for (const HEVCLevelLimits& limit : kHEVCLimits) {
+        if (limit.level == level && lumaPs > 0) return limit.maxLumaSr / lumaPs;
+    }
+    ALOGW("%s - failed to find matching HEVC level=%d", __func__, level);
+    return std::numeric_limits<uint32_t>::max();
+}
+
+std::optional<uint8_t> c2LevelToV4L2LevelHEVC(C2Config::level_t level) {
+    switch (level) {
+    case C2Config::LEVEL_HEVC_MAIN_1:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_1;
+    case C2Config::LEVEL_HEVC_MAIN_2:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_2;
+    case C2Config::LEVEL_HEVC_MAIN_2_1:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_2_1;
+    case C2Config::LEVEL_HEVC_MAIN_3:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_3;
+    case C2Config::LEVEL_HEVC_MAIN_3_1:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_3_1;
+    case C2Config::LEVEL_HEVC_MAIN_4:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_4;
+    case C2Config::LEVEL_HEVC_MAIN_4_1:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_4_1;
+    case C2Config::LEVEL_HEVC_MAIN_5:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_5;
+    case C2Config::LEVEL_HEVC_MAIN_5_1:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_5_1;
+    case C2Config::LEVEL_HEVC_MAIN_5_2:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_5_2;
+    case C2Config::LEVEL_HEVC_MAIN_6:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_6;
+    case C2Config::LEVEL_HEVC_MAIN_6_1:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_6_1;
+    case C2Config::LEVEL_HEVC_MAIN_6_2:
+        return V4L2_MPEG_VIDEO_HEVC_LEVEL_6_2;
+    default:
+        ALOGE("Unrecognizable HEVC C2 level (value = 0x%x)...", level);
+        return std::nullopt;
+    }
+}
+
+bool extractParamSetsHEVC(const uint8_t* data, size_t length, std::vector<uint8_t>* vps,
+                          std::vector<uint8_t>* sps, std::vector<uint8_t>* pps) {
+    bool foundVPS = false;
+    bool foundSPS = false;
+    bool foundPPS = false;
+    HEVCNalParser parser(data, length);
+    while (!(foundVPS && foundSPS && foundPPS) && parser.locateNextNal()) {
+        if (parser.length() == 0) continue;
+        switch (parser.type()) {
+        case kVPSType:
+            cacheNALU(parser, vps);
+            foundVPS = true;
+            break;
+        case kSPSType:
+            cacheNALU(parser, sps);
+            foundSPS = true;
+            break;
+        case kPPSType:
+            cacheNALU(parser, pps);
+            foundPPS = true;
+            break;
+        }
+    }
+    return foundVPS && foundSPS && foundPPS;
+}
+
+bool extractCSDInfoHEVC(std::unique_ptr<C2StreamInitDataInfo::output>* const csd,
+                        const uint8_t* data, size_t length) {
+    csd->reset();
+
+    std::vector<uint8_t> vps;
+    std::vector<uint8_t> sps;
+    std::vector<uint8_t> pps;
+    if (!extractParamSetsHEVC(data, length, &vps, &sps, &pps)) {
+        return false;
+    }
+
+    size_t configDataLength = vps.size() + sps.size() + pps.size() + (3u * kStartCodeSize);
+    ALOGV("Extracted codec config data: length=%zu", configDataLength);
+
+    *csd = C2StreamInitDataInfo::output::AllocUnique(configDataLength, 0u);
+    uint8_t* csdBuffer = (*csd)->m.value;
+    return copyNALUPrependingStartCode(vps.data(), vps.size(), &csdBuffer, &configDataLength) &&
+           copyNALUPrependingStartCode(sps.data(), sps.size(), &csdBuffer, &configDataLength) &&
+           copyNALUPrependingStartCode(pps.data(), pps.size(), &csdBuffer, &configDataLength);
+}
+
+size_t prependParamSetsToIRAPHEVC(const uint8_t* src, size_t srcSize, uint8_t* dst, size_t dstSize,
+                                  std::vector<uint8_t>* vps, std::vector<uint8_t>* sps,
+                                  std::vector<uint8_t>* pps) {
+    bool foundParamSets = false;
+    bool injected = false;
+    size_t remainingDstSize = dstSize;
+    HEVCNalParser parser(src, srcSize);
+    while (parser.locateNextNal()) {
+        if (parser.length() == 0) continue;
+        const uint8_t type = parser.type();
+        switch (type) {
+        case kVPSType:
+            cacheNALU(parser, vps);
+            foundParamSets = true;
+            break;
+        case kSPSType:
+            cacheNALU(parser, sps);
+            foundParamSets = true;
+            break;
+        case kPPSType:
+            cacheNALU(parser, pps);
+            foundParamSets = true;
+            break;
+        default:
+            // Only the first slice of the picture gets the parameter sets.
+            if (!isIRAP(type) || foundParamSets || injected) break;
+
+            if (vps->empty() || sps->empty() || pps->empty()) {
+                ALOGE("No cached VPS, SPS or PPS NAL unit available to inject before IRAP");
+                return 0;
+            }
+            if (!copyNALUPrependingStartCode(vps->data(), vps->size(), &dst, &remainingDstSize) ||
+                !copyNALUPrependingStartCode(sps->data(), sps->size(), &dst, &remainingDstSize) ||
+                !copyNALUPrependingStartCode(pps->data(), pps->size(), &dst, &remainingDstSize)) {
+                ALOGE("Not enough space to inject parameter sets before IRAP");
+                return 0;
+            }
+            injected = true;
+            ALOGV("Parameter sets injected before IRAP (type %u)", type);
+            break;
+        }
+
+        // Copy the NAL unit to the new output buffer.
+        if (!copyNALUPrependingStartCode(parser.data(), parser.length(), &dst, &remainingDstSize)) {
+            ALOGE("NAL unit does not fit in the provided output buffer");
+            return 0;
+        }
+    }
+
+    return dstSize - remainingDstSize;
+}
+
+}  // namespace android
