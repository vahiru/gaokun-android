+// static
+C2R DecodeInterface::HdrStaticInfoSetter(bool /* mayBlock */,
+                                         C2P<C2StreamHdrStaticInfo::output>& info) {
+    const auto clamp = [](float value, float max) { return std::clamp(value, 0.f, max); };
+    C2StreamHdrStaticInfo::output& m = info.set();
+    m.mastering.red.x = clamp(m.mastering.red.x, 1.f);
+    m.mastering.red.y = clamp(m.mastering.red.y, 1.f);
+    m.mastering.green.x = clamp(m.mastering.green.x, 1.f);
+    m.mastering.green.y = clamp(m.mastering.green.y, 1.f);
+    m.mastering.blue.x = clamp(m.mastering.blue.x, 1.f);
+    m.mastering.blue.y = clamp(m.mastering.blue.y, 1.f);
+    m.mastering.white.x = clamp(m.mastering.white.x, 1.f);
+    m.mastering.white.y = clamp(m.mastering.white.y, 1.f);
+    m.mastering.maxLuminance = clamp(m.mastering.maxLuminance, 65535.f);
+    m.mastering.minLuminance = clamp(m.mastering.minLuminance, 6.5535f);
+    m.maxCll = clamp(m.maxCll, 65535.f);
+    m.maxFall = clamp(m.maxFall, 65535.f);
+    return C2R::Ok();
+}
