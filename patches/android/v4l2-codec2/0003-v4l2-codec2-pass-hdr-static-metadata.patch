From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] v4l2_codec2: declare C2StreamHdrStaticInfo and attach it to decoded frames

Android's Codec2InfoBuilder only advertises HEVC Main10HDR10 profiles when the
decoder component declares C2StreamHdrStaticInfo::output. Add the parameter to
V4L2DecodeInterface for HEVC and VP9, and attach the current static HDR
metadata to each decoded output frame buffer in V4L2DecodeComponent so
SurfaceFlinger receives the container's mastering display and content light
level metadata.

Origin: local
Upstream-Status: Pending
---
diff --git a/components/DecodeComponent.cpp b/components/DecodeComponent.cpp
index 305b1ff..d1e9b2b 100644
--- a/components/DecodeComponent.cpp
+++ b/components/DecodeComponent.cpp
@@ -622,6 +622,10 @@ void DecodeComponent::onOutputFrameReady(std::unique_ptr<VideoFrame> frame) {
     if (mCurrentColorAspects) {
         buffer->setInfo(mCurrentColorAspects);
     }
+    std::shared_ptr<C2StreamHdrStaticInfo::output> hdrStaticInfo;
+    if (mIntfImpl->queryHdrStaticInfo(&hdrStaticInfo) == C2_OK) {
+        buffer->setInfo(hdrStaticInfo);
+    }
     work->worklets.front()->output.buffers.emplace_back(std::move(buffer));
 
     // Check no-show frame by timestamps for VP8/VP9 cases before reporting the current work.
diff --git a/components/DecodeInterface.cpp b/components/DecodeInterface.cpp
index db560db..3d751d3 100644
--- a/components/DecodeInterface.cpp
+++ b/components/DecodeInterface.cpp
@@ -7,6 +7,8 @@
 
 #include <v4l2_codec2/components/DecodeInterface.h>
 
+#include <algorithm>
+
 #include <C2PlatformSupport.h>
 #include <SimpleC2Interface.h>
 #include <android/hardware/graphics/common/1.0/types.h>
@@ -81,6 +83,26 @@ C2R DecodeInterface::DefaultColorAspectsSetter(bool /* mayBlock */, C2P<T>& def)
     return C2R::Ok();
 }
 
+// static
+C2R DecodeInterface::HdrStaticInfoSetter(bool /* mayBlock */,
+                                         C2P<C2StreamHdrStaticInfo::output>& info) {
+    const auto clamp = [](float value, float max) { return std::clamp(value, 0.f, max); };
+    C2StreamHdrStaticInfo::output& m = info.set();
+    m.mastering.red.x = clamp(m.mastering.red.x, 1.f);
+    m.mastering.red.y = clamp(m.mastering.red.y, 1.f);
+    m.mastering.green.x = clamp(m.mastering.green.x, 1.f);
+    m.mastering.green.y = clamp(m.mastering.green.y, 1.f);
+    m.mastering.blue.x = clamp(m.mastering.blue.x, 1.f);
+    m.mastering.blue.y = clamp(m.mastering.blue.y, 1.f);
+    m.mastering.white.x = clamp(m.mastering.white.x, 1.f);
+    m.mastering.white.y = clamp(m.mastering.white.y, 1.f);
+    m.mastering.maxLuminance = clamp(m.mastering.maxLuminance, 65535.f);
+    m.mastering.minLuminance = clamp(m.mastering.minLuminance, 6.5535f);
+    m.maxCll = clamp(m.maxCll, 65535.f);
+    m.maxFall = clamp(m.maxFall, 65535.f);
+    return C2R::Ok();
+}
+
 // static
 C2R DecodeInterface::MergedColorAspectsSetter(bool /* mayBlock */,
                                               C2P<C2StreamColorAspectsInfo::output>& merged,
@@ -407,6 +429,29 @@ DecodeInterface::DecodeInterface(const std::string& name,
                     .withSetter(DefaultColorAspectsSetter)
                     .build());
 
+    if (mVideoCodec == VideoCodec::HEVC || mVideoCodec == VideoCodec::VP9) {
+        helper->addStructDescriptors<C2MasteringDisplayColorVolumeStruct, C2ColorXyStruct>();
+        addParameter(DefineParam(mHdrStaticInfo, C2_PARAMKEY_HDR_STATIC_INFO)
+                             .withDefault(new C2StreamHdrStaticInfo::output(
+                                     0u, C2HdrStaticMetadataStruct{}))
+                             .withFields({C2F(mHdrStaticInfo, mastering.red.x).inRange(0, 1),
+                                          C2F(mHdrStaticInfo, mastering.red.y).inRange(0, 1),
+                                          C2F(mHdrStaticInfo, mastering.green.x).inRange(0, 1),
+                                          C2F(mHdrStaticInfo, mastering.green.y).inRange(0, 1),
+                                          C2F(mHdrStaticInfo, mastering.blue.x).inRange(0, 1),
+                                          C2F(mHdrStaticInfo, mastering.blue.y).inRange(0, 1),
+                                          C2F(mHdrStaticInfo, mastering.white.x).inRange(0, 1),
+                                          C2F(mHdrStaticInfo, mastering.white.y).inRange(0, 1),
+                                          C2F(mHdrStaticInfo, mastering.maxLuminance)
+                                                  .inRange(0, 65535),
+                                          C2F(mHdrStaticInfo, mastering.minLuminance)
+                                                  .inRange(0, 6.5535),
+                                          C2F(mHdrStaticInfo, maxCll).inRange(0, 65535),
+                                          C2F(mHdrStaticInfo, maxFall).inRange(0, 65535)})
+                             .withSetter(HdrStaticInfoSetter)
+                             .build());
+    }
+
     // At this moment v4l2_codec2 support decoding this information only for
     // unprotected H264 and both protected and unprotected HEVC.
     if ((mVideoCodec == VideoCodec::H264 && !secureMode) || mVideoCodec == VideoCodec::HEVC) {
@@ -436,6 +481,23 @@ size_t DecodeInterface::getInputBufferSize() const {
     return mMaxInputSize->value;
 }
 
+c2_status_t DecodeInterface::queryHdrStaticInfo(
+        std::shared_ptr<C2StreamHdrStaticInfo::output>* targetInfo) {
+    if (!mHdrStaticInfo) {
+        return C2_NOT_FOUND;
+    }
+    auto info = std::make_unique<C2StreamHdrStaticInfo::output>(0u, C2HdrStaticMetadataStruct{});
+    c2_status_t status = query({info.get()}, {}, C2_DONT_BLOCK, nullptr);
+    if (status != C2_OK) {
+        return status;
+    }
+    if (info->mastering.maxLuminance <= 0.f && info->maxCll <= 0.f) {
+        return C2_NOT_FOUND;
+    }
+    *targetInfo = std::move(info);
+    return C2_OK;
+}
+
 c2_status_t DecodeInterface::queryColorAspects(
         std::shared_ptr<C2StreamColorAspectsInfo::output>* targetColorAspects) {
     std::unique_ptr<C2StreamColorAspectsInfo::output> colorAspects =
diff --git a/components/include/v4l2_codec2/components/DecodeInterface.h b/components/include/v4l2_codec2/components/DecodeInterface.h
index 7e513c5..d5c006b 100644
--- a/components/include/v4l2_codec2/components/DecodeInterface.h
+++ b/components/include/v4l2_codec2/components/DecodeInterface.h
@@ -35,6 +35,8 @@ public:
     size_t getInputBufferSize() const;
     c2_status_t queryColorAspects(
             std::shared_ptr<C2StreamColorAspectsInfo::output>* targetColorAspects);
+    // Returns C2_NOT_FOUND when the client gave no HDR static metadata.
+    c2_status_t queryHdrStaticInfo(std::shared_ptr<C2StreamHdrStaticInfo::output>* targetInfo);
 
 private:
     // Configurable parameter setters.
@@ -48,6 +50,8 @@ private:
     template <typename T>
     static C2R DefaultColorAspectsSetter(bool mayBlock, C2P<T>& def);
 
+    static C2R HdrStaticInfoSetter(bool mayBlock, C2P<C2StreamHdrStaticInfo::output>& info);
+
     static C2R MergedColorAspectsSetter(bool mayBlock,
                                         C2P<C2StreamColorAspectsInfo::output>& merged,
                                         const C2P<C2StreamColorAspectsTuning::output>& def,
@@ -100,6 +104,10 @@ private:
     // as C2Info in decoded output buffers.
     std::shared_ptr<C2StreamColorAspectsInfo::output> mColorAspects;
 
+    // HDR static metadata from the container, set by the client. The framework advertises the HDR
+    // profiles of HEVC only for decoders with this parameter. Passed through with the output.
+    std::shared_ptr<C2StreamHdrStaticInfo::output> mHdrStaticInfo;
+
     c2_status_t mInitStatus;
     std::optional<VideoCodec> mVideoCodec;
 };
