+// A plane of a mapped picture: its first sample and the steps in bytes between samples and rows.
+struct PlaneRef {
+    const uint8_t* data;
+    int colInc;
+    int rowInc;
+};
+
+PlaneRef planeRef(const C2GraphicView& view, const C2PlanarLayout& layout, uint32_t plane) {
+    return {view.data()[plane], layout.planes[plane].colInc, layout.planes[plane].rowInc};
+}
+
+// Whether |layout| is P010: semi-planar 4:2:0 with 10-bit samples in the top bits of 16-bit words,
+// U before V. Gralloc describes it with the U and V planes two bytes apart.
+bool isP010(const C2GraphicView& view, const C2PlanarLayout& layout) {
+    const C2PlaneInfo& y = layout.planes[C2PlanarLayout::PLANE_Y];
+    const C2PlaneInfo& u = layout.planes[C2PlanarLayout::PLANE_U];
+    const C2PlaneInfo& v = layout.planes[C2PlanarLayout::PLANE_V];
+    return layout.type == C2PlanarLayout::TYPE_YUV && layout.rootPlanes == 2 && y.bitDepth == 10 &&
+           y.allocatedDepth == 16 && y.colInc == 2 && u.colInc == 4 && v.colInc == 4 &&
+           u.rowInc == v.rowInc &&
+           view.data()[C2PlanarLayout::PLANE_V] == view.data()[C2PlanarLayout::PLANE_U] + 2;
+}
+
+// Write 8-bit 4:2:0 samples (planar or semi-planar, either chroma order) as P010. P010 keeps a
+// 10-bit sample in the top bits of a 16-bit word, so an 8-bit sample moved to the top byte becomes
+// the 10-bit code four times its value: the same level at the higher bit depth, in limited range
+// (16-235 becomes 64-940) as in full range.
+void widenToP010(PlaneRef y, PlaneRef u, PlaneRef v, uint8_t* dstY, int dstStrideY, uint8_t* dstUV,
+                 int dstStrideUV, int width, int height) {
+    for (int row = 0; row < height; row++) {
+        const uint8_t* src = y.data + static_cast<ptrdiff_t>(row) * y.rowInc;
+        uint16_t* dst =
+                reinterpret_cast<uint16_t*>(dstY + static_cast<ptrdiff_t>(row) * dstStrideY);
+        if (y.colInc == 1) {
+            for (int col = 0; col < width; col++) dst[col] = static_cast<uint16_t>(src[col] << 8);
+        } else {
+            for (int col = 0; col < width; col++) {
+                dst[col] = static_cast<uint16_t>(src[col * y.colInc] << 8);
+            }
+        }
+    }
+    for (int row = 0; row < height / 2; row++) {
+        const uint8_t* srcU = u.data + static_cast<ptrdiff_t>(row) * u.rowInc;
+        const uint8_t* srcV = v.data + static_cast<ptrdiff_t>(row) * v.rowInc;
+        uint16_t* dst =
+                reinterpret_cast<uint16_t*>(dstUV + static_cast<ptrdiff_t>(row) * dstStrideUV);
+        for (int col = 0; col < width / 2; col++) {
+            dst[2 * col] = static_cast<uint16_t>(srcU[col * u.colInc] << 8);
+            dst[2 * col + 1] = static_cast<uint16_t>(srcV[col * v.colInc] << 8);
+        }
+    }
+}
+
+// The 8-bit code nearest to a P010 sample.
+inline uint8_t narrowP010Sample(const uint8_t* sample) {
+    uint16_t value;
+    memcpy(&value, sample, sizeof(value));
+    return static_cast<uint8_t>(std::min<uint32_t>((value + 0x80u) >> 8, 0xffu));
+}
+
+// Write P010 samples as NV12, rounding each to the nearest 8-bit code.
+void narrowP010ToNV12(PlaneRef y, PlaneRef u, PlaneRef v, uint8_t* dstY, int dstStrideY,
+                      uint8_t* dstUV, int dstStrideUV, int width, int height) {
+    for (int row = 0; row < height; row++) {
+        const uint8_t* src = y.data + static_cast<ptrdiff_t>(row) * y.rowInc;
+        uint8_t* dst = dstY + static_cast<ptrdiff_t>(row) * dstStrideY;
+        for (int col = 0; col < width; col++) dst[col] = narrowP010Sample(src + col * y.colInc);
+    }
+    for (int row = 0; row < height / 2; row++) {
+        const uint8_t* srcU = u.data + static_cast<ptrdiff_t>(row) * u.rowInc;
+        const uint8_t* srcV = v.data + static_cast<ptrdiff_t>(row) * v.rowInc;
+        uint8_t* dst = dstUV + static_cast<ptrdiff_t>(row) * dstStrideUV;
+        for (int col = 0; col < width / 2; col++) {
+            dst[2 * col] = narrowP010Sample(srcU + col * u.colInc);
+            dst[2 * col + 1] = narrowP010Sample(srcV + col * v.colInc);
+        }
+    }
+}
+
