+void FormatConverter::convertRgbToP010(const uint8_t* rgb, int rgbStride, uint8_t* dstY,
+                                       uint8_t* dstUV, int dstStride) {
+    // The same conversion as to NV12 for 8-bit coding (libyuv: BT.601 matrix, limited range), to
+    // an intermediate I420 frame, which is then widened. The 8-bit RGB frames have no more
+    // precision to keep.
+    const int width = mVisibleSize.width;
+    const int height = mVisibleSize.height;
+    const int tempStride = width / 2;
+    if (!mTempPlaneY) {
+        mTempPlaneY = std::unique_ptr<uint8_t[]>(new uint8_t[static_cast<size_t>(width) * height]);
+    }
+    libyuv::ABGRToI420(rgb, rgbStride, mTempPlaneY.get(), width, mTempPlaneU.get(), tempStride,
+                       mTempPlaneV.get(), tempStride, width, height);
+    widenToP010({mTempPlaneY.get(), 1, width}, {mTempPlaneU.get(), 1, tempStride},
+                {mTempPlaneV.get(), 1, tempStride}, dstY, dstStride, dstUV, dstStride, width,
+                height);
+}
