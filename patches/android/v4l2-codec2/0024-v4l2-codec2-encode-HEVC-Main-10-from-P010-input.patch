+// static
+void V4L2Device::queryEncoderInputCapabilities(uint32_t codedFormat, SupportedCapabilities* caps) {
+    for (const auto& info : getDeviceInfosForType(Type::kEncoder)) {
+        if (std::find(info.second.begin(), info.second.end(), codedFormat) == info.second.end()) {
+            continue;
+        }
+        scoped_refptr<V4L2Device> device = V4L2Device::create();
+        if (!device->openDevicePath(info.first, Type::kEncoder)) {
+            ALOGV("Failed opening %s", info.first.c_str());
+            continue;
+        }
+
+        // The raw formats of an encoder may depend on the coded format (stateful encoder
+        // interface), so set it before listing them.
+        struct v4l2_format format;
+        memset(&format, 0, sizeof(format));
+        format.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+        if (device->ioctl(VIDIOC_G_FMT, &format) == 0) {
+            format.fmt.pix_mp.pixelformat = codedFormat;
+            if (device->ioctl(VIDIOC_S_FMT, &format) == 0 &&
+                format.fmt.pix_mp.pixelformat == codedFormat) {
+                const auto rawFormats =
+                        device->enumerateSupportedPixelformats(V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+                caps->tenBitInput = std::find(rawFormats.begin(), rawFormats.end(),
+                                              V4L2_PIX_FMT_P010) != rawFormats.end();
+            }
+        }
+        device->closeDevice();
+
+        ALOGV("%s: 10-bit input %d", info.first.c_str(), caps->tenBitInput);
+        if (caps->tenBitInput) {
+            return;
+        }
+    }
+}
