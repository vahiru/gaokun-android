diff --git a/components/EncodeComponent.cpp b/components/EncodeComponent.cpp
index e25f33d..e64b7be 100644
--- a/components/EncodeComponent.cpp
+++ b/components/EncodeComponent.cpp
@@ -38,6 +38,18 @@ using android::hardware::graphics::common::V1_0::BufferUsage;
 namespace android {
 
 namespace {
+// The number of frames in a row the encoder may drop before the component reports an error. Frame
+// skipping is not enabled, so the encoder is not expected to drop any frame. After one second of
+// input at the usual 30 fps without a single encoded frame the encoder is assumed to be broken, and
+// the client is told so it can recover instead of waiting for output forever.
+constexpr uint32_t kMaxConsecutiveDroppedFrames = 30;
+
+// Whether |work| had a frame to encode and is still waiting for its bitstream.
+bool isWaitingForOutput(const C2Work& work) {
+    return !work.input.buffers.empty() && work.worklets.front()->output.buffers.empty() &&
+           !(work.worklets.front()->output.flags & C2FrameData::FLAG_DROP_FRAME);
+}
+
 // Create an input frame from the specified graphic block.
 std::unique_ptr<VideoEncoder::InputFrame> createInputFrame(
         const C2ConstGraphicBlock& block, VideoPixelFormat format,
@@ -591,9 +603,10 @@ void EncodeComponent::onDrainDone(bool success) {
         return;
     }
 
-    // Mark the item in the output work queue as EOS done.
+    // Mark the item in the output work queue as EOS done, keeping a dropped frame mark.
     C2Work* eosWork = it->get();
-    eosWork->worklets.back()->output.flags = C2FrameData::FLAG_END_OF_STREAM;
+    eosWork->worklets.back()->output.flags = static_cast<C2FrameData::flags_t>(
+            eosWork->worklets.back()->output.flags | C2FrameData::FLAG_END_OF_STREAM);
 
     // Draining is done which means all buffers on the device output queue have been returned, but
     // not all buffers on the device input queue might have been returned yet.
@@ -785,6 +798,7 @@ void EncodeComponent::flush() {
     ALOG_ASSERT(mEncoderTaskRunner->RunsTasksInCurrentSequence());
 
     mEncoder->flush();
+    mConsecutiveDroppedFrames = 0;
 
     // Report all queued work items as aborted.
     std::list<std::unique_ptr<C2Work>> abortedWorkItems;
@@ -875,6 +889,41 @@ void EncodeComponent::onOutputBufferDone(size_t dataSize, int64_t timestamp, boo
     ALOGV("%s(): output buffer done (timestamp: %" PRId64 ", size: %zu, keyframe: %d)", __func__,
           timestamp, dataSize, keyFrame);
     ALOG_ASSERT(mEncoderTaskRunner->RunsTasksInCurrentSequence());
+
+    // The encoder dropped the oldest frame still waiting for its bitstream. Complete its work item
+    // without output, so the work items behind it are not held up forever.
+    if (dataSize == 0) {
+        auto it = std::find_if(
+                mWorkQueue.begin(), mWorkQueue.end(),
+                [](const std::unique_ptr<C2Work>& w) { return isWaitingForOutput(*w); });
+        if (it == mWorkQueue.end()) {
+            ALOGW("Encoder dropped a frame, but no frame is waiting for output");
+            return;
+        }
+        C2Work* work = it->get();
+        work->worklets.front()->output.flags = static_cast<C2FrameData::flags_t>(
+                work->worklets.front()->output.flags | C2FrameData::FLAG_DROP_FRAME);
+        mConsecutiveDroppedFrames++;
+        ALOGW("Encoder dropped frame (index: %" PRIu64 ", timestamp: %" PRIu64
+              ", dropped in a row: %u)",
+              work->input.ordinal.frameIndex.peeku(), work->input.ordinal.timestamp.peeku(),
+              mConsecutiveDroppedFrames);
+        if (mConsecutiveDroppedFrames >= kMaxConsecutiveDroppedFrames) {
+            if (mConsecutiveDroppedFrames == kMaxConsecutiveDroppedFrames) {
+                ALOGE("Encoder dropped %u frames in a row", mConsecutiveDroppedFrames);
+                reportError(C2_CORRUPTED);
+            }
+            return;
+        }
+
+        while (!mWorkQueue.empty() && isWorkDone(*mWorkQueue.front())) {
+            reportWork(std::move(mWorkQueue.front()));
+            mWorkQueue.pop_front();
+        }
+        return;
+    }
+    mConsecutiveDroppedFrames = 0;
+
     ALOG_ASSERT(buffer->dmabuf);
 
     C2ConstLinearBlock constBlock =
@@ -988,8 +1037,9 @@ bool EncodeComponent::isWorkDone(const C2Work& work) const {
         return false;
     }
 
-    // If the work item had an input buffer to be encoded, it should have an output buffer set.
-    if (!work.input.buffers.empty() && work.worklets.front()->output.buffers.empty()) {
+    // If the work item had an input buffer to be encoded, it should have an output buffer set,
+    // unless the encoder dropped the frame.
+    if (isWaitingForOutput(work)) {
         ALOGV("Output buffer associated with work item %" PRIu64 " not returned yet",
               work.input.ordinal.frameIndex.peeku());
         return false;
