     // The queue of encode work items currently being processed.
     std::deque<std::unique_ptr<C2Work>> mWorkQueue;
+    // The number of frames the encoder dropped since it last returned an encoded frame.
+    uint32_t mConsecutiveDroppedFrames = 0;
 
     // The output block pool.
     std::shared_ptr<C2BlockPool> mOutputBlockPool;
diff --git a/components/include/v4l2_codec2/components/VideoEncoder.h b/components/include/v4l2_codec2/components/VideoEncoder.h
index eeb63c2..8941510 100644
--- a/components/include/v4l2_codec2/components/VideoEncoder.h
+++ b/components/include/v4l2_codec2/components/VideoEncoder.h
@@ -58,6 +58,9 @@ public:
             ::base::RepeatingCallback<void(uint32_t, std::unique_ptr<BitstreamBuffer>* buffer)>;
     // TODO(dstaessens): Change callbacks to OnceCallback provided when requesting encode/drain.
     using InputBufferDoneCB = ::base::RepeatingCallback<void(uint64_t)>;
+    // Called with the data size, timestamp, key frame flag and buffer of each encoded frame, in
+    // input order. A data size of 0 and a null buffer mean the encoder dropped the oldest frame
+    // that has no output yet.
     using OutputBufferDoneCB = ::base::RepeatingCallback<void(
             size_t, int64_t, bool, std::unique_ptr<BitstreamBuffer> buffer)>;
     using DrainDoneCB = ::base::RepeatingCallback<void(bool)>;
diff --git a/v4l2/V4L2Device.cpp b/v4l2/V4L2Device.cpp
index 05be881..3650563 100644
--- a/v4l2/V4L2Device.cpp
+++ b/v4l2/V4L2Device.cpp
@@ -640,6 +640,13 @@ bool V4L2ReadableBuffer::isKeyframe() const {
     return mBufferData->mV4l2Buffer.flags & V4L2_BUF_FLAG_KEYFRAME;
 }
 
+bool V4L2ReadableBuffer::isError() const {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(mSequenceChecker);
+    ALOG_ASSERT(mBufferData);
+
+    return mBufferData->mV4l2Buffer.flags & V4L2_BUF_FLAG_ERROR;
+}
+
 struct timeval V4L2ReadableBuffer::getTimeStamp() const {
     DCHECK_CALLED_ON_VALID_SEQUENCE(mSequenceChecker);
     ALOG_ASSERT(mBufferData);
diff --git a/v4l2/V4L2Encoder.cpp b/v4l2/V4L2Encoder.cpp
index d5adf3b..86ba4d5 100644
--- a/v4l2/V4L2Encoder.cpp
+++ b/v4l2/V4L2Encoder.cpp
@@ -1029,7 +1029,18 @@ bool V4L2Encoder::dequeueOutputBuffer() {
 
     std::unique_ptr<BitstreamBuffer> bitstreamBuffer =
             std::move(mOutputBuffers[buffer->bufferId()]);
-    if (encodedDataSize > 0) {
+    if (encodedDataSize == 0 || buffer->isError()) {
+        // An empty buffer marked as last only signals the end of a drain. Any other empty buffer,
+        // and any buffer marked as erroneous, stands for a frame the device dropped. Without
+        // B-frames the device returns the bitstream buffers in input order, so the client matches
+        // it to the oldest frame still waiting for its bitstream; the timestamp cannot be used,
+        // as drivers may return such buffers without one. The block goes back to the pool.
+        if (buffer->isError() || !buffer->isLast()) {
+            ALOGW("Device returned no bitstream for a frame (data size: %zu, error: %d)",
+                  encodedDataSize, buffer->isError());
+            mOutputBufferDoneCb.Run(0, timestamp.InMicroseconds(), false, nullptr);
+        }
+    } else {
         if (!mInjectParamsBeforeIDR) {
             // No need to inject SPS or PPS before IDR frames, we can just return the buffer as-is.
             mOutputBufferDoneCb.Run(encodedDataSize, timestamp.InMicroseconds(),
