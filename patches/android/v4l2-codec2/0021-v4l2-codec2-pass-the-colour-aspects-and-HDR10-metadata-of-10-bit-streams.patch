+std::optional<V4L2Colorimetry> c2ColorAspectsToV4L2Colorimetry(
+        const C2ColorAspectsStruct& aspects) {
+    V4L2Colorimetry colorimetry;
+    bool mapped = true;
+
+    // V4L2 names a colour space after its primaries; the other fields are set apart.
+    switch (aspects.primaries) {
+    case C2Color::PRIMARIES_UNSPECIFIED:
+        break;
+    case C2Color::PRIMARIES_BT709:
+        colorimetry.colorspace = V4L2_COLORSPACE_REC709;
+        break;
+    case C2Color::PRIMARIES_BT470_M:
+        colorimetry.colorspace = V4L2_COLORSPACE_470_SYSTEM_M;
+        break;
+    case C2Color::PRIMARIES_BT601_625:
+        colorimetry.colorspace = V4L2_COLORSPACE_470_SYSTEM_BG;
+        break;
+    case C2Color::PRIMARIES_BT601_525:
+        colorimetry.colorspace = V4L2_COLORSPACE_SMPTE170M;
+        break;
+    case C2Color::PRIMARIES_BT2020:
+        colorimetry.colorspace = V4L2_COLORSPACE_BT2020;
+        break;
+    case C2Color::PRIMARIES_RP431:
+        colorimetry.colorspace = V4L2_COLORSPACE_DCI_P3;
+        break;
+    default:
+        // Generic film, EG 432-1 (P3 with a D65 white point), EBU 3213 and others.
+        mapped = false;
+        break;
+    }
+
+    switch (aspects.transfer) {
+    case C2Color::TRANSFER_UNSPECIFIED:
+        break;
+    case C2Color::TRANSFER_LINEAR:
+        colorimetry.xferFunc = V4L2_XFER_FUNC_NONE;
+        break;
+    case C2Color::TRANSFER_SRGB:
+        colorimetry.xferFunc = V4L2_XFER_FUNC_SRGB;
+        break;
+    case C2Color::TRANSFER_170M:
+        colorimetry.xferFunc = V4L2_XFER_FUNC_709;
+        break;
+    case C2Color::TRANSFER_240M:
+        colorimetry.xferFunc = V4L2_XFER_FUNC_SMPTE240M;
+        break;
+    case C2Color::TRANSFER_ST2084:
+        colorimetry.xferFunc = V4L2_XFER_FUNC_SMPTE2084;
+        break;
+    default:
+        // HLG, gamma 2.2/2.8, xvYCC, BT.1361, ST 428 and others.
+        mapped = false;
+        break;
+    }
+
+    switch (aspects.matrix) {
+    case C2Color::MATRIX_UNSPECIFIED:
+        break;
+    case C2Color::MATRIX_BT709:
+        colorimetry.ycbcrEnc = V4L2_YCBCR_ENC_709;
+        break;
+    case C2Color::MATRIX_BT601:
+        colorimetry.ycbcrEnc = V4L2_YCBCR_ENC_601;
+        break;
+    case C2Color::MATRIX_240M:
+        colorimetry.ycbcrEnc = V4L2_YCBCR_ENC_SMPTE240M;
+        break;
+    case C2Color::MATRIX_BT2020:
+        colorimetry.ycbcrEnc = V4L2_YCBCR_ENC_BT2020;
+        break;
+    case C2Color::MATRIX_BT2020_CONSTANT:
+        colorimetry.ycbcrEnc = V4L2_YCBCR_ENC_BT2020_CONST_LUM;
+        break;
+    default:
+        // FCC 73.682 and others.
+        mapped = false;
+        break;
+    }
+
+    switch (aspects.range) {
+    case C2Color::RANGE_UNSPECIFIED:
+        break;
+    case C2Color::RANGE_FULL:
+        colorimetry.quantization = V4L2_QUANTIZATION_FULL_RANGE;
+        break;
+    case C2Color::RANGE_LIMITED:
+        colorimetry.quantization = V4L2_QUANTIZATION_LIM_RANGE;
+        break;
+    default:
+        mapped = false;
+        break;
+    }
+
+    if (!mapped) return std::nullopt;
+
+    // The V4L2 core resets the transfer function, the matrix and the range when the colour space
+    // is DEFAULT (v4l_sanitize_colorspace()), so they cannot be described without primaries.
+    if (colorimetry.colorspace == V4L2_COLORSPACE_DEFAULT) {
+        if (colorimetry == V4L2Colorimetry()) return colorimetry;  // Nothing specified.
+        return std::nullopt;
+    }
+    // A field left at DEFAULT takes the default of the colour space (a BT.2020 colour space, say,
+    // the BT.709 transfer function): primaries go to the driver only with a transfer function and
+    // a matrix.
+    if (colorimetry.xferFunc == V4L2_XFER_FUNC_DEFAULT ||
+        colorimetry.ycbcrEnc == V4L2_YCBCR_ENC_DEFAULT) {
+        return std::nullopt;
+    }
+    // A colour description always comes with the range flag. Video is limited range unless said
+    // otherwise (also what a decoder infers without the flag), so an unspecified range is limited
+    // rather than left to the driver.
+    if (colorimetry.quantization == V4L2_QUANTIZATION_DEFAULT) {
+        colorimetry.quantization = V4L2_QUANTIZATION_LIM_RANGE;
+    }
+    return colorimetry;
+}
+
+C2ColorAspectsStruct c2CodedColorAspects(const C2ColorAspectsStruct& aspects) {
+    const std::optional<V4L2Colorimetry> colorimetry = c2ColorAspectsToV4L2Colorimetry(aspects);
+    if (!colorimetry) return C2ColorAspectsStruct();
+
+    C2ColorAspectsStruct coded = aspects;
+    if (coded.range == C2Color::RANGE_UNSPECIFIED &&
+        colorimetry->quantization == V4L2_QUANTIZATION_LIM_RANGE) {
+        coded.range = C2Color::RANGE_LIMITED;
+    }
+    return coded;
+}
