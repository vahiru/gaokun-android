@@ -39,6 +43,32 @@ struct VideoEncoderAcceleratorConfig {
 // Convert the specified C2Config level to a V4L2 level.
 uint8_t c2LevelToV4L2Level(C2Config::level_t level);
 
+// The colorimetry fields of a raw v4l2_format: colour primaries (colorspace), transfer function,
+// Y'CbCr encoding and quantization range. The DEFAULT value of each field leaves it to the driver.
+struct V4L2Colorimetry {
+    uint32_t colorspace = V4L2_COLORSPACE_DEFAULT;
+    uint8_t xferFunc = V4L2_XFER_FUNC_DEFAULT;
+    uint8_t ycbcrEnc = V4L2_YCBCR_ENC_DEFAULT;
+    uint8_t quantization = V4L2_QUANTIZATION_DEFAULT;
+
+    bool operator==(const V4L2Colorimetry& other) const {
+        return colorspace == other.colorspace && xferFunc == other.xferFunc &&
+               ycbcrEnc == other.ycbcrEnc && quantization == other.quantization;
+    }
+};
+
+// Convert C2 colour aspects to the V4L2 colorimetry that describes exactly them: primaries, a
+// transfer function and a matrix, with an unspecified range as limited range. All unspecified
+// gives all DEFAULT. Returns nullopt when a specified aspect has no V4L2 value (e.g. the HLG
+// transfer function), when other aspects come without primaries (the V4L2 core resets them when
+// the colour space is DEFAULT), and when primaries come without a transfer function or a matrix
+// (a driver completes a DEFAULT field from the colour space, a value nobody chose).
+std::optional<V4L2Colorimetry> c2ColorAspectsToV4L2Colorimetry(const C2ColorAspectsStruct& aspects);
+
+// The colour aspects a stream carries when its raw format has the colorimetry that
+// c2ColorAspectsToV4L2Colorimetry() makes of |aspects|: all unspecified when there is none.
+C2ColorAspectsStruct c2CodedColorAspects(const C2ColorAspectsStruct& aspects);
+
 // Get the specified graphics block in YCbCr format.
 android_ycbcr getGraphicBlockInfo(const C2ConstGraphicBlock& block);
 
