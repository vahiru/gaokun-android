+// static
+C2R EncodeInterface::ColorAspectsSetter(bool /*mayBlock*/,
+                                        C2P<C2StreamColorAspectsInfo::input>& aspects) {
+    if (aspects.v.range > C2Color::RANGE_OTHER) {
+        aspects.set().range = C2Color::RANGE_OTHER;
+    }
+    if (aspects.v.primaries > C2Color::PRIMARIES_OTHER) {
+        aspects.set().primaries = C2Color::PRIMARIES_OTHER;
+    }
+    if (aspects.v.transfer > C2Color::TRANSFER_OTHER) {
+        aspects.set().transfer = C2Color::TRANSFER_OTHER;
+    }
+    if (aspects.v.matrix > C2Color::MATRIX_OTHER) {
+        aspects.set().matrix = C2Color::MATRIX_OTHER;
+    }
+    return C2R::Ok();
+}
+
+// static
+C2R EncodeInterface::CodedColorAspectsSetter(bool /*mayBlock*/,
+                                             C2P<C2StreamColorAspectsInfo::output>& coded,
+                                             const C2P<C2StreamProfileLevelInfo::output>& profile,
+                                             const C2P<C2StreamColorAspectsInfo::input>& aspects) {
+    // What a stream coded from the configured input would carry. While the encoder runs, the
+    // component keeps what its stream carries (see config()).
+    const C2ColorAspectsStruct described = codedColorAspects(profile.v.profile, aspects.v);
+    coded.set().range = described.range;
+    coded.set().primaries = described.primaries;
+    coded.set().transfer = described.transfer;
+    coded.set().matrix = described.matrix;
+    return C2R::Ok();
+}
+
+// static
+C2R EncodeInterface::HdrStaticInfoSetter(bool /*mayBlock*/,
