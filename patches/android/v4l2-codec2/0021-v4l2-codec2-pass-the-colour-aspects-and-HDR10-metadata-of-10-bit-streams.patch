+
+void EncodeInterface::setStreamColorAspects(const std::optional<C2ColorAspectsStruct>& aspects) {
+    if (!mHasColorAspects) return;
+
+    Lock lock = this->lock();
+    mStreamColorAspects = aspects;
+    setCodedColorAspects_l(aspects ? *aspects
+                                   : codedColorAspects(mProfileLevel->profile, *mColorAspects));
+}
+
+void EncodeInterface::setCodedColorAspects_l(const C2ColorAspectsStruct& aspects) {
+    mCodedColorAspects->range = aspects.range;
+    mCodedColorAspects->primaries = aspects.primaries;
+    mCodedColorAspects->transfer = aspects.transfer;
+    mCodedColorAspects->matrix = aspects.matrix;
+}
+
+c2_status_t EncodeInterface::config(const std::vector<C2Param*>& params, c2_blocking_t mayBlock,
+                                    std::vector<std::unique_ptr<C2SettingResult>>* const failures,
+                                    bool updateParams,
+                                    std::vector<std::shared_ptr<C2Param>>* changes) {
+    const c2_status_t status =
+            C2InterfaceHelper::config(params, mayBlock, failures, updateParams, changes);
+    if (!mHasColorAspects) return status;
+
+    // The colour description of a running stream is part of the V4L2 raw format, which cannot
+    // change once the encoder has allocated its buffers. Colour aspects configured meanwhile
+    // apply from the next start; until then the VUI aspects stay what the stream carries.
+    Lock lock = this->lock();
+    if (!mStreamColorAspects) return status;
+    setCodedColorAspects_l(*mStreamColorAspects);
+    if (updateParams) {
+        for (C2Param* param : params) {
+            C2StreamColorAspectsInfo::output* coded = C2StreamColorAspectsInfo::output::From(param);
+            if (coded && coded->stream() == 0u) {
+                coded->range = mStreamColorAspects->range;
+                coded->primaries = mStreamColorAspects->primaries;
+                coded->transfer = mStreamColorAspects->transfer;
+                coded->matrix = mStreamColorAspects->matrix;
+            }
+        }
+    }
+    return status;
+}
+
+std::optional<C2HdrStaticMetadataStruct> EncodeInterface::getHdrStaticInfo() const {
+    Lock lock = this->lock();
+    if (!mHdrStaticInfo || (mHdrStaticInfo->mastering.maxLuminance <= 0.f &&
+                            mHdrStaticInfo->maxCll <= 0.f && mHdrStaticInfo->maxFall <= 0.f)) {
+        return std::nullopt;
+    }
+    return C2HdrStaticMetadataStruct(*mHdrStaticInfo);
+}
