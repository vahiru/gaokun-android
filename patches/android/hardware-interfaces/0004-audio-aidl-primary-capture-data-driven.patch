@@ -43,6 +43,16 @@ class StreamAlsaMonoPipe : public StreamAlsaBase {
                                  int32_t* latencyMs) override;
     void shutdown() override;
 
+  protected:
+    // Capture only: waits until the pipe filled by inputIoThread() holds at least 'frameCount'
+    // frames, or until uptimeNanos() reaches 'deadlineNs'. Returns the number of frames
+    // available to read (may be less than 'frameCount'), or a negative status.
+    ssize_t waitForCapturedFrames(size_t frameCount, int64_t deadlineNs);
+
+    // Capture only: frames actually read from the pipe by the last 'transfer' (the rest is
+    // silence).
+    size_t mLastCaptureFramesRead = 0;
+
   private:
     ::android::NBAIO_Format getPipeFormat() const;
     ::android::sp<::android::MonoPipe> makeSink(bool writeCanBlock);
