--- a/audio/aidl/default/primary/StreamPrimary.cpp
+++ b/audio/aidl/default/primary/StreamPrimary.cpp
@@ -39,6 +39,11 @@ using android::base::GetBoolProperty;
 
 namespace aidl::android::hardware::audio::core {
 
+namespace {
+// How long the first capture 'transfer' after 'start' waits for the hardware to deliver a block.
+constexpr int64_t kFirstCaptureBlockTimeoutNs = 500 * NANOS_PER_MILLISECOND;
+}  // namespace
+
 StreamPrimary::StreamPrimary(StreamContext* context, const Metadata& metadata)
     : StreamAlsaMonoPipe(context, metadata, 3 /*readWriteRetries*/),
       mIsAsynchronous(!!getContext().getAsyncCallback()),
@@ -89,6 +94,7 @@ StreamPrimary::StreamPrimary(StreamContext* context, const Metadata& metadata)
     mStartTimeNs = ::android::uptimeNanos();
     mFramesSinceStart = 0;
     mSkipNextTransfer = false;
+    mCaptureDeadlineNs = mStartTimeNs + kFirstCaptureBlockTimeoutNs;
     return ::android::OK;
 }
 
@@ -97,6 +103,37 @@ StreamPrimary::StreamPrimary(StreamContext* context, const Metadata& metadata)
     if (isStubStreamOnWorker()) {
         return mStubDriver.transfer(buffer, frameCount, actualFrameCount, latencyMs);
     }
+    if (mIsInput && !mIsAsynchronous) {
+        // Capture is paced by the hardware: inputIoThread() blocks in pcm_read() and pushes each
+        // block into the pipe as soon as ALSA has it, so hand every block over as soon as it is
+        // there. The wall-clock schedule below starts with an empty pipe: it inserts two blocks
+        // of silence right after start() and then keeps the real audio two blocks behind
+        // (170 ms at 4096 frames @ 48 kHz) for as long as the stream stays active, without this
+        // delay being reported anywhere; any stall adds another block that is never recovered.
+        // This relies on the capture pipe holding two blocks (see makeSink()): with a one-block
+        // pipe the writer is throttled below real time and the ALSA buffer overruns.
+        const int64_t blockNs =
+                static_cast<int64_t>(mBufferSizeFrames) * NANOS_PER_SECOND / mSampleRate;
+        // If this thread itself was held up past the deadline, still give inputIoThread() a moment:
+        // it was most likely held up too and is about to push what ALSA has buffered meanwhile.
+        const int64_t deadlineNs =
+                std::max(mCaptureDeadlineNs, ::android::uptimeNanos() + blockNs / 8);
+        waitForCapturedFrames(frameCount, deadlineNs);
+        RETURN_STATUS_IF_ERROR(
+                StreamAlsaMonoPipe::transfer(buffer, frameCount, actualFrameCount, latencyMs));
+        const int64_t nowNs = ::android::uptimeNanos();
+        const bool gotBlock = mLastCaptureFramesRead >= frameCount;
+        if (mFramesSinceStart == 0) {
+            LOG(DEBUG) << __func__ << ": first capture block "
+                       << (gotBlock ? "ready " : "timed out ")
+                       << (nowNs - mStartTimeNs) / NANOS_PER_MILLISECOND << " ms after start";
+        }
+        // With data the next block is due in about one block time, allow three. Without data
+        // (a stalled or dead device) keep inserting silence at the real-time rate.
+        mCaptureDeadlineNs = gotBlock ? nowNs + 3 * blockNs : deadlineNs + blockNs;
+        mFramesSinceStart += *actualFrameCount;
+        return ::android::OK;
+    }
     // This is a workaround for the emulator implementation which has a host-side buffer
     // and is not being able to achieve real-time behavior similar to ADSPs (b/302587331).
     if (!mSkipNextTransfer) {
