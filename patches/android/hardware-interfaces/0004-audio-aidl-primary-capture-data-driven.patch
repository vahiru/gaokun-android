 #include "core-impl/StreamAlsaMonoPipe.h"
 
@@ -137,6 +140,7 @@ StreamAlsaMonoPipe::~StreamAlsaMonoPipe() {
         LOG(VERBOSE) << __func__ << ": reading from sink " << i;
         ssize_t framesRead = mSources[i]->read(buffer, frameCount);
         LOG_IF(FATAL, framesRead < 0) << "Error reading from the pipe: " << framesRead;
+        mLastCaptureFramesRead = framesRead > 0 ? static_cast<size_t>(framesRead) : 0;
         if (ssize_t framesMissing = static_cast<ssize_t>(frameCount) - framesRead;
             framesMissing > 0) {
             LOG(WARNING) << __func__ << ": incomplete data received, inserting " << framesMissing
@@ -165,6 +169,20 @@ StreamAlsaMonoPipe::~StreamAlsaMonoPipe() {
     return ::android::OK;
 }
 
+ssize_t StreamAlsaMonoPipe::waitForCapturedFrames(size_t frameCount, int64_t deadlineNs) {
+    if (!mIsInput || mSources.empty()) return 0;
+    const size_t i = 0;  // For the input case, only support a single device.
+    ssize_t framesAvailable;
+    while ((framesAvailable = mSources[i]->availableToRead()) >= 0 &&
+           static_cast<size_t>(framesAvailable) < frameCount) {
+        const int64_t nowNs = ::android::uptimeNanos();
+        if (nowNs >= deadlineNs) break;
+        // MonoPipeReader does not have a blocking read, poll at 1 ms like outputIoThread() does.
+        usleep(std::min<int64_t>(1000, (deadlineNs - nowNs + 999) / 1000));
+    }
+    return framesAvailable;
+}
+
 void StreamAlsaMonoPipe::shutdown() {
     teardownIo();
 }
@@ -185,7 +203,8 @@ void StreamAlsaMonoPipe::inputIoThread(size_t idx) {
             while (bufferFramesWritten < mBufferSizeFrames) {
                 if (!mIoThreadIsRunning) return;
                 ssize_t framesWrittenOrError =
-                        mSinks[idx]->write(&buffer[0], mBufferSizeFrames - bufferFramesWritten);
+                        mSinks[idx]->write(&buffer[bufferFramesWritten * mFrameSizeBytes],
+                                           mBufferSizeFrames - bufferFramesWritten);
                 if (framesWrittenOrError >= 0) {
                     bufferFramesWritten += framesWrittenOrError;
                 } else {
diff --git a/audio/aidl/default/include/core-impl/StreamAlsaMonoPipe.h b/audio/aidl/default/include/core-impl/StreamAlsaMonoPipe.h
