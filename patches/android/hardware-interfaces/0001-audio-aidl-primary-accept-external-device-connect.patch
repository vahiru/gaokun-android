@@ -42,6 +42,43 @@ using aidl::android::media::audio::common::MicrophoneInfo;
 
 namespace aidl::android::hardware::audio::core {
 
+// Accept the connection of an external device whose port already carries usable
+// profiles, instead of failing it.
+//
+// Module::populateConnectedDevicePort() is a pure error path: it logs "module
+// implementation must override 'populateConnectedDevicePort' to handle connection
+// of external devices" and returns EX_ILLEGAL_STATE. ModuleAlsa, ModuleUsb,
+// ModuleBluetooth and ModuleRemoteSubmix all override it -- ModulePrimary does not.
+// The consequence is that the stock primary module cannot accept *any* removable
+// device: plugging in an analog headset ends as
+//   APM failed to make available device 0x4 addr= error=1
+// even though everything above the HAL is correct.
+//
+// Nothing needs populating here. Module::connectExternalDevice() itself documents
+// this exact case:
+//
+//   "If the template device port has dynamic profiles, while all routable mix ports
+//    have static profiles, [...] the connected device port can be left with dynamic
+//    profiles [...] An example of this case is connection of an analog wired headset,
+//    it should be treated in the same way as a speaker."
+//
+// and it only rejects the connection afterwards when the connected port is left with
+// dynamic profiles *and* a routable mix port also has only dynamic profiles. The
+// device ports for removable devices in this product declare static profiles, so the
+// check passes and the port is usable as-is.
+//
+// Why the profiles cannot instead be carried by the port address: the framework
+// connects h2w devices with an *empty* address (AudioDeviceInventory logs
+// "setWiredDeviceConnectionState( type:4 (sink) ... addr: name:h2w)"), and
+// HwModuleCollection::getDeviceDescriptor() bails out to a fresh dynamic device when a
+// declared port has a non-empty address and the request does not. So removable ports
+// must be declared without an address, which is also why they must declare profiles.
+ndk::ScopedAStatus ModulePrimary::populateConnectedDevicePort(AudioPort* audioPort,
+                                                             int32_t /*nextPortId*/) {
+    LOG(DEBUG) << __func__ << ": accepting " << audioPort->toString();
+    return ndk::ScopedAStatus::ok();
+}
