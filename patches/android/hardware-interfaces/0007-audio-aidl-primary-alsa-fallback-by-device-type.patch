+// Parses the "CARD_<n>_DEV_<m>" selector at the end of 'address'.
+bool parseCardAndDeviceId(const std::string& address, std::pair<int, int>* cardAndDeviceId) {
+    const size_t suffixPos = address.rfind("CARD_");
+    return suffixPos != std::string::npos &&
+           sscanf(address.c_str() + suffixPos, "CARD_%d_DEV_%d", &cardAndDeviceId->first,
+                  &cardAndDeviceId->second) == 2;
+}
+
+// "ro.vendor.audio.primary.alsa.<device type in lower case>", e.g.
+// "ro.vendor.audio.primary.alsa.in_headset" for AudioDeviceType::IN_HEADSET.
+std::string getFallbackPropertyName(AudioDeviceType type) {
+    std::string name = ::aidl::android::media::audio::common::toString(type);
+    std::transform(name.begin(), name.end(), name.begin(),
+                   [](unsigned char c) { return std::tolower(c); });
+    return "ro.vendor.audio.primary.alsa." + name;
+}
