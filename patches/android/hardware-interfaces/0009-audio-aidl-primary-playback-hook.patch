+void StreamPrimary::openPlaybackHook() {
+    // A resume after a pause keeps the hook the stream already has.
+    if (mPlaybackHook != nullptr || !mConfig.has_value()) return;
+    if (const PlaybackHookLib* lib = getPlaybackHookLib(); lib != nullptr) {
+        mPlaybackHook = lib->open(mCurrAlsaDeviceId.first, mCurrAlsaDeviceId.second, mSampleRate,
+                                  static_cast<int>(mConfig->channels),
+                                  static_cast<int>(mConfig->format));
+    }
+}
+
+void StreamPrimary::closePlaybackHook() {
+    if (mPlaybackHook == nullptr) return;
+    getPlaybackHookLib()->close(mPlaybackHook);
+    mPlaybackHook = nullptr;
+}
