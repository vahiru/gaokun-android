+
+// A vendor library that sees every playback block right before it goes into ALSA, after
+// AudioFlinger has mixed everything (FAST tracks included, which no software session effect
+// can be attached to). Named by ro.vendor.audio.primary.playback_hook; unset means none.
+//   void* playback_hook_open(int card, int device, int sampleRate, int channelCount,
+//                            int pcmFormat);   // nullptr: not interested in this stream
+//   void playback_hook_process(void* handle, void* buffer, size_t frameCount);  // in place
+//   void playback_hook_close(void* handle);
+// All three are called on the stream's worker thread. The library has to be loadable from
+// this APEX's isolated linker namespace, i.e. from a directory its linker config permits.
+struct PlaybackHookLib {
+    void* (*open)(int, int, int, int, int);
+    void (*process)(void*, void*, size_t);
+    void (*close)(void*);
+};
+
+const PlaybackHookLib* getPlaybackHookLib() {
+    static const PlaybackHookLib* const lib = []() -> const PlaybackHookLib* {
+        const std::string path =
+                ::android::base::GetProperty("ro.vendor.audio.primary.playback_hook", "");
+        if (path.empty()) return nullptr;
+        void* handle = dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL);
+        if (handle == nullptr) {
+            LOG(ERROR) << "playback hook: " << dlerror();
+            return nullptr;
+        }
+        auto* l = new PlaybackHookLib{
+                reinterpret_cast<void* (*)(int, int, int, int, int)>(
+                        dlsym(handle, "playback_hook_open")),
+                reinterpret_cast<void (*)(void*, void*, size_t)>(
+                        dlsym(handle, "playback_hook_process")),
+                reinterpret_cast<void (*)(void*)>(dlsym(handle, "playback_hook_close"))};
+        if (l->open == nullptr || l->process == nullptr || l->close == nullptr) {
+            LOG(ERROR) << "playback hook: " << path << " lacks the playback_hook_* functions";
+            delete l;
+            dlclose(handle);
+            return nullptr;
+        }
+        LOG(INFO) << "playback hook: using " << path;
+        return l;
+    }();
+    return lib;
+}
 }  // namespace
 
