 }
+
+// A vendor library that processes the capture of an attached device before the client gets it,
+// e.g. turns a microphone array into a beamformed pair. Named by
+// ro.vendor.audio.primary.capture_hook; unset means none.
+//   void* capture_hook_open(int card, int device, int sampleRate, int channelCount,
+//                           int pcmFormat, const int* sources, size_t sourceCount,
+//                           int* hardwareChannelCount, int* delayFrames);
+//       nullptr: not interested in this stream, which then captures as it does without a hook.
+//       Otherwise the ALSA device is opened with *hardwareChannelCount channels (same rate and
+//       format), and the capture position accounts for *delayFrames frames of processing delay.
+//   void capture_hook_process(void* handle, const void* in, void* out, size_t frameCount);
+//       'in' holds *hardwareChannelCount interleaved channels, 'out' gets channelCount.
+//   void capture_hook_set_sources(void* handle, const int* sources, size_t sourceCount);
+//   void capture_hook_close(void* handle);
+// 'sources' are the AudioSource values of the stream's record tracks. open() and close() are
+// called on the stream's worker thread, process() on its I/O thread in between, and
+// set_sources() on a Binder thread when the client updates the metadata, never at the same time
+// as open() or close(). The library has to be loadable from this APEX's linker namespace.
+struct CaptureHookLib {
+    void* (*open)(int, int, int, int, int, const int*, size_t, int*, int*);
+    void (*process)(void*, const void*, void*, size_t);
+    void (*setSources)(void*, const int*, size_t);
+    void (*close)(void*);
+};
+
+const CaptureHookLib* getCaptureHookLib() {
+    static const CaptureHookLib* const lib = []() -> const CaptureHookLib* {
+        const std::string path =
+                ::android::base::GetProperty("ro.vendor.audio.primary.capture_hook", "");
+        if (path.empty()) return nullptr;
+        void* handle = dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL);
+        if (handle == nullptr) {
+            LOG(ERROR) << "capture hook: " << dlerror();
+            return nullptr;
+        }
+        auto* l = new CaptureHookLib{
+                reinterpret_cast<void* (*)(int, int, int, int, int, const int*, size_t, int*,
+                                           int*)>(dlsym(handle, "capture_hook_open")),
+                reinterpret_cast<void (*)(void*, const void*, void*, size_t)>(
+                        dlsym(handle, "capture_hook_process")),
+                reinterpret_cast<void (*)(void*, const int*, size_t)>(
+                        dlsym(handle, "capture_hook_set_sources")),
+                reinterpret_cast<void (*)(void*)>(dlsym(handle, "capture_hook_close"))};
+        if (l->open == nullptr || l->process == nullptr || l->setSources == nullptr ||
+            l->close == nullptr) {
+            LOG(ERROR) << "capture hook: " << path << " lacks the capture_hook_* functions";
+            delete l;
+            dlclose(handle);
+            return nullptr;
+        }
+        LOG(INFO) << "capture hook: using " << path;
+        return l;
+    }();
+    return lib;
+}
+
+std::vector<int> getCaptureSources(const StreamCommonInterface::Metadata& metadata) {
+    std::vector<int> sources;
+    if (const auto* sinkMetadata = std::get_if<SinkMetadata>(&metadata)) {
+        for (const auto& track : sinkMetadata->tracks) {
+            sources.push_back(static_cast<int>(track.source));
+        }
+    }
+    return sources;
+}
 }  // namespace
 
