+void StreamPrimary::convertCapture(const void* in, void* out, size_t frameCount) {
+    getCaptureHookLib()->process(mCaptureHook, in, out, frameCount);
+}
+
+void StreamPrimary::openCaptureHook() {
+    // A resume keeps the ALSA device as it is, with or without a hook.
+    if (mCaptureHook != nullptr || !mAlsaDeviceProxies.empty() || !mConfig.has_value()) return;
+    const CaptureHookLib* lib = getCaptureHookLib();
+    if (lib == nullptr) return;
+    std::lock_guard l(mCaptureHookLock);
+    int hardwareChannels = 0, delayFrames = 0;
+    void* hook = lib->open(mCurrAlsaDeviceId.first, mCurrAlsaDeviceId.second, mSampleRate,
+                           static_cast<int>(mConfig->channels), static_cast<int>(mConfig->format),
+                           mCaptureSources.data(), mCaptureSources.size(), &hardwareChannels,
+                           &delayFrames);
+    if (hook == nullptr) return;
+    if (hardwareChannels <= 0 || delayFrames < 0) {
+        LOG(ERROR) << __func__ << ": capture hook opened with " << hardwareChannels
+                   << " channels and a delay of " << delayFrames << " frames, not using it";
+        lib->close(hook);
+        return;
+    }
+    mCaptureHook = hook;
+    mCaptureHardwareChannels = static_cast<unsigned int>(hardwareChannels);
+    mCaptureHookDelayNs = static_cast<int64_t>(delayFrames) * NANOS_PER_SECOND / mSampleRate;
+}
+
+void StreamPrimary::closeCaptureHook() {
+    std::lock_guard l(mCaptureHookLock);
+    if (mCaptureHook == nullptr) return;
+    getCaptureHookLib()->close(mCaptureHook);
+    mCaptureHook = nullptr;
+    mCaptureHardwareChannels = 0;
+    mCaptureHookDelayNs = 0;
+}
+
+ndk::ScopedAStatus StreamPrimary::updateMetadataCommon(const Metadata& metadata) {
+    ndk::ScopedAStatus status = StreamAlsaMonoPipe::updateMetadataCommon(metadata);
+    if (status.isOk() && mIsInput) {
+        std::lock_guard l(mCaptureHookLock);
+        mCaptureSources = getCaptureSources(metadata);
+        if (mCaptureHook != nullptr) {
+            getCaptureHookLib()->setSources(mCaptureHook, mCaptureSources.data(),
+                                            mCaptureSources.size());
+        }
+    }
+    return status;
+}
