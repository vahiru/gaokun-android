+::android::status_t StreamPrimary::refinePosition(StreamDescriptor::Position* position) {
+    // Playback: the position maintained by the Stream class counts every frame the client has
+    // handed over, including the ones still queued in the ALSA buffer (a whole buffer at most).
+    // Report what the hardware is playing instead.
+    if (!mIsInput && !isStubStreamOnWorker()) return refinePlaybackPosition(position);
+    // Capture: since not all data is actually sent to the HAL, use the position maintained by
+    // Stream class which accounts for all frames passed from / to the client.
     return ::android::OK;
