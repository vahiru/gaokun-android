+/**
+ * Parallel view: shows the activities of an app side by side in large landscape windows,
+ * following the Huawei EasyGo rules the app ships in {@code assets/easygo.json} (the
+ * "magicwindow" entity). Applies to apps with
+ * {@link android.content.pm.ActivityInfo#OVERRIDE_ENABLE_PARALLEL_VIEW} enabled, which the
+ * device settings app sets per package.
+ *
+ * <p>{@link SplitController} calls {@link #registerLifecycleCallbacks} and
+ * {@link #addStartMonitor} in place of the plain registrations, and
+ * {@link AppCompatEmbeddingRuleController#loadAppCompatRules} calls {@link #addRules} after it has
+ * checked that the app does not use activity embedding itself.
+ */
+public final class ParallelViewRules {
+    private static final String TAG = "ParallelView";
+    /** Splits need a parent window at least this wide, and wider than tall. */
+    private static final int MIN_WIDTH_DP = 600;
+    /** Range of the primary (left) share when the app's rules allow dragging the divider. */
+    private static final float DIVIDER_MIN_RATIO = 0.25f;
+    private static final float DIVIDER_MAX_RATIO = 0.75f;
+
+    /**
+     * Activities treated as transitional in addition to an app's own transActivities: pages that
+     * its rules would send to the side although they are no pages of their own. Package name,
+     * then class names.
+     */
+    private static final String[][] EXTRA_TRANSITIONAL = {
+        // A translucent full-window banner; sent to the side, it leaves the side black under it.
+        {"tv.danmaku.bili", "kntr.common.compose.launcher.TranslucentVertexActivity"},
+    };
+
+    /** Set by {@link #addRules}: the app's package, package manager and resources. */
+    private static volatile String sPackage;
+    private static volatile PackageManager sPackageManager;
+    private static volatile Resources sResources;
+    /** Activity class name -> whether its theme is floating. */
+    private static final ConcurrentHashMap<String, Boolean> sFloating = new ConcurrentHashMap<>();
+
+    /** SplitController's activity start monitor, and the Instrumentation it was last added to. */
+    @Nullable
+    private static Instrumentation.ActivityMonitor sMonitor;
+    @Nullable
+    private static Instrumentation sMonitoredInstrumentation;
+
+    /** Whether {@link #addRules} added rules for the app of this process. */
+    private static volatile boolean sRulesAdded;
+    /** The controller of this process; set only when parallel-view rules were added. */
+    @Nullable
+    private static volatile SplitController sController;
+    /** Activities with a layout listener for {@link #onLayout}, and that listener. */
+    private static final WeakHashMap<Activity, ViewTreeObserver.OnGlobalLayoutListener>
+            sWatched = new WeakHashMap<>();
+    /** Requested orientation of activities that have not called setRequestedOrientation(). */
+    private static final WeakHashMap<Activity, Integer> sServerOrientations = new WeakHashMap<>();
+    /** Splits expanded for full-screen playback, and their attributes before that. */
+    private static final WeakHashMap<SplitContainer, SplitAttributes> sExpandedSplits =
+            new WeakHashMap<>();
+
+    private ParallelViewRules() {}
+
+    /** Called at the end of the SplitController constructor, after the rules are loaded. */
+    public static void setSplitController(@NonNull SplitController controller) {
+        // Apps that use activity embedding themselves get no rules here and are left alone.
+        if (isEnabled() && sRulesAdded) {
+            sController = controller;
+        }
+    }
+
+    /**
+     * Called when the task of a split changes, for example when it enters or leaves split
+     * screen; checks the pages again after the current transaction.
+     */
+    static void onTaskChanged() {
+        if (sController == null) {
+            return;
+        }
+        new Handler(Looper.getMainLooper()).post(() -> {
+            final List<Activity> activities;
+            synchronized (sWatched) {
+                activities = new ArrayList<>(sWatched.keySet());
+            }
+            for (Activity activity : activities) {
+                onLayout(activity);
+            }
+        });
+    }
+
+    /** Whether parallel view is enabled for the app of this process. */
+    public static boolean isEnabled() {
+        return CompatChanges.isChangeEnabled(OVERRIDE_ENABLE_PARALLEL_VIEW);
+    }
+
+    /**
+     * Registers SplitController's activity lifecycle callbacks, in place of
+     * {@code app.registerActivityLifecycleCallbacks(callbacks)}.
+     *
+     * <p>Some apps override that method and wrap every callback in a class that forwards only
+     * the seven original methods, so onActivityPreCreated and onActivityPostCreated never arrive
+     * and no rule is ever resolved. For apps with parallel view enabled whose Application
+     * overrides the method, the callbacks go straight into Application's own list, as the
+     * platform implementation of the method does. Apps with parallel view enabled also get a
+     * {@link MonitorKeeper}, registered the same way ahead of SplitController's callbacks.
+     */
+    public static void registerLifecycleCallbacks(@NonNull Application app,
+            @NonNull Application.ActivityLifecycleCallbacks callbacks) {
+        if (isEnabled()) {
+            try {
+                final Method register = app.getClass().getMethod(
+                        "registerActivityLifecycleCallbacks",
+                        Application.ActivityLifecycleCallbacks.class);
+                if (register.getDeclaringClass() != Application.class) {
+                    final Field field =
+                            Application.class.getDeclaredField("mActivityLifecycleCallbacks");
+                    field.setAccessible(true);
+                    @SuppressWarnings("unchecked")
+                    final ArrayList<Application.ActivityLifecycleCallbacks> list =
+                            (ArrayList<Application.ActivityLifecycleCallbacks>) field.get(app);
+                    synchronized (list) {
+                        list.add(new MonitorKeeper());
+                        list.add(callbacks);
+                    }
+                    Log.i(TAG, app.getClass().getName()
+                            + " overrides registerActivityLifecycleCallbacks; added directly");
+                    return;
+                }
+            } catch (ReflectiveOperationException | RuntimeException e) {
+                Log.w(TAG, "Could not add the lifecycle callbacks directly", e);
+            }
+            app.registerActivityLifecycleCallbacks(new MonitorKeeper());
+        }
+        app.registerActivityLifecycleCallbacks(callbacks);
+    }
+
+    /**
+     * Adds SplitController's activity start monitor, in place of
+     * {@code instrumentation.addMonitor(monitor)}.
+     *
+     * <p>Some apps replace the Instrumentation after they start. Starts then go through the
+     * replacement's execStartActivity(), which checks only the replacement's own monitors (or
+     * passes the start on to the instance it replaced), so the monitor would never see a start
+     * and new activities would never be routed to the side. For apps with parallel view enabled,
+     * the monitor therefore goes into the own list of the current Instrumentation now (the app
+     * may have replaced it already), and {@link MonitorKeeper} does the same before each activity
+     * is created.
+     */
+    public static void addStartMonitor(@NonNull Instrumentation instrumentation,
+            @NonNull Instrumentation.ActivityMonitor monitor) {
+        instrumentation.addMonitor(monitor);
+        if (!isEnabled()) {
+            return;
+        }
+        synchronized (ParallelViewRules.class) {
+            sMonitor = monitor;
+            sMonitoredInstrumentation = null;
+        }
+        ensureStartMonitor();
+    }
+
+    /**
+     * Makes sure that the current Instrumentation holds SplitController's start monitor in its
+     * own list, and so does every Instrumentation it keeps in a field: a replacement that
+     * overrides execStartActivity() usually passes starts on to the instance it replaced, and
+     * only that instance's monitors are checked then.
+     */
+    static void ensureStartMonitor() {
+        final Instrumentation current = ActivityThread.currentActivityThread().getInstrumentation();
+        final Instrumentation.ActivityMonitor monitor;
+        synchronized (ParallelViewRules.class) {
+            if (sMonitor == null || current == null || current == sMonitoredInstrumentation) {
+                return;
+            }
+            monitor = sMonitor;
+            sMonitoredInstrumentation = current;
+        }
+        try {
+            final StringBuilder note = new StringBuilder(current.getClass().getName());
+            addToOwnList(current, monitor);
+            for (Class<?> c = current.getClass(); c != null && c != Instrumentation.class;
+                    c = c.getSuperclass()) {
+                for (Field f : c.getDeclaredFields()) {
+                    if (Modifier.isStatic(f.getModifiers())
+                            || !Instrumentation.class.isAssignableFrom(f.getType())) {
+                        continue;
+                    }
+                    f.setAccessible(true);
+                    final Object inner = f.get(current);
+                    if (inner instanceof Instrumentation && inner != current) {
+                        addToOwnList((Instrumentation) inner, monitor);
+                        note.append(", wraps ").append(inner.getClass().getName());
+                    }
+                }
+            }
+            Log.i(TAG, "Start monitor in the own list of " + note);
+        } catch (ReflectiveOperationException | RuntimeException e) {
+            Log.w(TAG, "Could not add the start monitor to the current Instrumentation", e);
+        }
+    }
+
+    /** Adds {@code monitor} to the own list of {@code instrumentation}, as addMonitor() does. */
+    private static void addToOwnList(@NonNull Instrumentation instrumentation,
+            @NonNull Instrumentation.ActivityMonitor monitor)
+            throws ReflectiveOperationException {
+        final Field syncField = Instrumentation.class.getDeclaredField("mSync");
+        final Field monitorsField = Instrumentation.class.getDeclaredField("mActivityMonitors");
+        syncField.setAccessible(true);
+        monitorsField.setAccessible(true);
+        synchronized (syncField.get(instrumentation)) {
+            @SuppressWarnings("unchecked")
+            List<Instrumentation.ActivityMonitor> monitors =
+                    (List<Instrumentation.ActivityMonitor>) monitorsField.get(instrumentation);
+            if (monitors == null) {
+                monitors = new ArrayList<>();
+                monitorsField.set(instrumentation, monitors);
+            }
+            if (!monitors.contains(monitor)) {
+                monitors.add(monitor);
+            }
+        }
+    }
+
+    /** Before each activity is created, checks whether the app replaced its Instrumentation. */
+    private static final class MonitorKeeper implements Application.ActivityLifecycleCallbacks {
+        @Override
+        public void onActivityPreCreated(@NonNull Activity activity,
+                @Nullable Bundle savedInstanceState) {
+            ensureStartMonitor();
+        }
+
+        @Override
+        public void onActivityCreated(@NonNull Activity activity,
+                @Nullable Bundle savedInstanceState) {}
+
+        @Override
+        public void onActivityPostCreated(@NonNull Activity activity,
+                @Nullable Bundle savedInstanceState) {
+            watchLayout(activity);
+        }
+
+        @Override
+        public void onActivityStarted(@NonNull Activity activity) {}
+
+        @Override
+        public void onActivityResumed(@NonNull Activity activity) {
+            watchLayout(activity);
+        }
+
+        @Override
+        public void onActivityPaused(@NonNull Activity activity) {}
+
+        @Override
+        public void onActivityStopped(@NonNull Activity activity) {}
+
+        @Override
+        public void onActivitySaveInstanceState(@NonNull Activity activity,
+                @NonNull Bundle outState) {}
+
+        @Override
+        public void onActivityDestroyed(@NonNull Activity activity) {
+            unwatchLayout(activity);
+        }
+    }
+
+    /** Calls {@link #onLayout} after every layout of the window of {@code activity}. */
+    private static void watchLayout(@NonNull Activity activity) {
+        final View decor = activity.getWindow().peekDecorView();
+        if (sController == null || decor == null) {
+            return;
+        }
+        final WeakReference<Activity> ref = new WeakReference<>(activity);
+        final ViewTreeObserver.OnGlobalLayoutListener listener = () -> {
+            final Activity a = ref.get();
+            if (a != null) {
+                onLayout(a);
+            }
+        };
+        synchronized (sWatched) {
+            if (sWatched.containsKey(activity)) {
+                return;
+            }
+            sWatched.put(activity, listener);
+        }
+        // A relaunched activity may keep the window of the instance it replaces, so the
+        // listener belongs to the instance and is removed when it is destroyed.
+        decor.getViewTreeObserver().addOnGlobalLayoutListener(listener);
+        onLayout(activity);
+    }
+
+    private static void unwatchLayout(@NonNull Activity activity) {
+        final ViewTreeObserver.OnGlobalLayoutListener listener;
+        synchronized (sWatched) {
+            listener = sWatched.remove(activity);
+        }
+        final View decor = activity.getWindow().peekDecorView();
+        if (listener != null && decor != null) {
+            decor.getViewTreeObserver().removeOnGlobalLayoutListener(listener);
+        }
+    }
+
+    /**
+     * Keeps full-screen playback working for a page shown beside another one.
+     *
+     * <p>Such a page is in multi-window mode, in which some apps refuse full-screen playback;
+     * it is reported as not in multi-window mode while it is in a split of a task that is not in
+     * multi-window mode itself, and as it really is otherwise (split screen, freeform,
+     * picture-in-picture). ActivityThread sets the state only when the activity is created and
+     * when it enters or leaves multi-window mode, so it is checked after every layout.
+     *
+     * <p>When the pages of the side container request a landscape orientation, the split is
+     * expanded so that they fill the task, with the main page kept underneath and without a
+     * divider, and the split is restored when they no longer request landscape. The pages are
+     * judged as window management judges the display orientation (see {@link #sideOrientation}).
+     */
+    private static void onLayout(@NonNull Activity activity) {
+        final SplitController controller = sController;
+        if (controller == null || activity.isFinishing() || activity.isDestroyed()) {
+            return;
+        }
+        final boolean inSplitOfFullTask;
+        final SplitContainer split;
+        final List<Activity> sidePages;
+        final boolean isNonStickyPlaceholder;
+        synchronized (controller.mLock) {
+            final TaskFragmentContainer container = controller.getContainerWithActivity(activity);
+            final TaskContainer task = container != null ? container.getTaskContainer() : null;
+            inSplitOfFullTask = task != null && !task.isInMultiWindow();
+            split = inSplitOfFullTask ? task.getActiveSplitForContainer(container) : null;
+            sidePages = split != null && split.getSecondaryContainer() == container
+                    ? container.collectNonFinishingActivities() : null;
+            isNonStickyPlaceholder = split != null && split.isPlaceholderContainer()
+                    && !SplitContainer.isStickyPlaceholderRule(split.getSplitRule());
+        }
+        try {
+            final boolean inMultiWindowMode = !inSplitOfFullTask
+                    && WindowConfiguration.inMultiWindowMode(activity.getResources()
+                            .getConfiguration().windowConfiguration.getWindowingMode());
+            if (activity.isInMultiWindowMode() != inMultiWindowMode) {
+                final Field field = Activity.class.getDeclaredField("mIsInMultiWindowMode");
+                field.setAccessible(true);
+                field.setBoolean(activity, inMultiWindowMode);
+            }
+            if (sidePages == null) {
+                return;
+            }
+            final boolean landscape = isLandscape(sideOrientation(sidePages));
+            final SplitAttributes restore;
+            synchronized (sExpandedSplits) {
+                if (landscape && !sExpandedSplits.containsKey(split)) {
+                    // Expanding dismisses a placeholder that is not sticky, together with the
+                    // pages above it.
+                    if (isNonStickyPlaceholder) {
+                        return;
+                    }
+                    sExpandedSplits.put(split, split.getDefaultSplitAttributes());
+                    restore = null;
+                } else if (!landscape && sExpandedSplits.containsKey(split)) {
+                    restore = sExpandedSplits.remove(split);
+                } else {
+                    return;
+                }
+            }
+            if (restore == null) {
+                Log.i(TAG, activity.getComponentName().getClassName()
+                        + " requests landscape; expanding its split");
+                // Without a divider: no handle over the video, and no drag to undo.
+                controller.updateSplitAttributes(split.getToken(),
+                        new SplitAttributes.Builder(split.getDefaultSplitAttributes())
+                                .setSplitType(
+                                        new SplitAttributes.SplitType.ExpandContainersSplitType())
+                                .setDividerAttributes(null)
+                                .build());
+            } else {
+                Log.i(TAG, activity.getComponentName().getClassName()
+                        + " no longer requests landscape; restoring its split");
+                controller.updateSplitAttributes(split.getToken(), restore);
+            }
+        } catch (ReflectiveOperationException | RuntimeException e) {
+            Log.w(TAG, "Could not update the split of " + activity.getComponentName(), e);
+        }
+    }
+
+    /**
+     * The orientation that the pages of a container ({@code pages}, bottom to top) request
+     * together, as window management determines the display orientation: from the top, the
+     * first page that requests an explicit orientation decides; a page that requests "behind",
+     * or a translucent or floating page that requests none, defers to the page below, and an
+     * opaque page that requests none ends the search unspecified. Pages of other processes are
+     * not known here. So
+     * a page opened above a player does not restore the split while the player is visible under
+     * it, and a player with a translucent theme still decides.
+     */
+    private static int sideOrientation(@NonNull List<Activity> pages)
+            throws ReflectiveOperationException {
+        for (int i = pages.size() - 1; i >= 0; i--) {
+            final Activity page = pages.get(i);
+            final int orientation = requestedOrientation(page);
+            if (orientation == ActivityInfo.SCREEN_ORIENTATION_BEHIND) {
+                continue;
+            }
+            if (orientation != ActivityInfo.SCREEN_ORIENTATION_UNSET
+                    && orientation != ActivityInfo.SCREEN_ORIENTATION_UNSPECIFIED) {
+                return orientation;
+            }
+            if (!ActivityInfo.isTranslucentOrFloating(page.getWindow().getWindowStyle())) {
+                break;
+            }
+        }
+        return ActivityInfo.SCREEN_ORIENTATION_UNSPECIFIED;
+    }
+
+    /**
+     * The orientation that {@code activity} requests: what it last passed to
+     * setRequestedOrientation(), else what the system holds for it (declared in the manifest,
+     * or requested by an earlier instance of a relaunched activity), queried once.
+     */
+    private static int requestedOrientation(@NonNull Activity activity)
+            throws ReflectiveOperationException {
+        final Field field = Activity.class.getDeclaredField("mLastRequestedOrientation");
+        field.setAccessible(true);
+        final int requested = field.getInt(activity);
+        if (requested != ActivityInfo.SCREEN_ORIENTATION_UNSET) {
+            return requested;
+        }
+        synchronized (sServerOrientations) {
+            final Integer known = sServerOrientations.get(activity);
+            if (known != null) {
+                return known;
+            }
+        }
+        final int fromServer = activity.getRequestedOrientation();
+        synchronized (sServerOrientations) {
+            sServerOrientations.put(activity, fromServer);
+        }
+        return fromServer;
+    }
+
+    private static boolean isLandscape(int orientation) {
+        return orientation == ActivityInfo.SCREEN_ORIENTATION_LANDSCAPE
+                || orientation == ActivityInfo.SCREEN_ORIENTATION_REVERSE_LANDSCAPE
+                || orientation == ActivityInfo.SCREEN_ORIENTATION_SENSOR_LANDSCAPE
+                || orientation == ActivityInfo.SCREEN_ORIENTATION_USER_LANDSCAPE;
+    }
+
+    /** Adds the parallel-view rules of the app in {@code context} to {@code rules}. */
+    public static void addRules(@NonNull Context context, @NonNull Set<EmbeddingRule> rules) {
+        if (!isEnabled()) {
+            return;
+        }
+        final String pkg = context.getPackageName();
+        try {
+            sPackage = pkg;
+            sPackageManager = context.getPackageManager();
+            sResources = context.getResources();
+            if (!isSystemOverrideAllowed(context, pkg)) {
+                // The property refuses rules that the system makes up for the app. These rules
+                // are the app's own, so they apply all the same.
+                Log.i(TAG, pkg + ": system override not allowed; applying the app's own rules");
+            }
+            final String json = readAsset(context, "easygo.json");
+            if (json == null) {
+                Log.i(TAG, pkg + ": no assets/easygo.json");
+                return;
+            }
+            final EasyGo cfg = EasyGo.parse(json);
+            if (cfg == null) {
+                Log.i(TAG, pkg + ": no magicwindow entity in easygo.json");
+                return;
+            }
+            if (cfg.excludesPad) {
+                Log.i(TAG, pkg + ": easygo.json excludes tablets");
+                return;
+            }
+            for (String[] extra : EXTRA_TRANSITIONAL) {
+                if (extra[0].equals(pkg)) {
+                    for (int i = 1; i < extra.length; i++) {
+                        cfg.transitional.add(extra[i]);
+                    }
+                }
+            }
+            final int added = addRules(context, pkg, cfg, rules);
+            sRulesAdded = added > 0;
+            Log.i(TAG, pkg + ": mode " + cfg.mode + ", ratio " + cfg.ratio + ", divider "
+                    + (cfg.draggable ? (cfg.dragToFullScreen ? "draggable to full screen"
+                            : "draggable") : "fixed")
+                    + ", " + cfg.pairs.size() + " pairs, " + cfg.dual.size() + " default dual, "
+                    + cfg.fullScreen.size() + " full-screen, " + cfg.transitional.size()
+                    + " transitional, kept out of push: " + cfg.pushExcluded + "; "
+                    + added + " rules");
+        } catch (JSONException | RuntimeException e) {
+            Log.w(TAG, pkg + ": could not load the parallel-view rules", e);
+        }
+    }
+
+    private static int addRules(@NonNull Context context, @NonNull String pkg,
+            @NonNull EasyGo cfg, @NonNull Set<EmbeddingRule> rules) {
+        final MinWidthLandscape parent = new MinWidthLandscape();
+        final SplitAttributes.Builder attrsBuilder = new SplitAttributes.Builder()
+                .setSplitType(cfg.ratio > 0
+                        ? new SplitAttributes.SplitType.RatioSplitType(cfg.ratio)
+                        : SplitAttributes.SplitType.RatioSplitType.splitEqually())
+                .setLayoutDirection(SplitAttributes.LayoutDirection.LEFT_TO_RIGHT);
+        if (cfg.draggable) {
+            // Dragging the divider to an edge expands one side to the whole task, where the app
+            // is no longer in multi-window mode.
+            attrsBuilder.setDividerAttributes(new DividerAttributes.Builder(
+                            DividerAttributes.DIVIDER_TYPE_DRAGGABLE)
+                    .setDraggingToFullscreenAllowed(cfg.dragToFullScreen)
+                    .setPrimaryMinRatio(DIVIDER_MIN_RATIO)
+                    .setPrimaryMaxRatio(DIVIDER_MAX_RATIO)
+                    .build());
+        }
+        final SplitAttributes attrs = attrsBuilder.build();
+        int added = 0;
+        if (cfg.mode == EasyGo.MODE_SHOPPING) {
+            // Every page the app opens goes to the side and pushes the page there to the main
+            // side; activityPairs do not apply in this mode. Launcher activities are usually
+            // splash screens that start the main page and finish, so they stay out of the push
+            // rule unless one is a main page with a default side page.
+            cfg.pushExcluded.addAll(launcherActivities(context, pkg));
+            for (String[] d : cfg.dual) {
+                cfg.pushExcluded.remove(d[0]);
+            }
+            rules.add(pairRule(pkg, cfg, null, null, parent, attrs, false /* clearTop */,
+                    SplitRule.FINISH_NEVER, "pv-push"));
+            added++;
+        } else {
+            for (String[] p : cfg.pairs) {
+                final String from = "*".equals(p[0]) ? null : p[0];
+                final String to = "*".equals(p[1]) ? null : p[1];
+                rules.add(pairRule(pkg, cfg, from, to, parent, attrs, true /* clearTop */,
+                        SplitRule.FINISH_ALWAYS, "pv-" + p[0] + "->" + p[1]));
+                added++;
+            }
+        }
+        for (String[] d : cfg.dual) {
+            // The page the app shows on the side of its main page by default.
+            final Intent placeholder = new Intent().setClassName(pkg, d[1]);
+            rules.add(new SplitPlaceholderRule.Builder(placeholder, new ActivityIs(pkg, d[0]),
+                    new IntentIs(pkg, d[0]), parent)
+                    .setDefaultSplitAttributes(attrs)
+                    .setFinishPrimaryWithPlaceholder(SplitRule.FINISH_ALWAYS)
+                    .setSticky(false)
+                    .setTag("pv-dual-" + d[0])
+                    .build());
+            added++;
+        }
+        for (String name : cfg.fullScreen) {
+            rules.add(new ActivityRule.Builder(new ActivityIs(pkg, name), new IntentIs(pkg, name))
+                    .setShouldAlwaysExpand(true)
+                    .setTag("pv-full-" + name)
+                    .build());
+            added++;
+        }
+        return added;
+    }
+
+    @NonNull
+    private static SplitPairRule pairRule(@NonNull String pkg, @NonNull EasyGo cfg,
+            @Nullable String from, @Nullable String to, @NonNull MinWidthLandscape parent,
+            @NonNull SplitAttributes attrs, boolean clearTop, int finishSecondaryWithPrimary,
+            @NonNull String tag) {
+        return new SplitPairRule.Builder(new PairMatches(pkg, cfg, from, to),
+                new IntentPairMatches(pkg, cfg, from, to), parent)
+                .setDefaultSplitAttributes(attrs)
+                .setFinishPrimaryWithSecondary(SplitRule.FINISH_NEVER)
+                .setFinishSecondaryWithPrimary(finishSecondaryWithPrimary)
+                .setShouldClearTop(clearTop)
+                .setTag(tag)
+                .build();
+    }
+
+    private static boolean isSystemOverrideAllowed(@NonNull Context context,
+            @NonNull String pkg) {
+        try {
+            return context.getPackageManager()
+                    .getProperty(PROPERTY_ACTIVITY_EMBEDDING_ALLOW_SYSTEM_OVERRIDE, pkg)
+                    .getBoolean();
+        } catch (PackageManager.NameNotFoundException e) {
+            return true;
+        }
+    }
+
+    /** The app's launcher activities, with aliases resolved to their target activities. */
+    @NonNull
+    private static Set<String> launcherActivities(@NonNull Context context, @NonNull String pkg) {
+        final Set<String> out = new HashSet<>();
+        final Intent launcher = new Intent(Intent.ACTION_MAIN)
+                .addCategory(Intent.CATEGORY_LAUNCHER).setPackage(pkg);
+        for (ResolveInfo ri : context.getPackageManager().queryIntentActivities(launcher, 0)) {
+            if (ri.activityInfo != null) {
+                out.add(ri.activityInfo.name);
+                if (ri.activityInfo.targetActivity != null) {
+                    out.add(ri.activityInfo.targetActivity);
+                }
+            }
+        }
+        return out;
+    }
+
+    @Nullable
+    private static String readAsset(@NonNull Context context, @NonNull String name) {
+        try (InputStream in = context.getAssets().open(name)) {
+            final ByteArrayOutputStream out = new ByteArrayOutputStream();
+            final byte[] buf = new byte[8192];
+            int n;
+            while ((n = in.read(buf)) > 0) {
+                out.write(buf, 0, n);
+            }
+            // JSONObject skips a leading byte order mark.
+            return new String(out.toByteArray(), StandardCharsets.UTF_8);
+        } catch (IOException e) {
+            return null;
+        }
+    }
+
+    /** Whether the theme of the activity class {@code cls} is floating (dialog-like). */
+    private static boolean isFloating(@NonNull String cls, @Nullable Activity activity) {
+        final Boolean known = sFloating.get(cls);
+        if (known != null) {
+            return known;
+        }
+        boolean floating = false;
+        try {
+            Resources.Theme theme = null;
+            if (activity != null) {
+                theme = activity.getTheme();
+            } else if (sPackage != null && sPackageManager != null && sResources != null) {
+                final ActivityInfo info =
+                        sPackageManager.getActivityInfo(new ComponentName(sPackage, cls), 0);
+                theme = sResources.newTheme();
+                theme.applyStyle(info.getThemeResource(), true /* force */);
+            }
+            if (theme != null) {
+                final TypedArray a = theme.obtainStyledAttributes(
+                        new int[] {android.R.attr.windowIsFloating});
+                floating = a.getBoolean(0, false);
+                a.recycle();
+            }
+        } catch (PackageManager.NameNotFoundException | RuntimeException e) {
+            Log.w(TAG, "Could not read the theme of " + cls, e);
+        }
+        if (floating) {
+            Log.i(TAG, cls + " has a floating theme; wildcard rules leave it alone");
+        }
+        sFloating.put(cls, floating);
+        return floating;
+    }
+
+    /** The parts of an EasyGo "magicwindow" entity that parallel view uses. */
+    static final class EasyGo {
+        /** Shopping mode: pages push each other from the side to the main side. */
+        static final int MODE_SHOPPING = 0;
+        /** Custom mode: activityPairs say which page opens on the side of which. */
+        static final int MODE_CUSTOM = 1;
+
+        int mode = MODE_CUSTOM;
+        /** Share of the width for the main (left) side from UX.windowsRatio for PAD, or 0. */
+        float ratio;
+        /** excludeDevice names PAD. */
+        boolean excludesPad;
+        /** UX.isDraggable (tablets only; false when absent). */
+        boolean draggable;
+        /** UX.supportDraggingToFullScreen names PAD or is "true". */
+        boolean dragToFullScreen;
+        /** {from, to} class names; "*" matches any activity of the app. */
+        final List<String[]> pairs = new ArrayList<>();
+        /** {main page, page shown on its side by default}. */
+        final List<String[]> dual = new ArrayList<>();
+        /** Pages that never take part in a split. */
+        final Set<String> transitional = new HashSet<>();
+        /** Pages that always fill the task. */
+        final Set<String> fullScreen = new HashSet<>();
+        /** Activities that the shopping-mode push rule leaves alone. */
+        final Set<String> pushExcluded = new HashSet<>();
+
+        /** Parses the first magicwindow entity, or returns null if there is none. */
+        @Nullable
+        static EasyGo parse(@NonNull String json) throws JSONException {
+            final JSONArray entities = new JSONObject(json).optJSONArray("logicEntities");
+            for (int e = 0; entities != null && e < entities.length(); e++) {
+                final JSONObject entity = entities.optJSONObject(e);
+                final JSONObject head = entity != null ? entity.optJSONObject("head") : null;
+                final JSONObject body = entity != null ? entity.optJSONObject("body") : null;
+                if (head == null || body == null
+                        || !"magicwindow".equals(head.optString("function"))) {
+                    continue;
+                }
+                final EasyGo cfg = new EasyGo();
+                cfg.mode = "0".equals(body.optString("mode", "1")) ? MODE_SHOPPING : MODE_CUSTOM;
+                cfg.excludesPad = namesPad(body.optString("excludeDevice"));
+                final JSONObject ux = body.optJSONObject("UX");
+                if (ux != null) {
+                    cfg.draggable = "true".equalsIgnoreCase(ux.optString("isDraggable").trim());
+                    final String full = ux.optString("supportDraggingToFullScreen").trim();
+                    cfg.dragToFullScreen = "true".equalsIgnoreCase(full) || namesPad(full);
+                    cfg.ratio = padRatio(ux.optJSONArray("windowsRatio"));
+                }
+                final JSONArray pairs = body.optJSONArray("activityPairs");
+                for (int i = 0; pairs != null && i < pairs.length(); i++) {
+                    final JSONObject p = pairs.optJSONObject(i);
+                    if (p == null) {
+                        continue;
+                    }
+                    final String from = p.optString("from").trim();
+                    final String to = p.optString("to").trim();
+                    if (!from.isEmpty() && !to.isEmpty()) {
+                        cfg.pairs.add(new String[] {from, to});
+                    } else {
+                        cfg.addDual(p);
+                    }
+                }
+                final JSONObject dual = body.optJSONObject("defaultDualActivities");
+                if (dual != null) {
+                    cfg.addDual(dual);
+                }
+                final JSONArray transitional = body.optJSONArray("transActivities");
+                for (int i = 0; transitional != null && i < transitional.length(); i++) {
+                    final String t = transitional.optString(i).trim();
+                    if (!t.isEmpty()) {
+                        cfg.transitional.add(t);
+                    }
+                }
+                final JSONArray activities = body.optJSONArray("Activities");
+                for (int i = 0; activities != null && i < activities.length(); i++) {
+                    final JSONObject a = activities.optJSONObject(i);
+                    final String name = a != null ? a.optString("name").trim() : "";
+                    if (!name.isEmpty() && "true".equals(a.optString("defaultFullScreen"))) {
+                        cfg.fullScreen.add(name);
+                    }
+                }
+                return cfg;
+            }
+            return null;
+        }
+
+        /** Whether a "|"-separated device list names PAD. */
+        private static boolean namesPad(@NonNull String devices) {
+            for (String d : devices.split("\\|")) {
+                if ("PAD".equalsIgnoreCase(d.trim())) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        /**
+         * The main side's share of the width from the PAD entry of UX.windowsRatio, whose ratio
+         * is "left|right" in pixels of the device the app was tuned on; 0 for an even split.
+         */
+        private static float padRatio(@Nullable JSONArray ratios) {
+            for (int i = 0; ratios != null && i < ratios.length(); i++) {
+                final JSONObject r = ratios.optJSONObject(i);
+                if (r == null || !"PAD".equalsIgnoreCase(r.optString("device").trim())) {
+                    continue;
+                }
+                final String[] lr = r.optString("ratio").split("\\|");
+                try {
+                    final float left = Float.parseFloat(lr[0].trim());
+                    final float right = Float.parseFloat(lr[1].trim());
+                    final float share = left / (left + right);
+                    if (share >= 0.2f && share <= 0.8f) {
+                        return share;
+                    }
+                } catch (NumberFormatException | ArrayIndexOutOfBoundsException e) {
+                    // Not two numbers: keep the even split.
+                }
+            }
+            return 0;
+        }
+
+        /** Adds {mainPage or each of mainPages (comma-separated), relatedPage}, once each. */
+        void addDual(@NonNull JSONObject o) {
+            final String related = o.optString("relatedPage").trim();
+            if (related.isEmpty()) {
+                return;
+            }
+            final String mains = o.has("mainPage")
+                    ? o.optString("mainPage") : o.optString("mainPages");
+            for (String m : mains.split(",")) {
+                final String main = m.trim();
+                if (main.isEmpty()) {
+                    continue;
+                }
+                boolean seen = false;
+                for (String[] d : dual) {
+                    seen |= d[0].equals(main) && d[1].equals(related);
+                }
+                if (!seen) {
+                    dual.add(new String[] {main, related});
+                }
+            }
+        }
+
+        /** Whether {@code cls} may take part in a split at all. */
+        boolean isSplittable(@NonNull String cls) {
+            return !transitional.contains(cls) && !fullScreen.contains(cls);
+        }
+    }
+
+    private static boolean matches(@Nullable String pattern, @NonNull String cls) {
+        return pattern == null || pattern.equals(cls);
+    }
+
+    @Nullable
+    private static String classOf(@NonNull String pkg, @Nullable ComponentName c) {
+        return c != null && pkg.equals(c.getPackageName()) ? c.getClassName() : null;
+    }
+
+    /** The activity class of {@code pkg} that an intent starts, also for implicit intents. */
+    @Nullable
+    private static String classOf(@NonNull String pkg, @NonNull Intent intent) {
+        if (intent.getComponent() != null) {
+            return classOf(pkg, intent.getComponent());
+        }
+        final PackageManager pm = sPackageManager;
+        if (pm == null || (intent.getPackage() != null && !pkg.equals(intent.getPackage()))) {
+            return null;
+        }
+        final ResolveInfo ri = pm.resolveActivity(intent, PackageManager.MATCH_DEFAULT_ONLY);
+        return ri != null && ri.activityInfo != null && pkg.equals(ri.activityInfo.packageName)
+                ? ri.activityInfo.name : null;
+    }
+
+    /**
+     * Whether a pair of classes matches a pair rule from {@code from} to {@code to} (null for
+     * "*"). Wildcard rules leave out floating pages and, for the push rule, the pages the push
+     * rule excludes.
+     */
+    private static boolean pairMatches(@NonNull EasyGo cfg, @Nullable String from,
+            @Nullable String to, @Nullable String primary, @Nullable String secondary) {
+        return primary != null && secondary != null
+                && cfg.isSplittable(primary) && cfg.isSplittable(secondary)
+                && matches(from, primary) && matches(to, secondary)
+                && (from != null || to != null || (!cfg.pushExcluded.contains(primary)
+                        && !cfg.pushExcluded.contains(secondary)));
+    }
+
+    /** Primary and secondary activity of a split that already exists or is being formed. */
+    private static final class PairMatches implements Predicate<Pair<Activity, Activity>> {
+        private final String mPackage;
+        private final EasyGo mCfg;
+        private final String mFrom;
+        private final String mTo;
+
+        PairMatches(String pkg, EasyGo cfg, String from, String to) {
+            mPackage = pkg;
+            mCfg = cfg;
+            mFrom = from;
+            mTo = to;
+        }
+
+        @Override
+        public boolean test(Pair<Activity, Activity> p) {
+            final String secondary = classOf(mPackage, p.second.getComponentName());
+            return pairMatches(mCfg, mFrom, mTo,
+                    classOf(mPackage, p.first.getComponentName()), secondary)
+                    && (mTo != null || !isFloating(secondary, p.second));
+        }
+    }
+
+    /** Primary activity and the intent it is about to start. */
+    private static final class IntentPairMatches implements Predicate<Pair<Activity, Intent>> {
+        private final String mPackage;
+        private final EasyGo mCfg;
+        private final String mFrom;
+        private final String mTo;
+
+        IntentPairMatches(String pkg, EasyGo cfg, String from, String to) {
+            mPackage = pkg;
+            mCfg = cfg;
+            mFrom = from;
+            mTo = to;
+        }
+
+        @Override
+        public boolean test(Pair<Activity, Intent> p) {
+            final String secondary = classOf(mPackage, p.second);
+            return pairMatches(mCfg, mFrom, mTo,
+                    classOf(mPackage, p.first.getComponentName()), secondary)
+                    && (mTo != null || !isFloating(secondary, null /* activity */));
+        }
+    }
+
+    private static final class ActivityIs implements Predicate<Activity> {
+        private final String mPackage;
+        private final String mClass;
+
+        ActivityIs(String pkg, String cls) {
+            mPackage = pkg;
+            mClass = cls;
+        }
+
+        @Override
+        public boolean test(Activity activity) {
+            return mClass.equals(classOf(mPackage, activity.getComponentName()));
+        }
+    }
+
+    private static final class IntentIs implements Predicate<Intent> {
+        private final String mPackage;
+        private final String mClass;
+
+        IntentIs(String pkg, String cls) {
+            mPackage = pkg;
+            mClass = cls;
+        }
+
+        @Override
+        public boolean test(Intent intent) {
+            return mClass.equals(classOf(mPackage, intent));
+        }
+    }
+
+    /**
+     * Splits only in landscape parents at least {@link #MIN_WIDTH_DP} wide. The density comes from
+     * the window metrics, as apps may change the density in their own resources.
+     */
+    private static final class MinWidthLandscape implements Predicate<WindowMetrics> {
+        @Override
+        public boolean test(WindowMetrics metrics) {
+            final Rect bounds = metrics.getBounds();
+            return bounds.width() >= MIN_WIDTH_DP * metrics.getDensity()
+                    && bounds.width() > bounds.height();
+        }
+    }
+}
