+++ b/services/core/java/com/android/server/wm/DisplayContent.java
@@ -30,6 +30,7 @@ import static android.app.WindowConfiguration.WINDOWING_MODE_UNDEFINED;
 import static android.content.pm.ActivityInfo.SCREEN_ORIENTATION_LANDSCAPE;
 import static android.content.pm.ActivityInfo.SCREEN_ORIENTATION_UNSET;
 import static android.content.pm.ActivityInfo.SCREEN_ORIENTATION_UNSPECIFIED;
+import static android.content.pm.ActivityInfo.SCREEN_ORIENTATION_USER_LANDSCAPE;
 import static android.content.res.Configuration.ORIENTATION_LANDSCAPE;
 import static android.content.res.Configuration.ORIENTATION_PORTRAIT;
 import static android.content.res.Configuration.ORIENTATION_UNDEFINED;
@@ -2131,7 +2132,8 @@ class DisplayContent extends RootDisplayArea implements WindowManagerPolicy.Disp
         if (top != null) {
             final int orientation = top.getRequestedOrientation();
             if ((orientation == SCREEN_ORIENTATION_UNSPECIFIED && !top.providesOrientation())
-                    || (orientation == ActivityInfo.SCREEN_ORIENTATION_BEHIND)) {
+                    || (orientation == ActivityInfo.SCREEN_ORIENTATION_BEHIND)
+                    || top.defersIgnoredOrientationRequest()) {
                 return top;
             }
         }
@@ -2217,7 +2219,8 @@ class DisplayContent extends RootDisplayArea implements WindowManagerPolicy.Disp
     private void applyFixedRotationForNonTopVisibleActivityIfNeeded(@NonNull ActivityRecord ar,
             @ActivityInfo.ScreenOrientation int topOrientation) {
         int orientation = ar.getRequestedOrientation();
-        if (orientation == ActivityInfo.SCREEN_ORIENTATION_BEHIND) {
+        if (orientation == ActivityInfo.SCREEN_ORIENTATION_BEHIND
+                || ar.defersIgnoredOrientationRequest()) {
             final ActivityRecord nextCandidate = getActivityBelowForDefiningOrientation(ar);
             if (nextCandidate != null) {
                 orientation = nextCandidate.getRequestedOrientation();
@@ -2231,13 +2234,23 @@ class DisplayContent extends RootDisplayArea implements WindowManagerPolicy.Disp
             }
             return;
         }
+        if (respectsLandscapeRequests() && shouldIgnoreOrientationRequest(orientation)
+                && ar.areBoundsLetterboxed()) {
+            // A landscape top is respected here. An activity behind it whose request is ignored
+            // and that is already letterboxed (in landscape, or for an aspect ratio) stays
+            // letterboxed rather than being drawn in its own rotation and relaid out. One that is
+            // not, typically one that filled the portrait display now rotating for the top,
+            // keeps its appearance through the transform, as elsewhere.
+            return;
+        }
         if (ar.inMultiWindowMode()
                 || ar.getTask().inMultiWindowMode()
                 || ar.getRequestedConfigurationOrientation() == ORIENTATION_UNDEFINED) {
             return;
         }
         final int displayRotation = getRotation();
-        final int rotation = mDisplayRotation.rotationForOrientation(orientation, displayRotation);
+        final int rotation = mDisplayRotation.rotationForOrientation(
+                toRespectedLandscape(orientation), displayRotation);
         final DisplayFrames rotatedFrames = ar.getFixedRotationTransformDisplayFrames();
         if (rotation == displayRotation && (rotatedFrames == null || (rotatedFrames.mWidth
                 == mDisplayFrames.mWidth && rotatedFrames.mHeight == mDisplayFrames.mHeight))) {
@@ -2289,8 +2302,8 @@ class DisplayContent extends RootDisplayArea implements WindowManagerPolicy.Disp
             return ROTATION_UNDEFINED;
         }
         final int currentRotation = getRotation();
-        final int rotation = mDisplayRotation.rotationForOrientation(activityOrientation,
-                currentRotation);
+        final int rotation = mDisplayRotation.rotationForOrientation(
+                toRespectedLandscape(activityOrientation), currentRotation);
         if (rotation == currentRotation) {
             return ROTATION_UNDEFINED;
         }
@@ -3350,7 +3363,31 @@ class DisplayContent extends RootDisplayArea implements WindowManagerPolicy.Disp
             return SCREEN_ORIENTATION_UNSPECIFIED;
         }
 
-        return orientation;
+        return toRespectedLandscape(orientation);
+    }
+
+    /**
+     * Whether this display respects landscape requests although it ignores orientation requests:
+     * it ignores them (large screens by default) and its natural orientation is landscape (see
+     * DisplayArea#shouldIgnoreOrientationRequest()).
+     */
+    boolean respectsLandscapeRequests() {
+        return getIgnoreOrientationRequest()
+                && getNaturalOrientation() == ORIENTATION_LANDSCAPE;
+    }
+
+    /**
+     * On a display that {@link #respectsLandscapeRequests}, returns "userLandscape" for
+     * "landscape" and "reverseLandscape". These are respected to keep the display in landscape,
+     * but each gives one fixed rotation, so a tablet held the other way would be turned over;
+     * with "userLandscape" the sensor or the rotation lock chooses between both landscape
+     * rotations, as they do while the display is in landscape and the request is ignored.
+     */
+    @ScreenOrientation
+    int toRespectedLandscape(@ScreenOrientation int orientation) {
+        return (orientation == SCREEN_ORIENTATION_LANDSCAPE
+                        || orientation == ActivityInfo.SCREEN_ORIENTATION_REVERSE_LANDSCAPE)
+                && respectsLandscapeRequests() ? SCREEN_ORIENTATION_USER_LANDSCAPE : orientation;
     }
 
     void updateDisplayInfo(@NonNull DisplayInfo newDisplayInfo) {
diff --git a/services/core/java/com/android/server/wm/TaskFragment.java b/services/core/java/com/android/server/wm/TaskFragment.java
index 4444b8e..530e599 100644
--- a/services/core/java/com/android/server/wm/TaskFragment.java
+++ b/services/core/java/com/android/server/wm/TaskFragment.java
@@ -33,6 +33,7 @@ import static android.content.pm.ActivityInfo.FLAG_ALLOW_UNTRUSTED_ACTIVITY_EMBE
 import static android.content.pm.ActivityInfo.FLAG_RESUME_WHILE_PAUSING;
 import static android.content.pm.ActivityInfo.SCREEN_ORIENTATION_UNSET;
 import static android.content.pm.ActivityInfo.SCREEN_ORIENTATION_UNSPECIFIED;
+import static android.content.pm.ActivityInfo.SCREEN_ORIENTATION_USER_LANDSCAPE;
 import static android.content.res.Configuration.ORIENTATION_LANDSCAPE;
 import static android.content.res.Configuration.ORIENTATION_PORTRAIT;
 import static android.content.res.Configuration.ORIENTATION_UNDEFINED;
@@ -2029,6 +2030,9 @@ class TaskFragment extends WindowContainer<WindowContainer> {
     @Override
     int getOrientation(@ActivityInfo.ScreenOrientation int candidate) {
         if (shouldReportOrientationUnspecified()) {
+            if (shouldKeepDisplayInLandscape()) {
+                return SCREEN_ORIENTATION_USER_LANDSCAPE;
+            }
             return SCREEN_ORIENTATION_UNSPECIFIED;
         }
         if (canSpecifyOrientation()) {
@@ -2073,6 +2077,71 @@ class TaskFragment extends WindowContainer<WindowContainer> {
         return super.providesOrientation() || shouldReportOrientationUnspecified();
     }
 
+    /**
+     * Whether this embedded TaskFragment, shown side by side with adjacent TaskFragments, keeps the
+     * display in landscape, on a display that {@link DisplayContent#respectsLandscapeRequests}:
+     * when the TaskFragments of the group, from the top, find a landscape request first, as the
+     * task would find it with them stacked. Sets {@link #mLastOrientationSource} towards the
+     * requesting activity, which rotation code uses to tell an app request apart (e.g. against a
+     * rotation lock).
+     *
+     * <p>A split may be shown only in landscape and be stacked in portrait, where its containers
+     * fill the task and report the orientation of their activities. Reporting unspecified side by
+     * side would let the display follow the sensor back to portrait, which stacks the split, whose
+     * landscape request then rotates the display to landscape again. A request below an opaque
+     * container (whose activities report an orientation, unspecified included) is covered when
+     * the split is stacked, so it does not keep the display in landscape. Only kept, not entered:
+     * the display must already be in landscape.
+     *
+     * <p>Only for Activity Embedding: the root tasks of split screen are adjacent as well, and the
+     * apps in them do not decide the display orientation.
+     */
+    private boolean shouldKeepDisplayInLandscape() {
+        if (!isEmbedded()) {
+            return false;
+        }
+        mLastOrientationSource = null;
+        final DisplayContent dc = getDisplayContent();
+        if (dc == null || getParent() == null || !dc.respectsLandscapeRequests()
+                || dc.getConfiguration().orientation != ORIENTATION_LANDSCAPE) {
+            return false;
+        }
+        final ArrayList<TaskFragment> group = new ArrayList<>();
+        group.add(this);
+        forOtherAdjacentTaskFragments(tf -> {
+            group.add(tf);
+        });
+        final ArrayList<WindowContainer> siblings = getParent().mChildren;
+        group.sort((a, b) -> Integer.compare(siblings.indexOf(b), siblings.indexOf(a)));
+        for (int i = 0; i < group.size(); i++) {
+            final TaskFragment tf = group.get(i);
+            final int orientation = tf.getActivitiesOrientation();
+            if (orientation == SCREEN_ORIENTATION_UNSET
+                    || orientation == ActivityInfo.SCREEN_ORIENTATION_BEHIND) {
+                continue;
+            }
+            if (!ActivityInfo.isFixedOrientationLandscape(orientation)) {
+                break;
+            }
+            if (tf != this) {
+                mLastOrientationSource = tf;
+            }
+            return true;
+        }
+        mLastOrientationSource = null;
+        return false;
+    }
+
+    /**
+     * The orientation that the activities of this TaskFragment request, as it reports it when it
+     * is not shown side by side. Like {@link #getOrientation}, updates
+     * {@link #mLastOrientationSource}.
+     */
+    @ActivityInfo.ScreenOrientation
+    private int getActivitiesOrientation() {
+        return super.getOrientation(SCREEN_ORIENTATION_UNSET);
+    }
+
     private boolean shouldReportOrientationUnspecified() {
         // Apps and their containers are not allowed to specify orientation from adjacent
         // TaskFragment.
