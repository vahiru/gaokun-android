diff --git a/services/core/java/com/android/server/wm/ActivityRecord.java b/services/core/java/com/android/server/wm/ActivityRecord.java
index 25bb429..65bc389 100644
--- a/services/core/java/com/android/server/wm/ActivityRecord.java
+++ b/services/core/java/com/android/server/wm/ActivityRecord.java
@@ -2446,7 +2446,7 @@ final class ActivityRecord extends WindowToken {
                 if (topAttached.isSnapshotCompatible(snapshot)
                         // This trampoline must be the same rotation.
                         && mDisplayContent.getDisplayRotation().rotationForOrientation(
-                                getOverrideOrientation(),
+                                mDisplayContent.toRespectedLandscape(getOverrideOrientation()),
                                 mDisplayContent.getRotation()) == snapshot.getRotation()) {
                     return STARTING_WINDOW_TYPE_SNAPSHOT;
                 }
@@ -7535,6 +7535,10 @@ final class ActivityRecord extends WindowToken {
             return SCREEN_ORIENTATION_UNSET;
         }
 
+        if (isVisibleRequested() && defersIgnoredOrientationRequest()) {
+            return SCREEN_ORIENTATION_BEHIND;
+        }
+
         if (candidate == SCREEN_ORIENTATION_BEHIND) {
             // Allow app to specify orientation regardless of its visibility state if the current
             // candidate want us to use orientation behind. I.e. the visible app on-top of this one
@@ -7552,6 +7556,29 @@ final class ActivityRecord extends WindowToken {
         return SCREEN_ORIENTATION_UNSET;
     }
 
+    /**
+     * Whether this translucent or floating activity takes its orientation from the activities
+     * behind it, as if it requested "behind", because the display ignores its request, on a
+     * display that {@link DisplayContent#respectsLandscapeRequests}. E.g. a portrait dialog over a
+     * landscape game: otherwise its request would end the search, the display would follow the
+     * sensor or the rotation lock to portrait, and the game would be laid out in portrait, as its
+     * own landscape request is respected, so it is not letterboxed, and no fixed rotation is
+     * applied to it while the display has no orientation source. Not while the keyguard is
+     * locked, where activities behind may be hidden.
+     */
+    boolean defersIgnoredOrientationRequest() {
+        if (fillsParent() || mDisplayContent == null
+                || !mDisplayContent.respectsLandscapeRequests()
+                || mDisplayContent.isKeyguardLocked()) {
+            return false;
+        }
+        final int orientation = getOverrideOrientation();
+        return orientation != SCREEN_ORIENTATION_UNSET
+                && orientation != ActivityInfo.SCREEN_ORIENTATION_UNSPECIFIED
+                && orientation != SCREEN_ORIENTATION_BEHIND
+                && mDisplayContent.shouldIgnoreOrientationRequest(orientation);
+    }
+
     /**
      * Returns the app's preferred orientation regardless of its current visibility state taking
      * into account orientation per-app overrides applied by the device manufacturers.
diff --git a/services/core/java/com/android/server/wm/DisplayArea.java b/services/core/java/com/android/server/wm/DisplayArea.java
index 598b577..a43f888 100644
--- a/services/core/java/com/android/server/wm/DisplayArea.java
+++ b/services/core/java/com/android/server/wm/DisplayArea.java
@@ -257,6 +257,16 @@ public class DisplayArea<T extends WindowContainer> extends WindowContainer<T> {
                 // The behavior of non-fixed orientation is the same as ignoring.
                 return true;
             }
+            if (ActivityInfo.isFixedOrientationLandscape(orientation) && mDisplayContent != null
+                    && mDisplayContent.getNaturalOrientation()
+                            == Configuration.ORIENTATION_LANDSCAPE) {
+                // On a display whose natural orientation is landscape, respect landscape
+                // requests, so that a landscape-only app (most games) fills the display instead
+                // of being letterboxed when it starts while the display is in portrait. Other
+                // requests are still ignored unless exempted per app: portrait-only apps stay
+                // letterboxed in landscape. See DisplayContent#respectsLandscapeRequests().
+                return false;
+            }
             return !shouldRespectOrientationRequestDueToPerAppOverride();
         }
         return false;
diff --git a/services/core/java/com/android/server/wm/DisplayContent.java b/services/core/java/com/android/server/wm/DisplayContent.java
index 1e5d898..0b575be 100644
