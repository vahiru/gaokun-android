+        /** A snapshot of the window of a container, and the color next to the divider. */
+        private static final class Snapshot {
+            @NonNull
+            final ScreenshotHardwareBuffer mBuffer;
+            /** Relative to the task. */
+            @NonNull
+            final Rect mBounds;
+            @Nullable
+            final Color mEdgeColor;
+
+            Snapshot(@NonNull ScreenshotHardwareBuffer buffer, @NonNull Rect bounds,
+                    @Nullable Color edgeColor) {
+                mBuffer = buffer;
+                mBounds = bounds;
+                mEdgeColor = edgeColor;
+            }
+        }
+
+        /**
+         * Takes a snapshot of the window of the top activity in {@code container}. Returns null if
+         * the container has activities of another process (they cannot be captured here, and one
+         * may be on top), if the window does not exactly fill the container (letterboxed or scaled
+         * for size compatibility), if it has secure content, or if it cannot be captured; the veil
+         * then shows a solid color.
+         */
+        @Nullable
+        private Snapshot takeSnapshot(@NonNull TaskFragmentContainer container,
+                boolean isPrimary) {
+            final TaskFragmentInfo info = container.getInfo();
+            if (info == null || container.hasCrossProcessActivities()) {
+                return null;
+            }
+            final Activity activity = container.getTopNonFinishingActivity();
+            final View decor = activity != null ? activity.getWindow().peekDecorView() : null;
+            final ViewRootImpl viewRoot = decor != null ? decor.getViewRootImpl() : null;
+            final SurfaceControl window = viewRoot != null ? viewRoot.getSurfaceControl() : null;
+            if (window == null || !window.isValid()) {
+                return null;
+            }
+            final Rect taskBounds = mProperties.mConfiguration.windowConfiguration.getBounds();
+            final int[] location = new int[2];
+            decor.getLocationOnScreen(location);
+            final Rect bounds = new Rect(0, 0, decor.getWidth(), decor.getHeight());
+            bounds.offset(location[0] - taskBounds.left, location[1] - taskBounds.top);
+            // The current bounds of the container; the veils already follow the touch.
+            final Rect containerBounds =
+                    new Rect(info.getConfiguration().windowConfiguration.getBounds());
+            containerBounds.offset(-taskBounds.left, -taskBounds.top);
+            if (containerBounds.isEmpty() || !bounds.equals(containerBounds)) {
+                return null;
+            }
+            // The content starts at the surface insets of the window surface.
+            final Rect insets = viewRoot.mWindowAttributes.surfaceInsets;
+            final Rect crop = new Rect(0, 0, bounds.width(), bounds.height());
+            crop.offset(insets.left, insets.top);
+            ScreenshotHardwareBuffer buffer = null;
+            try {
+                buffer = capture(window, crop);
+                if (buffer == null || buffer.containsSecureLayers()) {
+                    // Secure content comes out black.
+                    return null;
+                }
+                // The strip on the side of the divider.
+                final Rect edge = new Rect(crop);
+                final boolean atStart = isPrimary != mProperties.mIsReversedLayout;
+                if (mProperties.mIsVerticalSplit) {
+                    if (atStart) {
+                        edge.left = Math.max(edge.left, edge.right - SNAPSHOT_EDGE_SAMPLE_PX);
+                    } else {
+                        edge.right = Math.min(edge.right, edge.left + SNAPSHOT_EDGE_SAMPLE_PX);
+                    }
+                } else {
+                    if (atStart) {
+                        edge.top = Math.max(edge.top, edge.bottom - SNAPSHOT_EDGE_SAMPLE_PX);
+                    } else {
+                        edge.bottom = Math.min(edge.bottom, edge.top + SNAPSHOT_EDGE_SAMPLE_PX);
+                    }
+                }
+                final Snapshot snapshot =
+                        new Snapshot(buffer, bounds, mostCommonColor(capture(window, edge)));
+                buffer = null;
+                return snapshot;
+            } catch (RuntimeException e) {
+                Log.w(TAG, "Could not take a snapshot of " + activity.getComponentName(), e);
+                return null;
+            } finally {
+                if (buffer != null) {
+                    buffer.getHardwareBuffer().close();
+                }
+            }
+        }
+
+        /** Captures {@code crop} of {@code window} and its child surfaces. */
+        @Nullable
+        private static ScreenshotHardwareBuffer capture(@NonNull SurfaceControl window,
+                @NonNull Rect crop) {
+            return ScreenCaptureInternal.captureLayers(
+                    new ScreenCaptureInternal.LayerCaptureArgs.Builder(window)
+                            .setSourceCrop(crop)
+                            .setChildrenOnly(false)
+                            // Without READ_FRAME_BUFFER, SurfaceFlinger lets an app capture only
+                            // the layers of its own uid.
+                            .setUid(Process.myUid())
+                            .build());
+        }
+
+        /** The most common opaque color in {@code buffer}, which is closed. */
+        @Nullable
+        private static Color mostCommonColor(@Nullable ScreenshotHardwareBuffer buffer) {
+            if (buffer == null) {
+                return null;
+            }
+            final Bitmap bitmap;
+            // Copying a hardware bitmap counts as a slow call for StrictMode; the strip is small.
+            final StrictMode.ThreadPolicy policy = StrictMode.allowThreadViolations();
+            try {
+                final Bitmap hardware = buffer.asBitmap();
+                bitmap = hardware != null
+                        ? hardware.copy(Bitmap.Config.ARGB_8888, false /* isMutable */) : null;
+                if (hardware != null) {
+                    hardware.recycle();
+                }
+            } finally {
+                StrictMode.setThreadPolicy(policy);
+                buffer.getHardwareBuffer().close();
+            }
+            if (bitmap == null) {
+                return null;
+            }
+            final int[] pixels = new int[bitmap.getWidth() * bitmap.getHeight()];
+            bitmap.getPixels(pixels, 0, bitmap.getWidth(), 0, 0, bitmap.getWidth(),
+                    bitmap.getHeight());
+            bitmap.recycle();
+            // Translucent or undrawn pixels say nothing about the color of the page.
+            Arrays.sort(pixels);
+            int best = 0;
+            int bestCount = 0;
+            for (int i = 0; i < pixels.length; ) {
+                int j = i + 1;
+                while (j < pixels.length && pixels[j] == pixels[i]) {
+                    j++;
+                }
+                if (Color.alpha(pixels[i]) == 0xFF && j - i > bestCount) {
+                    best = pixels[i];
+                    bestCount = j - i;
+                }
+                i = j;
+            }
+            return bestCount > 0 ? Color.valueOf(best) : null;
+        }
+
+        /**
+         * Shows {@code snapshot} on {@code veil} and closes its buffer. Returns the snapshot
+         * surface, or null if there is no snapshot.
+         */
+        @Nullable
+        private static SurfaceControl showSnapshot(@NonNull SurfaceControl.Transaction t,
+                @Nullable SurfaceControl veil, @Nullable Snapshot snapshot, @NonNull String name,
+                @NonNull Rect outBounds) {
+            if (snapshot == null) {
+                return null;
+            }
+            final HardwareBuffer buffer = snapshot.mBuffer.getHardwareBuffer();
+            try {
+                if (veil == null) {
+                    return null;
+                }
+                final SurfaceControl surface = new SurfaceControl.Builder()
+                        .setParent(veil)
+                        .setName(name)
+                        .setCallsite("DividerManager.showSnapshot")
+                        .setBLASTLayer()
+                        .build();
+                t.setBuffer(surface, buffer)
+                        .setDataSpace(surface, snapshot.mBuffer.getColorSpace().getDataSpace())
+                        .setVisibility(surface, true);
+                outBounds.set(snapshot.mBounds);
+                return surface;
+            } finally {
+                // The transaction keeps its own reference to the buffer.
+                buffer.close();
+            }
+        }
+
+        private void removeSnapshots(@NonNull SurfaceControl.Transaction t) {
