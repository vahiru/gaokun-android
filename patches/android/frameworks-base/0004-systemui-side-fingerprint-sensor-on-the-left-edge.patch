@@ -119,28 +123,46 @@ constructor(
                 val displayWidth = if (isDefaultOrientation) size.width() else size.height()
                 val displayHeight = if (isDefaultOrientation) size.height() else size.width()
                 val sensorLengthInPx = sensorLocation.sensorRadius * 2
+                // A vertical sensor is on the right edge in the default orientation unless the
+                // device says otherwise (config_sideFpsSensorOnLeftEdge). A sensor on the left edge
+                // is placed like a right-edge sensor at the mirrored position (counted from the
