+                        displayHeight - sensorLocation.sensorLocationY - sensorLengthInPx
+                    } else {
+                        sensorLocation.sensorLocationY
+                    }
+                val verticalPlacementRotation =
+                    if (isSensorOnLeftEdgeInDefaultOrientation) {
+                        rotation.turnedHalfway()
+                    } else {
+                        rotation
+                    }
 
                 val (sensorLeft, sensorTop) =
                     if (isSensorVerticalInDefaultOrientation) {
-                        when (rotation) {
+                        when (verticalPlacementRotation) {
                             DisplayRotation.ROTATION_0 -> {
-                                Pair(displayWidth, sensorLocation.sensorLocationY)
+                                Pair(displayWidth, sensorY)
                             }
                             DisplayRotation.ROTATION_90 -> {
-                                Pair(sensorLocation.sensorLocationY, 0)
+                                Pair(sensorY, 0)
                             }
                             DisplayRotation.ROTATION_180 -> {
                                 Pair(
                                     0,
                                     displayHeight -
-                                        sensorLocation.sensorLocationY -
+                                        sensorY -
                                         sensorLengthInPx,
                                 )
                             }
                             DisplayRotation.ROTATION_270 -> {
                                 Pair(
                                     displayHeight -
-                                        sensorLocation.sensorLocationY -
+                                        sensorY -
                                         sensorLengthInPx,
                                     displayWidth,
                                 )
@@ -175,6 +197,7 @@ constructor(
                     top = sensorTop,
                     length = sensorLengthInPx,
                     isSensorVerticalInDefaultOrientation = isSensorVerticalInDefaultOrientation,
+                    isSensorOnLeftEdgeInDefaultOrientation = isSensorOnLeftEdgeInDefaultOrientation,
                 )
             }
             .distinctUntilChanged(
@@ -183,7 +206,9 @@ constructor(
                         old.top == new.top &&
                         old.length == new.length &&
                         old.isSensorVerticalInDefaultOrientation ==
-                            new.isSensorVerticalInDefaultOrientation
+                            new.isSensorVerticalInDefaultOrientation &&
+                        old.isSensorOnLeftEdgeInDefaultOrientation ==
+                            new.isSensorOnLeftEdgeInDefaultOrientation
                 }
             )
             .onEach {
diff --git a/packages/SystemUI/src/com/android/systemui/biometrics/domain/model/SideFpsSensorLocation.kt b/packages/SystemUI/src/com/android/systemui/biometrics/domain/model/SideFpsSensorLocation.kt
index 12f374f..e89dc9a 100644
--- a/packages/SystemUI/src/com/android/systemui/biometrics/domain/model/SideFpsSensorLocation.kt
+++ b/packages/SystemUI/src/com/android/systemui/biometrics/domain/model/SideFpsSensorLocation.kt
@@ -16,6 +16,8 @@
 
 package com.android.systemui.biometrics.domain.model
 
+import com.android.systemui.display.shared.model.DisplayRotation
+
 data class SideFpsSensorLocation(
     /** Pixel offset from the left of the screen */
     val left: Int,
@@ -27,5 +29,27 @@ data class SideFpsSensorLocation(
      * Whether the sensor is vertical when the device is in its default orientation (Rotation_0 or
      * Rotation_180)
      */
-    val isSensorVerticalInDefaultOrientation: Boolean
+    val isSensorVerticalInDefaultOrientation: Boolean,
+    /**
+     * Whether a vertical sensor is on the left edge of the display in its default orientation
+     * rather than on the right edge
+     */
+    val isSensorOnLeftEdgeInDefaultOrientation: Boolean = false,
 )
+
+/**
+ * The rotation in which a sensor on the right (or top) edge sits where this sensor sits in
+ * [rotation]. A sensor on the left edge in the default orientation sits where a right-edge sensor
+ * does with the display turned a further 180 degrees.
+ */
+fun SideFpsSensorLocation.placementRotation(rotation: DisplayRotation): DisplayRotation =
+    if (isSensorOnLeftEdgeInDefaultOrientation) rotation.turnedHalfway() else rotation
+
+/** This rotation turned a further 180 degrees. */
+fun DisplayRotation.turnedHalfway(): DisplayRotation =
+    when (this) {
+        DisplayRotation.ROTATION_0 -> DisplayRotation.ROTATION_180
+        DisplayRotation.ROTATION_90 -> DisplayRotation.ROTATION_270
+        DisplayRotation.ROTATION_180 -> DisplayRotation.ROTATION_0
+        DisplayRotation.ROTATION_270 -> DisplayRotation.ROTATION_90
+    }
