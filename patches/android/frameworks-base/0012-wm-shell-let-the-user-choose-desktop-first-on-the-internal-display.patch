index c1e8a7a..491a4f0 100644
--- a/core/res/res/values/config.xml
+++ b/core/res/res/values/config.xml
@@ -7764,6 +7764,12 @@
     <!-- Whether the current device's internal display can host desktop sessions.  -->
     <bool name="config_canInternalDisplayHostDesktops">false</bool>
 
+    <!-- Whether the internal display switches between touch-first and desktop-first only as the
+         user chooses with the per-user Settings.Secure "desktop_first_on_default_display",
+         instead of following external displays, a connected touchpad and keyboard, and the
+         device state. Applies when the internal display can host desktop sessions. -->
+    <bool name="config_desktopFirstFollowsUserSetting">false</bool>
+
     <!-- Whether desktop mode is supported on the current device  -->
     <bool name="config_isDesktopModeSupported">false</bool>
 
