@@ -127,17 +130,45 @@ class DesktopDisplayModeController(
             }
         }
 
+    /**
+     * Whether the user chooses between touch-first and desktop-first for the default display,
+     * with [DESKTOP_FIRST_ON_DEFAULT_DISPLAY], instead of it following external displays, input
+     * devices and the device state. For devices whose keyboard cover cannot tell whether it is
+     * attached.
+     */
+    private val desktopFirstFollowsUserSetting =
+        context.resources.getBoolean(R.bool.config_desktopFirstFollowsUserSetting)
+
+    private val userSettingObserver =
+        object : ContentObserver(mainHandler) {
+            override fun onChange(selfChange: Boolean) {
+                updateDefaultDisplayWindowingMode()
+            }
+        }
+
     init {
         shellInit.addInitCallback({ onInit() }, this)
-        inputManager.registerInputDeviceListener(inputDeviceListener, mainHandler)
-        if (Flags.enableDesktopFirstLaptopStateBugfix()) {
-            deviceStateManager.registerCallback(mainExecutor, deviceStateCallback)
+        // With the user's choice, input devices and the device state do not change the mode.
+        if (!desktopFirstFollowsUserSetting) {
+            inputManager.registerInputDeviceListener(inputDeviceListener, mainHandler)
+            if (Flags.enableDesktopFirstLaptopStateBugfix()) {
+                deviceStateManager.registerCallback(mainExecutor, deviceStateCallback)
+            }
         }
     }
 
     private fun onInit() {
         shellCommandHandler.addDumpCallback(this::dump, this)
-        if (Flags.enableDesktopFirstUserChangeBugfix()) {
+        if (desktopFirstFollowsUserSetting) {
+            context.contentResolver.registerContentObserver(
+                Settings.Secure.getUriFor(DESKTOP_FIRST_ON_DEFAULT_DISPLAY),
+                /* notifyForDescendants= */ false,
+                userSettingObserver,
+                UserHandle.USER_ALL,
+            )
+        }
+        // With the user's choice, the setting of the new user applies after a user switch.
+        if (Flags.enableDesktopFirstUserChangeBugfix() || desktopFirstFollowsUserSetting) {
             shellController.addUserChangeListener(
                 object : UserChangeListener {
                     override fun onUserChanged(newUserId: Int, userContext: Context) {
@@ -252,6 +283,14 @@ class DesktopDisplayModeController(
             isDefaultDisplayDesktopEligible,
         )
         if (isDefaultDisplayDesktopEligible) {
+            if (desktopFirstFollowsUserSetting) {
+                val isDesktopFirstChosenByUser = isDesktopFirstChosenByUser()
+                logV(
+                    "canDesktopFirstModeBeEnabledOnDefaultDisplay: isDesktopFirstChosenByUser=%b",
+                    isDesktopFirstChosenByUser,
+                )
+                return isDesktopFirstChosenByUser
+            }
             val isExtendedDisplayEnabled = isExtendedDisplayEnabled()
             val hasExternalDisplay = hasExternalDisplay()
             logV(
@@ -335,6 +374,14 @@ class DesktopDisplayModeController(
         return desktopState.isDesktopModeSupportedOnDisplay(DEFAULT_DISPLAY)
     }
 
+    private fun isDesktopFirstChosenByUser() =
+        Settings.Secure.getIntForUser(
+            context.contentResolver,
+            DESKTOP_FIRST_ON_DEFAULT_DISPLAY,
+            0,
+            UserHandle.USER_CURRENT,
+        ) != 0
+
     // TODO(b/478792808): Remove suppression
     @SuppressWarnings("ProtoLogNonConstantFormat")
     private fun logV(msg: String, vararg arguments: Any?) {
@@ -372,6 +419,10 @@ class DesktopDisplayModeController(
         if (Flags.enableDesktopFirstLaptopStateBugfix()) {
             pw.println("isDesktopFirstDeviceState=" + isDesktopFirstDeviceState)
         }
+        pw.println("desktopFirstFollowsUserSetting=" + desktopFirstFollowsUserSetting)
+        if (desktopFirstFollowsUserSetting) {
+            pw.println("isDesktopFirstChosenByUser=" + isDesktopFirstChosenByUser())
+        }
 
         pw.println("Current Desktop Display Modes:")
         pw.increaseIndent()
@@ -383,5 +434,12 @@ class DesktopDisplayModeController(
 
     companion object {
         private const val TAG = "DesktopDisplayModeController"
+
+        /**
+         * [Settings.Secure] key, per user: a non-zero value makes the default display
+         * desktop-first, 0 or unset touch-first. Read only with
