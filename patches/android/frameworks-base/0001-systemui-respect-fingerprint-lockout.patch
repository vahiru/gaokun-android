From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] SystemUI: respect a class 1/2 fingerprint lockout

isUnlockingWithBiometricAllowed() only blocks all biometrics when a class 3
biometric is locked out. For a class 1/2 fingerprint it ends with
!isFaceLockedOut || !isFingerprintLockedOut, which stays true during the
fingerprint's own timed lockout unless face is locked out as well, and always
on devices without face authentication. SystemUI then keeps requesting
fingerprint authentication, and the framework rejects every request until the
lockout ends.

Treat a fingerprint lockout as disabling fingerprint unlock regardless of the
sensor strength, as it already does for class 3. During the lockout SystemUI
runs fingerprint detection instead, as for class 3, and resumes authentication
once the lockout is reset.

Origin: local
Upstream-Status: Pending
---
 .../keyguard/KeyguardUpdateMonitor.java       |  6 ++++-
 .../keyguard/KeyguardUpdateMonitorTest.java   | 22 +++++++++++++++++++
 2 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/packages/SystemUI/src/com/android/keyguard/KeyguardUpdateMonitor.java b/packages/SystemUI/src/com/android/keyguard/KeyguardUpdateMonitor.java
index 9998e0b..13c4bed 100644
--- a/packages/SystemUI/src/com/android/keyguard/KeyguardUpdateMonitor.java
+++ b/packages/SystemUI/src/com/android/keyguard/KeyguardUpdateMonitor.java
@@ -1652,7 +1652,11 @@ public class KeyguardUpdateMonitor implements TrustManager.TrustListener, CoreSt
             @NonNull BiometricSourceType biometricSourceType) {
         switch (biometricSourceType) {
             case FINGERPRINT:
-                return isUnlockingWithBiometricAllowed(isFingerprintClass3());
+                // isUnlockingWithBiometricAllowed(boolean) still allows a locked-out
+                // class 1/2 fingerprint unless face is locked out too, which never
+                // happens without face authentication.
+                return !isFingerprintLockedOut()
+                        && isUnlockingWithBiometricAllowed(isFingerprintClass3());
             case FACE:
                 return getFaceAuthInteractor() != null
                         && isUnlockingWithBiometricAllowed(
diff --git a/packages/SystemUI/tests/src/com/android/keyguard/KeyguardUpdateMonitorTest.java b/packages/SystemUI/tests/src/com/android/keyguard/KeyguardUpdateMonitorTest.java
index be6d145..541b028 100644
--- a/packages/SystemUI/tests/src/com/android/keyguard/KeyguardUpdateMonitorTest.java
+++ b/packages/SystemUI/tests/src/com/android/keyguard/KeyguardUpdateMonitorTest.java
@@ -1050,6 +1050,28 @@ public class KeyguardUpdateMonitorTest extends SysuiTestCase {
                 BiometricSourceType.FINGERPRINT));
     }
 
+    @Test
+    public void class1FingerprintTemporaryLockoutDisablesFingerprintAuth() throws RemoteException {
+        setupFingerprintAuth(/* isClass3 */ false);
+        primaryAuthNotRequiredByStrongAuthTracker();
+        fingerprintErrorTemporaryLockOut();
+        Assert.assertFalse(mKeyguardUpdateMonitor.isUnlockingWithFingerprintAllowed());
+    }
+
+    @Test
+    public void class1FingerprintAuthResumesAfterLockoutReset() throws RemoteException {
+        ArgumentCaptor<FingerprintManager.LockoutResetCallback> callback =
+                ArgumentCaptor.forClass(FingerprintManager.LockoutResetCallback.class);
+        verify(mFingerprintManager).addLockoutResetCallback(callback.capture());
+        setupFingerprintAuth(/* isClass3 */ false);
+        primaryAuthNotRequiredByStrongAuthTracker();
+        fingerprintErrorTemporaryLockOut();
+        Assert.assertFalse(mKeyguardUpdateMonitor.isUnlockingWithFingerprintAllowed());
+        callback.getValue().onLockoutReset(FINGERPRINT_SENSOR_ID);
+        mTestableLooper.processAllMessages();
+        Assert.assertTrue(mKeyguardUpdateMonitor.isUnlockingWithFingerprintAllowed());
+    }
+
