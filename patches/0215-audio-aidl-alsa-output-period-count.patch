+// gaokun3: alsa_utils takes the period count of every built-in device from
+// ro.hardware.audio.tinyalsa.period_count, playback and capture alike. Playback can run with fewer
+// periods than capture needs (the capture hook processes 85 ms blocks while the ALSA buffer keeps
+// filling), so ro.vendor.audio.primary.out_period_count sets it for output devices only. The block
+// alsa_utils asked for (period_size * period_count) stays the same; only the number of periods it
+// is cut into changes. The kernel may still round the period size up (q6apm-dai: multiples of 480
+// frames). Unset or below 2 keeps alsa_utils' choice.
+void applyOutputPeriodCount(const DeviceProfile& deviceProfile, alsa_device_profile* profile) {
+    if (deviceProfile.direction != PCM_OUT) return;
+    const unsigned periodCount = static_cast<unsigned>(
+            ::android::base::GetIntProperty("ro.vendor.audio.primary.out_period_count", 0));
+    struct pcm_config& config = profile->default_config;
+    if (periodCount < 2 || config.period_count == 0 || periodCount == config.period_count) return;
+    const unsigned blockFrames = config.period_size * config.period_count;
+    config.period_count = periodCount;
+    config.period_size = blockFrames / periodCount;
+    profile->min_period_size = profile->max_period_size = config.period_size;
+    LOG(DEBUG) << __func__ << ": address=" << deviceProfile << " period_count " << periodCount
+               << ", period_size " << config.period_size;
+}
+
 }  // namespace
 
