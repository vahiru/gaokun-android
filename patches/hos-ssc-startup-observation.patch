+// Diagnostic-only process budget; never changes a sensor decision.
+uint64_t ObserveNs() {
+    struct timespec ts = {};
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return static_cast<uint64_t>(ts.tv_sec) * 1000000000ULL + ts.tv_nsec;
+}
+uint32_t ObserveBits(float value) {
+    uint32_t bits;
+    static_assert(sizeof(bits) == sizeof(value), "float32 required");
+    std::memcpy(&bits, &value, sizeof(bits));
+    return bits;
+}
+bool ObservePermit() {
+    static std::atomic_uint used{0};
+    unsigned n = used.load(std::memory_order_relaxed);
+    while (n < 512) {
+        if (used.compare_exchange_weak(n, n + 1, std::memory_order_relaxed)) {
+            if (n == 511) LOG(INFO) << "SscObs: observation-budget-exhausted mono_ns=" << ObserveNs();
+            return n < 511;
+        }
+    }
+    return false;
+}
 // 50 Hz 足够自动旋转与体感；SSC 会给出它实际采用的速率。
