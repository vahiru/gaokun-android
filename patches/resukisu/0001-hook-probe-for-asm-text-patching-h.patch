From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] KernelSU: hook: probe for <asm/text-patching.h> with __has_include

Mainline Linux 6.13+ moved aarch64_insn_patch_text() from <asm/patching.h> to
<asm/text-patching.h>. Probe for <asm/text-patching.h>, <asm/patching.h>, and
<asm/insn.h> via __has_include in kernel/hook/patch_memory.h before falling back
to the LINUX_VERSION_CODE check.

Origin: local
Upstream-Status: Pending
---
diff --git a/kernel/hook/patch_memory.h b/kernel/hook/patch_memory.h
index a5a722e..3d55dba 100644
--- a/kernel/hook/patch_memory.h
+++ b/kernel/hook/patch_memory.h
@@ -10,7 +10,25 @@
 #include "linux/version.h"
 
 #ifdef __aarch64__
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 14, 0)
+/*
+ * aarch64_insn_patch_text() lives in a header whose name has changed twice:
+ *   < 5.14        asm/insn.h
+ *   5.14 .. 6.12  asm/patching.h
+ *   >= 6.13       asm/text-patching.h   (cross-arch rename; mainline commit
+ *                 "arm64: move aarch64_insn_patch_text* to text-patching.h")
+ * A LINUX_VERSION_CODE ladder gets this wrong on every future rename, so
+ * probe for the header instead and keep the version ladder only as the
+ * fallback for compilers without __has_include.
+ */
+#if defined(__has_include)
+#  if __has_include(<asm/text-patching.h>)
+#    include <asm/text-patching.h> // IWYU pragma: keep
+#  elif __has_include(<asm/patching.h>)
+#    include <asm/patching.h> // IWYU pragma: keep
+#  else
+#    include <asm/insn.h> // IWYU pragma: keep
+#  endif
+#elif LINUX_VERSION_CODE >= KERNEL_VERSION(5, 14, 0)
 #include "asm/patching.h" // IWYU pragma: keep
 #elif LINUX_VERSION_CODE >= KERNEL_VERSION(4, 0, 0)
 #include "asm/insn.h" // IWYU pragma: keep
