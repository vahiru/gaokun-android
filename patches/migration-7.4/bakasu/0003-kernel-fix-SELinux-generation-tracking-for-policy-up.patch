From e59394b0430eefa2d8676cd79228187e19c55d88 Mon Sep 17 00:00:00 2001
From: Akisaira <akisaira@outlook.com>
Date: Wed, 18 Nov 2026 23:13:26 +1100
Subject: [PATCH] kernel: fix SELinux generation tracking for policy updates

When KernelSU installs its modified policy it resets the AVC and reports
policy load seqno 0 to netlink listeners and the SELinux status page, and
the new policy keeps the old latest_granting. Userspace AVCs that compare
seqnos (libselinux) then do not see a new policy generation.

Give the new policy latest_granting + 1 and report that seqno, as
tiann/KernelSU did in 28db74f6f469. The legacy path for kernels without
the policy mutex is left as it was.

Origin: other, https://github.com/tiann/KernelSU/commit/28db74f6f4692e97006ce9ebd8b19b9cc614b5b7
Upstream-Status: Pending
---
 kernel/selinux/rules.c | 24 +++++++++++++-----------
 1 file changed, 13 insertions(+), 11 deletions(-)

diff --git a/kernel/selinux/rules.c b/kernel/selinux/rules.c
index 4544b3d1..c3cae546 100644
--- a/kernel/selinux/rules.c
+++ b/kernel/selinux/rules.c
@@ -33,17 +33,17 @@ extern int avc_ss_reset(u32 seqno);
 extern int avc_ss_reset(struct selinux_avc *avc, u32 seqno);
 #endif
 // reset avc cache table, otherwise the new rules will not take effect if already denied
-static void reset_avc_cache()
+static void reset_avc_cache(u32 seqno)
 {
 #if ((!defined(KSU_COMPAT_USE_SELINUX_STATE)) || LINUX_VERSION_CODE >= KERNEL_VERSION(6, 4, 0))
-    avc_ss_reset(0);
-    selnl_notify_policyload(0);
-    selinux_status_update_policyload(0);
+    avc_ss_reset(seqno);
+    selnl_notify_policyload(seqno);
+    selinux_status_update_policyload(seqno);
 #else
     struct selinux_avc *avc = selinux_state.avc;
-    avc_ss_reset(avc, 0);
-    selnl_notify_policyload(0);
-    selinux_status_update_policyload(&selinux_state, 0);
+    avc_ss_reset(avc, seqno);
+    selnl_notify_policyload(seqno);
+    selinux_status_update_policyload(&selinux_state, seqno);
 #endif
     selinux_xfrm_notify_policyload();
 }
@@ -310,11 +310,12 @@ void apply_kernelsu_rules()
     ksu_allow(db, "system_server", KERNEL_SU_DOMAIN, "process", "sigkill");
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0) || defined(KSU_COMPAT_HAS_POLICY_MUTEX)
+    pol->latest_granting = old_pol->latest_granting + 1;
     rcu_assign_pointer(selinux_state.policy, pol);
     synchronize_rcu();
     ksu_destroy_sepolicy(old_pol);
 
-    reset_avc_cache();
+    reset_avc_cache(pol->latest_granting);
 out_unlock:
     mutex_unlock(&selinux_state.policy_mutex);
 #else
@@ -326,7 +327,7 @@ out_unlock:
     memcpy(policydb_ptr, newpolicydb, sizeof(*policydb_ptr));
     ksu_unlock_sepolicy_legacy();
 
-    reset_avc_cache();
+    reset_avc_cache(0);
 
     /* Free the old policydb. */
     ksu_destroy_policydb(oldpolicydb);
@@ -715,11 +716,12 @@ int handle_sepolicy(void __user *user_data, u64 data_len)
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0) || defined(KSU_COMPAT_HAS_POLICY_MUTEX)
     // 5.10+
+    pol->latest_granting = old_pol->latest_granting + 1;
     rcu_assign_pointer(selinux_state.policy, pol);
     synchronize_rcu();
     ksu_destroy_sepolicy(old_pol);
 
-    reset_avc_cache();
+    reset_avc_cache(pol->latest_granting);
     ret = success_cmd_count;
     goto out_unlock;
 
@@ -737,7 +739,7 @@ out_unlock:
     memcpy(policydb_ptr, newpolicydb, sizeof(*policydb_ptr));
     ksu_unlock_sepolicy_legacy();
 
-    reset_avc_cache();
+    reset_avc_cache(0);
 
     /* Free the old policydb. */
     ksu_destroy_policydb(oldpolicydb);
