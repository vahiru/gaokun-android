From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] KernelSU: use orig_x0 for the first syscall argument on arm64
 7.3+

Since Linux 7.3 the native arm64 syscall wrappers take the first argument
from regs->orig_x0 instead of regs->regs[0] (SC_ARM64_REGS_TO_ARGS). The
hooks that rewrite it no longer reach the syscall: sucompat sets up the
execveat() of ksud through regs[0], so "su" ran the original path, and
__ksyscall() left the first argument of every syscall it calls at zero.

Add PT_REGS_SYSCALL_PARM1(), which is orig_x0 on arm64 7.3+ and the first
argument register everywhere else, and use it wherever the regs are a
syscall's: the sucompat and execve hooks, the read, fstat, init_module and
finit_module hooks, adb_root and the reboot supercall. __ksyscall() sets
both. PT_REAL_REGS() still reads the kprobe's first function argument.

tiann/KernelSU fixed the same in 9ae6e65aa88a on top of the
PT_REGS_SYSCALL_PARM1() it already had; the pinned ReSukiSU has neither.

Assisted-by: Claude:claude-opus-5-5
Origin: other, https://github.com/tiann/KernelSU/commit/9ae6e65aa88a13a47f8e895550dd5b369c6d8820
Upstream-Status: Pending
---
 kernel/compat/kernel_compat.h       | 1 +
 kernel/feature/adb_root.c           | 2 +-
 kernel/feature/module_load_filter.c | 4 ++--
 kernel/feature/sucompat.c           | 8 ++++----
 kernel/hook/syscall_event_bridge.c  | 2 +-
 kernel/include/arch.h               | 9 +++++++++
 kernel/runtime/ksud_integration.c   | 6 +++---
 kernel/supercall/supercall.c        | 2 +-
 8 files changed, 22 insertions(+), 12 deletions(-)

diff --git a/kernel/compat/kernel_compat.h b/kernel/compat/kernel_compat.h
index 505fb829..124b5042 100644
--- a/kernel/compat/kernel_compat.h
+++ b/kernel/compat/kernel_compat.h
@@ -69,6 +69,7 @@ static_assert(1 == 0, "Unsupported architecture!");
         extern long KSU_SYS_PREFIX(name)(const struct pt_regs *);                                                      \
         struct pt_regs __ksu_regs = { 0 };                                                                             \
         PT_REGS_PARM1(&__ksu_regs) = (unsigned long)(a);                                                               \
+        PT_REGS_SYSCALL_PARM1(&__ksu_regs) = (unsigned long)(a);                                                       \
         PT_REGS_PARM2(&__ksu_regs) = (unsigned long)(b);                                                               \
         PT_REGS_PARM3(&__ksu_regs) = (unsigned long)(c);                                                               \
         PT_REGS_SYSCALL_PARM4(&__ksu_regs) = (unsigned long)(d);                                                       \
diff --git a/kernel/feature/adb_root.c b/kernel/feature/adb_root.c
index f79030db..b16dfa37 100644
--- a/kernel/feature/adb_root.c
+++ b/kernel/feature/adb_root.c
@@ -220,7 +220,7 @@ long ksu_adb_root_handle_execve_tracepoint(struct pt_regs *regs)
     // Tracepoint Syscall Redirect hook always in GKI2
     // So there no need to check for modern static key interface
     if (static_branch_unlikely(&ksu_adb_root)) {
-        return do_ksu_adb_root_handle_execve((const char __user *)PT_REGS_PARM1(regs), regs,
+        return do_ksu_adb_root_handle_execve((const char __user *)PT_REGS_SYSCALL_PARM1(regs), regs,
                                              (unsigned long *)&PT_REGS_PARM3(regs));
     }
     return 0;
diff --git a/kernel/feature/module_load_filter.c b/kernel/feature/module_load_filter.c
index bbe7c4ce..d534c8d9 100644
--- a/kernel/feature/module_load_filter.c
+++ b/kernel/feature/module_load_filter.c
@@ -289,7 +289,7 @@ int ksu_handle_finit_module(int fd, int flags)
 static long (*orig_sys_init_module)(const struct pt_regs *regs);
 static long ksu_sys_init_module(const struct pt_regs *regs)
 {
-    int ret = ksu_handle_init_module((const void __user *)PT_REGS_PARM1(regs), (unsigned long)PT_REGS_PARM2(regs));
+    int ret = ksu_handle_init_module((const void __user *)PT_REGS_SYSCALL_PARM1(regs), (unsigned long)PT_REGS_PARM2(regs));
 
     if (!ret)
         return ret;
@@ -301,7 +301,7 @@ static long ksu_sys_init_module(const struct pt_regs *regs)
 static long (*orig_sys_finit_module)(const struct pt_regs *regs);
 static long ksu_sys_finit_module(const struct pt_regs *regs)
 {
-    int ret = ksu_handle_finit_module((int)PT_REGS_PARM1(regs), (int)PT_REGS_PARM3(regs));
+    int ret = ksu_handle_finit_module((int)PT_REGS_SYSCALL_PARM1(regs), (int)PT_REGS_PARM3(regs));
 
     if (!ret)
         return ret;
diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
index aa4a13eb..d8c8166a 100644
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -241,7 +241,7 @@ static long ksu_handle_execve_sucompat_common_internal(const char __user **filen
     struct file *ksud_file;
     const struct cred *old_cred;
 
-    if (execveat && ((int)PT_REGS_PARM1(regs) != AT_FDCWD || (int)PT_REGS_PARM5(regs) != 0))
+    if (execveat && ((int)PT_REGS_SYSCALL_PARM1(regs) != AT_FDCWD || (int)PT_REGS_PARM5(regs) != 0))
         goto do_orig_execve;
 
     if (unlikely(!filename_user))
@@ -286,7 +286,7 @@ static long ksu_handle_execve_sucompat_common_internal(const char __user **filen
     pending_sucompat = ksu_sulog_capture_sucompat_tracepoint(*filename_user, argv_user, GFP_KERNEL);
     // execve(file, argv, environ)
     // execveat(fd, file, argv, environ, flags)
-    orig_regs[0] = regs->__PT_PARM1_REG;
+    orig_regs[0] = regs->__PT_SYSCALL_PARM1_REG;
     orig_regs[1] = regs->__PT_PARM2_REG;
     orig_regs[2] = regs->__PT_PARM3_REG;
     orig_regs[3] = regs->__PT_SYSCALL_PARM4_REG;
@@ -295,7 +295,7 @@ static long ksu_handle_execve_sucompat_common_internal(const char __user **filen
     regs->__PT_SYSCALL_PARM4_REG = envp;
     regs->__PT_PARM3_REG = (unsigned long)argv_user;
     regs->__PT_PARM2_REG = empty_user_path();
-    regs->__PT_PARM1_REG = tmp_fd;
+    regs->__PT_SYSCALL_PARM1_REG = tmp_fd;
 
     ret = escape_with_root_profile();
     if (ret) {
@@ -306,7 +306,7 @@ static long ksu_handle_execve_sucompat_common_internal(const char __user **filen
     ret = ksu_syscall_table[__NR_execveat](regs);
     if (ret < 0) {
         ksu_close_fd(tmp_fd);
-        regs->__PT_PARM1_REG = orig_regs[0];
+        regs->__PT_SYSCALL_PARM1_REG = orig_regs[0];
         regs->__PT_PARM2_REG = orig_regs[1];
         regs->__PT_PARM3_REG = orig_regs[2];
         regs->__PT_SYSCALL_PARM4_REG = orig_regs[3];
diff --git a/kernel/hook/syscall_event_bridge.c b/kernel/hook/syscall_event_bridge.c
index 43dc582c..605e0626 100644
--- a/kernel/hook/syscall_event_bridge.c
+++ b/kernel/hook/syscall_event_bridge.c
@@ -74,7 +74,7 @@ extern struct static_key_true ksud_execve_key;
 static long __nocfi ksu_hook_execve_common(int orig_nr, const struct pt_regs *regs, bool execveat)
 {
     const char __user **filename_user =
-        execveat ? (const char __user **)&PT_REGS_PARM2(regs) : (const char __user **)&PT_REGS_PARM1(regs);
+        execveat ? (const char __user **)&PT_REGS_PARM2(regs) : (const char __user **)&PT_REGS_SYSCALL_PARM1(regs);
     const char __user *const __user *argv_user = execveat ? (const char __user *const __user *)PT_REGS_PARM3(regs) :
                                                             (const char __user *const __user *)PT_REGS_PARM2(regs);
     bool current_is_init = is_init(current_cred());
diff --git a/kernel/include/arch.h b/kernel/include/arch.h
index c6bf518d..bd18a15c 100644
--- a/kernel/include/arch.h
+++ b/kernel/include/arch.h
@@ -6,6 +6,10 @@
 #if defined(__aarch64__)
 
 #define __PT_PARM1_REG regs[0]
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0)
+/* Since 7.3 the native syscall wrappers take the first argument from orig_x0. */
+#define __PT_SYSCALL_PARM1_REG orig_x0
+#endif
 #define __PT_PARM2_REG regs[1]
 #define __PT_PARM3_REG regs[2]
 #define __PT_SYSCALL_PARM4_REG regs[3]
@@ -77,6 +81,11 @@
 #endif
 
 #define PT_REGS_PARM1(x) (__PT_REGS_CAST(x)->__PT_PARM1_REG)
+#ifndef __PT_SYSCALL_PARM1_REG
+#define __PT_SYSCALL_PARM1_REG __PT_PARM1_REG
+#endif
+/* The first argument of a syscall, as the syscall itself reads it from its pt_regs. */
+#define PT_REGS_SYSCALL_PARM1(x) (__PT_REGS_CAST(x)->__PT_SYSCALL_PARM1_REG)
 #define PT_REGS_PARM2(x) (__PT_REGS_CAST(x)->__PT_PARM2_REG)
 #define PT_REGS_PARM3(x) (__PT_REGS_CAST(x)->__PT_PARM3_REG)
 #define PT_REGS_SYSCALL_PARM4(x) (__PT_REGS_CAST(x)->__PT_SYSCALL_PARM4_REG)
diff --git a/kernel/runtime/ksud_integration.c b/kernel/runtime/ksud_integration.c
index 2ddcf312..e05a74a6 100644
--- a/kernel/runtime/ksud_integration.c
+++ b/kernel/runtime/ksud_integration.c
@@ -977,7 +977,7 @@ static void ksu_execve_hook_ksud_common(const char __user *filename_user, const
 
 void ksu_execve_hook_ksud(const struct pt_regs *regs)
 {
-    const char __user *filename_user = (const char __user *)PT_REGS_PARM1(regs);
+    const char __user *filename_user = (const char __user *)PT_REGS_SYSCALL_PARM1(regs);
     const char __user *const __user *argv_user = (const char __user *const __user *)PT_REGS_PARM2(regs);
 
     ksu_execve_hook_ksud_common(filename_user, argv_user);
@@ -994,7 +994,7 @@ void ksu_execveat_hook_ksud(const struct pt_regs *regs)
 static long (*orig_sys_read)(const struct pt_regs *regs);
 static long ksu_sys_read(const struct pt_regs *regs)
 {
-    unsigned int fd = PT_REGS_PARM1(regs);
+    unsigned int fd = PT_REGS_SYSCALL_PARM1(regs);
     char __user **buf_ptr = (char __user **)&PT_REGS_PARM2(regs);
     size_t *count_ptr = (size_t *)&PT_REGS_PARM3(regs);
 
@@ -1005,7 +1005,7 @@ static long ksu_sys_read(const struct pt_regs *regs)
 static long (*orig_sys_fstat)(const struct pt_regs *regs);
 static long ksu_sys_fstat(const struct pt_regs *regs)
 {
-    unsigned int fd = PT_REGS_PARM1(regs);
+    unsigned int fd = PT_REGS_SYSCALL_PARM1(regs);
     void __user *statbuf = (void __user *)PT_REGS_PARM2(regs);
     bool is_rc = false;
     long ret;
diff --git a/kernel/supercall/supercall.c b/kernel/supercall/supercall.c
index 7fde216a..ca43b5a3 100644
--- a/kernel/supercall/supercall.c
+++ b/kernel/supercall/supercall.c
@@ -164,7 +164,7 @@ int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd, void __user
 static int reboot_handler_pre(struct kprobe *p, struct pt_regs *regs)
 {
     struct pt_regs *real_regs = PT_REAL_REGS(regs);
-    int magic1 = (int)PT_REGS_PARM1(real_regs);
+    int magic1 = (int)PT_REGS_SYSCALL_PARM1(real_regs);
     int magic2 = (int)PT_REGS_PARM2(real_regs);
     int cmd = (int)PT_REGS_PARM3(real_regs);
     void __user **arg = (void __user **)&PT_REGS_SYSCALL_PARM4(real_regs);
