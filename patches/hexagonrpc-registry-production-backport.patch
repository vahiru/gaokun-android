--- /dev/null
+++ b/hexagonrpcd/hexagonfs_registry.c
@@ -0,0 +1,260 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Opt-in registry output backend. No generic mapped path gains write rights.
+ * Exact QRD/449 groups and historically observed temp.json are permitted.
+ * Rename/removal protocols remain unsupported; no generated payload is seeded.
+ */
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include "hexagonfs.h"
+#include "registry_names.h"
+
+#define REGISTRY_MAX_BYTES (256 * 1024)
+#define REGISTRY_TOTAL_BYTES (2 * 1024 * 1024)
+#define REGISTRY_MAX_FILES (REGISTRY_NAME_COUNT + 1)
+struct registry_ctx { int fd, parent, root; unsigned depth; bool writing, reading; DIR *dir; };
+
+static bool group_name(const char *s) {
+    for(size_t i=0;i<REGISTRY_NAME_COUNT;++i)if(!strcmp(s,registry_names[i]))return true;
+    return false;
+}
+static bool allowed(unsigned depth,const char *s) {
+    return depth==0 ? !strcmp(s,"temp.json") : depth==1 && group_name(s);
+}
+static int check_file(int fd) {
+    struct stat s;
+    if (fstat(fd, &s)) return -errno;
+    if (!S_ISREG(s.st_mode) || s.st_nlink != 1 || s.st_uid != geteuid()) return -EPERM;
+    if (s.st_size < 0 || s.st_size > REGISTRY_MAX_BYTES) return -EFBIG;
+    return 0;
+}
+static int check_dir(int fd) {
+    struct stat s;
+    if (fstat(fd, &s)) return -errno;
