+/* Canonicalize CR segments as in production; only the historically observed
+ * absolute temp spelling may contain '..'. All other write traversal is denied. */
+static int normalize_write_path(const char *name,char **out) {
+    if(!name || !*name || strlen(name)>1024)return -EINVAL;
+    char *copy=strdup(name);if(!copy)return -ENOMEM;
+    char *src=copy,*dst=copy;
+    while(*src){
+        if(*src=='/'){*dst++=*src++;continue;}
+        char *end=strchr(src,'/');if(!end)end=src+strlen(src);
+        char *last=end;if(last>src && last[-1]=='\r')--last;
+        if(last==src){free(copy);return -EINVAL;}
+        for(char *p=src;p<last;++p)if((unsigned char)*p<32){free(copy);return -EINVAL;}
+        memmove(dst,src,(size_t)(last-src));dst+=last-src;src=end;
+    }
+    *dst=0;
+    const char *legacy[]={"/persist/sensors/registry/registry/../temp.json",
+        "/mnt/vendor/persist/sensors/registry/registry/../temp.json"};
+    const char *target[]={"/persist/sensors/registry/temp.json",
+        "/mnt/vendor/persist/sensors/registry/temp.json"};
+    for(unsigned i=0;i<2;++i)if(!strcmp(copy,legacy[i])){strcpy(copy,target[i]);break;}
+    *out=copy;return 0;
+}
+static int resolve_parent(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+			  const char *name, const char **base, bool *owned)
+{
+	const char *slash = strrchr(name, '/');
+	char *dir;
+	int fileno;
+
+	*owned = false;
+    if (!name || !*name || rootfd < 0 || rootfd >= HEXAGONFS_MAX_FD ||
+        dirfd < 0 || dirfd >= HEXAGONFS_MAX_FD || !fds[rootfd] || !fds[dirfd])
+        return -EINVAL;
+    /* Mutations reject dot traversal before directory resolution. */
+    const char *part = name;
+    while (*part) {
+        while (*part == '/') ++part;
+        const char *end = strchr(part, '/');
+        size_t len = end ? (size_t)(end-part) : strlen(part);
+        if (len && part[len-1] == '\r') --len;
+        if ((len==1 && part[0]=='.') || (len==2 && part[0]=='.' && part[1]=='.'))
+            return -EPERM;
+        if (!end) break;
+        part=end+1;
+    }
+
+
+	if (slash == NULL) {
+		*base = name;
+		return dirfd;
+	}
+
+	*base = slash + 1;
+
+	if (slash == name)
+		return rootfd;
+
+	dir = strndup(name, slash - name);
+	if (dir == NULL)
+		return -ENOMEM;
+
+	fileno = hexagonfs_openat(fds, rootfd, dirfd, dir);
+	free(dir);
+	if (fileno < 0)
+		return fileno;
+
+	*owned = true;
+
+	return fileno;
+}
+static int create_normalized(struct hexagonfs_fd **fds, int rootfd, int dirfd, const char *name, int flags)
+{
+	struct hexagonfs_fd *dir, *fd;
+	const char *base;
+	bool owned;
+	int parent, ret;
+
+	parent = resolve_parent(fds, rootfd, dirfd, name, &base, &owned);
+	if (parent < 0)
+		return parent;
+
+	dir = fds[parent];
+	if (dir == NULL) {
+		ret = -EBADF;
+		goto out;
+	}
+
+	if (*base == '\0') {
+		ret = -EISDIR;
+		goto out;
+	}
+
+	if (dir->ops->create == NULL) {
+		ret = -ENOSYS;
+		goto out;
+	}
+
+	ret = dir->ops->create(dir, base, flags, &fd);
+	if (ret)
+		goto out;
+
+	/* The file stands on its own: its directory may be closed before it. */
+	fd->up = NULL;
+
+	ret = allocate_file_number(fds, fd);
+	if (ret < 0)
+		destroy_file_descriptor(fd);
+
+out:
+	if (owned)
+		hexagonfs_close(fds, parent);
+
+	return ret;
+}
+
+int hexagonfs_create(struct hexagonfs_fd **fds,int rootfd,int dirfd,const char *name,int flags) {
+    char *normalized=NULL;int ret=normalize_write_path(name,&normalized);
+    if(ret)return ret;
+    ret=create_normalized(fds,rootfd,dirfd,normalized,flags);
+    free(normalized);return ret;
+}
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size, const void *ptr)
+{
+	struct hexagonfs_fd *fd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+
+	if (fd->ops->write == NULL)
+		return -ENOSYS;
+
+	return fd->ops->write(fd, size, ptr);
+}
+int hexagonfs_ftruncate(struct hexagonfs_fd **fds, int fileno, off_t len)
+{
+	struct hexagonfs_fd *fd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+
+	if (fd->ops->truncate == NULL)
+		return -ENOSYS;
+
+	return fd->ops->truncate(fd, len);
+}
+int hexagonfs_sync(struct hexagonfs_fd **fds, int fileno)
+{
+    if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD || !fds[fileno]) return -EBADF;
+    struct hexagonfs_fd *fd=fds[fileno];
+    if (!fd->ops->sync) return -ENOSYS;
+    return fd->ops->sync(fd);
+}
+int hexagonfs_parse_mode(const char *mode, int *flags)
+{
+    if (!mode || !*mode) return -EINVAL;
+    char kind=*mode++;
+    if (kind!='r' && kind!='w' && kind!='a') return -EINVAL;
+    bool binary=false, plus=false;
+    for (; *mode; ++mode) {
+        if (*mode=='b' && !binary) binary=true;
+        else if (*mode=='+' && !plus) plus=true;
+        else return -EINVAL;
+    }
+    *flags=plus?O_RDWR:(kind=='r'?O_RDONLY:O_WRONLY);
+    if(kind=='w')*flags|=O_CREAT|O_TRUNC;
+    if(kind=='a')*flags|=O_CREAT|O_APPEND;
+    return 0;
+}
