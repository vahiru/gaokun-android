diff --git a/hexagonrpcd/hexagonfs_registry.c b/hexagonrpcd/hexagonfs_registry.c
new file mode 100644
index 0000000..4f690a3
--- /dev/null
+++ b/hexagonrpcd/hexagonfs_registry.c
@@ -0,0 +1,195 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Opt-in registry output backend. No generic mapped path gains write rights.
+ * Initial evidence permits only <output>/registry/registry. Unknown temporary
+ * names, rename, removal and directory creation are intentionally unsupported.
+ */
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include "hexagonfs.h"
+
+#define REGISTRY_MAX_BYTES (4 * 1024 * 1024)
+struct registry_ctx { int fd, parent; unsigned depth; bool writing, reading; DIR *dir; };
+
+static bool leaf(const char *s) {
+    return !strcmp(s, "registry") || !strcmp(s, "registry\r");
+}
+static int check_file(int fd) {
+    struct stat s;
+    if (fstat(fd, &s)) return -errno;
+    if (!S_ISREG(s.st_mode) || s.st_nlink != 1 || s.st_uid != geteuid()) return -EPERM;
+    if (s.st_size < 0 || s.st_size > REGISTRY_MAX_BYTES) return -EFBIG;
+    return 0;
+}
+static int check_dir(int fd) {
+    struct stat s;
+    if (fstat(fd, &s)) return -errno;
+    if (!S_ISDIR(s.st_mode) || s.st_uid != geteuid() || (s.st_mode & 077)) return -EPERM;
+    return 0;
+}
+/* Inspect without following links; only the single known child is allowed. */
+static int check_children(int fd, bool directory) {
+    int copy = openat(fd, ".", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    if (copy < 0) return -errno;
+    DIR *d = fdopendir(copy);
+    if (!d) { int e = errno; close(copy); return -e; }
+    int ret = 0; struct dirent *e;
+    errno = 0;
+    while ((e = readdir(d))) {
+        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
+        if (strcmp(e->d_name, "registry")) { ret = -EPERM; break; }
+        struct stat s;
+        if (fstatat(fd, e->d_name, &s, AT_SYMLINK_NOFOLLOW)) { ret = -errno; break; }
+        if (directory ? !S_ISDIR(s.st_mode) : !S_ISREG(s.st_mode)) { ret = -EPERM; break; }
+        if (!directory && (s.st_nlink != 1 || s.st_size > REGISTRY_MAX_BYTES)) { ret = -EPERM; break; }
+        errno = 0;
+    }
+    if (!ret && errno) ret = -errno;
+    closedir(d); return ret;
+}
+/* Trusted CLI path must be absolute; even its parent components cannot be links. */
+static int open_output_root(const char *path) {
+    if (!path || path[0] != '/' || !path[1]) return -EINVAL;
+    char *copy = strdup(path + 1); if (!copy) return -ENOMEM;
+    int fd = open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC), ret = 0;
+    if (fd < 0) { free(copy); return -errno; }
+    char *next = copy, *part;
+    while ((part = strsep(&next, "/"))) {
+        if (!*part || !strcmp(part, ".") || !strcmp(part, "..") || strchr(part, '\r')) { ret = -EINVAL; break; }
+        int n = openat(fd, part, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+        if (n < 0) { ret = -errno; break; }
+        close(fd); fd = n;
+    }
+    free(copy);
+    if (ret) { close(fd); return ret; }
+    return fd;
+}
+static void reg_close(void *data) {
+    struct registry_ctx *c = data;
+    if(c->dir)closedir(c->dir);
+    close(c->fd); if (c->parent >= 0) close(c->parent); free(c);
+}
+static int reg_root(const void *data, bool dir, void **out) {
+    (void)dir;
+    int fd = open_output_root(data); if (fd < 0) return fd;
+    int ret = check_dir(fd);
+    if (!ret) ret = check_children(fd, true);
+    int child = -1;
+    if (!ret) { child = openat(fd,"registry",O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW); if (child < 0) ret = -errno; }
+    if (!ret) ret = check_dir(child);
+    if (!ret) ret = check_children(child, false);
+    if (child >= 0) close(child);
+    if (ret) { close(fd); return ret; }
+    struct registry_ctx *c = calloc(1,sizeof(*c));
+    if (!c) { close(fd); return -ENOMEM; }
+    c->fd=fd; c->parent=-1; c->reading=true; *out=c; return 0;
+}
+static int finish_open(struct hexagonfs_fd *dir, int fd, unsigned depth,
+                       bool writing, bool reading, struct hexagonfs_fd **out) {
+    struct registry_ctx *p = dir->data;
+    struct registry_ctx *c = calloc(1,sizeof(*c));
+    struct hexagonfs_fd *f = calloc(1,sizeof(*f));
+    if (!c || !f) { free(c); free(f); close(fd); return -ENOMEM; }
+    int parent = dup(p->fd);
+    if (parent < 0) { int e=errno; free(c); free(f); close(fd); return -e; }
+    c->fd=fd; c->parent=parent; c->depth=depth; c->writing=writing; c->reading=reading;
+    f->data=c; f->up=dir; f->ops=&hexagonfs_registry_ops; *out=f; return 0;
+}
+static int reg_open(struct hexagonfs_fd *dir,const char *name,bool expect_dir,struct hexagonfs_fd **out) {
+    struct registry_ctx *c=dir->data;
+    if (!leaf(name) || c->depth>1 || (expect_dir && c->depth!=0)) return -EPERM;
+    int flags=O_RDONLY|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK;
+    if (!c->depth) flags|=O_DIRECTORY;
+    int fd=openat(c->fd,"registry",flags); if(fd<0)return -errno;
+    int ret=c->depth?check_file(fd):check_dir(fd);
+    if(ret){close(fd);return ret;}
+    return finish_open(dir,fd,c->depth+1,false,true,out);
+}
+static int reg_create(struct hexagonfs_fd *dir,const char *name,int flags,struct hexagonfs_fd **out) {
+    struct registry_ctx *c=dir->data;
+    int access=flags&O_ACCMODE;
+    if (!leaf(name) || c->depth!=1 || (access!=O_WRONLY && access!=O_RDWR) ||
+        (flags & ~(O_ACCMODE|O_CREAT|O_TRUNC|O_APPEND))) return -EPERM;
+    int ret=check_children(c->fd,false); if(ret)return ret;
+    /* No truncation before verifying file type/link count/owner and lock. */
+    int fd=openat(c->fd,"registry",access|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK|(flags&(O_CREAT|O_APPEND)),0600);
+    if(fd<0)return -errno;
+    ret=check_file(fd);
+    if(!ret && flock(fd,LOCK_EX|LOCK_NB))ret=-errno;
+    if(!ret && (flags&O_TRUNC) && ftruncate(fd,0))ret=-errno;
+    if(ret){close(fd);return ret;}
+    return finish_open(dir,fd,2,true,access==O_RDWR,out);
+}
+static ssize_t reg_read(struct hexagonfs_fd *fd,size_t n,void *buf) {
+    struct registry_ctx *c=fd->data;
+    if(!c->reading || c->depth!=2)return -EBADF;
+    ssize_t ret; do{ret=read(c->fd,buf,n);}while(ret<0 && errno==EINTR);
+    return ret<0?-errno:ret;
+}
+static ssize_t reg_write(struct hexagonfs_fd *fd,size_t n,const void *buf) {
+    struct registry_ctx *c=fd->data;
+    if(!c->writing || c->depth!=2)return -EBADF;
+    int ret=check_file(c->fd); if(ret)return ret;
+    int flags=fcntl(c->fd,F_GETFL); if(flags<0)return -errno;
+    off_t pos=lseek(c->fd,0,(flags&O_APPEND)?SEEK_END:SEEK_CUR); if(pos<0)return -errno;
+    if(pos>REGISTRY_MAX_BYTES || n>(size_t)(REGISTRY_MAX_BYTES-pos))return -EFBIG;
+    size_t done=0;
+    while(done<n){ssize_t k=write(c->fd,(const char*)buf+done,n-done);
+        if(k<0){if(errno==EINTR)continue;return -errno;} if(!k)return -EIO;done+=(size_t)k;}
+    return (ssize_t)done;
+}
+static int reg_truncate(struct hexagonfs_fd *fd,off_t size) {
+    struct registry_ctx *c=fd->data;
+    if(!c->writing || c->depth!=2)return -EBADF;
+    if(size<0 || size>REGISTRY_MAX_BYTES)return -EFBIG;
+    int ret=check_file(c->fd);if(ret)return ret;
+    return ftruncate(c->fd,size)?-errno:0;
+}
+static int reg_sync(struct hexagonfs_fd *fd) {
+    struct registry_ctx *c=fd->data;
+    /* A read-only handle can reference an inode modified through another FD. */
+    if(fsync(c->fd))return -errno;
+    return c->parent >= 0 && fsync(c->parent) ? -errno : 0;
+}
+static int reg_readdir(struct hexagonfs_fd *fd,size_t size,char *out) {
+    struct registry_ctx *c=fd->data;
+    if(!size)return -EINVAL;
+    if(c->depth>1)return -ENOTDIR;
+    if(!c->dir){int copy=openat(c->fd,".",O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW);
+        if(copy<0)return -errno;
+        c->dir=fdopendir(copy);if(!c->dir){int e=errno;close(copy);return -e;}}
+    struct dirent *e;
+    errno=0;
+    while((e=readdir(c->dir))){
+        if(!strcmp(e->d_name,".") || !strcmp(e->d_name,".."))continue;
+        if(strcmp(e->d_name,"registry"))return -EPERM;
+        if(size<sizeof("registry"))return -ENAMETOOLONG;
+        memcpy(out,"registry",sizeof("registry"));return 0;
+    }
+    out[0]=0;return -errno;
+}
+static int reg_stat(struct hexagonfs_fd *fd,struct stat *out) {
+    struct registry_ctx *c=fd->data;return fstat(c->fd,out)?-errno:0;
+}
+static int reg_seek(struct hexagonfs_fd *fd,off_t off,int whence) {
+    struct registry_ctx *c=fd->data;struct stat s;off_t base=0;
+    if(c->depth!=2)return -EISDIR;
+    if(whence==SEEK_CUR){base=lseek(c->fd,0,SEEK_CUR);if(base<0)return -errno;}
+    else if(whence==SEEK_END){if(fstat(c->fd,&s))return -errno;base=s.st_size;}
+    else if(whence!=SEEK_SET)return -EINVAL;
+    if(off < -base || off > REGISTRY_MAX_BYTES-base)return -EFBIG;
+    return lseek(c->fd,base+off,SEEK_SET)<0?-errno:0;
+}
+struct hexagonfs_file_ops hexagonfs_registry_ops={
+    .close=reg_close,.from_dirent=reg_root,.openat=reg_open,.create=reg_create,
+    .read=reg_read,.write=reg_write,.truncate=reg_truncate,.sync=reg_sync,
+    .stat=reg_stat,.seek=reg_seek,.readdir=reg_readdir,
+    /* No rename or unlink until the real registry protocol is known. */
+};
