+def _gaokun_ver_tuple(text):
+    parts = []
+    for chunk in str(text).strip().split('.'):
+        digits = ''
+        for ch in chunk:
+            if ch.isdigit():
+                digits += ch
+            else:
+                break
+        parts.append(int(digits) if digits else 0)
+    return tuple(parts)
+
+
+class MesonStr(str):
+    """带 meson 语言方法的字符串（gaokun 补丁）。"""
+
+    def version_compare(self, spec):
+        spec = str(spec).strip()
+        for op in ('>=', '<=', '==', '!=', '>', '<'):
+            if spec.startswith(op):
+                rhs = spec[len(op):].strip()
+                break
+        else:
+            op, rhs = '==', spec
+        a = _gaokun_ver_tuple(self)
+        b = _gaokun_ver_tuple(rhs)
+        width = max(len(a), len(b))
+        a = a + (0,) * (width - len(a))
+        b = b + (0,) * (width - len(b))
+        if op == '>=':
+            return a >= b
+        if op == '<=':
+            return a <= b
+        if op == '==':
+            return a == b
+        if op == '!=':
+            return a != b
+        if op == '>':
+            return a > b
+        return a < b
+
+    def split(self, *args, **kwargs):
+        return [MesonStr(s) for s in str.split(self, *args, **kwargs)]
+
+    def strip(self, *args, **kwargs):
+        return MesonStr(str.strip(self, *args, **kwargs))
+
