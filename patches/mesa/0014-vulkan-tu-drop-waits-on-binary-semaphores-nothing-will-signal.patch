@@ -245,6 +245,9 @@ vk_queue_submit_add_semaphore_wait(struct vk_queue *queue,
 {
    VK_FROM_HANDLE(vk_semaphore, semaphore, wait_info->semaphore);
 
+   if (vk_semaphore_drop_unsignaled_wait(queue->base.device, semaphore))
+      return;
+
    /* From the Vulkan 1.2.194 spec:
     *
     *    "Applications can import a semaphore payload into an existing
@@ -275,6 +278,7 @@ vk_queue_submit_add_semaphore_wait(struct vk_queue *queue,
          submit->_has_binary_permanent_semaphore_wait = true;
       }
 
+      vk_semaphore_note_wait(semaphore);
       sync = &semaphore->permanent;
    }
 
@@ -299,6 +303,7 @@ vk_queue_submit_add_semaphore_signal(struct vk_queue *queue,
 
    struct vk_sync *sync = vk_semaphore_get_active_sync(semaphore);
    uint64_t signal_value = signal_info->value;
+   vk_semaphore_note_signal(semaphore);
    if (semaphore->type == VK_SEMAPHORE_TYPE_TIMELINE) {
       if (signal_value == 0) {
          return vk_queue_set_lost(queue,
diff --git a/src/vulkan/runtime/vk_semaphore.c b/src/vulkan/runtime/vk_semaphore.c
index 534eaa7..341991d 100644
--- a/src/vulkan/runtime/vk_semaphore.c
+++ b/src/vulkan/runtime/vk_semaphore.c
@@ -38,6 +38,9 @@
 #include "vk_physical_device.h"
 #include "vk_util.h"
 
+#include "util/log.h"
+#include "util/u_atomic.h"
+
 static VkExternalSemaphoreHandleTypeFlags
 vk_sync_semaphore_import_types(const struct vk_sync_type *type,
                                VkSemaphoreType semaphore_type)
@@ -229,6 +232,34 @@ vk_semaphore_reset_temporary(struct vk_device *device,
    semaphore->temporary = NULL;
 }
 
+bool
+vk_semaphore_wait_is_unsignaled(const struct vk_device *device,
+                                const struct vk_semaphore *semaphore)
+{
+   return device->drop_unsignaled_binary_waits &&
+          semaphore->type == VK_SEMAPHORE_TYPE_BINARY &&
+          semaphore->temporary == NULL &&
+          !semaphore->binary_untracked &&
+          p_atomic_read(&semaphore->binary_signals_pending) == 0;
+}
+
+bool
+vk_semaphore_drop_unsignaled_wait(struct vk_device *device,
+                                  struct vk_semaphore *semaphore)
+{
+   if (!vk_semaphore_wait_is_unsignaled(device, semaphore))
+      return false;
+
+   static bool warned;
+   if (!p_atomic_xchg(&warned, true)) {
+      mesa_logw("Dropping waits on binary semaphores without a submitted "
+                "signal operation (VUID-vkQueueSubmit-pWaitSemaphores-03238), "
+                "first one: %p", (void *)semaphore);
+   }
+
+   return true;
+}
+
 VKAPI_ATTR void VKAPI_CALL
 vk_common_DestroySemaphore(VkDevice _device,
                            VkSemaphore _semaphore,
@@ -490,6 +521,8 @@ vk_common_ImportSemaphoreWin32HandleKHR(VkDevice _device,
    if (temporary) {
       vk_semaphore_reset_temporary(device, semaphore);
       semaphore->temporary = temporary;
+   } else {
+      semaphore->binary_untracked = true;
    }
 
    return VK_SUCCESS;
@@ -514,6 +547,8 @@ vk_common_GetSemaphoreWin32HandleKHR(VkDevice _device,
       result = vk_sync_export_win32_handle(device, sync, pHandle);
       if (result != VK_SUCCESS)
          return result;
+      if (sync == &semaphore->permanent)
+         semaphore->binary_untracked = true;
       break;
 
    default:
@@ -620,6 +655,8 @@ vk_common_ImportSemaphoreFdKHR(VkDevice _device,
    if (temporary) {
       vk_semaphore_reset_temporary(device, semaphore);
       semaphore->temporary = temporary;
+   } else {
+      semaphore->binary_untracked = true;
    }
 
    return VK_SUCCESS;
@@ -643,6 +680,8 @@ vk_common_GetSemaphoreFdKHR(VkDevice _device,
       result = vk_sync_export_opaque_fd(device, sync, pFd);
       if (result != VK_SUCCESS)
          return result;
+      if (sync == &semaphore->permanent)
+         semaphore->binary_untracked = true;
       break;
 
    case VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT:
@@ -701,6 +740,7 @@ vk_common_GetSemaphoreFdKHR(VkDevice _device,
          result = vk_sync_reset(device, sync);
          if (unlikely(result != VK_SUCCESS))
             return result;
+         vk_semaphore_note_wait(semaphore);
       }
       break;
 
diff --git a/src/vulkan/runtime/vk_semaphore.h b/src/vulkan/runtime/vk_semaphore.h
index 141f39a..6ce12b1 100644
--- a/src/vulkan/runtime/vk_semaphore.h
+++ b/src/vulkan/runtime/vk_semaphore.h
@@ -26,6 +26,8 @@
 #include "vk_object.h"
 #include "vk_sync.h"
 
+#include "util/u_atomic.h"
+
 #ifdef __cplusplus
 extern "C" {
 #endif
@@ -49,6 +51,22 @@ struct vk_semaphore {
     */
    struct vk_sync *temporary;
 
+   /** Binary semaphores only: number of signal operations on the permanent
+    * payload that have been submitted and not yet consumed by a wait or a
+    * SYNC_FD export.  More than one can be outstanding when a later signal
+    * waits on a timeline that the consuming wait's batch signals.  Updated
+    * atomically: such a signal and wait can come from different threads
+    * without any host ordering between them.  Only meaningful while
+    * binary_untracked is false.  See vk_device::drop_unsignaled_binary_waits.
+    */
+   uint32_t binary_signals_pending;
+
+   /** Binary semaphores only: the permanent payload has been imported or
+    * exported as a shareable handle, so other semaphores or processes can
+    * signal it and binary_signals_pending says nothing.
+    */
+   bool binary_untracked;
+
    /** Permanent semaphore state.
     *
     * Every semaphore has some form of permanent state.
@@ -70,6 +88,49 @@ vk_semaphore_get_active_sync(struct vk_semaphore *semaphore)
    return semaphore->temporary ? semaphore->temporary : &semaphore->permanent;
 }
 
+/* Whether a wait on this semaphore has no signal operation to pair with and
+ * vk_device::drop_unsignaled_binary_waits asks for it to be dropped.  Call it
+ * before the wait consumes the temporary payload.
+ */
+bool vk_semaphore_wait_is_unsignaled(const struct vk_device *device,
+                                     const struct vk_semaphore *semaphore);
+
+/* vk_semaphore_wait_is_unsignaled(), and warn once per process when it is
+ * true.  A queue wait for which this returns true is dropped.
+ */
+bool vk_semaphore_drop_unsignaled_wait(struct vk_device *device,
+                                       struct vk_semaphore *semaphore);
+
+/* Record a queue wait on, or a signal of, the active payload of a binary
+ * semaphore.  Only waits on and signals of the permanent payload are
+ * counted.
+ */
+static inline void
+vk_semaphore_note_wait(struct vk_semaphore *semaphore)
+{
+   if (semaphore->type != VK_SEMAPHORE_TYPE_BINARY ||
+       semaphore->temporary != NULL)
+      return;
+
+   /* Saturating decrement */
+   uint32_t n = p_atomic_read(&semaphore->binary_signals_pending);
+   while (n > 0) {
+      uint32_t prev = p_atomic_cmpxchg(&semaphore->binary_signals_pending,
+                                       n, n - 1);
+      if (prev == n)
+         break;
+      n = prev;
+   }
+}
+
+static inline void
+vk_semaphore_note_signal(struct vk_semaphore *semaphore)
+{
+   if (semaphore->type == VK_SEMAPHORE_TYPE_BINARY &&
+       semaphore->temporary == NULL)
+      p_atomic_inc(&semaphore->binary_signals_pending);
+}
+
 #ifdef __cplusplus
 }
 #endif
