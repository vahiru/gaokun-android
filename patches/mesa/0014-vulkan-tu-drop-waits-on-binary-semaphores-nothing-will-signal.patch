diff --git a/src/vulkan/runtime/vk_android.c b/src/vulkan/runtime/vk_android.c
index 505ada0..a0b9485 100644
--- a/src/vulkan/runtime/vk_android.c
+++ b/src/vulkan/runtime/vk_android.c
@@ -32,6 +32,7 @@
 #include "vk_log.h"
 #include "vk_physical_device.h"
 #include "vk_queue.h"
+#include "vk_semaphore.h"
 #include "vk_util.h"
 
 #include "c11/threads.h"
@@ -429,7 +430,17 @@ vk_common_QueueSignalReleaseImageANDROID(VkQueue _queue,
       /* see wsi_common_queue_present for the rationale */
