-   if (device->copy_sync_payloads != NULL) {
+   /* A wait that drop_unsignaled_binary_waits drops must not let the CPU-side
+    * payload copy signal the release fence right away: submit to the queue
+    * instead, so the fence still comes after the work queued before it.
+    */
+   bool drops_wait = false;
+   for (uint32_t i = 0; i < waitSemaphoreCount; i++) {
+      VK_FROM_HANDLE(vk_semaphore, semaphore, pWaitSemaphores[i]);
+      drops_wait |= vk_semaphore_wait_is_unsignaled(device, semaphore);
+   }
+
+   if (device->copy_sync_payloads != NULL && !drops_wait) {
       result = vk_device_copy_semaphore_payloads(
          device, waitSemaphoreCount, wait_infos, 1, &signal_info, 0, NULL);
    } else {
diff --git a/src/vulkan/runtime/vk_device.c b/src/vulkan/runtime/vk_device.c
index a2ffe73..d5253de 100644
--- a/src/vulkan/runtime/vk_device.c
+++ b/src/vulkan/runtime/vk_device.c
@@ -766,6 +766,19 @@ vk_device_copy_semaphore_payloads(struct vk_device *device,
          goto fail;
    }
 
+   /* Count the waits on and signals of permanent payloads, see
+    * vk_device::drop_unsignaled_binary_waits.  Before the temporary payloads
+    * are reset, so that a wait on a temporary one is not counted.
+    */
+   for (uint32_t i = 0; i < wait_semaphore_count; i++) {
+      VK_FROM_HANDLE(vk_semaphore, semaphore, wait_semaphores[i].semaphore);
+      vk_semaphore_note_wait(semaphore);
+   }
+   for (uint32_t i = 0; i < signal_semaphore_count; i++) {
+      VK_FROM_HANDLE(vk_semaphore, semaphore, signal_semaphores[i].semaphore);
+      vk_semaphore_note_signal(semaphore);
+   }
+
    /* Reset any temporary semaphores we waited on */
    for (uint32_t i = 0; i < wait_semaphore_count; i++) {
       VK_FROM_HANDLE(vk_semaphore, semaphore, wait_semaphores[i].semaphore);
diff --git a/src/vulkan/runtime/vk_device.h b/src/vulkan/runtime/vk_device.h
index cebff12..9ba758b 100644
--- a/src/vulkan/runtime/vk_device.h
+++ b/src/vulkan/runtime/vk_device.h
@@ -316,6 +316,23 @@ struct vk_device {
    /* Link-time optimization disable */
    bool disable_lto;
 
+   /** Drop queue waits on binary semaphores nothing will ever signal
+    *
+    * Waiting on a binary semaphore requires a signal operation on it to have
+    * been submitted already (VUID-vkQueueSubmit-pWaitSemaphores-03238).  Some
+    * applications wait twice on the semaphore they passed to one
+    * vkAcquireNextImageKHR.  The first wait consumes the acquire payload and
+    * the second one waits on the unsignaled permanent payload, which blocks
+    * forever with threaded submit and is rejected by the kernel otherwise.
+    * When this is set, a queue wait on a binary semaphore whose permanent
+    * payload has no submitted signal left that an earlier wait has not
+    * consumed is dropped instead.  Only semaphores whose payload never left
+    * the VkSemaphore are tracked, see vk_semaphore::binary_signals_pending.
+    * Like the temporary payloads, which a failed submit already consumes,
+    * the counts are not rolled back when a submit fails.
+    */
+   bool drop_unsignaled_binary_waits;
+
    struct vk_device_memory_report *memory_reports;
    uint32_t memory_report_count;
 };
