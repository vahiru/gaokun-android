From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] Input: himax-spi: 手的位置图，误报成手指的手以MT_TOOL_PALM撤回

现有的掌压规则逐帧、逐个连通域判断（面积、信号总和、长宽比），只认得出掌根。
手的其余部分，比如弯着的手指、指节、平放时的手指，在网格上是一块块和指尖一样
大的孤岛；手掌落下和抬起时，掌根自己也有几帧小于palm_area_threshold。这些都
被当成手指上报，而且一律是MT_TOOL_FINGER，事后就算认出来也只能让它抬起，而
按下再抬起就是一次点击。笔在感应范围外时（抬笔换行、落笔之前），Android的笔
屏蔽也管不到它们。

这个补丁给算法加一张"手的位置图"（hand_age[]，每格记着几帧前还是手）：

- 手掌区域外扩hand_margin格写进图里，手离开后再保留hand_hold_frames帧。
- 落在图里的峰值在展开成触点之前丢掉，它所在的连通域也写进图，所以属于手的
  碎块会一直被认出来，直到抬起；手的碎块也不再占用触点槽。
- 屏上在一段空白之后出现手掌，算作"落下"。落下前后hand_land_frames帧内，
  hand_land_dist格以内的峰值、连通域和刚出生的跟踪都算同一只手：平放时手指
  往往比掌根早落下几十毫秒。
- 已经上报、后来才认出是手的跟踪，以MT_TOOL_PALM再报一帧，下一帧释放。
  Android收到后取消这个指针，只有一个指针时应用收到ACTION_CANCEL，不算点击。
  为此注册了ABS_MT_TOOL_TYPE轴，否则输入核心会丢掉这个事件。
- 按下已超过hand_land_frames的手指，只受"现在就在手里"这一条约束：按着手指
  时放下手掌、手指拖过手掌刚离开的地方，都不会被打断。
- 屏上没有手掌区域时这些规则都不生效，纯手指操作的行为不变。

为了按区域标记，连通域多了每帧的编号（zone_of[]记录每个像素属于哪一块），
峰值带上所在区域的编号。熄屏和芯片重新初始化时，位置图随跟踪器一起清空
（hx_hand_reset()）。

algo/下新增的参数（可运行时修改；超出上限的写入返回-EINVAL）：
  参数              默认  上限  含义
  hand_enabled      1     -     总开关
  hand_margin       2     8     手掌和手的碎块往外扩的格数（约9毫米）
  hand_hold_frames  36    120   手离开后继续记住的帧数（约300毫秒）
  hand_land_frames  12    60    "落下"前后的窗口（约100毫秒）
  hand_land_dist    25    60    落下时算作同一只手的范围（约11厘米）

上限定义在hx-algo.h：hand_age到255表示“不是手”，保留时间要远小于它，否则
整块屏都会被当成手；落下窗口要和同样封顶在255的跟踪年龄比较，道理相同；外扩
每一遍要为每格扫描2×hand_margin+1格，太大会拖慢中断线程。

algo/stats新增的计数器：hand_lands（落下次数）、hand_peaks（作为手丢掉的
峰值）、hand_cancel_map（落进位置图而撤回的跟踪）、hand_cancel_land（和手掌
一起落下而撤回的跟踪）。

issue #29。
---
diff --git a/drivers/input/touchscreen/himax-spi-core.c b/drivers/input/touchscreen/himax-spi-core.c
index 0089e9be5..78ef03921 100644
--- a/drivers/input/touchscreen/himax-spi-core.c
+++ b/drivers/input/touchscreen/himax-spi-core.c
@@ -686,6 +686,14 @@ static int himax_input_dev_config(struct himax_ts_data *ts)
 	 */
 	input_abs_set_res(ts->input_dev, ABS_MT_POSITION_X, HX_RES_UNITS_PER_MM);
 	input_abs_set_res(ts->input_dev, ABS_MT_POSITION_Y, HX_RES_UNITS_PER_MM);
+
+	/*
+	 * Contacts that turn out to be part of a hand are reported once as
+	 * MT_TOOL_PALM before they are released (hx_hand_filter()); without
+	 * the axis the input core would drop that event and the contact would
+	 * end in a plain lift, i.e. a tap.
+	 */
+	input_set_abs_params(ts->input_dev, ABS_MT_TOOL_TYPE, 0, MT_TOOL_MAX, 0, 0);
 	// TODO: 根据触点附近数据集建模得到
 	if (!disable_pressure) {
 		input_set_abs_params(ts->input_dev, ABS_MT_TOUCH_MAJOR, 0, 255, 0, 0);
@@ -717,6 +725,7 @@ static void himax_release_all_touches(struct himax_ts_data *ts)
 		ts->algo->touch_start_frames = 0;
 		ts->algo->touch_active = false;
 		ts->algo->iir_initialized = false;
+		hx_hand_reset(ts->algo);
 	}
 
 	if (ts->input_dev)
@@ -1010,6 +1019,30 @@ static ssize_t _name##_store(struct device *dev,			\
 }									\
 static DEVICE_ATTR_RW(_name)
 
+/* u8 tunable with an upper limit; larger values are rejected */
+#define HX_ALGO_ATTR_U8_MAX_RW(_name, _max)				\
+static ssize_t _name##_show(struct device *dev,				\
+			    struct device_attribute *attr, char *buf)	\
+{									\
+	struct himax_ts_data *ts = dev_get_drvdata(dev);		\
+	return sysfs_emit(buf, "%u\n", (unsigned int)ts->algo->_name);	\
+}									\
+static ssize_t _name##_store(struct device *dev,			\
+			     struct device_attribute *attr,		\
+			     const char *buf, size_t count)		\
+{									\
+	struct himax_ts_data *ts = dev_get_drvdata(dev);		\
+	u8 val;								\
+	int ret = kstrtou8(buf, 0, &val);				\
+	if (ret)							\
+		return ret;						\
+	if (val > (_max))						\
+		return -EINVAL;						\
+	ts->algo->_name = val;						\
+	return count;							\
+}									\
+static DEVICE_ATTR_RW(_name)
+
 #define HX_ALGO_ATTR_S32_RW(_name)					\
 static ssize_t _name##_show(struct device *dev,				\
 			    struct device_attribute *attr, char *buf)	\
@@ -1052,6 +1085,12 @@ HX_ALGO_ATTR_U16_RW(palm_contact_area);
 HX_ALGO_ATTR_U8_RW(palm_area_threshold);
 HX_ALGO_ATTR_S32_RW(palm_signal_threshold);
 HX_ALGO_ATTR_S16_RW(palm_density_low);
+/* Hand map */
+HX_ALGO_ATTR_BOOL_RW(hand_enabled);
+HX_ALGO_ATTR_U8_MAX_RW(hand_margin, HX_HAND_MARGIN_MAX);
+HX_ALGO_ATTR_U8_MAX_RW(hand_hold_frames, HX_HAND_HOLD_MAX);
+HX_ALGO_ATTR_U8_MAX_RW(hand_land_frames, HX_HAND_LAND_FRAMES_MAX);
+HX_ALGO_ATTR_U8_MAX_RW(hand_land_dist, HX_HAND_LAND_DIST_MAX);
 /* Pressure / touch-major reporting */
 HX_ALGO_ATTR_BOOL_RW(pressure_enabled);
 /* Edge compensation */
@@ -1102,6 +1141,10 @@ static ssize_t stats_show(struct device *dev, struct device_attribute *attr,
 	n += sysfs_emit_at(buf, n, "tracks_jump       %u\n", st->tracks_jump);
 	n += sysfs_emit_at(buf, n, "tracks_guard_kill %u\n", st->tracks_guard_kill);
 	n += sysfs_emit_at(buf, n, "tracks_lost       %u\n", st->tracks_lost);
+	n += sysfs_emit_at(buf, n, "hand_lands        %u\n", st->hand_lands);
+	n += sysfs_emit_at(buf, n, "hand_peaks        %u\n", st->hand_peaks);
+	n += sysfs_emit_at(buf, n, "hand_cancel_map   %u\n", st->hand_cancel_map);
+	n += sysfs_emit_at(buf, n, "hand_cancel_land  %u\n", st->hand_cancel_land);
 	n += sysfs_emit_at(buf, n, "max_contacts      %u\n", st->max_contacts);
 	return n;
 }
@@ -1162,6 +1205,11 @@ static struct attribute *hx_algo_attrs[] = {
 	&dev_attr_palm_area_threshold.attr,
 	&dev_attr_palm_signal_threshold.attr,
 	&dev_attr_palm_density_low.attr,
+	&dev_attr_hand_enabled.attr,
+	&dev_attr_hand_margin.attr,
+	&dev_attr_hand_hold_frames.attr,
+	&dev_attr_hand_land_frames.attr,
+	&dev_attr_hand_land_dist.attr,
 	&dev_attr_pressure_enabled.attr,
 	&dev_attr_edge_comp_enabled.attr,
 	&dev_attr_edge_boost_pct.attr,
@@ -1299,7 +1347,9 @@ static void himax_report_tracked_state(struct himax_ts_data *ts, bool report_on)
 			  ts->algo->tracks[i].debounce == 0;
 
 		input_mt_slot(ts->input_dev, i);
-		input_mt_report_slot_state(ts->input_dev, MT_TOOL_FINGER, on);
+		input_mt_report_slot_state(ts->input_dev,
+					   ts->algo->tracks[i].palm ?
+					   MT_TOOL_PALM : MT_TOOL_FINGER, on);
 		if (!on)
 			continue;
 
@@ -1362,7 +1412,9 @@ static irqreturn_t himax_ts_thread(int irq, void *data)
 
 	hx_detect_macro_zones(algo);
 	hx_reject_palms(algo);
+	hx_hand_update(algo);
 	hx_detect_peaks(algo);
+	hx_hand_filter(algo);
 	hx_expand_and_resolve(algo, pos, &cnt);
 	hx_track_contacts(algo, pos, cnt);
 	stable_cnt = hx_count_stable_tracks(algo);
diff --git a/drivers/input/touchscreen/hx-algo.c b/drivers/input/touchscreen/hx-algo.c
index 0d2b8dbb1..6de0bfe80 100644
--- a/drivers/input/touchscreen/hx-algo.c
+++ b/drivers/input/touchscreen/hx-algo.c
@@ -53,6 +53,12 @@ void hx_algo_init_defaults(struct hx_algo *algo)
 	algo->palm_area_threshold    = 50;
 	algo->palm_signal_threshold  = 80000;
 	algo->palm_density_low       = 400;
+	algo->hand_enabled       = true;
+	algo->hand_margin        = 2;   /* ~9 mm around a palm or hand blob  */
+	algo->hand_hold_frames   = 36;  /* ~300 ms at 120 Hz                 */
+	algo->hand_land_frames   = 12;  /* ~100 ms either side of a landing  */
+	algo->hand_land_dist     = 25;  /* ~11 cm: a flat hand's fingertips  */
+	hx_hand_reset(algo);
 	algo->pressure_enabled   = false;
 	algo->edge_comp_enabled = true;
 	algo->edge_boost_pct   = 50;   /* 50% signal boost on border pixels  */
@@ -342,8 +348,10 @@ void hx_detect_macro_zones(struct hx_algo *algo)
 	static const int dc[] = {-1,  0,  1, -1, 1, -1, 0, 1};
 	u16 head, tail;
 	int r, c, d;
+	u8 next_id = 0;
 
 	memset(algo->visited, 0, sizeof(algo->visited));
+	memset(algo->zone_of, 0, sizeof(algo->zone_of));
 	algo->zone_count = 0;
 
 	for (r = 0; r < HX_ROWS; r++) {
@@ -388,6 +396,11 @@ void hx_detect_macro_zones(struct hx_algo *algo)
 			zone->signal_sum = 0;
 			zone->is_palm    = false;
 			zone->palm_rule  = 0;
+			/*
+			 * Ids are unique within the frame, also across eviction;
+			 * past 255 zones the rest share id 0, i.e. "no zone".
+			 */
+			zone->id = next_id < U8_MAX ? ++next_id : 0;
 			zone->min_r = r;  zone->max_r = r;
 			zone->min_c = c;  zone->max_c = c;
 
@@ -406,6 +419,7 @@ void hx_detect_macro_zones(struct hx_algo *algo)
 				if (zone->area < HX_ZONE_PX_MAX)
 					zone->pixels[zone->area] = ci;
 				zone->area++;
+				algo->zone_of[ci] = zone->id;
 				if (sig > 0)
 					zone->signal_sum += sig;
 
@@ -524,6 +538,296 @@ void hx_reject_palms(struct hx_algo *algo)
 	}
 }
 
+/* ======================================================================== */
+/* Phase 2B½ / 2C½ — hand map                                               */
+/*                                                                           */
+/* The palm rules above only ever catch the heel of the hand.  The rest of  */
+/* a resting hand reaches the panel as fingertip-sized islands -- curled    */
+/* fingers, knuckles, the fingers of a flat hand -- that no per-zone rule   */
+/* can tell from a finger, and the palm itself passes through fingertip     */
+/* size while it lands and while it lifts.  Each of those became a short    */
+/* contact, and a press followed by a lift is a tap.                        */
+/*                                                                           */
+/* hand_age[] remembers where the hand has been: 0 = hand this frame,       */
+/* n = n frames ago, U8_MAX = not within the last 255 frames.  Palm zones   */
+/* are written into it every frame (hx_hand_update), together with the      */
+/* zone of every peak that falls inside it (hx_hand_filter), so a blob      */
+/* that belongs to the hand keeps itself marked for as long as it stays     */
+/* down and for hand_hold_frames after.  A palm appearing after a quiet     */
+/* spell is a landing; peaks and young tracks near it within                */
+/* hand_land_frames belong to the same hand.                                */
+/*                                                                           */
+/* Nothing changes until a palm zone shows up, so finger-only use takes     */
+/* none of these paths.                                                     */
+/* ======================================================================== */
+
+static void hx_reset_track(struct hx_track *trk);
+
+void hx_hand_reset(struct hx_algo *algo)
+{
+	memset(algo->hand_age, U8_MAX, sizeof(algo->hand_age));
+	algo->palm_seen = false;
+}
+
+/*
+ * Zones are collected in mark_id[] and marked in one pass over the grid,
+ * so a frame with many hand blobs costs no more than one with a few.
+ * Id 0 ("no zone") is never set.
+ */
+static inline void hx_want_zone(struct hx_algo *algo, u8 id)
+{
+	if (id)
+		algo->mark_id[id] = 1;
+}
+
+static void hx_mark_wanted(struct hx_algo *algo)
+{
+	int i;
+
+	for (i = 0; i < HX_PIXELS; i++)
+		if (algo->mark_id[algo->zone_of[i]])
+			algo->hand_mark[i] = 1;
+	memset(algo->mark_id, 0, sizeof(algo->mark_id));
+}
+
+/* Mark the square of hand_margin cells around (r, c). */
+static void hx_mark_around(struct hx_algo *algo, int r, int c)
+{
+	int m = algo->hand_margin, dr, dc;
+
+	for (dr = -m; dr <= m; dr++)
+		for (dc = -m; dc <= m; dc++) {
+			int nr = r + dr, nc = c + dc;
+
+			if (nr >= 0 && nr < HX_ROWS && nc >= 0 && nc < HX_COLS)
+				algo->hand_mark[nr * HX_COLS + nc] = 1;
+		}
+}
+
+/* Grow hand_mark[] by hand_margin cells (square), write it to hand_age[]. */
+static void hx_hand_commit(struct hx_algo *algo)
+{
+	int m = algo->hand_margin, r, c, k;
+
+	/* separable max filter: rows into hand_tmp, then columns back */
+	for (r = 0; r < HX_ROWS; r++)
+		for (c = 0; c < HX_COLS; c++) {
+			u8 v = 0;
+
+			for (k = max(c - m, 0); k <= min(c + m, HX_COLS - 1) && !v; k++)
+				v = algo->hand_mark[r * HX_COLS + k];
+			algo->hand_tmp[r * HX_COLS + c] = v;
+		}
+	for (r = 0; r < HX_ROWS; r++)
+		for (c = 0; c < HX_COLS; c++) {
+			u8 v = 0;
+
+			for (k = max(r - m, 0); k <= min(r + m, HX_ROWS - 1) && !v; k++)
+				v = algo->hand_tmp[k * HX_COLS + c];
+			if (v)
+				algo->hand_age[r * HX_COLS + c] = 0;
+		}
+}
+
+/* Within hand_land_dist cells (Chebyshev) of a palm zone's bounding box. */
+static bool hx_near_palm(const struct hx_algo *algo, int r, int c)
+{
+	int d = algo->hand_land_dist;
+	u8 i;
+
+	for (i = 0; i < algo->zone_count; i++) {
+		const struct hx_macro_zone *z = &algo->zones[i];
+
+		if (z->is_palm &&
+		    r >= z->min_r - d && r <= z->max_r + d &&
+		    c >= z->min_c - d && c <= z->max_c + d)
+			return true;
+	}
+	return false;
+}
+
+/* Grid cell under a track; inverse of the mapping in hx_expand_and_resolve(). */
+static void hx_track_cell(const struct hx_track *trk, int *r, int *c)
+{
+	*c = clamp_t(int, (trk->x * 6) >> 8, 0, HX_COLS - 1);
+	*r = clamp_t(int, ((trk->y * 32) / 5) >> 8, 0, HX_ROWS - 1);
+}
+
+/*
+ * A finger that has been down for longer than a landing lasts is left to
+ * the "inside the hand now" test alone.  Without this, resting a palm
+ * while holding a finger, or dragging a finger across the spot a palm
+ * just left, would drop that finger's peaks, and its track would end in
+ * a plain lift.
+ */
+static bool hx_established(const struct hx_algo *algo, const struct hx_track *trk)
+{
+	return trk->active && !trk->palm && !trk->debounce &&
+	       trk->age > algo->hand_land_frames;
+}
+
+static bool hx_near_established(const struct hx_algo *algo, int r, int c)
+{
+	int i;
+
+	for (i = 0; i < HIMAX_MAX_TOUCH; i++) {
+		const struct hx_track *trk = &algo->tracks[i];
+		int tr, tc;
+
+		if (!hx_established(algo, trk))
+			continue;
+		hx_track_cell(trk, &tr, &tc);
+		if (abs(tr - r) <= 2 && abs(tc - c) <= 2)
+			return true;
+	}
+	return false;
+}
+
+void hx_hand_update(struct hx_algo *algo)
+{
+	bool palm_now = false;
+	u8 i;
+	int k;
+
+	algo->frame_seq++;
+	for (k = 0; k < HX_PIXELS; k++)
+		if (algo->hand_age[k] < U8_MAX)
+			algo->hand_age[k]++;
+
+	if (!algo->hand_enabled)
+		return;
+
+	memset(algo->hand_mark, 0, sizeof(algo->hand_mark));
+	for (i = 0; i < algo->zone_count; i++) {
+		if (!algo->zones[i].is_palm)
+			continue;
+		palm_now = true;
+		hx_want_zone(algo, algo->zones[i].id);
+	}
+	if (!palm_now)
+		return;
+
+	if (!algo->palm_seen ||
+	    algo->frame_seq - algo->palm_seen_seq > algo->hand_hold_frames) {
+		algo->palm_land_seq = algo->frame_seq;
+		algo->stats.hand_lands++;
+	}
+	algo->palm_seen = true;
+	algo->palm_seen_seq = algo->frame_seq;
+
+	/*
+	 * While a palm lands, every blob in its reach is the same hand -- the
+	 * fingers of a flat hand come down with it, often before the heel is
+	 * large enough to count as a palm, and later flicker around the peak
+	 * threshold.  Marking them now, peak or not, lets the hand map follow
+	 * them from then on.  A zone holding an established finger is left
+	 * alone.
+	 */
+	if (algo->frame_seq - algo->palm_land_seq <= algo->hand_land_frames) {
+		for (i = 0; i < algo->zone_count; i++) {
+			const struct hx_macro_zone *z = &algo->zones[i];
+			bool keep = false;
+			int j;
+
+			if (z->is_palm ||
+			    !hx_near_palm(algo, (z->min_r + z->max_r) / 2,
+					  (z->min_c + z->max_c) / 2))
+				continue;
+			for (j = 0; j < HIMAX_MAX_TOUCH && !keep; j++) {
+				int tr, tc;
+
+				if (!hx_established(algo, &algo->tracks[j]))
+					continue;
+				hx_track_cell(&algo->tracks[j], &tr, &tc);
+				keep = algo->zone_of[tr * HX_COLS + tc] == z->id;
+			}
+			if (!keep)
+				hx_want_zone(algo, z->id);
+		}
+	}
+	hx_mark_wanted(algo);
+	hx_hand_commit(algo);
+}
+
+void hx_hand_filter(struct hx_algo *algo)
+{
+	bool landing;
+	u8 dst = 0, i;
+
+	if (!algo->hand_enabled)
+		return;
+
+	landing = algo->palm_seen &&
+		  algo->frame_seq - algo->palm_land_seq <= algo->hand_land_frames &&
+		  algo->frame_seq == algo->palm_seen_seq;
+
+	/*
+	 * Peaks: inside the hand now, or -- unless an established finger is
+	 * right there -- inside the remembered hand or near a landing palm.
+	 */
+	memset(algo->hand_mark, 0, sizeof(algo->hand_mark));
+	for (i = 0; i < algo->peak_count; i++) {
+		struct hx_peak *p = &algo->peaks[i];
+		int idx = p->r * HX_COLS + p->c;
+		bool hand;
+
+		if (algo->hand_age[idx] == 0)
+			hand = true;
+		else if (hx_near_established(algo, p->r, p->c))
+			hand = false;
+		else
+			hand = algo->hand_age[idx] <= algo->hand_hold_frames ||
+			       (landing && hx_near_palm(algo, p->r, p->c));
+		if (!hand) {
+			algo->peaks[dst++] = *p;
+			continue;
+		}
+		algo->stats.hand_peaks++;
+		hx_want_zone(algo, p->zone_id);
+	}
+	algo->peak_count = dst;
+	hx_mark_wanted(algo);
+	hx_hand_commit(algo);
+
+	/*
+	 * Tracks: one that now sits in the hand is the contact whose blob just
+	 * grew into a palm or merged with one; a young one near a landing palm
