From: Vahiru <nekovahiru@gmail.com>
Subject: [PATCH] Input: himax-spi: 把坐标 fuzz 做成可运行时改的模块参数（Android 上 8 太大）

**问题**：驱动给 `ABS_MT_POSITION_X/Y` 写死 `fuzz = 8`，注释写明理由是
"prevent libinput from treating 10px drifts as swipes" —— 那是**桌面 Linux** 的理由。
input 核心的 `input_defuzz_abs_event()`（v7.2-rc2 `drivers/input/input.c`）对 fuzz=8 的处理是：

    |Δ| < 4        → 直接返回旧值（**这一帧的移动被整个丢掉**）
    4 ≤ |Δ| < 8    → 只取 1/4（old*3 + new)/4
    8 ≤ |Δ| < 16   → 只取 1/2
    ≥ 16           → 原样通过

本机面板 1600×2560、像素间距约 0.1 mm，于是**慢速拖动时 0.4 mm 以内的位移全部消失、
1.6 mm 以内被衰减** —— 手感就是"跟不上手指、一格一格地走"。

而 Android 侧本来就有两层同样作用的东西：InputReader 的移动过滤，以及
`ViewConfiguration.getScaledTouchSlop()`（本机约 24 px）在**手势起点**上的判定。
再叠一层内核 fuzz 是重复过滤。驱动自己还带 IIR 平滑（`hx-algo.c`，`iir_enabled=1`
默认开），抖动本来就有人管。

**为什么做成可写的模块参数，而不是直接改成 0**：
本项目里**重启是最贵的资源**（失败要有人按电源键，见 CLAUDE.md 的操作纪律）。
`touchscreen-fuzz-x/y` 虽然是标准 DT 属性、改 DTB 就能生效（
`drivers/input/touchscreen.c:89` 实测会覆盖驱动默认值），但**每试一个值就要重启一次**。
做成 0644 的模块参数之后，一次重启换来无限次实时 A/B：

    echo 0 > /sys/module/himax_hx83121a_spi/parameters/fuzz

⚠️ 默认值仍是 **8**，即**本补丁单独打上不改变任何行为** —— 要的是那个旋钮，
不是替用户做决定。调到满意之后再把定案值写进 DT 的 `touchscreen-fuzz-x/y`。

⚠️ 静态指针 `himax_fuzz_ts`：本平台只有一个触摸控制器（`spi0.0`），probe 成功后记一份。
多实例平台上这个写法只会作用到最后一个 —— 这个驱动的 of_match 只有 `himax,hx83121a-ts`，
可以接受，但别照抄到别处。

案卷：`docs/stage4-findings.md` #113。
---
diff --git a/drivers/input/touchscreen/himax-spi-core.c b/drivers/input/touchscreen/himax-spi-core.c
--- a/drivers/input/touchscreen/himax-spi-core.c
+++ b/drivers/input/touchscreen/himax-spi-core.c
@@ -593,45 +593,90 @@
 /* -------------------------------------------------------------------------- */
 /* input 子系统 */
+
+/*
+ * Coordinate fuzz for ABS_MT_POSITION_X/Y.
+ *
+ * The historical hard-coded value was 8, picked so that libinput would not turn
+ * a resting finger's drift into a swipe.  input_defuzz_abs_event() discards any
+ * movement below fuzz/2 outright and damps everything below 2*fuzz, so on this
+ * 1600x2560 panel a fuzz of 8 eats every motion under ~0.4 mm and damps up to
+ * ~1.6 mm.  Android already applies its own touch slop on top of this, and this
+ * driver runs an IIR filter of its own (hx-algo.c), so the kernel-side value
+ * wants to be much smaller there.
+ *
+ * Writable at runtime (0644) so it can be A/B'd against a real finger without a
+ * reboot; the default is unchanged, so this alone is a no-op.  DT can still
+ * override it via touchscreen-fuzz-x/y, which touchscreen_parse_properties()
+ * applies after the input_set_abs_params() calls below.
+ */
+static unsigned int himax_fuzz = 8;
+static struct himax_ts_data *himax_fuzz_ts;
+
+static int himax_fuzz_set(const char *val, const struct kernel_param *kp)
+{
+	struct himax_ts_data *ts = READ_ONCE(himax_fuzz_ts);
+	int ret;
+
+	ret = param_set_uint(val, kp);
+	if (ret)
+		return ret;
+
+	if (ts && ts->input_dev) {
+		input_abs_set_fuzz(ts->input_dev, ABS_MT_POSITION_X, himax_fuzz);
+		input_abs_set_fuzz(ts->input_dev, ABS_MT_POSITION_Y, himax_fuzz);
+	}
+
+	return 0;
+}
+
+static const struct kernel_param_ops himax_fuzz_ops = {
+	.set = himax_fuzz_set,
+	.get = param_get_uint,
+};
+module_param_cb(fuzz, &himax_fuzz_ops, &himax_fuzz, 0644);
+MODULE_PARM_DESC(fuzz, "ABS_MT_POSITION_X/Y fuzz, writable at runtime (default: 8)");
+
 static int himax_input_dev_config(struct himax_ts_data *ts)
 {
 	struct input_dev *input_dev;
 	int ret;
 
 	input_dev = devm_input_allocate_device(ts->dev);
 	if (!input_dev)
 		return -ENOMEM;
 
 	ts->input_dev = input_dev;
 	input_set_drvdata(input_dev, ts);
 
 	input_dev->name = "Himax Capacitive TouchScreen";
 	input_dev->phys = "input/ts";
 	input_dev->id.bustype = BUS_SPI;
 
-	/* Standard capacitive touchscreen fuzz (8) to absorb static finger deformation
-	 * during clicks, preventing libinput from treating 10px drifts as swipes. */
+	/* See the himax_fuzz comment above for why this is a knob and not an 8. */
 	input_set_abs_params(ts->input_dev, ABS_MT_POSITION_X,
-			     0, SZ_64K - 1, 8, 0);
+			     0, SZ_64K - 1, himax_fuzz, 0);
 	input_set_abs_params(ts->input_dev, ABS_MT_POSITION_Y,
-			     0, SZ_64K - 1, 8, 0);
+			     0, SZ_64K - 1, himax_fuzz, 0);
 	// TODO: 根据触点附近数据集建模得到
 	if (!disable_pressure) {
 		input_set_abs_params(ts->input_dev, ABS_MT_TOUCH_MAJOR, 0, 255, 0, 0);
 		input_set_abs_params(ts->input_dev, ABS_MT_PRESSURE, 0, 4095, 0, 0);
 		dev_info(ts->dev, "pressure/touch_major axes enabled\n");
 	} else {
 		dev_info(ts->dev, "pressure/touch_major axes disabled by module parameter\n");
 	}
 	touchscreen_parse_properties(ts->input_dev, true, &ts->props);
 
 	ret = input_mt_init_slots(ts->input_dev, HIMAX_MAX_TOUCH,
 				  INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
 	if (ret)
 		return ret;
 
 	ret = input_register_device(ts->input_dev);
 	if (ret)
 		return ret;
 
+	WRITE_ONCE(himax_fuzz_ts, ts);
+
 	return 0;
 }
