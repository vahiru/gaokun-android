From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] Input: himax-spi: 固件看不到手指时提前结束触摸

track_lost_frames让没匹配上的跟踪再留3帧，用来接上手指下短暂消失的触点，代价是
每次抬手的UP都晚这3帧。固件的手指标志（0121）说屏幕上没有手指时，这段等待没有
意义。

新增track_fw_lost_frames，这样的帧里用它代替track_lost_frames，默认1。留1帧是因为
标志看的是固件坐标的低字节是否同为0xff，真实坐标可能撞上；单帧误报不应该切断按住
的手指。

标志覆盖整块屏幕：还有别的手指按着时，抬手照旧等track_lost_frames。只有
baseline_fw_finger打开、走自适应基线时才生效，这正是标志把整帧清零的条件。设成不
小于track_lost_frames的值就是原来的行为。
---
 drivers/input/touchscreen/himax-spi-core.c |  2 ++
 drivers/input/touchscreen/hx-algo.c        | 14 +++++++++++++-
 drivers/input/touchscreen/hx-algo.h        |  2 ++
 3 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/drivers/input/touchscreen/himax-spi-core.c b/drivers/input/touchscreen/himax-spi-core.c
index 9d9e118..975c00a 100644
--- a/drivers/input/touchscreen/himax-spi-core.c
+++ b/drivers/input/touchscreen/himax-spi-core.c
@@ -1125,6 +1125,7 @@ HX_ALGO_ATTR_S32_RW(track_filter_mincutoff);
 HX_ALGO_ATTR_S32_RW(track_filter_beta);
 HX_ALGO_ATTR_S32_RW(track_filter_dcutoff);
 HX_ALGO_ATTR_U8_RW(track_lost_frames);
+HX_ALGO_ATTR_U8_RW(track_fw_lost_frames);
 HX_ALGO_ATTR_U8_RW(debounce_base);
 HX_ALGO_ATTR_BOOL_RW(ghost_row_filter);
 HX_ALGO_ATTR_S32_RW(debounce_strong);
@@ -1259,6 +1260,7 @@ static struct attribute *hx_algo_attrs[] = {
 	&dev_attr_zone_split.attr,
 	&dev_attr_track_dist2_max.attr,
 	&dev_attr_track_lost_frames.attr,
+	&dev_attr_track_fw_lost_frames.attr,
 	&dev_attr_debounce_base.attr,
 	&dev_attr_ghost_row_filter.attr,
 	&dev_attr_debounce_strong.attr,
diff --git a/drivers/input/touchscreen/hx-algo.c b/drivers/input/touchscreen/hx-algo.c
index f752112..c09cf5b 100644
--- a/drivers/input/touchscreen/hx-algo.c
+++ b/drivers/input/touchscreen/hx-algo.c
@@ -84,6 +84,7 @@ void hx_algo_init_defaults(struct hx_algo *algo)
 	algo->zone_split       = true;
 	algo->track_dist2_max   = HIMAX_TRACK_MATCH_DIST2;
 	algo->track_lost_frames = HIMAX_TRACK_LOST_FRAMES;
+	algo->track_fw_lost_frames = 1;   /* a lone wrong flag must not cut a touch */
 	algo->debounce_base     = HIMAX_NEW_TOUCH_DEBOUNCE;
 	algo->ghost_row_filter  = false;
 	algo->debounce_strong   = 3000;
@@ -2278,6 +2279,7 @@ void hx_track_contacts(struct hx_algo *algo,
 	struct hx_match_candidate cand[HIMAX_MAX_TOUCH * HIMAX_MAX_TOUCH];
 	int cand_cnt = 0;
 	int i, j, k;
+	u8 lost;
 
 	/*
 	 * A track reported as a palm last frame has served its purpose; one
@@ -2433,6 +2435,16 @@ void hx_track_contacts(struct hx_algo *algo,
 		det_used[m->det_idx]        = true;
 	}
 
+	/*
+	 * The wait bridges a contact that drops out under a finger.  A frame the
+	 * firmware calls empty has no finger left to wait for, so the last lift
+	 * of a touch goes out sooner.  The flag covers the whole panel: with
+	 * another finger down a lift still waits.
+	 */
+	lost = algo->track_lost_frames;
+	if (algo->base_mode && algo->baseline_fw_finger && !algo->fw_finger)
+		lost = min(lost, algo->track_fw_lost_frames);
+
 	/* Age or release unmatched tracks. */
 	for (i = 0; i < HIMAX_MAX_TOUCH; i++) {
 		struct hx_track *trk = &algo->tracks[i];
@@ -2452,7 +2464,7 @@ void hx_track_contacts(struct hx_algo *algo,
 		}
 
 		trk->missed++;
-		if (trk->missed > algo->track_lost_frames) {
+		if (trk->missed > lost) {
 			algo->stats.tracks_lost++;
 			hx_reset_track(trk);
 			freed |= 1u << i;
diff --git a/drivers/input/touchscreen/hx-algo.h b/drivers/input/touchscreen/hx-algo.h
index 75fbfcd..4a7fcc5 100644
--- a/drivers/input/touchscreen/hx-algo.h
+++ b/drivers/input/touchscreen/hx-algo.h
@@ -367,6 +367,8 @@ struct hx_algo {
 	/* Tracking */
 	s32  track_dist2_max;      /* max squared distance for match       */
 	u8   track_lost_frames;    /* missed frames before slot release    */
+	u8   track_fw_lost_frames; /* the same while the firmware sees no  */
+				   /* finger; never more than the above    */
 	u8   debounce_base;        /* new-slot debounce count              */
 	s32  debounce_strong;      /* a new contact with at least this
 				    * signal is reported at once, unless
