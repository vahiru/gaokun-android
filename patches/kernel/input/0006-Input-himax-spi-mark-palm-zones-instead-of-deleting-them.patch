From: Vahiru <nekovahiru@gmail.com>
Subject: [PATCH] Input: himax-spi: 掌压剔除改成【标记】而不是删除连通域

**问题**：`hx_detect_macro_zones()` 的 BFS 是 **8-连通、阈值 `macro_threshold`**，
所以**指尖挨着手掌根部落下时，两者会进同一个 zone**。而 `hx_reject_palms()`
的处理是把命中规则的 zone 从数组里**整个删掉**（原地压缩 `zones[]`），
于是 `hx_detect_peaks()` 根本不会去扫它 —— **手指跟着手掌一起消失，
而且没有留下任何痕迹**。

规则 1 的阈值是面积 ≥ 50 格 ≈ 925 mm²，手掌 + 手指合成的 zone 轻松越过。

**改法**：不删，改成在 zone 上打 `is_palm` 标记，并记下是**哪一条规则**
命中的（`palm_rule`，1–4）。`hx_detect_peaks()` 默认跳过被标记的 zone ——
**这与原来的"删掉"逐位等价**，所以本补丁单独打上不改变任何行为。

真正的价值在于决定变得**可见且可逆**：

* `0043` 的 `palm_area / palm_signal / palm_density / palm_aspect` 四个计数器
  直接告诉你掌压在什么时候、按哪条规则开火。
* 新旋钮 `palm_zone_scan`（默认 0）打开后，掌压 zone 里也会找峰值，
  于是陷在手掌里的指尖能被救回来。
* 新旋钮 `palm_contact_area`（默认 0 = 关）在**逐触点**这一级再判一次掌压：
  `ct->area` 只统计"≥ 峰值一半"的格子，量的是**这个触点自己**而不是它
  碰巧连着的东西 —— 这才是分辨指尖与手掌根部的正确粒度。

★ 为什么默认值一个都不动：这两个旋钮的合适取值**必须拿真实的手在面板上量**，
而本仓的纪律是不在没实测的情况下改掌压（`bin/gaokun3-touch-mode.sh` 顶部记过）。
旋钮 + 计数器已经就位，定值是下一次上机的事，不是猜出来的。

顺带修掉一处死代码路径：`hx_reject_palms()` 原先用 `dst` 做原地压缩，
现在不需要了，一并删掉。

编译：`W=1` 零告警。
案卷：`docs/stage4-findings.md` #115。
---
diff --git a/drivers/input/touchscreen/himax-spi-core.c b/drivers/input/touchscreen/himax-spi-core.c
--- a/drivers/input/touchscreen/himax-spi-core.c
+++ b/drivers/input/touchscreen/himax-spi-core.c
@@ -1025,6 +1025,8 @@
 HX_ALGO_ATTR_U16_RW(iso_nbr_ratio_q8);
 HX_ALGO_ATTR_U8_RW(edge_min_area);
 HX_ALGO_ATTR_BOOL_RW(palm_enabled);
+HX_ALGO_ATTR_BOOL_RW(palm_zone_scan);
+HX_ALGO_ATTR_U16_RW(palm_contact_area);
 HX_ALGO_ATTR_U8_RW(palm_area_threshold);
 HX_ALGO_ATTR_S32_RW(palm_signal_threshold);
 HX_ALGO_ATTR_S16_RW(palm_density_low);
@@ -1059,6 +1061,8 @@
 	&dev_attr_iso_nbr_ratio_q8.attr,
 	&dev_attr_edge_min_area.attr,
 	&dev_attr_palm_enabled.attr,
+	&dev_attr_palm_zone_scan.attr,
+	&dev_attr_palm_contact_area.attr,
 	&dev_attr_palm_area_threshold.attr,
 	&dev_attr_palm_signal_threshold.attr,
 	&dev_attr_palm_density_low.attr,
diff --git a/drivers/input/touchscreen/hx-algo.c b/drivers/input/touchscreen/hx-algo.c
--- a/drivers/input/touchscreen/hx-algo.c
+++ b/drivers/input/touchscreen/hx-algo.c
@@ -48,6 +48,8 @@
 	algo->iso_nbr_ratio_q8   = 8;    /* legacy (z >> 5) behaviour  */
 	algo->edge_min_area      = 1;    /* legacy: border cell exempt */
 	algo->palm_enabled       = true;
+	algo->palm_zone_scan     = false;  /* legacy: palm zones yield no peaks */
+	algo->palm_contact_area  = 0;      /* legacy: no per-contact palm test  */
 	algo->palm_area_threshold    = 50;
 	algo->palm_signal_threshold  = 80000;
 	algo->palm_density_low       = 400;
@@ -379,6 +381,8 @@
 
 			zone->area       = 0;
 			zone->signal_sum = 0;
+			zone->is_palm    = false;
+			zone->palm_rule  = 0;
 			zone->min_r = r;  zone->max_r = r;
 			zone->min_c = c;  zone->max_c = c;
 
@@ -435,7 +439,14 @@
 /* ======================================================================== */
 /* Phase 2B — palm rejection                                                 */
 /*                                                                           */
-/* Four integer-only rules.  Any zone matching a rule is discarded.         */
+/* Four integer-only rules.  A matching zone is *marked*, not discarded.    */
+/*                                                                           */
+/* Marking rather than deleting matters because hx_detect_macro_zones()     */
+/* is 8-connected at macro_threshold: a fingertip touching down against     */
+/* the heel of the hand ends up in the same zone as the palm, and deleting  */
+/* the zone took the finger with it, with nothing left to show it had       */
+/* happened.  The zone now survives with is_palm set, so the decision is    */
+/* visible in the counters and reversible at runtime.                       */
 /* Rule 1: area >= palm_area_threshold                (large footprint)     */
 /* Rule 2: signal_sum >= palm_signal_threshold         (strong integrated)  */
 /* Rule 3: area >= 20 && density < palm_density_low   (spread low signal)  */
@@ -444,7 +455,6 @@
 
 void hx_reject_palms(struct hx_algo *algo)
 {
-	u8 dst = 0;
 	u8 i;
 
 	if (!algo->palm_enabled)
@@ -454,16 +464,19 @@
 		struct hx_macro_zone *z = &algo->zones[i];
 		u16 bbox_w, bbox_h, max_side, min_side;
 		bool reject = false;
+		u8 rule = 0;
 
 		/* Rule 1 */
 		if (z->area >= algo->palm_area_threshold) {
 			reject = true;
+			rule = 1;
 			goto next;
 		}
 
 		/* Rule 2 */
 		if (z->signal_sum >= algo->palm_signal_threshold) {
 			reject = true;
+			rule = 2;
 			goto next;
 		}
 
@@ -478,6 +491,7 @@
 		if (z->area >= 20 &&
 		    z->signal_sum < (s32)algo->palm_density_low * z->area) {
 			reject = true;
+			rule = 3;
 			goto next;
 		}
 
@@ -487,18 +501,15 @@
 		max_side = max(bbox_w, bbox_h);
 		min_side = min(bbox_w, bbox_h);
 		if (z->area >= 10 && min_side > 0 &&
-		    (u32)max_side * 256 >= 1024u * min_side)
+		    (u32)max_side * 256 >= 1024u * min_side) {
 			reject = true;
+			rule = 4;
+		}
 
 next:
-		if (!reject) {
-			if (dst != i)
-				algo->zones[dst] = *z;
-			dst++;
-		}
+		z->is_palm   = reject;
+		z->palm_rule = rule;
 	}
-
-	algo->zone_count = dst;
 }
 
 /* ======================================================================== */
@@ -609,6 +620,17 @@
 		struct hx_macro_zone *zone = &algo->zones[zi];
 		u16 px_limit = min_t(u16, zone->area, HX_ZONE_PX_MAX);
 		u16 pi;
+
+		/*
+		 * A zone the palm rules flagged yields no peaks, which is what
+		 * deleting it used to achieve.  palm_zone_scan lifts that so a
+		 * fingertip merged into a palm blob can still be found; the
+		 * per-contact palm_contact_area test in hx_expand_and_resolve()
+		 * is then what separates the two.  Both default to the old
+		 * behaviour -- this wants a real hand on the panel to tune.
+		 */
+		if (zone->is_palm && !algo->palm_zone_scan)
+			continue;
 
 		for (pi = 0; pi < px_limit; pi++) {
 			int idx = zone->pixels[pi];
@@ -962,6 +984,17 @@
 		clean = hx_expand_single_peak(algo, i, ct);
 		if (!clean)
 			hx_local_centroid(algo, i, ct);
+
+		/*
+		 * Per-contact palm test.  ct->area counts only cells at or above
+		 * half the peak, so it measures this contact rather than whatever
+		 * it happens to be connected to -- the right granularity for
+		 * telling a fingertip from the heel of a hand beside it.
+		 * 0 disables it, which is the shipped default.
+		 */
+		if (algo->palm_contact_area &&
+		    ct->area >= algo->palm_contact_area)
+			continue;
 
 		/* Push edge centroids outward toward physical sensor boundary */
 		if (ct->is_edge)
diff --git a/drivers/input/touchscreen/hx-algo.h b/drivers/input/touchscreen/hx-algo.h
--- a/drivers/input/touchscreen/hx-algo.h
+++ b/drivers/input/touchscreen/hx-algo.h
@@ -93,6 +93,8 @@
 	u8  max_r;
 	u8  min_c;
 	u8  max_c;
+	bool is_palm;   /* set by hx_reject_palms(); the zone is kept */
+	u8 palm_rule;   /* which rule fired, 1-4; 0 = not a palm      */
 };
 
 /**
@@ -148,6 +150,8 @@
 	u8   edge_min_area;        /* minimum zone area for an on-edge peak
 	                            * (1 = a lone border cell still counts) */
 	bool palm_enabled;         /* palm-rejection on/off                */
+	bool palm_zone_scan;       /* also look for peaks inside palm zones */
+	u16  palm_contact_area;    /* per-contact palm test; 0 = disabled   */
 	u8   palm_area_threshold;  /* area >= this → palm                  */
 	s32  palm_signal_threshold;/* signal_sum >= this → palm            */
 	s16  palm_density_low;     /* signal/area < this → palm            */
