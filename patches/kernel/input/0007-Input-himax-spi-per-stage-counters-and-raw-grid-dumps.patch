 	stable_cnt = hx_count_stable_tracks(algo);
+	if (stable_cnt > 0) {
+		algo->stats.frames_reported++;
+		if (stable_cnt > algo->stats.max_contacts)
+			algo->stats.max_contacts = stable_cnt;
+	}
 
 	/* Not final results, touchscreen_report_pos will handle this (x-y swap, y invert) */
 	for (int i = 0; i < HIMAX_MAX_TOUCH; ++i) {
@@ -1490,6 +1643,28 @@
 		return ret;
 	}
 
+	/*
+	 * Tie the debugfs tree to the device with devm rather than unwinding it
+	 * by hand.  devm_drm_panel_add_follower() below can return -EPROBE_DEFER
+	 * (that is why the existing error path uses dev_err_probe()), and a
+	 * hand-rolled create-here / remove-in-.remove() pair leaks the dentry on
+	 * that path.  Worse, the retry then finds the directory name already
+	 * taken: debugfs_create_dir() returns -EEXIST, debugfs_create_file()
+	 * quietly does nothing with that error pointer, and the driver comes up
+	 * with no diagnostic interface at all and nothing said so.
+	 */
+	ts->dbg_dir = debugfs_create_dir("himax-hx83121a", NULL);
+	ret = devm_add_action_or_reset(ts->dev, himax_debugfs_release,
+				      ts->dbg_dir);
+	if (ret) {
+		device_remove_file(ts->dev, &dev_attr_inplace_reset);
+		return ret;
+	}
+	debugfs_create_file("frame_raw", 0400, ts->dbg_dir, ts,
+			    &himax_dbg_raw_fops);
+	debugfs_create_file("frame", 0400, ts->dbg_dir, ts,
+			    &himax_dbg_out_fops);
+
 	ts->panel_follower.funcs = &himax_panel_follower_funcs;
 	ret = devm_drm_panel_add_follower(ts->dev, &ts->panel_follower);
 	if (ret) {
