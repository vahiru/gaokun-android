 }
 
diff --git a/drivers/input/touchscreen/hx-algo.h b/drivers/input/touchscreen/hx-algo.h
--- a/drivers/input/touchscreen/hx-algo.h
+++ b/drivers/input/touchscreen/hx-algo.h
@@ -97,7 +97,57 @@
 	u8 palm_rule;   /* which rule fired, 1-4; 0 = not a palm      */
 };
 
+/* Number of recent contact births kept for inspection. */
+#define HX_NEWLOG      16
+
 /**
+ * struct hx_stats - per-stage counters for the frame pipeline.
+ *
+ * Every stage between "a pixel crossed the threshold" and "a contact was
+ * reported" can silently drop or pass a candidate, and until these existed
+ * nothing in the driver could say which one did.  That is the question any
+ * touch complaint turns into, so the counters are cheap and always on.
+ * Free-running; reset by writing anything to the sysfs stats attribute.
+ */
+struct hx_stats {
+	u32 frames;             /* frames processed                        */
+	u32 frames_reported;    /* frames with at least one stable contact */
+	u32 zones;              /* macro-zones found                       */
+	u32 zones_evicted;      /* table full, a weaker zone was displaced */
+	u32 zones_overflow;     /* table full, the new zone lost           */
+	u32 palm_rule[5];       /* [1..4] = how often each palm rule fired */
+	u32 peaks_raw;          /* peak candidates before the filters      */
+	u32 rej_drift;          /* dropped as pressure drift               */
+	u32 rej_isolated;       /* dropped by the isolated-spike gate      */
+	u32 rej_minarea;        /* dropped by the minimum-area filter      */
+	u32 rej_edgeweak;       /* dropped as a weak edge peak             */
+	u32 contacts;           /* contacts handed to the tracker          */
+	u32 rej_contact_area;   /* dropped by the per-contact palm test    */
+	u32 tracks_new;         /* slots created                           */
+	u32 tracks_new_edge;    /* ... of those, born on a grid border     */
+	u32 tracks_jump;        /* released by jump detection              */
+	u32 tracks_guard_kill;  /* killed by track_active_guard            */
+	u32 tracks_lost;        /* released after track_lost_frames        */
+	u8  max_contacts;       /* most simultaneous stable contacts seen  */
+};
+
+/**
+ * struct hx_newlog - what a contact looked like at the moment it was born.
+ *
+ * A ghost and a fingertip both arrive as "a new touch"; they differ in area,
+ * integrated signal and whether they sat on the grid border.  Keeping the
+ * last few makes that difference readable after the fact.
+ */
+struct hx_newlog {
+	u32  seq;
+	s32  x;
+	s32  y;
+	u16  area;
+	s32  signal_sum;
+	bool is_edge;
+};
+
+/**
  * struct hx_algo - all algorithm state, allocated once in probe.
  *
  * Memory budget: ~40 KB.  Never allocate on the stack.
@@ -105,6 +155,11 @@
 struct hx_algo {
 	/* ---- Frame buffers ---- */
 	s16 frame[HX_ROWS][HX_COLS];        /* baseline-subtracted signal  */
+	/* Copy of frame[] straight after baseline subtraction, before CMF,
+	 * edge boost and IIR touch it.  This is the one the panel actually
+	 * produced, so it is the only place a per-pixel baseline problem
+	 * (thermal drift, a charger, water) is still visible. */
+	s16 raw_frame[HX_ROWS][HX_COLS];
 	s16 iir_history[HX_ROWS][HX_COLS];  /* IIR temporal-filter history */
 	bool iir_initialized;
 
@@ -170,6 +225,12 @@
 	bool track_active_guard;   /* kill stray tracks before 1st stable  */
 	u8   track_start_debounce; /* frames to confirm touch_active       */
 	s32  track_jump_dist2;     /* position jump → force lift+repress   */
+
+	/* ---- Diagnostics ---- */
+	struct hx_stats  stats;
+	struct hx_newlog newlog[HX_NEWLOG];
+	u8   newlog_head;
+	u32  newlog_seq;
 };
 
 /* ---- Public API ---- */
