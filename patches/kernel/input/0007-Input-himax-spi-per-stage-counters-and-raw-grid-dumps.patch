+				algo->stats.zones_evicted++;
+			} else {
+				algo->stats.zones_overflow++;
+			}
 		}
 	}
 }
@@ -509,6 +519,8 @@
 next:
 		z->is_palm   = reject;
 		z->palm_rule = rule;
+		if (reject)
+			algo->stats.palm_rule[rule]++;
 	}
 }
 
@@ -645,8 +657,10 @@
 				continue;
 			if (!hx_is_asymmetric_peak(algo, r, c))
 				continue;
-			if (hx_detect_pressure_drift(algo, r, c))
+			if (hx_detect_pressure_drift(algo, r, c)) {
+				algo->stats.rej_drift++;
 				continue;
+			}
 
 			for (dr = -1; dr <= 1; dr++)
 				for (dc = -1; dc <= 1; dc++) {
@@ -662,6 +676,7 @@
 				.nbr_sum   = nbr_sum,
 				.zone_area = zone->area,
 			};
+			algo->stats.peaks_raw++;
 			hx_insert_peak(algo, &peak);
 		}
 	}
@@ -691,6 +706,8 @@
 
 			if (have >= need)
 				algo->peaks[dst++] = algo->peaks[i];
+			else
+				algo->stats.rej_isolated++;
 		}
 		algo->peak_count = dst;
 	}
@@ -720,6 +737,8 @@
 
 			if (algo->peaks[i].zone_area >= min_area)
 				algo->peaks[dst++] = algo->peaks[i];
+			else
+				algo->stats.rej_minarea++;
 		}
 		algo->peak_count = dst;
 	}
@@ -759,6 +778,8 @@
 				}
 				if (!(on_edge && algo->peaks[i].z < cutoff))
 					algo->peaks[dst++] = algo->peaks[i];
+				else
+					algo->stats.rej_edgeweak++;
 			}
 			algo->peak_count = dst;
 		}
@@ -993,8 +1014,10 @@
 		 * 0 disables it, which is the shipped default.
 		 */
 		if (algo->palm_contact_area &&
-		    ct->area >= algo->palm_contact_area)
+		    ct->area >= algo->palm_contact_area) {
+			algo->stats.rej_contact_area++;
 			continue;
+		}
 
 		/* Push edge centroids outward toward physical sensor boundary */
 		if (ct->is_edge)
@@ -1028,6 +1051,7 @@
 	 * This matches the coordinate range the DT/touchscreen_properties
 	 * are calibrated for.
 	 */
+	algo->stats.contacts += algo->contact_count;
 	*cnt = algo->contact_count;
 	for (i = 0; i < *cnt; i++) {
 		struct hx_contact *ct = &algo->contacts[i];
@@ -1150,6 +1174,7 @@
 		 */
 		if (algo->track_jump_dist2 > 0 && trk->age >= 2 &&
 		    m->dist2 > algo->track_jump_dist2) {
+			algo->stats.tracks_jump++;
 			hx_reset_track(trk);
 			jump_released |= (1u << m->track_idx);
 			track_matched[m->track_idx] = true;
@@ -1191,13 +1216,16 @@
 		 * tracks immediately to prevent noise from being reported.
 		 */
 		if (algo->track_active_guard && !algo->touch_active) {
+			algo->stats.tracks_guard_kill++;
 			hx_reset_track(trk);
 			continue;
 		}
 
 		trk->missed++;
-		if (trk->missed > algo->track_lost_frames)
+		if (trk->missed > algo->track_lost_frames) {
+			algo->stats.tracks_lost++;
 			hx_reset_track(trk);
+		}
 	}
 
 	/* Create new slots for unmatched detections. */
@@ -1227,6 +1255,24 @@
 		trk->vy       = 0;
 		if (j < algo->contact_count)
 			trk->signal_sum = algo->contacts[j].signal_sum;
+
+		/* Record what this contact looked like when it was born. */
+		algo->stats.tracks_new++;
+		{
+			struct hx_newlog *lg = &algo->newlog[algo->newlog_head];
+
+			lg->seq        = ++algo->newlog_seq;
+			lg->x          = det[j].x;
+			lg->y          = det[j].y;
+			lg->area       = j < algo->contact_count ?
+					     algo->contacts[j].area : 0;
+			lg->signal_sum = trk->signal_sum;
+			lg->is_edge    = j < algo->contact_count &&
+					     algo->contacts[j].is_edge;
+			if (lg->is_edge)
