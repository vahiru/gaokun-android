 HX_ALGO_ATTR_U8_RW(track_start_debounce);
 HX_ALGO_ATTR_S32_RW(track_jump_dist2);
 
+/*
+ * Per-stage counters.  Read unlocked on purpose: the only writer is the
+ * IRQ thread, a snapshot torn across fields costs nothing for diagnostics,
+ * and taking op_lock here would let a wedged touch path block the one read
+ * that would explain why it is wedged.
+ */
+static ssize_t stats_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct himax_ts_data *ts = dev_get_drvdata(dev);
+	struct hx_stats *st = &ts->algo->stats;
+	int n = 0;
+
+	n += sysfs_emit_at(buf, n, "frames            %u\n", st->frames);
+	n += sysfs_emit_at(buf, n, "frames_reported   %u\n", st->frames_reported);
+	n += sysfs_emit_at(buf, n, "zones             %u\n", st->zones);
+	n += sysfs_emit_at(buf, n, "zones_evicted     %u\n", st->zones_evicted);
+	n += sysfs_emit_at(buf, n, "zones_overflow    %u\n", st->zones_overflow);
+	n += sysfs_emit_at(buf, n, "palm_area         %u\n", st->palm_rule[1]);
+	n += sysfs_emit_at(buf, n, "palm_signal       %u\n", st->palm_rule[2]);
+	n += sysfs_emit_at(buf, n, "palm_density      %u\n", st->palm_rule[3]);
+	n += sysfs_emit_at(buf, n, "palm_aspect       %u\n", st->palm_rule[4]);
+	n += sysfs_emit_at(buf, n, "peaks_raw         %u\n", st->peaks_raw);
+	n += sysfs_emit_at(buf, n, "rej_drift         %u\n", st->rej_drift);
+	n += sysfs_emit_at(buf, n, "rej_isolated      %u\n", st->rej_isolated);
+	n += sysfs_emit_at(buf, n, "rej_minarea       %u\n", st->rej_minarea);
+	n += sysfs_emit_at(buf, n, "rej_edgeweak      %u\n", st->rej_edgeweak);
+	n += sysfs_emit_at(buf, n, "contacts          %u\n", st->contacts);
+	n += sysfs_emit_at(buf, n, "rej_contact_area  %u\n", st->rej_contact_area);
+	n += sysfs_emit_at(buf, n, "tracks_new        %u\n", st->tracks_new);
+	n += sysfs_emit_at(buf, n, "tracks_new_edge   %u\n", st->tracks_new_edge);
+	n += sysfs_emit_at(buf, n, "tracks_jump       %u\n", st->tracks_jump);
+	n += sysfs_emit_at(buf, n, "tracks_guard_kill %u\n", st->tracks_guard_kill);
+	n += sysfs_emit_at(buf, n, "tracks_lost       %u\n", st->tracks_lost);
+	n += sysfs_emit_at(buf, n, "max_contacts      %u\n", st->max_contacts);
+	return n;
+}
+
+static ssize_t stats_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct himax_ts_data *ts = dev_get_drvdata(dev);
+
+	memset(&ts->algo->stats, 0, sizeof(ts->algo->stats));
+	memset(ts->algo->newlog, 0, sizeof(ts->algo->newlog));
+	ts->algo->newlog_head = 0;
+	ts->algo->newlog_seq = 0;
+	return count;
+}
+static DEVICE_ATTR_RW(stats);
+
+/* The last HX_NEWLOG contact births, oldest first. */
+static ssize_t contacts_log_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct hx_algo *algo = ((struct himax_ts_data *)dev_get_drvdata(dev))->algo;
+	int n = 0, k;
+
+	n += sysfs_emit_at(buf, n, "  seq      x      y  area   signal edge\n");
+	for (k = 0; k < HX_NEWLOG; k++) {
+		struct hx_newlog *lg =
+			&algo->newlog[(algo->newlog_head + k) % HX_NEWLOG];
+
+		if (!lg->seq)
+			continue;
+		n += sysfs_emit_at(buf, n, "%5u %6d %6d %5u %8d %4u\n",
+					   lg->seq, lg->x, lg->y, lg->area,
+					   lg->signal_sum, lg->is_edge ? 1 : 0);
+	}
+	return n;
+}
+static DEVICE_ATTR_RO(contacts_log);
+
 static struct attribute *hx_algo_attrs[] = {
 	&dev_attr_cmf_enabled.attr,
 	&dev_attr_cmf_exclusion.attr,
@@ -1078,6 +1154,8 @@
 	&dev_attr_track_active_guard.attr,
 	&dev_attr_track_start_debounce.attr,
 	&dev_attr_track_jump_dist2.attr,
+	&dev_attr_stats.attr,
+	&dev_attr_contacts_log.attr,
 	NULL,
 };
 
@@ -1086,6 +1164,76 @@
 	.attrs = hx_algo_attrs,
 };
 
+/*
+ * Raw grid dumps.  40x60 s16, little-endian, 4800 bytes -- too big for a
+ * sysfs attribute (PAGE_SIZE), hence debugfs.  frame_raw is what the panel
+ * produced; frame is what the pipeline decided.  Comparing the two is the
+ * only way to tell a signal problem from an algorithm problem, and reading
+ * frame_raw with nothing touching the panel is the only way to answer
+ * whether the firmware tracks a per-pixel baseline at all.
+ */
+static ssize_t himax_dbg_grid(struct himax_ts_data *ts, bool raw,
+				char __user *ubuf, size_t count, loff_t *ppos)
+{
+	size_t sz;
+	void *snap;
+	ssize_t ret;
+
+	if (!ts || !ts->algo)
+		return -ENODEV;
+
+	sz = sizeof(ts->algo->frame);
+	snap = kmalloc(sz, GFP_KERNEL);
+	if (!snap)
+		return -ENOMEM;
+
+	/*
+		 * op_lock is taken directly and deliberately: himax_lock() also
+		 * quiesces the interrupt, and himax_unlock() does not bring it back,
+		 * so borrowing that helper here would leave touch dead after a
+		 * diagnostic read.
+		 */
+	mutex_lock(&ts->op_lock);
+	memcpy(snap, raw ? (void *)ts->algo->raw_frame
+			     : (void *)ts->algo->frame, sz);
+	mutex_unlock(&ts->op_lock);
+
+	ret = simple_read_from_buffer(ubuf, count, ppos, snap, sz);
+	kfree(snap);
+	return ret;
+}
+
+static ssize_t himax_dbg_raw_read(struct file *f, char __user *u,
+				  size_t c, loff_t *p)
+{
+	return himax_dbg_grid(f->private_data, true, u, c, p);
+}
+
+static ssize_t himax_dbg_out_read(struct file *f, char __user *u,
+				  size_t c, loff_t *p)
+{
+	return himax_dbg_grid(f->private_data, false, u, c, p);
+}
+
+static const struct file_operations himax_dbg_raw_fops = {
+	.owner  = THIS_MODULE,
+	.open   = simple_open,
+	.read   = himax_dbg_raw_read,
+	.llseek = default_llseek,
+};
+
+static void himax_debugfs_release(void *dir)
+{
+	debugfs_remove_recursive(dir);
+}
+
+static const struct file_operations himax_dbg_out_fops = {
+	.owner  = THIS_MODULE,
+	.open   = simple_open,
+	.read   = himax_dbg_out_read,
+	.llseek = default_llseek,
+};
+
 static const struct drm_panel_follower_funcs himax_panel_follower_funcs = {
 	.panel_prepared = himax_panel_prepared,
 	.panel_unpreparing = himax_panel_unpreparing,
@@ -1198,6 +1346,11 @@
 	hx_expand_and_resolve(algo, pos, &cnt);
 	hx_track_contacts(algo, pos, cnt);
 	stable_cnt = hx_count_stable_tracks(algo);
+	if (stable_cnt > 0) {
+		algo->stats.frames_reported++;
+		if (stable_cnt > algo->stats.max_contacts)
+			algo->stats.max_contacts = stable_cnt;
+	}
 
 	/* Not final results, touchscreen_report_pos will handle this (x-y swap, y invert) */
 	for (int i = 0; i < HIMAX_MAX_TOUCH; ++i) {
@@ -1490,6 +1643,28 @@
 		return ret;
 	}
 
+	/*
+	 * Tie the debugfs tree to the device with devm rather than unwinding it
+	 * by hand.  devm_drm_panel_add_follower() below can return -EPROBE_DEFER
+	 * (that is why the existing error path uses dev_err_probe()), and a
+	 * hand-rolled create-here / remove-in-.remove() pair leaks the dentry on
+	 * that path.  Worse, the retry then finds the directory name already
+	 * taken: debugfs_create_dir() returns -EEXIST, debugfs_create_file()
+	 * quietly does nothing with that error pointer, and the driver comes up
+	 * with no diagnostic interface at all and nothing said so.
+	 */
+	ts->dbg_dir = debugfs_create_dir("himax-hx83121a", NULL);
+	ret = devm_add_action_or_reset(ts->dev, himax_debugfs_release,
+				      ts->dbg_dir);
+	if (ret) {
+		device_remove_file(ts->dev, &dev_attr_inplace_reset);
+		return ret;
+	}
+	debugfs_create_file("frame_raw", 0400, ts->dbg_dir, ts,
+			    &himax_dbg_raw_fops);
+	debugfs_create_file("frame", 0400, ts->dbg_dir, ts,
+			    &himax_dbg_out_fops);
+
 	ts->panel_follower.funcs = &himax_panel_follower_funcs;
 	ret = devm_drm_panel_add_follower(ts->dev, &ts->panel_follower);
 	if (ret) {
diff --git a/drivers/input/touchscreen/hx-algo.c b/drivers/input/touchscreen/hx-algo.c
