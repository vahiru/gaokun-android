+ * Every stage between "a pixel crossed the threshold" and "a contact was
+ * reported" can silently drop or pass a candidate, and until these existed
+ * nothing in the driver could say which one did.  That is the question any
+ * touch complaint turns into, so the counters are cheap and always on.
+ * Free-running; reset by writing anything to the sysfs stats attribute.
+ */
+struct hx_stats {
+	u32 frames;             /* frames processed                        */
+	u32 frames_reported;    /* frames with at least one stable contact */
+	u32 zones;              /* macro-zones found                       */
+	u32 zones_evicted;      /* table full, a weaker zone was displaced */
+	u32 zones_overflow;     /* table full, the new zone lost           */
+	u32 palm_rule[5];       /* [1..4] = how often each palm rule fired */
+	u32 peaks_raw;          /* peak candidates before the filters      */
+	u32 rej_drift;          /* dropped as pressure drift               */
+	u32 rej_isolated;       /* dropped by the isolated-spike gate      */
+	u32 rej_minarea;        /* dropped by the minimum-area filter      */
+	u32 rej_edgeweak;       /* dropped as a weak edge peak             */
+	u32 contacts;           /* contacts handed to the tracker          */
+	u32 rej_contact_area;   /* dropped by the per-contact palm test    */
+	u32 tracks_new;         /* slots created                           */
+	u32 tracks_new_edge;    /* ... of those, born on a grid border     */
+	u32 tracks_jump;        /* released by jump detection              */
+	u32 tracks_guard_kill;  /* killed by track_active_guard            */
+	u32 tracks_lost;        /* released after track_lost_frames        */
+	u8  max_contacts;       /* most simultaneous stable contacts seen  */
