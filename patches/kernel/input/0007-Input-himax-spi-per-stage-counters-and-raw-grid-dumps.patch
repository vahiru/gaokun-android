+	n += sysfs_emit_at(buf, n, "rej_isolated      %u\n", st->rej_isolated);
+	n += sysfs_emit_at(buf, n, "rej_minarea       %u\n", st->rej_minarea);
+	n += sysfs_emit_at(buf, n, "rej_edgeweak      %u\n", st->rej_edgeweak);
+	n += sysfs_emit_at(buf, n, "contacts          %u\n", st->contacts);
+	n += sysfs_emit_at(buf, n, "rej_contact_area  %u\n", st->rej_contact_area);
+	n += sysfs_emit_at(buf, n, "tracks_new        %u\n", st->tracks_new);
+	n += sysfs_emit_at(buf, n, "tracks_new_edge   %u\n", st->tracks_new_edge);
+	n += sysfs_emit_at(buf, n, "tracks_jump       %u\n", st->tracks_jump);
+	n += sysfs_emit_at(buf, n, "tracks_guard_kill %u\n", st->tracks_guard_kill);
+	n += sysfs_emit_at(buf, n, "tracks_lost       %u\n", st->tracks_lost);
+	n += sysfs_emit_at(buf, n, "max_contacts      %u\n", st->max_contacts);
+	return n;
+}
+
+static ssize_t stats_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct himax_ts_data *ts = dev_get_drvdata(dev);
+
+	memset(&ts->algo->stats, 0, sizeof(ts->algo->stats));
+	memset(ts->algo->newlog, 0, sizeof(ts->algo->newlog));
+	ts->algo->newlog_head = 0;
+	ts->algo->newlog_seq = 0;
+	return count;
+}
+static DEVICE_ATTR_RW(stats);
+
+/* The last HX_NEWLOG contact births, oldest first. */
+static ssize_t contacts_log_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct hx_algo *algo = ((struct himax_ts_data *)dev_get_drvdata(dev))->algo;
+	int n = 0, k;
+
+	n += sysfs_emit_at(buf, n, "  seq      x      y  area   signal edge\n");
+	for (k = 0; k < HX_NEWLOG; k++) {
+		struct hx_newlog *lg =
+			&algo->newlog[(algo->newlog_head + k) % HX_NEWLOG];
+
+		if (!lg->seq)
+			continue;
+		n += sysfs_emit_at(buf, n, "%5u %6d %6d %5u %8d %4u\n",
+					   lg->seq, lg->x, lg->y, lg->area,
+					   lg->signal_sum, lg->is_edge ? 1 : 0);
+	}
+	return n;
+}
+static DEVICE_ATTR_RO(contacts_log);
