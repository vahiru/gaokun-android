+	n += sysfs_emit_at(buf, n, "zones_overflow    %u\n", st->zones_overflow);
+	n += sysfs_emit_at(buf, n, "palm_area         %u\n", st->palm_rule[1]);
+	n += sysfs_emit_at(buf, n, "palm_signal       %u\n", st->palm_rule[2]);
