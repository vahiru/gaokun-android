@@ -86,6 +86,10 @@
 
 	/* pixel [0][0] is always invalid on this panel layout */
 	algo->frame[0][0] = 0;
+
+	/* Keep the untouched frame for the diagnostic dump; everything after
+	 * this point (CMF, edge boost, IIR) rewrites frame[] in place. */
+	memcpy(algo->raw_frame, algo->frame, sizeof(algo->frame));
 }
 
 /* ======================================================================== */
@@ -278,6 +282,7 @@
 
 void hx_preprocess_frame(struct hx_algo *algo, const u16 *raw)
 {
+	algo->stats.frames++;
 	hx_prepare_frame_baseline(algo, raw);
 
 	if (algo->cmf_enabled)
@@ -427,11 +432,16 @@
 				}
 			}
 
-			if (!full)
-				algo->zone_count++;
-			else if (zone->signal_sum >
-				 algo->zones[weakest].signal_sum)
