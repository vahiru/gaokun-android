From: Vahiru <nekovahiru@gmail.com>
Subject: [PATCH] Input: himax-spi: 把两道形同虚设的噪声闸门做成可调，并标注失效的掌压规则 3

这个驱动不走 IC 固件的触点输出，而是自己读 40×60 原始电容网格、自己做
去基线 / BFS 连通域 / 峰值 / 质心 / 跟踪（`hx-algo.c`）。噪声能不能变成一个
触点，完全取决于这条流水线上的几道闸门。审下来有三处名存实亡：

**1. Z8 孤立尖峰过滤（`hx_detect_peaks()`）**

    if ((algo->peaks[i].z >> 5) <= algo->peaks[i].nbr_sum)   /* 留下 */

`z >> 5` 就是 z/32。峰值刚好卡在阈值 800 时，这一条只会毙掉"八邻域加起来
不到 **25**"的尖峰 —— 环境噪声轻松越过。**它实际上从来没生效过。**
真手指的八邻域之和通常是峰值的 2～5 倍，脉冲噪声则接近 0，所以判据应该写成
峰值的一个比例。改成 Q8 比值 `nbr_sum * 256 >= z * iso_nbr_ratio_q8`，
**默认 8 与原式逐位等价**；想真正生效就调到 128（邻域至少要担一半）。

**2. 边缘单像素豁免（同一函数）**

    if (algo->peaks[i].zone_area >= 2 || on_edge)            /* 留下 */

非边缘要求连通域至少 2 格，**边缘则完全豁免** —— 一个噪点就够。理由本身成立
（手指压在边上有一半落在网格外），但这恰好是"单个噪声格 → 上报触点"最短的一条路，
而且 `hx_edge_boost()` 刚刚把边缘格乘了 `1 + edge_boost_pct/100`（默认 +50%，
四角**乘两次** = ×2.25）。也就是说边缘噪声先被放大 1.5 倍再去撞阈值，撞过了就直接放行。
拿平板的手正好扶在四边。改成可调的 `edge_min_area`，**默认 1 = 原行为**，
设 2 则要求边缘触点至少有一个过阈邻居。

**3. 掌压规则 3 是死代码（`hx_reject_palms()`）**

    if (z->area >= 20 && z->signal_sum < palm_density_low * z->area)

连通域里每一格都 `>= macro_threshold`（BFS 的构造前提），所以恒有
`signal_sum >= macro_threshold * area`。出厂值 `palm_density_low = 400`、
`macro_threshold = 800`，**这一条永远为假**。不改行为（改了就是在没实测的情况下
动掌压），只把这个前提写进注释：要让它生效，`palm_density_low` 必须大于
`macro_threshold`。

⚠️ 三项默认值全部保持原样，**本补丁单独打上不改变任何行为** —— 要的是那两个旋钮
和那句注释。和 `0037` 一样的理由：本项目里重启是最贵的资源，旋钮换来的是
一次重启之后无限次实机 A/B。

⚠️ 目前**没有**证据表明用户报告的幽灵触摸走的是这两条路 —— 2026-09-14 的实测
把绝大部分症状归到了 `0038` 的跳点检测上（一次滑动碎成十几次触摸，沿途的"按下"
看起来就是幽灵）。这里修的是**审查发现的、确实存在的**薄弱环节，
留作幽灵触摸真的在边缘复现时的下一把工具。

案卷：`docs/stage4-findings.md` #114。
---
diff --git a/drivers/input/touchscreen/himax-spi-core.c b/drivers/input/touchscreen/himax-spi-core.c
--- a/drivers/input/touchscreen/himax-spi-core.c
+++ b/drivers/input/touchscreen/himax-spi-core.c
@@ -1015,6 +1015,8 @@
 /* Detection */
 HX_ALGO_ATTR_S16_RW(macro_threshold);
 HX_ALGO_ATTR_S16_RW(peak_threshold);
+HX_ALGO_ATTR_U16_RW(iso_nbr_ratio_q8);
+HX_ALGO_ATTR_U8_RW(edge_min_area);
 HX_ALGO_ATTR_BOOL_RW(palm_enabled);
 HX_ALGO_ATTR_U8_RW(palm_area_threshold);
 HX_ALGO_ATTR_S32_RW(palm_signal_threshold);
@@ -1047,6 +1049,8 @@
 	&dev_attr_iir_gate_ratio_q8.attr,
 	&dev_attr_macro_threshold.attr,
 	&dev_attr_peak_threshold.attr,
+	&dev_attr_iso_nbr_ratio_q8.attr,
+	&dev_attr_edge_min_area.attr,
 	&dev_attr_palm_enabled.attr,
 	&dev_attr_palm_area_threshold.attr,
 	&dev_attr_palm_signal_threshold.attr,
diff --git a/drivers/input/touchscreen/hx-algo.c b/drivers/input/touchscreen/hx-algo.c
--- a/drivers/input/touchscreen/hx-algo.c
+++ b/drivers/input/touchscreen/hx-algo.c
@@ -45,6 +45,8 @@
 	algo->iir_gate_ratio_q8  = 26;
 	algo->macro_threshold    = 800;
 	algo->peak_threshold     = 800;
+	algo->iso_nbr_ratio_q8   = 8;    /* legacy (z >> 5) behaviour  */
+	algo->edge_min_area      = 1;    /* legacy: border cell exempt */
 	algo->palm_enabled       = true;
 	algo->palm_area_threshold    = 50;
 	algo->palm_signal_threshold  = 80000;
@@ -437,7 +439,13 @@
 		}
 
 		/* Rule 3: density = signal_sum / area < palm_density_low
-		 *         Rewritten without division: signal_sum < low * area */
+		 *         Rewritten without division: signal_sum < low * area
+		 *
+		 * NOTE: inert unless palm_density_low > macro_threshold.  Every
+		 * pixel in a zone is >= macro_threshold by BFS construction, so
+		 * signal_sum >= macro_threshold * area always holds; with the
+		 * shipped defaults (400 vs 800) this test can never be true.
+		 */
 		if (z->area >= 20 &&
 		    z->signal_sum < (s32)algo->palm_density_low * z->area) {
 			reject = true;
@@ -607,18 +615,48 @@
 		}
 	}
 
-	/* --- Z8 isolation filter: (z >> 5) > nbr_sum → isolated spike --- */
+	/*
+	 * Isolated-spike filter.
+	 *
+	 * A real fingertip lifts its eight neighbours with it, so nbr_sum runs
+	 * a few times the peak value; impulse noise does not.  Express the
+	 * gate as a fraction of the peak in Q8:
+	 *
+	 *	keep when  nbr_sum * 256 >= z * iso_nbr_ratio_q8
+	 *
+	 * The historical test was (z >> 5) <= nbr_sum, i.e. a ratio of 8/256.
+	 * For a peak sitting at the 800 threshold that only rejects a spike
+	 * whose eight neighbours sum to under 25, which ambient noise clears
+	 * easily -- in practice it never fired.  The default below reproduces
+	 * it exactly; raise it (128 = neighbours must carry half the peak) to
+	 * actually reject single-cell contacts.
+	 */
 	{
 		u8 dst = 0, i;
 
 		for (i = 0; i < algo->peak_count; i++) {
-			if ((algo->peaks[i].z >> 5) <= algo->peaks[i].nbr_sum)
+			s64 have = (s64)algo->peaks[i].nbr_sum * 256;
+			s64 need = (s64)algo->peaks[i].z * algo->iso_nbr_ratio_q8;
+
+			if (have >= need)
 				algo->peaks[dst++] = algo->peaks[i];
 		}
 		algo->peak_count = dst;
 	}
 
-	/* --- Zone minimum-area filter: area < 2 → reject (except edge peaks) --- */
+	/*
+	 * Minimum-area filter.
+	 *
+	 * Away from the border a contact must occupy at least two cells.  On
+	 * the border the historical code exempted the peak outright, because
+	 * a finger there has half its footprint off-grid -- but that
+	 * exemption is also the cheapest route from one noisy border cell to
+	 * a reported touch, and hx_edge_boost() has just scaled border cells
+	 * by 1 + edge_boost_pct/100 (corners twice, multiplicatively).
+	 * edge_min_area makes the exemption tunable: 1 is the historical
+	 * behaviour, 2 requires a border contact to have at least one
+	 * above-threshold neighbour.
+	 */
 	{
 		u8 dst = 0, i;
 
@@ -627,8 +665,9 @@
 					algo->peaks[i].r == HX_ROWS - 1 ||
 					algo->peaks[i].c == 0 ||
 					algo->peaks[i].c == HX_COLS - 1);
+			u16 min_area = on_edge ? algo->edge_min_area : 2;
 
-			if (algo->peaks[i].zone_area >= 2 || on_edge)
+			if (algo->peaks[i].zone_area >= min_area)
 				algo->peaks[dst++] = algo->peaks[i];
 		}
 		algo->peak_count = dst;
diff --git a/drivers/input/touchscreen/hx-algo.h b/drivers/input/touchscreen/hx-algo.h
--- a/drivers/input/touchscreen/hx-algo.h
+++ b/drivers/input/touchscreen/hx-algo.h
@@ -140,6 +140,10 @@
 	/* Detection */
 	s16  macro_threshold;      /* minimum pixel value to seed BFS      */
 	s16  peak_threshold;       /* minimum peak signal                  */
+	u16  iso_nbr_ratio_q8;     /* isolated-spike gate: keep a peak only
+	                            * when nbr_sum * 256 >= z * this        */
+	u8   edge_min_area;        /* minimum zone area for an on-edge peak
+	                            * (1 = a lone border cell still counts) */
 	bool palm_enabled;         /* palm-rejection on/off                */
 	u8   palm_area_threshold;  /* area >= this → palm                  */
 	s32  palm_signal_threshold;/* signal_sum >= this → palm            */
