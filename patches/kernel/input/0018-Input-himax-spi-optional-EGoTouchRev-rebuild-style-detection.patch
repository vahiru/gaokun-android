+	if (algo->edge_comp_mode == 1) {
+		if (algo->edge_comp_enabled)
+			hx_edge_stretch_contact(ct);
+	} else if (ct->is_edge) {
+		/* Push edge centroids outward toward physical sensor boundary */
+		hx_edge_compensate(algo, ct);
+	}
+	return true;
+}
