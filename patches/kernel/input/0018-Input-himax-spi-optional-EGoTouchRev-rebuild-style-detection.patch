+static void hx_split_contact(struct hx_algo *algo, int pi, s64 w_col,
+			     s64 w_row, s32 w_total, u16 area, s32 sig_sum)
+{
+	const struct hx_peak *pk = &algo->peaks[pi];
+	struct hx_contact ct;
+	u8 k, weakest = 0;
+
+	if (w_total > 0) {
+		ct.x = (s32)(w_col * 2 / w_total) + 0x80;
+		ct.y = (s32)(w_row * 2 / w_total) + 0x80;
+	} else {
+		ct.x = pk->c * 256 + 128;
+		ct.y = pk->r * 256 + 128;
+	}
+	ct.area = area;
+	ct.signal_sum = sig_sum;
+	ct.is_edge = (pk->r == 0 || pk->r == HX_ROWS - 1 ||
+		      pk->c == 0 || pk->c == HX_COLS - 1);
+	if (!hx_finish_contact(algo, pi, &ct))
+		return;
