+/*
+ * Close the zone map: an empty cell with at least three neighbours of one
+ * zone joins it, unless it then still borders an empty cell.  This only
+ * bridges gaps for the partition below.
+ */
+static void hx_split_close(struct hx_algo *algo)
+{
+	u16 n_cand = 0, n_new = 0, i;
+	int d;
+
+	memcpy(algo->split_prev, algo->zone_map, sizeof(algo->split_prev));
+	for (i = 0; i < algo->zone_cell_count; i++) {
+		int idx = algo->zone_cells[i];
+		int r = idx / HX_COLS, c = idx % HX_COLS;
+
+		for (d = 0; d < 8; d++) {
+			int nr = r + hx_dr[d], nc = c + hx_dc[d], ni;
+
+			if (nr < 0 || nr >= HX_ROWS || nc < 0 || nc >= HX_COLS)
+				continue;
+			ni = nr * HX_COLS + nc;
+			if (algo->split_prev[ni] || algo->split_mask[ni])
+				continue;
+			algo->split_mask[ni] = 1;
+			algo->split_cand[n_cand++] = ni;
+		}
+	}
+
+	for (i = 0; i < n_cand; i++) {
+		int idx = algo->split_cand[i];
+		int r = idx / HX_COLS, c = idx % HX_COLS;
+		u8 votes[HX_MAX_PEAKS + 1] = { 0 };
+		u8 best = 0, best_cnt = 0;
+
+		for (d = 0; d < 8; d++) {
+			int nr = r + hx_dr[d], nc = c + hx_dc[d];
+			u8 z;
+
+			if (nr < 0 || nr >= HX_ROWS || nc < 0 || nc >= HX_COLS)
+				continue;
+			z = algo->split_prev[nr * HX_COLS + nc];
+			if (!z || z > HX_MAX_PEAKS)
+				continue;
+			if (++votes[z] > best_cnt) {
+				best_cnt = votes[z];
+				best = z;
+			}
+		}
+		if (best_cnt >= 3) {
+			algo->zone_map[idx] = best;
+			algo->split_new[n_new++] = idx;
+		}
+	}
+
+	for (i = 0; i < n_new; i++) {
+		int idx = algo->split_new[i];
+		int r = idx / HX_COLS, c = idx % HX_COLS;
+
+		for (d = 0; d < 8; d++) {
+			int nr = r + hx_dr[d], nc = c + hx_dc[d];
+
+			if (nr < 0 || nr >= HX_ROWS || nc < 0 || nc >= HX_COLS)
+				continue;
+			if (!algo->zone_map[nr * HX_COLS + nc]) {
+				algo->zone_map[idx] = 0;
+				break;
+			}
+		}
+	}
+
+	for (i = 0; i < n_cand; i++)
+		algo->split_mask[algo->split_cand[i]] = 0;
+}
