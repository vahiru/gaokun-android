+/*
+ * Zone split (zone_split), after the EGoTouchRev service's zone expander.
+ *
+ * Peaks are taken weakest first.  Each one that no earlier zone has
+ * reached floods out over the cells at or above its expansion threshold
+ * and also claims the still-positive cells around them, which take no part
+ * in its centroid but stop other zones.  A stronger peak the flood reached
+ * is not grown again; it joins that zone.  A zone with one peak reports its
+ * centroid; a zone with several -- fingers close enough to merge -- is
+ * divided between them by a priority flood (cells are handed out from the
+ * highest signal down, each to the peak whose part reaches it first) and
+ * each part reports its own centroid.  Without it the weaker peak kept the
+ * centroid of the whole merged blob, pulled toward the other finger, and the
+ * stronger one fell back to a 3x3 centroid.
+ */
+static const int hx_dr[] = {-1, -1, -1, 0, 0, 1, 1, 1};
+static const int hx_dc[] = {-1,  0,  1, -1, 1, -1, 0, 1};
+
+static void hx_split_claim(struct hx_algo *algo, int idx, u8 zid)
+{
+	algo->zone_map[idx] = zid;
+	algo->zone_cells[algo->zone_cell_count++] = idx;
+}
+
+static void hx_split_add(struct hx_zone_unit *u, int r, int c, s16 sig)
+{
+	u->area++;
+	u->sig_sum += sig;
+	if (sig > 0) {
+		u->w_col += (s64)c * 128 * sig;
+		u->w_row += (s64)r * 128 * sig;
+		u->w_total += sig;
+	}
+}
+
+static void hx_split_flood(struct hx_algo *algo, int pi)
+{
+	const struct hx_peak *pk = &algo->peaks[pi];
+	struct hx_zone_unit *u = &algo->units[pi];
+	int seed = pk->r * HX_COLS + pk->c;
+	u16 head = 0, tail = 0;
+	u8 zid = pi + 1;
+
+	u->thold = hx_zone_thold(algo->peak_threshold, pk->z);
+	u->peaks[u->n_peaks++] = pi;
+	hx_split_claim(algo, seed, zid);
+	hx_split_add(u, pk->r, pk->c, pk->z);
+	algo->bfs_queue[tail++] = seed;
+
+	while (head != tail) {
+		int idx = algo->bfs_queue[head++];
+		int r = idx / HX_COLS, c = idx % HX_COLS, d;
+
+		for (d = 0; d < 8; d++) {
+			int nr = r + hx_dr[d], nc = c + hx_dc[d], ni;
+			s16 sig;
+
+			if (nr < 0 || nr >= HX_ROWS || nc < 0 || nc >= HX_COLS)
+				continue;
+			ni = nr * HX_COLS + nc;
+			if (algo->zone_map[ni])
+				continue;
+			sig = algo->frame[nr][nc];
+			if (sig >= u->thold) {
+				hx_split_claim(algo, ni, zid);
+				hx_split_add(u, nr, nc, sig);
+				algo->bfs_queue[tail++] = ni;
+			} else if (sig > 0) {
+				hx_split_claim(algo, ni, zid);
+			}
+		}
+	}
+}
