+static bool hx_finish_contact(struct hx_algo *algo, int pi,
+			      struct hx_contact *ct)
+{
+	/*
+	 * ct->area is measured at half the peak and so is roughly the same
+	 * for a fingertip and for a fragment of a palm (measured on the
+	 * panel: 8-20 vs 5-21 cells).  The macro-zone area at the absolute
+	 * threshold is the quantity that can tell them apart; carry it along
+	 * so the contact log can show it.
+	 */
+	ct->zone_area = algo->peaks[pi].zone_area;
+
+	/*
+	 * Per-contact palm test.  ct->area counts only cells at or above
+	 * half the peak, so it measures this contact rather than whatever
+	 * it happens to be connected to -- the right granularity for
+	 * telling a fingertip from the heel of a hand beside it.
+	 * 0 disables it, which is the shipped default.
+	 */
+	if (algo->palm_contact_area &&
+	    ct->area >= algo->palm_contact_area) {
+		algo->stats.rej_contact_area++;
+		return false;
+	}
