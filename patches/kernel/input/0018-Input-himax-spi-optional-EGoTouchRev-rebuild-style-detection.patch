+/*
+ * Priority-flood keys: signal first, then the lower owner, then the lower
+ * cell index, so the order matches the service's exactly.
+ */
+static inline u32 hx_split_key(s16 sig, u8 owner, int idx)
+{
+	return ((u32)(sig + 32768) << 16) | ((u32)(16 - owner) << 12) |
+	       (u32)(4095 - idx);
+}
+
+static void hx_split_push(struct hx_algo *algo, u16 *n, u32 key)
+{
+	u32 *h = algo->split_heap;
+	u16 i = (*n)++;
+
+	while (i > 0 && h[(i - 1) / 2] < key) {
+		h[i] = h[(i - 1) / 2];
+		i = (i - 1) / 2;
+	}
+	h[i] = key;
+}
+
+static u32 hx_split_pop(struct hx_algo *algo, u16 *n)
+{
+	u32 *h = algo->split_heap;
+	u32 top = h[0], last = h[--(*n)];
+	u16 i = 0;
+
+	for (;;) {
+		u16 l = 2 * i + 1, r = l + 1, big = i;
+		u32 v = last;
+
+		if (l < *n && h[l] > v) {
+			big = l;
+			v = h[l];
+		}
+		if (r < *n && h[r] > v)
+			big = r;
+		if (big == i)
+			break;
+		h[i] = h[big];
+		i = big;
+	}
+	if (*n)
+		h[i] = last;
+	return top;
+}
