@@ -88,8 +102,177 @@ void hx_algo_init_defaults(struct hx_algo *algo)
 /* Phase 1A — baseline subtraction                                          */
 /* ======================================================================== */
 
+/*
+ * Adaptive baseline (baseline_mode 1), after the EGoTouchRev service's
+ * BaselineTracker.
+ *
+ * Each cell tracks its own baseline in 1/256 units.  While the panel has a
+ * finger on it, the median of (raw - baseline) over the whole panel is taken
+ * as common-mode and removed; a cell that is then more than baseline_gate
+ * above its baseline passes through with its baseline frozen, and every
+ * other cell reads 0 while its baseline follows it -- slowly when it rises
+ * (temperature), faster when it falls (a lifting finger), and fast for the
+ * first frames of a touch or while nothing passes the gate (recovery), so a
+ * weak contact is absorbed rather than reported.  A cell that passed the
+ * gate is held for HX_BASE_HOLD frames after it drops below it: a sharp dip
+ * then passes through instead of being absorbed.  Without a finger every
+ * cell reads 0 and the baseline follows quickly.
+ *
+ * The firmware says whether it sees a finger; baseline_fw_finger decides
+ * whether to trust it.  Without it every frame is treated as touched, so
+ * there is no finger-off transition to start recovery from: recovery runs
+ * whenever nothing passed the gate the frame before, which also stands in
+ * for the fast no-finger tracking.  A cell that stays above the gate
+ * without a finger (a step in the panel's drift) is then never released;
+ * with the flag it is, the next time the firmware sees no finger.
+ *
+ * The baseline starts from the first frame rather than the service's
+ * fixed 0x7fee: without the flag there is no finger-free phase in which a
+ * cell whose idle level lies more than the gate above that could settle,
+ * and it would read as a touch from the start.  A finger on the panel at
+ * that moment is absorbed instead and reads negative once lifted.
+ *
+ * baseline_mode 2 runs the CMF on every cell before the gate instead of on
+ * the gated frame after it.  Coupled through a PC's USB ground, the panel
+ * carries row and column offsets that lift cells next to a finger over the
+ * gate; there the gated frame has nothing left to estimate them from.
+ */
+#define HX_BASE_DEADBAND	90	/* |delta| up to this is noise       */
+#define HX_BASE_NEG_DEADBAND	13	/* a held cell this far down passes  */
+#define HX_BASE_HOLD		60	/* frames                            */
+#define HX_BASE_RECOVERY	30	/* frames                            */
+
+static void hx_apply_cmf(struct hx_algo *algo);
+
+static void hx_base_update(struct hx_algo *algo, int i, s32 delta,
+			   int shift, s32 max_step)
+{
+	s32 step = (delta * 256) >> shift;
+
+	if (max_step > 0)
+		step = clamp_t(s32, step, -max_step * 256, max_step * 256);
+	algo->base_q8[i] = clamp_t(s32, algo->base_q8[i] + step, 0, 0xffff << 8);
+}
+
+/* The median of raw - baseline over the panel, clamped to the histogram. */
+static s32 hx_base_median(struct hx_algo *algo, const u16 *raw)
+{
+	int i, half = HX_BASE_HIST / 2;
+	u32 seen = 0;
+
+	memset(algo->base_hist, 0, sizeof(algo->base_hist));
+	for (i = 0; i < HX_PIXELS; i++) {
+		s32 d = (s32)le16_to_cpup(raw + i) - (algo->base_q8[i] >> 8);
+
+		algo->base_hist[clamp_t(s32, d + half, 0, HX_BASE_HIST - 1)]++;
+	}
+	for (i = 0; i < HX_BASE_HIST; i++) {
+		seen += algo->base_hist[i];
+		if (seen > HX_PIXELS / 2)
+			break;
+	}
+	return i - half;
+}
+
+static void hx_track_baseline(struct hx_algo *algo, const u16 *raw, u8 mode)
+{
+	bool finger = !algo->baseline_fw_finger || algo->fw_finger;
+	s16 *out = &algo->frame[0][0];
+	bool recovery = false, freeze = false;
+	s32 common;
+	int i;
+
+	if (!algo->base_init || algo->base_mode != mode) {
+		for (i = 0; i < HX_PIXELS; i++)
+			algo->base_q8[i] = (s32)le16_to_cpup(raw + i) << 8;
+		memset(algo->base_hold, 0, sizeof(algo->base_hold));
+		algo->base_prev_finger = false;
+		algo->base_had_freeze = false;
+		algo->base_recovery = 0;
+		algo->base_mode = mode;
+		algo->base_init = true;
+	}
+
+	if (!finger) {
+		for (i = 0; i < HX_PIXELS; i++) {
+			s32 delta = (s32)le16_to_cpup(raw + i) - (algo->base_q8[i] >> 8);
+
+			algo->base_hold[i] = 0;
+			if (abs(delta) > HX_BASE_DEADBAND)
+				hx_base_update(algo, i, delta, 3, 512);
+			else if (delta)
+				hx_base_update(algo, i, delta, 6, 1);
+			out[i] = 0;
+		}
+		algo->base_had_freeze = false;
+		algo->base_recovery = 0;
+		algo->base_prev_finger = false;
+		return;
+	}
+
+	/*
+	 * Recovery: a touch has just begun, or nothing passed the gate for
+	 * fewer than HX_BASE_RECOVERY frames into it.  Without the flag:
+	 * whenever nothing passed the gate last frame.
+	 */
+	if (!algo->baseline_fw_finger) {
+		recovery = !algo->base_had_freeze;
+	} else if (!algo->base_prev_finger) {
+		recovery = true;
+		algo->base_recovery = 0;
+	} else if (!algo->base_had_freeze) {
+		if (algo->base_recovery < U8_MAX)
+			algo->base_recovery++;
+		recovery = algo->base_recovery < HX_BASE_RECOVERY;
+	}
+
+	common = hx_base_median(algo, raw);
+	if (mode == 2) {
+		for (i = 0; i < HX_PIXELS; i++)
+			out[i] = clamp_t(s32, (s32)le16_to_cpup(raw + i) -
+					 (algo->base_q8[i] >> 8) - common,
+					 SHRT_MIN, SHRT_MAX);
+		out[0] = 0;
+		if (algo->cmf_enabled)
+			hx_apply_cmf(algo);
+	}
+	/* Cell 0 is not a real cell on this panel; it stays 0. */
+	out[0] = 0;
+	for (i = 1; i < HX_PIXELS; i++) {
+		s32 delta = (s32)le16_to_cpup(raw + i) - (algo->base_q8[i] >> 8);
+		s32 local = mode == 2 ? out[i] : delta - common;
+
+		if (local > algo->baseline_gate) {
+			/* Frozen: only follow the panel-wide shift. */
+			freeze = true;
+			algo->base_hold[i] = HX_BASE_HOLD;
+			if (common)
+				hx_base_update(algo, i, common, 3, 512);
+			out[i] = clamp_t(s32, local, SHRT_MIN, SHRT_MAX);
+			continue;
+		}
+		if (algo->base_hold[i]) {
+			algo->base_hold[i]--;
+			if (local < -HX_BASE_NEG_DEADBAND) {
+				out[i] = clamp_t(s32, local, SHRT_MIN, SHRT_MAX);
+				continue;
+			}
+		}
+		if (recovery)
+			hx_base_update(algo, i, delta, 2, 256);
+		else if (abs(delta) > HX_BASE_DEADBAND)
+			hx_base_update(algo, i, delta, delta > 0 ? 7 : 5, 20);
+		else if (delta)
+			hx_base_update(algo, i, delta, 6, 1);
+		out[i] = 0;
+	}
+	algo->base_had_freeze = freeze;
+	algo->base_prev_finger = true;
+}
+
 static void hx_prepare_frame_baseline(struct hx_algo *algo, const u16 *raw)
 {
+	u8 mode = READ_ONCE(algo->baseline_mode);
 	int r, c;
 
 	for (r = 0; r < HX_ROWS; r++) {
@@ -97,16 +280,25 @@ static void hx_prepare_frame_baseline(struct hx_algo *algo, const u16 *raw)
 			int idx = r * HX_COLS + c;
 			s32 sample = (s32)le16_to_cpup(raw + idx) - HX_BASELINE;
 
-			algo->frame[r][c] = clamp_t(s32, sample, SHRT_MIN, SHRT_MAX);
+			algo->raw_frame[r][c] = clamp_t(s32, sample, SHRT_MIN, SHRT_MAX);
 		}
 	}
 
 	/* pixel [0][0] is always invalid on this panel layout */
-	algo->frame[0][0] = 0;
+	algo->raw_frame[0][0] = 0;
 
-	/* Keep the untouched frame for the diagnostic dump; everything after
-	 * this point (CMF, edge boost, IIR) rewrites frame[] in place. */
-	memcpy(algo->raw_frame, algo->frame, sizeof(algo->frame));
