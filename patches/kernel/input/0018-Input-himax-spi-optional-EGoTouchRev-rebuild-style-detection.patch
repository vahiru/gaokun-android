+	/* With every slot taken, the contact with the least signal goes. */
+	if (algo->contact_count < HIMAX_MAX_TOUCH) {
+		algo->contacts[algo->contact_count++] = ct;
+		return;
+	}
+	for (k = 1; k < HIMAX_MAX_TOUCH; k++)
+		if (algo->contacts[k].signal_sum < algo->contacts[weakest].signal_sum)
+			weakest = k;
+	if (ct.signal_sum > algo->contacts[weakest].signal_sum)
+		algo->contacts[weakest] = ct;
+}
