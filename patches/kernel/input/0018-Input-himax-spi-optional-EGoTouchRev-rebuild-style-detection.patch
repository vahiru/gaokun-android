+		const struct hx_peak *a = &algo->peaks[i];
+
+		if (drop[i])
+			continue;
+		for (j = i + 1; j < algo->peak_count; j++) {
+			const struct hx_peak *b = &algo->peaks[j];
+			u8 weak;
+			s16 need;
+
+			if (drop[j] || a->zone_id != b->zone_id)
+				continue;
+			if (max(abs(a->r - b->r), abs(a->c - b->c)) > r)
+				continue;
