+static s16 hx_saddle(const struct hx_algo *algo, const struct hx_peak *a,
+		     const struct hx_peak *b)
+{
+	int dr = b->r - a->r, dc = b->c - a->c;
+	int steps = max(abs(dr), abs(dc));
+	s16 saddle = 0;
+	int k;
+
+	for (k = 1; k < steps; k++) {
+		int nr = a->r + DIV_ROUND_CLOSEST(dr * k, steps);
+		int nc = a->c + DIV_ROUND_CLOSEST(dc * k, steps);
+
+		if ((nr == a->r && nc == a->c) || (nr == b->r && nc == b->c))
+			continue;
+		saddle = max(saddle, hx_frame_at(algo, nr, nc));
+	}
+	return saddle;
