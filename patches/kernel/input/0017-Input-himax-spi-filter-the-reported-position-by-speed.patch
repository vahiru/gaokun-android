+/*
+ * Position filter: a One Euro filter (Casiez et al., CHI 2012) per track.
+ *
+ * Without smoothing the centroid wobbles by a few units from frame to
+ * frame, which shows as a shaking point during a slow slide, worse on
+ * battery where the signal is weaker.  track_smoothing's fixed 1/4 step
+ * steadies it but lags about three frames at every speed, which blunts
+ * flicks.  This filter's cutoff rises with speed instead:
+ *
+ *	cutoff = mincutoff + beta * speed
+ *
+ * so a slow slide is smoothed hard and a flick passes almost as measured.
+ * The velocity is how far the measurement is from the filtered position,
+ * per second, low-passed per axis at dcutoff; the speed is its magnitude.
+ * Matching and prediction keep using x/y;
+ * only the reported position is filtered.  It starts on the down position,
+ * so a touch-down is reported without lag.
+ */
+#define HX_FILTER_HZ		120	/* frames per second while touched */
+#define HX_FILTER_MAX_MHZ	10000000
+
+/* One frame of a first-order low-pass at @mhz: w / (1 + w), w = 2 pi f / rate, Q16. */
+static u32 hx_filter_alpha(s64 mhz)
+{
+	u64 w = (u64)clamp_t(s64, mhz, 0, HX_FILTER_MAX_MHZ) * 6283;
+
+	return div64_u64(w << 16, w + (u64)HX_FILTER_HZ * 1000000);
+}
+
+static void hx_filter_reset(struct hx_track *trk)
+{
+	trk->fx = trk->x << 8;
+	trk->fy = trk->y << 8;
+	trk->fvx = 0;
+	trk->fvy = 0;
+}
+
+static void hx_filter_update(const struct hx_algo *algo, struct hx_track *trk)
+{
+	s32 ex = (trk->x << 8) - trk->fx;
+	s32 ey = (trk->y << 8) - trk->fy;
+	u32 speed, a;
+
+	if (algo->track_filter_mincutoff <= 0) {
+		/* Off: follow the measurement, so turning it on does not jump. */
+		hx_filter_reset(trk);
+		return;
+	}
+	a = hx_filter_alpha(algo->track_filter_dcutoff);
+	trk->fvx += ((s64)a * (((s64)ex * HX_FILTER_HZ >> 8) - trk->fvx)) >> 16;
+	trk->fvy += ((s64)a * (((s64)ey * HX_FILTER_HZ >> 8) - trk->fvy)) >> 16;
+	speed = int_sqrt64((s64)trk->fvx * trk->fvx + (s64)trk->fvy * trk->fvy);
+	a = hx_filter_alpha(algo->track_filter_mincutoff +
+			    (s64)max(algo->track_filter_beta, 0) * speed);
+	trk->fx += ((s64)a * ex + (1 << 15)) >> 16;
+	trk->fy += ((s64)a * ey + (1 << 15)) >> 16;
+}
+
 void hx_track_contacts(struct hx_algo *algo,
 		       struct input_mt_pos *det, int det_cnt)
 {
@@ -1549,15 +1610,19 @@ void hx_track_contacts(struct hx_algo *algo,
 			if (trk->debounce == 0) {
