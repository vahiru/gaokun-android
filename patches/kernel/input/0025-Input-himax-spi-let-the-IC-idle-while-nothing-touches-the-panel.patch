+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * What the two HX83121A drivers on the HUAWEI MateBook E Go share.  The
+ * master (himax-spi, finger touch) and the cascade slave (himax_hx83121a_pen,
+ * active pen) are one controller, so the master's IDLE request also slows
+ * the slave's frames, and the master must not ask for IDLE while the pen is
+ * in use.
+ */
+#ifndef _HIMAX_CASCADE_H
+#define _HIMAX_CASCADE_H
+
+#include <linux/types.h>
+
+/*
+ * True while the master's frames say IDLE, and from its first enter-IDLE
+ * request until the panel is touched, the IC scans normally again or the
+ * master starts its wait over; false after every init.
+ */
+bool himax_hx83121a_ic_idle(void);
+
+/* The pen is in use: the master does not ask for IDLE for a while. */
+void himax_hx83121a_pen_active(void);
+
+#endif
