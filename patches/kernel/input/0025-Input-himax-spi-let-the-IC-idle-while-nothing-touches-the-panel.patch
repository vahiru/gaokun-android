+/* One HX83121A cascade per machine: this state is not per device. */
+static atomic_t himax_cascade_idle = ATOMIC_INIT(0);
+static atomic_long_t himax_cascade_pen_seen = ATOMIC_LONG_INIT(0);	/* jiffies, 0 = never */
+
+bool himax_hx83121a_ic_idle(void)
+{
+	return atomic_read(&himax_cascade_idle);
+}
+EXPORT_SYMBOL_GPL(himax_hx83121a_ic_idle);
+
+void himax_hx83121a_pen_active(void)
+{
+	atomic_long_set(&himax_cascade_pen_seen, jiffies | 1);
+}
+EXPORT_SYMBOL_GPL(himax_hx83121a_pen_active);
+
+/*
+ * The firmware takes commands through a mailbox of five 16-byte slots, used in
+ * turn: A8 8A, the command, 00, its parameter, and in the last word the 16-bit
+ * value that makes the eight little-endian words sum to zero.  The slot is
+ * written with its first two bytes zeroed, then the four-byte header, which
+ * hands it over, and read back; only then is the next slot used.  The
+ * vendor's Windows driver clears the slots and the write pointer at every
+ * start, before its reset; here it is done once the firmware runs again.
+ */
+#define HIMAX_CMD_SLOT_ADDR		0x10007550
+#define HIMAX_CMD_SLOTS			5
+#define HIMAX_CMD_PTR_ADDR		0x1000753c
+#define HIMAX_CMD_ENTER_IDLE		0x0a
+/* Status word 0 is 1 while the IC scans in IDLE. */
+#define HIMAX_STATUS_IDLE		0
+
+static int himax_cmd_clear(struct himax_ts_data *ts)
+{
+	u8 zero[HIMAX_CMD_SLOTS * 16] = { 0 };
+	int ret;
+
+	ret = himax_mcu_register_write(ts, HIMAX_CMD_SLOT_ADDR, zero, sizeof(zero));
+	if (!ret)
+		ret = himax_mcu_register_write(ts, HIMAX_CMD_PTR_ADDR, zero, HIMAX_REG_SZ);
+	return ret;
+}
+
+static int himax_send_command(struct himax_ts_data *ts, u8 cmd, u8 param)
+{
+	u32 addr = HIMAX_CMD_SLOT_ADDR + 16 * ts->cmd_slot;
+	u8 pkt[16] = { 0xa8, 0x8a, cmd, 0, param };
+	u8 back[16];
+	u32 sum = 0;
+	int i, ret;
+
+	for (i = 0; i < 14; i += 2)
+		sum += get_unaligned_le16(pkt + i);
+	put_unaligned_le16(-sum, pkt + 14);
+	pkt[0] = 0;
+	pkt[1] = 0;
+	ret = himax_mcu_register_write(ts, addr, pkt, sizeof(pkt));
+	if (!ret) {
+		pkt[0] = 0xa8;
+		pkt[1] = 0x8a;
+		ret = himax_mcu_register_write(ts, addr, pkt, HIMAX_REG_SZ);
+	}
+	if (!ret)
+		ret = himax_mcu_register_read(ts, addr, back, sizeof(back));
+	if (ret) {
+		dev_warn_ratelimited(ts->dev, "command %#x failed: %d\n", cmd, ret);
+		return ret;
+	}
+	ts->cmd_slot = (ts->cmd_slot + 1) % HIMAX_CMD_SLOTS;
+	return 0;
+}
+
+/*
+ * IDLE: with nothing on the panel for idle_ms the IC is asked to drop to its
+ * slow IDLE scan, in which it sends a frame every three seconds or so and
+ * wakes up by itself when a finger or the pen comes.  A frame is quiet
+ * without a zone, a track or the firmware's finger flag.  The pen leaves no
+ * trace in the master's frames, so the slave's driver reports pen use, and
+ * for HIMAX_PEN_IDLE_HOLD_MS after it IDLE is not requested, as by the
+ * vendor's Windows software.
+ *
+ * While the IC keeps scanning, enter-IDLE is sent again every
+ * HIMAX_IDLE_RETRY_MS, HIMAX_IDLE_MAX_REQUESTS times in all.  If the IC still
+ * scans HIMAX_IDLE_GIVE_UP_MS after the last one, or wakes up again with
+ * nothing on the panel, the wait starts over and it is asked again idle_ms
+ * later.  Times rather than frame counts, so this holds at any scan rate.
+ *
+ * The pen driver is told IDLE while the frames say so, and from the first
+ * enter-IDLE on (the slave slows down at once, while the master can send a
+ * few more frames as before) until the panel is touched, the IC wakes up or
+ * the wait starts over.
+ */
+#define HIMAX_PEN_IDLE_HOLD_MS		3000
+#define HIMAX_IDLE_RETRY_MS		100
+#define HIMAX_IDLE_MAX_REQUESTS		8
+#define HIMAX_IDLE_GIVE_UP_MS		1000
+
+static void himax_idle_set(struct himax_ts_data *ts, u8 state)
+{
+	ts->idle_state = state;
+	atomic_set(&himax_cascade_idle, ts->ic_idle || state >= HIMAX_IDLE_ASKED);
+}
+
+/* Every init resets the IC: it scans again, and commands start at slot 0. */
+static void himax_idle_reset(struct himax_ts_data *ts)
+{
+	ts->cmd_slot = 0;
+	ts->idle_requests = 0;
+	ts->ic_idle = false;
+	himax_idle_set(ts, HIMAX_IDLE_BUSY);
+}
+
+/* Restart the wait for idle_ms of quiet frames from now. */
+static void himax_idle_wait(struct himax_ts_data *ts, s32 ms)
+{
+	ts->idle_requests = 0;
+	ts->idle_at = jiffies + msecs_to_jiffies(ms);
+	himax_idle_set(ts, HIMAX_IDLE_WAIT);
+}
+
+static void himax_idle_update(struct himax_ts_data *ts, bool idle, bool quiet)
+{
+	struct hx_algo *algo = ts->algo;
+	unsigned long pen = atomic_long_read(&himax_cascade_pen_seen);
+	s32 ms = algo->idle_ms;
+	unsigned int next;
+
+	ts->ic_idle = idle;
+	if (idle)
+		algo->stats.idle_frames++;
+	if (pen && time_before(jiffies, pen + msecs_to_jiffies(HIMAX_PEN_IDLE_HOLD_MS)))
+		quiet = false;
+	if (!quiet) {
+		himax_idle_set(ts, HIMAX_IDLE_BUSY);
+		return;
+	}
+	if (idle) {
+		himax_idle_set(ts, HIMAX_IDLE_ON);
+		return;
+	}
+	if (ms <= 0) {
+		himax_idle_set(ts, HIMAX_IDLE_BUSY);
+		return;
+	}
+	/* quiet and scanning: just quiet, or awake again by itself */
+	if (ts->idle_state == HIMAX_IDLE_BUSY || ts->idle_state == HIMAX_IDLE_ON) {
+		himax_idle_wait(ts, ms);
+		return;
+	}
+	if (time_before(jiffies, ts->idle_at))
+		return;
+	if (ts->idle_requests >= HIMAX_IDLE_MAX_REQUESTS) {
+		himax_idle_wait(ts, ms);
+		return;
+	}
+	ts->idle_requests++;
+	next = ts->idle_requests < HIMAX_IDLE_MAX_REQUESTS ?
+	       HIMAX_IDLE_RETRY_MS : HIMAX_IDLE_GIVE_UP_MS;
+	ts->idle_at = jiffies + msecs_to_jiffies(next);
+	if (himax_send_command(ts, HIMAX_CMD_ENTER_IDLE, 0))
+		return;
+	algo->stats.idle_cmds++;
+	himax_idle_set(ts, HIMAX_IDLE_ASKED);
+}
+
 static void himax_report_tracked_state(struct himax_ts_data *ts, bool report_on)
 {
 	s32 x, y;
@@ -1633,6 +1828,15 @@ static irqreturn_t himax_ts_thread(int irq, void *data)
 	/* 这里报告给系统的坐标数据可以通过 evtest 查看 */
 	himax_report_tracked_state(ts, report_on);
 
+	{
+		bool idle = himax_frame_status(ts->event_buf, HIMAX_STATUS_IDLE) == 1;
+		bool quiet = !algo->fw_finger && !algo->zone_count;
+
+		for (int i = 0; i < HIMAX_MAX_TOUCH && quiet; i++)
+			quiet = !algo->tracks[i].active;
+		himax_idle_update(ts, idle, quiet);
+	}
+
 out_unlock:
 	mutex_unlock(&ts->op_lock);
 	return irq_ret;
