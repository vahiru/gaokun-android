+/*
+ * While himax-spi has put the IC in IDLE the slave sends a frame only every
+ * three seconds or so (once 6 s, at IDLE entry), so neither a read without
+ * a new frame nor a second without one means trouble then, as long as
+ * frames still come at all: a slave that a master reset took down sends
+ * none, and is re-initialised once IDLE_FRAME_GAP has passed without one.
+ */
+#define IDLE_FRAME_GAP		msecs_to_jiffies(10000)
+
+static bool pen_ic_idle(struct gk3_pen *p)
+{
+	return himax_hx83121a_ic_idle() &&
+	       time_before(jiffies, p->hdr_seen + IDLE_FRAME_GAP);
+}
+
+/* Frames from before a master reset say nothing about the slave after it. */
+static void pen_forget_frames(struct gk3_pen *p)
+{
+	p->hdr_seen = jiffies - IDLE_FRAME_GAP;
+}
