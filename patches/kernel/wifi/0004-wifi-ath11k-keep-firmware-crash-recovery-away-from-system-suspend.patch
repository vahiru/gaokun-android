From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] wifi: ath11k: keep firmware crash recovery away from system suspend

A firmware crash recovery resets the device: ath11k_core_reset() powers
it down and up, and the restart then rebuilds the driver state. Nothing
keeps that apart from system suspend and resume, which power the device
down and up as well. With WoWLAN the firmware also runs, and can crash,
while the system sleeps.

When the firmware crashed while the system suspended, the reset ran
alongside the suspend and resume callbacks. On a WCN6855 this left the
device unreachable until reboot:

  ath11k_pci 0006:01:00.0: firmware crashed: MHI_CB_EE_RDDM
  ...
  mhi mhi0: MHI did not load AMSS, ret:-5
  ...
  mhi mhi0: Device link is not accessible
  mhi mhi0: MHI did not enter READY state
  ath11k_pci 0006:01:00.0: failed to power up hif during resume: -110
  ath11k_pci 0006:01:00.0: timeout while waiting for restart complete

and every later resume waited for both timeouts, about 40 seconds. The
suspend before that spent a minute on WMI commands to the crashed
firmware, each waiting for its timeout. When the crash was only noticed
in ath11k_wow_op_resume(), mac80211 failed to start the device again and
closed the interfaces, and the reset that followed found the interrupts
still disabled from the WoW suspend, so its restart timed out connecting
to the firmware.

Mark the firmware as gone (ATH11K_FLAG_CRASH_FLUSH) as soon as the crash
is reported, so that commands to it fail at once, and stop waiting for
transmit completions then.

From PM_SUSPEND_PREPARE until PM_POST_SUSPEND, do not reset the device:
until the resume has completed, the MHI devices that carry QMI after a
power up are not even probed. Leave the crash pending instead. A resume
from a powered down suspend reloads the firmware anyway. With WoWLAN,
report the WoW suspend and resume as done, so that mac80211 keeps the
device configured, only quiesce the device, and enable its interrupts
again on resume; the reset at PM_POST_SUSPEND then restarts it as after
any other crash.

When not suspending, reset the device as before, and keep the system
awake until the recovery completes, for at most
ATH11K_RECOVERY_WAKEUP_MS, so that a suspend does not run into it.

Tested-on: WCN6855 hw2.1 PCI WLAN.HSP.1.1-03125-QCAHSPSWPL_V1_V2_SILICONZ_LITE-3.6510.41

Assisted-by: Claude:claude-opus-5-5
---
 drivers/net/wireless/ath/ath11k/core.c    | 67 +++++++++++++++++++++++
 drivers/net/wireless/ath/ath11k/core.h    |  8 +++
 drivers/net/wireless/ath/ath11k/debugfs.c |  2 +-
 drivers/net/wireless/ath/ath11k/mac.c     |  8 ++-
 drivers/net/wireless/ath/ath11k/mhi.c     |  2 +-
 drivers/net/wireless/ath/ath11k/wow.c     | 54 +++++++++++++++++-
 6 files changed, 136 insertions(+), 5 deletions(-)

diff --git a/drivers/net/wireless/ath/ath11k/core.c b/drivers/net/wireless/ath/ath11k/core.c
index 0a74791..1a22d9c 100644
--- a/drivers/net/wireless/ath/ath11k/core.c
+++ b/drivers/net/wireless/ath/ath11k/core.c
@@ -1310,6 +1310,8 @@ int ath11k_core_resume_early(struct ath11k_base *ab)
 		return 0;
 
 	reinit_completion(&ab->restart_completed);
+	/* This reloads the firmware: a crash during the suspend is recovered. */
+	clear_bit(ATH11K_FLAG_CRASH_PENDING, &ab->dev_flags);
 	ret = ath11k_hif_power_up(ab);
 	if (ret)
 		ath11k_warn(ab, "failed to power up hif during resume: %d\n", ret);
@@ -2530,6 +2532,9 @@ static void ath11k_core_restart(struct work_struct *work)
 	struct ath11k_base *ab = container_of(work, struct ath11k_base, restart_work);
 	int ret;
 
+	if (ab->is_reset)
+		pm_wakeup_ws_event(ab->recovery_ws, ATH11K_RECOVERY_WAKEUP_MS, false);
+
 	ret = ath11k_core_reconfigure_on_crash(ab);
 	if (ret) {
 		ath11k_err(ab, "failed to reconfigure driver on crash recovery\n");
@@ -2556,6 +2561,8 @@ static void ath11k_core_reset(struct work_struct *work)
 		return;
 	}
 
+	pm_wakeup_ws_event(ab->recovery_ws, ATH11K_RECOVERY_WAKEUP_MS, false);
+
 	/* Sometimes the recovery will fail and then the next all recovery fail,
 	 * this is to avoid infinite recovery since it can not recovery success.
 	 */
@@ -2619,6 +2626,51 @@ static void ath11k_core_reset(struct work_struct *work)
 	ath11k_dbg(ab, ATH11K_DBG_BOOT, "reset started\n");
 }
 
+static void ath11k_core_queue_reset(struct ath11k_base *ab)
+{
+	/* Keep the system awake until the recovery completes. */
+	pm_wakeup_ws_event(ab->recovery_ws, ATH11K_RECOVERY_WAKEUP_MS, false);
+	queue_work(ab->workqueue_aux, &ab->reset_work);
+}
+
+/*
+ * Called when the firmware crashed. Commands to it fail at once from here
+ * on, instead of each waiting for its timeout.
+ *
+ * During a system suspend or resume, a reset would power the device down and
+ * up alongside the suspend and resume callbacks, which can leave the device
+ * unreachable, and the firmware could not come up before the resume has
+ * completed anyway. So the reset waits for PM_POST_SUSPEND, unless a resume
+ * from a powered down suspend reloads the firmware first. Meanwhile
+ * mac80211 keeps the device configured (see ath11k_wow_op_suspend()), and
+ * the reset restarts it as after any other crash.
+ */
+void ath11k_core_schedule_reset(struct ath11k_base *ab)
+{
+	struct ath11k *ar;
+	int i;
+
+	set_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags);
+	wake_up(&ab->wmi_ab.tx_credits_wq);
+	for (i = 0; i < ab->num_radios; i++) {
+		ar = ab->pdevs[i].ar;
+		if (!ar)
+			continue;
+		wake_up(&ar->dp.tx_empty_waitq);
+		wake_up(&ar->txmgmt_empty_waitq);
+	}
+
+	set_bit(ATH11K_FLAG_CRASH_PENDING, &ab->dev_flags);
+	/* Pairs with the barrier in ath11k_core_pm_notify(). */
+	smp_mb__after_atomic();
+	if (test_bit(ATH11K_FLAG_SYSTEM_SUSPEND, &ab->dev_flags))
+		return;
+
+	if (test_and_clear_bit(ATH11K_FLAG_CRASH_PENDING, &ab->dev_flags))
+		ath11k_core_queue_reset(ab);
+}
+EXPORT_SYMBOL(ath11k_core_schedule_reset);
+
 static int ath11k_init_hw_params(struct ath11k_base *ab)
 {
 	const struct ath11k_hw_params *hw_params = NULL;
@@ -2672,9 +2724,20 @@ static int ath11k_core_pm_notify(struct notifier_block *nb,
 	switch (action) {
 	case PM_SUSPEND_PREPARE:
 		ab->actual_pm_policy = ab->pm_policy;
+		set_bit(ATH11K_FLAG_SYSTEM_SUSPEND, &ab->dev_flags);
 		break;
 	case PM_HIBERNATION_PREPARE:
 		ab->actual_pm_policy = ATH11K_PM_DEFAULT;
+		set_bit(ATH11K_FLAG_SYSTEM_SUSPEND, &ab->dev_flags);
+		break;
+	case PM_POST_SUSPEND:
+	case PM_POST_HIBERNATION:
+		clear_bit(ATH11K_FLAG_SYSTEM_SUSPEND, &ab->dev_flags);
+		/* Pairs with the barrier in ath11k_core_schedule_reset(). */
+		smp_mb__after_atomic();
+		/* A crash during the suspend that nothing recovered yet */
+		if (test_and_clear_bit(ATH11K_FLAG_CRASH_PENDING, &ab->dev_flags))
+			ath11k_core_queue_reset(ab);
 		break;
 	default:
 		break;
@@ -2754,6 +2817,7 @@ void ath11k_core_free(struct ath11k_base *ab)
 {
 	destroy_workqueue(ab->workqueue_aux);
 	destroy_workqueue(ab->workqueue);
+	wakeup_source_unregister(ab->recovery_ws);
 
 	kfree(ab);
 }
@@ -2778,6 +2842,9 @@ struct ath11k_base *ath11k_core_alloc(struct device *dev, size_t priv_size,
 	if (!ab->workqueue_aux)
 		goto err_free_wq;
 
+	/* Without it recovery still works, just without holding off suspend. */
+	ab->recovery_ws = wakeup_source_register(dev, "ath11k_recovery");
+
 	mutex_init(&ab->core_lock);
 	mutex_init(&ab->tbl_mtx_lock);
 	spin_lock_init(&ab->base_lock);
diff --git a/drivers/net/wireless/ath/ath11k/core.h b/drivers/net/wireless/ath/ath11k/core.h
index a0d7259..49e032f 100644
--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -17,6 +17,7 @@
 #include <linux/average.h>
 #include <linux/firmware.h>
 #include <linux/suspend.h>
+#include <linux/pm_wakeup.h>
 #include <linux/of.h>
 
 #include "qmi.h"
@@ -70,6 +71,7 @@ extern bool ath11k_ftm_mode;
 #define ATH11K_RESET_FAIL_TIMEOUT_HZ (20 * HZ)
 #define ATH11K_RECONFIGURE_TIMEOUT_HZ (10 * HZ)
 #define ATH11K_RECOVER_START_TIMEOUT_HZ (20 * HZ)
+#define ATH11K_RECOVERY_WAKEUP_MS (60 * MSEC_PER_SEC)
 
 enum ath11k_supported_bw {
 	ATH11K_BW_20	= 0,
@@ -288,6 +290,10 @@ enum ath11k_dev_flags {
 	ATH11K_FLAG_DEVICE_INIT_DONE,
 	ATH11K_FLAG_MULTI_MSI_VECTORS,
 	ATH11K_FLAG_FTM_SEGMENTED,
+	/* from PM_SUSPEND_PREPARE until PM_POST_SUSPEND (or hibernation) */
+	ATH11K_FLAG_SYSTEM_SUSPEND,
+	/* the firmware crashed during a system suspend, not recovered yet */
+	ATH11K_FLAG_CRASH_PENDING,
 };
 
 enum ath11k_monitor_flags {
@@ -1020,6 +1026,7 @@ struct ath11k_base {
 	struct work_struct update_11d_work;
 	u8 new_alpha2[3];
 	struct workqueue_struct *workqueue_aux;
+	struct wakeup_source *recovery_ws;
 	struct work_struct reset_work;
 	atomic_t reset_count;
 	atomic_t recovery_count;
@@ -1288,6 +1295,7 @@ int ath11k_core_resume(struct ath11k_base *ab);
 int ath11k_core_suspend(struct ath11k_base *ab);
 int ath11k_core_suspend_late(struct ath11k_base *ab);
 void ath11k_core_pre_reconfigure_recovery(struct ath11k_base *ab);
+void ath11k_core_schedule_reset(struct ath11k_base *ab);
 bool ath11k_core_coldboot_cal_support(struct ath11k_base *ab);
 
 const struct firmware *ath11k_core_firmware_request(struct ath11k_base *ab,
diff --git a/drivers/net/wireless/ath/ath11k/debugfs.c b/drivers/net/wireless/ath/ath11k/debugfs.c
index 7092261..fba86cc 100644
--- a/drivers/net/wireless/ath/ath11k/debugfs.c
+++ b/drivers/net/wireless/ath/ath11k/debugfs.c
@@ -410,7 +410,7 @@ static ssize_t ath11k_write_simulate_fw_crash(struct file *file,
 						   ATH11K_WMI_FW_HANG_DELAY);
 	} else if (!strcmp(buf, "hw-restart")) {
 		ath11k_info(ab, "user requested hw restart\n");
-		queue_work(ab->workqueue_aux, &ab->reset_work);
+		ath11k_core_schedule_reset(ab);
 		ret = 0;
 	} else {
 		ret = -EINVAL;
diff --git a/drivers/net/wireless/ath/ath11k/mac.c b/drivers/net/wireless/ath/ath11k/mac.c
index ae91b57..3360299 100644
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -8629,8 +8629,10 @@ static int ath11k_mac_flush_tx_complete(struct ath11k *ar)
 	long time_left;
 	int ret = 0;
 
+	/* Nothing completes once the firmware has crashed. */
 	time_left = wait_event_timeout(ar->dp.tx_empty_waitq,
-				       (atomic_read(&ar->dp.num_tx_pending) == 0),
+				       (atomic_read(&ar->dp.num_tx_pending) == 0) ||
+				       test_bit(ATH11K_FLAG_CRASH_FLUSH, &ar->ab->dev_flags),
 				       ATH11K_FLUSH_TIMEOUT);
 	if (time_left == 0) {
 		ath11k_warn(ar->ab, "failed to flush transmit queue, data pkts pending %d\n",
@@ -8639,7 +8641,8 @@ static int ath11k_mac_flush_tx_complete(struct ath11k *ar)
 	}
 
 	time_left = wait_event_timeout(ar->txmgmt_empty_waitq,
-				       (atomic_read(&ar->num_pending_mgmt_tx) == 0),
+				       (atomic_read(&ar->num_pending_mgmt_tx) == 0) ||
+				       test_bit(ATH11K_FLAG_CRASH_FLUSH, &ar->ab->dev_flags),
 				       ATH11K_FLUSH_TIMEOUT);
 	if (time_left == 0) {
 		ath11k_warn(ar->ab, "failed to flush mgmt transmit queue, mgmt pkts pending %d\n",
@@ -9290,6 +9293,7 @@ ath11k_mac_op_reconfig_complete(struct ieee80211_hw *hw,
 				complete(&ab->reset_complete);
 				ab->is_reset = false;
 				atomic_set(&ab->fail_cont_count, 0);
+				__pm_relax(ab->recovery_ws);
 				ath11k_dbg(ab, ATH11K_DBG_BOOT, "reset success\n");
 			}
 		}
diff --git a/drivers/net/wireless/ath/ath11k/mhi.c b/drivers/net/wireless/ath/ath11k/mhi.c
index e678a23..a12382e 100644
--- a/drivers/net/wireless/ath/ath11k/mhi.c
+++ b/drivers/net/wireless/ath/ath11k/mhi.c
@@ -284,7 +284,7 @@ static void ath11k_mhi_op_status_cb(struct mhi_controller *mhi_cntrl,
 
 		spin_lock_bh(&ab->base_lock);
 		if (!(test_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags)))
-			queue_work(ab->workqueue_aux, &ab->reset_work);
+			ath11k_core_schedule_reset(ab);
 		spin_unlock_bh(&ab->base_lock);
 
 		break;
diff --git a/drivers/net/wireless/ath/ath11k/wow.c b/drivers/net/wireless/ath/ath11k/wow.c
index 655a2e8..7f594c8 100644
--- a/drivers/net/wireless/ath/ath11k/wow.c
+++ b/drivers/net/wireless/ath/ath11k/wow.c
@@ -671,6 +671,41 @@ static int ath11k_wow_set_keepalive(struct ath11k *ar,
 	return 0;
 }
 
+/*
+ * The firmware crashed during the system suspend, and the device is reset
+ * once the system has resumed (see ath11k_core_schedule_reset()). Suspending
+ * without WoW instead would have mac80211 stop the device, and starting it
+ * again on resume fails. So only quiesce the device and report WoW as set.
+ */
+static void ath11k_wow_suspend_crashed(struct ath11k *ar)
+{
+	struct ath11k_base *ab = ar->ab;
+
+	timer_delete_sync(&ab->mon_reap_timer);
+	ath11k_ce_stop_shadow_timers(ab);
+	ath11k_dp_stop_shadow_timers(ab);
+
+	/* They are off already if the suspend failed at ath11k_hif_suspend(). */
+	if (test_bit(ATH11K_FLAG_EXT_IRQ_ENABLED, &ab->dev_flags))
+		ath11k_hif_irq_disable(ab);
+	if (test_bit(ATH11K_FLAG_CE_IRQ_ENABLED, &ab->dev_flags))
+		ath11k_hif_ce_irq_disable(ab);
+}
+
+/*
+ * The reset disables the interrupts and the restart enables them again, so
+ * it needs them enabled to start with: undo the suspend's disabling.
+ */
+static void ath11k_wow_resume_crashed(struct ath11k *ar)
+{
+	struct ath11k_base *ab = ar->ab;
+
+	if (!test_bit(ATH11K_FLAG_CE_IRQ_ENABLED, &ab->dev_flags))
+		ath11k_hif_ce_irq_enable(ab);
+	if (!test_bit(ATH11K_FLAG_EXT_IRQ_ENABLED, &ab->dev_flags))
+		ath11k_hif_irq_enable(ab);
+}
+
 int ath11k_wow_op_suspend(struct ieee80211_hw *hw,
 			  struct cfg80211_wowlan *wowlan)
 {
@@ -776,6 +811,12 @@ cleanup:
 	ath11k_wow_cleanup(ar);
 
 exit:
+	if (ret && test_bit(ATH11K_FLAG_CRASH_PENDING, &ar->ab->dev_flags)) {
+		ath11k_warn(ar->ab, "firmware crashed, suspending to restart it on resume\n");
+		ath11k_wow_suspend_crashed(ar);
+		ret = 0;
+	}
+
 	mutex_unlock(&ar->conf_mutex);
 	return ret ? 1 : 0;
 }
@@ -792,10 +833,14 @@ void ath11k_wow_op_set_wakeup(struct ieee80211_hw *hw, bool enabled)
 int ath11k_wow_op_resume(struct ieee80211_hw *hw)
 {
 	struct ath11k *ar = hw->priv;
-	int ret;
+	int ret = 0;
 
 	mutex_lock(&ar->conf_mutex);
 
+	/* A crashed device is restarted by the reset after resume. */
+	if (test_bit(ATH11K_FLAG_CRASH_PENDING, &ar->ab->dev_flags))
+		goto exit;
+
 	ret = ath11k_hif_resume(ar->ab);
 	if (ret) {
 		ath11k_warn(ar->ab, "failed to resume hif: %d\n", ret);
@@ -845,6 +890,13 @@ int ath11k_wow_op_resume(struct ieee80211_hw *hw)
 	}
 
 exit:
+	/* So is one that crashed during the sleep and was noticed just now. */
+	if (test_bit(ATH11K_FLAG_CRASH_PENDING, &ar->ab->dev_flags)) {
+		ath11k_warn(ar->ab, "firmware crashed, restarting it after resume\n");
+		ath11k_wow_resume_crashed(ar);
+		ret = 0;
+	}
+
 	if (ret) {
 		switch (ar->state) {
 		case ATH11K_STATE_ON:
