From: Vahiru <nekovahiru@gmail.com>
Subject: [PATCH] media: iris: return -EINVAL on decoder CAPTURE G_FMT before first SOURCE_CHANGE

Android's v4l2_codec2 HAL expects the venus stateful decoder behaviour where
VIDIOC_G_FMT on the CAPTURE queue returns -EINVAL until the initial
V4L2_EVENT_SOURCE_CHANGE event has been generated, deferring output queue
allocation until the stream dimensions are known.

Return -EINVAL from CAPTURE G_FMT on decoder instances that have subscribed to
V4L2_EVENT_SOURCE_CHANGE and have not yet received the first source-change
event, controlled by the module parameter qcom_iris.venus_compat_gfmt (default
true).

Origin: local
Upstream-Status: Inappropriate [Android v4l2_codec2 workaround]
---
diff --git a/drivers/media/platform/qcom/iris/iris_instance.h b/drivers/media/platform/qcom/iris/iris_instance.h
index a770331..814b608 100644
--- a/drivers/media/platform/qcom/iris/iris_instance.h
+++ b/drivers/media/platform/qcom/iris/iris_instance.h
@@ -114,6 +114,8 @@ struct iris_inst {
 	u32				metadata_idx;
 	u32				codec;
 	bool				last_buffer_dequeued;
+	bool				src_change_subscribed;
+	bool				seq_event_seen;
 	u64				last_buf_ns;
 	u32				frame_counter;
 	u32				frame_rate;
diff --git a/drivers/media/platform/qcom/iris/iris_vdec.c b/drivers/media/platform/qcom/iris/iris_vdec.c
index 9e228b7..d1dc09f 100644
--- a/drivers/media/platform/qcom/iris/iris_vdec.c
+++ b/drivers/media/platform/qcom/iris/iris_vdec.c
@@ -234,6 +234,7 @@ int iris_vdec_s_fmt(struct iris_inst *inst, struct v4l2_format *f)
 		fmt->type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
 		fmt->fmt.pix_mp.pixelformat = f->fmt.pix_mp.pixelformat;
 		inst->codec = fmt->fmt.pix_mp.pixelformat;
+		inst->seq_event_seen = false;
 		codec_align = inst->codec == V4L2_PIX_FMT_HEVC ? 32 : 16;
 		fmt->fmt.pix_mp.width = ALIGN(f->fmt.pix_mp.width, codec_align);
 		fmt->fmt.pix_mp.height = ALIGN(f->fmt.pix_mp.height, codec_align);
@@ -332,6 +333,8 @@ int iris_vdec_subscribe_event(struct iris_inst *inst, const struct v4l2_event_su
 		break;
 	case V4L2_EVENT_SOURCE_CHANGE:
 		ret = v4l2_src_change_event_subscribe(&inst->fh, sub);
+		if (!ret)
+			inst->src_change_subscribed = true;
 		break;
 	case V4L2_EVENT_CTRL:
 		ret = v4l2_ctrl_subscribe_event(&inst->fh, sub);
@@ -349,6 +352,8 @@ void iris_vdec_src_change(struct iris_inst *inst)
 	struct v4l2_event event = {0};
 	struct vb2_queue *src_q;
 
+	inst->seq_event_seen = true;
+
 	src_q = v4l2_m2m_get_src_vq(m2m_ctx);
 	if (!vb2_is_streaming(src_q))
 		return;
diff --git a/drivers/media/platform/qcom/iris/iris_vidc.c b/drivers/media/platform/qcom/iris/iris_vidc.c
index 14d63dc..477ef19 100644
--- a/drivers/media/platform/qcom/iris/iris_vidc.c
+++ b/drivers/media/platform/qcom/iris/iris_vidc.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2022-2024 Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
+#include <linux/moduleparam.h>
 #include <linux/pm_runtime.h>
 #include <media/v4l2-event.h>
 #include <media/v4l2-ioctl.h>
@@ -22,6 +23,19 @@
 #define STEP_WIDTH 1
 #define STEP_HEIGHT 1
 
+/*
+ * gaokun3: fail decoder CAPTURE G_FMT with -EINVAL until the first
+ * SOURCE_CHANGE event, as venus does (venus/vdec.c vdec_check_src_change()).
+ * Android's v4l2_codec2 was brought up against venus on this machine; with the
+ * switch on it takes exactly the path it took with venus. Writable at runtime
+ * (/sys/module/qcom_iris/parameters/venus_compat_gfmt) so the upstream iris
+ * behaviour can be A/B-tested without a rebuild; it is read on every G_FMT.
+ */
+static bool venus_compat_gfmt = true;
+module_param(venus_compat_gfmt, bool, 0644);
+MODULE_PARM_DESC(venus_compat_gfmt,
+		 "Decoder CAPTURE G_FMT fails until the first source change, like venus (default: true)");
+
 static void iris_v4l2_fh_init(struct iris_inst *inst, struct file *filp)
 {
 	if (inst->domain == ENCODER)
@@ -361,6 +375,11 @@ static int iris_g_fmt_vid_mplane(struct file *filp, void *fh, struct v4l2_format
 	mutex_lock(&inst->lock);
 	if (V4L2_TYPE_IS_OUTPUT(f->type))
 		*f = *inst->fmt_src;
+	else if (V4L2_TYPE_IS_CAPTURE(f->type) && inst->domain == DECODER &&
+		 READ_ONCE(venus_compat_gfmt) &&
+		 inst->src_change_subscribed && !inst->seq_event_seen)
+		/* See venus_compat_gfmt above. */
+		ret = -EINVAL;
 	else if (V4L2_TYPE_IS_CAPTURE(f->type))
 		*f = *inst->fmt_dst;
 	else
