From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] media: iris: gen1: add HDR10 static metadata to HEVC Main 10
 encoding

An HDR10 stream is HEVC Main 10 with BT.2020 primaries, the SMPTE ST
2084 (PQ) transfer, and the static metadata of SMPTE ST 2086 and
CTA-861.3 in two SEI messages: the mastering display colour volume and
the content light level. With P010 input and the colour description in
the VUI, the gen1 encoder can produce everything but the SEI messages,
so displays and players have to tone map PQ content without knowing
its mastering peak or content light level.

Add the V4L2_CID_COLORIMETRY_HDR10_MASTERING_DISPLAY and
V4L2_CID_COLORIMETRY_HDR10_CLL_INFO controls to the gen1 encoder, as
venus has them, and send their values as
HFI_PROPERTY_PARAM_VENC_HDR10_PQ_SEI at STREAMON. The payload is the
one venus and downstream msm_vidc send: the mastering display (three
x/y primaries, the white point, the maximum and minimum luminance)
followed by the maximum content and frame-average light levels, all as
32-bit words in the units of the SEI messages, which are the units of
the V4L2 controls; the values are passed through in the order V4L2
documents (green, blue, red).

The property is sent for HEVC Main 10 when the transfer function of the
raw (OUTPUT) format is SMPTE 2084. HDR10 metadata describes PQ content
only, so HLG and SDR 10-bit streams get none; venus sends it for every
Main 10 stream. The default mastering display is the common DCI-P3 D65
display of 1000 cd/m2 peak and 0.005 cd/m2 black, with the primaries in
the documented order; the default content light levels are 0, which
CTA-861.3 defines as unknown. Like the other encoder parameters, the
controls cannot be changed while the OUTPUT queue is streaming.

Gen2 platforms do not get the controls.

Origin: local
Upstream-Status: Pending
Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/platform/qcom/iris/iris_ctrls.c | 92 ++++++++++++++++++-
 drivers/media/platform/qcom/iris/iris_ctrls.h |  2 +
 .../media/platform/qcom/iris/iris_hfi_gen1.c  |  7 ++
 .../qcom/iris/iris_hfi_gen1_command.c         |  7 ++
 .../qcom/iris/iris_hfi_gen1_defines.h         | 24 +++++
 .../media/platform/qcom/iris/iris_instance.h  |  4 +
 .../platform/qcom/iris/iris_platform_common.h |  1 +
 7 files changed, 135 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/qcom/iris/iris_ctrls.c b/drivers/media/platform/qcom/iris/iris_ctrls.c
index bcb4cd7f2a..430f9bfe00 100644
--- a/drivers/media/platform/qcom/iris/iris_ctrls.c
+++ b/drivers/media/platform/qcom/iris/iris_ctrls.c
@@ -156,6 +156,9 @@ static enum platform_inst_fw_cap_type iris_get_cap_id(u32 id)
 		return LAYER5_BITRATE_HEVC;
 	case V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME:
 		return REQUEST_SYNC_FRAME;
+	case V4L2_CID_COLORIMETRY_HDR10_CLL_INFO:
+	case V4L2_CID_COLORIMETRY_HDR10_MASTERING_DISPLAY:
+		return HDR10_STATIC_INFO;
 	default:
 		return INST_FW_CAP_MAX;
 	}
@@ -301,6 +304,7 @@ static u32 iris_get_v4l2_id(enum platform_inst_fw_cap_type cap_id)
 		return V4L2_CID_MPEG_VIDEO_HEVC_HIER_CODING_L5_BR;
 	case REQUEST_SYNC_FRAME:
 		return V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME;
+	/* HDR10_STATIC_INFO: two compound controls, see iris_ctrls_init_hdr10() */
 	default:
 		return 0;
 	}
@@ -325,7 +329,17 @@ static int iris_op_s_ctrl(struct v4l2_ctrl *ctrl)
 
 	cap[cap_id].flags |= CAP_FLAG_CLIENT_SET;
 
-	inst->fw_caps[cap_id].value = ctrl->val;
+	switch (ctrl->id) {
+	case V4L2_CID_COLORIMETRY_HDR10_CLL_INFO:
+		inst->hdr10_cll = *ctrl->p_new.p_hdr10_cll;
+		break;
+	case V4L2_CID_COLORIMETRY_HDR10_MASTERING_DISPLAY:
+		inst->hdr10_mastering = *ctrl->p_new.p_hdr10_mastering;
+		break;
+	default:
+		inst->fw_caps[cap_id].value = ctrl->val;
+		break;
+	}
 
 	if (vb2_is_streaming(q)) {
 		if (cap[cap_id].set)
@@ -339,6 +353,39 @@ static const struct v4l2_ctrl_ops iris_ctrl_ops = {
 	.s_ctrl = iris_op_s_ctrl,
 };
 
+/*
+ * The HDR10 static metadata the encoder writes into HEVC Main 10 streams with
+ * the SMPTE ST 2084 transfer. The default mastering display is the common
+ * DCI-P3 D65 one of 1000 cd/m2 peak and 0.005 cd/m2 black, with the primaries
+ * in the order V4L2 and the SEI use (green, blue, red); the default content
+ * light levels are 0, which means unknown.
+ */
+static void iris_ctrls_init_hdr10(struct iris_inst *inst)
+{
+	static const struct v4l2_ctrl_hdr10_mastering_display mastering = {
+		.display_primaries_x = { 13250, 7500, 34000 },
+		.display_primaries_y = { 34500, 3000, 16000 },
+		.white_point_x = 15635,
+		.white_point_y = 16450,
+		.max_display_mastering_luminance = 10000000,
+		.min_display_mastering_luminance = 50,
+	};
+
+	memset(&inst->hdr10_cll, 0, sizeof(inst->hdr10_cll));
+	inst->hdr10_mastering = mastering;
+
+	v4l2_ctrl_new_std_compound(&inst->ctrl_handler, &iris_ctrl_ops,
+				   V4L2_CID_COLORIMETRY_HDR10_CLL_INFO,
+				   v4l2_ctrl_ptr_create(NULL),
+				   v4l2_ctrl_ptr_create(NULL),
+				   v4l2_ctrl_ptr_create(NULL));
+	v4l2_ctrl_new_std_compound(&inst->ctrl_handler, &iris_ctrl_ops,
+				   V4L2_CID_COLORIMETRY_HDR10_MASTERING_DISPLAY,
+				   v4l2_ctrl_ptr_create((void *)&mastering),
+				   v4l2_ctrl_ptr_create(NULL),
+				   v4l2_ctrl_ptr_create(NULL));
+}
+
 int iris_ctrls_init(struct iris_inst *inst)
 {
 	struct platform_inst_fw_cap *cap = &inst->fw_caps[0];
@@ -356,7 +403,8 @@ int iris_ctrls_init(struct iris_inst *inst)
 	 * V4L2_CID_MIN_BUFFERS_FOR_OUTPUT for encoder
 	 */
 
-	ret = v4l2_ctrl_handler_init(&inst->ctrl_handler, num_ctrls + 1);
+	ret = v4l2_ctrl_handler_init(&inst->ctrl_handler, num_ctrls + 1 +
+				     (cap[HDR10_STATIC_INFO].cap_id ? 2 : 0));
 	if (ret)
 		return ret;
 
@@ -404,6 +452,9 @@ int iris_ctrls_init(struct iris_inst *inst)
 				  V4L2_CID_MIN_BUFFERS_FOR_OUTPUT, 1, 32, 1, 4);
 	}
 
+	if (cap[HDR10_STATIC_INFO].cap_id)
+		iris_ctrls_init_hdr10(inst);
+
 	ret = inst->ctrl_handler.error;
 	if (ret)
 		goto error;
@@ -1597,6 +1648,43 @@ int iris_set_req_sync_frame(struct iris_inst *inst, enum platform_inst_fw_cap_ty
 					     &hfi_val, sizeof(u32));
 }
 
+/*
+ * HDR10 static metadata only applies to PQ content, so send it for HEVC
+ * Main 10 with the SMPTE ST 2084 transfer set on the raw format, and leave
+ * HLG and SDR 10-bit streams without it.
+ */
+int iris_set_hdr10_static_info_gen1(struct iris_inst *inst,
+				    enum platform_inst_fw_cap_type cap_id)
+{
+	const struct v4l2_ctrl_hdr10_mastering_display *md = &inst->hdr10_mastering;
+	const struct iris_hfi_session_ops *hfi_ops = inst->hfi_session_ops;
+	u32 hfi_id = inst->fw_caps[cap_id].hfi_id;
+	struct hfi_hdr10_pq_sei hdr10;
+	unsigned int i;
+
+	if (inst->codec != V4L2_PIX_FMT_HEVC ||
+	    inst->fw_caps[PROFILE_HEVC].value != V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN_10 ||
+	    inst->fmt_src->fmt.pix_mp.xfer_func != V4L2_XFER_FUNC_SMPTE2084)
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(md->display_primaries_x); i++) {
+		hdr10.mastering.display_primaries_x[i] = md->display_primaries_x[i];
+		hdr10.mastering.display_primaries_y[i] = md->display_primaries_y[i];
+	}
+	hdr10.mastering.white_point_x = md->white_point_x;
+	hdr10.mastering.white_point_y = md->white_point_y;
+	hdr10.mastering.max_display_mastering_luminance = md->max_display_mastering_luminance;
+	hdr10.mastering.min_display_mastering_luminance = md->min_display_mastering_luminance;
+	hdr10.cll.max_content_light = inst->hdr10_cll.max_content_light_level;
+	hdr10.cll.max_pic_average_light = inst->hdr10_cll.max_pic_average_light_level;
+
+	return hfi_ops->session_set_property(inst, hfi_id,
+					     HFI_HOST_FLAGS_NONE,
+					     iris_get_port_info(inst, cap_id),
+					     HFI_PAYLOAD_STRUCTURE,
+					     &hdr10, sizeof(hdr10));
+}
+
 int iris_set_properties(struct iris_inst *inst, u32 plane)
 {
 	const struct iris_hfi_session_ops *hfi_ops = inst->hfi_session_ops;
diff --git a/drivers/media/platform/qcom/iris/iris_ctrls.h b/drivers/media/platform/qcom/iris/iris_ctrls.h
index 8d8bbef960..a7860b8c49 100644
--- a/drivers/media/platform/qcom/iris/iris_ctrls.h
+++ b/drivers/media/platform/qcom/iris/iris_ctrls.h
@@ -48,6 +48,8 @@ int iris_set_layer_count_gen1(struct iris_inst *inst, enum platform_inst_fw_cap_
 int iris_set_layer_count_gen2(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
 int iris_set_layer_bitrate(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
 int iris_set_req_sync_frame(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
+int iris_set_hdr10_static_info_gen1(struct iris_inst *inst,
+				    enum platform_inst_fw_cap_type cap_id);
 int iris_set_properties(struct iris_inst *inst, u32 plane);
 
 #endif
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen1.c b/drivers/media/platform/qcom/iris/iris_hfi_gen1.c
index f5bddd61fc..453a3ef90e 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen1.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen1.c
@@ -385,6 +385,13 @@ static const struct platform_inst_fw_cap inst_fw_cap_sm8250_enc[] = {
 		.flags = CAP_FLAG_INPUT_PORT | CAP_FLAG_DYNAMIC_ALLOWED,
 		.set = iris_set_req_sync_frame,
 	},
+	{
+		/* V4L2_CID_COLORIMETRY_HDR10_CLL_INFO and _MASTERING_DISPLAY */
+		.cap_id = HDR10_STATIC_INFO,
+		.hfi_id = HFI_PROPERTY_PARAM_VENC_HDR10_PQ_SEI,
+		.flags = CAP_FLAG_OUTPUT_PORT,
+		.set = iris_set_hdr10_static_info_gen1,
+	},
 };
 
 static const u32 sm8250_vdec_input_config_param_default[] = {
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c b/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c
index b77a22fab4..b2c96e436c 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c
@@ -835,6 +835,13 @@ iris_hfi_gen1_packet_session_set_property(struct hfi_session_set_property_pkt *p
 		packet->shdr.hdr.size += sizeof(*info);
 		break;
 	}
+	case HFI_PROPERTY_PARAM_VENC_HDR10_PQ_SEI: {
+		struct hfi_hdr10_pq_sei *in = pdata, *hdr10 = prop_data;
+
+		*hdr10 = *in;
+		packet->shdr.hdr.size += sizeof(*hdr10);
+		break;
+	}
 	default:
 		return -EINVAL;
 	}
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen1_defines.h b/drivers/media/platform/qcom/iris/iris_hfi_gen1_defines.h
index b0ccafbbaa..73cc38c5b2 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen1_defines.h
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen1_defines.h
@@ -161,6 +161,7 @@
 #define HFI_PROPERTY_PARAM_VENC_VIDEO_SIGNAL_INFO		0x200501d
 #define HFI_PROPERTY_PARAM_VENC_MAX_NUM_B_FRAMES		0x2005020
 #define HFI_PROPERTY_PARAM_VENC_HIER_P_MAX_NUM_ENH_LAYER	0x2005026
+#define HFI_PROPERTY_PARAM_VENC_HDR10_PQ_SEI			0x2005036
 #define HFI_PROPERTY_CONFIG_VENC_TARGET_BITRATE			0x2006001
 #define HFI_PROPERTY_CONFIG_VENC_INTRA_PERIOD			0x2006003
 #define HFI_PROPERTY_CONFIG_VENC_REQUEST_SYNC_FRAME		0x2006004
@@ -524,6 +525,29 @@ struct hfi_video_signal_metadata {
 	u32 matrix_coeffs;
 };
 
+/*
+ * HEVC mastering display colour volume and content light level SEI payloads,
+ * in the units of the SEI messages (and of the V4L2 HDR10 controls).
+ */
+struct hfi_mastering_display_colour_sei_payload {
+	u32 display_primaries_x[3];
+	u32 display_primaries_y[3];
+	u32 white_point_x;
+	u32 white_point_y;
+	u32 max_display_mastering_luminance;
+	u32 min_display_mastering_luminance;
+};
+
+struct hfi_content_light_level_sei_payload {
+	u32 max_content_light;
+	u32 max_pic_average_light;
+};
+
+struct hfi_hdr10_pq_sei {
+	struct hfi_mastering_display_colour_sei_payload mastering;
+	struct hfi_content_light_level_sei_payload cll;
+};
+
 struct hfi_event_data {
 	u32 error;
 	u32 height;
diff --git a/drivers/media/platform/qcom/iris/iris_instance.h b/drivers/media/platform/qcom/iris/iris_instance.h
index c1512baa6a..4e6722fef4 100644
--- a/drivers/media/platform/qcom/iris/iris_instance.h
+++ b/drivers/media/platform/qcom/iris/iris_instance.h
@@ -96,6 +96,8 @@ extern bool iris_eos_flush;
  * @enc_scale_height: scale height for encoder instance
  * @hfi_layer_type: hierarchical coding layer type
  * @hfi_layer_count: hierarchical coding layer count
+ * @hdr10_cll: HDR10 content light level for the encoder
+ * @hdr10_mastering: HDR10 mastering display for the encoder
  */
 
 struct iris_inst {
@@ -149,6 +151,8 @@ struct iris_inst {
 	u32				enc_scale_height;
 	u32				hfi_layer_type;
 	u32				hfi_layer_count;
+	struct v4l2_ctrl_hdr10_cll_info	hdr10_cll;
+	struct v4l2_ctrl_hdr10_mastering_display hdr10_mastering;
 };
 
 #endif
diff --git a/drivers/media/platform/qcom/iris/iris_platform_common.h b/drivers/media/platform/qcom/iris/iris_platform_common.h
index 23b6e7676d..47324d957e 100644
--- a/drivers/media/platform/qcom/iris/iris_platform_common.h
+++ b/drivers/media/platform/qcom/iris/iris_platform_common.h
@@ -183,6 +183,7 @@ enum platform_inst_fw_cap_type {
 	LAYER4_BITRATE_HEVC,
 	LAYER5_BITRATE_HEVC,
 	REQUEST_SYNC_FRAME,
+	HDR10_STATIC_INFO,
 	INST_FW_CAP_MAX,
 };
 
