@@ -403,6 +403,7 @@ static const u32 sm8250_venc_input_config_param[] = {
 	HFI_PROPERTY_PARAM_UNCOMPRESSED_PLANE_ACTUAL_INFO,
 	HFI_PROPERTY_PARAM_FRAME_SIZE,
 	HFI_PROPERTY_PARAM_UNCOMPRESSED_FORMAT_SELECT,
