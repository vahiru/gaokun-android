 	if (!meta->running) {
 		spin_unlock(&meta->lock);
@@ -584,6 +717,25 @@ void vfe17x_meta_bus(struct vfe_device *vfe, u32 bus_status1)
 	}
 	done = meta->stats_cur;
 	ife_stats_next(meta);
+	/* Dual IFE: wait for the slave's grid of the same frame */
