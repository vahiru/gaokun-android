diff --git a/drivers/media/platform/qcom/camss/camss-csid-gen2.c b/drivers/media/platform/qcom/camss/camss-csid-gen2.c
index bed84962e..774bf6e06 100644
--- a/drivers/media/platform/qcom/camss/camss-csid-gen2.c
+++ b/drivers/media/platform/qcom/camss/camss-csid-gen2.c
@@ -355,6 +355,11 @@ static bool csid_port_is_ipp(struct csid_device *csid, u8 port)
 	return csid->res->has_ipp && port == CSID_PORT_IPP;
 }
 
+/* IPP halt modes and master index, downstream cam_ife_csid_core.c for 175 */
+#define		IPP_CTRL_HALT_MODE_MASTER	2
+#define		IPP_CTRL_HALT_MODE_SLAVE	3
+#define		IPP_CTRL_MASTER_IDX		4
+
 static void __csid_ctrl_ipp(struct csid_device *csid, int enable)
 {
 	u32 val;
@@ -363,6 +368,22 @@ static void __csid_ctrl_ipp(struct csid_device *csid, int enable)
 		val = HALT_CMD_RESUME_AT_FRAME_BOUNDARY << RDI_CTRL_HALT_CMD;
 	else
 		val = HALT_CMD_HALT_AT_FRAME_BOUNDARY << RDI_CTRL_HALT_CMD;
+
+	/*
+	 * Dual IFE: the slave follows the master's resume and halt, so the
+	 * two stripes start and stop on the same frame.
+	 */
+	switch (csid->ipp_sync) {
+	case CSID_IPP_SYNC_MASTER:
+		val |= IPP_CTRL_HALT_MODE_MASTER << RDI_CTRL_HALT_MODE;
+		break;
+	case CSID_IPP_SYNC_SLAVE:
+		val = IPP_CTRL_HALT_MODE_SLAVE << RDI_CTRL_HALT_MODE |
+		      csid->ipp_master << IPP_CTRL_MASTER_IDX;
+		break;
+	default:
+		break;
+	}
 	writel_relaxed(val, csid->base + CSID_IPP_CTRL);
 }
 
diff --git a/drivers/media/platform/qcom/camss/camss-csid.c b/drivers/media/platform/qcom/camss/camss-csid.c
index 1fc88a875..d7fa2d51d 100644
--- a/drivers/media/platform/qcom/camss/camss-csid.c
+++ b/drivers/media/platform/qcom/camss/camss-csid.c
@@ -757,6 +757,40 @@ static int csid_set_power(struct v4l2_subdev *sd, int on)
  *
  * Return 0 on success or a negative error code otherwise
  */
+/*
+ * Dual IFE: the CSIDs feeding the two pixel paths of a VFE pair start and
+ * stop on the same frame boundary, the one of the master VFE driving the
+ * other. The VFEs paired when the slave's pixel path started, before its
+ * CSID.
+ */
+static void csid_ipp_dual_role(struct csid_device *csid)
+{
+	struct media_pad *pad = media_pad_remote_pad_first(&csid->pads[MSM_CSID_PAD_IPP]);
+	struct csid_device *master;
+	struct vfe_device *vfe;
+	struct vfe_line *line;
+
+	csid->ipp_sync = CSID_IPP_SYNC_NONE;
+	if (!pad || !is_media_entity_v4l2_subdev(pad->entity))
+		return;
+
+	line = v4l2_get_subdevdata(media_entity_to_v4l2_subdev(pad->entity));
+	vfe = to_vfe(line);
+	if (!vfe->dual.peer)
+		return;
+	if (vfe->dual.master) {
+		csid->ipp_sync = CSID_IPP_SYNC_MASTER;
+		return;
+	}
+
+	pad = media_pad_remote_pad_first(&vfe->dual.peer->line[VFE_LINE_PIX].pads[MSM_VFE_PAD_SINK]);
+	if (!pad || !is_media_entity_v4l2_subdev(pad->entity))
+		return;
+	master = v4l2_get_subdevdata(media_entity_to_v4l2_subdev(pad->entity));
+	csid->ipp_master = master->id;
+	csid->ipp_sync = CSID_IPP_SYNC_SLAVE;
+}
+
 static int csid_set_stream(struct v4l2_subdev *sd, int enable)
 {
 	struct csid_device *csid = v4l2_get_subdevdata(sd);
@@ -777,6 +811,9 @@ static int csid_set_stream(struct v4l2_subdev *sd, int enable)
 			return -ENOLINK;
 	}
 
+	if (enable && csid->res->has_ipp)
+		csid_ipp_dual_role(csid);
+
 	if (csid->phy.need_vc_update) {
 		csid->res->hw_ops->configure_stream(csid, enable);
 		csid->phy.need_vc_update = false;
