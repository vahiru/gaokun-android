From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] media: i2c: hi846: Report the pixel array rate and the link frequency

V4L2_CID_PIXEL_RATE is the pixel array's rate, which userspace combines
with the blanking controls to get the line and frame times. hi846
derives it from the current mode's MIPI link frequency, but the array
runs at one rate in every mode: 3800 x 2526 lines at 30 fps is 288 MHz
(24 MHz MCLK) in the 3264x2448 and 1632x1224 modes alike, and 1280x720
at 90 fps and 640x480 at 120 fps give the same. The binned modes run
the MIPI link slower, as they send fewer pixels per line, and the 2-lane
configuration runs it faster. The control's range is also fixed from
the probe mode, so on 4 lanes every mode reported the 1280x720 value,
144 MHz: libcamera computed 66.7 ms frames for a sensor running at
30 fps, and doubled every exposure time. Report the rate of the
full-resolution 4-lane modes, MCLK / 3 * 90 / 2 * 2 * 4 / 10, for every
mode and lane count.

The CSI-2 receiver used to derive the link frequency from the pixel
rate (camss does without V4L2_CID_LINK_FREQ), which was already wrong
for the full-resolution modes (180 MHz for a 360 MHz link) and now
would be for all. Add the control back, read-only, listing the
supported modes' own link frequencies and following the current mode.
"media: hi846: fix link frequency handling" removed it when the link
frequency became computed at runtime; the receiver still needs it.

The read-only controls need nothing written, so s_ctrl returns early for
them instead of failing with -EINVAL while the sensor is powered.

hi846_check_link_freqs() runs in hi846_parse_dt() before the clock is
taken, computes every link frequency as 0 and passes; not changed here.

Assisted-by: Claude:claude-opus-5-5
Origin: local
Upstream-Status: Pending
---
 drivers/media/i2c/hi846.c | 59 +++++++++++++++++++++++++++++++++++----
 1 file changed, 53 insertions(+), 6 deletions(-)

diff --git a/drivers/media/i2c/hi846.c b/drivers/media/i2c/hi846.c
index 09b8dd60e..d68412691 100644
--- a/drivers/media/i2c/hi846.c
+++ b/drivers/media/i2c/hi846.c
@@ -1305,6 +1305,7 @@ struct hi846 {
 	u8 nr_lanes;
 
 	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
 	struct v4l2_ctrl *vblank;
 	struct v4l2_ctrl *hblank;
 	struct v4l2_ctrl *exposure;
@@ -1314,6 +1315,10 @@ struct hi846 {
 	const struct hi846_mode *supported_modes;
 	int num_modes;
 	bool streaming;
+
+	/* the supported modes' link frequencies, for V4L2_CID_LINK_FREQ */
+	s64 link_freqs[ARRAY_SIZE(supported_modes)];
+	unsigned int nr_link_freqs;
 };
 
 static inline struct hi846 *to_hi846(struct v4l2_subdev *sd)
@@ -1364,14 +1369,35 @@ hi846_get_link_freq(struct hi846 *hi846, const struct hi846_mode *cur_mode)
 	return link_freq;
 }
 
+/*
+ * The pixel array runs at one rate in every mode: line length 3800 times frame
+ * length 2526 at 30 fps is 288 MHz with a 24 MHz MCLK in the 3264x2448 and
+ * 1632x1224 modes alike, and 1280x720 at 90 fps (842 lines) and 640x480 at
+ * 120 fps (631 lines) give the same. That is the MIPI pixel rate of the
+ * full-resolution modes on four lanes (link frequency MCLK / 3 * 90 / 2): the
+ * other modes and the 2-lane configuration change only the MIPI clock.
+ */
 static u64 hi846_calc_pixel_rate(struct hi846 *hi846)
 {
-	u64 link_freq = hi846_get_link_freq(hi846, hi846->cur_mode);
-	u64 pixel_rate = link_freq * 2 * hi846->nr_lanes;
+	u64 link_freq = clk_get_rate(hi846->clock) / 3 * 90 / 2;
 
-	do_div(pixel_rate, HI846_RGB_DEPTH);
+	return div_u64(link_freq * 2 * 4, HI846_RGB_DEPTH);
+}
 
-	return pixel_rate;
+/*
+ * Index of the current mode's link frequency in link_freqs. The CSI-2 receiver
+ * needs the real link frequency, which doesn't follow from the pixel rate.
+ */
+static unsigned int hi846_link_freq_index(struct hi846 *hi846)
+{
+	s64 link_freq = hi846_get_link_freq(hi846, hi846->cur_mode);
+	unsigned int i;
+
+	for (i = 0; i < hi846->nr_link_freqs - 1; i++)
+		if (hi846->link_freqs[i] == link_freq)
+			break;
+
+	return i;
 }
 
 static int hi846_read_reg(struct hi846 *hi846, u16 reg, u8 *val)
@@ -1515,6 +1541,10 @@ static int hi846_set_ctrl(struct v4l2_ctrl *ctrl)
 					 exposure_max);
 	}
 
+	/* The read-only controls are set by the driver itself: nothing to write. */
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
 	ret = pm_runtime_get_if_in_use(&client->dev);
 	if (!ret || ret == -EAGAIN)
 		return 0;
@@ -1575,6 +1605,7 @@ static int hi846_init_controls(struct hi846 *hi846)
 {
 	struct v4l2_ctrl_handler *ctrl_hdlr;
 	s64 exposure_max, h_blank;
+	unsigned int i, j;
 	int ret;
 	struct i2c_client *client = v4l2_get_subdevdata(&hi846->sd);
 	struct v4l2_fwnode_device_properties props;
@@ -1591,6 +1622,23 @@ static int hi846_init_controls(struct hi846 *hi846)
 				  V4L2_CID_PIXEL_RATE, 0,
 				  hi846_calc_pixel_rate(hi846), 1,
 				  hi846_calc_pixel_rate(hi846));
+	for (i = 0; i < hi846->num_modes; i++) {
+		s64 f = hi846_get_link_freq(hi846, &hi846->supported_modes[i]);
+
+		for (j = 0; j < hi846->nr_link_freqs; j++)
+			if (hi846->link_freqs[j] == f)
+				break;
+		if (j == hi846->nr_link_freqs)
+			hi846->link_freqs[hi846->nr_link_freqs++] = f;
+	}
+	hi846->link_freq =
+		v4l2_ctrl_new_int_menu(ctrl_hdlr, &hi846_ctrl_ops,
+				       V4L2_CID_LINK_FREQ,
+				       hi846->nr_link_freqs - 1,
+				       hi846_link_freq_index(hi846),
+				       hi846->link_freqs);
+	if (hi846->link_freq)
+		hi846->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
 	hi846->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &hi846_ctrl_ops,
 					  V4L2_CID_VBLANK,
 					  hi846->cur_mode->frame_len -
@@ -1901,8 +1949,7 @@ static int hi846_set_format(struct v4l2_subdev *sd,
 	mf->code = HI846_MEDIA_BUS_FORMAT;
 	mf->field = V4L2_FIELD_NONE;
 
-	__v4l2_ctrl_s_ctrl_int64(hi846->pixel_rate,
-				 hi846_calc_pixel_rate(hi846));
+	__v4l2_ctrl_s_ctrl(hi846->link_freq, hi846_link_freq_index(hi846));
 
 	/* Update limits and set FPS to default */
 	vblank_def = hi846->cur_mode->frame_len - hi846->cur_mode->height;
