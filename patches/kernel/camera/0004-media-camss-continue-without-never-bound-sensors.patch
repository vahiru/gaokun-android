+	struct delayed_work sensor_fallback_work;
+	bool notifier_complete;
+	struct fwnode_handle *bound_sensors[8];
+	unsigned int num_bound_sensors;
 	struct media_device media_dev;
 	struct device *dev;
 	struct csiphy_device *csiphy;
