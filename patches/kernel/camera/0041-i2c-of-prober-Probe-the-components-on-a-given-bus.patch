From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] i2c: of-prober: Probe the components on a given bus

i2c_of_probe_component() takes the bus of the first node in the device
tree whose name is the component type, and only if that bus node is
named "i2c". Boards with second source components of the same type on
several buses, or on controllers whose bus nodes have other names, such
as the Qualcomm CCI with its "i2c-bus" children, cannot use it.

Add i2c_of_probe_component_on_bus(), which probes the components on a
bus node the caller passes, and have i2c_of_probe_component() find its
bus as before and use the same code.

Assisted-by: Claude:claude-opus-5-5
Origin: local
Upstream-Status: Pending
---
 drivers/i2c/i2c-core-of-prober.c | 124 +++++++++++++++++++++----------
 include/linux/i2c-of-prober.h    |   8 +-
 2 files changed, 90 insertions(+), 42 deletions(-)

diff --git a/drivers/i2c/i2c-core-of-prober.c b/drivers/i2c/i2c-core-of-prober.c
index 6a82b03809..90323695d6 100644
--- a/drivers/i2c/i2c-core-of-prober.c
+++ b/drivers/i2c/i2c-core-of-prober.c
@@ -89,42 +89,8 @@ static int i2c_of_probe_enable_node(struct device *dev, struct device_node *node
 
 static const struct i2c_of_probe_ops i2c_of_probe_dummy_ops;
 
-/**
- * i2c_of_probe_component() - probe for devices of "type" on the same i2c bus
- * @dev: Pointer to the &struct device of the caller, only used for dev_printk() messages.
- * @cfg: Pointer to the &struct i2c_of_probe_cfg containing callbacks and other options
- *       for the prober.
- * @ctx: Context data for callbacks.
- *
- * Probe for possible I2C components of the same "type" (&i2c_of_probe_cfg->type)
- * on the same I2C bus that have their status marked as "fail-needs-probe".
- *
- * Assumes that across the entire device tree the only instances of nodes
- * with "type" prefixed node names (not including the address portion) are
- * the ones that need handling for second source components. In other words,
- * if "type" is "touchscreen", then all device nodes named "touchscreen*"
- * are the ones that need probing. There cannot be another "touchscreen*"
- * node that is already enabled.
- *
- * Assumes that for each "type" of component, only one actually exists. In
- * other words, only one matching and existing device will be enabled.
- *
- * Context: Process context only. Does non-atomic I2C transfers.
- *          Should only be used from a driver probe function, as the function
- *          can return -EPROBE_DEFER if the I2C adapter or other resources
- *          are unavailable.
- * Return: 0 on success or no-op, error code otherwise.
- *         A no-op can happen when it seems like the device tree already
- *         has components of the type to be probed already enabled. This
- *         can happen when the device tree had not been updated to mark
- *         the status of the to-be-probed components as "fail-needs-probe".
- *         Or this function was already run with the same parameters and
- *         succeeded in enabling a component. The latter could happen if
- *         the user had multiple types of components to probe, and one of
- *         them down the list caused a deferred probe. This is expected
- *         behavior.
- */
-int i2c_of_probe_component(struct device *dev, const struct i2c_of_probe_cfg *cfg, void *ctx)
+static int i2c_of_probe_bus(struct device *dev, struct device_node *i2c_node,
+			    const struct i2c_of_probe_cfg *cfg, void *ctx)
 {
 	const struct i2c_of_probe_ops *ops;
 	const char *type;
@@ -134,10 +100,6 @@ int i2c_of_probe_component(struct device *dev, const struct i2c_of_probe_cfg *cf
 	ops = cfg->ops ?: &i2c_of_probe_dummy_ops;
 	type = cfg->type;
 
-	struct device_node *i2c_node __free(device_node) = i2c_of_probe_get_i2c_node(dev, type);
-	if (!i2c_node)
-		return -ENODEV;
-
 	/*
 	 * If any devices of the given "type" are already enabled then this function is a no-op.
 	 * Either the device tree hasn't been modified to work with this probe function, or the
@@ -181,8 +143,90 @@ int i2c_of_probe_component(struct device *dev, const struct i2c_of_probe_cfg *cf
 
 	return ret;
 }
+
+/**
+ * i2c_of_probe_component() - probe for devices of "type" on the same i2c bus
+ * @dev: Pointer to the &struct device of the caller, only used for dev_printk() messages.
+ * @cfg: Pointer to the &struct i2c_of_probe_cfg containing callbacks and other options
+ *       for the prober.
+ * @ctx: Context data for callbacks.
+ *
+ * Probe for possible I2C components of the same "type" (&i2c_of_probe_cfg->type)
+ * on the same I2C bus that have their status marked as "fail-needs-probe".
+ *
+ * Assumes that across the entire device tree the only instances of nodes
+ * with "type" prefixed node names (not including the address portion) are
+ * the ones that need handling for second source components. In other words,
+ * if "type" is "touchscreen", then all device nodes named "touchscreen*"
+ * are the ones that need probing. There cannot be another "touchscreen*"
+ * node that is already enabled.
+ *
+ * Assumes that for each "type" of component, only one actually exists. In
+ * other words, only one matching and existing device will be enabled.
+ *
+ * Context: Process context only. Does non-atomic I2C transfers.
+ *          Should only be used from a driver probe function, as the function
+ *          can return -EPROBE_DEFER if the I2C adapter or other resources
+ *          are unavailable.
+ * Return: 0 on success or no-op, error code otherwise.
+ *         A no-op can happen when it seems like the device tree already
+ *         has components of the type to be probed already enabled. This
+ *         can happen when the device tree had not been updated to mark
+ *         the status of the to-be-probed components as "fail-needs-probe".
+ *         Or this function was already run with the same parameters and
+ *         succeeded in enabling a component. The latter could happen if
+ *         the user had multiple types of components to probe, and one of
+ *         them down the list caused a deferred probe. This is expected
+ *         behavior.
+ */
+int i2c_of_probe_component(struct device *dev, const struct i2c_of_probe_cfg *cfg, void *ctx)
+{
+	struct device_node *i2c_node __free(device_node) =
+		i2c_of_probe_get_i2c_node(dev, cfg->type);
+	if (!i2c_node)
+		return -ENODEV;
+
+	return i2c_of_probe_bus(dev, i2c_node, cfg, ctx);
+}
 EXPORT_SYMBOL_NS_GPL(i2c_of_probe_component, "I2C_OF_PROBER");
 
+/**
+ * i2c_of_probe_component_on_bus() - probe for devices of "type" on a given i2c bus
+ * @dev: Pointer to the &struct device of the caller, only used for dev_printk() messages.
+ * @i2c_node: Device node of the I2C bus the components are on.
+ * @cfg: Pointer to the &struct i2c_of_probe_cfg containing callbacks and other options
+ *       for the prober.
+ * @ctx: Context data for callbacks.
+ *
+ * Like i2c_of_probe_component(), but for components on the bus @i2c_node
+ * rather than on the bus of the first "type" node in the device tree. This
+ * allows components of the same "type" to be probed on several buses, and
+ * buses whose node is not named "i2c".
+ *
+ * Assumes that the only children of @i2c_node with "type" prefixed node names
+ * are the ones that need handling for second source components, and that only
+ * one of them actually exists.
+ *
+ * Context: Process context only. Does non-atomic I2C transfers.
+ *          Should only be used from a driver probe function, as the function
+ *          can return -EPROBE_DEFER if the I2C adapter or other resources
+ *          are unavailable.
+ * Return: 0 on success, when no component responds, or on a no-op; error
+ *         code otherwise. A no-op happens in the same cases as for
+ *         i2c_of_probe_component().
+ */
+int i2c_of_probe_component_on_bus(struct device *dev, struct device_node *i2c_node,
+				  const struct i2c_of_probe_cfg *cfg, void *ctx)
+{
+	if (!of_device_is_available(i2c_node)) {
+		dev_err(dev, "I2C controller not available\n");
+		return -ENODEV;
+	}
+
+	return i2c_of_probe_bus(dev, i2c_node, cfg, ctx);
+}
+EXPORT_SYMBOL_NS_GPL(i2c_of_probe_component_on_bus, "I2C_OF_PROBER");
+
 static int i2c_of_probe_simple_get_supply(struct device *dev, struct device_node *node,
 					  struct i2c_of_probe_simple_ctx *ctx)
 {
diff --git a/include/linux/i2c-of-prober.h b/include/linux/i2c-of-prober.h
index bb6d47f50e..45f1d2f5a5 100644
--- a/include/linux/i2c-of-prober.h
+++ b/include/linux/i2c-of-prober.h
@@ -17,7 +17,8 @@ struct device_node;
 /**
  * struct i2c_of_probe_ops - I2C OF component prober callbacks
  *
- * A set of callbacks to be used by i2c_of_probe_component().
+ * A set of callbacks to be used by i2c_of_probe_component() and
+ * i2c_of_probe_component_on_bus().
  *
  * All callbacks are optional. Callbacks are called only once per run, and are
  * used in the order they are defined in this structure.
@@ -26,7 +27,8 @@ struct device_node;
  * or a negative error number on failure.
  *
  * The @dev parameter passed to the callbacks is the same as @dev passed to
- * i2c_of_probe_component(). It should only be used for dev_printk() calls
+ * i2c_of_probe_component() or i2c_of_probe_component_on_bus(). It should only
+ * be used for dev_printk() calls
  * and nothing else, especially not managed device resource (devres) APIs.
  */
 struct i2c_of_probe_ops {
@@ -70,6 +72,8 @@ struct i2c_of_probe_cfg {
 #if IS_ENABLED(CONFIG_OF_DYNAMIC)
 
 int i2c_of_probe_component(struct device *dev, const struct i2c_of_probe_cfg *cfg, void *ctx);
+int i2c_of_probe_component_on_bus(struct device *dev, struct device_node *i2c_node,
+				  const struct i2c_of_probe_cfg *cfg, void *ctx);
 
 /**
  * DOC: I2C OF component prober simple helpers
