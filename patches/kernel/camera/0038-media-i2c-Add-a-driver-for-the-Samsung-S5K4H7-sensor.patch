+	u32 again_max;
+	u32 again_step;
+	u32 exposure_min;
+	u32 exposure_margin;
+};
+
+static inline struct s5k4h7 *to_s5k4h7(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct s5k4h7, sd);
+}
+
+static u32 s5k4h7_get_format_code(struct s5k4h7 *s5k4h7)
+{
+	u32 flips = (s5k4h7->hflip->val ? 1 : 0) | (s5k4h7->vflip->val ? 2 : 0);
+
+	return s5k4h7_mbus_formats[s5k4h7->pixel_order ^ flips];
+}
+
+static void s5k4h7_update_exposure_range(struct s5k4h7 *s5k4h7, u32 vblank)
+{
+	s64 max = s5k4h7->mode->height + vblank - s5k4h7->exposure_margin;
+
+	__v4l2_ctrl_modify_range(s5k4h7->exposure, s5k4h7->exposure_min, max,
+				 S5K4H7_EXPOSURE_STEP,
+				 min(s5k4h7->exposure->default_value, max));
+}
+
+static int s5k4h7_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k4h7 *s5k4h7 = container_of(ctrl->handler, struct s5k4h7,
+					     ctrl_handler);
+	int ret;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		s5k4h7_update_exposure_range(s5k4h7, ctrl->val);
+
+	/* Controls are written when the sensor is powered up for streaming */
+	if (!pm_runtime_get_if_active(s5k4h7->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(s5k4h7->regmap, S5K4H7_REG_ANALOG_GAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(s5k4h7->regmap, S5K4H7_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(s5k4h7->regmap, S5K4H7_REG_FRAME_LENGTH,
+				s5k4h7->mode->height + ctrl->val, NULL);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ret = cci_write(s5k4h7->regmap, S5K4H7_REG_ORIENTATION,
+				(s5k4h7->hflip->val ? S5K4H7_HFLIP : 0) |
+				(s5k4h7->vflip->val ? S5K4H7_VFLIP : 0), NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(s5k4h7->regmap, S5K4H7_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(s5k4h7->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k4h7_ctrl_ops = {
+	.s_ctrl = s5k4h7_set_ctrl,
+};
+
+static int s5k4h7_init_controls(struct s5k4h7 *s5k4h7)
+{
+	struct v4l2_ctrl_handler *hdl = &s5k4h7->ctrl_handler;
+	const struct s5k4h7_mode *mode = s5k4h7->mode;
+	struct v4l2_fwnode_device_properties props;
+	s64 hblank, vblank, exposure_max;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 11);
+
+	s5k4h7->link_freq = v4l2_ctrl_new_int_menu(hdl, &s5k4h7_ctrl_ops,
+						   V4L2_CID_LINK_FREQ,
+						   ARRAY_SIZE(s5k4h7_link_freq_menu) - 1,
+						   0, s5k4h7_link_freq_menu);
+	if (s5k4h7->link_freq)
+		s5k4h7->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5k4h7->pixel_rate = v4l2_ctrl_new_std(hdl, &s5k4h7_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       S5K4H7_PIXEL_RATE,
+					       S5K4H7_PIXEL_RATE, 1,
+					       S5K4H7_PIXEL_RATE);
+
+	hblank = mode->hts - mode->width;
+	s5k4h7->hblank = v4l2_ctrl_new_std(hdl, &s5k4h7_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank, hblank, 1,
+					   hblank);
+	if (s5k4h7->hblank)
+		s5k4h7->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	s5k4h7->vblank = v4l2_ctrl_new_std(hdl, &s5k4h7_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   S5K4H7_FRAME_LENGTH_MAX - mode->height,
+					   1, vblank);
+
+	v4l2_ctrl_new_std(hdl, &s5k4h7_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  s5k4h7->again_min, s5k4h7->again_max,
+			  s5k4h7->again_step, s5k4h7->again_min);
+
+	exposure_max = mode->vts - s5k4h7->exposure_margin;
+	s5k4h7->exposure = v4l2_ctrl_new_std(hdl, &s5k4h7_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     s5k4h7->exposure_min, exposure_max,
+					     S5K4H7_EXPOSURE_STEP,
+					     exposure_max);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &s5k4h7_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5k4h7_test_pattern_menu) - 1,
+				     0, 0, s5k4h7_test_pattern_menu);
+
+	s5k4h7->hflip = v4l2_ctrl_new_std(hdl, &s5k4h7_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (s5k4h7->hflip)
+		s5k4h7->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	s5k4h7->vflip = v4l2_ctrl_new_std(hdl, &s5k4h7_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (s5k4h7->vflip)
+		s5k4h7->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error_free;
+	}
+
+	ret = v4l2_fwnode_device_parse(s5k4h7->dev, &props);
+	if (ret)
+		goto error_free;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &s5k4h7_ctrl_ops, &props);
+	if (ret)
+		goto error_free;
+
+	s5k4h7->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error_free:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int s5k4h7_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct s5k4h7 *s5k4h7 = to_s5k4h7(sd);
+	const struct s5k4h7_reg_list *reg_list = &s5k4h7->mode->reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5k4h7->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(s5k4h7->regmap, s5k4h7_init_regs,
+			    ARRAY_SIZE(s5k4h7_init_regs), &ret);
+	cci_multi_reg_write(s5k4h7->regmap, reg_list->regs,
+			    reg_list->num_regs, &ret);
+	if (ret)
+		goto error;
+
+	ret = __v4l2_ctrl_handler_setup(s5k4h7->sd.ctrl_handler);
+	if (ret)
+		goto error;
+
+	ret = cci_write(s5k4h7->regmap, S5K4H7_REG_MODE_SELECT,
+			S5K4H7_MODE_STREAMING, NULL);
+	if (ret)
+		goto error;
+
+	/* The flips change the Bayer order, so they are fixed while streaming */
+	__v4l2_ctrl_grab(s5k4h7->hflip, true);
+	__v4l2_ctrl_grab(s5k4h7->vflip, true);
+
+	return 0;
+
+error:
+	dev_err(s5k4h7->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(s5k4h7->dev);
+
+	return ret;
+}
+
+static int s5k4h7_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct s5k4h7 *s5k4h7 = to_s5k4h7(sd);
+	int ret;
+
+	ret = cci_write(s5k4h7->regmap, S5K4H7_REG_MODE_SELECT, 0, NULL);
+	if (ret)
+		dev_err(s5k4h7->dev, "failed to stop streaming: %d\n", ret);
+
+	__v4l2_ctrl_grab(s5k4h7->hflip, false);
+	__v4l2_ctrl_grab(s5k4h7->vflip, false);
+
+	pm_runtime_put_autosuspend(s5k4h7->dev);
+
+	return ret;
+}
+
+static void s5k4h7_update_pad_format(struct s5k4h7 *s5k4h7,
+				     const struct s5k4h7_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = s5k4h7_get_format_code(s5k4h7);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k4h7_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k4h7 *s5k4h7 = to_s5k4h7(sd);
+	const struct s5k4h7_mode *mode;
+	s64 hblank, vblank;
+	int ret;
+
+	mode = v4l2_find_nearest_size(s5k4h7_modes, ARRAY_SIZE(s5k4h7_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+
+	s5k4h7_update_pad_format(s5k4h7, mode, &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	*v4l2_subdev_state_get_crop(state, 0) = mode->crop;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || s5k4h7->mode == mode)
+		return 0;
+
+	s5k4h7->mode = mode;
+
+	hblank = mode->hts - mode->width;
+	ret = __v4l2_ctrl_modify_range(s5k4h7->hblank, hblank, hblank, 1,
+				       hblank);
+	if (ret)
+		return ret;
+
+	vblank = mode->vts - mode->height;
+	ret = __v4l2_ctrl_modify_range(s5k4h7->vblank, vblank,
+				       S5K4H7_FRAME_LENGTH_MAX - mode->height,
+				       1, vblank);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(s5k4h7->vblank, vblank);
+	if (ret)
+		return ret;
+
+	/* s_ctrl does not run when VBLANK keeps its value; the height changed */
+	s5k4h7_update_exposure_range(s5k4h7, s5k4h7->vblank->val);
+
+	return 0;
+}
+
+static int s5k4h7_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct s5k4h7 *s5k4h7 = to_s5k4h7(sd);
+
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = s5k4h7_get_format_code(s5k4h7);
+
+	return 0;
+}
+
+static int s5k4h7_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct s5k4h7 *s5k4h7 = to_s5k4h7(sd);
+
+	if (fse->index >= ARRAY_SIZE(s5k4h7_modes))
+		return -EINVAL;
+
+	if (fse->code != s5k4h7_get_format_code(s5k4h7))
+		return -EINVAL;
+
+	fse->min_width = s5k4h7_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = s5k4h7_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int s5k4h7_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = S5K4H7_NATIVE_WIDTH;
+		sel->r.height = S5K4H7_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int s5k4h7_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct s5k4h7 *s5k4h7 = to_s5k4h7(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = s5k4h7->mode->width,
+			.height = s5k4h7->mode->height,
+		},
+	};
+
+	return s5k4h7_set_pad_format(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops s5k4h7_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5k4h7_pad_ops = {
+	.set_fmt = s5k4h7_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = s5k4h7_get_selection,
+	.enum_mbus_code = s5k4h7_enum_mbus_code,
+	.enum_frame_size = s5k4h7_enum_frame_size,
+	.enable_streams = s5k4h7_enable_streams,
+	.disable_streams = s5k4h7_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5k4h7_subdev_ops = {
+	.video = &s5k4h7_video_ops,
+	.pad = &s5k4h7_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k4h7_internal_ops = {
+	.init_state = s5k4h7_init_state,
+};
+
+static const struct media_entity_operations s5k4h7_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int s5k4h7_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k4h7 *s5k4h7 = to_s5k4h7(sd);
+	unsigned int i;
+	int ret;
+
+	gpiod_set_value_cansleep(s5k4h7->reset_gpio, 1);
+
+	for (i = 0; i < S5K4H7_NUM_SUPPLIES; i++) {
+		ret = regulator_enable(s5k4h7->supplies[i].consumer);
+		if (ret)
+			goto disable_supplies;
+		/* VANA, then VIO 2 ms later */
+		if (i == 0)
+			usleep_range(2000, 2500);
+	}
+	usleep_range(1000, 1500);
+
+	ret = clk_prepare_enable(s5k4h7->mclk);
+	if (ret)
+		goto disable_supplies;
+	usleep_range(1000, 1500);
+
+	gpiod_set_value_cansleep(s5k4h7->reset_gpio, 0);
+	/* The Windows driver waits 1 ms; leave the sensor some more time */
+	usleep_range(5000, 6000);
+
+	return 0;
+
+disable_supplies:
+	while (i--)
+		regulator_disable(s5k4h7->supplies[i].consumer);
+
+	return ret;
+}
+
+static int s5k4h7_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k4h7 *s5k4h7 = to_s5k4h7(sd);
+	unsigned int i;
+
+	gpiod_set_value_cansleep(s5k4h7->reset_gpio, 1);
+	usleep_range(1000, 1500);
+
+	clk_disable_unprepare(s5k4h7->mclk);
+
+	for (i = S5K4H7_NUM_SUPPLIES; i-- > 0;)
+		regulator_disable(s5k4h7->supplies[i].consumer);
+
+	return 0;
+}
+
+/*
+ * Boards that may carry either this sensor or another one on the same
+ * connector describe both in DT, so a missing sensor is not an error.
+ */
+static int s5k4h7_identify(struct s5k4h7 *s5k4h7)
+{
+	u8 buf[2];
+	u16 id;
+	int ret;
+
+	/*
+	 * Read through the regmap rather than cci_read(): when the board
+	 * carries the other module, nothing answers at this address, and
+	 * cci_read() would log that as an error on every boot.
+	 */
+	ret = regmap_bulk_read(s5k4h7->regmap,
+			       CCI_REG_ADDR(S5K4H7_REG_CHIP_ID), buf, 2);
+	if (ret) {
+		dev_info(s5k4h7->dev, "no sensor answers (%d)\n", ret);
+		return -ENODEV;
+	}
+
+	id = (buf[0] << 8) | buf[1];
+	if (id != S5K4H7_CHIP_ID) {
+		dev_info(s5k4h7->dev, "chip id 0x%04x is not an S5K4H7\n", id);
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+static bool s5k4h7_range_ok(u64 min, u64 max, u64 step)
+{
+	return min && step && min < max && max <= 0xffff;
+}
+
+/* Read the CCS limits, log them and use the ones that look sane */
+static void s5k4h7_read_limits(struct s5k4h7 *s5k4h7)
+{
+	u64 rev = 0, manuf = 0, order = 0, pedestal = 0, cap = 0, type = 0;
+	u64 amin = 0, amax = 0, astep = 0, m0 = 0, c0 = 0, m1 = 0, c1 = 0;
+	u64 cmin = 0, cmargin = 0;
+	int ret = 0;
+
+	cci_read(s5k4h7->regmap, S5K4H7_REG_REVISION, &rev, &ret);
+	cci_read(s5k4h7->regmap, S5K4H7_REG_MANUFACTURER, &manuf, &ret);
+	cci_read(s5k4h7->regmap, S5K4H7_REG_PIXEL_ORDER, &order, &ret);
+	cci_read(s5k4h7->regmap, S5K4H7_REG_DATA_PEDESTAL, &pedestal, &ret);
+	cci_read(s5k4h7->regmap, S5K4H7_REG_AGAIN_CAPABILITY, &cap, &ret);
+	cci_read(s5k4h7->regmap, S5K4H7_REG_AGAIN_CODE_MIN, &amin, &ret);
+	cci_read(s5k4h7->regmap, S5K4H7_REG_AGAIN_CODE_MAX, &amax, &ret);
+	cci_read(s5k4h7->regmap, S5K4H7_REG_AGAIN_CODE_STEP, &astep, &ret);
+	cci_read(s5k4h7->regmap, S5K4H7_REG_AGAIN_TYPE, &type, &ret);
+	cci_read(s5k4h7->regmap, S5K4H7_REG_AGAIN_M0, &m0, &ret);
+	cci_read(s5k4h7->regmap, S5K4H7_REG_AGAIN_C0, &c0, &ret);
+	cci_read(s5k4h7->regmap, S5K4H7_REG_AGAIN_M1, &m1, &ret);
+	cci_read(s5k4h7->regmap, S5K4H7_REG_AGAIN_C1, &c1, &ret);
+	cci_read(s5k4h7->regmap, S5K4H7_REG_COARSE_MIN, &cmin, &ret);
+	cci_read(s5k4h7->regmap, S5K4H7_REG_COARSE_MAX_MARGIN, &cmargin, &ret);
+	if (ret) {
+		dev_warn(s5k4h7->dev, "reading the CCS limits failed (%d)\n", ret);
+		return;
+	}
+
+	dev_dbg(s5k4h7->dev,
+		"rev 0x%02llx manuf 0x%02llx pixel_order %llu pedestal %llu again cap %llu code %llu..%llu step %llu type %llu m0 %lld c0 %lld m1 %lld c1 %lld coarse min %llu margin %llu\n",
+		rev, manuf, order, pedestal, cap, amin, amax, astep, type,
+		(s64)(s16)m0, (s64)(s16)c0, (s64)(s16)m1, (s64)(s16)c1,
+		cmin, cmargin);
+
+	if (order < ARRAY_SIZE(s5k4h7_mbus_formats))
+		s5k4h7->pixel_order = order;
+
+	if (s5k4h7_range_ok(amin, amax, astep)) {
+		s5k4h7->again_min = amin;
+		s5k4h7->again_max = amax;
+		s5k4h7->again_step = astep;
+	}
+
+	if (cmin && cmin < 64 && cmargin && cmargin < 64) {
+		s5k4h7->exposure_min = cmin;
+		s5k4h7->exposure_margin = cmargin;
+	}
+}
+
+static int s5k4h7_check_hwcfg(struct s5k4h7 *s5k4h7)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(s5k4h7->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5K4H7_DATA_LANES) {
+		dev_err(s5k4h7->dev, "%u data lanes, only 4 are supported\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s5k4h7->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       s5k4h7_link_freq_menu,
+				       ARRAY_SIZE(s5k4h7_link_freq_menu),
+				       &freq_bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static int s5k4h7_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct s5k4h7 *s5k4h7;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	s5k4h7 = devm_kzalloc(dev, sizeof(*s5k4h7), GFP_KERNEL);
+	if (!s5k4h7)
+		return -ENOMEM;
+
+	s5k4h7->dev = dev;
+	s5k4h7->pixel_order = 0;	/* GRBG until the sensor says otherwise */
+	s5k4h7->again_min = S5K4H7_AGAIN_MIN;
+	s5k4h7->again_max = S5K4H7_AGAIN_MAX;
+	s5k4h7->again_step = S5K4H7_AGAIN_STEP;
+	s5k4h7->exposure_min = S5K4H7_EXPOSURE_MIN;
+	s5k4h7->exposure_margin = S5K4H7_EXPOSURE_MARGIN;
+	v4l2_i2c_subdev_init(&s5k4h7->sd, client, &s5k4h7_subdev_ops);
+
+	s5k4h7->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k4h7->regmap))
+		return dev_err_probe(dev, PTR_ERR(s5k4h7->regmap),
+				     "failed to init CCI\n");
+
+	s5k4h7->mclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(s5k4h7->mclk))
+		return dev_err_probe(dev, PTR_ERR(s5k4h7->mclk),
+				     "failed to get MCLK\n");
+
+	freq = clk_get_rate(s5k4h7->mclk);
+	if (freq != S5K4H7_MCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "MCLK is %lu Hz, only 24 MHz is supported\n",
+				     freq);
+
+	ret = s5k4h7_check_hwcfg(s5k4h7);
+	if (ret)
+		return dev_err_probe(dev, ret, "bad endpoint configuration\n");
+
+	s5k4h7->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k4h7->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(s5k4h7->reset_gpio),
+				     "failed to get the reset GPIO\n");
+
+	for (i = 0; i < S5K4H7_NUM_SUPPLIES; i++)
+		s5k4h7->supplies[i].supply = s5k4h7_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, S5K4H7_NUM_SUPPLIES,
+				      s5k4h7->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get the supplies\n");
+
+	ret = s5k4h7_power_on(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to power on\n");
+
+	ret = s5k4h7_identify(s5k4h7);
+	if (ret)
+		goto power_off;
+
+	s5k4h7_read_limits(s5k4h7);
+
+	s5k4h7->mode = &s5k4h7_modes[0];
+	ret = s5k4h7_init_controls(s5k4h7);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	s5k4h7->sd.state_lock = s5k4h7->ctrl_handler.lock;
+	s5k4h7->sd.internal_ops = &s5k4h7_internal_ops;
+	s5k4h7->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k4h7->sd.entity.ops = &s5k4h7_entity_ops;
+	s5k4h7->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5k4h7->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5k4h7->sd.entity, 1, &s5k4h7->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init media entity\n");
+		goto free_ctrls;
+	}
+
+	ret = v4l2_subdev_init_finalize(&s5k4h7->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init subdev\n");
+		goto entity_cleanup;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5k4h7->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+
+	dev_info(dev, "S5K4H7 found, %u modes, Bayer %s\n",
+		 (unsigned int)ARRAY_SIZE(s5k4h7_modes),
+		 s5k4h7_pixel_order_names[s5k4h7->pixel_order]);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&s5k4h7->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+entity_cleanup:
+	media_entity_cleanup(&s5k4h7->sd.entity);
+free_ctrls:
+	v4l2_ctrl_handler_free(&s5k4h7->ctrl_handler);
+power_off:
+	s5k4h7_power_off(dev);
+
+	return ret;
+}
+
+static void s5k4h7_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k4h7 *s5k4h7 = to_s5k4h7(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(s5k4h7->dev);
+
+	if (!pm_runtime_status_suspended(s5k4h7->dev)) {
+		s5k4h7_power_off(s5k4h7->dev);
+		pm_runtime_set_suspended(s5k4h7->dev);
+	}
+}
+
+static const struct dev_pm_ops s5k4h7_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5k4h7_power_off, s5k4h7_power_on, NULL)
+};
+
+static const struct of_device_id s5k4h7_of_match[] = {
+	{ .compatible = "samsung,s5k4h7" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s5k4h7_of_match);
+
+static struct i2c_driver s5k4h7_i2c_driver = {
+	.driver = {
+		.name = "s5k4h7",
+		.pm = &s5k4h7_pm_ops,
+		.of_match_table = s5k4h7_of_match,
+	},
+	.probe = s5k4h7_probe,
+	.remove = s5k4h7_remove,
+};
+
+module_i2c_driver(s5k4h7_i2c_driver);
+
+MODULE_DESCRIPTION("Samsung S5K4H7 image sensor driver");
+MODULE_LICENSE("GPL");
