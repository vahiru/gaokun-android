+static inline struct s5k3l6 *to_s5k3l6(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct s5k3l6, sd);
+}
+
+static u32 s5k3l6_orientation(struct s5k3l6 *s5k3l6)
+{
+	return (s5k3l6->hflip->val ? S5K3L6_HFLIP : 0) |
+	       (s5k3l6->vflip->val ? S5K3L6_VFLIP : 0);
+}
+
+static u32 s5k3l6_get_format_code(struct s5k3l6 *s5k3l6)
+{
+	u32 flips = (s5k3l6->hflip->val ? 1 : 0) | (s5k3l6->vflip->val ? 2 : 0);
+
+	return s5k3l6_mbus_formats[s5k3l6->pixel_order ^ flips];
+}
+
+static void s5k3l6_update_exposure_range(struct s5k3l6 *s5k3l6, u32 vblank)
+{
+	s64 max = s5k3l6->mode->height + vblank - S5K3L6_EXPOSURE_MARGIN;
+
+	__v4l2_ctrl_modify_range(s5k3l6->exposure, s5k3l6->exposure_min, max,
+				 S5K3L6_EXPOSURE_STEP,
+				 min_t(s64, s5k3l6->mode->vts - S5K3L6_EXPOSURE_MARGIN, max));
+}
+
+/*
+ * The Windows settings give each mode a frame length, which is the default:
+ * 3260 lines, and 1630 for the 1080p mode. Both binned modes read a line, two
+ * sensor rows, in the same time, so the 2080x1560 mode's 3260 lines are mostly
+ * vertical blanking: it runs at 60 fps with 1634 lines. The other modes keep
+ * the Windows frame length as their shortest. The sensor's CCS minimum frame
+ * blanking (25 lines) is not usable: the sensor stops its output, until
+ * streaming restarts, with 25 lines of vertical blanking in the binned modes
+ * and with 40 in the modes 4160 columns wide (32 and 50 lines still work).
+ */
+static u32 s5k3l6_vblank_min(const struct s5k3l6_mode *mode)
+{
+	return mode->vts_min - mode->height;
+}
+
+static int s5k3l6_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k3l6 *s5k3l6 = container_of(ctrl->handler, struct s5k3l6,
+					     ctrl_handler);
+	int ret;
+
+	/*
+	 * LINK_FREQ, HBLANK and PIXEL_RATE follow the mode and have no
+	 * register of their own; set_fmt changes them while the sensor may
+	 * still be powered.
+	 */
+	if (ctrl->flags & V4L2_CTRL_FLAG_READ_ONLY)
+		return 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		s5k3l6_update_exposure_range(s5k3l6, ctrl->val);
+
+	/* Controls are written when the sensor is powered up for streaming */
+	if (!pm_runtime_get_if_active(s5k3l6->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(s5k3l6->regmap, S5K3L6_REG_ANALOG_GAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(s5k3l6->regmap, S5K3L6_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(s5k3l6->regmap, S5K3L6_REG_FRAME_LENGTH,
+				s5k3l6->mode->height + ctrl->val, NULL);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ret = cci_write(s5k3l6->regmap, S5K3L6_REG_ORIENTATION,
+				s5k3l6_orientation(s5k3l6), NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(s5k3l6->regmap, S5K3L6_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(s5k3l6->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k3l6_ctrl_ops = {
+	.s_ctrl = s5k3l6_set_ctrl,
+};
+
+static int s5k3l6_init_controls(struct s5k3l6 *s5k3l6)
+{
+	struct v4l2_ctrl_handler *hdl = &s5k3l6->ctrl_handler;
+	const struct s5k3l6_mode *mode = s5k3l6->mode;
+	struct v4l2_fwnode_device_properties props;
+	s64 hblank, vblank, exposure_max;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 11);
+
+	s5k3l6->link_freq = v4l2_ctrl_new_int_menu(hdl, &s5k3l6_ctrl_ops,
+						   V4L2_CID_LINK_FREQ,
+						   ARRAY_SIZE(s5k3l6_link_freq_menu) - 1,
+						   mode->link_freq_index,
+						   s5k3l6_link_freq_menu);
+	if (s5k3l6->link_freq)
+		s5k3l6->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5k3l6->pixel_rate = v4l2_ctrl_new_std(hdl, &s5k3l6_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       S5K3L6_PIXEL_RATE,
+					       S5K3L6_PIXEL_RATE, 1,
+					       S5K3L6_PIXEL_RATE);
+
+	hblank = mode->hts - mode->width;
+	s5k3l6->hblank = v4l2_ctrl_new_std(hdl, &s5k3l6_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank, hblank, 1,
+					   hblank);
+	if (s5k3l6->hblank)
+		s5k3l6->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	s5k3l6->vblank = v4l2_ctrl_new_std(hdl, &s5k3l6_ctrl_ops,
+					   V4L2_CID_VBLANK,
+					   s5k3l6_vblank_min(mode),
+					   S5K3L6_FRAME_LENGTH_MAX - mode->height,
+					   1, vblank);
+
+	v4l2_ctrl_new_std(hdl, &s5k3l6_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  s5k3l6->again_min, s5k3l6->again_max,
+			  s5k3l6->again_step, s5k3l6->again_min);
+
+	exposure_max = mode->vts - S5K3L6_EXPOSURE_MARGIN;
+	s5k3l6->exposure = v4l2_ctrl_new_std(hdl, &s5k3l6_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     s5k3l6->exposure_min, exposure_max,
+					     S5K3L6_EXPOSURE_STEP,
+					     exposure_max);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &s5k3l6_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5k3l6_test_pattern_menu) - 1,
+				     0, 0, s5k3l6_test_pattern_menu);
+
+	s5k3l6->hflip = v4l2_ctrl_new_std(hdl, &s5k3l6_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (s5k3l6->hflip)
+		s5k3l6->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	s5k3l6->vflip = v4l2_ctrl_new_std(hdl, &s5k3l6_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (s5k3l6->vflip)
+		s5k3l6->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error_free;
+	}
+
+	ret = v4l2_fwnode_device_parse(s5k3l6->dev, &props);
+	if (ret)
+		goto error_free;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &s5k3l6_ctrl_ops, &props);
+	if (ret)
+		goto error_free;
+
+	s5k3l6->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error_free:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+static int s5k3l6_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+	const struct s5k3l6_reg_list *reg_list = &s5k3l6->mode->reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5k3l6->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(s5k3l6->regmap, s5k3l6_init_regs_a,
+			    ARRAY_SIZE(s5k3l6_init_regs_a), &ret);
+	if (ret)
+		goto error;
+	usleep_range(10, 20);
+	cci_multi_reg_write(s5k3l6->regmap, s5k3l6_init_regs_b,
+			    ARRAY_SIZE(s5k3l6_init_regs_b), &ret);
+	cci_multi_reg_write(s5k3l6->regmap, reg_list->regs,
+			    reg_list->num_regs, &ret);
+	if (ret)
+		goto error;
+
+	ret = __v4l2_ctrl_handler_setup(s5k3l6->sd.ctrl_handler);
+	if (ret)
+		goto error;
+
+	/*
+	 * The Windows driver starts streaming with a 16-bit write that also sets
+	 * image_orientation; keep the flips the controls set.
+	 */
+	cci_write(s5k3l6->regmap, S5K3L6_REG_STREAM_CTRL, 1, &ret);
+	cci_write(s5k3l6->regmap, S5K3L6_REG_MODE_ORIENTATION,
+		  (S5K3L6_MODE_STREAMING << 8) | s5k3l6_orientation(s5k3l6), &ret);
+	cci_write(s5k3l6->regmap, S5K3L6_REG_STREAM_CTRL, 0, &ret);
+	if (ret)
+		goto error;
+
+	/* The flips change the Bayer order, so they are fixed while streaming */
+	__v4l2_ctrl_grab(s5k3l6->hflip, true);
+	__v4l2_ctrl_grab(s5k3l6->vflip, true);
+
+	return 0;
+
+error:
+	dev_err(s5k3l6->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(s5k3l6->dev);
+
+	return ret;
+}
+
+static int s5k3l6_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+	int ret;
+
+	ret = cci_write(s5k3l6->regmap, S5K3L6_REG_MODE_SELECT, 0, NULL);
+	if (ret)
+		dev_err(s5k3l6->dev, "failed to stop streaming: %d\n", ret);
+
+	__v4l2_ctrl_grab(s5k3l6->hflip, false);
+	__v4l2_ctrl_grab(s5k3l6->vflip, false);
+
+	pm_runtime_put_autosuspend(s5k3l6->dev);
+
+	return ret;
+}
+
+static void s5k3l6_update_pad_format(struct s5k3l6 *s5k3l6,
+				     const struct s5k3l6_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = s5k3l6_get_format_code(s5k3l6);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k3l6_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+	const struct s5k3l6_mode *mode;
+	s64 hblank, vblank;
+	int ret;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE &&
+	    v4l2_subdev_is_streaming(sd))
+		return -EBUSY;
+
+	mode = v4l2_find_nearest_size(s5k3l6_modes, ARRAY_SIZE(s5k3l6_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+
+	s5k3l6_update_pad_format(s5k3l6, mode, &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	*v4l2_subdev_state_get_crop(state, 0) = mode->crop;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || s5k3l6->mode == mode)
+		return 0;
+
+	s5k3l6->mode = mode;
+
+	ret = __v4l2_ctrl_s_ctrl(s5k3l6->link_freq, mode->link_freq_index);
+	if (ret)
+		return ret;
+
+	hblank = mode->hts - mode->width;
+	ret = __v4l2_ctrl_modify_range(s5k3l6->hblank, hblank, hblank, 1,
+				       hblank);
+	if (ret)
+		return ret;
+
+	vblank = mode->vts - mode->height;
+	ret = __v4l2_ctrl_modify_range(s5k3l6->vblank,
+				       s5k3l6_vblank_min(mode),
+				       S5K3L6_FRAME_LENGTH_MAX - mode->height,
+				       1, vblank);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(s5k3l6->vblank, vblank);
+	if (ret)
+		return ret;
+
+	/* s_ctrl does not run when VBLANK keeps its value; the height changed */
+	s5k3l6_update_exposure_range(s5k3l6, s5k3l6->vblank->val);
+
+	return 0;
+}
+
+static int s5k3l6_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = s5k3l6_get_format_code(s5k3l6);
+
+	return 0;
+}
+
+static int s5k3l6_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+
+	if (fse->index >= ARRAY_SIZE(s5k3l6_modes))
+		return -EINVAL;
+
+	if (fse->code != s5k3l6_get_format_code(s5k3l6))
+		return -EINVAL;
+
+	fse->min_width = s5k3l6_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = s5k3l6_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int s5k3l6_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r = s5k3l6_default_crop;
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = S5K3L6_NATIVE_WIDTH;
+		sel->r.height = S5K3L6_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int s5k3l6_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = s5k3l6->mode->width,
+			.height = s5k3l6->mode->height,
+		},
+	};
+
+	return s5k3l6_set_pad_format(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops s5k3l6_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5k3l6_pad_ops = {
+	.set_fmt = s5k3l6_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = s5k3l6_get_selection,
+	.enum_mbus_code = s5k3l6_enum_mbus_code,
+	.enum_frame_size = s5k3l6_enum_frame_size,
+	.enable_streams = s5k3l6_enable_streams,
+	.disable_streams = s5k3l6_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5k3l6_subdev_ops = {
+	.video = &s5k3l6_video_ops,
+	.pad = &s5k3l6_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k3l6_internal_ops = {
+	.init_state = s5k3l6_init_state,
+};
+
+static const struct media_entity_operations s5k3l6_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+/*
+ * The Windows sequence for this module: reset asserted, VANA, VDIG, VIO 1 ms
+ * apart, MCLK, then reset released and 18 ms before the first access. VANA is
+ * LDO2_B, which the panel's VDDI also uses at 1.8 V: request 2.8 V while the
+ * sensor is powered, the regulator core applies the highest request.
+ */
+static int s5k3l6_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+	unsigned int i;
+	int ret;
+
+	gpiod_set_value_cansleep(s5k3l6->reset_gpio, 1);
+
+	ret = regulator_set_voltage(s5k3l6->supplies[0].consumer, 2800000,
+				    2800000);
+	if (ret) {
+		dev_err(dev, "vdda: cannot request 2.8 V: %d\n", ret);
+		return ret;
+	}
+
+	for (i = 0; i < S5K3L6_NUM_SUPPLIES; i++) {
+		ret = regulator_enable(s5k3l6->supplies[i].consumer);
+		if (ret)
+			goto disable_supplies;
+		usleep_range(1000, 1500);
+	}
+
+	ret = clk_prepare_enable(s5k3l6->mclk);
+	if (ret)
+		goto disable_supplies;
+	usleep_range(1000, 1500);
+
+	gpiod_set_value_cansleep(s5k3l6->reset_gpio, 0);
+	usleep_range(18000, 20000);
+
+	return 0;
+
+disable_supplies:
+	while (i--)
+		regulator_disable(s5k3l6->supplies[i].consumer);
+	regulator_set_voltage(s5k3l6->supplies[0].consumer, 1800000, 2800000);
+
+	return ret;
+}
+
+static int s5k3l6_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+	unsigned int i;
+
+	gpiod_set_value_cansleep(s5k3l6->reset_gpio, 1);
+	usleep_range(1000, 1500);
+
+	clk_disable_unprepare(s5k3l6->mclk);
+
+	for (i = S5K3L6_NUM_SUPPLIES; i-- > 0;)
+		regulator_disable(s5k3l6->supplies[i].consumer);
+
+	/* Hand the 2.8 V request back so LDO2_B returns to the panel's 1.8 V */
+	regulator_set_voltage(s5k3l6->supplies[0].consumer, 1800000, 2800000);
+
+	return 0;
+}
+
+static int s5k3l6_identify(struct s5k3l6 *s5k3l6)
+{
+	u64 id;
+	int ret;
+
+	ret = cci_read(s5k3l6->regmap, S5K3L6_REG_CHIP_ID, &id, NULL);
+	if (ret)
+		return dev_err_probe(s5k3l6->dev, ret,
+				     "failed to read the chip id\n");
+
+	if (id != S5K3L6_CHIP_ID)
+		return dev_err_probe(s5k3l6->dev, -ENODEV,
+				     "chip id 0x%04llx is not an S5K3L6\n", id);
+
+	return 0;
+}
+
+static bool s5k3l6_range_ok(u64 min, u64 max, u64 step)
+{
+	return min && step && min < max && max <= 0xffff;
+}
+
+/* Read the CCS limits, log them and use the ones that look sane */
+static void s5k3l6_read_limits(struct s5k3l6 *s5k3l6)
+{
+	u64 rev = 0, manuf = 0, order = 0, pedestal = 0, cap = 0, type = 0;
+	u64 amin = 0, amax = 0, astep = 0, m0 = 0, c0 = 0, m1 = 0, c1 = 0;
+	u64 cmin = 0, cmargin = 0;
+	int ret = 0;
+
+	cci_read(s5k3l6->regmap, S5K3L6_REG_REVISION, &rev, &ret);
+	cci_read(s5k3l6->regmap, S5K3L6_REG_MANUFACTURER, &manuf, &ret);
+	cci_read(s5k3l6->regmap, S5K3L6_REG_PIXEL_ORDER, &order, &ret);
+	cci_read(s5k3l6->regmap, S5K3L6_REG_DATA_PEDESTAL, &pedestal, &ret);
+	cci_read(s5k3l6->regmap, S5K3L6_REG_AGAIN_CAPABILITY, &cap, &ret);
+	cci_read(s5k3l6->regmap, S5K3L6_REG_AGAIN_CODE_MIN, &amin, &ret);
+	cci_read(s5k3l6->regmap, S5K3L6_REG_AGAIN_CODE_MAX, &amax, &ret);
+	cci_read(s5k3l6->regmap, S5K3L6_REG_AGAIN_CODE_STEP, &astep, &ret);
+	cci_read(s5k3l6->regmap, S5K3L6_REG_AGAIN_TYPE, &type, &ret);
+	cci_read(s5k3l6->regmap, S5K3L6_REG_AGAIN_M0, &m0, &ret);
+	cci_read(s5k3l6->regmap, S5K3L6_REG_AGAIN_C0, &c0, &ret);
+	cci_read(s5k3l6->regmap, S5K3L6_REG_AGAIN_M1, &m1, &ret);
+	cci_read(s5k3l6->regmap, S5K3L6_REG_AGAIN_C1, &c1, &ret);
+	cci_read(s5k3l6->regmap, S5K3L6_REG_COARSE_MIN, &cmin, &ret);
+	cci_read(s5k3l6->regmap, S5K3L6_REG_COARSE_MAX_MARGIN, &cmargin, &ret);
+	if (ret) {
+		dev_warn(s5k3l6->dev, "reading the CCS limits failed (%d)\n", ret);
+		return;
+	}
+
+	dev_dbg(s5k3l6->dev,
+		"rev 0x%02llx manuf 0x%02llx pixel_order %llu pedestal %llu again cap %llu code %llu..%llu step %llu type %llu m0 %lld c0 %lld m1 %lld c1 %lld coarse min %llu margin %llu\n",
+		rev, manuf, order, pedestal, cap, amin, amax, astep, type,
+		(s64)(s16)m0, (s64)(s16)c0, (s64)(s16)m1, (s64)(s16)c1,
+		cmin, cmargin);
+
+	if (order < ARRAY_SIZE(s5k3l6_mbus_formats))
+		s5k3l6->pixel_order = order;
+
+	if (s5k3l6_range_ok(amin, amax, astep)) {
+		s5k3l6->again_min = amin;
+		s5k3l6->again_max = amax;
+		s5k3l6->again_step = astep;
+	}
+
+	if (cmin && cmin < 64)
+		s5k3l6->exposure_min = cmin;
+}
+
+static int s5k3l6_check_hwcfg(struct s5k3l6 *s5k3l6)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(s5k3l6->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5K3L6_DATA_LANES) {
+		dev_err(s5k3l6->dev, "%u data lanes, only 4 are supported\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s5k3l6->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       s5k3l6_link_freq_menu,
+				       ARRAY_SIZE(s5k3l6_link_freq_menu),
+				       &freq_bitmap);
+	/* Each mode runs at its own link frequency */
+	if (!ret && freq_bitmap != GENMASK(ARRAY_SIZE(s5k3l6_link_freq_menu) - 1, 0)) {
+		dev_err(s5k3l6->dev,
+			"the endpoint must list 600, 284 and 260 MHz\n");
+		ret = -EINVAL;
+	}
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static int s5k3l6_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct s5k3l6 *s5k3l6;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	s5k3l6 = devm_kzalloc(dev, sizeof(*s5k3l6), GFP_KERNEL);
+	if (!s5k3l6)
+		return -ENOMEM;
+
+	s5k3l6->dev = dev;
+	s5k3l6->pixel_order = 0;	/* GRBG until the sensor says otherwise */
+	s5k3l6->again_min = S5K3L6_AGAIN_MIN;
+	s5k3l6->again_max = S5K3L6_AGAIN_MAX;
+	s5k3l6->again_step = S5K3L6_AGAIN_STEP;
+	s5k3l6->exposure_min = S5K3L6_EXPOSURE_MIN;
+	v4l2_i2c_subdev_init(&s5k3l6->sd, client, &s5k3l6_subdev_ops);
+
+	s5k3l6->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k3l6->regmap))
+		return dev_err_probe(dev, PTR_ERR(s5k3l6->regmap),
+				     "failed to init CCI\n");
+
+	s5k3l6->mclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(s5k3l6->mclk))
+		return dev_err_probe(dev, PTR_ERR(s5k3l6->mclk),
+				     "failed to get MCLK\n");
+
+	freq = clk_get_rate(s5k3l6->mclk);
+	if (freq != S5K3L6_MCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "MCLK runs at %lu Hz, not 24 MHz\n", freq);
+
+	ret = s5k3l6_check_hwcfg(s5k3l6);
+	if (ret)
+		return dev_err_probe(dev, ret, "bad endpoint configuration\n");
+
+	s5k3l6->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k3l6->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(s5k3l6->reset_gpio),
+				     "failed to get the reset GPIO\n");
+
+	for (i = 0; i < S5K3L6_NUM_SUPPLIES; i++)
+		s5k3l6->supplies[i].supply = s5k3l6_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, S5K3L6_NUM_SUPPLIES,
+				      s5k3l6->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get the supplies\n");
+
+	ret = s5k3l6_power_on(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to power on\n");
+
+	ret = s5k3l6_identify(s5k3l6);
+	if (ret)
+		goto power_off;
+
+	s5k3l6_read_limits(s5k3l6);
+
+	s5k3l6->mode = &s5k3l6_modes[0];
+	ret = s5k3l6_init_controls(s5k3l6);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	s5k3l6->sd.state_lock = s5k3l6->ctrl_handler.lock;
+	s5k3l6->sd.internal_ops = &s5k3l6_internal_ops;
+	s5k3l6->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k3l6->sd.entity.ops = &s5k3l6_entity_ops;
+	s5k3l6->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5k3l6->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5k3l6->sd.entity, 1, &s5k3l6->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init media entity\n");
+		goto free_ctrls;
+	}
+
+	ret = v4l2_subdev_init_finalize(&s5k3l6->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init subdev\n");
+		goto entity_cleanup;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5k3l6->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+
+	dev_info(dev, "S5K3L6 found, %u modes, Bayer %s\n",
+		 (unsigned int)ARRAY_SIZE(s5k3l6_modes),
+		 s5k3l6_pixel_order_names[s5k3l6->pixel_order]);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&s5k3l6->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+entity_cleanup:
+	media_entity_cleanup(&s5k3l6->sd.entity);
+free_ctrls:
+	v4l2_ctrl_handler_free(&s5k3l6->ctrl_handler);
+power_off:
+	s5k3l6_power_off(dev);
+
+	return ret;
+}
+
+static void s5k3l6_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(s5k3l6->dev);
+
+	if (!pm_runtime_status_suspended(s5k3l6->dev)) {
+		s5k3l6_power_off(s5k3l6->dev);
+		pm_runtime_set_suspended(s5k3l6->dev);
+	}
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(s5k3l6_pm_ops, s5k3l6_power_off,
+				 s5k3l6_power_on, NULL);
+
+static const struct of_device_id s5k3l6_of_match[] = {
+	{ .compatible = "samsung,s5k3l6" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s5k3l6_of_match);
+
+static struct i2c_driver s5k3l6_i2c_driver = {
+	.driver = {
+		.name = "s5k3l6",
+		.pm = pm_ptr(&s5k3l6_pm_ops),
+		.of_match_table = s5k3l6_of_match,
+	},
+	.probe = s5k3l6_probe,
+	.remove = s5k3l6_remove,
+};
+
+module_i2c_driver(s5k3l6_i2c_driver);
+
+MODULE_DESCRIPTION("Samsung S5K3L6 image sensor driver");
+MODULE_LICENSE("GPL");
