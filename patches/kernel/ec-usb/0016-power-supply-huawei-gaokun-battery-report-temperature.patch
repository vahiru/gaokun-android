From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] power: supply: huawei-gaokun-battery: report battery temperature

Word 0x9c in the EC battery status block reports the battery temperature
in tenths of a Kelvin (e.g. 0x0b96..0x0bb3 = 2966..2995 = 23.5..26.4 C
at room temperature, rising monotonically during charging and heavy load).

Expose POWER_SUPPLY_PROP_TEMP in tenths of a degree Celsius (raw - 2731)
and reject values outside [-40.0 C, 120.0 C] with -ENODATA so that an
uninitialized (0x0000) or failed (0xffff) read cannot trigger an
emergency over-temperature shutdown in userspace.

Tested on MateBook E Go (SC8280XP): /sys/class/power_supply/gaokun-ec-battery/temp
and Android dumpsys battery report the battery temperature in 0.1 C
(e.g. w9c=0x0bb5 -> 266 = 26.6 C).

Origin: local
Upstream-Status: Pending
---
 drivers/power/supply/huawei-gaokun-battery.c | 29 ++++++++++++++++++--
 1 file changed, 26 insertions(+), 3 deletions(-)

diff --git a/drivers/power/supply/huawei-gaokun-battery.c b/drivers/power/supply/huawei-gaokun-battery.c
index 0800d43..c4e8a91 100644
--- a/drivers/power/supply/huawei-gaokun-battery.c
+++ b/drivers/power/supply/huawei-gaokun-battery.c
@@ -51,7 +51,7 @@
 #define EC_BAT_FULL_CAPACITY	0x96
 /* 0x98: ? */
 #define EC_BAT_CURRENT		0x9A
-/* 0x9C: ? */
+#define EC_BAT_TEMP		0x9C
 
 #define EC_BAT_INFO_START	0xA0
 /* 0xA0: POWER_SUPPLY_PROP_INPUT_VOLTAGE_LIMIT? */
@@ -75,6 +75,10 @@
 
 #define MILLI_TO_MICRO		1000
 
+#define KELVIN_OFFSET		2731
+#define EC_BAT_TEMP_MIN		(KELVIN_OFFSET - 400)	/* -40.0 C */
+#define EC_BAT_TEMP_MAX		(KELVIN_OFFSET + 1200)	/* 120.0 C */
+
 #define SMART_CHARGE_MODE	0
 #define SMART_CHARGE_DELAY	1
 #define SMART_CHARGE_START	2
@@ -100,7 +104,7 @@ struct gaokun_psy_bat_status {
 	__le16 full_capacity;
 	__le16 unknown1;
 	__le16 rate_now;
-	__le16 unknown2;	/* 0x9C */
+	__le16 temp_now;	/* 0x9C, 0.1 K */
 } __packed;
 
 struct gaokun_psy_bat_info {
@@ -309,6 +313,17 @@ static int gaokun_psy_capacity_level(struct gaokun_psy *ecbat)
 	return POWER_SUPPLY_CAPACITY_LEVEL_NORMAL;
 }
 
+static int gaokun_psy_get_temp(struct gaokun_psy *ecbat, int *temp)
+{
+	u16 raw = le16_to_cpu(ecbat->status.temp_now);
+
+	if (raw < EC_BAT_TEMP_MIN || raw > EC_BAT_TEMP_MAX)
+		return -ENODATA;
+
+	*temp = (int)raw - KELVIN_OFFSET;
+	return 0;
+}
+
 static int gaokun_psy_get_bat_status(struct gaokun_psy *ecbat)
 {
 	/* _BST */
@@ -423,6 +438,12 @@ static int gaokun_psy_get_bat_property(struct power_supply *psy,
 		val->intval = gaokun_psy_capacity_level(ecbat);
 		break;
 
+	case POWER_SUPPLY_PROP_TEMP:
+		ret = gaokun_psy_get_temp(ecbat, &val->intval);
+		if (ret)
+			return ret;
+		break;
+
 	case POWER_SUPPLY_PROP_MODEL_NAME:
 		val->strval = ecbat->battery_model;
 		break;
@@ -503,6 +524,7 @@ static enum power_supply_property gaokun_psy_bat_props[] = {
 	POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD,
 	POWER_SUPPLY_PROP_CAPACITY,
 	POWER_SUPPLY_PROP_CAPACITY_LEVEL,
+	POWER_SUPPLY_PROP_TEMP,
 	POWER_SUPPLY_PROP_MODEL_NAME,
 	POWER_SUPPLY_PROP_MANUFACTURER,
 	POWER_SUPPLY_PROP_SERIAL_NUMBER,
@@ -648,7 +670,7 @@ static ssize_t ec_raw_show(struct device *dev, struct device_attribute *attr,
 	return sysfs_emit(buf, "status=0x%02x w98=0x%04x w9c=0x%04x wa0=0x%04x\n",
 			  ecbat->bat_status_raw,
 			  le16_to_cpu(ecbat->status.unknown1),
-			  le16_to_cpu(ecbat->status.unknown2),
+			  le16_to_cpu(ecbat->status.temp_now),
 			  le16_to_cpu(ecbat->info.unknown3));
 }
 
