Subject: [PATCH] =?UTF-8?q?platform:=20arm64:=20huawei-gaokun-ec:=20report?=
 =?UTF-8?q?=20the=20initial=20lid=20state=20at=20probe=EF=BC=88=E6=9C=AC?=
 =?UTF-8?q?=E5=9C=B0=EF=BC=8C1.0=20=E6=89=B9=202=20DISP-1=EF=BC=89?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

案卷：docs/v1.0-plan.md 的 DISP-1（内核那一半，"EC 初始 LID 状态"）。**本地补丁**。

问题：驱动注册 "LID" 输入设备（SW_LID）时既不读也不报当前状态，只在 EC_EVENT_LID 中断里
上报。input 层的初值是 0（开着），所以开机时盖子是合着的，输入层和 Android 都会一直以为
开着，直到下一次开合。现在没人用这个开关所以无害；DISP-1 打开 config_lidControlsSleep 之后
就会是"合着盖开机、屏幕不灭"。

改法：input_register_device() 之后、申请中断之前，用中断里同一个读法
（gaokun_ec_psy_read_byte(EC_LID_STATE) & EC_LID_OPEN）读一次，设好 lid_opened 并补报一次
SW_LID + sync。放在申请中断之前，lid_opened 不会和中断线程抢。读失败就保持原假设（开着），
只打一条 warn；读成功打一行 info，开机 dmesg 里能直接看到初值。

没动：resume 里"Resume may be unstable, so open lid anyways"（无条件报开）。合着盖被别的唤醒源
（闹钟等）唤醒时它会报一次"开盖"—— 打开 lidControlsSleep 之后要一起测（DISP-1 的 ROM 一半）。

⬜ 实机（用户在场）：合着盖开机 → dmesg 有 "initial lid state: closed"、`dumpsys input` 里
LID 那台设备的 SwitchValues 带 SW_LID 位；开着盖开机 → "open"、SwitchValues 0。
---
 drivers/platform/arm64/huawei-gaokun-ec.c | 28 +++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/drivers/platform/arm64/huawei-gaokun-ec.c b/drivers/platform/arm64/huawei-gaokun-ec.c
index e9c4e72..4c74447 100644
--- a/drivers/platform/arm64/huawei-gaokun-ec.c
+++ b/drivers/platform/arm64/huawei-gaokun-ec.c
@@ -764,6 +764,32 @@ static irqreturn_t gaokun_ec_irq_handler(int irq, void *data)
 	return IRQ_HANDLED;
 }
 
+/*
+ * 开机时盖子的状态。原实现只在 EC_EVENT_LID 事件里上报 SW_LID，注册时既不读
+ * 也不报，于是开机时盖子是合着的，输入层（和 Android 的 lid 逻辑）会一直以为
+ * 开着，直到下一次开合（1.0 计划 DISP-1）。读法与中断里的完全相同；放在申请
+ * 中断之前，lid_opened 不会和中断线程抢。读失败就保持原来的假设（开着）。
+ */
+static void gaokun_ec_report_initial_lid(struct gaokun_ec *ec)
+{
+	u8 status;
+	int ret;
+
+	ret = gaokun_ec_psy_read_byte(ec, EC_LID_STATE, &status);
+	if (ret) {
+		dev_warn(&ec->client->dev,
+			 "failed to read initial lid state (%d), assuming open\n", ret);
+		ec->lid_opened = true;
+		return;
+	}
+
+	ec->lid_opened = !!(status & EC_LID_OPEN);
+	input_report_switch(ec->idev, SW_LID, !ec->lid_opened);
+	input_sync(ec->idev);
+	dev_info(&ec->client->dev, "initial lid state: %s (0x%02x)\n",
+		 ec->lid_opened ? "open" : "closed", status);
+}
+
 static int gaokun_ec_probe(struct i2c_client *client)
 {
 	struct device *dev = &client->dev;
@@ -802,6 +828,8 @@ static int gaokun_ec_probe(struct i2c_client *client)
 	if (ret)
 		return dev_err_probe(dev, ret, "Failed to register input device\n");
 
+	gaokun_ec_report_initial_lid(ec);
+
 	ret = gaokun_aux_init(dev, GAOKUN_DEV_PSY, ec);
 	if (ret)
 		return ret;
