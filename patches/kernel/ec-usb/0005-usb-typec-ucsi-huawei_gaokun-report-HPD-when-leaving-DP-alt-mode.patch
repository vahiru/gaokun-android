From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] usb: typec: ucsi: huawei_gaokun: Report HPD when leaving DP alt mode

Since mode switching was added, gaokun_ucsi_handle_usb_mode() only
notifies the DP HPD bridge while the port reports the DisplayPort SVID.
When a DP adapter is unplugged, the EC reports the port with no mux
(SVID 0) instead, so the disconnect is never sent and the DP connector
stays connected until a later event happens to carry the DP SVID.

Meanwhile the display driver keeps the stale connector's display
pipeline, and a display connected to the other port can fail to get the
hardware resources it needs (atomic commit returns -ENAVAIL).

Remember the last HPD state sent to the bridge, and also send it when
the port leaves DP alt mode with HPD still reported as connected.

Fixes: 1c2b66a7d725 ("usb: ucsi: huawei_gaokun: support mode switching")
Cc: stable@vger.kernel.org
Assisted-by: Claude:claude-opus-5-5
---
 drivers/usb/typec/ucsi/ucsi_huawei_gaokun.c | 22 +++++++++++++++------
 1 file changed, 16 insertions(+), 6 deletions(-)

diff --git a/drivers/usb/typec/ucsi/ucsi_huawei_gaokun.c b/drivers/usb/typec/ucsi/ucsi_huawei_gaokun.c
index 04608af..fa1775f 100644
--- a/drivers/usb/typec/ucsi/ucsi_huawei_gaokun.c
+++ b/drivers/usb/typec/ucsi/ucsi_huawei_gaokun.c
@@ -98,6 +98,7 @@ struct gaokun_ucsi_port {
 	u16 svid;
 	u8 hpd_state;
 	u8 hpd_irq;
+	bool hpd_reported; /* last HPD state sent to the DP bridge */
 };
 
 struct gaokun_ucsi {
@@ -317,12 +318,21 @@ static void gaokun_ucsi_handle_usb_mode(struct gaokun_ucsi_port *port)
 	if (ret)
 		dev_err(uec->dev, "failed to set mux %d\n", ret);
 
-	/* UCSI callback .connector_status() have set orientation */
-	if (port->bridge && port->svid == USB_TYPEC_DP_SID)
-		drm_aux_hpd_bridge_notify(&port->bridge->dev,
-					  port->hpd_state ?
-					  connector_status_connected :
-					  connector_status_disconnected);
+	/*
+	 * UCSI callback .connector_status() have set orientation. Report HPD
+	 * while in DP alt mode, and once more when the port leaves it (unplug
+	 * or a switch to USB), or the connector stays connected.
+	 */
+	if (port->bridge) {
+		bool hpd = port->svid == USB_TYPEC_DP_SID && port->hpd_state;
+
+		if (port->svid == USB_TYPEC_DP_SID || port->hpd_reported != hpd) {
+			drm_aux_hpd_bridge_notify(&port->bridge->dev,
+						  hpd ? connector_status_connected :
+							connector_status_disconnected);
+			port->hpd_reported = hpd;
+		}
+	}
 
 	gaokun_ec_ucsi_pan_ack(uec->ec, port->idx);
 }
