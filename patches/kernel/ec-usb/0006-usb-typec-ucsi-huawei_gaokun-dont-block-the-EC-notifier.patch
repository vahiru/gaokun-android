From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] usb: typec: ucsi: huawei_gaokun: Don't block the EC notifier

UCSI and USB events both reach this driver through the EC notifier
chain, which the EC driver calls from its threaded interrupt handler.
After a connector change, gaokun_ucsi_handle_no_usb_event() waits up to
two seconds in that handler for the USB event that should follow. But
the USB event can only be read by the same handler once the wait is
over, so the wait always times out, the fallback runs, and all other EC
events (battery, lid, the next Type-C change) are held up for two
seconds. This repeats on every connector change until a USB event gets
through, after which the completions stay done. A system suspend that
starts during the wait is held up as well, as suspend_device_irqs()
waits for the threaded handler.

Run the fallback from delayed work instead, and cancel it when the USB
event arrives. Queue it on the freezable workqueue so that it does not
run during system suspend. As one run can now stand in for several
connector changes, let it handle every port that has an update. As
before, it is no longer armed once a USB event has been seen; a flag
replaces the per-port completions.

Fixes: 00327d7f2c8c ("usb: typec: ucsi: add Huawei Matebook E Go ucsi driver")
Cc: stable@vger.kernel.org
Assisted-by: Claude:claude-opus-5-5
---
 drivers/usb/typec/ucsi/ucsi_huawei_gaokun.c | 76 ++++++++++-----------
 1 file changed, 38 insertions(+), 38 deletions(-)

diff --git a/drivers/usb/typec/ucsi/ucsi_huawei_gaokun.c b/drivers/usb/typec/ucsi/ucsi_huawei_gaokun.c
index fa1775f..2d8b249 100644
--- a/drivers/usb/typec/ucsi/ucsi_huawei_gaokun.c
+++ b/drivers/usb/typec/ucsi/ucsi_huawei_gaokun.c
@@ -8,7 +8,6 @@
 #include <drm/bridge/aux-bridge.h>
 #include <linux/auxiliary_bus.h>
 #include <linux/bitops.h>
-#include <linux/completion.h>
 #include <linux/container_of.h>
 #include <linux/module.h>
 #include <linux/notifier.h>
@@ -19,7 +18,7 @@
 #include <linux/usb/typec_altmode.h>
 #include <linux/usb/typec_dp.h>
 #include <linux/usb/typec_mux.h>
-#include <linux/workqueue_types.h>
+#include <linux/workqueue.h>
 
 #include "ucsi.h"
 
@@ -81,7 +80,6 @@ struct gaokun_ucsi_reg {
 	(sizeof_field(struct gaokun_ucsi_reg, port_data) / GAOKUN_UCSI_BYTES_PER_PORT)
 
 struct gaokun_ucsi_port {
-	struct completion usb_ack;
 	spinlock_t lock; /* serializing port resource access */
 
 	struct gaokun_ucsi *ucsi;
@@ -107,10 +105,12 @@ struct gaokun_ucsi {
 	struct gaokun_ucsi_port *ports;
 	struct device *dev;
 	struct delayed_work work;
+	struct delayed_work usb_work; /* stands in for a missing USB event */
 	struct notifier_block nb;
 	u16 version;
 	u8 num_ports;
 	bool registered;
+	bool usb_events; /* the EC has sent a USB event */
 };
 
 /* -------------------------------------------------------------------------- */
@@ -337,53 +337,45 @@ static void gaokun_ucsi_handle_usb_mode(struct gaokun_ucsi_port *port)
 	gaokun_ec_ucsi_pan_ack(uec->ec, port->idx);
 }
 
-static void gaokun_ucsi_usb_notify_ind(struct gaokun_ucsi *uec)
+/* Returns whether a port had an update */
+static bool gaokun_ucsi_usb_notify_ind(struct gaokun_ucsi *uec)
 {
 	int idx;
 
 	if (!uec->ucsi->connector) { /* slow to register */
 		dev_err_ratelimited(uec->dev, "ucsi connector is not initialized yet\n");
-		return;
+		return false;
 	}
 
 	idx = gaokun_ucsi_refresh(uec);
-	if (idx == GAOKUN_UCSI_NO_PORT_UPDATE)
+	if (idx == GAOKUN_UCSI_NO_PORT_UPDATE) {
 		gaokun_ec_ucsi_pan_ack(uec->ec, idx); /* ack directly if no update */
-	else
-		gaokun_ucsi_handle_usb_mode(&uec->ports[idx]);
-}
-
-/*
- * When inserting, 2 UCSI events(connector change) are followed by USB events.
- * If we received one USB event, that means USB events are not blocked, so we
- * can complelte for all ports, and we should signal all events.
- */
-static void gaokun_ucsi_complete_usb_ack(struct gaokun_ucsi *uec)
-{
-	struct gaokun_ucsi_port *port;
-	int idx = 0;
-
-	while (idx < uec->num_ports) {
-		port = &uec->ports[idx++];
-		if (!completion_done(&port->usb_ack))
-			complete_all(&port->usb_ack);
+		return false;
 	}
+
+	gaokun_ucsi_handle_usb_mode(&uec->ports[idx]);
+	return true;
 }
 
 /*
  * USB event is necessary for enabling altmode, the event should follow
  * UCSI event, if not after timeout(this notify may be disabled somehow),
- * then force to enable altmode.
+ * then force to enable altmode. When inserting, 2 UCSI events (connector
+ * change) are followed by USB events. Once we have received one USB event,
+ * USB events are not blocked, and the fallback is no longer needed.
  */
-static void gaokun_ucsi_handle_no_usb_event(struct gaokun_ucsi *uec, int idx)
+static void gaokun_ucsi_usb_work(struct work_struct *work)
 {
-	struct gaokun_ucsi_port *port;
+	struct gaokun_ucsi *uec = container_of(work, struct gaokun_ucsi,
+					       usb_work.work);
+	int i;
 
-	port = &uec->ports[idx];
-	if (!wait_for_completion_timeout(&port->usb_ack, 2 * HZ)) {
-		dev_warn(uec->dev, "No USB EVENT, triggered by UCSI EVENT");
-		gaokun_ucsi_usb_notify_ind(uec);
-	}
+	dev_warn(uec->dev, "No USB EVENT, triggered by UCSI EVENT\n");
+
+	/* One update per call; this stands in for several UCSI events */
+	for (i = 0; i < uec->num_ports; i++)
+		if (!gaokun_ucsi_usb_notify_ind(uec))
+			break;
 }
 
 static int gaokun_ucsi_notify(struct notifier_block *nb,
@@ -395,7 +387,8 @@ static int gaokun_ucsi_notify(struct notifier_block *nb,
 
 	switch (action) {
 	case EC_EVENT_USB:
-		gaokun_ucsi_complete_usb_ack(uec);
+		uec->usb_events = true;
+		cancel_delayed_work_sync(&uec->usb_work);
 		gaokun_ucsi_usb_notify_ind(uec);
 		return NOTIFY_OK;
 
@@ -405,8 +398,14 @@ static int gaokun_ucsi_notify(struct notifier_block *nb,
 			return NOTIFY_DONE;
 
 		ucsi_notify_common(uec->ucsi, cci);
-		if (UCSI_CCI_CONNECTOR(cci))
-			gaokun_ucsi_handle_no_usb_event(uec, UCSI_CCI_CONNECTOR(cci) - 1);
+		/*
+		 * The USB event is delivered by the same EC IRQ thread that runs
+		 * this notifier, so it cannot be waited for here. Freezable, so
+		 * the fallback does not run during system suspend.
+		 */
+		if (UCSI_CCI_CONNECTOR(cci) && !uec->usb_events)
+			queue_delayed_work(system_freezable_wq, &uec->usb_work,
+					   2 * HZ);
 
 		return NOTIFY_OK;
 
@@ -442,7 +441,6 @@ static int gaokun_ucsi_ports_init(struct gaokun_ucsi *uec)
 		ucsi_port->ccx = USBC_CCX_NONE;
 		ucsi_port->idx = i;
 		ucsi_port->ucsi = uec;
-		init_completion(&ucsi_port->usb_ack);
 		spin_lock_init(&ucsi_port->lock);
 	}
 
@@ -529,6 +527,7 @@ static int gaokun_ucsi_probe(struct auxiliary_device *adev,
 	uec->nb.notifier_call = gaokun_ucsi_notify;
 
 	INIT_DELAYED_WORK(&uec->work, gaokun_ucsi_register_worker);
+	INIT_DELAYED_WORK(&uec->usb_work, gaokun_ucsi_usb_work);
 
 	ret = gaokun_ucsi_ports_init(uec);
 	if (ret)
@@ -553,10 +552,11 @@ static void gaokun_ucsi_remove(struct auxiliary_device *adev)
 	int i;
 
 	disable_delayed_work_sync(&uec->work);
-	if (uec->registered) {
+	if (uec->registered)
 		gaokun_ec_unregister_notify(uec->ec, &uec->nb);
+	disable_delayed_work_sync(&uec->usb_work);
+	if (uec->registered)
 		ucsi_unregister(uec->ucsi);
-	}
 
 	for (i = 0; i < uec->num_ports; ++i)
 		typec_mux_put(uec->ports[i].typec_mux);
