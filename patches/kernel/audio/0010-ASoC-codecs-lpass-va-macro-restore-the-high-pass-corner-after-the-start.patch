From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] ASoC: codecs: lpass-va-macro: restore the high-pass corner after the start

The reset value of the decimator's high-pass filter is 4 Hz. POST_PMU sets it
to 150 Hz so that the start-up step decays in about 10 ms instead of about
300 ms, and nothing sets it back, so every VA capture stays at 150 Hz and
loses the low end. The next capture also reads 150 Hz, so the original value
is gone after the first one.

Save the corner in POST_PMU and restore it from delayed work 300 ms later, the
delay of lpass-tx-macro and of Qualcomm's downstream va-macro. If the capture
stops first, restore it in PRE_PMD so that the next capture reads the right
value. Restoring after the step has decayed leaves a shift of about 0.002 of
full scale, below the low-frequency background; doing it inside the 40 ms mute
instead leaves a transient about 9 times larger.

Origin: local
Upstream-Status: Pending
---
--- a/sound/soc/codecs/lpass-va-macro.c
+++ b/sound/soc/codecs/lpass-va-macro.c
@@ -172,6 +172,7 @@
 #define VA_MACRO_SWR_MIC_MUX_SEL_MASK 0xF
 #define VA_MACRO_ADC_MUX_CFG_OFFSET 0x8
 #define VA_MACRO_UNMUTE_DELAY_MS 40
+#define VA_MACRO_HPF_DELAY_MS 300
 
 static const DECLARE_TLV_DB_SCALE(digital_gain, -8400, 100, -8400);
 
@@ -211,6 +212,13 @@ struct va_mute_work {
 	struct delayed_work dwork;
 };
 
+struct va_hpf_work {
+	struct va_macro *va;
+	u8 decimator;
+	u8 hpf_cut_off_freq;
+	struct delayed_work dwork;
+};
+
 struct va_macro {
 	struct device *dev;
 	unsigned long active_ch_mask[VA_MACRO_MAX_DAIS];
@@ -221,6 +229,7 @@ struct va_macro {
 
 	int dec_mode[VA_MACRO_NUM_DECIMATORS];
 	struct va_mute_work mute_dwork[VA_MACRO_NUM_DECIMATORS];
+	struct va_hpf_work hpf_dwork[VA_MACRO_NUM_DECIMATORS];
 	struct regmap *regmap;
 	struct clk *mclk;
 	struct clk *npl;
@@ -763,6 +772,34 @@ static void va_macro_mute_update_callback(struct work_struct *work)
 			   CDC_VA_TX_PATH_PGA_MUTE_DISABLE);
 }
 
+static void va_macro_hpf_set_corner(struct va_macro *va, u8 decimator,
+				    u8 hpf_cut_off_freq)
+{
+	u16 dec_cfg_reg = CDC_VA_TX0_TX_PATH_CFG0 +
+			  VA_MACRO_TX_PATH_OFFSET * decimator;
+	u16 hpf_gate_reg = CDC_VA_TX0_TX_PATH_SEC2 +
+			   VA_MACRO_TX_PATH_OFFSET * decimator;
+
+	regmap_update_bits(va->regmap, dec_cfg_reg, TX_HPF_CUT_OFF_FREQ_MASK,
+			   hpf_cut_off_freq << 5);
+	regmap_update_bits(va->regmap, hpf_gate_reg,
+			   CDC_VA_TX_HPF_CUTOFF_FREQ_CHANGE_MASK,
+			   CDC_VA_TX_HPF_CUTOFF_FREQ_CHANGE_REQ);
+	/* Minimum 1 clk cycle delay is required as per HW spec */
+	usleep_range(1000, 1010);
+	regmap_update_bits(va->regmap, hpf_gate_reg,
+			   CDC_VA_TX_HPF_CUTOFF_FREQ_CHANGE_MASK, 0);
+}
+
+static void va_macro_hpf_update_callback(struct work_struct *work)
+{
+	struct va_hpf_work *hpf_work = container_of(to_delayed_work(work),
+						    struct va_hpf_work, dwork);
+
+	va_macro_hpf_set_corner(hpf_work->va, hpf_work->decimator,
+				hpf_work->hpf_cut_off_freq);
+}
+
 static int va_macro_enable_dec(struct snd_soc_dapm_widget *w,
 			       struct snd_kcontrol *kcontrol, int event)
 {
@@ -807,6 +844,7 @@ static int va_macro_enable_dec(struct snd_soc_dapm_widget *w,
 		usleep_range(1000, 1010);
 		hpf_cut_off_freq = (snd_soc_component_read(comp, dec_cfg_reg) &
 				    TX_HPF_CUT_OFF_FREQ_MASK) >> 5;
+		va->hpf_dwork[decimator].hpf_cut_off_freq = hpf_cut_off_freq;
 
 		if (hpf_cut_off_freq != CF_MIN_3DB_150HZ) {
 			snd_soc_component_update_bits(comp, dec_cfg_reg,
@@ -844,8 +882,16 @@ static int va_macro_enable_dec(struct snd_soc_dapm_widget *w,
 		queue_delayed_work(system_freezable_wq,
 				   &va->mute_dwork[decimator].dwork,
 				   msecs_to_jiffies(VA_MACRO_UNMUTE_DELAY_MS));
+		/* 150 Hz only settles the decimator, go back afterwards */
+		if (va->hpf_dwork[decimator].hpf_cut_off_freq != CF_MIN_3DB_150HZ)
+			queue_delayed_work(system_freezable_wq,
+					   &va->hpf_dwork[decimator].dwork,
+					   msecs_to_jiffies(VA_MACRO_HPF_DELAY_MS));
 		break;
 	case SND_SOC_DAPM_PRE_PMD:
+		if (cancel_delayed_work_sync(&va->hpf_dwork[decimator].dwork))
+			va_macro_hpf_set_corner(va, decimator,
+				va->hpf_dwork[decimator].hpf_cut_off_freq);
 		cancel_delayed_work_sync(&va->mute_dwork[decimator].dwork);
 		snd_soc_component_update_bits(comp, tx_vol_ctl_reg,
 					      CDC_VA_TX_PATH_PGA_MUTE_EN_MASK,
@@ -1350,6 +1396,10 @@ static int va_macro_component_probe(struct snd_soc_component *component)
 		va->mute_dwork[i].decimator = i;
 		INIT_DELAYED_WORK(&va->mute_dwork[i].dwork,
 				  va_macro_mute_update_callback);
+		va->hpf_dwork[i].va = va;
+		va->hpf_dwork[i].decimator = i;
+		INIT_DELAYED_WORK(&va->hpf_dwork[i].dwork,
+				  va_macro_hpf_update_callback);
 	}
 
 	return 0;
