From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] PCI: qcom: keep an active-only PCIe-MEM vote in L2 on
 SC8280XP

Once both links are down, icc_disable() on the two PCIe-MEM paths drops
the PCI0 BCM to zero in the AMC and WAKE sets, and the SoC resets around
the next wake. Linux logs nothing.

The 1 kBps vote that the driver uses while a link stays up would prevent
the reset too, but it carries the ALWAYS tag, so it stays in the sleep set
and keeps DDR and CX from collapsing.

Tag the path ACTIVE_ONLY and vote 1 kBps when the link goes down, and go
back to ALWAYS before the link comes up. PCI0 then stays on in the AMC and
WAKE sets and the sleep set is empty. The Windows PEP data has a similar
vote: a suppressible one from PCIE_2A to EBI1 in its boot-time default
resources.

Limit this to SC8280XP and SA8540P with a flag in their config. X1E80100
was using the same config, so give it a copy without the flag. The other
SoCs keep icc_disable().

Assisted-by: Claude:claude-opus-5-5
---
 drivers/pci/controller/dwc/pcie-qcom.c | 41 +++++++++++++++++++++++---
 1 file changed, 37 insertions(+), 4 deletions(-)

diff --git a/drivers/pci/controller/dwc/pcie-qcom.c b/drivers/pci/controller/dwc/pcie-qcom.c
index d62cf302d..d5ed8b1e2 100644
--- a/drivers/pci/controller/dwc/pcie-qcom.c
+++ b/drivers/pci/controller/dwc/pcie-qcom.c
@@ -36,6 +36,8 @@
 #include <linux/types.h>
 #include <linux/units.h>
 
+#include <dt-bindings/interconnect/qcom,icc.h>
+
 #include "../../pci.h"
 #include "../pci-host-common.h"
 #include "pcie-designware.h"
@@ -260,12 +262,14 @@ struct qcom_pcie_ops {
   * @override_no_snoop: Override NO_SNOOP attribute in TLP to enable cache
   * snooping
   * @firmware_managed: Set if the Root Complex is firmware managed
+  * @l2_mem_vote: Keep a minimal active-only PCIe-MEM vote while the link is down
   */
 struct qcom_pcie_cfg {
 	const struct qcom_pcie_ops *ops;
 	bool override_no_snoop;
 	bool firmware_managed;
 	bool no_l0s;
+	bool l2_mem_vote;
 };
 
 struct qcom_pcie_perst {
@@ -1607,6 +1611,12 @@ static const struct qcom_pcie_cfg cfg_2_9_0 = {
 static const struct qcom_pcie_cfg cfg_sc8280xp = {
 	.ops = &ops_1_21_0,
 	.no_l0s = true,
+	.l2_mem_vote = true,
+};
+
+static const struct qcom_pcie_cfg cfg_x1e80100 = {
+	.ops = &ops_1_21_0,
+	.no_l0s = true,
 };
 
 static const struct qcom_pcie_cfg cfg_fw_managed = {
@@ -2193,6 +2203,29 @@ static int qcom_pcie_probe(struct platform_device *pdev)
 	return ret;
 }
 
+/*
+ * On SC8280XP the SoC resets around the next wake if the last vote on the
+ * PCIe-MEM paths goes away. Keep a minimal vote in the active and wake sets,
+ * and leave the sleep set empty so that DDR and CX can still collapse.
+ */
+static int qcom_pcie_icc_mem_disable(struct qcom_pcie *pcie)
+{
+	if (!pcie->cfg->l2_mem_vote)
+		return icc_disable(pcie->icc_mem);
+
+	icc_set_tag(pcie->icc_mem, QCOM_ICC_TAG_ACTIVE_ONLY);
+
+	return icc_set_bw(pcie->icc_mem, 0, kBps_to_icc(1));
+}
+
+static int qcom_pcie_icc_mem_enable(struct qcom_pcie *pcie)
+{
+	if (pcie->cfg->l2_mem_vote)
+		icc_set_tag(pcie->icc_mem, QCOM_ICC_TAG_ALWAYS);
+
+	return icc_enable(pcie->icc_mem);
+}
+
 static int qcom_pcie_suspend_noirq(struct device *dev)
 {
 	struct qcom_pcie *pcie;
@@ -2207,7 +2240,7 @@ static int qcom_pcie_suspend_noirq(struct device *dev)
 		return ret;
 
 	if (pcie->pci->suspended) {
-		ret = icc_disable(pcie->icc_mem);
+		ret = qcom_pcie_icc_mem_disable(pcie);
 		if (ret)
 			dev_err(dev, "Failed to disable PCIe-MEM interconnect path: %d\n", ret);
 
@@ -2275,7 +2308,7 @@ static int qcom_pcie_resume_noirq(struct device *dev)
 			return ret;
 		}
 
-		ret = icc_enable(pcie->icc_mem);
+		ret = qcom_pcie_icc_mem_enable(pcie);
 		if (ret) {
 			dev_err(dev, "Failed to enable PCIe-MEM interconnect path: %d\n", ret);
 			goto disable_icc_cpu;
@@ -2311,7 +2344,7 @@ static int qcom_pcie_resume_noirq(struct device *dev)
 
 	return 0;
 disable_icc_mem:
-	icc_disable(pcie->icc_mem);
+	qcom_pcie_icc_mem_disable(pcie);
 disable_icc_cpu:
 	icc_disable(pcie->icc_cpu);
 
@@ -2345,7 +2378,7 @@ static const struct of_device_id qcom_pcie_match[] = {
 	{ .compatible = "qcom,pcie-sm8450-pcie0", .data = &cfg_1_9_0 },
 	{ .compatible = "qcom,pcie-sm8450-pcie1", .data = &cfg_1_9_0 },
 	{ .compatible = "qcom,pcie-sm8550", .data = &cfg_1_9_0 },
-	{ .compatible = "qcom,pcie-x1e80100", .data = &cfg_sc8280xp },
+	{ .compatible = "qcom,pcie-x1e80100", .data = &cfg_x1e80100 },
 	{ }
 };
 
