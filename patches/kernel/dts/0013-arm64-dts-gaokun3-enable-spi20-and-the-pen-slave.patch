From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] arm64: dts: gaokun3: 启用 spi20 与触摸从片（主动笔）

感应 M-Pencil 的 HX83121A 级联从片接在 spi20（QUP2 SE4 @ 0x890000）上，
即 ACPI 中的 THPB/HIMX0002（\_SB.SP21），中断在 GPIO 39，没有复位线。
gaokun3 的设备树原先没有启用 spi20，也没有它的引脚状态。

- &spi20：启用，并挂上从片节点 pen@0（compatible "himax,hx83121a-pen-slave"，
  12 MHz，中断低电平触发）。与主片一样以 panel = <&panel> 跟随面板，亮屏后
  重新初始化从片。
- spi20_default：qup20 的 gpio87–90。这一功能组还包括 gpio92，但它在本机是
  后摄稳压器的使能脚，所以只复用这四个 SPI 引脚。参数照主片的 spi6_default。
- ts1_default：中断脚 gpio39，参数照主片的中断脚（gpio、bias-disable）。

节点内容与 #26 的 KernelSU 模块在运行时应用的 DT overlay 相同，后者在
1.0.0-rc.1 上实测可用。
---
 .../boot/dts/qcom/sc8280xp-huawei-gaokun3.dts      | 73 ++++++++++++++++++++++
 1 file changed, 73 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3.dts b/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3.dts
index f7c7c8999e92212e186aad5cff2a92dd4453e69a..9af467840ab5e09d04ad31eb937ed9057064bdc7 100644
--- a/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3.dts
+++ b/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3.dts
@@ -803,6 +803,33 @@ ucsi1_sbu: endpoint {
 	};
 };
 
+&spi20 {
+	pinctrl-0 = <&spi20_default>;
+	pinctrl-names = "default";
+
+	status = "okay";
+
+	/*
+	 * The cascade slave of the panel's HX83121A pair, which senses the
+	 * active pen (ACPI THPB/HIMX0002 on \_SB.SP21).  It has no reset line
+	 * of its own: it is reset together with the master.
+	 */
+	pen@0 {
+		compatible = "himax,hx83121a-pen-slave";
+		reg = <0>;
+
+		interrupts-extended = <&tlmm 39 IRQ_TYPE_LEVEL_LOW>;
+
+		/* re-initialised after the screen comes back on */
+		panel = <&panel>;
+
+		spi-max-frequency = <12000000>;
+
+		pinctrl-0 = <&ts1_default>;
+		pinctrl-names = "default";
+	};
+};
+
 &iris {
 	firmware-name = "qcom/sc8280xp/HUAWEI/gaokun3/qcvss8280.mbn";
 	status = "okay";
@@ -1669,6 +1696,43 @@ perst-n-pins {
 		};
 	};
 
+	/*
+	 * qup20 is gpio87-90 plus gpio92, but gpio92 is the rear camera
+	 * regulator enable on this board: only the four SPI pins are muxed.
+	 */
+	spi20_default: spi20-default-state {
+		miso-n-pins {
+			pins = "gpio87";
+			function = "qup20";
+			drive-strength = <2>;
+			bias-pull-down;
+		};
+
+		mosi-n-pins {
+			pins = "gpio88";
+			function = "qup20";
+			drive-strength = <2>;
+			bias-pull-down;
+			output-high;
+		};
+
+		clk-n-pins {
+			pins = "gpio89";
+			function = "qup20";
+			drive-strength = <2>;
+			bias-pull-down;
+			output-high;
+		};
+
+		cs-n-pins {
+			pins = "gpio90";
+			function = "qup20";
+			drive-strength = <2>;
+			bias-pull-down;
+			output-high;
+		};
+	};
+
 	spi6_default: spi6-default-state {
 		miso-n-pins {
 			pins = "gpio154";
@@ -1724,6 +1788,15 @@ reset-n-pins {
 		};
 	};
 
+	ts1_default: ts1-default-state {
+		int-n-pins {
+			pins = "gpio39";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
 	uart2_default: uart2-default-state {
 		cts-pins {
 			pins = "gpio121";
