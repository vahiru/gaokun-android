From: Vahiru <nekovahiru@gmail.com>
Subject: [PATCH] arm64: dts: qcom: sc8280xp-huawei-gaokun3: configure rear flash LED on PM8350C channels 1 and 4

The rear camera flash LED on the Huawei MateBook E Go is driven by channels 1
and 4 of the PM8350C (pmc8280c) flash LED module rather than GPIO 93. Replace
the non-functional GPIO 93 flash LED node with a pmc8280c_flash led-0 node
aggregating channels 1 and 4 (led-sources = <1>, <4>) exposed as white:flash.

Origin: local
Upstream-Status: Pending
---
diff --git a/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3-camera.dtsi b/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3-camera.dtsi
index 937eda9..b87f09e 100644
--- a/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3-camera.dtsi
+++ b/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3-camera.dtsi
@@ -22,7 +22,7 @@
 	leds {
 		compatible = "gpio-leds";
 
-		pinctrl-0 = <&cam_indicator_en>, <&camera_flash_en>;
+		pinctrl-0 = <&cam_indicator_en>;
 		pinctrl-names = "default";
 
 		privacy_led: privacy-led {
@@ -33,13 +33,10 @@
 			panic-indicator;
 		};
 
-		camera_flash: led {
-			function = LED_FUNCTION_FLASH;
-			color = <LED_COLOR_ID_WHITE>;
-			gpios = <&tlmm 93 GPIO_ACTIVE_HIGH>;
-			linux,default-trigger = "none";
-			default-state = "off";
-		};
+		/*
+		 * GPIO93 does not drive the rear flash LED; the physical flash
+		 * LED is driven by &pmc8280c led-0 (channels 1 and 4) below.
+		 */
 	};
 
 	vreg_camf_1p2: regulator-camf-1p2 {
@@ -112,6 +109,29 @@
 	};
 };
 
+/*
+ * Rear camera flash LED: ACPI \_SB.FLSH declares no GPIO/I2C resources because
+ * the flash is driven by the PM8350C (pmc8280c) SPMI flash module on channels
+ * 1 and 4. Current limits are conservative defaults (200 mA torch, 600 mA /
+ * 400 ms flash). Do not attach flash-leds to the ov13b10 node so v4l2-async
+ * does not block waiting for an extra subdev.
+ */
+&pmc8280c {
+	pmc8280c_flash: led-controller@ee00 {
+		compatible = "qcom,pm8350c-flash-led", "qcom,spmi-flash-led";
+		reg = <0xee00>;
+
+		camera_flash_led: led-0 {
+			function = LED_FUNCTION_FLASH;
+			color = <LED_COLOR_ID_WHITE>;
+			led-sources = <1>, <4>;
+			led-max-microamp = <200000>;
+			flash-max-microamp = <600000>;
+			flash-max-timeout-us = <400000>;
+		};
+	};
+};
+
 &camss {
 	/*
 	 * CSIPHY0, CSIPHY1 1.2v = l4d, 0.88v = l6d
@@ -272,12 +292,6 @@
 		bias-disable;
 	};
 
-	camera_flash_en: camera-flash-en-state {
-		pins = "gpio93";
-		function = "gpio";
-		drive-strength = <2>;
-		bias-disable;
-	};
 
 	camf_1p2_reg_en: camf-1p2-reg-en-state {
 		pins = "gpio44";
