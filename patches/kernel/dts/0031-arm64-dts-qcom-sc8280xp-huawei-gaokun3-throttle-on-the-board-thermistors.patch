 .../boot/dts/qcom/sc8280xp-huawei-gaokun3.dts | 168 ++++++++++++++++--
 1 file changed, 152 insertions(+), 16 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3.dts b/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3.dts
index 879ade4fe8..05839dbc3d 100644
--- a/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3.dts
+++ b/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3.dts
@@ -234,26 +234,96 @@ linux,cma {
 	};
 
 	thermal-zones {
-		skin-temp-thermal {
-			polling-delay-passive = <250>;
+		sys-therm1-thermal {
+			polling-delay-passive = <1000>;
 
-			thermal-sensors = <&pmk8280_adc_tm 5>;
+			thermal-sensors = <&pmk8280_adc_tm 0>;
 
 			trips {
-				skin_temp_alert0: trip-point0 {
-					temperature = <55000>;
-					hysteresis = <1000>;
+				sys_therm1_alert0: trip-point0 {
+					temperature = <54000>;
+					hysteresis = <2000>;
 					type = "passive";
 				};
 
-				skin_temp_alert1: trip-point1 {
+				sys-therm1-crit {
+					temperature = <100000>;
+					hysteresis = <1000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&sys_therm1_alert0>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT 8>,
+							 <&cpu1 THERMAL_NO_LIMIT 8>,
+							 <&cpu2 THERMAL_NO_LIMIT 8>,
+							 <&cpu3 THERMAL_NO_LIMIT 8>,
+							 <&cpu4 THERMAL_NO_LIMIT 10>,
+							 <&cpu5 THERMAL_NO_LIMIT 10>,
+							 <&cpu6 THERMAL_NO_LIMIT 10>,
+							 <&cpu7 THERMAL_NO_LIMIT 10>,
+							 <&gpu THERMAL_NO_LIMIT 5>;
+				};
+			};
+		};
+
+		sys-therm2-thermal {
+			polling-delay-passive = <1000>;
+
+			thermal-sensors = <&pmk8280_adc_tm 1>;
+
+			trips {
+				sys_therm2_alert0: trip-point0 {
 					temperature = <58000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				sys-therm2-crit {
+					temperature = <100000>;
 					hysteresis = <1000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&sys_therm2_alert0>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT 9>,
+							 <&cpu1 THERMAL_NO_LIMIT 9>,
+							 <&cpu2 THERMAL_NO_LIMIT 9>,
+							 <&cpu3 THERMAL_NO_LIMIT 9>,
+							 <&cpu4 THERMAL_NO_LIMIT 11>,
+							 <&cpu5 THERMAL_NO_LIMIT 11>,
+							 <&cpu6 THERMAL_NO_LIMIT 11>,
+							 <&cpu7 THERMAL_NO_LIMIT 11>,
+							 <&gpu THERMAL_NO_LIMIT 6>;
+				};
+			};
+		};
+
+		sys-therm3-thermal {
+			polling-delay-passive = <1000>;
+
+			thermal-sensors = <&pmk8280_adc_tm 2>;
+
+			trips {
+				sys_therm3_alert0: trip-point0 {
+					temperature = <58000>;
+					hysteresis = <2000>;
 					type = "passive";
 				};
 
-				skin-temp-crit {
-					temperature = <73000>;
+				sys_therm3_alert1: trip-point1 {
+					temperature = <65000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				sys-therm3-crit {
+					temperature = <100000>;
 					hysteresis = <1000>;
 					type = "critical";
 				};
@@ -261,19 +331,85 @@ skin-temp-crit {
 
 			cooling-maps {
 				map0 {
-					trip = <&skin_temp_alert0>;
-					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+					trip = <&sys_therm3_alert0>;
+					cooling-device = <&gpu THERMAL_NO_LIMIT 5>;
+				};
+
+				map1 {
+					trip = <&sys_therm3_alert1>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
 							 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
 							 <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
-							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
 				};
+			};
+		};
 
-				map1 {
-					trip = <&skin_temp_alert1>;
-					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+		sys-therm4-thermal {
+			polling-delay-passive = <1000>;
+
+			thermal-sensors = <&pmk8280_adc_tm 3>;
+
+			trips {
+				sys_therm4_alert0: trip-point0 {
+					temperature = <64000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				sys-therm4-crit {
+					temperature = <100000>;
+					hysteresis = <1000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&sys_therm4_alert0>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT 13>,
+							 <&cpu1 THERMAL_NO_LIMIT 13>,
+							 <&cpu2 THERMAL_NO_LIMIT 13>,
+							 <&cpu3 THERMAL_NO_LIMIT 13>,
+							 <&cpu4 THERMAL_NO_LIMIT 14>,
+							 <&cpu5 THERMAL_NO_LIMIT 14>,
+							 <&cpu6 THERMAL_NO_LIMIT 14>,
+							 <&cpu7 THERMAL_NO_LIMIT 14>,
+							 <&gpu THERMAL_NO_LIMIT 6>;
+				};
+			};
+		};
+
+		sys-therm7-thermal {
+			polling-delay-passive = <1000>;
+
+			thermal-sensors = <&pmk8280_adc_tm 6>;
+
+			trips {
+				sys_therm7_alert0: trip-point0 {
+					temperature = <95000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&sys_therm7_alert0>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
 							 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
 							 <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
-							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
 				};
 			};
 		};
