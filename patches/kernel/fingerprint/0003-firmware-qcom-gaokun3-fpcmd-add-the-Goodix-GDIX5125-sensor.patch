+/*
+ * Goodix GDIX5125. The same TA drives an MCU that speaks Milan frames (see
+ * gaokun3_fpcmd_goodix.h). Requests use the Goodix TA envelope: type 1 writes
+ * a frame to SPI, type 2 reads the MCU's pending packet, types 3/4 are
+ * REQUEST_INIT_FP_DATA1/2. INIT replays the Windows boot order. The TA opens
+ * its secure-storage files during INIT_FP_DATA; patch 0050 answers those
+ * listener requests with a failure, which the TA treats as a fresh install
+ * ("base available 0") and carries on. Image reads with CMD_TO_DEVICE 9 make
+ * the TA return the whole image packet instead of keeping it for its own
+ * algorithm, which needs the INIT_FP_DATA step to have run.
+ */
+#define GDX_MAGIC		0x00093418
+#define GDX_REQ_HEADER		0x28
+#define GDX_REQ_DATA		0x2c
+#define GDX_RSP_DATA		0x28
+#define GDX_REQ_WRITE		1
+#define GDX_REQ_READ		2
+#define GDX_REQ_INIT1		3
+#define GDX_REQ_INIT2		4
+#define GDX_DEV_DEFAULT		0
+#define GDX_DEV_CAPTURE_IMAGE	9
+#define GDX_RESULT_DONE		2
+/* The TA read nothing from the MCU (no packet pending, or the MCU asleep). */
+#define GDX_RESULT_NO_DATA	3
+#define GDX_READ_CAP		0x60
+#define GDX_IMAGE_CAP		0x7000
+#define GDX_IMAGE_CMD		0x24
+#define GDX_IMG_WAIT_MS		100
+#define GDX_IMG_POLLS		15
+/* The MCU sleeps after ~30 s idle and drops the command that wakes it. */
+#define GDX_IDLE_NOP_MS		5000
+#define GDX_TOUCH_AREAS		2
+/* zlib CRC32 of the 224-byte type 14 template in gfspi.dll 1.1.143.622. */
+#define GDX_CFG_CRC32		0x7aa2ecf5
+
+static struct {
+	u32 txn;
+	ktime_t last_cmd;
+	bool awake;
+	bool ready;
+	u16 base[GDX_FDT_AREAS];
+	u16 threshold;
+} gdx;
+
+static void gdx_reset_state(void)
+{
+	memset(&gdx, 0, sizeof(gdx));
+}
+
+static int gdx_call(u32 type, u32 dev_cmd, const u8 *payload, size_t len,
+		    u32 rsp_cap, const u8 **data, size_t *data_len)
+{
+	u8 *req = fp_req, *rsp = fp_rsp;
+	/* Sizes as the Windows client passes them to the TA. */
+	size_t req_len = (len + GDX_REQ_HEADER + 0x44) & ~0x3f;
+	size_t rsp_len = (rsp_cap + 0x68) & ~0x3f;
+	u32 total, dlen, llen;
+	int ret;
+
+	if (req_len > FP_IO_SZ || rsp_len > FP_IO_SZ)
+		return -E2BIG;
+	memset(req, 0, req_len);
+	put_unaligned_le32(GDX_MAGIC, req);
+	put_unaligned_le32(len + GDX_REQ_HEADER, req + 0x04);
+	put_unaligned_le32(type, req + 0x08);
+	put_unaligned_le32(++gdx.txn, req + 0x10);
+	/* +0x14 control and +0x15 log switch stay 0, as do the log sizes. */
+	put_unaligned_le32(dev_cmd, req + 0x18);
+	put_unaligned_le32(rsp_cap, req + 0x1c);
+	put_unaligned_le32(len, req + 0x28);
+	if (len)
+		memcpy(req + GDX_REQ_DATA, payload, len);
+	memset(rsp, 0, rsp_len);
+	ret = qcom_scm_qseecom_app_send(fp_app_id, req, req_len, rsp, rsp_len);
+	if (ret) {
+		pr_err("fpcmd: goodix secure call type %u failed: %d\n", type, ret);
+		return ret;
+	}
+	total = get_unaligned_le32(rsp);
+	dlen = get_unaligned_le32(rsp + 0x1c);
+	llen = get_unaligned_le32(rsp + 0x24);
+	if (dlen > rsp_cap || llen > rsp_len ||
+	    total != GDX_RSP_DATA + dlen + llen || total > rsp_len ||
+	    get_unaligned_le32(rsp + 0x08) != type ||
+	    get_unaligned_le32(rsp + 0x10) != gdx.txn) {
+		pr_err("fpcmd: goodix TA response rejected (type %u)\n", type);
+		return -EPROTO;
+	}
+	if (type == GDX_REQ_READ &&
+	    get_unaligned_le32(rsp + 0x04) == GDX_RESULT_NO_DATA)
+		return -ENODATA;
+	if (get_unaligned_le32(rsp + 0x04) != GDX_RESULT_DONE) {
+		pr_err("fpcmd: goodix TA result %u (type %u)\n",
+		       get_unaligned_le32(rsp + 0x04), type);
+		return -EIO;
+	}
+	*data = rsp + GDX_RSP_DATA;
+	*data_len = dlen;
+	return 0;
+}
+
+static int gdx_write(u8 cmd0, u8 cmd1, const u8 *data, size_t len)
+{
+	u8 frame[GDX_CFG_LEN + GDX_FRAME_OVERHEAD];
+	const u8 *rd;
+	size_t rl;
+	int n;
+
+	n = gdx_build_frame(frame, sizeof(frame), cmd0, cmd1, data, len);
+	if (n < 0)
+		return n;
+	n = gdx_call(GDX_REQ_WRITE, GDX_DEV_DEFAULT, frame, n, 0, &rd, &rl);
+	if (n) {
+		gdx.awake = false;
+		return n;
+	}
+	gdx.last_cmd = ktime_get_boottime();
+	return 0;
+}
+
+static int gdx_nop(void)
+{
+	static const u8 zero[4];
+	int ret;
+
+	ret = gdx_write(0, 0, zero, sizeof(zero));
+	if (ret)
+		return ret;
+	msleep(10);
+	gdx.awake = true;
+	return 0;
+}
+
+/* Boot time includes suspend, so a resumed system sends the NOP too. */
+static int gdx_wake(void)
+{
+	if (gdx.awake &&
+	    ktime_ms_delta(ktime_get_boottime(), gdx.last_cmd) < GDX_IDLE_NOP_MS)
+		return 0;
+	return gdx_nop();
+}
+
+static int gdx_read(u32 dev_cmd, u32 cap, struct gdx_packet *pkt)
+{
+	const u8 *data;
+	size_t len;
+	int ret;
+
+	ret = gdx_call(GDX_REQ_READ, dev_cmd, NULL, 0, cap, &data, &len);
+	if (ret)
+		return ret;
+	return gdx_parse_packet(data, len, pkt);
+}
+
+/* Send a command and wait for its reply; returns the reply length. */
+static int gdx_command(u8 cmd0, u8 cmd1, const u8 *data, size_t len,
+		       u8 *reply, size_t min_len, size_t cap)
+{
+	u8 want = cmd0 << 4 | cmd1 << 1;
+	struct gdx_packet pkt;
+	int attempt, ret;
+
+	ret = gdx_write(cmd0, cmd1, data, len);
+	if (ret)
+		return ret;
+	for (attempt = 0; attempt < 5; attempt++) {
+		msleep(20);
+		ret = gdx_read(GDX_DEV_DEFAULT, GDX_READ_CAP, &pkt);
+		if (ret == -ENODATA || ret == -EPROTO || ret == -EBADMSG)
+			continue;
+		if (ret)
+			break;
+		if (pkt.cmd != want) {
+			fp_dbg("goodix: packet %#x while waiting for %#x\n",
+			       pkt.cmd, want);
+			ret = -EPROTO;
+			continue;
+		}
+		if (pkt.len < min_len || pkt.len > cap) {
+			ret = -EPROTO;
+			break;
+		}
+		memcpy(reply, pkt.data, pkt.len);
+		return pkt.len;
+	}
+	/*
+	 * Next time, wake the MCU first: it may have slept through this one.
+	 * A missing or garbled reply is reported as -EPROTO; other errors come
+	 * from the secure call itself.
+	 */
+	gdx.awake = false;
+	pr_err("fpcmd: goodix command %u/%u got no valid reply: %d\n",
+	       cmd0, cmd1, ret);
+	return ret == -ENODATA || ret == -EBADMSG ? -EPROTO : ret;
+}
+
+static int gdx_init_data(u32 type, const u8 *payload)
+{
+	const u8 *data;
+	size_t len;
+	int ret;
+
+	ret = gdx_call(type, GDX_DEV_DEFAULT, payload, GDX_INIT_LEN,
+		       GDX_INIT_LEN, &data, &len);
+	if (!ret && len != GDX_INIT_LEN)
+		ret = -EPROTO;
+	if (ret)
+		pr_err("fpcmd: goodix INIT_FP_DATA%u failed: %d\n", type - 2, ret);
+	return ret;
+}
+
+static int gdx_load_config(u8 **cfg)
+{
+	void *buf = NULL;
+	ssize_t ret;
+
+	/* Without a file size, a larger file fails before anything is read. */
+	ret = kernel_read_file_from_path(gdx_cfg_path, 0, &buf, GDX_CFG_LEN,
+					 NULL, READING_FIRMWARE);
+	if (ret < 0) {
+		pr_err("fpcmd: goodix config %s: %zd\n", gdx_cfg_path, ret);
+		return ret;
+	}
+	if (ret != GDX_CFG_LEN ||
+	    (crc32_le(~0, buf, GDX_CFG_LEN) ^ ~0) != GDX_CFG_CRC32) {
+		pr_err("fpcmd: goodix config %s is not the known template\n",
+		       gdx_cfg_path);
+		vfree(buf);
+		return -EINVAL;
+	}
+	*cfg = buf;
+	return 0;
+}
+
+static int gdx_fdt_read(u16 *values)
+{
+	static const u8 manual[2 + 2 * GDX_FDT_AREAS] = { 0x09, 0x01 };
+	u8 reply[GDX_FDT_REPLY_LEN];
+	int i, ret;
+
+	ret = gdx_command(3, 3, manual, sizeof(manual), reply,
+			  GDX_FDT_REPLY_LEN, GDX_FDT_REPLY_LEN);
+	if (ret < 0)
+		return ret;
+	for (i = 0; i < GDX_FDT_AREAS; i++)
+		values[i] = get_unaligned_le16(reply + 4 + 2 * i);
+	return 0;
+}
+
+static int gdx_init(void)
+{
+	static const u8 zero2[2], state_req[] = { 0x55, 0x12, 0x34, 0, 0 };
+	static const u8 idle[] = { 0x01, 0x14 }, mode_idle[] = { 0x14, 0x00 };
+	static const u8 chip_req[] = { 0, 0, 0, 4, 0 };
+	u8 reply[64], otp[GDX_OTP_LEN], dac[8], payload[GDX_INIT_LEN];
+	char version[64] = "";
+	struct gdx_otp_info info;
+	u8 *cfg = NULL;
+	u32 chip;
+	int i, ret;
+
+	gdx_reset_state();
+	/* Read the template before touching the MCU. */
+	ret = gdx_load_config(&cfg);
+	if (ret)
+		return ret;
+
+	/* Windows order: NOP + version, NOP + state, NOP + version, idle. */
+	ret = gdx_nop();
+	if (!ret)
+		ret = gdx_command(10, 4, zero2, 2, reply, 1, sizeof(reply) - 1);
+	if (ret < 0)
+		goto out;
+	memcpy(version, reply, ret);
+	version[ret] = 0;
+	ret = gdx_nop();
+	if (!ret)
+		ret = gdx_command(10, 7, state_req, sizeof(state_req), reply, 1,
+				  sizeof(reply));
+	if (ret >= 0)
+		ret = gdx_nop();
+	if (!ret)
+		ret = gdx_command(10, 4, zero2, 2, reply, 1, sizeof(reply));
+	if (ret >= 0)
+		ret = gdx_command(10, 1, idle, sizeof(idle), reply, 1, sizeof(reply));
+	if (ret < 0)
+		goto out;
+	msleep(2);
+	ret = gdx_command(8, 1, chip_req, sizeof(chip_req), reply, 4, 4);
+	if (ret < 0)
+		goto out;
+	chip = get_unaligned_le16(reply + 1);
+	if (chip != 0x2507 && chip != 0x2508 && chip != 0x2510) {
+		pr_err("fpcmd: goodix chip %#x is not a ChicagoT part\n", chip);
+		ret = -ENODEV;
+		goto out;
+	}
+
+	gdx_init_payload(payload, chip, version, NULL, NULL);
+	ret = gdx_init_data(GDX_REQ_INIT1, payload);
+	if (ret)
+		goto out;
+	ret = gdx_command(10, 3, zero2, 2, otp, GDX_OTP_LEN, GDX_OTP_LEN);
+	if (ret < 0)
+		goto out;
+	ret = gdx_parse_otp(otp, &info);
+	if (ret) {
+		pr_err("fpcmd: goodix OTP has no usable DAC values\n");
+		goto out;
+	}
+	if (!info.cp_ok || !info.ft_ok || !info.mt_ok)
+		pr_warn("fpcmd: goodix OTP CRC cp=%d ft=%d mt=%d\n",
+			info.cp_ok, info.ft_ok, info.mt_ok);
+	ret = gdx_cfg_patch(cfg, &info);
+	if (ret) {
+		pr_err("fpcmd: goodix config template does not fit: %d\n", ret);
+		goto out;
+	}
+	for (i = 0; i < 4; i++)
+		put_unaligned_le16(info.dac[i], dac + 2 * i);
+	fp_dbg("goodix chip %#x '%s' dac %#x/%#x/%#x/%#x tcode %#x delta %#x\n",
+	       chip, version, info.dac[0], info.dac[1], info.dac[2], info.dac[3],
+	       info.tcode, info.fdt_delta);
+
+	ret = gdx_command(10, 1, idle, sizeof(idle), reply, 1, sizeof(reply));
+	if (ret < 0)
+		goto out;
+	/* Mode idle has no reply. */
+	ret = gdx_write(7, 0, mode_idle, sizeof(mode_idle));
+	if (ret)
+		goto out;
+	msleep(50);
+	ret = gdx_command(9, 4, dac, sizeof(dac), reply, 2, 2);
+	if (ret >= 0 && reply[0] != 1)
+		ret = -EIO;
+	if (ret < 0)
+		goto out;
+	ret = gdx_command(9, 0, cfg, GDX_CFG_LEN, reply, 2, 2);
+	if (ret >= 0 && reply[0] != 1)
+		ret = -EIO;
+	if (ret < 0) {
+		pr_err("fpcmd: goodix config download failed: %d\n", ret);
+		goto out;
+	}
+	ret = gdx_nop();
+	if (!ret)
+		ret = gdx_command(10, 7, state_req, sizeof(state_req), reply, 1,
+				  sizeof(reply));
+	if (ret < 0)
+		goto out;
+
+	gdx_init_payload(payload, chip, version, otp, &info);
+	ret = gdx_init_data(GDX_REQ_INIT2, payload);
+	if (ret)
+		goto out;
+
+	/* No-finger reference for the finger detect areas. */
+	ret = gdx_fdt_read(gdx.base);
+	if (ret)
+		goto out;
+	gdx.threshold = 2 * info.fdt_delta;
+	gdx.ready = true;
+	fp_dbg("goodix ready, fdt base %u %u %u %u %u %u %u %u %u %u threshold %u\n",
+	       gdx.base[0], gdx.base[1], gdx.base[2], gdx.base[3], gdx.base[4],
+	       gdx.base[5], gdx.base[6], gdx.base[7], gdx.base[8], gdx.base[9],
+	       gdx.threshold);
+out:
+	vfree(cfg);
+	return ret < 0 ? ret : 0;
+}
+
+/*
+ * Finger presence from the FDT areas. A covered area reads lower than its
+ * no-finger reference by more than twice the OTP FDT delta (the MCU's own
+ * down/up thresholds sit at (v >> 1) -/+ delta). Areas within the threshold
+ * follow slow drift; areas well above it mean the reference was taken with a
+ * finger on the key, so they take the new value.
+ */
+static int gdx_finger_status(u8 *status)
+{
+	u16 cur[GDX_FDT_AREAS];
+	int i, d, down = 0, ret;
+
+	if (!gdx.ready)
+		return -ENODEV;
+	ret = gdx_wake();
+	if (!ret)
+		ret = gdx_fdt_read(cur);
+	if (ret)
+		return ret;
+	for (i = 0; i < GDX_FDT_AREAS; i++)
+		if (gdx.base[i] - cur[i] > gdx.threshold)
+			down++;
+	*status = down >= GDX_TOUCH_AREAS;
+	if (!*status) {
+		for (i = 0; i < GDX_FDT_AREAS; i++) {
+			d = cur[i] - gdx.base[i];
+			if (d > gdx.threshold)
+				gdx.base[i] = cur[i];
+			else if (d >= -gdx.threshold)
+				gdx.base[i] += d / 4;
+		}
+	}
+	fp_dbg("goodix fdt %u %u %u %u %u %u %u %u %u %u down %d\n",
+	       cur[0], cur[1], cur[2], cur[3], cur[4], cur[5], cur[6], cur[7],
+	       cur[8], cur[9], down);
+	return 0;
+}
+
+static int gdx_capture(size_t image_bytes)
+{
+	static const u8 image_req[] = { 0x01, 0x00 };
+	u16 *pixels = (u16 *)fp_capture_data;
+	struct gdx_packet pkt;
+	int attempt, i, ret;
+
+	fp_capture_len = 0;
+	if (image_bytes != GDX_IMG_PIXELS * sizeof(u16))
+		return -EINVAL;
+	if (!gdx.ready)
+		return -ENODEV;
+	ret = gdx_wake();
+	if (!ret)
+		ret = gdx_write(2, 2, image_req, sizeof(image_req));
+	if (ret)
+		return ret;
+	/*
+	 * The image is ready 100-130 ms after the request; until then the TA
+	 * reads nothing and says so. Without the IRQ line, poll for it. Each
+	 * empty poll still clocks the whole capacity over SPI, hence the wait.
+	 */
+	msleep(GDX_IMG_WAIT_MS);
+	for (attempt = 0; attempt < GDX_IMG_POLLS; attempt++) {
+		ret = gdx_read(GDX_DEV_CAPTURE_IMAGE, GDX_IMAGE_CAP, &pkt);
+		if (!ret && pkt.cmd == GDX_IMAGE_CMD)
+			break;
+		/* Keep polling past a late reply to an earlier command. */
+		if (!ret)
+			fp_dbg("goodix: packet %#x while waiting for the image\n",
+			       pkt.cmd);
+		else if (ret != -ENODATA && ret != -EPROTO && ret != -EBADMSG)
+			break;
+		msleep(20);
+	}
+	fp_dbg("goodix image after %d polls: %d\n", attempt + 1, ret);
+	if (attempt == GDX_IMG_POLLS)
+		ret = -ENODATA;
+	if (!ret && pkt.len != GDX_IMG_DATA_LEN)
+		ret = -EPROTO;
+	if (!ret)
+		ret = gdx_decode_image(pkt.data, pkt.len, pixels);
+	/* The raw image is plaintext: do not leave it in the shared buffer. */
+	memzero_explicit(fp_rsp, FP_IO_SZ);
+	if (ret) {
+		gdx.awake = false;
+		pr_err("fpcmd: goodix image read failed: %d\n", ret);
+		/* Like a command without a reply. */
+		return ret == -ENODATA || ret == -EBADMSG ? -EPROTO : ret;
+	}
+	for (i = 0; i < GDX_IMG_PIXELS; i++)
+		cpu_to_le16s(&pixels[i]);
+	fp_capture_len = image_bytes;
+	return 0;
+}
+
+static int gdx_probe(void)
+{
+	static const u8 zero2[2];
+	u8 reply[64];
+	int ret;
+
+	ret = gdx_wake();
+	if (!ret)
+		ret = gdx_command(10, 4, zero2, 2, reply, 1, sizeof(reply));
+	return ret < 0 ? ret : 0;
+}
+
+static bool fp_goodix(void)
+{
+	return fp_sensor == GAOKUN3_FPCMD_SENSOR_GOODIX;
+}
