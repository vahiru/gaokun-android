diff --git a/drivers/firmware/qcom/gaokun3_fpcmd.h b/drivers/firmware/qcom/gaokun3_fpcmd.h
index c8350ce54..5ad241173 100644
--- a/drivers/firmware/qcom/gaokun3_fpcmd.h
+++ b/drivers/firmware/qcom/gaokun3_fpcmd.h
@@ -39,4 +39,22 @@ struct gaokun3_fpcmd_capture {
 #define GAOKUN3_FPCMD_IOC_GET_FINGER_STATUS \
 	_IOR(GAOKUN3_FPCMD_IOC_MAGIC, 0x06, gaokun3_fpcmd_u8)
 
+/*
+ * Sensor variant, chosen by user space from the board straps (TLMM GPIO61/62,
+ * as the ACPI _HID of \_SB.SPBA does: 0/1 FocalTech FTE7001, 1/0 Goodix
+ * GDIX5125). Set before INIT; FocalTech is the default.
+ *
+ * Goodix: GET_FINGER_STATUS reports physical finger presence (it reads to 0
+ * after lift-off). CAPTURE requires image_bytes =
+ * GAOKUN3_FPCMD_GOODIX_WIDTH * GAOKUN3_FPCMD_GOODIX_HEIGHT * 2 and fills it
+ * with little-endian 12-bit samples, row major, unencrypted.
+ */
+#define GAOKUN3_FPCMD_SENSOR_FOCALTECH	0
+#define GAOKUN3_FPCMD_SENSOR_GOODIX	1
+#define GAOKUN3_FPCMD_GOODIX_WIDTH	36
+#define GAOKUN3_FPCMD_GOODIX_HEIGHT	160
+
+#define GAOKUN3_FPCMD_IOC_SET_SENSOR \
+	_IOW(GAOKUN3_FPCMD_IOC_MAGIC, 0x07, gaokun3_fpcmd_u32)
+
 #endif
diff --git a/drivers/firmware/qcom/gaokun3_fpcmd_goodix.h b/drivers/firmware/qcom/gaokun3_fpcmd_goodix.h
new file mode 100644
index 000000000..79ad9bf33
--- /dev/null
+++ b/drivers/firmware/qcom/gaokun3_fpcmd_goodix.h
@@ -0,0 +1,355 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Goodix GDIX5125 (MCU chip 0x2510, sensor type 14) protocol helpers for the
+ * gaokun3 fingerprint transport. Pure functions only, so they can also be
+ * built and tested in user space; the caller provides u8/u16/u32, bool,
+ * get_unaligned_le16/32, put_unaligned_le16/32, memcpy/memset/strnlen and the
+ * E* error codes.
+ *
+ * The MCU speaks "Milan" frames:
+ *   a0 <len u16 = inner length> <header sum = a0 + len bytes>
+ *   <cmd = cmd0 << 4 | cmd1 << 1 | 1> <inner len u16 = data + 1> <data> <sum>
+ * with sum = 0xaa - (cmd & 0xfe) - inner len bytes - data bytes. The NOP
+ * request and the image packet carry the fixed sum 0x88 instead; every other
+ * reply carries the computed sum. A reply uses the request command with bit 0
+ * clear. The TA image packet starts with 0xc0 instead of 0xa0.
+ *
+ * OTP handling, the configuration patches and the INIT_FP_DATA layout follow
+ * the Windows driver (gfspi.dll 1.1.143.622: ChicagoT_check_otp,
+ * ChicagoT_check_and_parse_otp, send_init_data_to_ta).
+ */
+#ifndef _GAOKUN3_FPCMD_GOODIX_H
+#define _GAOKUN3_FPCMD_GOODIX_H
+
+#define GDX_FRAME_OVERHEAD	8
+#define GDX_NOP_SUM		0x88
+
+#define GDX_OTP_LEN		64
+#define GDX_CFG_LEN		224
+#define GDX_CFG_SUM_WORDS	0x6f
+#define GDX_CFG_SUM_OFFSET	0xde
+#define GDX_INIT_LEN		0xc0
+#define GDX_SENSOR_TYPE		14
+#define GDX_FDT_AREAS		10
+#define GDX_FDT_REPLY_LEN	(4 + 2 * GDX_FDT_AREAS)
+
+#define GDX_IMG_LINES		114
+#define GDX_IMG_LINE_BYTES	240
+#define GDX_IMG_DUMMY_COLUMNS	2
+#define GDX_IMG_WIDTH		(GDX_IMG_LINES / 3 - GDX_IMG_DUMMY_COLUMNS)
+#define GDX_IMG_HEIGHT		160
+#define GDX_IMG_DATA_LEN	(5 + GDX_IMG_LINES * GDX_IMG_LINE_BYTES + 4)
+#define GDX_IMG_PIXELS		(GDX_IMG_WIDTH * GDX_IMG_HEIGHT)
+
+struct gdx_packet {
+	u8 flags;
+	u8 cmd;
+	const u8 *data;
+	size_t len;
+	size_t size;	/* bytes of the buffer this packet used */
+};
+
+struct gdx_otp_info {
+	u16 dac[4];	/* register values: dac0 << 4 | 8, dac1, dac2, dac3 */
+	u16 tcode;
+	u16 fdt_delta;
+	u8 tcode_byte;	/* 0 if the OTP gave none; then no tcode patches */
+	u8 fdt_offset;
+	bool cp_ok, ft_ok, mt_ok;
+};
+
+static inline u8 gdx_crc8(const u8 *data, size_t len)
+{
+	u8 crc = 0;
+	size_t i;
+	int bit;
+
+	/* CRC-8, polynomial 0x07, MSB first, inverted result (FUN_180010a48). */
+	for (i = 0; i < len; i++) {
+		crc ^= data[i];
+		for (bit = 0; bit < 8; bit++)
+			crc = crc & 0x80 ? (u8)(crc << 1) ^ 0x07 : (u8)(crc << 1);
+	}
+	return (u8)~crc;
+}
+
+static inline u8 gdx_sum(const u8 *data, size_t len)
+{
+	u8 sum = 0;
+	size_t i;
+
+	for (i = 0; i < len; i++)
+		sum += data[i];
+	return sum;
+}
+
+/* Build a host-to-MCU frame; returns its length or -E2BIG. */
+static inline int gdx_build_frame(u8 *out, size_t cap, u8 cmd0, u8 cmd1,
+				  const u8 *data, size_t len)
+{
+	size_t outer = len + 4, inner = len + 1;
+	u8 cmd = (u8)(cmd0 << 4 | cmd1 << 1 | 1);
+
+	if (cmd0 > 0xf || cmd1 > 7 || len > 0xfff0 ||
+	    len + GDX_FRAME_OVERHEAD > cap)
+		return -E2BIG;
+	out[0] = 0xa0;
+	put_unaligned_le16((u16)outer, out + 1);
+	out[3] = (u8)(0xa0 + out[1] + out[2]);
+	out[4] = cmd;
+	put_unaligned_le16((u16)inner, out + 5);
+	if (len)
+		memcpy(out + 7, data, len);
+	if (!cmd0)
+		out[7 + len] = GDX_NOP_SUM;
+	else
+		out[7 + len] = (u8)(0xaa - (cmd & 0xfe) - out[5] - out[6] -
+				    gdx_sum(data, len));
+	return (int)(len + GDX_FRAME_OVERHEAD);
+}
+
+/* Parse one MCU packet at the start of buf. */
+static inline int gdx_parse_packet(const u8 *buf, size_t size,
+				   struct gdx_packet *pkt)
+{
+	size_t outer, inner;
+	u8 sum;
+
+	if (size < 7)
+		return -ENODATA;
+	if (buf[0] != 0xa0 && buf[0] != 0xc0)
+		return -EPROTO;
+	if ((u8)(buf[0] + buf[1] + buf[2]) != buf[3])
+		return -EBADMSG;
+	outer = get_unaligned_le16(buf + 1);
+	inner = get_unaligned_le16(buf + 5);
+	if (outer < 4 || 4 + outer > size || !inner || 3 + inner > outer)
+		return -EPROTO;
+	pkt->flags = buf[0];
+	pkt->cmd = buf[4];
+	pkt->data = buf + 7;
+	pkt->len = inner - 1;
+	pkt->size = 4 + outer;
+	sum = buf[7 + pkt->len];
+	if (sum != (u8)(0xaa - (pkt->cmd & 0xfe) - buf[5] - buf[6] -
+			gdx_sum(pkt->data, pkt->len)) &&
+	    !(buf[0] == 0xc0 && sum == GDX_NOP_SUM))
+		return -EBADMSG;
+	return 0;
+}
+
+/*
+ * Derive DAC, tcode and FDT delta from the OTP the MCU returns for 10/3.
+ * Returns -EINVAL if no usable DAC set exists (Windows: "OTP DAC check
+ * failed", after which it keeps the template values; we refuse instead).
+ */
+static inline int gdx_parse_otp(const u8 *otp, struct gdx_otp_info *info)
+{
+	u8 buf[27];
+	const u8 *ft = otp + 0x32, *mt = otp + 0x2e, *src = NULL;
+	u8 dac[4], t, b;
+	bool ft_dac_ok, mt_dac_ok;
+	int i, same = 0;
+	u32 x;
+
+	memset(info, 0, sizeof(*info));
+
+	/* ChicagoT_OTP_CRC_Check: three CRC-8 regions. */
+	memcpy(buf, otp, 11);
+	memcpy(buf + 11, otp + 0x24, 4);
+	info->cp_ok = gdx_crc8(buf, 15) == otp[0x3c];
+	memcpy(buf, otp + 0x0b, 9);
+	buf[9] = otp[0x1c];
+	memcpy(buf + 10, otp + 0x32, 4);
+	memcpy(buf + 14, otp + 0x38, 4);
+	buf[18] = otp[0x3e];
+	info->ft_ok = gdx_crc8(buf, 19) == otp[0x3d];
+	memcpy(buf, otp + 0x14, 8);
+	memcpy(buf + 8, otp + 0x1d, 7);
+	memcpy(buf + 15, otp + 0x28, 10);
+	memcpy(buf + 25, otp + 0x36, 2);
+	info->mt_ok = gdx_crc8(buf, 27) == otp[0x3f];
+
+	/* ChicagoT_OTP_DAC_Check: FT set, else MT set, else 3-of-4 vote. */
+	ft_dac_ok = ft[0] && ft[1] && ft[2] && ft[3] &&
+		    gdx_crc8(ft, 4) == otp[0x3e];
+	mt_dac_ok = mt[0] && mt[1] && mt[2] && mt[3] &&
+		    gdx_crc8(mt, 4) == otp[0x16];
+	if (info->ft_ok || ft_dac_ok) {
+		src = ft;
+	} else if (info->mt_ok || mt_dac_ok) {
+		src = mt;
+	} else {
+		for (i = 0; i < 4; i++)
+			if (mt[i] == ft[i] && ft[i])
+				same++;
+		if (same < 3)
+			return -EINVAL;
+		for (i = 0; i < 4; i++)
+			dac[i] = mt[i] == ft[i] ? ft[i] :
+				 (u8)((mt[(i + 1) % 4] + mt[(i + 2) % 4] +
+				       mt[(i + 3) % 4]) / 3);
+		src = dac;
+	}
+	info->dac[0] = (u16)(src[0] << 4 | 8);
+	for (i = 1; i < 4; i++)
+		info->dac[i] = src[i];
+
+	/* ChicagoT_check_and_parse_otp: tcode byte with its inverted copy. */
+	info->tcode = 0x80;
+	info->fdt_delta = 0x15;
+	if (otp[0x2a] && otp[0x2a] == (u8)~otp[0x2b])
+		t = otp[0x2a];
+	else if (otp[0x2d] && otp[0x2d] == (u8)~otp[0x2b])
+		t = otp[0x2d];
+	else if (otp[0x2a] && otp[0x2d] == otp[0x2a])
+		t = otp[0x2a];
+	else
+		t = 0;
+	if (t) {
+		info->tcode_byte = t;
+		info->tcode = (u16)(((t >> 4) + 1) * 0x10 + 0x40);
+		x = ((t & 0xf) + 2) * 100;
+		info->fdt_delta = (u8)(((x * 0x100) / info->tcode / 3) >> 4);
+	}
+
+	b = otp[0x1b];
+	if (b) {
+		if ((b & 3) == ((b >> 4) & 3))
+			info->fdt_offset = b & 3;
+		else if ((b & 3) == (((u8)~b >> 2) & 3))
+			info->fdt_offset = b & 3;
+		else if (((b >> 4) & 3) == (((u8)~b >> 2) & 3))
+			info->fdt_offset = (b >> 4) & 3;
+	}
+	return 0;
+}
+
+static inline u16 gdx_cfg_checksum(const u8 *cfg)
+{
+	u16 sum = 0xa5a5;
+	int i;
+
+	for (i = 0; i < GDX_CFG_SUM_WORDS; i++)
+		sum += get_unaligned_le16(cfg + 2 * i);
+	return (u16)-sum;
+}
+
+/* modify_sensor_config: mode 0 = word, 1 = low byte, 2 = high byte. */
+static inline int gdx_cfg_set(u8 *cfg, u16 reg, u16 value, int section,
+			      int mode)
+{
+	size_t start = cfg[1 + 2 * section], len = cfg[2 + 2 * section];
+	size_t pos;
+	u16 old;
+
+	if (start + len > GDX_CFG_SUM_OFFSET || len % 4)
+		return -EINVAL;
+	for (pos = start; pos < start + len; pos += 4) {
+		if (get_unaligned_le16(cfg + pos) != reg)
+			continue;
+		old = get_unaligned_le16(cfg + pos + 2);
+		if (mode == 1)
+			value = (old & 0xff00) | (value & 0xff);
+		else if (mode == 2)
+			value = (value & 0xff00) | (old & 0xff);
+		put_unaligned_le16(value, cfg + pos + 2);
+		return 0;
+	}
+	return -ENOENT;
+}
+
+/*
+ * Patch the type 14 template in place with the values derived from OTP. The
+ * template's own checksum field is stale in gfspi.dll; Windows recomputes it
+ * after patching, and so does this.
+ */
+static inline int gdx_cfg_patch(u8 *cfg, const struct gdx_otp_info *info)
+{
+	int ret;
+
+	if (cfg[0] != 0x90)
+		return -EINVAL;
+	ret = gdx_cfg_set(cfg, 0x220, info->dac[0], 0, 0);
+	if (!ret)
+		ret = gdx_cfg_set(cfg, 0x236, info->dac[1], 0, 0);
+	if (!ret)
+		ret = gdx_cfg_set(cfg, 0x238, info->dac[2], 0, 0);
+	if (!ret)
+		ret = gdx_cfg_set(cfg, 0x23a, info->dac[3], 0, 0);
+	if (!ret && info->tcode_byte)
+		ret = gdx_cfg_set(cfg, 0x5c, info->tcode, 0, 0);
+	if (!ret && info->tcode_byte)
+		ret = gdx_cfg_set(cfg, 0x82, (u16)(info->fdt_delta << 8), 2, 2);
+	if (!ret && info->fdt_offset)
+		ret = gdx_cfg_set(cfg, 0x56, info->fdt_offset + 4, 2, 1);
+	if (ret)
+		return ret;
+	put_unaligned_le16(gdx_cfg_checksum(cfg), cfg + GDX_CFG_SUM_OFFSET);
+	return 0;
+}
+
+/*
+ * REQUEST_INIT_FP_DATA1 (otp == NULL) and INIT_FP_DATA2 payloads. version is
+ * the NUL-terminated string from the 10/4 reply.
+ */
+static inline void gdx_init_payload(u8 *out, u32 chip_id, const char *version,
+				    const u8 *otp,
+				    const struct gdx_otp_info *info)
+{
+	memset(out, 0, GDX_INIT_LEN);
+	put_unaligned_le32(GDX_SENSOR_TYPE, out + 0x00);
+	put_unaligned_le32(chip_id, out + 0x04);
+	put_unaligned_le16(GDX_OTP_LEN, out + 0x0c);
+	if (otp)
+		memcpy(out + 0x0e, otp, GDX_OTP_LEN);
+	put_unaligned_le16(2 * GDX_FDT_AREAS, out + 0x4e);
+	put_unaligned_le16(0x24, out + 0x64);
+	put_unaligned_le16(0xa0, out + 0x66);
+	put_unaligned_le32(0x2d00, out + 0x68);
+	put_unaligned_le32(0x0c80, out + 0x6c);
+	if (otp) {
+		put_unaligned_le16(info->tcode, out + 0x70);
+		put_unaligned_le16(info->fdt_delta, out + 0x72);
+	}
+	memcpy(out + 0x7e, version, strnlen(version, 0x3f));
+}
+
+/*
+ * Unpack the image data of a 0x24 packet into width x height samples, row
+ * major, 12 bits each. Every column is scanned three times; average them.
+ */
+static inline int gdx_decode_image(const u8 *data, size_t len, u16 *out)
+{
+	const u8 *raw = data + 5;
+	u16 line[GDX_IMG_HEIGHT];
+	u32 acc[GDX_IMG_HEIGHT];
+	int l, i, row, col;
+
+	if (len != GDX_IMG_DATA_LEN || data[0] || data[1] || data[2] ||
+	    data[3] || data[4])
+		return -EPROTO;
+	for (col = 0; col < GDX_IMG_LINES / 3; col++) {
+		memset(acc, 0, sizeof(acc));
+		for (l = 0; l < 3; l++) {
+			const u8 *b = raw + (3 * col + l) * GDX_IMG_LINE_BYTES;
+
+			for (i = 0; i < GDX_IMG_HEIGHT; i += 4, b += 6) {
+				line[i] = (u16)((b[0] & 0xf) << 8 | b[1]);
+				line[i + 1] = (u16)(b[3] << 4 | b[0] >> 4);
+				line[i + 2] = (u16)((b[5] & 0xf) << 8 | b[2]);
+				line[i + 3] = (u16)(b[4] << 4 | b[5] >> 4);
+			}
+			for (row = 0; row < GDX_IMG_HEIGHT; row++)
+				acc[row] += line[row];
+		}
+		if (col < GDX_IMG_DUMMY_COLUMNS)
+			continue;
+		for (row = 0; row < GDX_IMG_HEIGHT; row++)
+			out[row * GDX_IMG_WIDTH + col - GDX_IMG_DUMMY_COLUMNS] =
+				(u16)((acc[row] + 1) / 3);
+	}
+	return 0;
+}
+
+#endif
diff --git a/drivers/firmware/qcom/qcom_qseecom_fpcmd.c b/drivers/firmware/qcom/qcom_qseecom_fpcmd.c
index 6a3514413..81b3ee6f5 100644
--- a/drivers/firmware/qcom/qcom_qseecom_fpcmd.c
+++ b/drivers/firmware/qcom/qcom_qseecom_fpcmd.c
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
- * Gaokun3 FocalTech fingerprint transport over QSEE.
+ * Gaokun3 fingerprint transport over QSEE (FocalTech FTE7001, Goodix GDIX5125).
  * The misc device exposes a narrow ioctl ABI; insertion alone does not call TA.
  * Explicit load/wake/probe/capture operations enter secure firmware and may
  * access SPI or trigger a secure-storage listener.
@@ -25,13 +25,21 @@
 #include <linux/hex.h>
 #include <linux/uaccess.h>
 #include <linux/string.h>
+#include <linux/crc32.h>
+#include <linux/ktime.h>
+#include <linux/unaligned.h>
 #include "gaokun3_fpcmd.h"
+#include "gaokun3_fpcmd_goodix.h"
 
 #define FP_IMG_ALIGN (4 * 1024 * 1024)
 /* This diagnostic path supports the known <4 MiB monolithic sec ELF only. */
 #define FP_IMG_MAX FP_IMG_ALIGN
 #define FP_IO_SZ (32 * 1024)
 #define FP_CAPTURE_MAX (FP_IO_SZ - 12 - 5)
