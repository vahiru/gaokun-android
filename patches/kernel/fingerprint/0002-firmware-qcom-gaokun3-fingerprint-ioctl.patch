From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] firmware: qcom: add restricted Gaokun3 fingerprint QSEE transport

Add a restricted misc device (/dev/gaokun3_fpcmd) providing a fixed ioctl ABI
for communicating with the signed FocalTech fingerprint trusted application on
sc8280xp-huawei-gaokun3 over QSEECOM (using the QSEECOM app load, shutdown, and
listener interface). Uses the vendor firmware path and exclusive open/release
with fail-closed TA shutdown, without debugfs or arbitrary QSEE command
submission.

Origin: local
Upstream-Status: Inappropriate [device-specific QSEE transport]
---
diff --git a/drivers/firmware/qcom/Makefile b/drivers/firmware/qcom/Makefile
--- a/drivers/firmware/qcom/Makefile
+++ b/drivers/firmware/qcom/Makefile
@@ -1,3 +1,4 @@
+obj-$(CONFIG_GAOKUN3_FPCMD) += qcom_qseecom_fpcmd.o
 # SPDX-License-Identifier: GPL-2.0
 #
 # Makefile for the linux kernel.
diff --git a/drivers/firmware/qcom/Kconfig b/drivers/firmware/qcom/Kconfig
--- a/drivers/firmware/qcom/Kconfig
+++ b/drivers/firmware/qcom/Kconfig
@@ -1,3 +1,12 @@
+config GAOKUN3_FPCMD
+	bool "Gaokun3 FTE7001 restricted fingerprint transport"
+	depends on QCOM_QSEECOM && QCOM_SCM=y
+	default n
+	help
+	  Fixed ioctl transport for the signed FocalTech fingerprint TA.
+	  Requires the downstream QSEE app-load/shutdown/listener patch.
+	  No TA calls occur until userspace explicitly requests them.
+
 # SPDX-License-Identifier: GPL-2.0-only
 #
 # For a description of the syntax of this configuration file,
diff --git a/drivers/firmware/qcom/qcom_qseecom_fpcmd.c b/drivers/firmware/qcom/qcom_qseecom_fpcmd.c
new file mode 100644
--- /dev/null
+++ b/drivers/firmware/qcom/qcom_qseecom_fpcmd.c
@@ -0,0 +1,795 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Gaokun3 FocalTech fingerprint transport over QSEE.
+ * The misc device exposes a narrow ioctl ABI; insertion alone does not call TA.
+ * Explicit load/wake/probe/capture operations enter secure firmware and may
+ * access SPI or trigger a secure-storage listener.
+ * Listener fallback cannot guarantee that a firmware call will not hang.
+ *
+ * TA ABI: fingerpr.mbn b081543c7b6ae4360969007836747601e8c48ec48a8335a5479e45ec0e34355a
+ * sub_ADFC uses the SMC buffer sizes (not just header.rlen) for SPI lengths,
+ * writes read data at rsp + 12, and acknowledges in the REQUEST header.
+ */
+#include <linux/module.h>
+#include <linux/miscdevice.h>
+#include <linux/firmware/qcom/qcom_scm.h>
+#include <linux/firmware/qcom/qcom_tzmem.h>
+#include <linux/dma-mapping.h>
+#include <linux/kernel_read_file.h>
+#include <linux/vmalloc.h>
+#include <linux/slab.h>
+#include <linux/mutex.h>
+#include <linux/fs.h>
+#include <linux/delay.h>
+#include <linux/ctype.h>
+#include <linux/hex.h>
+#include <linux/uaccess.h>
+#include <linux/string.h>
+#include "gaokun3_fpcmd.h"
+
+#define FP_IMG_ALIGN (4 * 1024 * 1024)
+/* This diagnostic path supports the known <4 MiB monolithic sec ELF only. */
+#define FP_IMG_MAX FP_IMG_ALIGN
+#define FP_IO_SZ (32 * 1024)
+#define FP_CAPTURE_MAX (FP_IO_SZ - 12 - 5)
+#define FP_QSEE_SPI_READ 0x8020
+#define FP_QSEE_SPI_WRITE 0x8021
+#define FP_TA_ACK 0x5aa5
+#define FP_SENSOR_MARKER 0x02
+#define FP_SENSOR_OK 0x04
+
+static char *fp_img_path = "/vendor/firmware/fingerpr.mbn";
+module_param(fp_img_path, charp, 0400);
+MODULE_PARM_DESC(fp_img_path, "path to the vendor-supplied fingerprint TA image");
+
+#ifdef GAOKUN3_FPCMD_DEBUG
+#define fp_dbg(fmt, ...) pr_info("fpcmd: " fmt, ##__VA_ARGS__)
+#define fp_dbg_dump(prefix, data, len) \
+	print_hex_dump(KERN_INFO, prefix, DUMP_PREFIX_OFFSET, 16, 1, data, len, false)
+#else
+#define fp_dbg(fmt, ...) do { } while (0)
+#define fp_dbg_dump(prefix, data, len) do { } while (0)
+#endif
+
+static DEFINE_MUTEX(fp_lock);
+static struct qcom_tzmem_pool *fp_io_pool;
+static void *fp_req, *fp_rsp;
+static u32 fp_app_id;
+static bool fp_loaded;
+static bool fp_opened;
+static bool fp_shutdown_failed;
+static size_t fp_rsp_len;
+static u8 *fp_capture_data;
+static size_t fp_capture_len;
+
+struct fp_qsee_header {
+	__le32 command;
+	__le32 data_len;
+	__le32 response_len;
+};
+
+static void fp_free_io(void)
+{
+	if (fp_req)
+		qcom_tzmem_free(fp_req);
+	if (fp_rsp)
+		qcom_tzmem_free(fp_rsp);
+	if (fp_io_pool)
+		qcom_tzmem_pool_free(fp_io_pool);
+	fp_req = NULL;
+	fp_rsp = NULL;
+	fp_io_pool = NULL;
+	fp_rsp_len = 0;
+}
+
+static int fp_load(void)
+{
+	struct qcom_tzmem_pool_config cfg = {
+		.initial_size = FP_IMG_ALIGN,
+		.max_size = FP_IMG_ALIGN,
+		.policy = QCOM_TZMEM_POLICY_STATIC,
+	};
+	struct qcom_tzmem_pool *img_pool;
+	void *stage, *filebuf = NULL;
+	phys_addr_t phys;
+	size_t img_len = 0, stage_len;
+	int ret;
+
+	if (fp_loaded)
+		return -EBUSY;
+	ret = kernel_read_file_from_path(fp_img_path, 0, &filebuf, FP_IMG_MAX,
+					 &img_len, READING_FIRMWARE);
+	if (ret < 0)
+		return ret;
+	if (!img_len) {
+		ret = -EINVAL;
+		goto out_file;
+	}
+	stage_len = ALIGN(img_len, FP_IMG_ALIGN);
+	img_pool = qcom_tzmem_pool_new(&cfg);
+	if (IS_ERR(img_pool)) {
+		ret = PTR_ERR(img_pool);
+		goto out_file;
+	}
+	stage = qcom_tzmem_alloc(img_pool, stage_len, GFP_KERNEL);
+	if (!stage) {
+		ret = -ENOMEM;
+		goto out_imgpool;
+	}
+	phys = qcom_tzmem_to_phys(stage);
+	if (!phys || upper_32_bits(phys) || upper_32_bits(phys + img_len - 1)) {
+		pr_err("fpcmd: TA buffer %pa must be entirely below 4 GiB\n", &phys);
+		ret = -EINVAL;
+		goto out_stage;
+	}
+	fp_dbg("TA buffer %pa selected\n", &phys);
+	memset(stage, 0, stage_len);
+	memcpy(stage, filebuf, img_len);
+
+	/* Allocate everything before APP_START; no post-load allocation failure. */
+	cfg.initial_size = cfg.max_size = 2 * FP_IO_SZ;
+	fp_io_pool = qcom_tzmem_pool_new(&cfg);
+	if (IS_ERR(fp_io_pool)) {
+		ret = PTR_ERR(fp_io_pool);
+		fp_io_pool = NULL;
+		goto out_stage;
+	}
+	fp_req = qcom_tzmem_alloc(fp_io_pool, FP_IO_SZ, GFP_KERNEL);
+	fp_rsp = qcom_tzmem_alloc(fp_io_pool, FP_IO_SZ, GFP_KERNEL);
+	if (!fp_req || !fp_rsp) {
+		ret = -ENOMEM;
+		goto out_io;
+	}
+	ret = qcom_scm_qseecom_app_load(stage, 0, img_len, &fp_app_id);
+	if (ret)
+		goto out_io;
+	fp_loaded = true;
+	/* Keep code and DMA buffers alive until an explicit successful shutdown. */
+	__module_get(THIS_MODULE);
+	fp_dbg("LOAD ok, app_id=%u; unload TA before rmmod\n", fp_app_id);
+	goto out_stage;
+out_io:
+	fp_free_io();
+out_stage:
+	qcom_tzmem_free(stage);
+out_imgpool:
+	qcom_tzmem_pool_free(img_pool);
+out_file:
+	vfree(filebuf);
+	return ret;
+}
+
+static int fp_unload(void)
+{
+	int ret;
+
+	if (fp_shutdown_failed)
+		return -EIO;
+	if (!fp_loaded)
+		return 0;
+	ret = qcom_scm_qseecom_app_shutdown(fp_app_id);
+	if (ret) {
+		fp_shutdown_failed = true;
+		pr_err("fpcmd: shutdown failed: %d; retaining TA buffers\n", ret);
+		return ret;
+	}
+	fp_loaded = false;
+	fp_free_io();
+	fp_dbg("app_shutdown(%u) ok\n", fp_app_id);
+	module_put(THIS_MODULE);
+	return 0;
+}
+
+static u8 fp_xor8(const u8 *data, size_t len)
+{
+	u8 value = 0;
+	size_t i;
+
+	for (i = 0; i < len; i++)
+		value ^= data[i];
+	return value;
+}
+
+static int fp_send_request(size_t req_len)
+{
+	struct fp_qsee_header *header = fp_req;
+	u32 command, dlen, rlen;
+	size_t rsp_len;
+	int ret;
+
+	fp_rsp_len = 0;
+	if (req_len < sizeof(*header) || req_len > FP_IO_SZ)
+		return -EINVAL;
+	command = le32_to_cpu(header->command);
+	dlen = le32_to_cpu(header->data_len);
+	rlen = le32_to_cpu(header->response_len);
+	if (dlen != req_len - sizeof(*header) || rlen > FP_IO_SZ - sizeof(*header))
+		return -EINVAL;
+	if (command == FP_QSEE_SPI_READ) {
+		if (dlen || rlen < 5)
+			return -EINVAL;
+	} else if (command == FP_QSEE_SPI_WRITE) {
+		const u8 *frame = (const u8 *)(header + 1);
+
+		if (rlen || dlen < 5 || dlen > 1024)
+			return -EINVAL;
+		if (frame[0] != FP_SENSOR_MARKER ||
+		    (((u32)frame[1] << 8) | frame[2]) != dlen - 4 ||
+		    fp_xor8(frame + 1, dlen - 2) != frame[dlen - 1])
+			return -EBADMSG;
+	} else {
+		/* Do not expose unverified template/enrollment commands. */
+		return -EOPNOTSUPP;
+	}
+
+	/* TA sub_ADFC reads exactly rsp_size - 12 bytes from SPI. */
+	rsp_len = sizeof(*header) + rlen;
+	memset(fp_rsp, 0, FP_IO_SZ);
+	ret = qcom_scm_qseecom_app_send(fp_app_id, fp_req, req_len, fp_rsp, rsp_len);
+	msleep(10); /* Windows TA_Commication waits after every exchange. */
+	if (ret) {
+		pr_err("fpcmd: secure transport failed: %d\n", ret);
+		return ret;
+	}
+	/* The TA mutates the input header; the output's first 12 bytes are unused. */
+	if (le32_to_cpu(header->command) != FP_TA_ACK ||
+	    le32_to_cpu(header->response_len) != 0) {
+		pr_err("fpcmd: TA completion rejected\n");
+		return -EPROTO;
+	}
+	fp_rsp_len = rsp_len;
+	return 0;
+}
+
+static int fp_build_write(u8 sensor_command, const u8 *payload, size_t payload_len)
+{
+	struct fp_qsee_header *header = fp_req;
+	u8 *frame = (u8 *)(header + 1);
+	size_t frame_len = payload_len + 5;
+
+	if (payload_len > 1019 || sizeof(*header) + frame_len > FP_IO_SZ)
+		return -E2BIG;
+	header->command = cpu_to_le32(FP_QSEE_SPI_WRITE);
+	header->data_len = cpu_to_le32(frame_len);
+	header->response_len = 0;
+	frame[0] = FP_SENSOR_MARKER;
+	frame[1] = (payload_len + 1) >> 8;
+	frame[2] = (payload_len + 1) & 0xff;
+	frame[3] = sensor_command;
+	memcpy(&frame[4], payload, payload_len);
+	frame[4 + payload_len] = fp_xor8(&frame[1], payload_len + 3);
+	return sizeof(*header) + frame_len;
+}
+
+static int fp_read_response(size_t data_len, const u8 **data)
+{
+	struct fp_qsee_header *header = fp_req;
+	const u8 *frame = (u8 *)fp_rsp + sizeof(*header);
+	size_t frame_len = data_len + 5;
+	int ret;
+
+	if (data_len > FP_IO_SZ - sizeof(*header) - 5)
+		return -E2BIG;
+	header->command = cpu_to_le32(FP_QSEE_SPI_READ);
+	header->data_len = 0;
+	header->response_len = cpu_to_le32(frame_len);
+	ret = fp_send_request(sizeof(*header));
+	if (ret)
+		return ret;
+	if (fp_rsp_len != sizeof(*header) + frame_len ||
+	    frame[0] != FP_SENSOR_MARKER ||
+	    (((size_t)frame[1] << 8) | frame[2]) != data_len + 1) {
+		pr_err("fpcmd: invalid sensor frame header\n");
+		return -EPROTO;
+	}
+	if (fp_xor8(frame + 1, frame_len - 2) != frame[frame_len - 1]) {
+		pr_err("fpcmd: sensor XOR mismatch\n");
+		return -EBADMSG;
+	}
+	if (frame[3] != FP_SENSOR_OK) {
+		pr_err("fpcmd: sensor status=%#x\n", frame[3]);
+		return -EIO;
+	}
+	*data = frame + 4;
+	return 0;
+}
+
+static int fp_write_sensor(u8 sensor_command, const u8 *payload,
+			   size_t payload_len)
+{
+	const u8 *response;
+	int req_len;
+	int ret;
+
+	req_len = fp_build_write(sensor_command, payload, payload_len);
+	if (req_len < 0)
+		return req_len;
+	ret = fp_send_request(req_len);
+	if (ret)
+		return ret;
+	/* The vendor write helper reads and validates a zero-data status frame. */
+	return fp_read_response(0, &response);
+}
+
+static int fp_write_sensor_no_status(u8 sensor_command, const u8 *payload,
+				      size_t payload_len)
+{
+	int req_len;
+
+	/* ff_sc_ReadSram uses the raw write helper for 0x8b and immediately
+	 * follows it with BulkRead; reading a status frame here would consume
+	 * the first five bytes of the image response. */
+	req_len = fp_build_write(sensor_command, payload, payload_len);
+	if (req_len < 0)
+		return req_len;
+	return fp_send_request(req_len);
+}
+
+static int fp_read_after_write(u8 sensor_command, const u8 *payload,
+				size_t payload_len, size_t count, u8 *result)
+{
+	const u8 *data;
+	int req_len;
+	int ret;
+
+	req_len = fp_build_write(sensor_command, payload, payload_len);
+	if (req_len < 0)
+		return req_len;
+	ret = fp_send_request(req_len);
+	if (ret)
+		return ret;
+	ret = fp_read_response(count, &data);
+	if (ret)
+		return ret;
+	memcpy(result, data, count);
+	return 0;
+}
+
+static int fp_read_indirect_byte(u8 *result)
+{
+	struct fp_qsee_header *header = fp_req;
+	const u8 *raw = (u8 *)fp_rsp + sizeof(*header);
+	const u8 *data;
+	int ret;
+
+	/* Windows ReadInfo_Indirectly asks the TA for one byte but accepts the
+	 * transport result as an opaque response; this command does not always
+	 * return the normal sensor frame used by 0x88. */
+	header->command = cpu_to_le32(FP_QSEE_SPI_READ);
+	header->data_len = 0;
+	header->response_len = cpu_to_le32(6);
+	ret = fp_send_request(sizeof(*header));
+	if (ret)
+		return ret;
+	if (fp_rsp_len == sizeof(*header) + 6 && raw[0] == 0xf8 &&
+		raw[1] == 0xf8 && raw[2] == 0xf8 && raw[3] == 0xf8 &&
+		raw[4] == 0xf8 && raw[5] == 0xf8) {
+		*result = raw[0];
+		fp_dbg("accepted opaque 0x89 response byte %#x\n", *result);
+		return 0;
+	}
+	/* Also accept a normal framed one-byte response if firmware supplies it. */
+	if (fp_rsp_len == sizeof(*header) + 6 && raw[0] == FP_SENSOR_MARKER &&
+		(((size_t)raw[1] << 8) | raw[2]) == 2 && raw[3] == FP_SENSOR_OK &&
+		fp_xor8(raw + 1, 4) == raw[5]) {
+		data = raw + 4;
+		*result = data[0];
+		return 0;
+	}
+	fp_dbg_dump("fpcmd: invalid 0x89 response: ", fp_rsp, fp_rsp_len);
+	return -EPROTO;
+}
+
+static int fp_read_register(u8 reg, size_t count, u8 *result)
+{
+	u8 payload[] = { reg, count };
+	int attempt, ret;
+
+	for (attempt = 0; attempt < 3; attempt++) {
+		ret = fp_read_after_write(0x88, payload, sizeof(payload), count, result);
+		if (!ret || (ret != -EPROTO && ret != -EBADMSG))
+			break;
+		msleep(5);
+	}
+	if (ret)
+		return ret;
+	if (reg != 0x1d)
+		fp_dbg("register %#x = %*phN\n", reg, (int)count, result);
+	msleep(1); /* ff_sc_ReadInfo_directly */
+	return 0;
+}
+
+static int fp_write_info(u8 reg, u8 value)
+{
+	u8 payload[] = { reg, 1, value };
+
+	/* Windows ff_sc_WriteInfo uses command 0x87 and a three-byte payload. */
+	return fp_write_sensor(0x87, payload, sizeof(payload));
+}
+
+static int fp_init_sleep_mode(void)
+{
+	u8 indirect_payload[] = { 0x1d, 1 };
+	u8 status[2], ignored;
+	int attempt, ret;
+
+	/* ff_sc_init_sleep_mode: WriteInfo(0x1f,1), WriteInfo(0x1e,1). */
+	ret = fp_write_info(0x1f, 1);
+	if (ret)
+		return ret;
+	ret = fp_write_info(0x1e, 1);
+	if (ret)
+		return ret;
+	for (attempt = 0; attempt < 50; attempt++) {
+		msleep(3);
+		ret = fp_read_register(0x20, sizeof(status), status);
+		if (!ret && status[0] == 0xa5 && status[1] == 0x5a)
+			break;
+	}
+	if (attempt == 50)
+		return ret ? ret : -ETIMEDOUT;
+
+	/* Windows ff_sc_ReadInfo_Indirectly retries the complete 0x89 write/read
+	 * transaction up to three times.  The sensor can return a transient raw
+	 * 0xf8 byte sequence immediately after the mode writes; do not turn that
+	 * first response into a permanent protocol failure. */
+	ret = -EIO;
+	for (attempt = 0; attempt < 3; attempt++) {
+		ret = fp_build_write(0x89, indirect_payload,
+				      sizeof(indirect_payload));
+		if (ret >= 0)
+			ret = fp_send_request(ret);
+		if (!ret)
+			ret = fp_read_indirect_byte(&ignored);
+		if (!ret)
+			break;
+		fp_dbg("indirect read attempt %d failed: %d\n", attempt + 1, ret);
+		msleep(1);
+	}
+	if (ret)
+		return ret;
+	msleep(1);
+	ret = fp_read_register(0x20, sizeof(status), status);
+	if (ret)
+		return ret;
+	if (status[0] != 0xa5 || status[1] != 0x5a)
+		return -EIO;
+	return 0;
+}
+
+static int fp_vendor_wake(void);
+
+static int fp_vendor_init(void)
+{
+	u8 width, height;
+	int ret;
+
+	/* GPIO reset is a separate user-space GPIO v2 operation. Linux global GPIO
+	 * numbers differ from TLMM line offsets on this board. */
+	fp_dbg("init assumes the FTE7001 reset line was pulsed externally\n");
+	/* ff_sc_fp_chip_init: wake/status, dimensions, 0x01/0x30 writes,
+	 * then the sensor-mode sleep initialization. */
+	ret = fp_vendor_wake();
+	if (ret)
+		return ret;
+	ret = fp_read_register(0x14, sizeof(width), &width);
+	if (ret)
+		return ret;
+	ret = fp_read_register(0x15, sizeof(height), &height);
+	if (ret)
+		return ret;
+	if (!width || !height)
+		return -ENODATA;
+	ret = fp_write_info(0x01, 0x01);
+	if (ret)
+		return ret;
+	ret = fp_write_info(0x30, 0xbb);
+	if (ret)
+		return ret;
+	ret = fp_vendor_wake();
+	if (ret)
+		return ret;
+	ret = fp_init_sleep_mode();
+	if (ret)
+		return ret;
+	fp_dbg("Windows init sequence completed: resolution %ux%u\n", width, height);
+	return 0;
+}
+
+static int fp_vendor_wake(void)
+{
+	const u8 wake_payload[] = { 0x01, 0x70 };
+	u8 status[2];
+	int attempt;
+	int ret;
+
+	ret = fp_read_register(0x20, sizeof(status), status);
+	if (!ret && status[0] == 0xa5 && status[1] == 0x5a) {
+		fp_dbg("sensor already awake\n");
+		return 0;
+	}
+
+	for (attempt = 0; attempt < 10; attempt++) {
+		ret = fp_write_sensor(0x8e, wake_payload, sizeof(wake_payload));
+		if (ret)
+			return ret;
+		msleep(5);
+		ret = fp_write_sensor(0x8e, wake_payload, sizeof(wake_payload));
+		if (ret)
+			return ret;
+		msleep(10);
+
+		ret = fp_read_register(0x20, sizeof(status), status);
+		if (!ret && status[0] == 0xa5 && status[1] == 0x5a) {
+			fp_dbg("sensor awake after %d attempt(s)\n", attempt + 1);
+			return 0;
+		}
+		if (ret)
+			fp_dbg("wake attempt %d status read failed: %d\n", attempt + 1, ret);
+	}
+
+	pr_err("fpcmd: sensor did not become ready after 10 wake attempts\n");
+	return ret ? ret : -ETIMEDOUT;
+}
+
+
+/*
+ * Windows OnScanImage first selects scan-image mode (0x87/00 01 6c),
+ * programs the SRAM window with 0x8b/34 00 <big-endian byte count>, then
+ * reads exactly 2*width*height bytes after a 20 ms delay.  The payload is
+ * the encrypted 16-bit image buffer; the UMDF path decrypts and converts it
+ * after this transport step.  Keep this interface raw and bounded so the
+ * first Linux test can be inspected offline.
+ */
+static int fp_read_raw_response(size_t response_bytes, const u8 **data)
+{
+	struct fp_qsee_header *header = fp_req;
+	int ret;
+
+	if (response_bytes < 5 ||
+	    response_bytes > FP_IO_SZ - sizeof(*header))
+		return -E2BIG;
+	header->command = cpu_to_le32(FP_QSEE_SPI_READ);
+	header->data_len = 0;
+	header->response_len = cpu_to_le32(response_bytes);
+	ret = fp_send_request(sizeof(*header));
+	if (ret)
+		return ret;
+	if (fp_rsp_len != sizeof(*header) + response_bytes)
+		return -EPROTO;
+	*data = (u8 *)fp_rsp + sizeof(*header);
+	fp_dbg_dump("fpcmd: raw response head: ", *data,
+		    min_t(size_t, response_bytes, 64));
+	if (response_bytes > 64)
+		fp_dbg_dump("fpcmd: raw response tail: ",
+			    *data + response_bytes - min_t(size_t, response_bytes, 64),
+			    min_t(size_t, response_bytes, 64));
+	return 0;
+}
+
+static int fp_capture_raw(size_t image_bytes)
+{
+	static const u8 scan_mode[] = { 0x00, 0x01, 0x6c };
+	u8 sram_setup[] = { 0x34, 0x00, 0x00, 0x00 };
+	u8 status[2];
+	const u8 *raw;
+	size_t response_bytes = image_bytes + 5;
+	int attempt, ret;
+
+	if (!image_bytes || image_bytes > FP_CAPTURE_MAX || (image_bytes & 1))
+		return -EINVAL;
+	if (image_bytes > U16_MAX)
+		return -E2BIG;
+
+	/* OnScanImage wakes the part, switches to scan mode, then waits for the
+	 * ready status before asking the SRAM window for the image. */
+	ret = fp_vendor_wake();
+	if (ret)
+		return ret;
+	ret = fp_write_sensor(0x87, scan_mode, sizeof(scan_mode));
+	if (ret)
+		return ret;
+	ret = -ETIMEDOUT;
+	for (attempt = 0; attempt < 6; attempt++) {
+		msleep(10);
+		ret = fp_read_register(0x20, sizeof(status), status);
+		if (!ret && status[0] == 0xa5 && status[1] == 0x5a)
+			break;
+	}
+	if (ret)
+		return ret;
+
+	sram_setup[2] = image_bytes >> 8;
+	sram_setup[3] = image_bytes;
+	ret = fp_write_sensor_no_status(0x8b, sram_setup, sizeof(sram_setup));
+	if (ret)
+		return ret;
+	msleep(20);
+
+	ret = fp_read_raw_response(response_bytes, &raw);
+	if (ret)
+		return ret;
+	if (raw[0] == FP_SENSOR_MARKER &&
+	    (((size_t)raw[1] << 8) | raw[2]) == image_bytes + 1 &&
+	    raw[3] == FP_SENSOR_OK &&
+	    fp_xor8(raw + 1, response_bytes - 2) == raw[response_bytes - 1]) {
+		memcpy(fp_capture_data, raw + 4, image_bytes);
+		fp_capture_len = image_bytes;
+		fp_dbg("raw capture ok, %zu encrypted bytes; first 16=%*phN\n",
+		       image_bytes, 16, fp_capture_data);
+		return 0;
+	}
+
+	/* Never expose an invalid secure response as biometric image data. */
+	fp_capture_len = 0;
+	pr_err("fpcmd: sensor returned an invalid image frame\n");
+	return -EPROTO;
+}
+
+static int fp_vendor_probe(void)
+{
+	u8 status[2], width, height;
+	int ret;
+
+	ret = fp_read_register(0x20, sizeof(status), status);
+	if (ret)
+		return ret;
+	if (status[0] != 0xa5 || status[1] != 0x5a) {
+		pr_err("fpcmd: sensor is not awake/ready; no automatic wake attempted\n");
+		return -EAGAIN;
+	}
+	ret = fp_read_register(0x14, sizeof(width), &width);
+	if (ret)
+		return ret;
+	ret = fp_read_register(0x15, sizeof(height), &height);
+	if (ret)
+		return ret;
+	if (!width || !height)
+		return -ENODATA;
+	fp_dbg("probe ok: resolution %ux%u (no image capture)\n", width, height);
+	return 0;
+}
+
+static long fp_ioctl(struct file *file, unsigned int command,
+		     unsigned long argument)
+{
+	void __user *argp = (void __user *)argument;
+	struct gaokun3_fpcmd_capture capture;
+	u8 status;
+	int ret;
+
+	(void)file;
+	switch (command) {
+	case GAOKUN3_FPCMD_IOC_LOAD:
+		mutex_lock(&fp_lock);
+		ret = fp_load();
+		mutex_unlock(&fp_lock);
+		return ret;
+	case GAOKUN3_FPCMD_IOC_UNLOAD:
+		mutex_lock(&fp_lock);
+		ret = fp_unload();
+		mutex_unlock(&fp_lock);
+		return ret;
+	case GAOKUN3_FPCMD_IOC_INIT:
+		mutex_lock(&fp_lock);
+		ret = fp_loaded ? fp_vendor_init() : -ENODEV;
+		mutex_unlock(&fp_lock);
+		if (ret)
+			pr_err("fpcmd: sensor initialization failed: %d\n", ret);
+		return ret;
+	case GAOKUN3_FPCMD_IOC_PROBE:
+		mutex_lock(&fp_lock);
+		ret = fp_loaded ? fp_vendor_probe() : -ENODEV;
+		mutex_unlock(&fp_lock);
+		if (ret)
+			pr_err("fpcmd: sensor probe failed: %d\n", ret);
+		return ret;
+	case GAOKUN3_FPCMD_IOC_WAKE:
+		mutex_lock(&fp_lock);
+		ret = fp_loaded ? fp_vendor_wake() : -ENODEV;
+		mutex_unlock(&fp_lock);
+		return ret;
+	case GAOKUN3_FPCMD_IOC_CAPTURE:
+		if (copy_from_user(&capture, argp, sizeof(capture)))
+			return -EFAULT;
+		if (capture.reserved || !capture.user_ptr)
+			return -EINVAL;
+		mutex_lock(&fp_lock);
+		if (!fp_loaded)
+			ret = -ENODEV;
+		else
+			ret = fp_capture_raw(capture.image_bytes);
+		if (!ret && copy_to_user(u64_to_user_ptr(capture.user_ptr),
+					 fp_capture_data, fp_capture_len))
+			ret = -EFAULT;
+		mutex_unlock(&fp_lock);
+		return ret;
+	case GAOKUN3_FPCMD_IOC_GET_FINGER_STATUS:
+		mutex_lock(&fp_lock);
+		ret = fp_loaded ? fp_read_register(0x1d, 1, &status) : -ENODEV;
+		mutex_unlock(&fp_lock);
+		if (ret)
+			return ret;
+		status &= 1;
+		return copy_to_user(argp, &status, sizeof(status)) ? -EFAULT : 0;
+	default:
+		return -ENOTTY;
+	}
+}
+
+/* Single owner across processes and threads; close after a HAL crash must
+ * shut down the TA before any subsequent GPIO reset. A failed shutdown keeps
+ * this device unavailable until reboot, retaining the secure buffers. */
+static int fp_open(struct inode *inode, struct file *file)
+{
+	int ret = 0;
+
+	mutex_lock(&fp_lock);
+	if (fp_opened || fp_loaded)
+		ret = -EBUSY;
+	else
+		fp_opened = true;
+	mutex_unlock(&fp_lock);
+	return ret;
+}
+
+static int fp_release(struct inode *inode, struct file *file)
+{
+	int ret;
+
+	mutex_lock(&fp_lock);
+	ret = fp_unload();
+	if (!ret)
+		fp_opened = false;
+	mutex_unlock(&fp_lock);
+	return ret;
+}
+
+static const struct file_operations fp_fops = {
+	.owner = THIS_MODULE,
+	.open = fp_open,
+	.release = fp_release,
+	.unlocked_ioctl = fp_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl = compat_ptr_ioctl,
+#endif
+	.llseek = noop_llseek,
+};
+
+static struct miscdevice fp_miscdev = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "gaokun3_fpcmd",
+	.fops = &fp_fops,
+	.mode = 0600,
+};
+
+static int __init fpcmd_init(void)
+{
+	int ret;
+
+	fp_capture_data = vzalloc(FP_CAPTURE_MAX);
+	if (!fp_capture_data)
+		return -ENOMEM;
+	ret = misc_register(&fp_miscdev);
+	if (ret) {
+		vfree(fp_capture_data);
+		fp_capture_data = NULL;
+		return ret;
+	}
+	fp_dbg("registered /dev/%s; no TA call until an explicit ioctl\n",
+	       fp_miscdev.name);
+	return 0;
+}
+
+static void __exit fpcmd_exit(void)
+{
+	/* The load reference prevents exit while the TA is still active. */
+	misc_deregister(&fp_miscdev);
+	vfree(fp_capture_data);
+	fp_capture_data = NULL;
+	fp_capture_len = 0;
+}
+module_init(fpcmd_init);
+module_exit(fpcmd_exit);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Gaokun3 FocalTech fingerprint QSEE transport");
