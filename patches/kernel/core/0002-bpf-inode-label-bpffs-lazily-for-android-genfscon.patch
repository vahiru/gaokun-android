From: Vahiru <nekovahiru@gmail.com>
Subject: [PATCH] bpf: inode: skip eager security_inode_init_security() for Android genfscon labeling

Mainline bpffs calls security_inode_init_security() during inode creation in
bpf_mkdir(), bpf_mkobj_ops(), and bpf_symlink(). On Android, SELinux labels
/sys/fs/bpf subdirectories and pinned objects via path-based genfscon rules
rather than xattrs; eager initialization before the dentry is attached assigns
the parent directory's context to new objects and breaks netd / bpfloader
SELinux checks.

Skip security_inode_init_security() in bpffs so SELinux falls back to lazy
genfscon path-based labeling when the dentry is instantiated.

Origin: local
Upstream-Status: Inappropriate [Android-specific]
---
diff --git a/kernel/bpf/inode.c b/kernel/bpf/inode.c
index 7837968c0842..cc3564630257 100644
--- a/kernel/bpf/inode.c
+++ b/kernel/bpf/inode.c
@@ -46,6 +46,13 @@ static inline struct bpf_fs_inode *BPF_FS_I(struct inode *inode)
 
 static struct kmem_cache *bpf_fs_inode_cachep __ro_after_init;
 
+/*
+ * On Android, SELinux labels bpffs paths via genfscon rules; skip eager
+ * security_inode_init_security() so inodes use lazy path-based labeling
+ * instead of inheriting the parent directory's label before dentry attach.
+ */
+#define BPF_FS_EAGER_SECURITY_INIT 0
+
 static int bpf_fs_initxattrs(struct inode *inode,
 			     const struct xattr *xattr_array, void *fs_info);
 static ssize_t bpf_fs_listxattr(struct dentry *dentry, char *buf, size_t size);
@@ -186,8 +193,10 @@ static struct dentry *bpf_mkdir(struct mnt_idmap *idmap, struct inode *dir,
 	if (IS_ERR(inode))
 		return ERR_CAST(inode);
 
-	ret = security_inode_init_security(inode, dir, &dentry->d_name,
-					   bpf_fs_initxattrs, NULL);
+	ret = BPF_FS_EAGER_SECURITY_INIT
+		? security_inode_init_security(inode, dir, &dentry->d_name,
+					       bpf_fs_initxattrs, NULL)
+		: 0;
 	if (ret && ret != -EOPNOTSUPP) {
 		iput(inode);
 		return ERR_PTR(ret);
@@ -372,8 +381,10 @@ static int bpf_mkobj_ops(struct dentry *dentry, umode_t mode, void *raw,
 	if (IS_ERR(inode))
 		return PTR_ERR(inode);
 
-	ret = security_inode_init_security(inode, dir, &dentry->d_name,
-					   bpf_fs_initxattrs, NULL);
+	ret = BPF_FS_EAGER_SECURITY_INIT
+		? security_inode_init_security(inode, dir, &dentry->d_name,
+					       bpf_fs_initxattrs, NULL)
+		: 0;
 	if (ret && ret != -EOPNOTSUPP) {
 		iput(inode);
 		return ret;
@@ -444,8 +455,10 @@ static int bpf_symlink(struct mnt_idmap *idmap, struct inode *dir,
 	inode->i_op = &bpf_symlink_iops;
 	inode->i_link = link;
 
-	ret = security_inode_init_security(inode, dir, &dentry->d_name,
-					   bpf_fs_initxattrs, NULL);
+	ret = BPF_FS_EAGER_SECURITY_INIT
+		? security_inode_init_security(inode, dir, &dentry->d_name,
+					       bpf_fs_initxattrs, NULL)
+		: 0;
 	if (ret && ret != -EOPNOTSUPP) {
 		iput(inode);
 		return ret;
