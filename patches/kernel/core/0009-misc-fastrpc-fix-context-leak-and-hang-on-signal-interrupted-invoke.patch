Co-developed-by: Srinivas Kandagatla <srinivas.kandagatla@oss.qualcomm.com>
Signed-off-by: Srinivas Kandagatla <srinivas.kandagatla@oss.qualcomm.com>
Signed-off-by: Anandu Krishnan E <anandu.e@oss.qualcomm.com>
Link: https://patch.msgid.link/20261002-anandu-fastrpc-interrupted-invoke-v3-v3-1-31e90439d2ba@oss.qualcomm.com
[Akisaira: backported to v7.2.9, which has no polling mode and no
 fastrpc_wait_for_response(), so the wait stays in fastrpc_internal_invoke().
 Changes from v3, which the text above doesn't reflect:
 - fastrpc_context_schedule_put_work() uses xchg() instead of fl->lock.
   fastrpc_rpmsg_callback() runs in hard interrupt context with glink over
   smem and fl->lock isn't IRQ-safe, so taking it there can deadlock on one
   CPU.
 - Only the wait parks a context. An -ERESTARTSYS from rpmsg_send() never
   reached the DSP, and the retry would wait for a reply that can't come.
 - A retry resumes only with the same args, as ctx->args isn't repointed on
   resume, in v3 either. A different retry is a new call.
 - invoke_interrupted_mmaps stays, now filled at close if a context is still
   parked. Its reply can free fl long after the close, while a static PD still
   has fl->mmaps mapped, which is what 76e8e4ace1ed guards against.
 - The INTERRUPTED message is dev_dbg, as each system suspend prints it.
 - fastrpc_notify_users() doesn't drain fl->interrupted as the text above
   says. It drops the worker reference and leaves the context parked. The
   invoker reference goes when the call resumes or in
   fastrpc_device_release(), and once that has unlinked fl from the channel,
   a context whose reply never comes keeps itself and fl alive.
 - fastrpc_rpmsg_remove() walks invoke_interrupted_mmaps under cctx->lock.
   Close now adds to that list, and misc_deregister() doesn't wait for open
   fds.]
Signed-off-by: Akisaira <akisaira@outlook.com>
Assisted-by: Claude:claude-opus-5-5
Origin: backport, https://patch.msgid.link/20261002-anandu-fastrpc-interrupted-invoke-v3-v3-1-31e90439d2ba@oss.qualcomm.com
Upstream-Status: Backport [https://patch.msgid.link/20261002-anandu-fastrpc-interrupted-invoke-v3-v3-1-31e90439d2ba@oss.qualcomm.com]
---
 drivers/misc/fastrpc.c | 178 +++++++++++++++++++++++++++++++++++------
 1 file changed, 152 insertions(+), 26 deletions(-)

diff --git a/drivers/misc/fastrpc.c b/drivers/misc/fastrpc.c
index d7a9e12f5..e5a77dfaf 100644
--- a/drivers/misc/fastrpc.c
+++ b/drivers/misc/fastrpc.c
@@ -233,9 +233,12 @@ struct fastrpc_invoke_ctx {
 	int pid;
 	int client_id;
 	u32 sc;
+	u32 handle;
 	u32 *crc;
 	u64 ctxid;
 	u64 msg_sz;
+	/* set once put_work has been scheduled for this ctx */
+	bool put_work_scheduled;
 	struct kref refcount;
 	struct list_head node; /* list of ctxs */
 	struct completion work;
@@ -297,6 +300,7 @@ struct fastrpc_user {
 	struct list_head user;
 	struct list_head maps;
 	struct list_head pending;
+	struct list_head interrupted;
 	struct list_head mmaps;
 
 	struct fastrpc_channel_ctx *cctx;
@@ -519,7 +523,12 @@ static void fastrpc_user_free(struct kref *ref)
 		fastrpc_buf_free(fl->init_mem);
 
 	list_for_each_entry_safe(ctx, n, &fl->pending, node) {
-		list_del(&ctx->node);
+		list_del_init(&ctx->node);
+		fastrpc_context_put(ctx);
+	}
+
+	list_for_each_entry_safe(ctx, n, &fl->interrupted, node) {
+		list_del_init(&ctx->node);
 		fastrpc_context_put(ctx);
 	}
 
@@ -558,6 +567,11 @@ static void fastrpc_context_free(struct kref *ref)
 	cctx = ctx->cctx;
 	fl = ctx->fl;
 
+	spin_lock(&fl->lock);
+	if (!list_empty(&ctx->node))
+		list_del_init(&ctx->node);
+	spin_unlock(&fl->lock);
+
 	for (i = 0; i < ctx->nbufs; i++)
 		fastrpc_map_put(ctx->maps[i]);
 
@@ -570,6 +584,7 @@ static void fastrpc_context_free(struct kref *ref)
 
 	kfree(ctx->maps);
 	kfree(ctx->olaps);
+	kfree(ctx->args);
 	kfree(ctx);
 
 	/* Release the reference taken in fastrpc_context_alloc() */
@@ -595,6 +610,54 @@ static void fastrpc_context_put_wq(struct work_struct *work)
 	fastrpc_context_put(ctx);
 }
 
+/*
+ * Ensures put_work is scheduled at most once per ctx; racing callers may both
+ * try. No fl->lock here: fastrpc_rpmsg_callback() runs in hard interrupt
+ * context with glink over smem, and fl->lock isn't IRQ-safe.
+ */
+static void fastrpc_context_schedule_put_work(struct fastrpc_invoke_ctx *ctx)
+{
+	if (!xchg(&ctx->put_work_scheduled, true))
+		schedule_work(&ctx->put_work);
+}
+
+/* References taken for ctx are left intact; ownership just moves between lists. */
+static void fastrpc_context_save_interrupted(struct fastrpc_invoke_ctx *ctx)
+{
+	spin_lock(&ctx->fl->lock);
+	list_del(&ctx->node);
+	list_add_tail(&ctx->node, &ctx->fl->interrupted);
+	spin_unlock(&ctx->fl->lock);
+}
+
+/*
+ * Matches on handle, sc and args: the restarted syscall passes all of them
+ * unchanged. Anything else is a different call, whose buffers the DSP's output
+ * wouldn't reach.
+ */
+static struct fastrpc_invoke_ctx *fastrpc_context_restore_interrupted(
+			struct fastrpc_user *fl, u32 handle, u32 sc,
+			struct fastrpc_invoke_args *args)
+{
+	struct fastrpc_invoke_ctx *ctx = NULL, *ictx;
+
+	spin_lock(&fl->lock);
+	list_for_each_entry(ictx, &fl->interrupted, node) {
+		if (ictx->pid == current->pid && ictx->handle == handle &&
+		    ictx->sc == sc &&
+		    (!ictx->nscalars ||
+		     !memcmp(ictx->args, args, ictx->nscalars * sizeof(*args)))) {
+			ctx = ictx;
+			list_del(&ctx->node);
+			list_add_tail(&ctx->node, &fl->pending);
+			break;
+		}
+	}
+	spin_unlock(&fl->lock);
+
+	return ctx;
+}
+
 #define CMP(aa, bb) ((aa) == (bb) ? 0 : (aa) < (bb) ? -1 : 1)
 static int olaps_cmp(const void *a, const void *b)
 {
@@ -675,7 +738,15 @@ static struct fastrpc_invoke_ctx *fastrpc_context_alloc(
 			kfree(ctx);
 			return ERR_PTR(-ENOMEM);
 		}
-		ctx->args = args;
+		/* Own copy: ctx may outlive the caller's args if parked on fl->interrupted. */
+		ctx->args = kzalloc_objs(*ctx->args, ctx->nscalars);
+		if (!ctx->args) {
+			kfree(ctx->olaps);
+			kfree(ctx->maps);
+			kfree(ctx);
+			return ERR_PTR(-ENOMEM);
+		}
+		memcpy(ctx->args, args, ctx->nscalars * sizeof(*args));
 		fastrpc_get_buff_overlaps(ctx);
 	}
 
@@ -717,6 +788,7 @@ static struct fastrpc_invoke_ctx *fastrpc_context_alloc(
 	fastrpc_channel_ctx_put(cctx);
 	kfree(ctx->maps);
 	kfree(ctx->olaps);
+	kfree(ctx->args);
 	kfree(ctx);
 
 	return ERR_PTR(ret);
@@ -1244,8 +1316,7 @@ static int fastrpc_internal_invoke(struct fastrpc_user *fl,  u32 kernel,
 				   struct fastrpc_invoke_args *args)
 {
 	struct fastrpc_invoke_ctx *ctx = NULL;
-	struct fastrpc_buf *buf, *b;
-
+	bool resumed = false;
 	int err = 0;
 
 	if (!fl->sctx)
@@ -1259,9 +1330,21 @@ static int fastrpc_internal_invoke(struct fastrpc_user *fl,  u32 kernel,
 		return -EPERM;
 	}
 
-	ctx = fastrpc_context_alloc(fl, kernel, sc, args);
-	if (IS_ERR(ctx))
-		return PTR_ERR(ctx);
+	if (!kernel)
+		ctx = fastrpc_context_restore_interrupted(fl, handle, sc, args);
+
+	if (ctx) {
+		/* ctx->args is already populated from before the interruption. */
+		resumed = true;
+	} else {
+		ctx = fastrpc_context_alloc(fl, kernel, sc, args);
+		if (IS_ERR(ctx))
+			return PTR_ERR(ctx);
+		ctx->handle = handle;
+	}
+
+	if (resumed)
+		goto wait;
 
 	err = fastrpc_get_args(kernel, ctx);
 	if (err)
@@ -1274,11 +1357,23 @@ static int fastrpc_internal_invoke(struct fastrpc_user *fl,  u32 kernel,
 	if (err)
 		goto bail;
 
+wait:
 	if (kernel) {
-		if (!wait_for_completion_timeout(&ctx->work, 10 * HZ))
+		if (!wait_for_completion_timeout(&ctx->work, 10 * HZ)) {
 			err = -ETIMEDOUT;
+			dev_warn(fl->sctx->dev,
+				 "fastrpc_invoke: TIMEOUT ctxid=0x%llx handle=0x%x nscalars=%d\n",
+				 ctx->ctxid, ctx->handle, ctx->nscalars);
+		}
 	} else {
 		err = wait_for_completion_interruptible(&ctx->work);
+		if (err == -ERESTARTSYS) {
+			dev_dbg(fl->sctx->dev,
+				"fastrpc_invoke: INTERRUPTED ctxid=0x%llx handle=0x%x nscalars=%d\n",
+				ctx->ctxid, ctx->handle, ctx->nscalars);
+			fastrpc_context_save_interrupted(ctx);
+			return err;
+		}
 	}
 
 	if (err)
@@ -1297,22 +1392,10 @@ static int fastrpc_internal_invoke(struct fastrpc_user *fl,  u32 kernel,
 		goto bail;
 
 bail:
-	if (err != -ERESTARTSYS && err != -ETIMEDOUT) {
-		/* We are done with this compute context */
-		spin_lock(&fl->lock);
-		list_del(&ctx->node);
-		spin_unlock(&fl->lock);
-		fastrpc_context_put(ctx);
-	}
-
-	if (err == -ERESTARTSYS) {
-		spin_lock(&fl->lock);
-		list_for_each_entry_safe(buf, b, &fl->mmaps, node) {
-			list_del(&buf->node);
-			list_add_tail(&buf->node, &fl->cctx->invoke_interrupted_mmaps);
-		}
-		spin_unlock(&fl->lock);
-	}
+	spin_lock(&fl->lock);
+	list_del_init(&ctx->node);
+	spin_unlock(&fl->lock);
+	fastrpc_context_put(ctx);
 
 	if (err)
 		dev_dbg(fl->sctx->dev, "Error: Invoke Failed %d\n", err);
@@ -1628,14 +1711,40 @@ static int fastrpc_device_release(struct inode *inode, struct file *file)
 {
 	struct fastrpc_user *fl = (struct fastrpc_user *)file->private_data;
 	struct fastrpc_channel_ctx *cctx = fl->cctx;
+	struct fastrpc_invoke_ctx *ctx, *n;
 	unsigned long flags;
+	LIST_HEAD(mmaps);
 
 	fastrpc_release_current_dsp_process(fl);
 
+	/*
+	 * A parked context can outlive this close, and its reply can then free
+	 * fl while the DSP still uses fl->mmaps. Keep them with the channel.
+	 * Not nested in cctx->lock: the rpmsg callback takes that one in hard
+	 * interrupt context, and fl->lock isn't IRQ-safe.
+	 */
+	spin_lock(&fl->lock);
+	if (!list_empty(&fl->interrupted))
+		list_splice_init(&fl->mmaps, &mmaps);
+	spin_unlock(&fl->lock);
+
 	spin_lock_irqsave(&cctx->lock, flags);
 	list_del(&fl->user);
+	list_splice_tail(&mmaps, &cctx->invoke_interrupted_mmaps);
 	spin_unlock_irqrestore(&cctx->lock, flags);
 
+	/* fl is already unlinked from cctx->users; drop the invoker's ref so it isn't leaked. */
+	spin_lock(&fl->lock);
+	list_for_each_entry_safe(ctx, n, &fl->interrupted, node) {
+		list_del_init(&ctx->node);
+		ctx->retval = -EPIPE;
+		complete(&ctx->work);
+		spin_unlock(&fl->lock);
+		fastrpc_context_put(ctx);
+		spin_lock(&fl->lock);
+	}
+	spin_unlock(&fl->lock);
+
 	fastrpc_session_free(cctx, fl->sctx);
 	file->private_data = NULL;
 	/* Release the reference taken in fastrpc_device_open */
@@ -1665,6 +1774,7 @@ static int fastrpc_device_open(struct inode *inode, struct file *filp)
 	spin_lock_init(&fl->lock);
 	mutex_init(&fl->mutex);
 	INIT_LIST_HEAD(&fl->pending);
+	INIT_LIST_HEAD(&fl->interrupted);
 	INIT_LIST_HEAD(&fl->maps);
 	INIT_LIST_HEAD(&fl->mmaps);
 	INIT_LIST_HEAD(&fl->user);
@@ -1770,6 +1880,7 @@ static int fastrpc_invoke(struct fastrpc_user *fl, char __user *argp)
 	}
 
 	err = fastrpc_internal_invoke(fl, false, inv.handle, inv.sc, args);
+	/* ctx keeps its own copy of args, so this is always safe to free. */
 	kfree(args);
 
 	return err;
@@ -2498,6 +2609,16 @@ static void fastrpc_notify_users(struct fastrpc_user *user)
 		ctx->retval = -EPIPE;
 		complete(&ctx->work);
 	}
+
+	/*
+	 * Drops only the worker ref. The invoker ref goes when the call resumes
+	 * or in fastrpc_device_release().
+	 */
+	list_for_each_entry(ctx, &user->interrupted, node) {
+		ctx->retval = -EPIPE;
+		complete(&ctx->work);
+		fastrpc_context_schedule_put_work(ctx);
+	}
 	spin_unlock(&user->lock);
 }
 
@@ -2521,8 +2642,11 @@ static void fastrpc_rpmsg_remove(struct rpmsg_device *rpdev)
 	if (cctx->secure_fdevice)
 		misc_deregister(&cctx->secure_fdevice->miscdev);
 
+	/* misc_deregister() doesn't wait for open fds, and a close adds to this list. */
+	spin_lock_irqsave(&cctx->lock, flags);
 	list_for_each_entry_safe(buf, b, &cctx->invoke_interrupted_mmaps, node)
 		list_del(&buf->node);
+	spin_unlock_irqrestore(&cctx->lock, flags);
 
 	if (cctx->remote_heap)
 		fastrpc_buf_free(cctx->remote_heap);
@@ -2564,9 +2688,11 @@ static int fastrpc_rpmsg_callback(struct rpmsg_device *rpdev, void *data,
 	/*
 	 * The DMA buffer associated with the context cannot be freed in
 	 * interrupt context so schedule it through a worker thread to
-	 * avoid a kernel BUG.
+	 * avoid a kernel BUG. fastrpc_context_schedule_put_work() guards
+	 * against a concurrent fastrpc_notify_users() also scheduling this
+	 * same work item for an interrupted context.
 	 */
-	schedule_work(&ctx->put_work);
+	fastrpc_context_schedule_put_work(ctx);
 
 	return 0;
 }
