@@ -927,11 +911,31 @@ static void _dpu_crtc_setup_cp_blocks(struct drm_crtc *crtc)
 		if (!dspp)
 			continue;
 
+		/*
+		 * Both banks stay loaded, so switching gamut is one opmode write.
+		 * A modeset may bring DSPPs that lost power; one that turns the
