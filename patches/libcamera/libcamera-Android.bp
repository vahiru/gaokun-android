// libcamera 的 Soong 移植 —— gaokun3 相机 HAL 的底座。
//
// ⚠️★★ 为什么必须在 AOSP 里编，而不能用 NDK 预编译的产物：
//   NDK 的 libc++ 用内联命名空间 std::__ndk1，AOSP 平台用 std::__1。
//   凡签名里带标准库类型的符号两边 mangled name 就对不上，而 libcamera
//   的 C++ API 到处都是 std::span / std::shared_ptr。实测链接报
//   "undefined symbol: ...generateConfigurationENSt3__14span..."。
//   ⇒ 跨工具链混链 C++ 的前提是 ABI 相同，NDK 与平台恰恰不同。见 #96。
//
// 源文件清单是从【已跑通的 meson 构建】用 `meson introspect --targets`
// 抽出来的，不是手抄：libcamera-base 20 + libcamera 69 + ipa_qcom_ife 13
// （meson 选项 -Dpipelines=qcom-ife -Dipas=qcom-ife；硬件 ISP，软件 ISP 不再编译）。
//
// ⚠️ 生成文件（control_ids.cpp / property_ids.cpp / version.cpp /
//   ipa_pub_key.cpp / qcom-ife 的 IPA proxy）由 libcamera 自带的 Python 生成器
//   产出，见 generated/ 目录与 scripts/camera/gen-libcamera-sources.sh。

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "libcamera_gaokun3_defaults",
    vendor: true,
    cpp_std: "c++20",          // 上游 meson.build:9 就是 cpp_std=c++20
    rtti: true,
    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-missing-field-initializers",
        "-D_GNU_SOURCE",
        // ⚠️★ libcamera 的源码【从不】 #include "config.h" —— meson 是用
        //    强制包含塞进去的（上游 meson.build:113 的
        //    `'-include', meson.current_build_dir() / 'config.h'`）。
        //    Soong 这边照做；`-include` 走的是和 #include "..." 同一套
        //    搜索路径，所以 generated/include 在 local_include_dirs 里就够。
        //    漏了它的症状很迷惑：memfd.cpp 里给老 glibc 的兼容垫片会被编进来
        //    和 bionic 撞车（F_ADD_SEALS 重定义 / memfd_create 有歧义），
        //    同时 IPA_MODULE_DIR 等一堆宏"未声明"。
        // ⚠️ Soong 校验每个 cflag 必须以 "-" 开头，所以要写成一个 token
        //    （"-include", "config.h" 分成两项会被拒：
        //     'Flag `config.h` must start with `-`'）。
        "-includeconfig.h",
        // libcamera 的私有头靠这个宏自我保护（include/libcamera/base/private.h:21）。
        // 上游 meson 在 src/libcamera/base/meson.build:53 定义它。
        "-DLIBCAMERA_BASE_PRIVATE",
        // ★ 让 IPA 跑在【进程内】而不是独立进程。见 patches/libcamera/0003-*：
        //   没有 gnutls/libcrypto 时 isSignatureValid() 恒为 false ⇒ 强制隔离，
        //   那样既要多编一个 proxy worker 可执行体（否则报
        //   "Failed to get proxy worker path"、IPA 起不来），
        //   又要每帧多付一次 IPC。
        //   ⚠️ 安全权衡见该补丁的说明：换闭源 IPA 的项目不要开这个宏。
        "-DLIBCAMERA_IPA_TRUST_UNSIGNED",
    ],
    // ★ 这组 -I 是从【已跑通的 meson 构建】的 build.ninja 里抄出来的
    //   （grep 某个 .o 的编译行取 -I），不是一个个试出来的：
    //   libcamera 的 IPA 源码大量用【裸名】include（<module.h>、
    //   <core_ipa_interface.h>、<ipa_context.h>、<control_ids.h>…），
    //   少一个就是一串看不出关联的 "unknown type name"。
    local_include_dirs: [
        "include",
        "src",
        "src/ipa",
        "src/ipa/qcom-ife",
        "src/ipa/libipa",
        "generated/include",
        "generated/include/libcamera",
        "generated/include/libcamera/ipa",
    ],
}

cc_library_shared {
    name: "libcamera_base_gk3",
    defaults: ["libcamera_gaokun3_defaults"],
    srcs: [
        "src/libcamera/base/bound_method.cpp",
        "src/libcamera/base/class.cpp",
        "src/libcamera/base/flags.cpp",
        "src/libcamera/base/object.cpp",
        "src/libcamera/base/shared_fd.cpp",
        "src/libcamera/base/signal.cpp",
        "src/libcamera/base/unique_fd.cpp",
        "src/libcamera/base/backtrace.cpp",
        "src/libcamera/base/event_dispatcher.cpp",
        "src/libcamera/base/event_dispatcher_poll.cpp",
        "src/libcamera/base/event_notifier.cpp",
        "src/libcamera/base/file.cpp",
        "src/libcamera/base/log.cpp",
        "src/libcamera/base/memfd.cpp",
        "src/libcamera/base/message.cpp",
        "src/libcamera/base/mutex.cpp",
        "src/libcamera/base/semaphore.cpp",
        "src/libcamera/base/thread.cpp",
        "src/libcamera/base/timer.cpp",
        "src/libcamera/base/utils.cpp",
    ],
    shared_libs: ["liblog"],
}

cc_library_shared {
    name: "libcamera_gk3",
    defaults: ["libcamera_gaokun3_defaults"],
    srcs: [
        "src/libcamera/camera.cpp",
        "src/libcamera/camera_manager.cpp",
        "src/libcamera/color_space.cpp",
        "src/libcamera/controls.cpp",
        "src/libcamera/fence.cpp",
        "src/libcamera/framebuffer.cpp",
        "src/libcamera/framebuffer_allocator.cpp",
        "src/libcamera/geometry.cpp",
        "src/libcamera/orientation.cpp",
        "src/libcamera/pixel_format.cpp",
        "src/libcamera/request.cpp",
        "src/libcamera/stream.cpp",
        "src/libcamera/transform.cpp",
        "src/libcamera/bayer_format.cpp",
        "src/libcamera/byte_stream_buffer.cpp",
        "src/libcamera/camera_controls.cpp",
        "src/libcamera/camera_lens.cpp",
        "src/libcamera/clock_recovery.cpp",
        "src/libcamera/control_serializer.cpp",
        "src/libcamera/control_validator.cpp",
        "src/libcamera/converter.cpp",
        "src/libcamera/debug_controls.cpp",
        "src/libcamera/delayed_controls.cpp",
        "src/libcamera/device_enumerator.cpp",
        "src/libcamera/device_enumerator_sysfs.cpp",
        "src/libcamera/dma_buf_allocator.cpp",
        "src/libcamera/formats.cpp",
        "src/libcamera/global_configuration.cpp",
        "src/libcamera/ipa_controls.cpp",
        "src/libcamera/ipa_data_serializer.cpp",
        "src/libcamera/ipa_interface.cpp",
        "src/libcamera/ipa_manager.cpp",
        "src/libcamera/ipa_module.cpp",
        "src/libcamera/ipa_proxy.cpp",
        "src/libcamera/ipc_pipe.cpp",
        "src/libcamera/ipc_pipe_unixsocket.cpp",
        "src/libcamera/ipc_unixsocket.cpp",
        "src/libcamera/mapped_framebuffer.cpp",
        "src/libcamera/matrix.cpp",
        "src/libcamera/media_device.cpp",
        "src/libcamera/media_object.cpp",
        "src/libcamera/media_pipeline.cpp",
        "src/libcamera/pipeline_handler.cpp",
        "src/libcamera/process.cpp",
        "src/libcamera/pub_key.cpp",
        "src/libcamera/shared_mem_object.cpp",
        "src/libcamera/source_paths.cpp",
        "src/libcamera/sysfs.cpp",
        "src/libcamera/v4l2_device.cpp",
        "src/libcamera/v4l2_pixelformat.cpp",
        "src/libcamera/v4l2_request.cpp",
        "src/libcamera/v4l2_subdevice.cpp",
        "src/libcamera/v4l2_videodevice.cpp",
        "src/libcamera/value_node.cpp",
        "src/libcamera/vector.cpp",
        "src/libcamera/yaml_parser.cpp",
        "src/libcamera/converter/converter_dw100.cpp",
        "src/libcamera/converter/converter_dw100_vertexmap.cpp",
        "src/libcamera/converter/converter_v4l2_m2m.cpp",
        "src/libcamera/pipeline/qcom-ife/qcom_ife.cpp",
        "src/libcamera/sensor/camera_sensor.cpp",
        "src/libcamera/sensor/camera_sensor_legacy.cpp",
        "src/libcamera/sensor/camera_sensor_properties.cpp",
        "src/libcamera/sensor/camera_sensor_raw.cpp",
        // ── 生成的源（见头部说明）──
        "generated/src/control_ids.cpp",
        "generated/src/property_ids.cpp",
        "generated/src/version.cpp",
        "generated/src/ipa_pub_key.cpp",
        "generated/src/qcom-ife_ipa_proxy.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcamera_base_gk3",
    ],
    // ⚠️ libyaml 在 AOSP 里是 cc_library_static（external/libyaml/Android.bp:1），
    //    所以要放 static_libs —— 放 shared_libs 会报 "missing variant"。
    static_libs: ["libyaml"],
}

cc_library_static {
    name: "libcamera_ipa_gk3",
    defaults: ["libcamera_gaokun3_defaults"],
    // ★ 这里面就有我们自己加的 hi846 CameraSensorHelper
    //   （patches/libcamera/0002-*，见 #94）。
    srcs: [
        "src/ipa/libipa/agc.cpp",
        "src/ipa/libipa/agc_mean_luminance.cpp",
        "src/ipa/libipa/agc_msv.cpp",
        "src/ipa/libipa/algorithm.cpp",
        "src/ipa/libipa/awb.cpp",
        "src/ipa/libipa/awb_bayes.cpp",
        "src/ipa/libipa/awb_grey.cpp",
        "src/ipa/libipa/camera_sensor_helper.cpp",
        "src/ipa/libipa/ccm.cpp",
        "src/ipa/libipa/colours.cpp",
        "src/ipa/libipa/exposure_mode_helper.cpp",
        "src/ipa/libipa/fc_queue.cpp",
        "src/ipa/libipa/fixedpoint.cpp",
        "src/ipa/libipa/histogram.cpp",
        "src/ipa/libipa/interpolator.cpp",
        "src/ipa/libipa/lsc.cpp",
        "src/ipa/libipa/lsc_base.cpp",
        "src/ipa/libipa/lsc_polynomial.cpp",
        "src/ipa/libipa/lsc_table.cpp",
        "src/ipa/libipa/lux.cpp",
        "src/ipa/libipa/module.cpp",
        "src/ipa/libipa/pwl.cpp",
        "src/ipa/libipa/quantized.cpp",
        "src/ipa/libipa/v4l2_params.cpp",
        "src/ipa/libipa/v4l2_stats.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcamera_base_gk3",
        "libcamera_gk3",
    ],
}

cc_library_shared {
    name: "libcamera_ipa_qcom_ife_gk3",
    defaults: ["libcamera_gaokun3_defaults"],
    // ⚠️★ 必须装到 libcamera 编译进去的 IPA_MODULE_DIR（config.h：/vendor/lib64/libcamera/ipa），
    //   否则 IPAManager 报 "No IPA found in '/vendor/lib64/libcamera/ipa'"，qcom-ife 管线建不起来。
    //   调优文件由 device.mk 装到 IPA_CONFIG_DIR 下的 qcom-ife/（/vendor/etc/libcamera/ipa/qcom-ife/）。
    relative_install_path: "libcamera/ipa",
    static_libs: ["libcamera_ipa_gk3"],
    srcs: [
        "src/ipa/qcom-ife/ipa_context.cpp",
        "src/ipa/qcom-ife/qcom-ife.cpp",
        "src/ipa/qcom-ife/stats.cpp",
        "src/ipa/qcom-ife/algorithms/abf.cpp",
        "src/ipa/qcom-ife/algorithms/agc.cpp",
        "src/ipa/qcom-ife/algorithms/awb.cpp",
        "src/ipa/qcom-ife/algorithms/bf.cpp",
        "src/ipa/qcom-ife/algorithms/blc.cpp",
        "src/ipa/qcom-ife/algorithms/bpc.cpp",
        "src/ipa/qcom-ife/algorithms/ccm.cpp",
        "src/ipa/qcom-ife/algorithms/gamma.cpp",
        "src/ipa/qcom-ife/algorithms/lsc.cpp",
        "src/ipa/qcom-ife/algorithms/pdpc.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcamera_base_gk3",
        "libcamera_gk3",
    ],
}
