From 113942949bd70b84bdf588aba1f6758eaeabcd63 Mon Sep 17 00:00:00 2001
From: Akisaira <akisaira@outlook.com>
Date: Wed, 4 Nov 2026 02:05:49 +1100
Subject: [PATCH] ipa: libipa: agc: Filter over the frames between
 statistics

AgcMeanLuminance moves the exposure value 20% of the way to its target
on each calculation, a speed meant for statistics on every frame. The
software ISP computes them on one frame in four, so its exposure takes
four times as long to settle: about 2.5 seconds after the scene gets six
times brighter, at 30 fps, twice that at 15 fps.

Let the caller give the number of frames since the previous calculation
and apply the per-frame speed that many times. The soft ISP passes the
frames between its statistics; other IPAs keep the default of one.
AgcMSV, used without a camera sensor helper, ignores it.

On the Huawei MateBook E Go's rear camera (ov13b10, 2096x1560 at 30 fps),
switching the flash LED on and off in front of a lit scene (exposure
value x0.16 and x6.3), the exposure now settles within 5% in 0.77 s
instead of 2.50 s and in 0.23 s instead of 1.17 s, without overshoot.

Signed-off-by: Akisaira <akisaira@outlook.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

Origin: local
Upstream-Status: Pending
---
 src/ipa/libipa/agc.cpp                |  8 ++++++++
 src/ipa/libipa/agc.h                  |  1 +
 src/ipa/libipa/agc_mean_luminance.cpp | 18 +++++++++++++++---
 src/ipa/libipa/agc_mean_luminance.h   |  3 ++-
 src/ipa/softisp/algorithms/agc.cpp    | 14 +++++++++++++-
 src/ipa/softisp/algorithms/agc.h      |  4 ++++
 6 files changed, 43 insertions(+), 5 deletions(-)

diff --git a/src/ipa/libipa/agc.cpp b/src/ipa/libipa/agc.cpp
index 4dea9acc..adcc6cbb 100644
--- a/src/ipa/libipa/agc.cpp
+++ b/src/ipa/libipa/agc.cpp
@@ -311,6 +311,13 @@ namespace agc {
  *
  * \var AgcAlgorithm::ProcessParams::lux
  * \brief Effective lux value of the frame
+ *
+ * \var AgcAlgorithm::ProcessParams::frames
+ * \brief Number of frames since the previous frame with statistics, see
+ * AgcMeanLuminance::Params::frames
+ *
+ * Used with a camera sensor helper only: the AgcMSV algorithm that runs
+ * without one ignores it.
  */
 
 /**
@@ -861,6 +868,7 @@ void AgcAlgorithm::process(const agc::Session &session, agc::ActiveState &state,
 				.exposureModeIndex = frameContext.exposureMode,
 				.lux = params->lux,
 				.exposureCompensation = std::pow(2.0, frameContext.exposureValue),
+				.frames = params->frames,
 			});
 
 			/* Update the estimated exposure and gain. */
diff --git a/src/ipa/libipa/agc.h b/src/ipa/libipa/agc.h
index 7a3ccf4b..95852b08 100644
--- a/src/ipa/libipa/agc.h
+++ b/src/ipa/libipa/agc.h
@@ -138,6 +138,7 @@ public:
 		double gain;
 		std::vector<AgcMeanLuminance::AgcConstraint> &&additionalConstraints = {};
 		double lux = 0;
+		unsigned int frames = 1;
 	};
 
 	int init(const ValueNode &tuningData, CameraSensorHelper *sensor,
diff --git a/src/ipa/libipa/agc_mean_luminance.cpp b/src/ipa/libipa/agc_mean_luminance.cpp
index 72833247..34f21bcc 100644
--- a/src/ipa/libipa/agc_mean_luminance.cpp
+++ b/src/ipa/libipa/agc_mean_luminance.cpp
@@ -578,14 +578,17 @@ double AgcMeanLuminance::effectiveYTarget(double lux, double exposureCompensatio
 /**
  * \brief Apply a filter on the exposure value to limit the speed of changes
  * \param[in] exposureValue The target exposure from the AGC algorithm
+ * \param[in] frames The number of frames since the previous calculation
  *
  * The speed of the filter is adaptive, and will produce the target quicker
  * during startup, or when the target exposure is within 20% of the most recent
- * filter output.
+ * filter output. It is a speed per frame: a calculation covering \a frames
+ * frames applies it that many times over.
  *
  * \return The filtered exposure
  */
-utils::Duration AgcMeanLuminance::filterExposure(utils::Duration exposureValue)
+utils::Duration AgcMeanLuminance::filterExposure(utils::Duration exposureValue,
+						 unsigned int frames)
 {
 	double speed = 0.2;
 
@@ -602,6 +605,8 @@ utils::Duration AgcMeanLuminance::filterExposure(utils::Duration exposureValue)
 	    filteredExposure_ > 0.8 * exposureValue)
 		speed = sqrt(speed);
 
+	speed = 1.0 - std::pow(1.0 - speed, std::max(frames, 1u));
+
 	filteredExposure_ = speed * exposureValue +
 			    filteredExposure_ * (1.0 - speed);
 
@@ -634,6 +639,13 @@ utils::Duration AgcMeanLuminance::filterExposure(utils::Duration exposureValue)
  * \var AgcMeanLuminance::Params::exposureCompensation
  * \brief The exposure compensation value to be used in the AGC calculations
  * It is expressed as gain instead of EV.
+ *
+ * \var AgcMeanLuminance::Params::frames
+ * \brief The number of frames since the previous calculation
+ *
+ * The exposure value moves towards the target as far as calculations on each
+ * of these frames would have moved it, for pipelines that compute statistics
+ * on some frames only.
  */
 
 /**
@@ -695,7 +707,7 @@ AgcMeanLuminance::calculateNewEv(const Params &params)
 	 * We filter the exposure value to make sure changes are not too jarring
 	 * from frame to frame.
 	 */
-	newExposureValue = filterExposure(newExposureValue);
+	newExposureValue = filterExposure(newExposureValue, params.frames);
 
 	frameCount_++;
 	return { exposureModeHelper.splitExposure(newExposureValue), yTarget };
diff --git a/src/ipa/libipa/agc_mean_luminance.h b/src/ipa/libipa/agc_mean_luminance.h
index f799618f..0083df09 100644
--- a/src/ipa/libipa/agc_mean_luminance.h
+++ b/src/ipa/libipa/agc_mean_luminance.h
@@ -69,6 +69,7 @@ public:
 		uint32_t exposureModeIndex;
 		double lux = 0;
 		double exposureCompensation = 1;
+		unsigned int frames = 1;
 	};
 
 	struct Result : ExposureModeHelper::Result {
@@ -86,7 +87,7 @@ private:
 	int parseExposureModes(const ValueNode &tuningData);
 	double estimateInitialGain(const Traits &traits, double yTarget) const;
 	double constraintClampGain(const Params &params, double gain) const;
-	utils::Duration filterExposure(utils::Duration exposureValue);
+	utils::Duration filterExposure(utils::Duration exposureValue, unsigned int frames);
 
 	utils::Duration filteredExposure_;
 	mutable bool luxWarningEnabled_;
diff --git a/src/ipa/softisp/algorithms/agc.cpp b/src/ipa/softisp/algorithms/agc.cpp
index e904bf96..6ab65d99 100644
--- a/src/ipa/softisp/algorithms/agc.cpp
+++ b/src/ipa/softisp/algorithms/agc.cpp
@@ -62,6 +62,8 @@ int Agc::init(IPAContext &context, const ValueNode &tuningData)
 
 int Agc::configure(IPAContext &context, [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
+	lastStatsFrame_.reset();
+
 	return agc_.configure(context.configuration.agc, context.activeState.agc, {
 		.sensorInfo = context.sensorInfo,
 		.sensorControls = context.sensorControls,
@@ -94,12 +96,21 @@ void Agc::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
 }
 
 void Agc::process(IPAContext &context,
-		  [[maybe_unused]] const uint32_t frame,
+		  const uint32_t frame,
 		  IPAFrameContext &frameContext,
 		  const SwIspStats *stats,
 		  ControlList &metadata)
 {
 	if (stats->valid) {
+		/*
+		 * Statistics come every few frames only. Move the exposure as
+		 * far as a calculation on every frame would have, otherwise the
+		 * exposure takes several times as long to settle as it should.
+		 */
+		const unsigned int frames =
+			lastStatsFrame_ && frame > *lastStatsFrame_ ? frame - *lastStatsFrame_ : 1;
+		lastStatsFrame_ = frame;
+
 		/* \todo The histogram should come already adjusted. */
 		auto histogram = stats->yHistogram;
 
@@ -115,6 +126,7 @@ void Agc::process(IPAContext &context,
 			.yHist = yHist,
 			.exposure = frameContext.sensor.exposure,
 			.gain = frameContext.sensor.gain,
+			.frames = frames,
 		}}, metadata);
 	} else {
 		agc_.process(context.configuration.agc, context.activeState.agc, frameContext.agc, {}, metadata);
diff --git a/src/ipa/softisp/algorithms/agc.h b/src/ipa/softisp/algorithms/agc.h
index 10484cb4..fa168d8b 100644
--- a/src/ipa/softisp/algorithms/agc.h
+++ b/src/ipa/softisp/algorithms/agc.h
@@ -7,6 +7,9 @@
 
 #pragma once
 
+#include <optional>
+#include <stdint.h>
+
 #include <libipa/agc.h>
 
 #include "algorithm.h"
@@ -35,6 +38,7 @@ public:
 
 private:
 	AgcAlgorithm agc_;
+	std::optional<uint32_t> lastStatsFrame_;
 };
 
 } /* namespace ipa::softisp::algorithms */
