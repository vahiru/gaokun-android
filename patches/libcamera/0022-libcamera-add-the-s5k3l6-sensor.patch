+class CameraSensorHelperS5k3l6 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5k3l6()
+	{
+		/*
+		 * Huawei MateBook E Go rear camera (Lijing module). The Windows
+		 * driver's module configuration gives a data pedestal of 64 at
+		 * 10 bits, a 16x maximum analogue gain, the S5K3L6's code / 32
+		 * model (m0 1, c0 0, m1 0, c1 32), and an exposure of the frame
+		 * length minus 8 at most, which the kernel driver applies.
+		 */
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+		exposureMargin_ = 8;
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5k3l6", CameraSensorHelperS5k3l6)
+
