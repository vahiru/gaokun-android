 	if (config.setsFrameLength) {
 		state.minFrameDuration = frameHeights[2] * session.lineDuration;
 		state.maxFrameDuration = frameHeights[2] * session.lineDuration;
@@ -500,6 +526,8 @@ int AgcAlgorithm::configure(agc::Session &session, agc::ActiveState &state,
 	config.ctrlMap.erase(&controls::ExposureValue);
 	config.ctrlMap.erase(&controls::AeConstraintMode);
 	config.ctrlMap.erase(&controls::AeExposureMode);
+	config.ctrlMap.erase(&controls::AeFlickerMode);
+	config.ctrlMap.erase(&controls::AeFlickerPeriod);
 
 	/* \todo Move this to the `Camera` class. */
 	config.ctrlMap[&controls::AeEnable] = ControlInfo{
@@ -583,6 +611,15 @@ int AgcAlgorithm::configure(agc::Session &session, agc::ActiveState &state,
 			for (const auto &[id, _] : impl.exposureModeHelpers())
 				options.emplace_back(id);
 			config.ctrlMap[&controls::AeExposureMode] = ControlInfo(options);
+
+			config.ctrlMap[&controls::AeFlickerMode] = ControlInfo(
+				std::array{ ControlValue(controls::FlickerOff),
+					    ControlValue(controls::FlickerManual) },
+				ControlValue(controls::FlickerOff));
+			config.ctrlMap[&controls::AeFlickerPeriod] = ControlInfo(
+				static_cast<int32_t>(kMinFlickerPeriod.get<std::micro>()),
+				static_cast<int32_t>(kMaxFlickerPeriod.get<std::micro>()),
+				static_cast<int32_t>(kDefaultFlickerPeriod.get<std::micro>()));
 		},
 	}, impl_);
 
@@ -683,6 +720,17 @@ void AgcAlgorithm::queueRequest(const agc::Session &session, agc::ActiveState &s
 			static_cast<controls::AeConstraintModeEnum>(*constraintMode);
 	frameContext.constraintMode = state.constraintMode;
 
+	const auto &flickerMode = controls.get(controls::AeFlickerMode);
+	if (flickerMode)
+		state.flickerMode = static_cast<controls::AeFlickerModeEnum>(*flickerMode);
+	const auto &flickerPeriod = controls.get(controls::AeFlickerPeriod);
+	if (flickerPeriod)
+		state.flickerPeriod = std::clamp<utils::Duration>(
+			std::chrono::microseconds(*flickerPeriod),
+			kMinFlickerPeriod, kMaxFlickerPeriod);
+	frameContext.flickerMode = state.flickerMode;
+	frameContext.flickerPeriod = state.flickerPeriod;
+
 	const auto &exposureValue = controls.get(controls::ExposureValue);
 	if (exposureValue)
 		state.exposureValue = *exposureValue;
@@ -869,6 +917,9 @@ void AgcAlgorithm::process(const agc::Session &session, agc::ActiveState &state,
 				.lux = params->lux,
 				.exposureCompensation = std::pow(2.0, frameContext.exposureValue),
 				.frames = params->frames,
+				.flickerPeriod = frameContext.flickerMode == controls::FlickerManual
+						 ? frameContext.flickerPeriod
+						 : utils::Duration{},
 			});
 
 			/* Update the estimated exposure and gain. */
@@ -963,6 +1014,13 @@ void AgcAlgorithm::fillMetadata(const agc::Session &session,
 
 	metadata.set(controls::AeExposureMode, frameContext.exposureMode);
 	metadata.set(controls::AeConstraintMode, frameContext.constraintMode);
+	/* Only the mean luminance implementation avoids flicker */
+	if (std::holds_alternative<AgcMeanLuminance>(impl_)) {
+		metadata.set(controls::AeFlickerMode, frameContext.flickerMode);
+		if (frameContext.flickerMode == controls::FlickerManual)
