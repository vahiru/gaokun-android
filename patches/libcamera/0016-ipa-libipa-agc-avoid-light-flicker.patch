 LOG_DEFINE_CATEGORY(Agc)
 
+namespace {
+
+/*
+ * Flicker periods the AeFlickerPeriod control accepts. The default is the
+ * 100 Hz flicker of lights on 50 Hz mains.
+ */
+constexpr utils::Duration kMinFlickerPeriod = 100us;
+constexpr utils::Duration kMaxFlickerPeriod = 1s;
+constexpr utils::Duration kDefaultFlickerPeriod = 10ms;
+
+} /* namespace */
+
 namespace agc {
 
 /**
@@ -167,6 +179,12 @@ namespace agc {
  * \var ActiveState::exposureMode
