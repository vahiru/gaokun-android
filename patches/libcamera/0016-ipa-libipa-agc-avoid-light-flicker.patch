+ *
+ * \var AgcMeanLuminance::Params::flickerPeriod
+ * \brief The period of the light flicker the exposure time avoids, 0 for none
+ *
+ * \sa ExposureModeHelper::splitExposure()
  */
 
 /**
@@ -692,7 +697,7 @@ AgcMeanLuminance::calculateNewEv(const Params &params)
 		 * doesn't get stuck with 0 in case the sensor driver allows a
 		 * min exposure of 0.
 		 */
-		return { exposureModeHelper.splitExposure(10ms), yTarget };
+		return { exposureModeHelper.splitExposure(10ms, params.flickerPeriod), yTarget };
 	}
 
 	double gain = estimateInitialGain(params.traits, yTarget);
@@ -716,8 +721,17 @@ AgcMeanLuminance::calculateNewEv(const Params &params)
 	 */
 	const utils::Duration minExposureValue =
 		exposureModeHelper.minExposureTime() * exposureModeHelper.minGain();
+	/* Avoiding flicker, the exposure time takes whole periods at most. */
+	utils::Duration maxExposureTime = exposureModeHelper.maxExposureTime();
+	if (params.flickerPeriod && maxExposureTime >= params.flickerPeriod) {
+		const utils::Duration periods =
+			static_cast<long>(maxExposureTime / params.flickerPeriod) *
+			params.flickerPeriod;
+		if (periods >= exposureModeHelper.minExposureTime())
+			maxExposureTime = periods;
+	}
 	const utils::Duration maxExposureValue =
-		exposureModeHelper.maxExposureTime() * exposureModeHelper.maxGain();
+		maxExposureTime * exposureModeHelper.maxGain();
 	newExposureValue = std::clamp(newExposureValue, minExposureValue, maxExposureValue);
 	/* The limits change with the frame duration and manual controls too. */
 	if (frameCount_)
@@ -731,7 +745,8 @@ AgcMeanLuminance::calculateNewEv(const Params &params)
 	newExposureValue = filterExposure(newExposureValue, params.frames);
 
 	frameCount_++;
-	return { exposureModeHelper.splitExposure(newExposureValue), yTarget };
+	return { exposureModeHelper.splitExposure(newExposureValue, params.flickerPeriod),
