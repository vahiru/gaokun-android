diff --git a/src/ipa/libipa/exposure_mode_helper.cpp b/src/ipa/libipa/exposure_mode_helper.cpp
index b3e75f63..ee1d6fe1 100644
--- a/src/ipa/libipa/exposure_mode_helper.cpp
+++ b/src/ipa/libipa/exposure_mode_helper.cpp
@@ -141,6 +141,26 @@ utils::Duration ExposureModeHelper::clampExposureTime(utils::Duration exposureTi
 	return exp;
 }
 
+/*
+ * Shorten an exposure time to a whole number of flicker periods, so that every
+ * line integrates the same amount of light from a flickering source. An
+ * exposure time shorter than one period, or one the limits do not allow to
+ * shorten, is kept: the bands are then unavoidable.
+ */
+utils::Duration ExposureModeHelper::avoidFlicker(utils::Duration exposureTime,
+						 utils::Duration flickerPeriod,
+						 double *quantizationGain) const
+{
+	if (!flickerPeriod || exposureTime < flickerPeriod)
+		return exposureTime;
+
+	utils::Duration periods = static_cast<long>(exposureTime / flickerPeriod) * flickerPeriod;
+	if (periods < minExposureTime_)
+		return exposureTime;
+
+	return clampExposureTime(periods, quantizationGain);
+}
+
 double ExposureModeHelper::clampGain(double gain, double *quantizationGain) const
 {
 	double clamped = std::clamp(gain, minGain_, maxGain_);
@@ -173,6 +193,7 @@ double ExposureModeHelper::clampGain(double gain, double *quantizationGain) cons
 /**
  * \brief Split exposure into exposure time and gain
  * \param[in] exposure Exposure value
+ * \param[in] flickerPeriod Period of the light flicker to avoid, 0 for none
  *
  * This function divides a given exposure into exposure time, analogue and
  * digital gain by iterating through stages of exposure time and gain limits.
@@ -199,6 +220,10 @@ double ExposureModeHelper::clampGain(double gain, double *quantizationGain) cons
  * required exposure, the helper falls-back to simply maximising the exposure
  * time first, followed by analogue gain, followed by digital gain.
  *
+ * When \a flickerPeriod is set, an exposure time of at least one period is
+ * shortened to a whole number of periods and the gain makes up for it, so that
+ * a light source flickering with that period lights all lines alike.
+ *
  * During the calculations the gain missed due to quantization is recorded and
  * returned as quantization gain. The quantization gain is not included in the
  * digital gain. So to exactly apply the given exposure, both quantization gain
@@ -208,7 +233,8 @@ double ExposureModeHelper::clampGain(double gain, double *quantizationGain) cons
  * gain
  */
 ExposureModeHelper::Result
-ExposureModeHelper::splitExposure(utils::Duration exposure) const
+ExposureModeHelper::splitExposure(utils::Duration exposure,
+				  utils::Duration flickerPeriod) const
 {
 	ASSERT(maxExposureTime_);
 	ASSERT(maxGain_);
@@ -252,6 +278,7 @@ ExposureModeHelper::splitExposure(utils::Duration exposure) const
 		/* Clamp the gain to lastStageGain and regulate exposureTime. */
 		if (stageExposureTime * lastStageGain >= exposure) {
 			exposureTime = clampExposureTime(exposure / lastStageGain, &quantGain);
+			exposureTime = avoidFlicker(exposureTime, flickerPeriod, &quantGain);
 			gain = clampGain(exposure / exposureTime, &quantGain2);
 			quantGain *= quantGain2;
 
@@ -261,7 +288,7 @@ ExposureModeHelper::splitExposure(utils::Duration exposure) const
 
 		/* Clamp the exposureTime to stageExposureTime and regulate gain. */
 		if (stageExposureTime * stageGain >= exposure) {
-			exposureTime = stageExposureTime;
+			exposureTime = avoidFlicker(stageExposureTime, flickerPeriod, &quantGain);
 			gain = clampGain(exposure / exposureTime, &quantGain2);
 			quantGain *= quantGain2;
 
@@ -280,6 +307,7 @@ ExposureModeHelper::splitExposure(utils::Duration exposure) const
 	 * exposure time is maxed before gain is touched at all.
 	 */
 	exposureTime = clampExposureTime(exposure / stageGain, &quantGain);
+	exposureTime = avoidFlicker(exposureTime, flickerPeriod, &quantGain);
 	gain = clampGain(exposure / exposureTime, &quantGain2);
 	quantGain *= quantGain2;
 
