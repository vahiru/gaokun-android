From 0cab90272038b4e5f1e6b6db3008267dd75a7955 Mon Sep 17 00:00:00 2001
From: Akisaira <akisaira@outlook.com>
Date: Sat, 14 Nov 2026 23:23:35 +1100
Subject: [PATCH] ipa: qcom-ife: Let small highlights clip

The upper AGC constraint of both cameras kept the brightest 2% of the
metering window at 0.8 at most. A lamp covering that much of the window
(about 1% of the frame with the default centre window) made the AGC
lower the exposure until the lamp no longer saturated, and the rest of
the frame came out far too dark. The front camera has no focus window
to meter on, so a lamp anywhere in the centre of a video call did this.

Apply the upper constraint to the 90th to 95th percentiles instead: the
brightest 5% may clip, while a large highlight such as a screen is kept
out of saturation. Let it lower the exposure no further than to keep the
pixels below the 90th percentile at half the mean luminance target
(minRestRatio 0.5): a highlight brighter than that, such as a window in
daylight, clips.

Signed-off-by: Akisaira <akisaira@outlook.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

Origin: local
Upstream-Status: Pending
---
 src/ipa/qcom-ife/data/hi846.yaml   | 24 +++++++++++++++---------
 src/ipa/qcom-ife/data/ov13b10.yaml | 24 +++++++++++++++---------
 2 files changed, 30 insertions(+), 18 deletions(-)

diff --git a/src/ipa/qcom-ife/data/hi846.yaml b/src/ipa/qcom-ife/data/hi846.yaml
index 8532a285..24be21d7 100644
--- a/src/ipa/qcom-ife/data/hi846.yaml
+++ b/src/ipa/qcom-ife/data/hi846.yaml
@@ -12,13 +12,18 @@
 # units, 64 at 10 bits).
 #
 # Agc: the libipa mean luminance target, the libipa lower constraint (the
-# brightest 2% of the pixels at least 0.5) and an upper one (at most 0.8), which
-# keeps highlights such as white text on a screen out of saturation. Both are
-# metered on the focus window (by default the centre 70% of the frame, the
-# meteringWindow key); the regions outside it weigh 0.25 in the mean
-# (outsideWeight) and take no part in the constraints. The IPA
-# sets the frame length from FrameDurationLimits, and the exposure time may
-# stretch the frame up to the longest one allowed.
+# brightest 2% of the pixels at least 0.5) and an upper one, which keeps large
+# highlights such as a screen out of saturation: the 90th to 95th percentiles at
+# most 0.8. The brightest 5% may clip, so that a lamp in the background does
+# not darken the frame. The upper constraint lowers the exposure no further than
+# to keep the pixels below the 90th percentile at half the mean target
+# (minRestRatio): beyond that the highlights, such as a window in daylight,
+# clip and the rest of the frame keeps its brightness. Both are metered on the
+# focus window (by default the centre 70% of the frame, the meteringWindow key);
+# the regions outside it weigh 0.25 in the mean (outsideWeight) and take no part
+# in the constraints.
+# The IPA sets the frame length from FrameDurationLimits, and the exposure time
+# may stretch the frame up to the longest one allowed.
 %YAML 1.1
 ---
 version: 1
@@ -32,9 +37,10 @@ algorithms:
             qHi: 1.0
             yTarget: 0.5
           upper:
-            qLo: 0.98
-            qHi: 1.0
+            qLo: 0.90
+            qHi: 0.95
             yTarget: 0.8
+            minRestRatio: 0.5
   - Awb:
       algorithm: bayes
       colourGains:
diff --git a/src/ipa/qcom-ife/data/ov13b10.yaml b/src/ipa/qcom-ife/data/ov13b10.yaml
index b52dfc0a..5eb41c01 100644
--- a/src/ipa/qcom-ife/data/ov13b10.yaml
+++ b/src/ipa/qcom-ife/data/ov13b10.yaml
@@ -11,13 +11,18 @@
 # BlackLevel: the camera sensor helper gives the level.
