From 16e79fdce620f2102bb25bb4dc381fd7bcd6f905 Mon Sep 17 00:00:00 2001
From: Akisaira <akisaira@outlook.com>
Date: Thu, 19 Nov 2026 02:42:13 +1100
Subject: [PATCH] libcamera: Add the S5K4H7 sensor

Some Huawei MateBook E Go units carry an S5K4H7 front camera (Xinli
module) instead of the HI846. Add its camera sensor helper, its sensor
properties and a qcom-ife tuning file.

The helper takes the black level, the analogue gain model (gain = code /
32) and the exposure margin (4 lines) that the sensor reports in its CCS
registers. The unit cell size is 1.12 um, the size the Windows driver's
field of view and focal length imply. The control delays have not been
measured; they are taken to be those of the other two cameras.

Awb, Ccm, Abf and Lsc come from the tuning the Windows camera driver
ships for this module.

Tested on a MateBook E Go with the S5K4H7 module: preview and still
capture in Aperture and in another app.

Signed-off-by: Akisaira <akisaira@outlook.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

Origin: local
Upstream-Status: Pending
---
 src/ipa/libipa/camera_sensor_helper.cpp       |  19 ++
 src/ipa/qcom-ife/data/meson.build             |   1 +
 src/ipa/qcom-ife/data/s5k4h7.yaml             | 205 ++++++++++++++++++
 .../sensor/camera_sensor_properties.cpp       |  22 ++
 4 files changed, 247 insertions(+)
 create mode 100644 src/ipa/qcom-ife/data/s5k4h7.yaml

diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index 037d5301..f6a7af57 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -555,6 +555,25 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("hi846", CameraSensorHelperHi846)
 
+class CameraSensorHelperS5k4h7 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5k4h7()
+	{
+		/*
+		 * Huawei MateBook E Go front camera (Xinli module). The sensor's
+		 * CCS registers give a data pedestal of 64 at 10 bits, the
+		 * analogue gain model gain = code / 32 (m0 1, c0 0, m1 0,
+		 * c1 32) and an exposure of the frame length minus 4 at most,
+		 * which the kernel driver applies.
+		 */
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+		exposureMargin_ = 4;
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5k4h7", CameraSensorHelperS5k4h7)
+
 class CameraSensorHelperOv13b10 : public CameraSensorHelper
 {
 public:
