+/*
+ * Correct the phase detection pixels in \a line, the copy of the input line
+ * that \a src points into.
+ */
+void DebayerCpuThread::correctPhaseDetectPixels(uint8_t *line, const uint8_t *src)
+{
+	if (debayer_->pdColumns_.empty())
+		return;
+
+	const unsigned int stride = debayer_->inputConfig_.stride;
+	const unsigned int y = (src - frame_) / stride;
+	const int offset = static_cast<int>(src - frame_ - y * stride) -
+			   static_cast<int>(lineBufferPadding_);
+	debayer_->correctPhaseDetectPixels(line, offset, lineBufferLength_, frame_, y);
+}
