+/**
+ * \brief Locate the sensor's phase detection pixels in the captured frames
+ * \param[in] sensorInfo The sensor mode
+ * \param[in] transform The transform applied by the sensor
+ *
+ * The positions apply to images read out from the whole active area at full
+ * resolution, with a transform they are known for, see
+ * CameraSensorProperties::PhaseDetectPixels. Binning and skipping average the
+ * phase detection pixels with image pixels or leave them out, and the analogue
+ * crop cannot tell a binned mode from a cropped one: some drivers report the
+ * mode's size centred in the array for both.
+ *
+ * \return The positions of the phase detection pixels inside a block, relative
+ * to the top left corner of the frame, or none when the sensor has none, the
+ * frame is not the whole active area at full resolution, or the sensor applies
+ * a transform they are not known for
+ */
+std::vector<Point>
+SoftwareIsp::framePhaseDetectPixels(const IPACameraSensorInfo &sensorInfo,
+				    Transform transform) const
+{
+	if (!sensorProps_ || sensorProps_->phaseDetectPixels.positions.empty())
+		return {};
+
+	const CameraSensorProperties::PhaseDetectPixels &pd = sensorProps_->phaseDetectPixels;
+	const auto it = pd.positions.find(transform);
+	if (sensorInfo.outputSize != sensorInfo.activeAreaSize || it == pd.positions.end()) {
+		LOG(SoftwareIsp, Debug)
+			<< "Phase detection pixels not corrected: output "
+			<< sensorInfo.outputSize << " of " << sensorInfo.activeAreaSize
+			<< ", transform " << transformToString(transform);
+		return {};
+	}
+
+	return it->second;
+}
