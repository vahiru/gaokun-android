+
+void DebayerCpu::setupPhaseDetectCorrection(const StreamConfiguration &inputCfg)
+{
+	pdColumns_.clear();
+	inputSize_ = inputCfg.size;
+
+	if (pdPositions_.empty() || pdPeriod_.isNull())
+		return;
+
+	/* The sensors known to have them send CSI-2 packed 10-bit data. */
+	const BayerFormat bayer = BayerFormat::fromPixelFormat(inputCfg.pixelFormat);
+	if (bayer.bitDepth != 10 || bayer.packing != BayerFormat::Packing::CSI2) {
+		LOG(Debayer, Warning)
+			<< "Phase detection pixels not corrected in "
+			<< inputCfg.pixelFormat;
+		return;
+	}
+
+	pdColumns_.assign(pdPeriod_.height, {});
+	for (const Point &p : pdPositions_) {
+		if (p.x < 0 || p.y < 0 || static_cast<unsigned int>(p.x) >= pdPeriod_.width ||
+		    static_cast<unsigned int>(p.y) >= pdPeriod_.height)
+			continue;
+		pdColumns_[p.y].push_back(p.x);
+	}
+
+	LOG(Debayer, Info)
+		<< "Correcting " << pdPositions_.size()
+		<< " phase detection pixels per " << pdPeriod_ << " block";
+}
+
+/*
+ * Replace the phase detection pixels of input line \a y in \a line, its copy:
+ * \a line[i] holds byte \a offset + i of the line, for \a length bytes. The
+ * values come from the same colour pixels two away in \a frame, the input,
+ * along the direction where they differ less so that edges stay sharp.
+ */
+void DebayerCpu::correctPhaseDetectPixels(uint8_t *line, int offset, unsigned int length,
+					  const uint8_t *frame, unsigned int y) const
+{
+	const std::vector<unsigned int> &columns = pdColumns_[y % pdPeriod_.height];
+	if (columns.empty())
+		return;
+
+	const unsigned int stride = inputConfig_.stride;
+	const unsigned int width = inputSize_.width;
+	const uint8_t *row = frame + y * stride;
+	const uint8_t *above = frame + (y >= 2 ? y - 2 : y + 2) * stride;
+	const uint8_t *below = frame + (y + 2 < inputSize_.height ? y + 2 : y - 2) * stride;
+
+	/* CSI-2 packed: the 8 MSBs of 4 pixels, then a byte with their 2 LSBs. */
+	auto value = [](const uint8_t *r, unsigned int x) {
+		const uint8_t *p = r + x / 4 * 5;
+		return (p[x % 4] << 2) | ((p[4] >> (x % 4 * 2)) & 3);
+	};
+
+	for (unsigned int c : columns) {
+		for (unsigned int x = c; x < width; x += pdPeriod_.width) {
+			const int msb = static_cast<int>(x / 4 * 5 + x % 4) - offset;
+			if (msb < 0 || msb >= static_cast<int>(length))
+				continue;
+
+			const int l = value(row, x >= 2 ? x - 2 : x + 2);
+			const int r = value(row, x + 2 < width ? x + 2 : x - 2);
+			const int a = value(above, x);
+			const int b = value(below, x);
+			const int v = std::abs(l - r) <= std::abs(a - b)
+					    ? (l + r + 1) / 2 : (a + b + 1) / 2;
+
+			line[msb] = v >> 2;
+			const int lsb = static_cast<int>(x / 4 * 5 + 4) - offset;
+			if (lsb >= 0 && lsb < static_cast<int>(length)) {
+				const unsigned int shift = x % 4 * 2;
+				line[lsb] = (line[lsb] & ~(3 << shift)) | ((v & 3) << shift);
+			}
+		}
+	}
+}
