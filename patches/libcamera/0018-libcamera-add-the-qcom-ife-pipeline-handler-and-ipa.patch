+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE adaptive Bayer filter
+ */
+
+#pragma once
+
+#include <array>
+#include <stdint.h>
+#include <vector>
+
+#include "algorithm.h"
+#include "params.h"
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+class Abf : public Algorithm
+{
+public:
+	Abf() = default;
+	~Abf() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPACameraSensorInfo &configInfo) override;
+	void prepare(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     QcomIfeParams *params) override;
+
+private:
+	using Nodes = std::array<uint16_t, IFE17X_ABF_NOISE_NODES>;
+
+	struct Region {
+		double gainStart;
+		double gainEnd;
+		std::array<double, IFE17X_ABF_NOISE_NODES> stddev;
+	};
+
+	Nodes noiseNodes(double gain) const;
+
+	std::vector<Region> regions_;
+	double edgeSoftness_;
+
+	uint16_t blackLevel_;
+	int16_t radialX_;
+	int16_t radialY_;
+	uint8_t r2Shift_;
+
+	Nodes applied_;
+	bool appliedValid_ = false;
+};
+
+} /* namespace ipa::qcom_ife::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/qcom-ife/algorithms/agc.cpp b/src/ipa/qcom-ife/algorithms/agc.cpp
new file mode 100644
index 00000000..442d8b00
--- /dev/null
+++ b/src/ipa/qcom-ife/algorithms/agc.cpp
@@ -0,0 +1,461 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2024, Ideas On Board Oy
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE AGC/AEC mean-based control algorithm
+ */
+
+#include "agc.h"
+
+#include <algorithm>
+#include <array>
+#include <initializer_list>
+
+#include <libcamera/base/log.h>
+#include <libcamera/base/utils.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libipa/colours.h"
+
+/**
+ * \file agc.h
+ */
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+/**
+ * \class Agc
+ * \brief Qualcomm IFE AGC algorithm
+ *
+ * The algorithm estimates the luminance of a frame from the AWB Bayer grid
+ * and leaves the exposure computation to the libipa AgcMeanLuminance
+ * algorithm.
+ *
+ * The mean of each grid region is taken per channel and multiplied by the
+ * white balance gains the frame was processed with, as the grid is taken
+ * before them. The luminance of the frame is the weighted mean of the Rec. 601
+ * luminance of the regions.
+ *
+ * The exposure is metered on a window: the focus window the AfWindows control
+ * sets with AfMetering on windows, else the centre of the frame. The regions
+ * whose centre lies in it weigh 1 in the mean luminance and the others less,
+ * so that a bright or dark background moves the exposure less than the
+ * subject. The luminance histogram the constraint modes work on counts the
+ * pixels of the window only: highlights outside it, such as a lamp at the
+ * edge of the frame, do not bring the exposure down.
+ *
+ * The grid leaves the pixels above its thresholds out of the sums and counts.
+ * Those pixels are saturated or close to it, so the algorithm counts them back
+ * in at full scale: a region of a blown-out sky then reads as bright, instead
+ * of as the mean of its few darker pixels or not at all, which would drive
+ * the exposure up further. A region without any counted pixel is saturated
+ * all over, not empty.
+ *
+ * The constraints work on the Bayer histogram of the window (BHistStats14),
+ * which counts the pixels of one channel, green by default, scaled by its
+ * white balance gain as a measure of the luminance. The Y channel is the
+ * luminance before the white balance gains, taken as it is. Only without it does the
+ * histogram come from the grid: in each region the pixels at or below the
+ * thresholds count at the luminance of their own mean and the others at full
+ * scale. That histogram jumps when pixels of a region cross the thresholds,
+ * the brightest pixels moving from the region mean to full scale at once: on
+ * a small window, where a few regions make up the brightest part, the
+ * exposure the constraints ask for then swings from frame to frame.
+ */
+
+LOG_DEFINE_CATEGORY(QcomIfeAgc)
+
+/* Number of bins of the luminance histogram built from the grid regions */
+static constexpr unsigned int kNumHistogramBins = 256;
+
+namespace {
+
+class AgcTraits final : public AgcMeanLuminance::Traits
+{
+public:
+	AgcTraits(const std::vector<RGB<double>> &means, const std::vector<double> &weights)
+		: means_(means), weights_(weights)
+	{
+	}
+
+	double estimateLuminance(double gain) const override
+	{
+		double ySum = 0.0;
+		double wSum = 0.0;
+
+		/* The pipeline clips each channel at full scale. */
+		for (size_t i = 0; i < means_.size(); i++) {
+			ySum += weights_[i] * rec601LuminanceFromRGB((means_[i] * gain).min(1.0));
+			wSum += weights_[i];
+		}
+
+		return wSum > 0.0 ? ySum / wSum : 0.0;
+	}
+
+private:
+	const std::vector<RGB<double>> &means_;
+	const std::vector<double> &weights_;
+};
+
+/*
+ * Compute the mean of some channels of a region, in 14 bit units, counting the
+ * pixels the grid left out at full scale. A grid that counted no pixel at all
+ * comes from a frame above the thresholds everywhere.
+ */
+double regionMean(const ife17x_awb_bg_region &region, const GridStatistics &grid,
+		  std::initializer_list<GridStatistics::Channel> channels)
+{
+	double sum = 0.0;
+	unsigned int pixels = 0;
+
+	for (GridStatistics::Channel c : channels) {
+		const unsigned int n = grid.pixels(region, c);
+		const unsigned int count = std::min<unsigned int>(region.count[c], n);
+
+		sum += region.sum[c] + (n - count) * kPixelMax;
+		pixels += n;
+	}
+
+	return pixels ? sum / pixels : kPixelMax;
+}
+
+/*
+ * Compute the mean of some channels of a region over the pixels the grid
+ * counted, in 14 bit units, or the threshold when it counted none.
+ */
+double countedMean(const ife17x_awb_bg_region &region, const GridStatistics &grid,
+		   std::initializer_list<GridStatistics::Channel> channels)
+{
+	double sum = 0.0;
+	unsigned int pixels = 0;
+
+	for (GridStatistics::Channel c : channels) {
+		sum += region.sum[c];
+		pixels += std::min<unsigned int>(region.count[c], grid.pixels(region, c));
+	}
+
+	return pixels ? sum / pixels : kGridThreshold;
+}
+
+} /* namespace */
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::init
+ */
+int Agc::init(IPAContext &context, const ValueNode &tuningData)
+{
+	windowSize_ = std::clamp(tuningData["meteringWindow"].get<double>(windowSize_), 0.1, 1.0);
+	outsideWeight_ = std::clamp(tuningData["outsideWeight"].get<double>(outsideWeight_),
+				    0.0, 1.0);
+	bayerHistogram_ = tuningData["bayerHistogram"].get<bool>(bayerHistogram_);
+	const unsigned int channel =
+		tuningData["histogramChannel"].get<unsigned int>(histogramChannel_);
+	if (channel > IFE17X_BHIST_CHANNEL_B)
+		LOG(QcomIfeAgc, Warning)
+			<< "No histogram channel " << channel << ", counting Gr";
+	else
+		histogramChannel_ = channel;
+
+	return agc_.init(tuningData, context.camHelper.get(), {
+		.sensorInfo = context.sensorInfo,
+		.sensorControls = context.sensorControls,
+		.ctrlMap = context.ctrlMap,
+		.setsFrameLength = true,
+	});
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::configure
+ */
+int Agc::configure(IPAContext &context, const IPACameraSensorInfo &configInfo)
+{
+	input_ = configInfo.outputSize;
+	analogCrop_ = configInfo.analogCrop;
+	centres_ = gridCentres(input_, context.configuration.dualSplit);
+	defaultWindow_ = Size(input_.width * windowSize_, input_.height * windowSize_)
+				 .centeredTo(Rectangle(input_).center());
+	windowsMetering_ = false;
+	requested_ = {};
+
+	return agc_.configure(context.configuration.agc, context.activeState.agc, {
+		.sensorInfo = context.sensorInfo,
+		.sensorControls = context.sensorControls,
+		.ctrlMap = context.ctrlMap,
+		.setsFrameLength = true,
+	});
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::queueRequest
+ */
+void Agc::queueRequest(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		       IPAFrameContext &frameContext,
+		       const ControlList &controls)
+{
+	agc_.queueRequest(context.configuration.agc, context.activeState.agc,
+			  frameContext.agc, controls);
+
+	if (const auto &metering = controls.get(controls::AfMetering))
+		windowsMetering_ = *metering == controls::AfMeteringWindows;
+
+	if (const auto &windows = controls.get(controls::AfWindows)) {
+		requested_ = {};
+		for (const Rectangle &w : *windows) {
+			/* A window without width or without height is no window */
+			if (w.width && w.height) {
+				requested_ = w;
+				break;
+			}
+		}
+	}
+
+	frameContext.metering.window = defaultWindow_;
+	if (windowsMetering_ && !requested_.isNull() && !analogCrop_.isNull()) {
+		/* Pixel array coordinates to IFE input pixels */
+		Rectangle w = requested_.transformedBetween(analogCrop_, Rectangle(input_))
+				      .boundedTo(Rectangle(input_));
+		if (w.width && w.height)
+			frameContext.metering.window = w;
+	}
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::prepare
+ */
+void Agc::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext, QcomIfeParams *params)
+{
+	agc_.prepare(context.activeState.agc, frameContext.agc);
+
+	if (context.activeState.initialParams)
+		fillGridConfig(params);
+
+	/* The histogram follows the metering window of each frame */
+	if (bayerHistogram_) {
+		const Rectangle &w = frameContext.metering.window;
+		auto block = params->block<QcomIfeBlocks::Bhist>();
+
+		block.setEnabled(true);
+		block->channel = histogramChannel_;
+		block->left = w.x & ~1;
+		block->top = w.y & ~1;
+		block->width = std::max(w.width & ~1U, 2U);
+		block->height = std::max(w.height & ~1U, 2U);
+	}
+}
+
+/*
+ * Build the luminance histogram of the metering window from the Bayer
+ * histograms: with two IFEs, of the stripes the window covers. The channel's
+ * bins of the 14 bit range move by its white balance gain. Returns false when
+ * the histograms counted no pixel.
+ */
+bool Agc::parseHistogram(const ife17x_stats_buffer *stats, const RGB<double> &wbGains,
+			 const Rectangle &window, bool dualIfe, unsigned int dualSplit)
+{
+	std::array<uint32_t, IFE17X_BHIST_BINS> bins{};
+	double gain = 1.0;
+	uint64_t total = 0;
+
+	switch (histogramChannel_) {
+	case IFE17X_BHIST_CHANNEL_R:
+		gain = wbGains.r();
+		break;
+	case IFE17X_BHIST_CHANNEL_GR:
+	case IFE17X_BHIST_CHANNEL_GB:
+		gain = wbGains.g();
+		break;
+	case IFE17X_BHIST_CHANNEL_B:
+		gain = wbGains.b();
+		break;
+	default:
+		break;
+	}
+
+	/*
+	 * The stripes the window covers by 2 columns or more, with its edges
+	 * made even as in the block (prepare()): a stripe it misses counts a
+	 * window of its own that is not the metering window's.
+	 */
+	const int left = window.x & ~1;
+	const int right = std::min<int>(left + std::max(window.width & ~1U, 2U), input_.width);
+	const int split = dualIfe ? static_cast<int>(dualSplit) : static_cast<int>(input_.width);
+	const bool sides[2] = {
+		std::min(right, split) - left >= 2,
+		dualIfe && right - std::max(left, split) >= 2,
+	};
+
+	for (unsigned int s = 0; s < 2; s++) {
+		if (!sides[s])
+			continue;
+		for (unsigned int i = 0; i < IFE17X_BHIST_BINS; i++) {
+			const uint32_t count = stats->bhist[s][i] & 0x1ffffff;
+			const unsigned int j = std::min<unsigned int>(
+				static_cast<unsigned int>((i + 0.5) * gain),
+				IFE17X_BHIST_BINS - 1);
+
+			bins[j] += count;
+			total += count;
+		}
+	}
+
+	LOG(QcomIfeAgc, Debug)
+		<< "Bayer histogram of " << window << ": " << total << " pixels"
+		<< (sides[0] ? " left" : "") << (sides[1] ? " right" : "");
+
+	if (!total)
+		return false;
+
+	yHist_ = Histogram(bins);
+	return true;
+}
+
+void Agc::parseStatistics(const GridStatistics &grid, const RGB<double> &wbGains,
+			  const Rectangle &window)
+{
+	std::array<uint32_t, kNumHistogramBins> bins{};
+	const auto binOf = [](double y) {
+		return std::min(static_cast<unsigned int>(y * kNumHistogramBins),
+				kNumHistogramBins - 1);
+	};
+
+	means_.clear();
+	means_.reserve(grid.regions().size());
+	weights_.clear();
+	weights_.reserve(grid.regions().size());
+
+	/* A window between region centres meters the whole frame */
+	const auto inWindow = [&](size_t i) {
+		if (i >= centres_.size())
+			return false;
+		const Point &p = centres_[i];
+		return p.x >= window.x && p.x < window.x + static_cast<int>(window.width) &&
+		       p.y >= window.y && p.y < window.y + static_cast<int>(window.height);
+	};
+	bool anyInside = false;
+	for (size_t i = 0; i < grid.regions().size() && !anyInside; i++)
+		anyInside = inWindow(i);
+
+	for (size_t i = 0; i < grid.regions().size(); i++) {
+		const ife17x_awb_bg_region &region = grid.regions()[i];
+		const bool inside = !anyInside || inWindow(i);
+
+		RGB<double> mean{ {
+			regionMean(region, grid, { GridStatistics::Red }),
+			regionMean(region, grid, { GridStatistics::GreenRed,
+						   GridStatistics::GreenBlue }),
+			regionMean(region, grid, { GridStatistics::Blue }),
+		} };
+
+		mean = mean * wbGains / kPixelMax;
+		means_.push_back(mean);
+		/*
+		 * By the region's pixels: with two IFEs, the stripes' regions
+		 * differ in width when the split is off the middle. An empty
+		 * grid counts no pixel anywhere: weigh the regions alike.
+		 */
+		weights_.push_back((inside ? 1.0 : outsideWeight_) *
+				   (grid.empty() ? 1.0
+						 : grid.pixels(region, GridStatistics::GreenRed)));
+
+		if (!inside)
+			continue;
+
+		/* Pixels as the green channels count them */
+		const unsigned int pixels = grid.pixels(region, GridStatistics::GreenRed) +
+					    grid.pixels(region, GridStatistics::GreenBlue);
+		const unsigned int counted =
+			std::min<unsigned int>(region.count[GridStatistics::GreenRed],
+					       grid.pixels(region, GridStatistics::GreenRed)) +
+			std::min<unsigned int>(region.count[GridStatistics::GreenBlue],
+					       grid.pixels(region, GridStatistics::GreenBlue));
+
+		if (counted) {
+			RGB<double> below{ {
+				countedMean(region, grid, { GridStatistics::Red }),
+				countedMean(region, grid, { GridStatistics::GreenRed,
+							    GridStatistics::GreenBlue }),
+				countedMean(region, grid, { GridStatistics::Blue }),
+			} };
+
+			below = below * wbGains / kPixelMax;
+			bins[binOf(rec601LuminanceFromRGB(below.min(1.0)))] += counted;
+		}
+		/* An empty grid: the region is saturated */
+		bins[kNumHistogramBins - 1] += grid.empty() ? 1 : pixels - counted;
+	}
+
+	yHist_ = Histogram(bins);
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::process
+ */
+void Agc::process(IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext,
+		  const ife17x_stats_buffer *stats,
+		  ControlList &metadata)
+{
+	const agc::Session &session = context.configuration.agc;
+	agc::ActiveState &state = context.activeState.agc;
+
+	if (!stats) {
+		LOG(QcomIfeAgc, Error) << "No statistics buffer passed to Agc";
+		agc_.process(session, state, frameContext.agc, {}, metadata);
+		return;
+	}
+
+	/*
+	 * Take an empty grid for a frame above the thresholds everywhere: the
+	 * grid write master has nothing to write, and the driver nothing to
+	 * complete, before the grid runs. All regions then read as saturated,
+	 * which brings the exposure down.
+	 */
+	GridStatistics grid(stats, context.configuration.dualIfe);
+
+	/* The frame context holds no gains if the tuning file has no Awb. */
+	RGB<double> wbGains = frameContext.awb.gains;
+	if (wbGains.r() <= 0.0 || wbGains.g() <= 0.0 || wbGains.b() <= 0.0)
+		wbGains = RGB<double>{ 1.0 };
+
+	parseStatistics(grid, wbGains, frameContext.metering.window);
+	if (bayerHistogram_)
+		parseHistogram(stats, wbGains, frameContext.metering.window,
+			       context.configuration.dualIfe, context.configuration.dualSplit);
+
+	agc_.process(session, state, frameContext.agc, { {
+		.traits = AgcTraits(means_, weights_),
+		.yHist = yHist_,
+		.exposure = frameContext.sensor.exposure,
+		.gain = frameContext.sensor.gain,
+	} }, metadata);
+
+	/*
+	 * The sensor takes the values just computed (IPAQcomIfe::setControls()),
+	 * not those prepare() gave the frame: requests are queued frames ahead
+	 * of their statistics, and their values would reach the sensor that
+	 * much later. The frame length follows the exposure time.
+	 */
+	agc::FrameContext &agc = frameContext.agc;
+	if (agc.autoExposureEnabled)
+		agc.exposure = state.automatic.exposure;
+	if (agc.autoGainEnabled)
+		agc.gain = state.automatic.gain;
+	const uint32_t frameLength =
+		std::max(static_cast<uint32_t>(std::ceil(agc.minFrameDuration /
+							 session.lineDuration - 1e-3)),
+			 agc.exposure + session.exposureMargin);
+	agc.vblank = frameLength - session.sensor.outputSize.height;
+	agc.frameDuration = frameLength * session.lineDuration;
+}
+
+REGISTER_IPA_ALGORITHM(Agc, "Agc")
+
+} /* namespace ipa::qcom_ife::algorithms */
+
+} /* namespace libcamera */
