+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE gamma curves
+ */
+
+#pragma once
+
+#include "algorithm.h"
+#include "params.h"
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+class Gamma : public Algorithm
+{
+public:
+	Gamma() = default;
+	~Gamma() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPACameraSensorInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void prepare(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     QcomIfeParams *params) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const ife17x_stats_buffer *stats,
+		     ControlList &metadata) override;
+
+private:
+	double defaultGamma_ = 0.0;
+	/* Gamma value of the curves last written to a parameters buffer */
+	double appliedGamma_ = 0.0;
+};
+
+} /* namespace ipa::qcom_ife::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/qcom-ife/algorithms/lsc.cpp b/src/ipa/qcom-ife/algorithms/lsc.cpp
new file mode 100644
index 00000000..76fc1b7f
--- /dev/null
+++ b/src/ipa/qcom-ife/algorithms/lsc.cpp
@@ -0,0 +1,412 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE lens shading correction
+ */
+
+#include "lsc.h"
+
+#include <algorithm>
+#include <cmath>
+#include <tuple>
+#include <utility>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/value_node.h"
+
+/**
+ * \file lsc.h
+ */
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+/**
+ * \class Lsc
+ * \brief Qualcomm IFE lens shading correction
+ *
+ * LSC34 multiplies each pixel by a gain interpolated from a grid of up to
+ * 16 x 12 blocks over the frame, one gain per Bayer channel and node.
+ *
+ * The tuning data gives the gains on a 17 x 13 grid over the sensor's full
+ * resolution (\a size), in \a regions of analogue gain (\a gain) holding
+ * \a sets by colour temperature (\a ct, a range, and the tables \a r, \a gr,
+ * \a gb and \a b, row by row from the top left). As in the Windows driver,
+ * a value inside a range (or below the first) takes that entry, a value
+ * between two ranges blends them linearly, and a value above the last range
+ * takes the last one.
+ *
+ * The hardware grid follows the Windows driver: it covers the frame with the
+ * most blocks whose size meets the hardware's limits, centred on the frame.
+ * Its nodes take the gains of the calibration grid at their place on the
+ * sensor, for the mode's crop and binning: bilinear interpolation on the
+ * border, Catmull-Rom inside, over the calibration grid extended by one node
+ * of linear extrapolation on each side.
+ */
+
+LOG_DEFINE_CATEGORY(QcomIfeLsc)
+
+namespace {
+
+/* The calibration grid with one node of extrapolation around it */
+constexpr unsigned int kExtCols = 19;
+constexpr unsigned int kExtRows = 15;
+
+/* Recompute below these changes of colour temperature and gain */
+constexpr double kCtStep = 50.0;
+constexpr double kGainStep = 0.02;
+
+/*
+ * The entries of a list of ranges for a value: one with a zero ratio, or two
+ * and the ratio of the second.
+ */
+template<typename T, typename Range>
+std::tuple<const T *, const T *, double>
+select(const std::vector<T> &entries, Range range, double v)
+{
+	for (unsigned int i = 0; i < entries.size(); i++) {
+		const auto [start, end] = range(entries[i]);
+
+		if (v <= end || i + 1 == entries.size())
+			return { &entries[i], nullptr, 0.0 };
+
+		const double next = range(entries[i + 1]).first;
+		if (v < next)
+			return { &entries[i], &entries[i + 1], (v - end) / (next - end) };
+	}
+
+	return { nullptr, nullptr, 0.0 };
+}
+
+template<typename Table>
+void blend(Table &out, const Table &other, double ratio)
+{
+	for (unsigned int c = 0; c < out.size(); c++)
+		for (unsigned int i = 0; i < out[c].size(); i++)
+			out[c][i] += ratio * (other[c][i] - out[c][i]);
+}
+
+} /* namespace */
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::init
+ */
+int Lsc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	auto size = tuningData["size"].get<std::vector<unsigned int>>();
+	if (!size || size->size() != 2 || (*size)[0] < 2 * kCols || (*size)[1] < 2 * kRows) {
+		LOG(QcomIfeLsc, Error) << "Invalid calibration size";
+		return -EINVAL;
+	}
+	fullSize_ = Size((*size)[0], (*size)[1]);
+
+	static const char *const channels[4] = { "r", "gr", "gb", "b" };
+
+	for (const ValueNode &r : tuningData["regions"].asList()) {
+		auto gain = r["gain"].get<std::vector<double>>();
+		Region region;
+
+		if (!gain || gain->size() != 2 || (*gain)[0] > (*gain)[1] ||
+		    (!regions_.empty() && (*gain)[0] <= regions_.back().gainEnd)) {
+			LOG(QcomIfeLsc, Error)
+				<< "Each region needs a gain range above the one before";
+			return -EINVAL;
+		}
+		region.gainStart = (*gain)[0];
+		region.gainEnd = (*gain)[1];
+
+		for (const ValueNode &s : r["sets"].asList()) {
+			auto ct = s["ct"].get<std::vector<double>>();
+			Set set;
+
+			if (!ct || ct->size() != 2 || (*ct)[0] > (*ct)[1] ||
+			    (!region.sets.empty() && (*ct)[0] <= region.sets.back().ctEnd)) {
+				LOG(QcomIfeLsc, Error)
+					<< "Each set needs a colour temperature range above the one before";
+				return -EINVAL;
+			}
+			set.ctStart = (*ct)[0];
+			set.ctEnd = (*ct)[1];
+
+			for (unsigned int c = 0; c < 4; c++) {
+				auto table = s[channels[c]].get<std::vector<double>>();
+				if (!table || table->size() != kNodes) {
+					LOG(QcomIfeLsc, Error)
+						<< "Each set needs " << kNodes << " "
+						<< channels[c] << " gains";
+					return -EINVAL;
+				}
+				std::copy(table->begin(), table->end(), set.table[c].begin());
+			}
+
+			region.sets.push_back(std::move(set));
+		}
+
+		if (region.sets.empty()) {
+			LOG(QcomIfeLsc, Error) << "A region without sets";
+			return -EINVAL;
+		}
+
+		regions_.push_back(std::move(region));
+	}
+
+	if (regions_.empty()) {
+		LOG(QcomIfeLsc, Error) << "No regions";
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::configure
+ */
+int Lsc::configure([[maybe_unused]] IPAContext &context,
+		   const IPACameraSensorInfo &configInfo)
+{
+	/* The grid of the Windows driver, in Bayer quads of the frame */
+	const unsigned int w2 = configInfo.outputSize.width / 2;
+	const unsigned int h2 = configInfo.outputSize.height / 2;
+	unsigned int nh = 16, nv = 12, f = 4;
+	unsigned int bw = 0, bh = 0, padX = 0, padY = 0;
+
+	active_ = false;
+	appliedValid_ = false;
+
+	while (true) {
+		if (f == 0) {
+			if (nh <= 8 || nv <= 6)
+				break;
+			nh -= 4;
+			nv -= 3;
+			f = 3;
+		} else {
+			f--;
+		}
+
+		const unsigned int subW = ((w2 + nh - 1) / nh + (1 << f) - 1) >> f;
+		const unsigned int subH = ((h2 + nv - 1) / nv + (1 << f) - 1) >> f;
+		bw = subW << f;
+		bh = subH << f;
+		const unsigned int exW = bw * nh - w2;
+		const unsigned int exH = bh * nv - h2;
+
+		if (bw < 18 || bh < 9 || subW < 9 || subH < 9 || exW >= bw || exH >= bh)
+			continue;
+		padX = (exW + 1) / 2;
+		padY = (exH + 1) / 2;
+		if (bw - padX < 18 || subW - padX % subW < 9)
+			continue;
+
+		active_ = true;
+		break;
+	}
+
+	if (!active_ || bw > 2048 || bh > 1024) {
+		active_ = false;
+		LOG(QcomIfeLsc, Warning)
+			<< "No shading grid fits " << configInfo.outputSize;
+		return 0;
+	}
+
+	hBlocks_ = nh;
+	vBlocks_ = nv;
+	subgridShift_ = f;
+	blockWidth_ = bw;
+	blockHeight_ = bh;
+	startX_ = padX;
+	startY_ = padY;
+
+	/*
+	 * Each node's place on the sensor, in quads of the full resolution:
+	 * from the crop, with the binning of the mode. The calibration nodes
+	 * sit at multiples of sx, sy from the corner, the extended grid starts
+	 * one node before.
+	 */
+	const Rectangle &crop = configInfo.analogCrop;
+	const double scaleX = static_cast<double>(crop.width) / configInfo.outputSize.width;
+	const double scaleY = static_cast<double>(crop.height) / configInfo.outputSize.height;
+	const double sx = (fullSize_.width / 2 - 1) / static_cast<double>(kCols - 1);
+	const double sy = (fullSize_.height / 2 - 1) / static_cast<double>(kRows - 1);
+	const double x0 = crop.x / 2 - padX * scaleX;
+	const double y0 = crop.y / 2 - padY * scaleY;
+
+	taps_.clear();
+	for (unsigned int r = 0; r <= nv; r++) {
+		const double gy = (y0 + r * bh * scaleY + sy) / sy;
+
+		for (unsigned int c = 0; c <= nh; c++) {
+			const double gx = (x0 + c * bw * scaleX + sx) / sx;
+			const bool border = r == 0 || c == 0 || r == nv || c == nh;
+			/* Catmull-Rom needs one more node on either side */
+			const int lo = border ? 0 : 1;
+			const int hi = border ? kExtCols - 2 : kExtCols - 3;
+			const int hiY = border ? kExtRows - 2 : kExtRows - 3;
+			const int ix = std::clamp(static_cast<int>(std::floor(gx)), lo, hi);
+			const int iy = std::clamp(static_cast<int>(std::floor(gy)), lo, hiY);
+
+			taps_.push_back({
+				static_cast<unsigned int>(iy * kExtCols + ix),
+				std::clamp(gx - ix, 0.0, 1.0),
+				std::clamp(gy - iy, 0.0, 1.0),
+				border,
+			});
+		}
+	}
+
+	LOG(QcomIfeLsc, Debug)
+		<< "Grid " << nh << "x" << nv << " blocks of " << bw << "x" << bh
+		<< " quads, subgrid shift " << f << ", start " << padX << "," << padY;
+
+	return 0;
+}
+
+Lsc::Table Lsc::tableFor(const Region &region, double ct) const
+{
+	auto [lo, hi, ratio] = select(region.sets,
+				      [](const Set &s) { return std::pair{ s.ctStart, s.ctEnd }; },
+				      ct);
+	Table table = lo->table;
+	if (hi)
+		blend(table, hi->table, ratio);
+
+	return table;
+}
+
+Lsc::Table Lsc::interpolate(double gain, double ct) const
+{
+	auto [lo, hi, ratio] = select(regions_,
+				      [](const Region &r) { return std::pair{ r.gainStart, r.gainEnd }; },
+				      gain);
+	Table table = tableFor(*lo, ct);
+	if (hi)
+		blend(table, tableFor(*hi, ct), ratio);
+
+	return table;
+}
+
+Lsc::Gains Lsc::resample(const Table &table) const
+{
+	Gains gains{};
+
+	for (unsigned int c = 0; c < 4; c++) {
+		const auto &t = table[c];
+		std::array<double, kExtCols * kExtRows> e;
+		auto at = [&](unsigned int r, unsigned int col) -> double & {
+			return e[r * kExtCols + col];
+		};
+
+		/* The grid, and one node of linear extrapolation around it */
+		for (unsigned int r = 0; r < kRows; r++)
+			for (unsigned int col = 0; col < kCols; col++)
+				at(r + 1, col + 1) = t[r * kCols + col];
+		at(0, 0) = 2 * at(1, 1) - at(2, 2);
+		at(0, kExtCols - 1) = 2 * at(1, kCols) - at(2, kCols - 1);
+		at(kExtRows - 1, 0) = 2 * at(kRows, 1) - at(kRows - 1, 2);
+		at(kExtRows - 1, kExtCols - 1) = 2 * at(kRows, kCols) - at(kRows - 1, kCols - 1);
+		for (unsigned int r = 1; r <= kRows; r++) {
+			at(r, 0) = 2 * at(r, 1) - at(r, 2);
+			at(r, kExtCols - 1) = 2 * at(r, kCols) - at(r, kCols - 1);
+		}
+		for (unsigned int col = 1; col <= kCols; col++) {
+			at(0, col) = 2 * at(1, col) - at(2, col);
+			at(kExtRows - 1, col) = 2 * at(kRows, col) - at(kRows - 1, col);
+		}
+
+		for (unsigned int n = 0; n < taps_.size(); n++) {
+			const Tap &tap = taps_[n];
+			const unsigned int b = tap.index;
+			double v;
+
+			if (tap.border) {
+				const double top = e[b] + tap.tx * (e[b + 1] - e[b]);
+				const double bottom = e[b + kExtCols] +
+						      tap.tx * (e[b + kExtCols + 1] - e[b + kExtCols]);
+				v = top + tap.ty * (bottom - top);
+			} else {
+				/* Catmull-Rom weights */
+				auto weights = [](double s) {
+					const double s2 = s * s, s3 = s2 * s;
+					return std::array<double, 4>{
+						(2 * s2 - s3 - s) / 2,
+						(3 * s3 - 5 * s2 + 2) / 2,
+						(4 * s2 - 3 * s3 + s) / 2,
+						(s3 - s2) / 2,
+					};
+				};
+				const auto wx = weights(tap.tx);
+				const auto wy = weights(tap.ty);
+
+				v = 0.0;
+				for (int j = 0; j < 4; j++) {
+					const unsigned int row = b + (j - 1) * kExtCols;
+					double sum = 0.0;
+					for (int i = 0; i < 4; i++)
+						sum += wx[i] * e[row + i - 1];
+					v += wy[j] * sum;
+				}
+			}
+
+			/* Q10 from 1.0 to 7.999, like the Windows driver */
+			v = std::clamp(v, 1.0, 7.999);
+			gains[c][n] = std::clamp<long>(std::lround(v * 1024), 1024, 8191);
+		}
+	}
+
+	return gains;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::prepare
+ */
+void Lsc::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext, QcomIfeParams *params)
+{
+	if (!active_)
+		return;
+
+	const double gain = frameContext.agc.gain;
+	const double ct = frameContext.awb.colourTemperature;
+
+	if (!context.activeState.initialParams && appliedValid_ &&
+	    std::abs(ct - appliedCt_) < kCtStep &&
+	    std::abs(gain - appliedGain_) < kGainStep * appliedGain_)
+		return;
+
+	const Gains gains = resample(interpolate(gain, ct));
+	appliedGain_ = gain;
+	appliedCt_ = ct;
+
+	if (!context.activeState.initialParams && appliedValid_ && gains == applied_)
+		return;
+
+	auto block = params->block<QcomIfeBlocks::Lsc>();
+	block.setEnabled(true);
+
+	for (unsigned int c = 0; c < 4; c++)
+		std::copy(gains[c].begin(), gains[c].end(), block->gain[c]);
+	block->h_blocks = hBlocks_;
+	block->v_blocks = vBlocks_;
+	block->subgrid_shift = subgridShift_;
+	block->block_width = blockWidth_;
+	block->block_height = blockHeight_;
+	block->start_x = startX_;
+	block->start_y = startY_;
+
+	applied_ = gains;
+	appliedValid_ = true;
+
+	LOG(QcomIfeLsc, Debug)
+		<< "Gain " << gain << ", " << ct << " K: centre R "
+		<< gains[0][(vBlocks_ / 2) * (hBlocks_ + 1) + hBlocks_ / 2]
+		<< ", corner R " << gains[0][0];
+}
+
+REGISTER_IPA_ALGORITHM(Lsc, "Lsc")
