+# SPDX-License-Identifier: CC0-1.0
+#
+# Qualcomm IFE tuning for the rear camera (ov13b10) of the Huawei MateBook E Go.
+#
+# Awb and Ccm are the data of the earlier software ISP tuning of this camera,
+# unchanged, made by scripts/camera/gen-ov13b10-ccm.py in gaokun-android, which
+# says where they come from. Both ISPs take the colour statistics after the
+# black level subtraction and before the white balance gains, and apply the
+# matrix to linear data after the gains.
+#
+# BlackLevel: the camera sensor helper gives the level.
+#
+# Agc: the libipa mean luminance target, the libipa lower constraint (the
+# brightest 2% of the pixels at least 0.5) and an upper one (at most 0.8), which
+# keeps highlights such as white text on a screen out of saturation. Both are
+# metered on the focus window (by default the centre 70% of the frame, the
+# meteringWindow key); the regions outside it weigh 0.25 in the mean
+# (outsideWeight) and take no part in the constraints. The IPA
+# sets the frame length from FrameDurationLimits, and the exposure time may
+# stretch the frame up to the longest one allowed.
+#
+# Pdpc: the thresholds of the ov13b10 tuning of the Windows camera driver
+# (mod_pdpc11_aec_data: fmax 80, fmin 32, offsets 128). The phase detection
+# pixels themselves come from the sensor properties, in full size modes only.
+#
+# Bf: the focus statistics filters of the Windows tuning (the algorithm's
+# defaults), a 5x5 grid over the centre 70% of the frame, as the HAL's default
+# focus region.
+%YAML 1.1
+---
+version: 1
+algorithms:
+  - BlackLevel:
+  - Agc:
+      AeConstraintMode:
+        ConstraintNormal:
+          lower:
+            qLo: 0.98
+            qHi: 1.0
+            yTarget: 0.5
+          upper:
+            qLo: 0.98
+            qHi: 1.0
+            yTarget: 0.8
+  - Awb:
+      algorithm: bayes
+      colourGains:
+        - ct: 2300
+          gains: [ 0.9409, 2.4767 ]
+        - ct: 2856
+          gains: [ 1.1876, 2.0625 ]
+        - ct: 4000
+          gains: [ 1.6824, 1.8002 ]
+        - ct: 5000
+          gains: [ 1.9442, 1.3920 ]
+        - ct: 6500
+          gains: [ 2.3550, 1.2480 ]
+        - ct: 7500
+          gains: [ 2.4383, 1.2411 ]
+      priors:
+        - lux: 0
+          ct: [ 2000, 8000 ]
+          probability: [ 1.0, 1.0 ]
+      transversePos: 0.02
+      transverseNeg: 0.02
+      AwbMode:
+        AwbAuto:
+          lo: 2300
+          hi: 7500
+  - Ccm:
+      ccms:
+        - ct: 3000  # region 1-3000 K
+          ccm: [  1.55232, -0.70997,  0.15764,
+                 -0.23134,  1.38138, -0.15004,
+                 -0.18036, -0.72152,  1.90188 ]
+          offsets: [ 0, 0, 0 ]
+        - ct: 4000  # region 4000-5500 K
