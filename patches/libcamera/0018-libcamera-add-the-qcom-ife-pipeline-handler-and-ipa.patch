+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+/*
+ * \todo Document the interface and remove the related EXCLUDE_PATTERNS entry.
+ */
+
+module ipa.qcom_ife;
+
+import "include/libcamera/ipa/core.mojom";
+
+struct IPAConfigInfo {
+	libcamera.IPACameraSensorInfo sensorInfo;
+	libcamera.ControlInfoMap sensorControls;
+	/* Phase detection pixels of the configured mode: none, or a period and
+	 * the positions inside it from the top left corner of the frame */
+	libcamera.Size pdPeriod;
+	array<libcamera.Point> pdPixels;
+	/* Two IFEs process the frame in stripes */
+	bool dualIfe;
+	/* With two IFEs: the first column of the right stripe's output, and the
+	 * columns each stripe's input reaches beyond it; 0 with one IFE */
+	uint32 dualSplit;
+	uint32 dualPad;
+};
+
+/*
+ * The sensor controls of the first frames, written before streaming starts:
+ * the AGC's initial exposure time, gain and frame length
+ */
+struct StartResult {
+	int32 ret;
+	libcamera.ControlList sensorControls;
+};
+
+interface IPAQcomIfeInterface {
+	init(libcamera.IPASettings settings, IPAConfigInfo configInfo)
+		=> (int32 ret, libcamera.ControlInfoMap ipaControls);
+	start(libcamera.ControlList controls) => (StartResult result);
+	stop();
+
+	/*
+	 * The streams restarted without stop(): the hardware lost its
+	 * parameters, the next ones carry the full configuration. Async, so
+	 * that it runs after the fillParams() calls queued before it.
+	 */
+	[async] resetParams();
+
+	configure(IPAConfigInfo configInfo, uint8 bayerOrder)
+		=> (int32 ret, libcamera.ControlInfoMap ipaControls);
+
+	mapBuffers(array<libcamera.IPABuffer> buffers, bool readOnly);
+	unmapBuffers(array<libcamera.IPABuffer> buffers);
+
+	[async] queueRequest(uint32 request, libcamera.ControlList reqControls);
+	[async] fillParams(uint32 request, uint32 bufferId);
+	[async] processStats(uint32 request, uint32 bufferId,
+			     libcamera.ControlList sensorControls);
+};
+
+interface IPAQcomIfeEventInterface {
+	paramsComputed(uint32 request, uint32 bytesused);
+	statsProcessed(uint32 request, libcamera.ControlList metadata);
+	setSensorControls(libcamera.ControlList sensorControls);
+};
