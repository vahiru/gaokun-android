@@ -0,0 +1,139 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE phase detection pixel correction
+ */
+
+#include "pdpc.h"
+
+#include <algorithm>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/value_node.h"
+
+/**
+ * \file pdpc.h
+ */
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+/**
+ * \class Pdpc
+ * \brief Phase detection pixel correction
+ *
+ * Phase detection sensors replace some image pixels with masked ones, which
+ * show as a dot grid. The IFE replaces the pixels a mask marks from their
+ * neighbours. The pipeline handler passes the positions of the configured
+ * sensor mode, taken from the sensor properties: they exist in full size
+ * modes only, where binning does not average them away.
+ *
+ * The mask is a 64x64 pixel tile repeated over the frame from its top left
+ * corner, with one bit per pixel pair; the phase detection period must divide
+ * 64. The thresholds come from the tuning file: \a fmax and \a fmin (unsigned
+ * Q6), \a offset and \a t2Offset.
+ */
+
+LOG_DEFINE_CATEGORY(QcomIfePdpc)
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::init
+ */
+int Pdpc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	fmax_ = tuningData["fmax"].get<uint8_t>(fmax_);
+	fmin_ = tuningData["fmin"].get<uint8_t>(fmin_);
+	/* The kernel takes at most 15 bits */
+	offset_ = std::min<uint16_t>(tuningData["offset"].get<uint16_t>(offset_), 0x7fff);
+	t2Offset_ = std::min<uint16_t>(tuningData["t2Offset"].get<uint16_t>(t2Offset_), 0x7fff);
+
+	return 0;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::configure
+ */
+int Pdpc::configure(IPAContext &context,
+		    [[maybe_unused]] const IPACameraSensorInfo &configInfo)
+{
+	const Size &period = context.configuration.pd.period;
+	const unsigned int tile = IFE17X_PDPC_MASK_ROWS;
+
+	mask_.fill(0);
+	active_ = false;
+
+	if (context.configuration.pd.pixels.empty())
+		return 0;
+
+	if (!period.width || !period.height ||
+	    tile % period.width || tile % period.height) {
+		LOG(QcomIfePdpc, Warning)
+			<< "Phase detection period " << period
+			<< " does not divide the " << tile << " pixel tile";
+		return 0;
+	}
+
+	for (const Point &p : context.configuration.pd.pixels) {
+		const unsigned int px = static_cast<unsigned int>(p.x) % period.width;
+		const unsigned int py = static_cast<unsigned int>(p.y) % period.height;
+
+		for (unsigned int ty = py; ty < tile; ty += period.height)
+			for (unsigned int tx = px; tx < tile; tx += period.width)
+				mask_[ty] |= 1U << (31 - tx / 2);
+	}
+
+	active_ = true;
+	LOG(QcomIfePdpc, Debug)
+		<< context.configuration.pd.pixels.size()
+		<< " phase detection pixels per " << period;
+
+	return 0;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::prepare
+ */
+void Pdpc::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		   IPAFrameContext &frameContext, QcomIfeParams *params)
+{
+	if (!active_)
+		return;
+
+	auto block = params->block<QcomIfeBlocks::Pdpc>();
+	block.setEnabled(true);
+
+	/* 16 bit black level to the 14 bit pipeline, as BPC and ABF take it */
+	block->black_level = std::min<uint32_t>(
+		context.configuration.blc.level.value_or(0) >> 2, 4095);
+	block->fmax = fmax_;
+	block->fmin = fmin_;
+	block->bp_offset[0] = block->bp_offset[1] = offset_;
+	block->t2_bp_offset[0] = block->t2_bp_offset[1] = t2Offset_;
+
+	/* The neighbours of other colours, compared at the frame's gains */
+	const RGB<double> &gains = frameContext.awb.gains;
+	double r = 1.0, b = 1.0;
+
+	if (gains.r() > 0.0 && gains.g() > 0.0 && gains.b() > 0.0) {
+		r = gains.r() / gains.g();
+		b = gains.b() / gains.g();
+	}
+	auto q12 = [](double v) {
+		return static_cast<uint32_t>(std::clamp(v * 4096.0, 1.0, 131071.0));
+	};
+	block->wb_ratio[0] = q12(r);
+	block->wb_ratio[1] = q12(b);
+	block->wb_ratio[2] = q12(1.0 / r);
+	block->wb_ratio[3] = q12(1.0 / b);
+
+	std::copy(mask_.begin(), mask_.end(), block->mask);
+}
+
+REGISTER_IPA_ALGORITHM(Pdpc, "Pdpc")
+
+} /* namespace ipa::qcom_ife::algorithms */
+
+} /* namespace libcamera */
