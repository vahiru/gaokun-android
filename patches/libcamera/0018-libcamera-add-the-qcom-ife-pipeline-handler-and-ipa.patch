diff --git a/src/ipa/qcom-ife/algorithms/bpc.cpp b/src/ipa/qcom-ife/algorithms/bpc.cpp
new file mode 100644
index 00000000..ef1252df
--- /dev/null
+++ b/src/ipa/qcom-ife/algorithms/bpc.cpp
@@ -0,0 +1,108 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE bad pixel and bad cluster correction
+ */
+
+#include "bpc.h"
+
+#include <algorithm>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/value_node.h"
+
+/**
+ * \file bpc.h
+ */
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+/**
+ * \class Bpc
+ * \brief Qualcomm IFE bad pixel and bad cluster correction
+ *
+ * BPCBCC50 replaces pixels that stand out from their neighbours by more than
+ * the limits \a fmax and \a fmin (unsigned Q6, defaults 80 and 32, i.e. 1.25
+ * and 0.5), single ones and clusters, with the offsets \a bpcOffset and
+ * \a bccOffset and the threshold \a threshold (defaults 128 each, in the 14
+ * bit units of the pipeline). The defaults are the Windows driver's values,
+ * the same for both camera modules of this device and at every gain.
+ *
+ * Neighbours of other colours are compared at the frame's white balance
+ * gains, so the block goes out with every frame.
+ */
+
+LOG_DEFINE_CATEGORY(QcomIfeBpc)
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::init
+ */
+int Bpc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	fmax_ = std::clamp<unsigned int>(tuningData["fmax"].get<unsigned int>(80), 64, 127);
+	fmin_ = std::min<unsigned int>(tuningData["fmin"].get<unsigned int>(32), 64);
+	bpcOffset_ = std::min<unsigned int>(tuningData["bpcOffset"].get<unsigned int>(128), 0x7fff);
+	bccOffset_ = std::min<unsigned int>(tuningData["bccOffset"].get<unsigned int>(128), 0x7fff);
+	threshold_ = std::min<unsigned int>(tuningData["threshold"].get<unsigned int>(128), 8191);
+
+	return 0;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::configure
+ */
+int Bpc::configure(IPAContext &context,
+		   [[maybe_unused]] const IPACameraSensorInfo &configInfo)
+{
+	/* The level still in the data, in the 14 bit units of the pipeline */
+	blackLevel_ = std::min<unsigned int>(
+		context.configuration.blc.level.value_or(0) >> 2, 4095);
+
+	return 0;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::prepare
+ */
+void Bpc::prepare([[maybe_unused]] IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext, QcomIfeParams *params)
+{
+	auto block = params->block<QcomIfeBlocks::Bpc>();
+	block.setEnabled(true);
+
+	const RGB<double> &gains = frameContext.awb.gains;
+	double r = 1.0, b = 1.0;
+
+	if (gains.r() > 0.0 && gains.g() > 0.0 && gains.b() > 0.0) {
+		r = gains.r() / gains.g();
+		b = gains.b() / gains.g();
+	}
+
+	/* Q12, limited like the Windows driver */
+	auto q12 = [](double v) {
+		return static_cast<uint32_t>(std::clamp(v * 4096.0, 128.0, 131071.0));
+	};
+	block->wb_ratio[0] = q12(r);
+	block->wb_ratio[1] = q12(b);
+	block->wb_ratio[2] = q12(1.0 / r);
+	block->wb_ratio[3] = q12(1.0 / b);
+
+	block->flags = 0;
+	block->black_level = blackLevel_;
+	block->bpc_offset = bpcOffset_;
+	block->bcc_offset = bccOffset_;
+	block->threshold = threshold_;
+	block->fmax = fmax_;
+	block->fmin = fmin_;
+}
+
+REGISTER_IPA_ALGORITHM(Bpc, "Bpc")
+
+} /* namespace ipa::qcom_ife::algorithms */
+
+} /* namespace libcamera */
