+class QcomIfeCameraConfiguration : public CameraConfiguration
+{
+public:
+	QcomIfeCameraConfiguration(QcomIfeCameraData *data)
+		: CameraConfiguration(), data_(data)
+	{
+	}
+
+	Status validate() override;
+
+	V4L2SubdeviceFormat sensorFormat_;
+	Transform combinedTransform_;
+
+private:
+	const QcomIfeCameraData *data_;
+};
+
+CameraConfiguration::Status QcomIfeCameraConfiguration::validate()
+{
+	Status status = Valid;
+
+	if (config_.empty())
+		return Invalid;
+
+	/*
+	 * Up to three outputs: the full output path of the pixel pipeline,
+	 * its display output path, if there is one, and the sensor frame as
+	 * is through the RDI, if there is one (RAW).
+	 */
+	auto isRaw = [](const StreamConfiguration &c) {
+		return BayerFormat::fromPixelFormat(c.pixelFormat).isValid();
+	};
+	{
+		const unsigned int maxImages = data_->hasDisplay_ ? 2 : 1;
+		std::vector<StreamConfiguration> keep;
+		unsigned int images = 0;
+		bool haveRaw = false;
+
+		for (const StreamConfiguration &c : config_) {
+			if (isRaw(c) && data_->raw_ && !haveRaw && config_.size() > 1) {
+				keep.push_back(c);
+				haveRaw = true;
+			} else if (images < maxImages && (!isRaw(c) || config_.size() == 1)) {
+				keep.push_back(c);
+				images++;
+			} else {
+				status = Adjusted;
+			}
+		}
+		if (!images)
+			return Invalid;
+		config_ = std::move(keep);
+	}
+
+	Orientation requestedOrientation = orientation;
+	combinedTransform_ = data_->sensor_->computeTransform(&orientation);
+	if (orientation != requestedOrientation)
+		status = Adjusted;
+
+	/*
+	 * Of two image streams, the larger takes the full output path and the
+	 * other the display output path.
+	 */
+	StreamConfiguration *rawCfg = nullptr;
+	StreamConfiguration *imageCfg = nullptr;
+	StreamConfiguration *dispCfg = nullptr;
+	for (StreamConfiguration &c : config_) {
+		if (config_.size() > 1 && isRaw(c))
+			rawCfg = &c;
+		else if (!imageCfg)
+			imageCfg = &c;
+		else
+			dispCfg = &c;
+	}
+	if (dispCfg && dispCfg->size.width * dispCfg->size.height >
+		       imageCfg->size.width * imageCfg->size.height)
+		std::swap(imageCfg, dispCfg);
+	StreamConfiguration &cfg = *imageCfg;
+
+	if (cfg.pixelFormat != formats::NV12) {
+		LOG(QcomIfe, Debug) << "Format adjusted to NV12";
+		cfg.pixelFormat = formats::NV12;
+		status = Adjusted;
+	}
+
+	Size size = cfg.size.boundedTo(data_->maxOutputSize())
+			    .expandedTo(kMinSize)
+			    .alignedDownTo(kWidthAlign, kHeightAlign);
+	if (size != cfg.size) {
+		LOG(QcomIfe, Debug) << "Size adjusted to " << size;
+		cfg.size = size;
+		status = Adjusted;
+	}
+
+	/*
+	 * A RAW stream is the sensor frame of the largest mode, the one with
+	 * the phase detection pixels: the image comes from that mode too.
+	 */
+	sensorFormat_ = data_->sensorFormat(rawCfg ? data_->sensor_->resolution() : cfg.size);
+	if (!sensorFormat_.code) {
+		LOG(QcomIfe, Error) << "No sensor mode for " << cfg.size;
+		return Invalid;
+	}
+
+	if (rawCfg) {
+		BayerFormat bayer = BayerFormat::fromMbusCode(sensorFormat_.code);
+		bayer.order = data_->sensor_->bayerOrder(combinedTransform_);
+		bayer.packing = BayerFormat::Packing::CSI2;
+		const PixelFormat rawFormat = bayer.toPixelFormat();
+
+		if (rawCfg->pixelFormat != rawFormat || rawCfg->size != sensorFormat_.size) {
+			rawCfg->pixelFormat = rawFormat;
+			rawCfg->size = sensorFormat_.size;
+			status = Adjusted;
+		}
+
+		V4L2DeviceFormat f;
+		f.fourcc = data_->raw_->toV4L2PixelFormat(rawFormat);
+		f.size = rawCfg->size;
+		f.planesCount = 1;
+		if (data_->raw_->tryFormat(&f) || f.size != rawCfg->size) {
+			LOG(QcomIfe, Error) << "The RDI does not take " << rawCfg->toString();
+			return Invalid;
+		}
+		rawCfg->stride = f.planes[0].bpl;
+		rawCfg->frameSize = f.planes[0].size;
+		rawCfg->bufferCount = kBufferCount;
+		rawCfg->colorSpace = ColorSpace::Raw;
+		rawCfg->setStream(const_cast<Stream *>(&data_->rawStream_));
+	}
+
+	/*
+	 * Dual IFE: the two pixel paths do not scale, the output is the whole
+	 * sensor frame.
+	 */
+	if (sensorFormat_.size.width > kMaxInputWidth) {
+		const Size full = sensorFormat_.size.alignedDownTo(kWidthAlign, kHeightAlign);
+
+		if (cfg.size != full) {
+			LOG(QcomIfe, Debug) << "Dual IFE size adjusted to " << full;
+			cfg.size = full;
+			status = Adjusted;
+		}
+	}
+
+	/* Downscaling limit: grow the output if the mode is too large */
+	Size minOut{ sensorFormat_.size.width / kMaxDownscale,
+		     sensorFormat_.size.height / kMaxDownscale };
+	minOut = minOut.alignedUpTo(kWidthAlign, kHeightAlign);
+	if (cfg.size.width < minOut.width || cfg.size.height < minOut.height) {
+		cfg.size = cfg.size.expandedTo(minOut);
+		status = Adjusted;
+	}
+
+	/* The kernel stores NV12 in one plane, the stride equals the width */
+	ColorSpace colorSpace = ColorSpace::Sycc;
+	if (cfg.colorSpace != colorSpace) {
+		if (cfg.colorSpace)
+			status = Adjusted;
+		cfg.colorSpace = colorSpace;
+	}
+
+	cfg.stride = cfg.size.width;
+	cfg.frameSize = cfg.size.width * cfg.size.height * 3 / 2;
+	cfg.bufferCount = kBufferCount;
+	cfg.setStream(const_cast<Stream *>(&data_->stream_));
+
+	if (!dispCfg)
+		return status;
+
+	StreamConfiguration &disp = *dispCfg;
+
+	if (disp.pixelFormat != formats::NV12) {
+		disp.pixelFormat = formats::NV12;
+		status = Adjusted;
+	}
+
+	/*
+	 * The field of view of the full output: the display output covers
+	 * the same, so both outputs have one field of view. Its size takes the
+	 * aspect ratio of that field of view, covering the size asked for.
+	 */
+	const Size input = sensorFormat_.size;
+	Size scaled;
+	const Rectangle fov = fullPathCrop(input, cfg.size, &scaled)
+				      .transformedBetween(Rectangle(scaled), Rectangle(input));
+	/*
+	 * Integer arithmetic, and the height rounded down from the width, so
+	 * that a size validated once stays as it is.
+	 */
+	auto widthFor = [&](uint64_t h) {
+		return static_cast<unsigned int>((h * fov.width + fov.height - 1) / fov.height);
+	};
+	auto heightFor = [&](uint64_t w) {
+		return static_cast<unsigned int>(w * fov.height / fov.width);
+	};
+	/*
+	 * The scaler downscales the input by up to kMaxDownscale, to at least
+	 * an even size: the field of view's share of that is the smallest
+	 * output. It does not upscale, and the display output stays within
+	 * the full one, which keeps the two streams on their paths when the
+	 * configuration is validated again.
+	 */
+	const auto minScaled = [](unsigned int in) {
+		return utils::alignUp((in + kMaxDownscale - 1) / kMaxDownscale, 2);
+	};
+	const Size minSize =
+		Size(static_cast<unsigned int>((static_cast<uint64_t>(minScaled(input.width)) *
+						fov.width + input.width - 1) / input.width),
+		     static_cast<unsigned int>((static_cast<uint64_t>(minScaled(input.height)) *
+						fov.height + input.height - 1) / input.height))
+			.alignedUpTo(kWidthAlign, kHeightAlign);
+	const Size maxSize = fov.size().alignedDownTo(kWidthAlign, kHeightAlign).boundedTo(cfg.size);
+
+	Size dsize = disp.size.expandedTo(kMinSize).alignedUpTo(kWidthAlign, kHeightAlign);
+	dsize.width = std::max({ dsize.width, minSize.width,
+				 utils::alignUp(widthFor(std::max(dsize.height, minSize.height)),
+						kWidthAlign) });
+	dsize.width = std::min(dsize.width, maxSize.width);
+	dsize.height = std::min(utils::alignDown(heightFor(dsize.width), kHeightAlign),
+				maxSize.height);
+	if (dsize != disp.size) {
+		LOG(QcomIfe, Debug) << "Display output size adjusted to " << dsize;
+		disp.size = dsize;
+		status = Adjusted;
+	}
+
+	if (disp.colorSpace != cfg.colorSpace) {
+		if (disp.colorSpace)
+			status = Adjusted;
+		disp.colorSpace = cfg.colorSpace;
+	}
+
+	disp.stride = disp.size.width;
+	disp.frameSize = disp.size.width * disp.size.height * 3 / 2;
+	disp.bufferCount = kBufferCount;
+	disp.setStream(const_cast<Stream *>(&data_->dispStream_));
+
+	return status;
+}
+
+class PipelineHandlerQcomIfe : public PipelineHandler
+{
+public:
+	PipelineHandlerQcomIfe(CameraManager *manager)
+		: PipelineHandler(manager, kBufferCount)
+	{
+	}
+
+	std::unique_ptr<CameraConfiguration>
+	generateConfiguration(Camera *camera, std::span<const StreamRole> roles) override;
+	int configure(Camera *camera, CameraConfiguration *config) override;
+
+	int exportFrameBuffers(Camera *camera, Stream *stream,
+			       std::vector<std::unique_ptr<FrameBuffer>> *buffers) override;
+
+	int start(Camera *camera, const ControlList *controls) override;
+
+	bool match(DeviceEnumerator *enumerator) override;
+
+protected:
+	int queueRequestDevice(Camera *camera, Request *request) override;
+	void stopDevice(Camera *camera) override;
+	bool acquireDevice(Camera *camera) override;
+
+private:
+	QcomIfeCameraData *cameraData(Camera *camera)
+	{
+		return static_cast<QcomIfeCameraData *>(camera->_d());
+	}
+
+	bool registerSensorCamera(MediaEntity *csiphy, MediaEntity *sensor);
+	int configureDual(QcomIfeCameraData *data, const V4L2SubdeviceFormat &format,
+			  unsigned int split);
+
+	int allocateBuffers(Camera *camera);
+	void freeBuffers(Camera *camera);
+
+	enum class FrameKind { Image, Params, Stats, Raw, Display };
+	void checkFrame(FrameKind kind, Request *request, FrameBuffer *buffer);
+
+	QcomIfeFrameInfo *findFrameInfo(FrameBuffer *buffer);
+	void setFrame(const QcomIfeFrameInfo &info, FrameBuffer *buffer);
+	void tryComplete(QcomIfeFrameInfo *info);
+	void queueFrame(QcomIfeCameraData *data);
+
+	void imageReady(FrameKind kind, FrameBuffer *buffer);
+	void imageBufferReady(FrameBuffer *buffer);
+	void dispBufferReady(FrameBuffer *buffer);
+	void rawBufferReady(FrameBuffer *buffer);
+	void paramsBufferReady(FrameBuffer *buffer);
+	void statsBufferReady(FrameBuffer *buffer);
+
+	void paramsComputed(unsigned int requestId, uint32_t bytesused);
+	uint32_t appendOutputs(FrameBuffer *buffer, uint32_t bytesused, uint32_t outputs);
+	uint32_t outputsOnly(FrameBuffer *buffer, uint32_t outputs);
+	uint32_t appendDisplayWindow(FrameBuffer *buffer, uint32_t bytesused,
+				     const Size &compose, const Rectangle &crop);
+	void dispWindowFor(const Rectangle &scalerCrop, Size *compose, Rectangle *crop,
+			   Rectangle *shown) const;
+	void statsProcessed(unsigned int requestId, const ControlList &metadata);
+
+	void queueError();
+	void recover();
+
+	std::shared_ptr<MediaDevice> media_;
+	std::unique_ptr<V4L2Subdevice> csid_;
+	std::unique_ptr<V4L2Subdevice> pix_;
+	/* Second pixel path for frames wider than one IFE line, if present */
+	std::unique_ptr<V4L2Subdevice> csid1_;
+	std::unique_ptr<V4L2Subdevice> pix1_;
+	std::unique_ptr<V4L2VideoDevice> video_;
+	std::unique_ptr<V4L2VideoDevice> params_;
+	std::unique_ptr<V4L2VideoDevice> stats_;
+	/* RDI 0 and its node, for a RAW stream, if present */
+	std::unique_ptr<V4L2Subdevice> rdi_;
+	std::unique_ptr<V4L2VideoDevice> raw_;
+	bool rawConfigured_ = false;
+	bool rawStreaming_ = false;
+	/* The display output path and its node, if present */
+	std::unique_ptr<V4L2Subdevice> disp_;
+	std::unique_ptr<V4L2VideoDevice> dispVideo_;
+	bool dispConfigured_ = false;
+	bool dispStreaming_ = false;
+	/* Dual IFE: the column where the right stripe starts */
+	unsigned int dualSplit_ = 0;
+
+	/*
+	 * Zoom through the display output (dispWindowFor()): its geometry as
+	 * configured, in the frame (the scaler input, both stripes with dual
+	 * IFE), and the frame's place on the pixel array.
+	 */
+	struct {
+		Size frame;
+		Rectangle fov;
+		Size output;
+		Size compose;
+		Rectangle crop;
+		Rectangle analogCrop;
+		Rectangle scalerCropMax;
+	} dispGeom_;
+	/* The ScalerCrop of the last request that set one, null for none */
+	Rectangle zoom_;
+	/*
+	 * The display window the driver holds: it keeps one until parameters
+	 * change it, and starts with the configured one. Only a change goes
+	 * into the parameters.
+	 */
+	struct {
+		Size compose;
+		Rectangle crop;
+		Rectangle shown;
+	} dispSent_;
+	void resetDispSent()
+	{
+		dispSent_ = { dispGeom_.compose, dispGeom_.crop, dispGeom_.scalerCropMax };
+	}
+
+	std::vector<std::unique_ptr<FrameBuffer>> paramsBuffers_;
+	/* The parameters, for the outputs block after those of the IPA */
+	std::map<const FrameBuffer *, std::unique_ptr<MappedFrameBuffer>> paramsMaps_;
+	std::vector<std::unique_ptr<FrameBuffer>> statsBuffers_;
+	std::queue<FrameBuffer *> availableParamsBuffers_;
+	std::queue<FrameBuffer *> availableStatsBuffers_;
+	std::vector<IPABuffer> ipaBuffers_;
+
+	std::map<unsigned int, QcomIfeFrameInfo> frameInfo_;
+	bool videoStreaming_ = false;
+	std::array<int64_t, 5> frameOffset_;
+
+	/*
+	 * Error recovery. The driver fails the queues when the IFE wedges
+	 * (no frame comes until the streams restart): restart them without
+	 * stopping the camera, the requests in flight complete cancelled.
+	 */
+	Camera *camera_ = nullptr;
+	bool recoveryPending_ = false;
+	bool failed_ = false;
+	/* Parameters buffers the driver rejected in a row */
+	unsigned int paramsRejected_ = 0;
+	static constexpr unsigned int kMaxParamsRejected = 3;
+	unsigned int failedRestarts_ = 0;
+	static constexpr unsigned int kMaxFailedRestarts = 5;
+};
+
+std::unique_ptr<CameraConfiguration>
+PipelineHandlerQcomIfe::generateConfiguration(Camera *camera,
+					      std::span<const StreamRole> roles)
+{
+	QcomIfeCameraData *data = cameraData(camera);
+	auto config = std::make_unique<QcomIfeCameraConfiguration>(data);
+
+	if (roles.empty())
+		return config;
+
+	/*
+	 * One image stream, or two with the display output path, and a RAW
+	 * stream of the sensor frame if asked. A RAW role alone is an image.
+	 */
+	const unsigned int rawRoles = roles.size() > 1
+					      ? std::count(roles.begin(), roles.end(), StreamRole::Raw)
+					      : 0;
+	const unsigned int imageRoles = roles.size() - rawRoles;
+	if (rawRoles > 1 || (rawRoles && !data->raw_) || !imageRoles ||
+	    imageRoles > (data->hasDisplay_ ? 2u : 1u)) {
+		LOG(QcomIfe, Error)
+			<< "Supported: " << (data->hasDisplay_ ? "one or two image streams"
+							       : "one image stream")
+			<< " and one RAW stream";
+		return nullptr;
+	}
+	const bool withRaw = rawRoles == 1;
+
+	const Size maxSize = data->maxOutputSize();
+
+	for (StreamRole role : roles) {
+		if (withRaw && role == StreamRole::Raw) {
+			/* The sensor frame of the largest mode, Bayer order of no flips */
+			const Size full = data->sensor_->resolution();
+			const V4L2SubdeviceFormat mode = data->sensorFormat(full);
+			BayerFormat bayer = BayerFormat::fromMbusCode(mode.code);
+			bayer.packing = BayerFormat::Packing::CSI2;
+			const PixelFormat rawFormat = bayer.toPixelFormat();
+
+			std::map<PixelFormat, std::vector<SizeRange>> rawFormats = {
+				{ rawFormat, { SizeRange(mode.size) } },
+			};
+			StreamConfiguration rawCfg{ StreamFormats{ rawFormats } };
+			rawCfg.pixelFormat = rawFormat;
+			rawCfg.size = mode.size;
+			rawCfg.bufferCount = kBufferCount;
+			config->addConfiguration(rawCfg);
+			continue;
+		}
+
+		Size size;
+		switch (role) {
+		case StreamRole::StillCapture:
+		case StreamRole::Raw:
+			size = maxSize;
+			break;
+		case StreamRole::Viewfinder:
+		case StreamRole::VideoRecording:
+		default:
+			size = Size(1920, 1080).boundedTo(maxSize);
+			break;
+		}
+
+		std::map<PixelFormat, std::vector<SizeRange>> formats = {
+			{ formats::NV12,
+			  { SizeRange(kMinSize, maxSize, kWidthAlign, kHeightAlign) } },
+		};
+		StreamConfiguration cfg{ StreamFormats{ formats } };
+		cfg.pixelFormat = formats::NV12;
+		cfg.size = size;
+		cfg.bufferCount = kBufferCount;
+		config->addConfiguration(cfg);
+	}
+
+	if (config->validate() == CameraConfiguration::Invalid)
+		return nullptr;
+
+	return config;
+}
+
+int PipelineHandlerQcomIfe::configure(Camera *camera, CameraConfiguration *c)
+{
+	QcomIfeCameraData *data = cameraData(camera);
+	QcomIfeCameraConfiguration *config =
+		static_cast<QcomIfeCameraConfiguration *>(c);
+	const StreamConfiguration *rawCfg = nullptr;
+	const StreamConfiguration *imageCfg = nullptr;
+	const StreamConfiguration *dispCfg = nullptr;
+	for (const StreamConfiguration &sc : *config) {
+		if (sc.stream() == &data->rawStream_)
+			rawCfg = &sc;
+		else if (sc.stream() == &data->dispStream_)
+			dispCfg = &sc;
+		else
+			imageCfg = &sc;
+	}
+	const StreamConfiguration &cfg = *imageCfg;
+	int ret;
+
+	/* Nothing of a previous configuration holds if this one fails */
+	dispConfigured_ = false;
+	rawConfigured_ = false;
+	dualSplit_ = 0;
+
+	/* Links: sensor -> CSIPHY -> CSID 0 -> IPP -> VFE 0 pixel path */
+	ret = media_->disableLinks();
+	if (ret)
+		return ret;
+
+	MediaLink *link = media_->link(data->csiphyEntity_->name(), kCsiphySourcePad,
+				       kCsidName, kCsidSinkPad);
+	if (!link || link->setEnabled(true)) {
+		LOG(QcomIfe, Error) << "Cannot link " << data->csiphyEntity_->name()
+				    << " to " << kCsidName;
+		return -EINVAL;
+	}
+	link = media_->link(kCsidName, kCsidIppPad, kPixName, kPixSinkPad);
+	if (!link || link->setEnabled(true)) {
+		LOG(QcomIfe, Error) << "Cannot link " << kCsidName << " to "
+				    << kPixName;
+		return -EINVAL;
+	}
+
+	/* The sensor applies the flips and gives the resulting Bayer order */
+	V4L2SubdeviceFormat format = config->sensorFormat_;
+	ret = data->sensor_->setFormat(&format, config->combinedTransform_);
+	if (ret)
+		return ret;
+
+	const Size inputSize = format.size;
+	const Size outputSize = cfg.size;
+	const bool dual = inputSize.width > kMaxInputWidth;
+
+	/* Propagate the sensor format to the pixel path input */
+	struct {
+		V4L2Subdevice *sd;
+		unsigned int pad;
+	} chain[] = {
+		{ data->csiphy_.get(), kCsiphySinkPad },
+		{ data->csiphy_.get(), kCsiphySourcePad },
+		{ csid_.get(), kCsidSinkPad },
+		{ csid_.get(), kCsidIppPad },
+		{ pix_.get(), kPixSinkPad },
+	};
+	for (const auto &[sd, pad] : chain) {
+		/* Dual IFE: configureDual() sets the CSIDs and pixel paths */
+		if (dual && sd != data->csiphy_.get())
+			break;
+		V4L2SubdeviceFormat f = format;
+		ret = sd->setFormat(pad, &f);
+		if (ret)
+			return ret;
+		if (f.code != format.code || f.size != format.size) {
+			LOG(QcomIfe, Error) << sd->entity()->name() << " pad " << pad
+					    << " took " << f << ", wanted " << format;
+			return -EINVAL;
+		}
+	}
+
+	Size scaled = inputSize;
+	Rectangle crop{ 0, 0, outputSize };
+
+	if (dual) {
+		/*
+		 * With the display output, the split that lines its stripes
+		 * up best (dualSplitForDisplay()); its geometry is that of
+		 * one IFE over the whole frame.
+		 */
+		dualSplit_ = dualSplit(inputSize.width);
+		if (dispCfg) {
+			Size dispCompose;
+			Rectangle dispCrop;
+			double residual;
+
+			dispPathGeometry(inputSize, Rectangle(inputSize), dispCfg->size,
+					 &dispCompose, &dispCrop);
+			dualSplit_ = dualSplitForDisplay(inputSize, dispCompose.width,
+							 &residual);
+			LOG(QcomIfe, Debug) << "Dual IFE split " << dualSplit_
+					    << " for the display output, seam residual "
+					    << residual << " columns";
+		}
+		ret = configureDual(data, format, dualSplit_);
+		if (ret)
+			return ret;
+		goto video;
+	}
+
+	{
+	/*
+	 * Scale to the smallest size that keeps the sensor aspect ratio and
+	 * covers the output, then crop the output from its centre.
+	 */
+	crop = fullPathCrop(inputSize, outputSize, &scaled);
+
+	Rectangle compose{ 0, 0, scaled };
+	ret = pix_->setSelection(kPixSinkPad, V4L2_SEL_TGT_COMPOSE, &compose);
+	if (ret)
+		return ret;
+	if (compose.size() != scaled) {
+		LOG(QcomIfe, Error) << "Scaler took " << compose << ", wanted "
+				    << scaled;
+		return -EINVAL;
+	}
+
+	Rectangle fullCrop = crop;
+	ret = pix_->setSelection(kPixSourcePad, V4L2_SEL_TGT_CROP, &fullCrop);
+	if (ret)
+		return ret;
+	if (fullCrop != crop) {
+		LOG(QcomIfe, Error) << "Full output crop " << fullCrop << ", wanted "
+				    << crop;
+		return -EINVAL;
+	}
+
+	V4L2SubdeviceFormat outFormat{};
+	outFormat.code = MEDIA_BUS_FMT_YUYV8_1_5X8;
+	outFormat.size = outputSize;
+	ret = pix_->setFormat(kPixSourcePad, &outFormat);
+	if (ret)
+		return ret;
+	if (outFormat.size != outputSize || outFormat.code != MEDIA_BUS_FMT_YUYV8_1_5X8) {
+		LOG(QcomIfe, Error) << "Pixel path output " << outFormat
+				    << ", wanted " << outputSize << " NV12";
+		return -EINVAL;
+	}
+	}
+
+video:
+	V4L2DeviceFormat videoFormat;
+	videoFormat.fourcc = video_->toV4L2PixelFormat(formats::NV12);
+	videoFormat.size = outputSize;
+	videoFormat.planesCount = 1;
+	ret = video_->setFormat(&videoFormat);
+	if (ret)
+		return ret;
+	if (videoFormat.size != outputSize ||
+	    videoFormat.fourcc != video_->toV4L2PixelFormat(formats::NV12)) {
+		LOG(QcomIfe, Error) << "Video node took " << videoFormat;
+		return -EINVAL;
+	}
+
+	/*
+	 * Display output: the pixel path output -> the display output path ->
+	 * its node. The link and the formats must be set before the full
+	 * output starts the pixel path, which then waits for display buffers
+	 * as well: every frame it writes has both images.
+	 */
+	dispConfigured_ = false;
+	if (dispCfg) {
+		/* Dual IFE: the driver splits the display output into stripes */
+		const Rectangle fov = crop.transformedBetween(Rectangle(scaled),
+							      Rectangle(inputSize));
+		Size dispCompose;
+		Rectangle dispCrop;
+		dispPathGeometry(inputSize, fov, dispCfg->size, &dispCompose, &dispCrop);
+
+		link = media_->link(kPixName, kPixSourcePad, kDispName, kDispSinkPad);
+		if (!link || link->setEnabled(true)) {
+			LOG(QcomIfe, Error) << "Cannot link " << kPixName << " to " << kDispName;
+			return -EINVAL;
+		}
+
+		V4L2SubdeviceFormat f{};
+		f.code = MEDIA_BUS_FMT_YUYV8_1_5X8;
+		f.size = inputSize;
+		ret = disp_->setFormat(kDispSinkPad, &f);
+		if (ret)
+			return ret;
+		if (f.size != inputSize || f.code != MEDIA_BUS_FMT_YUYV8_1_5X8) {
+			LOG(QcomIfe, Error) << "Display output input " << f << ", wanted "
+					    << inputSize;
+			return -EINVAL;
+		}
+
+		Rectangle r{ 0, 0, dispCompose };
+		ret = disp_->setSelection(kDispSinkPad, V4L2_SEL_TGT_COMPOSE, &r);
+		if (ret)
+			return ret;
+		if (r.size() != dispCompose) {
+			LOG(QcomIfe, Error) << "Display scaler took " << r << ", wanted "
+					    << dispCompose;
+			return -EINVAL;
+		}
+
+		r = dispCrop;
+		ret = disp_->setSelection(kDispSourcePad, V4L2_SEL_TGT_CROP, &r);
+		if (ret)
+			return ret;
+		if (r != dispCrop) {
+			LOG(QcomIfe, Error) << "Display crop " << r << ", wanted " << dispCrop;
+			return -EINVAL;
+		}
+
+		ret = disp_->getFormat(kDispSourcePad, &f);
+		if (ret)
+			return ret;
+		if (f.size != dispCfg->size || f.code != MEDIA_BUS_FMT_YUYV8_1_5X8) {
+			LOG(QcomIfe, Error) << "Display output " << f << ", wanted "
+					    << dispCfg->size << " NV12";
+			return -EINVAL;
+		}
+
+		V4L2DeviceFormat dispFormat;
+		dispFormat.fourcc = dispVideo_->toV4L2PixelFormat(formats::NV12);
+		dispFormat.size = dispCfg->size;
+		dispFormat.planesCount = 1;
+		ret = dispVideo_->setFormat(&dispFormat);
+		if (ret)
+			return ret;
+		if (dispFormat.size != dispCfg->size ||
+		    dispFormat.fourcc != dispVideo_->toV4L2PixelFormat(formats::NV12)) {
+			LOG(QcomIfe, Error) << "Display node took " << dispFormat;
+			return -EINVAL;
+		}
+
+		dispGeom_.frame = inputSize;
+		dispGeom_.fov = fov;
+		dispGeom_.output = dispCfg->size;
+		dispGeom_.compose = dispCompose;
+		dispGeom_.crop = dispCrop;
+		zoom_ = Rectangle();
+
+		LOG(QcomIfe, Info) << "Display output: scaled " << dispCompose
+				   << ", crop " << dispCrop << ", output " << dispCfg->size;
+		dispConfigured_ = true;
+	}
+
+	/*
+	 * RAW: CSID 0 port 1 -> RDI 0 -> its video node, the sensor frame as
+	 * is. The link must be up before the CSID starts, which configures
+	 * the ports linked then.
+	 */
+	rawConfigured_ = false;
+	if (rawCfg) {
+		link = media_->link(kCsidName, kCsidRdiPad, kRdiName, 0);
+		if (!link || link->setEnabled(true)) {
+			LOG(QcomIfe, Error) << "Cannot link " << kCsidName << " to " << kRdiName;
+			return -EINVAL;
+		}
+
+		V4L2SubdeviceFormat f = format;
+		ret = csid_->setFormat(kCsidRdiPad, &f);
+		if (!ret)
+			ret = rdi_->setFormat(0, &f);
+		if (!ret)
+			ret = rdi_->setFormat(1, &f);
+		if (ret)
+			return ret;
+		if (f.code != format.code || f.size != format.size) {
+			LOG(QcomIfe, Error) << "RDI took " << f << ", wanted " << format;
+			return -EINVAL;
+		}
+
+		V4L2DeviceFormat rawFormat;
+		rawFormat.fourcc = raw_->toV4L2PixelFormat(rawCfg->pixelFormat);
+		rawFormat.size = rawCfg->size;
+		rawFormat.planesCount = 1;
+		ret = raw_->setFormat(&rawFormat);
+		if (ret)
+			return ret;
+		if (rawFormat.size != rawCfg->size ||
+		    rawFormat.fourcc != raw_->toV4L2PixelFormat(rawCfg->pixelFormat)) {
+			LOG(QcomIfe, Error) << "RAW node took " << rawFormat;
+			return -EINVAL;
+		}
+		rawConfigured_ = true;
+	}
+
+	V4L2DeviceFormat statsFormat;
+	ret = stats_->getFormat(&statsFormat);
+	if (ret)
+		return ret;
+	if (statsFormat.planes[0].size < sizeof(struct ife17x_stats_buffer)) {
+		LOG(QcomIfe, Error) << "Statistics buffer size "
+				    << statsFormat.planes[0].size << " too small";
+		return -EINVAL;
+	}
+
+	if (dual)
+		LOG(QcomIfe, Info) << "Sensor " << format << ", dual IFE, output "
+				   << outputSize << (rawConfigured_ ? ", with RAW" : "");
+	else
+		LOG(QcomIfe, Info) << "Sensor " << format << ", scaled " << scaled
+				   << ", crop " << crop << ", output " << outputSize
+				   << (dispConfigured_ ? ", with display output" : "")
+				   << (rawConfigured_ ? ", with RAW" : "");
+
+	/* The IPA needs the sensor mode and the Bayer order after the flips */
+	ipa::qcom_ife::IPAConfigInfo ipaConfig{};
+	ret = data->sensor_->sensorInfo(&ipaConfig.sensorInfo);
+	if (ret)
+		return ret;
+	ipaConfig.sensorControls = data->sensor_->controls();
+	ipaConfig.dualIfe = dual;
+	if (dual) {
+		ipaConfig.dualSplit = dualSplit_;
+		ipaConfig.dualPad = kDualPad;
+	}
+
+	/*
+	 * The field of view of the output in pixel array coordinates: the
+	 * crop of the scaled sensor frame, which covers the analogue crop.
+	 * AfWindows are relative to it.
+	 */
+	{
+		const Rectangle input(inputSize);
+		Rectangle fov = crop.transformedBetween(Rectangle(scaled), input);
+
+		fov = fov.transformedBetween(input, ipaConfig.sensorInfo.analogCrop);
+		data->properties_.set(properties::ScalerCropMaximum, fov);
+		dispGeom_.analogCrop = ipaConfig.sensorInfo.analogCrop;
+		dispGeom_.scalerCropMax = fov;
+	}
+
+	/*
+	 * Phase detection pixels, known for readouts of the whole active area
+	 * at full resolution with a given transform. The pixel path input
+	 * starts at the frame's left edge, the master stripe too.
+	 */
+	const CameraSensorProperties *props =
+		CameraSensorProperties::get(data->sensor_->model());
+	if (props && ipaConfig.sensorInfo.outputSize == ipaConfig.sensorInfo.activeAreaSize) {
+		const auto &pd = props->phaseDetectPixels;
+		const auto it = pd.positions.find(config->combinedTransform_);
+
+		if (it != pd.positions.end()) {
+			ipaConfig.pdPeriod = pd.period;
+			ipaConfig.pdPixels = it->second;
+		}
+	}
+
+	BayerFormat::Order bayerOrder =
+		data->sensor_->bayerOrder(config->combinedTransform_);
+	ControlInfoMap ipaControls;
+	ret = data->ipa_->configure(ipaConfig, utils::to_underlying(bayerOrder),
+				    &ipaControls);
+	if (ret) {
+		LOG(QcomIfe, Error) << "Failed to configure the IPA";
+		return ret;
+	}
+	/*
+	 * ScalerCrop zooms the display output: down to its own size in the
+	 * frame, where the scaler stops downscaling.
+	 */
+	Rectangle zoomMin, zoomMax;
+	if (dispConfigured_) {
+		const Size smallest = dispGeom_.output.boundedTo(dispGeom_.fov.size());
+
+		zoomMax = dispGeom_.scalerCropMax;
+		zoomMin = Rectangle(smallest)
+				  .transformedBetween(Rectangle(dispGeom_.frame), dispGeom_.analogCrop);
+		zoomMin.x = 0;
+		zoomMin.y = 0;
+	}
+	data->updateControls(ipaControls, zoomMin, zoomMax);
+
+	return 0;
+}
+
+/*
+ * Dual IFE: CSID 0 and CSID 1 crop the left and right stripes of the frame
+ * from the same CSIPHY stream into the pixel paths of VFE 0 and VFE 1. The
+ * split is a multiple of 64 near the middle and each stripe is padded by 64
+ * columns beyond it: the right stripe starts at a multiple of 64, where the
+ * phase detection mask tiles line up, and the edge effects of demosaicing
+ * stay in the padding, which the output crops leave out. VFE 1 writes its
+ * stripe into the buffers of the VFE 0 video node.
+ */
+int PipelineHandlerQcomIfe::configureDual(QcomIfeCameraData *data,
+					  const V4L2SubdeviceFormat &format,
+					  unsigned int split)
+{
+	const unsigned int width = format.size.width;
+	const unsigned int height = format.size.height;
+
+	if (!csid1_ || !pix1_ || split + kDualPad > kMaxInputWidth ||
+	    width - split + kDualPad > kMaxInputWidth || width % kWidthAlign) {
+		LOG(QcomIfe, Error) << "Sensor mode " << format.size
+				    << " does not fit two pixel paths";
+		return -EINVAL;
+	}
+
+	const struct {
+		V4L2Subdevice *csid;
+		V4L2Subdevice *pix;
+		Rectangle in;
+		Rectangle out;
+	} stripes[] = {
+		{ csid_.get(), pix_.get(), { 0, 0, split + kDualPad, height },
+		  { 0, 0, split, height } },
+		{ csid1_.get(), pix1_.get(),
+		  { static_cast<int>(split - kDualPad), 0, width - split + kDualPad, height },
+		  { static_cast<int>(kDualPad), 0, width - split, height } },
+	};
+
+	const std::pair<std::string, std::pair<unsigned int, std::string>> links[] = {
+		{ data->csiphyEntity_->name(), { kCsiphySourcePad, kCsid1Name } },
+		{ kCsid1Name, { kCsidIppPad, kPix1Name } },
+	};
+	for (const auto &[src, sink] : links) {
+		unsigned int sinkPad = sink.second == kPix1Name ? kPixSinkPad : kCsidSinkPad;
+		MediaLink *link = media_->link(src, sink.first, sink.second, sinkPad);
+
+		if (!link || link->setEnabled(true)) {
+			LOG(QcomIfe, Error) << "Cannot link " << src << " to " << sink.second;
+			return -EINVAL;
+		}
+	}
+	MediaLink *link = media_->link(kPix1Name, kPixSourcePad, kVideoName, 0);
+	if (!link || link->setEnabled(true)) {
+		LOG(QcomIfe, Error) << "Cannot link " << kPix1Name << " to " << kVideoName;
+		return -EINVAL;
+	}
+
+	for (const auto &st : stripes) {
+		V4L2SubdeviceFormat f = format;
+		int ret = st.csid->setFormat(kCsidSinkPad, &f);
+		if (ret)
+			return ret;
+
+		Rectangle in = st.in;
+		ret = st.csid->setSelection(kCsidIppPad, V4L2_SEL_TGT_CROP, &in);
+		if (ret)
+			return ret;
+
+		f = format;
+		f.size = st.in.size();
+		ret = st.csid->setFormat(kCsidIppPad, &f);
+		if (ret)
+			return ret;
+		ret = st.pix->setFormat(kPixSinkPad, &f);
+		if (ret)
+			return ret;
+		if (in != st.in || f.size != st.in.size() || f.code != format.code) {
+			LOG(QcomIfe, Error) << st.csid->entity()->name() << " crop " << in
+					    << " to " << f << ", wanted " << st.in;
+			return -EINVAL;
+		}
+
+		Rectangle out = st.out;
+		ret = st.pix->setSelection(kPixSourcePad, V4L2_SEL_TGT_CROP, &out);
+		if (ret)
+			return ret;
+
+		V4L2SubdeviceFormat o{};
+		o.code = MEDIA_BUS_FMT_YUYV8_1_5X8;
+		o.size = st.out.size();
+		ret = st.pix->setFormat(kPixSourcePad, &o);
+		if (ret)
+			return ret;
+		if (out != st.out || o.size != st.out.size()) {
+			LOG(QcomIfe, Error) << st.pix->entity()->name() << " output " << out
+					    << " " << o << ", wanted " << st.out;
+			return -EINVAL;
+		}
+	}
+
+	LOG(QcomIfe, Debug) << "Dual IFE split at " << split << ", padding " << kDualPad;
+	return 0;
+}
+
+int PipelineHandlerQcomIfe::exportFrameBuffers(Camera *camera, Stream *stream,
+					       std::vector<std::unique_ptr<FrameBuffer>> *buffers)
+{
+	QcomIfeCameraData *data = cameraData(camera);
+
+	if (stream == &data->rawStream_ && raw_)
+		return raw_->exportBuffers(stream->configuration().bufferCount, buffers);
+	if (stream == &data->dispStream_ && dispVideo_)
+		return dispVideo_->exportBuffers(stream->configuration().bufferCount, buffers);
+	if (stream != &data->stream_)
+		return -EINVAL;
+
+	return video_->exportBuffers(stream->configuration().bufferCount, buffers);
+}
+
+int PipelineHandlerQcomIfe::allocateBuffers(Camera *camera)
+{
+	QcomIfeCameraData *data = cameraData(camera);
+	int ret;
+
+	ret = params_->allocateBuffers(kBufferCount, &paramsBuffers_);
+	if (ret < 0)
+		return ret;
+	ret = stats_->allocateBuffers(kBufferCount, &statsBuffers_);
+	if (ret < 0) {
+		params_->releaseBuffers();
+		paramsBuffers_.clear();
+		return ret;
+	}
+
+	/* Statistics are read only for the IPA, parameters are written */
+	unsigned int ipaBufferId = 1;
+	std::vector<IPABuffer> statsIpa, paramsIpa;
+
+	for (std::unique_ptr<FrameBuffer> &buffer : statsBuffers_) {
+		buffer->setCookie(ipaBufferId++);
+		const auto planes = buffer->planes();
+		statsIpa.emplace_back(buffer->cookie(),
+				  std::vector<FrameBuffer::Plane>{ planes.begin(), planes.end() });
+		availableStatsBuffers_.push(buffer.get());
+	}
+	for (std::unique_ptr<FrameBuffer> &buffer : paramsBuffers_) {
+		auto map = std::make_unique<MappedFrameBuffer>(buffer.get(),
+							       MappedFrameBuffer::MapFlag::ReadWrite);
+		if (!map->isValid() || map->planes().empty()) {
+			LOG(QcomIfe, Error) << "Cannot map the parameters buffers";
+			paramsMaps_.clear();
+			availableStatsBuffers_ = {};
+			paramsBuffers_.clear();
+			statsBuffers_.clear();
+			params_->releaseBuffers();
+			stats_->releaseBuffers();
+			return -ENOMEM;
+		}
+		paramsMaps_[buffer.get()] = std::move(map);
+	}
+	for (std::unique_ptr<FrameBuffer> &buffer : paramsBuffers_) {
+		buffer->setCookie(ipaBufferId++);
+		const auto planes = buffer->planes();
+		paramsIpa.emplace_back(buffer->cookie(),
+				   std::vector<FrameBuffer::Plane>{ planes.begin(), planes.end() });
+		availableParamsBuffers_.push(buffer.get());
+	}
+
+	data->ipa_->mapBuffers(statsIpa, true);
+	data->ipa_->mapBuffers(paramsIpa, false);
+
+	ipaBuffers_ = std::move(statsIpa);
+	ipaBuffers_.insert(ipaBuffers_.end(), paramsIpa.begin(), paramsIpa.end());
+
+	return 0;
+}
+
+void PipelineHandlerQcomIfe::freeBuffers(Camera *camera)
+{
+	QcomIfeCameraData *data = cameraData(camera);
+
+	if (!ipaBuffers_.empty())
+		data->ipa_->unmapBuffers(ipaBuffers_);
+	ipaBuffers_.clear();
+
+	availableParamsBuffers_ = {};
+	availableStatsBuffers_ = {};
+	paramsMaps_.clear();
+	paramsBuffers_.clear();
+	statsBuffers_.clear();
+
+	params_->releaseBuffers();
+	stats_->releaseBuffers();
+	video_->releaseBuffers();
+	if (dispVideo_)
+		dispVideo_->releaseBuffers();
+	if (raw_)
+		raw_->releaseBuffers();
+}
+
+int PipelineHandlerQcomIfe::start(Camera *camera, const ControlList *controls)
+{
+	QcomIfeCameraData *data = cameraData(camera);
+	int ret;
+
+	ret = allocateBuffers(camera);
+	if (ret)
+		return ret;
+
+	ret = video_->importBuffers(data->stream_.configuration().bufferCount);
+	if (!ret && dispConfigured_)
+		ret = dispVideo_->importBuffers(data->dispStream_.configuration().bufferCount);
+	if (!ret && rawConfigured_)
+		ret = raw_->importBuffers(data->rawStream_.configuration().bufferCount);
+	if (ret) {
+		freeBuffers(camera);
+		return ret;
+	}
+
+	{
+		ipa::qcom_ife::StartResult result;
+
+		data->ipa_->start(controls ? *controls : ControlList{ controls::controls },
+				  &result);
+		ret = result.ret;
+		ControlList &sensorControls = result.sensorControls;
+		if (ret) {
+			LOG(QcomIfe, Error) << "Failed to start the IPA";
+			freeBuffers(camera);
+			return ret;
+		}
+
+		ret = data->sensor_->setTestPatternMode(controls::draft::TestPatternModeOff);
+		if (ret && ret != -EINVAL)
+			LOG(QcomIfe, Warning) << "Cannot turn the test pattern off";
+
+		/*
+		 * The first frames' controls, before streaming: the frame
+		 * length first, as it limits the exposure time.
+		 */
+		if (sensorControls.contains(V4L2_CID_VBLANK)) {
+			ControlList vblank(data->sensor_->controls());
+			vblank.set(V4L2_CID_VBLANK, sensorControls.get(V4L2_CID_VBLANK));
+			data->sensor_->setControls(&vblank);
+		}
+		if (!sensorControls.empty())
+			data->sensor_->setControls(&sensorControls);
+	}
+
+	data->delayedCtrls_->reset();
+
+	/* Frame start events of the pixel path drive the sensor controls */
+	ret = pix_->setFrameStartEnabled(true);
+	if (ret) {
+		LOG(QcomIfe, Error) << "No frame start events from " << kPixName;
+		goto error_ipa;
+	}
+	pix_->frameStart.connect(data->delayedCtrls_.get(),
+				 &DelayedControls::applyControls);
+
+	/*
+	 * The image node starts streaming with the buffers of the first
+	 * request, in paramsComputed(): the write master has no address
+	 * without a buffer, and the parameters queued before the start apply
+	 * to the first frame.
+	 */
+	ret = params_->streamOn();
+	if (ret)
+		goto error_events;
+	ret = stats_->streamOn();
+	if (ret)
+		goto error_params;
+
+	videoStreaming_ = false;
+	dispStreaming_ = false;
+	rawStreaming_ = false;
+	frameOffset_.fill(-1000);
+	resetDispSent();
+	camera_ = camera;
+	recoveryPending_ = false;
+	failed_ = false;
+	failedRestarts_ = 0;
+	paramsRejected_ = 0;
+
+	return 0;
+
+error_params:
+	params_->streamOff();
+error_events:
+	pix_->frameStart.disconnect(data->delayedCtrls_.get(),
+				    &DelayedControls::applyControls);
+	pix_->setFrameStartEnabled(false);
+error_ipa:
+	data->ipa_->stop();
+	freeBuffers(camera);
+	return ret;
+}
+
+void PipelineHandlerQcomIfe::stopDevice(Camera *camera)
+{
+	QcomIfeCameraData *data = cameraData(camera);
+
+	camera_ = nullptr;
+	data->ipa_->stop();
+
+	/*
+	 * The display node first, while the pixel path still runs to write
+	 * its last frames, then the image node; the RDI keeps the sensor
+	 * running until last.
+	 */
+	if (dispConfigured_)
+		dispVideo_->streamOff();
+	dispStreaming_ = false;
+	video_->streamOff();
+	videoStreaming_ = false;
+	if (rawConfigured_)
+		raw_->streamOff();
+	rawStreaming_ = false;
+	stats_->streamOff();
+	params_->streamOff();
+
+	pix_->frameStart.disconnect(data->delayedCtrls_.get(),
+				    &DelayedControls::applyControls);
+	pix_->setFrameStartEnabled(false);
+
+	/* Requests the IPA had not finished with */
+	while (!frameInfo_.empty()) {
+		auto it = frameInfo_.begin();
+		Request *request = it->second.request;
+		frameInfo_.erase(it);
+		cancelRequest(request);
+	}
+
+	freeBuffers(camera);
+}
+
+/* One camera at a time: they share the CSID and the VFE */
+bool PipelineHandlerQcomIfe::acquireDevice([[maybe_unused]] Camera *camera)
+{
+	return useCount() == 0;
+}
+
+int PipelineHandlerQcomIfe::queueRequestDevice(Camera *camera, Request *request)
+{
+	QcomIfeCameraData *data = cameraData(camera);
+
+	/* The streams could not be restarted: fail the request */
+	if (failed_)
+		return -EIO;
+
+	/*
+	 * The parameters of a request name the outputs that write its frame
+	 * (appendOutputs()): the driver gives the frame to them once each has
+	 * a buffer, and to no other, so a request can leave out a stream. The
+	 * frame needs an image, of the full or the display output.
+	 */
+	uint32_t outputs = 0;
+	for (const auto &[stream, buffer] : request->buffers()) {
+		if (stream == &data->stream_)
+			outputs |= IFE17X_OUTPUT_FULL;
+		else if (stream == &data->dispStream_)
+			outputs |= IFE17X_OUTPUT_DISPLAY;
+		else if (stream == &data->rawStream_)
+			outputs |= IFE17X_OUTPUT_RDI;
+	}
+	if (!(outputs & (IFE17X_OUTPUT_FULL | IFE17X_OUTPUT_DISPLAY))) {
+		LOG(QcomIfe, Error) << "Request " << request->sequence()
+				    << " has no image buffer";
+		return -EINVAL;
+	}
+
+	/* maxQueuedRequestsDevice is kBufferCount, as many as the buffers */
+	if (availableParamsBuffers_.empty() || availableStatsBuffers_.empty()) {
+		LOG(QcomIfe, Error) << "Parameters or statistics buffer underrun";
+		return -ENOBUFS;
+	}
+
+	QcomIfeFrameInfo &info = frameInfo_[request->sequence()];
+	info.request = request;
+	info.paramBuffer = availableParamsBuffers_.front();
+	availableParamsBuffers_.pop();
+	info.statBuffer = availableStatsBuffers_.front();
+	availableStatsBuffers_.pop();
+	info.outputs = outputs;
+	info.frameKnown = false;
+	info.dispWindow = false;
+
+	/*
+	 * ScalerCrop zooms the display output from this request's frame on;
+	 * the full output keeps the field of view. Report the window shown.
+	 */
+	if (dispConfigured_) {
+		if (const auto &crop = request->controls().get(controls::ScalerCrop))
+			zoom_ = *crop;
+
+		dispWindowFor(zoom_, &info.dispCompose, &info.dispCrop, &info.dispShown);
+		info.dispWindow = true;
+		request->_d()->metadata().set(controls::ScalerCrop, info.dispShown);
+	}
+	info.paramsQueued = false;
+	info.paramsDone = false;
+	info.statsDone = false;
+
+	/* Not frame accurate: the sensor applies it when it can */
+	const auto &pattern = request->controls().get(controls::draft::TestPatternMode);
+	if (pattern) {
+		int ret = data->sensor_->setTestPatternMode(
+			static_cast<controls::draft::TestPatternModeEnum>(*pattern));
+		if (ret)
+			LOG(QcomIfe, Error) << "Cannot set test pattern " << *pattern;
+		else
+			request->_d()->metadata().set(controls::draft::TestPatternMode,
+						      *pattern);
+	}
+
+	data->ipa_->queueRequest(request->sequence(), request->controls());
+	data->ipa_->fillParams(request->sequence(), info.paramBuffer->cookie());
+
+	return 0;
+}
+
+/*
+ * The IPA filled the parameters of a request: queue them with the statistics
+ * and image buffers. All three go to the next frames in order.
+ */
+void PipelineHandlerQcomIfe::paramsComputed(unsigned int requestId, uint32_t bytesused)
+{
+	auto it = frameInfo_.find(requestId);
+	if (it == frameInfo_.end())
+		return;
+
+	QcomIfeFrameInfo &info = it->second;
+	Request *request = info.request;
+
+	/*
+	 * Gave up after a device error, or the camera stops (stop() flushes
+	 * the IPA's messages): nothing more goes to the device.
+	 */
+	if (failed_ || !camera_) {
+		availableParamsBuffers_.push(info.paramBuffer);
+		availableStatsBuffers_.push(info.statBuffer);
+		frameInfo_.erase(it);
+		cancelRequest(request);
+		return;
+	}
+
+	/* The window when it changes (dispSent_) */
+	const bool window = info.dispWindow &&
+			    (info.dispCompose != dispSent_.compose || info.dispCrop != dispSent_.crop);
+	bool windowSent = window;
+
+	bytesused = appendOutputs(info.paramBuffer, bytesused, info.outputs);
+	if (window)
+		bytesused = appendDisplayWindow(info.paramBuffer, bytesused,
+						info.dispCompose, info.dispCrop);
+	info.paramBuffer->_d()->metadata().planes()[0].bytesused = bytesused;
+	if (params_->queueBuffer(info.paramBuffer) < 0) {
+		LOG(QcomIfe, Error) << "Cannot queue parameters of request "
+				    << requestId;
+		/*
+		 * They may have carried the full configuration: send it again,
+		 * a few times at most (a block the driver keeps rejecting would
+		 * otherwise take the full configuration with it every frame),
+		 * and only while the camera runs (stop() flushes messages).
+		 */
+		if (camera_ && ++paramsRejected_ <= kMaxParamsRejected)
+			cameraData(request->_d()->camera())->ipa_->resetParams();
+
+		/*
+		 * The frame of the request still needs its outputs list, or
+		 * the request's other buffers would go to another request's
+		 * frame: queue the list alone, with the window, then without
+		 * it (the frame keeps the window the driver holds, which the
+		 * metadata then reports). Failing that, the request does not
+		 * go to the device.
+		 */
+		bytesused = outputsOnly(info.paramBuffer, info.outputs);
+		if (bytesused && window)
+			bytesused = appendDisplayWindow(info.paramBuffer, bytesused,
+							info.dispCompose, info.dispCrop);
+		info.paramBuffer->_d()->metadata().planes()[0].bytesused = bytesused;
+		bool queued = bytesused && params_->queueBuffer(info.paramBuffer) >= 0;
+		if (!queued && window) {
+			bytesused = outputsOnly(info.paramBuffer, info.outputs);
+			info.paramBuffer->_d()->metadata().planes()[0].bytesused = bytesused;
+			queued = bytesused && params_->queueBuffer(info.paramBuffer) >= 0;
+			if (queued) {
+				LOG(QcomIfe, Error) << "Display window of request " << requestId
+						    << " refused";
+				windowSent = false;
+				request->_d()->metadata().set(controls::ScalerCrop, dispSent_.shown);
+			}
+		}
+		if (!queued) {
+			LOG(QcomIfe, Error) << "Cannot queue the outputs of request "
+					    << requestId;
+			availableParamsBuffers_.push(info.paramBuffer);
+			availableStatsBuffers_.push(info.statBuffer);
+			frameInfo_.erase(it);
+			cancelRequest(request);
+			queueError();
+			return;
+		}
+	} else {
+		paramsRejected_ = 0;
+	}
+	info.paramsQueued = true;
+	if (windowSent)
+		dispSent_ = { info.dispCompose, info.dispCrop, info.dispShown };
+
+	/*
+	 * The driver gives each frame the first statistics buffer queued:
+	 * without this one, later requests would take the grids of frames
+	 * before theirs. Restart the streams.
+	 */
+	if (stats_->queueBuffer(info.statBuffer) < 0) {
+		LOG(QcomIfe, Error) << "Cannot queue statistics of request "
+				    << requestId;
+		info.statsDone = true;
+		queueError();
+	}
+
+	/*
+	 * The image buffers after the parameters that name them, the full
+	 * output buffer last.
+	 */
+	QcomIfeCameraData *data = cameraData(request->_d()->camera());
+	for (bool full : { false, true }) {
+		for (auto &[stream, buffer] : request->buffers()) {
+			if ((stream == &data->stream_) != full)
+				continue;
+
+			V4L2VideoDevice *dev = stream == &data->rawStream_ ? raw_.get()
+					     : stream == &data->dispStream_ ? dispVideo_.get()
+									     : video_.get();
+			/*
+			 * Its frame waits for it, as the outputs list names
+			 * it: restart the streams.
+			 */
+			if (dev->queueBuffer(buffer) < 0) {
+				buffer->_d()->cancel();
+				completeBuffer(request, buffer);
+				queueError();
+			}
+		}
+	}
+
+	/*
+	 * The image node first: it starts the sensor with the pixel path, so
+	 * that the epochs count every frame the RDI writes. The display
+	 * output needs the pixel path running; until it streams, the pixel
+	 * path writes no frame. So it starts last: the RDI then writes from
+	 * the first frame on too, which each node takes as frame 0.
+	 */
+	/*
+	 * A stream that does not start leaves the buffers on a stopped
+	 * queue: handle it as a device error, which restarts the streams or
+	 * gives up.
+	 */
+	if (!videoStreaming_) {
+		int ret = video_->streamOn();
+		if (ret) {
+			LOG(QcomIfe, Error) << "Cannot start the image stream: "
+					    << strerror(-ret);
+			queueError();
+		} else {
+			videoStreaming_ = true;
+		}
+	}
+	if (rawConfigured_ && videoStreaming_ && !rawStreaming_) {
+		int ret = raw_->streamOn();
+		if (ret) {
+			LOG(QcomIfe, Error) << "Cannot start the RAW stream: "
+					    << strerror(-ret);
+			queueError();
+		} else {
+			rawStreaming_ = true;
+		}
+	}
+	if (dispConfigured_ && videoStreaming_ && !dispStreaming_ &&
+	    (!rawConfigured_ || rawStreaming_)) {
+		int ret = dispVideo_->streamOn();
+		if (ret) {
+			LOG(QcomIfe, Error) << "Cannot start the display stream: "
+					    << strerror(-ret);
+			queueError();
+		} else {
+			dispStreaming_ = true;
+		}
+	}
+
+	tryComplete(&info);
+}
+
+/*
+ * Name the outputs that write the request's frame (IFE17X_OUTPUT_*) in its
+ * parameters, after the blocks of the IPA. Returns the size of the
+ * parameters.
+ */
+uint32_t PipelineHandlerQcomIfe::appendOutputs(FrameBuffer *buffer, uint32_t bytesused,
+					       uint32_t outputs)
+{
+	auto it = paramsMaps_.find(buffer);
+	if (it == paramsMaps_.end())
+		return bytesused;
+
+	std::span<uint8_t> mem = it->second->planes()[0];
+	auto *params = reinterpret_cast<struct v4l2_isp_params_buffer *>(mem.data());
+	const size_t offset = offsetof(struct v4l2_isp_params_buffer, data) + params->data_size;
+	struct ife17x_params_outputs block{};
+
+	if (offset != bytesused || offset + sizeof(block) > mem.size()) {
+		LOG(QcomIfe, Error) << "No room for the outputs block: " << bytesused
+				    << " bytes used, " << mem.size() << " in the buffer";
+		return bytesused;
+	}
+
+	block.header.type = IFE17X_PARAMS_BLOCK_OUTPUTS;
+	block.header.flags = V4L2_ISP_PARAMS_FL_BLOCK_ENABLE;
+	block.header.size = sizeof(block);
+	block.outputs = outputs;
+	memcpy(mem.data() + offset, &block, sizeof(block));
+	params->data_size += sizeof(block);
+
+	return offset + sizeof(block);
+}
+
+/*
+ * The display output's window of the request's frame, after the other blocks.
+ * Returns the size of the parameters.
+ */
+uint32_t PipelineHandlerQcomIfe::appendDisplayWindow(FrameBuffer *buffer, uint32_t bytesused,
+						     const Size &compose, const Rectangle &crop)
+{
+	auto it = paramsMaps_.find(buffer);
+	if (it == paramsMaps_.end())
+		return bytesused;
+
+	std::span<uint8_t> mem = it->second->planes()[0];
+	auto *params = reinterpret_cast<struct v4l2_isp_params_buffer *>(mem.data());
+	const size_t offset = offsetof(struct v4l2_isp_params_buffer, data) + params->data_size;
+	struct ife17x_params_display_window block{};
+
+	if (offset != bytesused || offset + sizeof(block) > mem.size()) {
+		LOG(QcomIfe, Error) << "No room for the display window block";
+		return bytesused;
+	}
+
+	block.header.type = IFE17X_PARAMS_BLOCK_DISPLAY_WINDOW;
+	block.header.flags = V4L2_ISP_PARAMS_FL_BLOCK_ENABLE;
+	block.header.size = sizeof(block);
+	block.compose_width = compose.width;
+	block.compose_height = compose.height;
+	block.crop_left = crop.x;
+	block.crop_top = crop.y;
+	memcpy(mem.data() + offset, &block, sizeof(block));
+	params->data_size += sizeof(block);
+
+	return offset + sizeof(block);
+}
+
+/*
+ * The display output's window for a ScalerCrop rectangle (pixel array
+ * coordinates): the scaler output size @compose and the crop in it, and the
+ * rectangle it shows (@shown, pixel array coordinates). The zoom is the same
+ * in both directions, covers the rectangle when it can, keeps its centre,
+ * stays inside the field of view, and stops where the scaler would have to
+ * upscale. A null or full field of view rectangle gives the configured
+ * window, which has the field of view of the full output exactly.
+ */
+void PipelineHandlerQcomIfe::dispWindowFor(const Rectangle &scalerCrop, Size *compose,
+					   Rectangle *crop, Rectangle *shown) const
+{
+	const Size &frame = dispGeom_.frame;
+	const Size &out = dispGeom_.output;
+	const Rectangle &fov = dispGeom_.fov;
+	const Rectangle frameRect(frame);
+
+	Rectangle want;
+	if (!scalerCrop.isNull())
+		want = scalerCrop.transformedBetween(dispGeom_.analogCrop, frameRect).boundedTo(fov);
+	if (want.isNull() || (want.width >= fov.width && want.height >= fov.height)) {
+		*compose = dispGeom_.compose;
+		*crop = dispGeom_.crop;
+		*shown = dispGeom_.scalerCropMax;
+		return;
+	}
+
+	/* Input pixels per output pixel: 1 (no upscaling) to the field of view */
+	const double maxScale = std::min({ static_cast<double>(fov.width) / out.width,
+					   static_cast<double>(fov.height) / out.height,
+					   static_cast<double>(kMaxDownscale) });
+	double scale = std::max(static_cast<double>(want.width) / out.width,
+				static_cast<double>(want.height) / out.height);
+	scale = std::clamp(scale, 1.0, std::max(1.0, maxScale));
+
+	auto even = [](double v) {
+		return static_cast<unsigned int>(std::lround(v / 2)) * 2;
+	};
+	Size c{ even(frame.width / scale), even(frame.height / scale) };
+	c = c.expandedTo(out).boundedTo(frame);
+
+	/* The window in the frame, centred on the rectangle, inside the fov */
+	const double sx = static_cast<double>(frame.width) / c.width;
+	const double sy = static_cast<double>(frame.height) / c.height;
+	const double ww = out.width * sx, wh = out.height * sy;
+	const Point centre = want.center();
+	double left = std::clamp(centre.x - ww / 2, static_cast<double>(fov.x),
+				 std::max<double>(fov.x, fov.x + fov.width - ww));
+	double top = std::clamp(centre.y - wh / 2, static_cast<double>(fov.y),
+				std::max<double>(fov.y, fov.y + fov.height - wh));
+
+	unsigned int x = std::min(even(left / sx), c.width - out.width);
+	unsigned int y = std::min(even(top / sy), c.height - out.height);
+
+	*compose = c;
+	*crop = Rectangle(static_cast<int>(x), static_cast<int>(y), out);
+	*shown = Rectangle(static_cast<int>(std::lround(x * sx)), static_cast<int>(std::lround(y * sy)),
+			   static_cast<unsigned int>(std::lround(ww)),
+			   static_cast<unsigned int>(std::lround(wh)))
+			 .transformedBetween(frameRect, dispGeom_.analogCrop);
+}
+
+/*
+ * Parameters of the outputs list alone, for a request whose parameters the
+ * driver refused. Returns their size, 0 on failure.
+ */
+uint32_t PipelineHandlerQcomIfe::outputsOnly(FrameBuffer *buffer, uint32_t outputs)
+{
+	auto it = paramsMaps_.find(buffer);
+	if (it == paramsMaps_.end())
+		return 0;
+
+	auto *params = reinterpret_cast<struct v4l2_isp_params_buffer *>(
+		it->second->planes()[0].data());
+	const uint32_t header = offsetof(struct v4l2_isp_params_buffer, data);
+
+	params->data_size = 0;
+	const uint32_t size = appendOutputs(buffer, header, outputs);
+
+	return size > header ? size : 0;
+}
+
+/*
+ * The IPA computes the parameters of request N for frame N and reads the
+ * statistics of request N as those of frame N. The driver numbers the three
+ * kinds of buffers with the frame they belong to: report when a kind moves
+ * away from the request numbers.
+ */
+void PipelineHandlerQcomIfe::checkFrame(FrameKind kind, Request *request,
+					FrameBuffer *buffer)
+{
+	static const char *const names[] = { "image", "parameters", "statistics", "RAW",
+					     "display" };
+	int64_t offset = static_cast<int64_t>(buffer->metadata().sequence) -
+			 static_cast<int64_t>(request->sequence());
+	int64_t &last = frameOffset_[utils::to_underlying(kind)];
+
+	if (offset == last)
+		return;
+
+	std::ostringstream msg;
+	msg << "Request " << request->sequence() << ": "
+	    << names[utils::to_underlying(kind)] << " of frame "
+	    << buffer->metadata().sequence;
+	if (offset)
+		LOG(QcomIfe, Warning) << msg.str();
+	else
+		LOG(QcomIfe, Info) << msg.str();
+	last = offset;
+}
+
+/*
+ * The buffers of a request belong to one frame, which its parameters buffer
+ * gives. V4L2VideoDevice numbers the frames of each capture node from the
+ * first buffer the node returns, which is the stream's first frame only for
+ * a node that writes it: a request may leave a stream out, and a node whose
+ * first buffer is of a later frame would be numbered too low. Output nodes
+ * keep the driver's numbers, and the parameters of a frame complete when
+ * they are applied, a frame before its images and statistics.
+ */
+void PipelineHandlerQcomIfe::setFrame(const QcomIfeFrameInfo &info, FrameBuffer *buffer)
+{
+	if (info.frameKnown)
+		buffer->_d()->metadata().sequence = info.frame;
+}
+
+QcomIfeFrameInfo *PipelineHandlerQcomIfe::findFrameInfo(FrameBuffer *buffer)
+{
+	for (auto &[sequence, info] : frameInfo_) {
+		if (info.paramBuffer == buffer || info.statBuffer == buffer)
+			return &info;
+	}
+
+	return nullptr;
+}
+
+void PipelineHandlerQcomIfe::tryComplete(QcomIfeFrameInfo *info)
+{
+	Request *request = info->request;
+
+	if (!info->paramsDone || !info->statsDone)
+		return;
+	if (request->hasPendingBuffers())
+		return;
+
+	/*
+	 * An image buffer completed before its parameters keeps the number
+	 * its node gave it: number it now, for the request's consumers.
+	 */
+	for (auto &[stream, buffer] : request->buffers()) {
+		if (buffer->metadata().status == FrameMetadata::FrameSuccess)
+			setFrame(*info, buffer);
+	}
+
+	availableParamsBuffers_.push(info->paramBuffer);
+	availableStatsBuffers_.push(info->statBuffer);
+
+	frameInfo_.erase(request->sequence());
+	completeRequest(request);
+}
+
+/* An image of the full or the display output: both are of the same frame */
+void PipelineHandlerQcomIfe::imageReady(FrameKind kind, FrameBuffer *buffer)
+{
+	Request *request = buffer->request();
+	auto it = frameInfo_.find(request->sequence());
+	if (it == frameInfo_.end())
+		return;
+
+	QcomIfeFrameInfo &info = it->second;
+
+	if (buffer->metadata().status != FrameMetadata::FrameCancelled) {
+		setFrame(info, buffer);
+		request->_d()->metadata().set(controls::SensorTimestamp,
+					      buffer->metadata().timestamp);
+		checkFrame(kind, request, buffer);
+	}
+	if (buffer->metadata().status == FrameMetadata::FrameSuccess)
+		failedRestarts_ = 0;
+
+	completeBuffer(request, buffer);
+	tryComplete(&info);
+}
+
+void PipelineHandlerQcomIfe::imageBufferReady(FrameBuffer *buffer)
+{
+	imageReady(FrameKind::Image, buffer);
+}
+
+void PipelineHandlerQcomIfe::dispBufferReady(FrameBuffer *buffer)
+{
+	imageReady(FrameKind::Display, buffer);
+}
+
+void PipelineHandlerQcomIfe::rawBufferReady(FrameBuffer *buffer)
+{
+	Request *request = buffer->request();
+	auto it = frameInfo_.find(request->sequence());
+	if (it == frameInfo_.end())
+		return;
+
+	if (buffer->metadata().status == FrameMetadata::FrameSuccess) {
+		setFrame(it->second, buffer);
+		checkFrame(FrameKind::Raw, request, buffer);
+	}
+
+	completeBuffer(request, buffer);
+	tryComplete(&it->second);
+}
+
+void PipelineHandlerQcomIfe::paramsBufferReady(FrameBuffer *buffer)
+{
+	QcomIfeFrameInfo *info = findFrameInfo(buffer);
+	if (!info)
+		return;
+
+	if (buffer->metadata().status == FrameMetadata::FrameSuccess) {
+		checkFrame(FrameKind::Params, info->request, buffer);
+		info->frame = buffer->metadata().sequence;
+		info->frameKnown = true;
+	}
+
+	info->paramsDone = true;
+	tryComplete(info);
+}
+
+void PipelineHandlerQcomIfe::statsBufferReady(FrameBuffer *buffer)
+{
+	QcomIfeFrameInfo *info = findFrameInfo(buffer);
+	if (!info)
+		return;
+
+	/* Cancelled or failed: no grid for the IPA, no metadata */
+	if (buffer->metadata().status != FrameMetadata::FrameSuccess) {
+		info->statsDone = true;
+		tryComplete(info);
+		return;
+	}
+
+	Request *request = info->request;
+	setFrame(*info, buffer);
+	checkFrame(FrameKind::Stats, request, buffer);
+	QcomIfeCameraData *data = cameraData(request->_d()->camera());
+
+	/* The sensor settings of the frame the statistics come from */
+	ControlList sensorControls =
+		data->delayedCtrls_->get(buffer->metadata().sequence);
+
+	data->ipa_->processStats(request->sequence(), buffer->cookie(),
+				 sensorControls);
+}
+
+void PipelineHandlerQcomIfe::statsProcessed(unsigned int requestId,
+					    const ControlList &metadata)
+{
+	auto it = frameInfo_.find(requestId);
+	if (it == frameInfo_.end())
+		return;
+
+	QcomIfeFrameInfo &info = it->second;
+
+	info.request->_d()->metadata().merge(metadata);
+	info.statsDone = true;
+	tryComplete(&info);
+}
+
+/*
+ * A queue reported an unrecoverable error: restart the streams from the
+ * event loop, outside the notifier of the device that reported it.
+ */
+void PipelineHandlerQcomIfe::queueError()
+{
+	if (!camera_ || recoveryPending_ || failed_)
+		return;
+
+	recoveryPending_ = true;
+	invokeMethod(&PipelineHandlerQcomIfe::recover, ConnectionTypeQueued);
+}
+
+void PipelineHandlerQcomIfe::recover()
+{
+	recoveryPending_ = false;
+	if (!camera_ || failed_)
+		return;
+
+	QcomIfeCameraData *data = cameraData(camera_);
+
+	if (++failedRestarts_ > kMaxFailedRestarts) {
+		LOG(QcomIfe, Error)
+			<< "Device error after " << kMaxFailedRestarts
+			<< " restarts without a frame: giving up";
+		failed_ = true;
+		if (dispConfigured_)
+			dispVideo_->streamOff();
+		dispStreaming_ = false;
+		video_->streamOff();
+		videoStreaming_ = false;
+		if (rawConfigured_)
+			raw_->streamOff();
+		rawStreaming_ = false;
+		stats_->streamOff();
+		params_->streamOff();
+		return;
+	}
+
+	LOG(QcomIfe, Warning) << "Device error: restarting the streams ("
+			      << failedRestarts_ << ")";
+
+	/*
+	 * The VFE is reset on restart: the IPA must send the full
+	 * configuration again. The call is queued to the IPA after the
+	 * requests already given to it, whose parameters lack it and are
+	 * cancelled below, so the next request's parameters carry it.
+	 */
+	data->ipa_->resetParams();
+
+	/*
+	 * The requests in flight now: their parameters, if computed, lack
+	 * the full configuration. Completing a request queues the waiting
+	 * ones, which get it.
+	 */
+	std::vector<unsigned int> stale;
+	for (const auto &[sequence, info] : frameInfo_)
+		stale.push_back(sequence);
+
+	/*
+	 * Frame start events of the old streams must not reach the delayed
+	 * controls after their reset: unsubscribing drops the pending ones.
+	 */
+	pix_->frameStart.disconnect(data->delayedCtrls_.get(),
+				    &DelayedControls::applyControls);
+	pix_->setFrameStartEnabled(false);
+
+	/*
+	 * The buffers still queued come back cancelled and complete their
+	 * requests.
+	 */
+	if (dispConfigured_)
+		dispVideo_->streamOff();
+	dispStreaming_ = false;
+	video_->streamOff();
+	videoStreaming_ = false;
+	if (rawConfigured_)
+		raw_->streamOff();
+	rawStreaming_ = false;
+	stats_->streamOff();
+	params_->streamOff();
+
+	/*
+	 * Cancel the other stale requests too: their parameters were not
+	 * queued yet, or their statistics are still with the IPA. A late
+	 * paramsComputed() or statsProcessed() finds no frame and is dropped.
+	 */
+	for (unsigned int sequence : stale) {
+		auto it = frameInfo_.find(sequence);
+		if (it == frameInfo_.end())
+			continue;
+
+		QcomIfeFrameInfo &info = it->second;
+		Request *request = info.request;
+
+		availableParamsBuffers_.push(info.paramBuffer);
+		availableStatsBuffers_.push(info.statBuffer);
+		frameInfo_.erase(it);
+		cancelRequest(request);
+	}
+
+	/* Frame numbers start again from 0, the display window as configured */
+	data->delayedCtrls_->reset();
+	frameOffset_.fill(-1000);
+	resetDispSent();
+	/* As in start(): without frame start events the sensor controls stop */
+	if (pix_->setFrameStartEnabled(true)) {
+		LOG(QcomIfe, Error) << "No frame start events from " << kPixName;
+		failed_ = true;
+		return;
+	}
+	pix_->frameStart.connect(data->delayedCtrls_.get(),
+				 &DelayedControls::applyControls);
+
+	int ret = params_->streamOn();
+	if (!ret)
+		ret = stats_->streamOn();
+	if (ret) {
+		LOG(QcomIfe, Error) << "Cannot restart the streams: "
+				    << strerror(-ret);
+		failed_ = true;
+		params_->streamOff();
+		return;
+	}
+
+	/* The image node starts with the next request's buffers */
+}
+
+bool PipelineHandlerQcomIfe::registerSensorCamera(MediaEntity *csiphy,
+						  MediaEntity *sensor)
+{
+	std::unique_ptr<QcomIfeCameraData> data =
+		std::make_unique<QcomIfeCameraData>(this, csiphy);
+
+	/* Two pixel paths take twice a line, less the padding at the split */
+	int ret = data->init(sensor, pix1_ ? 2 * (kMaxInputWidth - kDualPad) : kMaxInputWidth);
+	if (ret) {
+		LOG(QcomIfe, Warning) << "Skipping " << sensor->name() << ": "
+				      << strerror(-ret);
+		return false;
+	}
+
+	ret = data->loadIPA();
+	if (ret) {
+		LOG(QcomIfe, Error) << "No IPA for " << sensor->name();
+		return false;
+	}
+
+	data->ipa_->paramsComputed.connect(this, &PipelineHandlerQcomIfe::paramsComputed);
+	data->ipa_->statsProcessed.connect(this, &PipelineHandlerQcomIfe::statsProcessed);
+
+	data->raw_ = raw_.get();
+	data->hasDisplay_ = disp_ && dispVideo_;
+	std::set<Stream *> streams{ &data->stream_ };
+	if (data->hasDisplay_)
+		streams.insert(&data->dispStream_);
+	if (raw_)
+		streams.insert(&data->rawStream_);
+	const std::string id = data->sensor_->id();
+	std::shared_ptr<Camera> camera =
+		Camera::create(std::move(data), id, streams);
+	registerCamera(std::move(camera));
+
+	return true;
+}
+
+bool PipelineHandlerQcomIfe::match(DeviceEnumerator *enumerator)
+{
+	DeviceMatch dm("qcom-camss");
+	dm.add(kCsidName);
+	dm.add(kPixName);
+	dm.add(kVideoName);
+	dm.add(kParamsName);
+	dm.add(kStatsName);
+
+	media_ = acquireMediaDevice(enumerator, dm);
+	if (!media_)
+		return false;
+
+	csid_ = V4L2Subdevice::fromEntityName(media_.get(), kCsidName);
+	pix_ = V4L2Subdevice::fromEntityName(media_.get(), kPixName);
+	video_ = V4L2VideoDevice::fromEntityName(media_.get(), kVideoName);
+	params_ = V4L2VideoDevice::fromEntityName(media_.get(), kParamsName);
+	stats_ = V4L2VideoDevice::fromEntityName(media_.get(), kStatsName);
+	if (!csid_ || !pix_ || !video_ || !params_ || !stats_)
+		return false;
+
+	if (csid_->open() || pix_->open() || video_->open() ||
+	    params_->open() || stats_->open())
+		return false;
+
+	/* Dual IFE needs CSID 1, the VFE 1 pixel path and its link to our node */
+	if (media_->getEntityByName(kCsid1Name) && media_->getEntityByName(kPix1Name) &&
+	    media_->link(kPix1Name, kPixSourcePad, kVideoName, 0)) {
+		csid1_ = V4L2Subdevice::fromEntityName(media_.get(), kCsid1Name);
+		pix1_ = V4L2Subdevice::fromEntityName(media_.get(), kPix1Name);
+		if (csid1_->open() || pix1_->open()) {
+			csid1_.reset();
+			pix1_.reset();
+		}
+	}
+
+	/* RDI 0 for a RAW stream of the sensor frame, optional */
+	if (media_->getEntityByName(kRdiName) && media_->getEntityByName(kRawVideoName) &&
+	    media_->link(kCsidName, kCsidRdiPad, kRdiName, 0)) {
+		rdi_ = V4L2Subdevice::fromEntityName(media_.get(), kRdiName);
+		raw_ = V4L2VideoDevice::fromEntityName(media_.get(), kRawVideoName);
+		if (rdi_->open() || raw_->open()) {
+			rdi_.reset();
+			raw_.reset();
+		} else {
+			raw_->bufferReady.connect(this, &PipelineHandlerQcomIfe::rawBufferReady);
+			raw_->queueError.connect(this, &PipelineHandlerQcomIfe::queueError);
+		}
+	}
+
+	/* The display output path, optional */
+	if (media_->getEntityByName(kDispName) && media_->getEntityByName(kDispVideoName) &&
+	    media_->link(kPixName, kPixSourcePad, kDispName, kDispSinkPad)) {
+		disp_ = V4L2Subdevice::fromEntityName(media_.get(), kDispName);
+		dispVideo_ = V4L2VideoDevice::fromEntityName(media_.get(), kDispVideoName);
+		if (disp_->open() || dispVideo_->open()) {
+			disp_.reset();
+			dispVideo_.reset();
+		} else {
+			dispVideo_->bufferReady.connect(this,
+							&PipelineHandlerQcomIfe::dispBufferReady);
+			dispVideo_->queueError.connect(this, &PipelineHandlerQcomIfe::queueError);
+		}
+	}
+
+	video_->bufferReady.connect(this, &PipelineHandlerQcomIfe::imageBufferReady);
+	video_->queueError.connect(this, &PipelineHandlerQcomIfe::queueError);
+	params_->queueError.connect(this, &PipelineHandlerQcomIfe::queueError);
+	stats_->queueError.connect(this, &PipelineHandlerQcomIfe::queueError);
+	params_->bufferReady.connect(this, &PipelineHandlerQcomIfe::paramsBufferReady);
+	stats_->bufferReady.connect(this, &PipelineHandlerQcomIfe::statsBufferReady);
+
+	/* A camera for each sensor on a CSIPHY that reaches CSID 0 */
+	unsigned int cameras = 0;
+	for (MediaEntity *entity : media_->entities()) {
+		if (entity->function() != MEDIA_ENT_F_CAM_SENSOR)
+			continue;
+
+		const MediaPad *source = entity->getPadByIndex(0);
+		if (!source || source->links().empty())
+			continue;
+
+		MediaEntity *csiphy = source->links()[0]->sink()->entity();
+		if (!media_->link(csiphy->name(), kCsiphySourcePad, kCsidName,
+				  kCsidSinkPad))
+			continue;
+
+		if (registerSensorCamera(csiphy, entity))
+			cameras++;
+	}
+
+	return cameras > 0;
+}
+
+REGISTER_PIPELINE_HANDLER(PipelineHandlerQcomIfe, "qcom-ife")
+
