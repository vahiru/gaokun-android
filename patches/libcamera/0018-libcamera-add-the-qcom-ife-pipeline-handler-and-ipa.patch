diff --git a/src/ipa/qcom-ife/algorithms/bf.cpp b/src/ipa/qcom-ife/algorithms/bf.cpp
new file mode 100644
index 00000000..190062b2
--- /dev/null
+++ b/src/ipa/qcom-ife/algorithms/bf.cpp
@@ -0,0 +1,518 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE focus statistics
+ */
+
+#include "bf.h"
+
+#include <algorithm>
+#include <bitset>
+#include <limits>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/value_node.h"
+
+#include "stats.h"
+
+/**
+ * \file bf.h
+ */
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+/**
+ * \class Bf
+ * \brief Focus figure of merit from the IFE focus statistics
+ *
+ * The IFE filters the green pixels of up to 178 regions with two band-pass
+ * filters, horizontal and vertical, and sums the cored filter output of each
+ * region. The algorithm covers a focus window with a grid of equal regions
+ * and reports the sum over the grid as FocusFoM, for a lens controller
+ * outside libcamera.
+ *
+ * The window is the first AfWindows rectangle while AfMetering is
+ * AfMeteringWindows, else the centre of the frame (\a window of its width and
+ * height, 0.7 by default). The grid has up to \a grid regions per side (5 by
+ * default), at least 16 pixels each.
+ *
+ * The filter output follows the signal level linearly (measured on the rear
+ * camera: twice the analogue gain, 2.0 to 2.2 times the sum), so the sum is
+ * divided by the mean green level of the window, from the AWB grid, and by
+ * the window area: the figure stays within about 15% over a fourfold change
+ * of exposure, while defocus divides it by about five.
+ *
+ * The filters default to the ones of the Windows camera driver tunings of
+ * both cameras: two cascaded biquads, b {2926, 0, -2926}, a {28241, -13251}
+ * then b {5120, 0, -5120}, a {18960, -9991} (Q14), output shift 3, coring
+ * threshold 400 and gain 16, coring curve 0 0 0 0 0 0 1 1 2 3 4 5 7 9 11 13 16.
+ * The tuning may replace them with \a h1 and \a v, each with \a iir, \a shift,
+ * \a coringGain, \a coringThreshold and \a coring.
+ *
+ * With two IFEs each stripe measures the regions inside its own input: the
+ * grid is cut at the split, with a gap of a few columns where neither stripe
+ * reaches past its margins, and the right stripe's records come from their
+ * own slot of the statistics buffer.
+ */
+
+LOG_DEFINE_CATEGORY(QcomIfeBf)
+
+namespace {
+
+/* Where regions may lie, from the frame edges (left, top, right, bottom) */
+constexpr int kMarginLeft = 76;
+constexpr int kMarginTop = 36;
+constexpr int kMarginRight = 12;
+constexpr int kMarginBottom = 4;
+
+/* Smallest region side of the grid */
+constexpr unsigned int kMinCell = 16;
+
+/* Regions per row and in all */
+constexpr unsigned int kMaxGrid = 13;
+/*
+ * With two IFEs, one stripe may measure the whole grid: at most
+ * IFE17X_BF_DUAL_LEFT_MAX regions (and IFE17X_BF_DUAL_RIGHT_MAX)
+ */
+constexpr unsigned int kMaxDualGrid = 9;
+
+constexpr uint64_t kSharpnessMask = (1ULL << 40) - 1;
+
+} /* namespace */
+
+int Bf::parseFilter(const ValueNode &data, Filter &filter)
+{
+	if (!data.isDictionary())
+		return 0;
+
+	if (data.contains("iir")) {
+		auto iir = data["iir"].get<std::vector<int16_t>>();
+		if (!iir || iir->size() != filter.iir.size()) {
+			LOG(QcomIfeBf, Error) << "iir needs " << filter.iir.size() << " values";
+			return -EINVAL;
+		}
+		std::copy(iir->begin(), iir->end(), filter.iir.begin());
+	}
+	if (data.contains("coring")) {
+		auto coring = data["coring"].get<std::vector<uint8_t>>();
+		if (!coring || coring->size() != filter.coring.size() ||
+		    std::any_of(coring->begin(), coring->end(),
+				[](uint8_t c) { return c > 31; })) {
+			LOG(QcomIfeBf, Error) << "coring needs " << filter.coring.size()
+					      << " values up to 31";
+			return -EINVAL;
+		}
+		std::copy(coring->begin(), coring->end(), filter.coring.begin());
+	}
+
+	filter.shift = std::min<uint8_t>(data["shift"].get<uint8_t>(filter.shift), 15);
+	filter.coringGain = std::min<uint16_t>(
+		data["coringGain"].get<uint16_t>(filter.coringGain), 1023);
+	filter.coringThreshold = std::min<uint32_t>(
+		data["coringThreshold"].get<uint32_t>(filter.coringThreshold), 0x1ffff);
+
+	return 0;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::init
+ */
+int Bf::init(IPAContext &context, const ValueNode &tuningData)
+{
+	const Filter defaults = {
+		.iir = { 2926, 0, -2926, 28241, -13251, 5120, 0, -5120, 18960, -9991 },
+		.shift = 3,
+		.coringGain = 16,
+		.coringThreshold = 400,
+		.coring = { 0, 0, 0, 0, 0, 0, 1, 1, 2, 3, 4, 5, 7, 9, 11, 13, 16 },
+	};
+
+	h1_ = defaults;
+	v_ = defaults;
+	int ret = parseFilter(tuningData["h1"], h1_);
+	if (!ret)
+		ret = parseFilter(tuningData["v"], v_);
+	if (ret)
+		return ret;
+
+	gridSize_ = std::clamp(tuningData["grid"].get<unsigned int>(gridSize_), 1U, kMaxGrid);
+	defaultWindow_ = std::clamp(tuningData["window"].get<double>(defaultWindow_), 0.1, 1.0);
+
+	context.ctrlMap[&controls::AfMetering] = ControlInfo(controls::AfMeteringValues);
+	context.ctrlMap[&controls::AfWindows] =
+		ControlInfo(Rectangle{}, Rectangle(65535, 65535, 65535, 65535), Rectangle{});
+
+	return 0;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::configure
+ */
+int Bf::configure(IPAContext &context, const IPACameraSensorInfo &configInfo)
+{
+	input_ = configInfo.outputSize;
+	analogCrop_ = configInfo.analogCrop;
+
+	windowsMetering_ = false;
+	requested_ = {};
+	programmed_ = {};
+	rois_.clear();
+
+	dualSplit_ = context.configuration.dualIfe ? context.configuration.dualSplit : 0;
+	dualPad_ = context.configuration.dualIfe ? context.configuration.dualPad : 0;
+	centres_ = gridCentres(input_, dualSplit_);
+
+	/*
+	 * The frame must hold at least one region inside the margins. With two
+	 * IFEs the pipeline must say where the stripes are.
+	 */
+	active_ = (!context.configuration.dualIfe || (dualSplit_ && dualPad_)) &&
+		  input_.width >= kMarginLeft + kMarginRight + 2 * kMinCell &&
+		  input_.height >= kMarginTop + kMarginBottom + 2 * kMinCell;
+	if (!active_) {
+		LOG(QcomIfeBf, Debug) << "No focus statistics for this configuration";
+		return 0;
+	}
+
+	const Size size{
+		static_cast<unsigned int>(input_.width * defaultWindow_),
+		static_cast<unsigned int>(input_.height * defaultWindow_),
+	};
+	defaultRect_ = fit(size.centeredTo(Rectangle(input_).center()));
+
+	return 0;
+}
+
+/*
+ * Bring a window inside the margins, with even edges and room for a region,
+ * keeping its centre where possible.
+ */
+Rectangle Bf::fit(Rectangle window) const
+{
+	const int left = kMarginLeft;
+	const int top = kMarginTop;
+	const int right = static_cast<int>(input_.width) - kMarginRight;
+	const int bottom = static_cast<int>(input_.height) - kMarginBottom;
+
+	if (window.width < kMinCell || window.height < kMinCell) {
+		const Point centre = window.center();
+
+		window = Size(std::max(window.width, kMinCell),
+			      std::max(window.height, kMinCell)).centeredTo(centre);
+	}
+
+	int x0 = std::max(window.x, left);
+	int y0 = std::max(window.y, top);
+	int x1 = std::min(window.x + static_cast<int>(window.width), right);
+	int y1 = std::min(window.y + static_cast<int>(window.height), bottom);
+
+	/* Pushed against an edge: keep the minimum size inside */
+	x1 = std::max(x1, std::min(x0 + static_cast<int>(kMinCell), right));
+	x0 = std::min(x0, x1 - static_cast<int>(kMinCell));
+	y1 = std::max(y1, std::min(y0 + static_cast<int>(kMinCell), bottom));
+	y0 = std::min(y0, y1 - static_cast<int>(kMinCell));
+
+	x0 = (x0 + 1) & ~1;
+	y0 = (y0 + 1) & ~1;
+	x1 &= ~1;
+	y1 &= ~1;
+
+	return Rectangle(x0, y0, x1 - x0, y1 - y0);
+}
+
+/*
+ * Cover a fitted window with a grid of equal regions in row order, which is
+ * the raster order of their ends the hardware wants.
+ *
+ * With two IFEs each stripe measures the regions inside its own input: the
+ * left stripe up to the split, the right stripe from its first column inside
+ * the margins. A window across the split is cut into a left and a right part
+ * with a gap of a few columns between them, and the columns go to the parts
+ * by their widths. The left part's regions come first, each part in row
+ * order.
+ */
+Bf::Grid Bf::grid(const Rectangle &window) const
+{
+	const unsigned int n = std::clamp(std::min(window.width, window.height) / kMinCell,
+					  1U, dualSplit_ ? std::min(gridSize_, kMaxDualGrid)
+							 : gridSize_);
+	const unsigned int ch = std::min((window.height / n) & ~1U, (input_.height / 2) & ~1U);
+	const int y = (window.y + static_cast<int>(window.height - n * ch) / 2) & ~1;
+	const int x0 = window.x;
+	const int x1 = window.x + static_cast<int>(window.width);
+	Grid g;
+
+	/* Add the regions of the columns [a, b), centred */
+	const auto add = [&](int a, int b, unsigned int columns) {
+		const unsigned int cw = std::min((static_cast<unsigned int>(b - a) / columns) & ~1U,
+						 (input_.width / 2) & ~1U);
+		const int x = (a + static_cast<int>(b - a - columns * cw) / 2) & ~1;
+
+		for (unsigned int r = 0; r < n; r++) {
+			for (unsigned int c = 0; c < columns; c++) {
+				g.rois.push_back({
+					.left = static_cast<uint16_t>(x + c * cw),
+					.top = static_cast<uint16_t>(y + r * ch),
+					.width = static_cast<uint16_t>(cw),
+					.height = static_cast<uint16_t>(ch),
+				});
+			}
+		}
+	};
+
+	if (!dualSplit_) {
+		add(x0, x1, n);
+		return g;
+	}
+
+	const int splitLeft = dualSplit_;
+	const int splitRight = dualSplit_ - dualPad_ + kMarginLeft;
+	int wl = std::max(0, std::min(x1, splitLeft) - x0);
+	int wr = std::max(0, x1 - std::max(x0, splitRight));
+
+	/* A part too narrow for a region goes; a window in the gap moves right */
+	if (wl < static_cast<int>(kMinCell))
+		wl = 0;
+	if (wr < static_cast<int>(kMinCell))
+		wr = 0;
+	if (!wl && !wr)
+		wr = kMinCell;
+
+	const int leftEnd = x0 + wl;
+	const int rightStart = wl && x1 > splitRight ? splitRight
+						      : std::max(x0, splitRight);
+
+	unsigned int nl = 0;
+	if (wl && wr && n > 1)
+		nl = std::clamp<unsigned int>(std::lround(static_cast<double>(n) * wl / (wl + wr)),
+					      1, n - 1);
+	else if (wl && (!wr || wl >= wr))
+		nl = n;
+
+	/*
+	 * The regions of a part end apart from each other in raster order:
+	 * with one column, the regions of consecutive rows end on the same
+	 * column, which the driver refuses. A part of several rows takes two
+	 * columns or none: with fewer than four columns in all, the wider
+	 * part takes them all.
+	 */
+	if (n > 1 && nl && nl < n && (nl == 1 || n - nl == 1)) {
+		if (n >= 4)
+			nl = std::clamp(nl, 2U, n - 2);
+		else
+			nl = wl >= wr ? n : 0;
+	}
+
+	if (nl) {
+		add(x0, leftEnd, nl);
+		g.numLeft = g.rois.size();
+	}
+	if (nl < n)
+		add(rightStart, rightStart + wr, n - nl);
+
+	return g;
+}
+
+/* The slot of the statistics buffer that holds the record of region @i */
+unsigned int Bf::slot(const Grid &grid, unsigned int i) const
+{
+	if (dualSplit_ && i >= grid.numLeft)
+		return IFE17X_BF_DUAL_RIGHT + (i - grid.numLeft);
+
+	return i;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::queueRequest
+ */
+void Bf::queueRequest([[maybe_unused]] IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      IPAFrameContext &frameContext, const ControlList &controls)
+{
+	if (const auto &metering = controls.get(controls::AfMetering))
+		windowsMetering_ = *metering == controls::AfMeteringWindows;
+
+	if (const auto &windows = controls.get(controls::AfWindows)) {
+		requested_ = {};
+		for (const Rectangle &w : *windows) {
+			/* A window without width or without height is no window */
+			if (w.width && w.height) {
+				requested_ = w;
+				break;
+			}
+		}
+	}
+
+	frameContext.bf.window = {};
+	if (!active_)
+		return;
+
+	frameContext.bf.window = defaultRect_;
+	if (windowsMetering_ && !requested_.isNull() && !analogCrop_.isNull()) {
+		/* Pixel array coordinates to IFE input pixels */
+		Rectangle w = requested_.transformedBetween(analogCrop_, Rectangle(input_))
+				      .boundedTo(Rectangle(input_));
+		/* Outside the frame on either axis: no window */
+		if (w.width && w.height)
+			frameContext.bf.window = fit(w);
+	}
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::prepare
+ */
+void Bf::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		 IPAFrameContext &frameContext, QcomIfeParams *params)
+{
+	const Rectangle &window = frameContext.bf.window;
+
+	/* The hardware keeps the configuration until it changes or resets */
+	if (!active_ || window.isNull() ||
+	    (window == programmed_ && !context.activeState.initialParams))
+		return;
+
+	const Grid g = grid(window);
+	rois_ = g.rois;
+
+	auto block = params->block<QcomIfeBlocks::Bf>();
+	block.setEnabled(true);
+
+	block->num_rois = rois_.size();
+	block->num_left = g.numLeft;
+	block->green = 0;
+	block->gamma_enable = 1;
+	for (unsigned int i = 0; i < IFE17X_BF_GAMMA_POINTS; i++)
+		block->gamma[i] = i * 0x200;
+
+	auto fill = [](ife17x_bf_filter &dst, const Filter &src) {
+		std::copy(src.iir.begin(), src.iir.end(), dst.iir);
+		dst.shift = src.shift;
+		dst.coring_gain = src.coringGain;
+		dst.coring_threshold = src.coringThreshold;
+		std::copy(src.coring.begin(), src.coring.end(), dst.coring);
+	};
+	fill(block->h1, h1_);
+	fill(block->v, v_);
+	std::copy(rois_.begin(), rois_.end(), block->rois);
+
+	programmed_ = window;
+
+	LOG(QcomIfeBf, Debug)
+		<< "Window " << window << ": " << rois_.size() << " regions of "
+		<< rois_[0].width << "x" << rois_[0].height;
+}
+
+/*
+ * Mean green level of the AWB grid regions centred in a window. With two IFEs
+ * the counts are those of one stripe's regions, the same size in both.
+ */
+std::optional<double> Bf::greenMean(const ife17x_stats_buffer *stats,
+				    const Rectangle &window) const
+{
+	using Channel = GridStatistics::Channel;
+
+	const Point centre = window.center();
+	uint64_t sum = 0, count = 0;
+	unsigned int nearest = 0;
+	uint64_t nearestDist = std::numeric_limits<uint64_t>::max();
+
+	for (unsigned int i = 0; i < centres_.size(); i++) {
+		const ife17x_awb_bg_region &region = stats->awb_bg[i];
+		const int cx = centres_[i].x;
+		const int cy = centres_[i].y;
+		const int64_t dx = cx - centre.x;
+		const int64_t dy = cy - centre.y;
+		const uint64_t dist = dx * dx + dy * dy;
+
+		if (dist < nearestDist) {
+			nearestDist = dist;
+			nearest = i;
+		}
+		if (cx < window.x || cy < window.y ||
+		    cx >= window.x + static_cast<int>(window.width) ||
+		    cy >= window.y + static_cast<int>(window.height))
+			continue;
+
+		sum += static_cast<uint64_t>(region.sum[Channel::GreenRed]) +
+		       region.sum[Channel::GreenBlue];
+		count += static_cast<uint64_t>(region.count[Channel::GreenRed]) +
+			 region.count[Channel::GreenBlue];
+	}
+
+	/* A window smaller than a grid region */
+	if (!count) {
+		const ife17x_awb_bg_region &region = stats->awb_bg[nearest];
+
+		sum = static_cast<uint64_t>(region.sum[Channel::GreenRed]) +
+		      region.sum[Channel::GreenBlue];
+		count = static_cast<uint64_t>(region.count[Channel::GreenRed]) +
+			region.count[Channel::GreenBlue];
+	}
+
+	if (!count || !sum)
+		return std::nullopt;
+
+	return static_cast<double>(sum) / count;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::process
+ */
+void Bf::process([[maybe_unused]] IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 IPAFrameContext &frameContext, const ife17x_stats_buffer *stats,
+		 ControlList &metadata)
+{
+	const Rectangle &window = frameContext.bf.window;
+
+	if (!active_ || !stats || window.isNull())
+		return;
+
+	/* The records of the frame's regions, in an order of their own */
+	const Grid g = grid(window);
+	const std::vector<ife17x_bf_roi> &rois = g.rois;
+	std::bitset<IFE17X_BF_MAX_ROIS> seen;
+	uint64_t sharpness = 0;
+
+	for (unsigned int i = 0; i < rois.size(); i++) {
+		const ife17x_bf_record &record = stats->bf[slot(g, i)];
+		const unsigned int index = (record.w[1] >> 54) & 0xff;
+
+		if (index >= rois.size() || seen[index]) {
+			LOG(QcomIfeBf, Debug) << "Frame " << frame
+					      << ": unexpected focus record " << i;
+			return;
+		}
+		seen.set(index);
+		sharpness += (record.w[1] & kSharpnessMask) + (record.w[3] & kSharpnessMask);
+	}
+
+	const Rectangle covered(rois.front().left, rois.front().top,
+				rois.back().left + rois.back().width - rois.front().left,
+				rois.back().top + rois.back().height - rois.front().top);
+	const std::optional<double> green = greenMean(stats, covered);
+	if (!green || *green < 1.0)
+		return;
+
+	const double area = static_cast<double>(covered.width) * covered.height;
+	const double fom = 1000.0 * sharpness / (*green * area);
+	const int32_t value = static_cast<int32_t>(
+		std::min(fom, static_cast<double>(std::numeric_limits<int32_t>::max())));
+
+	metadata.set(controls::FocusFoM, value);
+
+	LOG(QcomIfeBf, Debug) << "Frame " << frame << ": sharpness " << sharpness
+			      << ", green " << *green << ", FoM " << value;
+}
+
+REGISTER_IPA_ALGORITHM(Bf, "Bf")
+
+} /* namespace ipa::qcom_ife::algorithms */
+
+} /* namespace libcamera */
