+#define QCOM_IFE_DEFINE_BLOCK_TYPE(id, cfgType, blkType)			\
+template<>								\
+struct block_type<QcomIfeBlocks::id> {					\
+	using type = struct ife17x_params_##cfgType;			\
+	static constexpr ife17x_params_block_type blockType =		\
+		ife17x_params_block_type::IFE17X_PARAMS_BLOCK_##blkType;\
+}
+
+QCOM_IFE_DEFINE_BLOCK_TYPE(Bls,		bls,		BLS);
+QCOM_IFE_DEFINE_BLOCK_TYPE(Wb,		wb,		WB);
+QCOM_IFE_DEFINE_BLOCK_TYPE(Ccm,		ccm,		CCM);
+QCOM_IFE_DEFINE_BLOCK_TYPE(Gamma,	gamma,		GAMMA);
+QCOM_IFE_DEFINE_BLOCK_TYPE(AwbBg,	awb_bg,		AWB_BG);
+QCOM_IFE_DEFINE_BLOCK_TYPE(Pdpc,	pdpc,		PDPC);
+QCOM_IFE_DEFINE_BLOCK_TYPE(Bf,		bf,		BF);
+QCOM_IFE_DEFINE_BLOCK_TYPE(Abf,		abf,		ABF);
+QCOM_IFE_DEFINE_BLOCK_TYPE(Bpc,		bpc,		BPC);
+QCOM_IFE_DEFINE_BLOCK_TYPE(Lsc,		lsc,		LSC);
+QCOM_IFE_DEFINE_BLOCK_TYPE(Bhist,	bhist,		BHIST);
