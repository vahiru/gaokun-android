new file mode 100644
index 00000000..fb58bb68
--- /dev/null
+++ b/src/ipa/qcom-ife/algorithms/abf.cpp
@@ -0,0 +1,247 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE adaptive Bayer filter
+ */
+
+#include "abf.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/value_node.h"
+
+/**
+ * \file abf.h
+ */
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+/**
+ * \class Abf
+ * \brief Qualcomm IFE adaptive Bayer filter
+ *
+ * The adaptive Bayer filter (ABF34) smooths the Bayer data by the expected
+ * noise of each pixel level. It takes the inverse of the noise standard
+ * deviation at 65 levels, scaled by an edge softness factor; stronger noise
+ * gives smaller values and a stronger filter.
+ *
+ * The tuning data gives the noise tables by analogue gain, in \a regions: a
+ * \a gain range and the 65 standard deviations of the \a noise table. Like the
+ * Windows driver, a gain inside a region (or below the first) takes that
+ * region's table, a gain between two regions blends their tables linearly,
+ * and a gain above the last region takes the last one. \a edgeSoftness
+ * defaults to 3.0.
+ *
+ * The other parameters are the values the Windows driver's tuning sets for
+ * both of the camera modules of this device, the radial adjustment flat. Only
+ * the noise table changes with the gain; the block is written when it does.
+ */
+
+LOG_DEFINE_CATEGORY(QcomIfeAbf)
+
+namespace {
+
+/* The Windows driver's values for both camera modules */
+constexpr uint8_t kDistanceKernel[3] = { 3, 2, 1 };
+constexpr uint8_t kBpcFmax = 16;
+constexpr uint8_t kBpcFmin = 16;
+constexpr uint8_t kBpcShift = 3;
+constexpr uint16_t kBpcOffset = 64;
+constexpr unsigned int kNoisePreserveAnchor = 160;
+constexpr unsigned int kNoisePreserveEnd = 224;
+constexpr double kNoisePreserve = 0.6;
+/* Radial segment starts, as fractions of the distance to the frame corner */
+constexpr double kRadialAnchors[4] = { 0.0, 0.4, 0.6, 0.8 };
+
+constexpr uint16_t kNodeMax = 511;
+
+} /* namespace */
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::init
+ */
+int Abf::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	edgeSoftness_ = tuningData["edgeSoftness"].get<double>(3.0);
+	if (!(edgeSoftness_ > 0.0)) {
+		LOG(QcomIfeAbf, Error) << "Invalid edge softness";
+		return -EINVAL;
+	}
+
+	for (const ValueNode &r : tuningData["regions"].asList()) {
+		auto gain = r["gain"].get<std::vector<double>>();
+		auto noise = r["noise"].get<std::vector<double>>();
+		Region region;
+
+		if (!gain || gain->size() != 2 || (*gain)[0] > (*gain)[1] ||
+		    (!regions_.empty() && (*gain)[0] <= regions_.back().gainEnd)) {
+			LOG(QcomIfeAbf, Error)
+				<< "Each region needs a gain range above the one before";
+			return -EINVAL;
+		}
+		if (!noise || noise->size() != region.stddev.size()) {
+			LOG(QcomIfeAbf, Error)
+				<< "Each region needs " << region.stddev.size()
+				<< " noise values";
+			return -EINVAL;
+		}
+
+		region.gainStart = (*gain)[0];
+		region.gainEnd = (*gain)[1];
+		std::copy(noise->begin(), noise->end(), region.stddev.begin());
+		regions_.push_back(region);
+	}
+
+	if (regions_.empty()) {
+		LOG(QcomIfeAbf, Error) << "No noise regions";
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::configure
+ */
+int Abf::configure(IPAContext &context, const IPACameraSensorInfo &configInfo)
+{
+	/* The level still in the data, in the 14 bit units of the pipeline */
+	blackLevel_ = std::min<unsigned int>(
+		context.configuration.blc.level.value_or(0) >> 2, 4095);
+
+	/*
+	 * Distances from the frame centre: the frame's top left corner and the
+	 * shift that brings the corners' squared distance to 12 bits.
+	 */
+	const Size &size = configInfo.outputSize;
+	radialX_ = -static_cast<int16_t>(size.width / 2);
+	radialY_ = -static_cast<int16_t>(size.height / 2);
+
+	const uint64_t r2 = static_cast<uint64_t>(radialX_ * radialX_) +
+			    static_cast<uint64_t>(radialY_ * radialY_);
+	r2Shift_ = 0;
+	while (r2Shift_ < 15 && r2 > (4096ULL << r2Shift_))
+		r2Shift_++;
+
+	appliedValid_ = false;
+
+	return 0;
+}
+
+/*
+ * The inverse noise levels for a gain, as the Windows driver computes them:
+ * 8192 / (standard deviation * edge softness), at most 511.
+ */
+Abf::Nodes Abf::noiseNodes(double gain) const
+{
+	const Region *lo = &regions_.back();
+	const Region *hi = nullptr;
+	double ratio = 0.0;
+
+	for (unsigned int i = 0; i < regions_.size(); i++) {
+		const Region &r = regions_[i];
+
+		if (gain <= r.gainEnd) {
+			lo = &r;
+			break;
+		}
+		if (i + 1 < regions_.size() && gain < regions_[i + 1].gainStart) {
+			lo = &r;
+			hi = &regions_[i + 1];
+			ratio = (gain - r.gainEnd) / (hi->gainStart - r.gainEnd);
+			break;
+		}
+	}
+
+	Nodes nodes;
+	uint16_t previous = kNodeMax;
+
+	for (unsigned int i = 0; i < nodes.size(); i++) {
+		double stddev = lo->stddev[i];
+		if (hi)
+			stddev += ratio * (hi->stddev[i] - stddev);
+
+		const double p = std::clamp(stddev, 0.0, 511.0) * edgeSoftness_;
+		const double inverse = p > 0.0 ? 8192.0 / p : 8192.0;
+		uint16_t node = static_cast<uint16_t>(
+			std::min<double>(std::lround(inverse), kNodeMax));
+
+		/* The LUT holds the steps down to the next node only */
+		node = std::min(node, previous);
+		nodes[i] = node;
+		previous = node;
+	}
+
+	return nodes;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::prepare
+ */
+void Abf::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext, QcomIfeParams *params)
+{
+	const Nodes nodes = noiseNodes(frameContext.agc.gain);
+
+	if (!context.activeState.initialParams && appliedValid_ && nodes == applied_)
+		return;
+
+	auto block = params->block<QcomIfeBlocks::Abf>();
+	block.setEnabled(true);
+
+	std::copy(nodes.begin(), nodes.end(), block->noise);
+	block->flags = IFE17X_ABF_FL_FILTER | IFE17X_ABF_FL_RADIAL | IFE17X_ABF_FL_BPC;
+
+	for (unsigned int c = 0; c < 2; c++)
+		std::copy(std::begin(kDistanceKernel), std::end(kDistanceKernel),
+			  block->distance_ker[c]);
+
+	block->bpc_fmax = kBpcFmax;
+	block->bpc_fmin = kBpcFmin;
+	block->bpc_max_shift = kBpcShift;
+	block->bpc_min_shift = kBpcShift;
+	block->bpc_offset = kBpcOffset;
+	block->black_level = blackLevel_;
+
+	/* A flat noise preservation ramp: zero slope, the shift of the driver */
+	block->noise_prsv_anchor = kNoisePreserveAnchor;
+	block->noise_prsv_gap = kNoisePreserveEnd - kNoisePreserveAnchor;
+	for (unsigned int c = 0; c < 2; c++) {
+		block->noise_prsv_lo[c] = std::lround(kNoisePreserve * 256);
+		block->noise_prsv_slope[c] = 0;
+		block->noise_prsv_shift[c] = 10;
+	}
+
+	/* A flat radial adjustment: full value and no slope in every segment */
+	for (unsigned int i = 0; i < 4; i++) {
+		const double a = kRadialAnchors[i];
+		block->radial_anchor[i] = static_cast<uint16_t>(a * a * 4095);
+		for (unsigned int c = 0; c < 2; c++) {
+			block->radial_gain[c][i] = 255;
+			block->radial_slope[c][i] = 0;
+			block->radial_shift[c][i] = 0;
+		}
+	}
+	block->radial_x = radialX_;
+	block->radial_y = radialY_;
+	block->radial_r2_shift = r2Shift_;
+
+	applied_ = nodes;
+	appliedValid_ = true;
+
+	LOG(QcomIfeAbf, Debug)
+		<< "Gain " << frameContext.agc.gain << ": noise nodes "
+		<< nodes[1] << ", " << nodes[16] << ", " << nodes[64];
+}
+
+REGISTER_IPA_ALGORITHM(Abf, "Abf")
+
+} /* namespace ipa::qcom_ife::algorithms */
+
+} /* namespace libcamera */
