@@ -0,0 +1,223 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2024, Ideas On Board Oy
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE auto white balance algorithm
+ */
+
+#include "awb.h"
+
+#include <array>
+#include <stdint.h>
+
+#include <libcamera/base/log.h>
+#include <libcamera/base/utils.h>
+
+#include <libcamera/control_ids.h>
+
+#include "stats.h"
+
+/**
+ * \file awb.h
+ */
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+/**
+ * \class Awb
+ * \brief Qualcomm IFE auto white balance algorithm
+ *
+ * The algorithm feeds the libipa AWB algorithms with the mean red, green and
+ * blue values of the AWB Bayer grid. The grid is taken after the black level
+ * subtraction and before the white balance gains, so the means need no
+ * correction for the gains in use.
+ *
+ * Regions with pixels above the grid thresholds are left out: those pixels
+ * are missing from the sums of their channel only, which shifts the colour of
+ * the region. Dark regions, where noise and black level errors dominate, are
+ * left out too.
+ */
+
+LOG_DEFINE_CATEGORY(QcomIfeAwb)
+
+/* \todo The IPA has no Lux algorithm. */
+static constexpr unsigned int kDefaultLux = 500;
+
+/* Regions with a green mean below this level, in 14 bit units, are too dark */
+static constexpr unsigned int kMinGreenLevel = 256;
+
+/* Fewest regions the means may come from */
+static constexpr unsigned int kMinRegions = kGridWidth * kGridHeight / 32;
+
+class QcomIfeAwbStats final : public AwbStats
+{
+public:
+	QcomIfeAwbStats() = default;
+	QcomIfeAwbStats(const RGB<double> &rgbMeans)
+		: rgbMeans_(rgbMeans), valid_(true)
+	{
+		rg_ = rgbMeans_.r() / rgbMeans_.g();
+		bg_ = rgbMeans_.b() / rgbMeans_.g();
+	}
+
+	double computeColourError(const RGB<double> &gains) const override
+	{
+		/*
+		 * Compute the sum of the squared colour error (non-greyness) as
+		 * it appears in the log likelihood equation.
+		 */
+		double deltaR = gains.r() * rg_ - 1.0;
+		double deltaB = gains.b() * bg_ - 1.0;
+		double delta2 = deltaR * deltaR + deltaB * deltaB;
+
+		return delta2;
+	}
+
+	RGB<double> rgbMeans() const override
+	{
+		return rgbMeans_;
+	}
+
+	bool valid() const override
+	{
+		return valid_;
+	}
+
+private:
+	RGB<double> rgbMeans_;
+	double rg_ = 0.0;
+	double bg_ = 0.0;
+	bool valid_ = false;
+};
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::init
+ */
+int Awb::init(IPAContext &context, const ValueNode &tuningData)
+{
+	return awbAlgo_.init(tuningData, context.ctrlMap);
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::configure
+ */
+int Awb::configure(IPAContext &context,
+		   [[maybe_unused]] const IPACameraSensorInfo &configInfo)
+{
+	return awbAlgo_.configure(context.activeState.awb);
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::queueRequest
+ */
+void Awb::queueRequest(IPAContext &context,
+		       const uint32_t frame,
+		       IPAFrameContext &frameContext,
+		       const ControlList &controls)
+{
+	awbAlgo_.queueRequest(context.activeState.awb, frame, frameContext.awb,
+			      controls);
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::prepare
+ */
+void Awb::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext, QcomIfeParams *params)
+{
+	awbAlgo_.prepare(context.activeState.awb, frameContext.awb);
+
+	/*
+	 * The gains apply to the red, green and blue channels whatever the
+	 * Bayer order, after the grid statistics are taken.
+	 */
+	auto block = params->block<QcomIfeBlocks::Wb>();
+	block.setEnabled(true);
+
+	const RGB<double> &gains = frameContext.awb.gains;
+	block->gain[0] = UQ<5, 7>(static_cast<float>(gains.r())).quantized();
+	block->gain[1] = UQ<5, 7>(static_cast<float>(gains.g())).quantized();
+	block->gain[2] = UQ<5, 7>(static_cast<float>(gains.b())).quantized();
+
+	if (context.activeState.initialParams)
+		fillGridConfig(params);
+}
+
+QcomIfeAwbStats Awb::calculateRgbMeans(const ife17x_stats_buffer *stats, bool dualIfe) const
+{
+	using Channel = GridStatistics::Channel;
+
+	GridStatistics grid(stats, dualIfe);
+	if (grid.empty())
+		return {};
+
+	std::array<uint64_t, GridStatistics::NumChannels> sums{};
+	std::array<uint64_t, GridStatistics::NumChannels> counts{};
+	unsigned int regions = 0;
+
+	for (const ife17x_awb_bg_region &region : grid.regions()) {
+		bool complete = true;
+		for (unsigned int c = 0; c < GridStatistics::NumChannels; c++) {
+			if (region.count[c] < grid.pixels(region, static_cast<Channel>(c)))
+				complete = false;
+		}
+		if (!complete)
+			continue;
+
+		const uint64_t greenSum = static_cast<uint64_t>(region.sum[Channel::GreenRed]) +
+					  region.sum[Channel::GreenBlue];
+		const uint64_t greenCount = region.count[Channel::GreenRed] +
+					    region.count[Channel::GreenBlue];
+		if (greenSum < kMinGreenLevel * greenCount)
+			continue;
+
+		for (unsigned int c = 0; c < GridStatistics::NumChannels; c++) {
+			sums[c] += region.sum[c];
+			counts[c] += region.count[c];
+		}
+
+		regions++;
+	}
+
+	if (regions < kMinRegions) {
+		LOG(QcomIfeAwb, Debug)
+			<< "Only " << regions << " usable regions, skipping";
+		return {};
+	}
+
+	RGB<double> rgbMeans{ {
+		static_cast<double>(sums[Channel::Red]) / counts[Channel::Red],
+		static_cast<double>(sums[Channel::GreenRed] + sums[Channel::GreenBlue]) /
+			(counts[Channel::GreenRed] + counts[Channel::GreenBlue]),
+		static_cast<double>(sums[Channel::Blue]) / counts[Channel::Blue],
+	} };
+
+	return QcomIfeAwbStats(rgbMeans);
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::process
+ */
+void Awb::process(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext, const ife17x_stats_buffer *stats,
+		  ControlList &metadata)
+{
+	if (!stats) {
+		LOG(QcomIfeAwb, Error) << "No statistics buffer passed to Awb";
+		return;
+	}
+
+	QcomIfeAwbStats awbStats = calculateRgbMeans(stats, context.configuration.dualIfe);
+
+	awbAlgo_.process(context.activeState.awb, frameContext.awb, awbStats,
+			 kDefaultLux, metadata);
+}
+
+REGISTER_IPA_ALGORITHM(Awb, "Awb")
+
+} /* namespace ipa::qcom_ife::algorithms */
+
+} /* namespace libcamera */
