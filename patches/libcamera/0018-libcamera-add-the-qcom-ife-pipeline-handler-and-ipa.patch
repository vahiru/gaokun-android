new file mode 100644
index 00000000..b280d09a
--- /dev/null
+++ b/src/ipa/qcom-ife/algorithms/blc.cpp
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2024, Ideas On Board
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE black level subtraction
+ */
+
+#include "blc.h"
+
+#include <algorithm>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/value_node.h"
+
+/**
+ * \file blc.h
+ */
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+/**
+ * \class BlackLevel
+ * \brief Qualcomm IFE black level subtraction
+ *
+ * The black level comes from the \a blackLevel key of the tuning data, in 16
+ * bit units, or else from the camera sensor helper. The hardware subtracts a
+ * single level from all channels, in the units of its 14 bit pipeline, and
+ * scales the remaining range back to full scale. Without a known level the
+ * block is not written and the driver default stays.
+ */
+
+LOG_DEFINE_CATEGORY(QcomIfeBlc)
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::init
+ */
+int BlackLevel::init([[maybe_unused]] IPAContext &context,
+		     const ValueNode &tuningData)
+{
+	if (tuningData.contains("blackLevel")) {
+		tuningLevel_ = tuningData["blackLevel"].get<uint16_t>();
+		if (!tuningLevel_) {
+			LOG(QcomIfeBlc, Error) << "Invalid black level";
+			return -EINVAL;
+		}
+
+		LOG(QcomIfeBlc, Debug) << "Black level: " << *tuningLevel_;
+	}
+
+	return 0;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::configure
+ */
+int BlackLevel::configure(IPAContext &context,
+			  [[maybe_unused]] const IPACameraSensorInfo &configInfo)
+{
+	level_ = tuningLevel_;
+	if (!level_ && context.configuration.sensor.blackLevel)
+		level_ = *context.configuration.sensor.blackLevel;
+
+	if (!level_)
+		LOG(QcomIfeBlc, Warning)
+			<< "No black level, keeping the driver default";
+
+	context.configuration.blc.level = level_;
+
+	return 0;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::prepare
+ */
+void BlackLevel::prepare(IPAContext &context,
+			 [[maybe_unused]] const uint32_t frame,
+			 [[maybe_unused]] IPAFrameContext &frameContext,
+			 QcomIfeParams *params)
+{
+	if (!context.activeState.initialParams || !level_)
+		return;
+
+	auto block = params->block<QcomIfeBlocks::Bls>();
+	block.setEnabled(true);
+
+	/* From 16 bit to the 14 bit units of the pipeline, at most 8191 */
+	block->offset = std::min<uint32_t>(*level_ >> 2, 8191);
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::process
+ */
+void BlackLevel::process([[maybe_unused]] IPAContext &context,
+			 [[maybe_unused]] const uint32_t frame,
+			 [[maybe_unused]] IPAFrameContext &frameContext,
+			 [[maybe_unused]] const ife17x_stats_buffer *stats,
+			 ControlList &metadata)
+{
+	if (!level_)
+		return;
+
+	/* The same level applies to the R, Gr, Gb and B channels. */
+	const int32_t level = *level_;
+	metadata.set(controls::SensorBlackLevels, { level, level, level, level });
+}
+
+REGISTER_IPA_ALGORITHM(BlackLevel, "BlackLevel")
+
+} /* namespace ipa::qcom_ife::algorithms */
+
+} /* namespace libcamera */
