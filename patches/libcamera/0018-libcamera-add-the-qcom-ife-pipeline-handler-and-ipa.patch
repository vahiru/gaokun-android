+ * Qualcomm IFE (Titan 17x) AWB Bayer grid statistics
+ */
+
+#pragma once
+
+#include <array>
+#include <span>
+#include <stdint.h>
+#include <vector>
+
+#include <libcamera/geometry.h>
+
+#include <linux/media/qcom/ife17x-config.h>
+
+#include "params.h"
+
+namespace libcamera {
+
+namespace ipa::qcom_ife {
+
+/* Regions of the AWB Bayer grid, per row and per column */
+constexpr unsigned int kGridWidth = 64;
+/* Dual IFE splits the grid columns in two equal halves */
+static_assert(kGridWidth % 2 == 0);
+constexpr unsigned int kGridHeight = 48;
+
+/* Full scale of the 14 bit pipeline */
+constexpr double kPixelMax = 16383.0;
+
+/*
+ * Pixels above this level, in 14 bit units, are left out of the sums and
+ * counts of the grid. It sits a little below full scale so that pixels close
+ * to saturation, whose colour is no longer reliable, are left out too.
+ */
+constexpr uint16_t kGridThreshold = 0x3bff;
+
+void fillGridConfig(QcomIfeParams *params);
+
+std::vector<Point> gridCentres(const Size &input, unsigned int dualSplit);
+
+class GridStatistics
+{
+public:
+	/* Channels of a grid record, in the order of the hardware */
+	enum Channel : unsigned int {
+		Red = 0,
+		Blue = 1,
+		GreenRed = 2,
+		GreenBlue = 3,
+		NumChannels = 4,
+	};
+
+	GridStatistics(const ife17x_stats_buffer *stats, bool dualIfe);
+
+	std::span<const ife17x_awb_bg_region> regions() const { return regions_; }
+	unsigned int pixels(const ife17x_awb_bg_region &region, Channel channel) const
+	{
+		return pixels_[half(region)][channel];
+	}
+	bool empty() const { return empty_; }
+
+private:
+	std::span<const ife17x_awb_bg_region> regions_;
+	/* Which stripe's grid a region is in, with dual IFE; else 0 */
+	unsigned int half(const ife17x_awb_bg_region &region) const
+	{
+		return dualIfe_ &&
+		       static_cast<std::size_t>(&region - regions_.data()) >= regions_.size() / 2;
+	}
+
+	bool dualIfe_;
+
+	std::array<std::array<unsigned int, NumChannels>, 2> pixels_;
+	bool empty_;
+};
+
+} /* namespace ipa::qcom_ife */
+
+} /* namespace libcamera */
