+ *
+ * Qualcomm IFE AGC/AEC mean-based control algorithm
+ */
+
+#pragma once
+
+#include <vector>
+
+#include "libcamera/internal/vector.h"
+
+#include "libipa/agc.h"
+#include "libipa/histogram.h"
+
+#include "algorithm.h"
+#include "ipa_context.h"
+#include "stats.h"
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+class Agc : public Algorithm
+{
+public:
+	Agc() = default;
+	~Agc() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPACameraSensorInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void prepare(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     QcomIfeParams *params) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const ife17x_stats_buffer *stats,
+		     ControlList &metadata) override;
+
+private:
+	void parseStatistics(const GridStatistics &grid,
+			     const RGB<double> &wbGains, const Rectangle &window);
+	bool parseHistogram(const ife17x_stats_buffer *stats, const RGB<double> &wbGains,
+			    const Rectangle &window, bool dualIfe, unsigned int dualSplit);
+
+	AgcAlgorithm agc_;
+
+	/* Metering: the share of the frame the default window takes, and the
+	 * weight of the regions outside the window in the mean luminance */
+	double windowSize_ = 0.7;
+	double outsideWeight_ = 0.25;
+	/* The Bayer histogram for the constraints, and the channel it counts */
+	bool bayerHistogram_ = true;
+	unsigned int histogramChannel_ = IFE17X_BHIST_CHANNEL_GR;
+
+	Size input_;
+	Rectangle analogCrop_;
+	Rectangle defaultWindow_;
+	/* Centre of each grid region in pixels of the IFE input */
+	std::vector<Point> centres_;
+
+	bool windowsMetering_ = false;
+	Rectangle requested_;
+
+	/* Mean of each grid region after the white balance, in 0..1 */
+	std::vector<RGB<double>> means_;
+	/* Weight of each grid region in the mean luminance */
+	std::vector<double> weights_;
+	/* Luminance histogram of the pixels of the metering window */
+	Histogram yHist_;
+};
+
+} /* namespace ipa::qcom_ife::algorithms */
+
+} /* namespace libcamera */
