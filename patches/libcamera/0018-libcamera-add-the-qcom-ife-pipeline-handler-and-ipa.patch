+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE lens shading correction
+ */
+
+#pragma once
+
+#include <array>
+#include <stdint.h>
+#include <vector>
+
+#include <libcamera/geometry.h>
+
+#include "algorithm.h"
+#include "params.h"
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+class Lsc : public Algorithm
+{
+public:
+	Lsc() = default;
+	~Lsc() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPACameraSensorInfo &configInfo) override;
+	void prepare(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     QcomIfeParams *params) override;
+
+private:
+	/* The calibration grid over the full sensor */
+	static constexpr unsigned int kCols = 17;
+	static constexpr unsigned int kRows = 13;
+	static constexpr unsigned int kNodes = kCols * kRows;
+
+	using Table = std::array<std::array<double, kNodes>, 4>;
+	using Gains = std::array<std::array<uint16_t, IFE17X_LSC_MAX_NODES>, 4>;
+
+	struct Set {
+		double ctStart;
+		double ctEnd;
+		Table table;
+	};
+
+	struct Region {
+		double gainStart;
+		double gainEnd;
+		std::vector<Set> sets;
+	};
+
+	/* Where a hardware grid node falls in the extended calibration grid */
+	struct Tap {
+		unsigned int index;
+		double tx;
+		double ty;
+		bool border;
+	};
+
+	Table tableFor(const Region &region, double ct) const;
+	Table interpolate(double gain, double ct) const;
+	Gains resample(const Table &table) const;
+
+	std::vector<Region> regions_;
+	Size fullSize_;
+
+	bool active_ = false;
+	unsigned int hBlocks_;
+	unsigned int vBlocks_;
+	unsigned int subgridShift_;
+	unsigned int blockWidth_;
+	unsigned int blockHeight_;
+	unsigned int startX_;
+	unsigned int startY_;
+	std::vector<Tap> taps_;
+
+	double appliedGain_;
+	double appliedCt_;
+	Gains applied_;
+	bool appliedValid_ = false;
+};
+
+} /* namespace ipa::qcom_ife::algorithms */
+
+} /* namespace libcamera */
