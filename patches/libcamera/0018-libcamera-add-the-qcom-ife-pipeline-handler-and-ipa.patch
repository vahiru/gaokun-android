diff --git a/src/ipa/qcom-ife/algorithms/ccm.cpp b/src/ipa/qcom-ife/algorithms/ccm.cpp
new file mode 100644
index 00000000..fc616966
--- /dev/null
+++ b/src/ipa/qcom-ife/algorithms/ccm.cpp
@@ -0,0 +1,130 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Ideas On Board
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE Color Correction Matrix control algorithm
+ */
+
+#include "ccm.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+/**
+ * \file ccm.h
+ * \brief Qualcomm IFE CCM implementation
+ */
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+LOG_DEFINE_CATEGORY(QcomIfeCcm)
+
+/**
+ * \class Ccm
+ * \brief Qualcomm IFE color correction matrix algorithm
+ *
+ * The matrix is interpolated by colour temperature from the tuning data with
+ * the libipa CCM algorithm. The hardware applies it after the demosaic and the
+ * white balance gains and before the gamma curves, on linear data.
+ */
+
+/* The output offsets are signed 11 bit values */
+static constexpr int kMinOffset = -1024;
+static constexpr int kMaxOffset = 1023;
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::init
+ */
+int Ccm::init(IPAContext &context, const ValueNode &tuningData)
+{
+	return ccmAlgo_.init(tuningData, context.ctrlMap);
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::configure
+ */
+int Ccm::configure(IPAContext &context,
+		   [[maybe_unused]] const IPACameraSensorInfo &configInfo)
+{
+	return ccmAlgo_.configure(context.activeState.ccm,
+				  context.activeState.awb.automatic.colourTemperature);
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::queueRequest
+ */
+void Ccm::queueRequest(IPAContext &context,
+		       [[maybe_unused]] const uint32_t frame,
+		       IPAFrameContext &frameContext,
+		       const ControlList &controls)
+{
+	/* Nothing to do here, the ccm will be calculated in prepare() */
+	if (frameContext.awb.autoEnabled)
+		return;
+
+	ccmAlgo_.queueRequest(context.activeState.ccm, frameContext.ccm, controls);
+}
+
+void Ccm::setParameters(QcomIfeParams *params, const IPAFrameContext &frameContext)
+{
+	auto config = params->block<QcomIfeBlocks::Ccm>();
+	config.setEnabled(true);
+
+	/*
+	 * A non-zero shift adds fractional bits and narrows the range, so it
+	 * cannot help a coefficient that overflows. The matrix is clamped to
+	 * the range of the zero shift instead.
+	 */
+	const Matrix<float, 3, 3> &ccm = frameContext.ccm.ccm;
+	for (unsigned int i = 0; i < 3; i++) {
+		for (unsigned int j = 0; j < 3; j++) {
+			const Q<5, 7> coeff(ccm[i][j]);
+			config->coeff[i][j] = static_cast<int16_t>(std::lround(coeff.value() * 128));
+		}
+	}
+
+	for (unsigned int i = 0; i < 3; i++)
+		config->offset[i] = std::clamp<int>(frameContext.ccm.offsets[i][0],
+						    kMinOffset, kMaxOffset);
+
+	config->shift = 0;
+
+	LOG(QcomIfeCcm, Debug) << "Setting ccm: " << ccm << " offsets: "
+			       << frameContext.ccm.offsets;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::prepare
+ */
+void Ccm::prepare(IPAContext &context, const uint32_t frame,
+		  IPAFrameContext &frameContext, QcomIfeParams *params)
+{
+	if (frameContext.awb.autoEnabled)
+		ccmAlgo_.prepare(context.activeState.ccm, frameContext.ccm,
+				 frame, frameContext.awb.colourTemperature);
+
+	setParameters(params, frameContext);
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::process
+ */
+void Ccm::process([[maybe_unused]] IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext,
+		  [[maybe_unused]] const ife17x_stats_buffer *stats,
+		  ControlList &metadata)
+{
+	ccmAlgo_.process(frameContext.ccm, metadata);
+}
+
+REGISTER_IPA_ALGORITHM(Ccm, "Ccm")
+
+} /* namespace ipa::qcom_ife::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/qcom-ife/algorithms/ccm.h b/src/ipa/qcom-ife/algorithms/ccm.h
new file mode 100644
index 00000000..e6cbcb60
--- /dev/null
+++ b/src/ipa/qcom-ife/algorithms/ccm.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Ideas On Board
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE Color Correction Matrix control algorithm
+ */
+
+#pragma once
+
+#include <libcamera/controls.h>
+
+#include "libcamera/internal/value_node.h"
+
+#include "libipa/ccm.h"
+#include "libipa/fixedpoint.h"
+
+#include "algorithm.h"
+#include "ipa_context.h"
+#include "params.h"
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+class Ccm : public Algorithm
+{
+public:
+	Ccm() {}
+	~Ccm() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPACameraSensorInfo &configInfo) override;
+	void queueRequest(IPAContext &context,
+			  const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void prepare(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     QcomIfeParams *params) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const ife17x_stats_buffer *stats,
+		     ControlList &metadata) override;
+
+private:
+	void setParameters(QcomIfeParams *params, const IPAFrameContext &frameContext);
+
+	/*
+	 * The coefficients are signed 12 bit values, 1.0 = 128 with no extra
+	 * fractional bits, i.e. Q<5, 7> including the sign bit.
+	 */
+	CcmAlgorithm<Q<5, 7>> ccmAlgo_;
+};
+
+} /* namespace ipa::qcom_ife::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/qcom-ife/algorithms/gamma.cpp b/src/ipa/qcom-ife/algorithms/gamma.cpp
new file mode 100644
index 00000000..3213a19f
--- /dev/null
+++ b/src/ipa/qcom-ife/algorithms/gamma.cpp
@@ -0,0 +1,154 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE gamma curves
+ */
+
+#include "gamma.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/value_node.h"
+
+/**
+ * \file gamma.h
+ */
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+/**
+ * \class Gamma
+ * \brief Qualcomm IFE gamma curves
+ *
+ * The algorithm applies a power curve with the \a gamma value of the tuning
+ * data, 2.2 by default, to the red, green and blue channels. The Gamma control
+ * changes the value. The curves are written to the first parameters buffer
+ * and again only when the value changes, as the driver loads them into the
+ * inactive lookup table banks and switches banks each time.
+ */
+
+LOG_DEFINE_CATEGORY(QcomIfeGamma)
+
+static constexpr float kDefaultGamma = 2.2f;
+static constexpr float kMinGamma = 0.1f;
+static constexpr float kMaxGamma = 10.0f;
+
+/*
+ * The nodes are evenly spaced over the input range and go up to 1023. The
+ * last node may be 1024, so that the last segment reaches full scale.
+ */
+static constexpr unsigned int kCurveScale = 1024;
+static constexpr unsigned int kNodeMax = 1023;
+
+/* The hardware stores the step between two nodes as a signed 10 bit value. */
+static constexpr unsigned int kMaxStep = 511;
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::init
+ */
+int Gamma::init(IPAContext &context, const ValueNode &tuningData)
+{
+	defaultGamma_ = tuningData["gamma"].get<double>(kDefaultGamma);
+	if (defaultGamma_ < kMinGamma || defaultGamma_ > kMaxGamma) {
+		LOG(QcomIfeGamma, Error) << "Invalid gamma " << defaultGamma_;
+		return -EINVAL;
+	}
+
+	context.ctrlMap[&controls::Gamma] =
+		ControlInfo(kMinGamma, kMaxGamma, static_cast<float>(defaultGamma_));
+
+	return 0;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::configure
+ */
+int Gamma::configure(IPAContext &context,
+		     [[maybe_unused]] const IPACameraSensorInfo &configInfo)
+{
+	context.activeState.gamma.gamma = defaultGamma_;
+	appliedGamma_ = 0.0;
+
+	return 0;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::queueRequest
+ */
+void Gamma::queueRequest(IPAContext &context,
+			 [[maybe_unused]] const uint32_t frame,
+			 IPAFrameContext &frameContext,
+			 const ControlList &controls)
+{
+	const auto &gamma = controls.get(controls::Gamma);
+	if (gamma) {
+		context.activeState.gamma.gamma = std::clamp(*gamma, kMinGamma, kMaxGamma);
+		LOG(QcomIfeGamma, Debug)
+			<< "Set gamma to " << context.activeState.gamma.gamma;
+	}
+
+	frameContext.gamma.gamma = context.activeState.gamma.gamma;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::prepare
+ */
+void Gamma::prepare(IPAContext &context,
+		    [[maybe_unused]] const uint32_t frame,
+		    IPAFrameContext &frameContext,
+		    QcomIfeParams *params)
+{
+	const double gamma = frameContext.gamma.gamma;
+
+	if (!context.activeState.initialParams && gamma == appliedGamma_)
+		return;
+
+	auto block = params->block<QcomIfeBlocks::Gamma>();
+	block.setEnabled(true);
+
+	unsigned int previous = 0;
+	for (unsigned int i = 0; i < IFE17X_GAMMA_NODES; i++) {
+		const double x = static_cast<double>(i) / (IFE17X_GAMMA_NODES - 1);
+		unsigned int y = static_cast<unsigned int>(
+			std::lround(std::pow(x, 1.0 / gamma) * kCurveScale));
+
+		if (i < IFE17X_GAMMA_NODES - 1)
+			y = std::min(y, kNodeMax);
+		y = std::min(y, previous + kMaxStep);
+
+		for (unsigned int c = 0; c < 3; c++)
+			block->curve[c][i] = y;
+
+		previous = y;
+	}
+
+	appliedGamma_ = gamma;
+
+	LOG(QcomIfeGamma, Debug) << "Writing gamma curves for gamma " << gamma;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::process
+ */
+void Gamma::process([[maybe_unused]] IPAContext &context,
+		    [[maybe_unused]] const uint32_t frame,
+		    IPAFrameContext &frameContext,
+		    [[maybe_unused]] const ife17x_stats_buffer *stats,
+		    ControlList &metadata)
+{
+	metadata.set(controls::Gamma, static_cast<float>(frameContext.gamma.gamma));
+}
+
+REGISTER_IPA_ALGORITHM(Gamma, "Gamma")
+
+} /* namespace ipa::qcom_ife::algorithms */
+
+} /* namespace libcamera */
