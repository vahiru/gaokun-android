+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE focus statistics
+ */
+
+#pragma once
+
+#include <array>
+#include <optional>
+#include <stdint.h>
+#include <vector>
+
+#include <libcamera/geometry.h>
+
+#include "algorithm.h"
+#include "params.h"
+
+namespace libcamera {
+
+namespace ipa::qcom_ife::algorithms {
+
+class Bf : public Algorithm
+{
+public:
+	Bf() = default;
+	~Bf() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPACameraSensorInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void prepare(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     QcomIfeParams *params) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const ife17x_stats_buffer *stats,
+		     ControlList &metadata) override;
+
+private:
+	struct Filter {
+		std::array<int16_t, IFE17X_BF_IIR_COEFFS> iir;
+		uint8_t shift;
+		uint16_t coringGain;
+		uint32_t coringThreshold;
+		std::array<uint8_t, IFE17X_BF_CORING_POINTS> coring;
+	};
+
+	int parseFilter(const ValueNode &data, Filter &filter);
+	Rectangle fit(Rectangle window) const;
+	struct Grid {
+		std::vector<ife17x_bf_roi> rois;
+		/* With two IFEs: the regions of the left stripe, first */
+		unsigned int numLeft = 0;
+	};
+
+	Grid grid(const Rectangle &window) const;
+	unsigned int slot(const Grid &grid, unsigned int i) const;
+	std::optional<double> greenMean(const ife17x_stats_buffer *stats,
+					const Rectangle &window) const;
+
+	Filter h1_;
+	Filter v_;
+	unsigned int gridSize_ = 5;
+	double defaultWindow_ = 0.7;
+
+	bool active_ = false;
+	Size input_;
+	Rectangle analogCrop_;
+	Rectangle defaultRect_;
+	/* With two IFEs: where the right stripe starts, and the padding */
+	unsigned int dualSplit_ = 0;
+	unsigned int dualPad_ = 0;
+	/* Centre of each AWB grid region in pixels of the IFE input */
+	std::vector<Point> centres_;
+
+	/* From the requests: the metering mode and the window it uses */
+	bool windowsMetering_ = false;
+	Rectangle requested_;
+
+	/* What the hardware was last given */
+	Rectangle programmed_;
+	std::vector<ife17x_bf_roi> rois_;
+};
+
+} /* namespace ipa::qcom_ife::algorithms */
+
+} /* namespace libcamera */
