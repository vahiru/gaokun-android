diff --git a/src/ipa/qcom-ife/qcom-ife.cpp b/src/ipa/qcom-ife/qcom-ife.cpp
new file mode 100644
index 00000000..1cb84804
--- /dev/null
+++ b/src/ipa/qcom-ife/qcom-ife.cpp
@@ -0,0 +1,358 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2023, Ideas on Board Oy
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE (Titan 17x) ISP image processing algorithms
+ */
+
+#include <algorithm>
+#include <cmath>
+#include <map>
+#include <span>
+#include <string.h>
+#include <vector>
+
+#include <linux/media/qcom/ife17x-config.h>
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/file.h>
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+#include <libcamera/ipa/ipa_interface.h>
+#include <libcamera/ipa/ipa_module_info.h>
+#include <libcamera/ipa/qcom-ife_ipa_interface.h>
+
+#include "libcamera/internal/bayer_format.h"
+#include "libcamera/internal/mapped_framebuffer.h"
+#include "libcamera/internal/yaml_parser.h"
+
+#include "algorithms/algorithm.h"
+#include "libipa/agc.h"
+#include "libipa/camera_sensor_helper.h"
+
+#include "ipa_context.h"
+#include "params.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPAQcomIfe)
+
+namespace ipa::qcom_ife {
+
+/* Maximum number of frame contexts to be held */
+static constexpr uint32_t kMaxFrameContexts = 16;
+
+class IPAQcomIfe : public IPAQcomIfeInterface, public Module
+{
+public:
+	IPAQcomIfe();
+
+	int init(const IPASettings &settings, const IPAConfigInfo &ipaConfig,
+		 ControlInfoMap *ipaControls) override;
+	void start(const ControlList &controls, StartResult *result) override;
+	void stop() override;
+	void resetParams() override;
+	int configure(const IPAConfigInfo &ipaConfig, uint8_t bayerOrder,
+		      ControlInfoMap *ipaControls) override;
+	void mapBuffers(const std::vector<IPABuffer> &buffers, bool readOnly) override;
+	void unmapBuffers(const std::vector<IPABuffer> &buffers) override;
+	void queueRequest(const uint32_t request, const ControlList &controls) override;
+	void fillParams(unsigned int request, uint32_t bufferId) override;
+	void processStats(unsigned int request, unsigned int bufferId,
+			  const ControlList &sensorControls) override;
+
+protected:
+	std::string logPrefix() const override;
+
+private:
+	void updateControls(ControlInfoMap *ipaControls);
+	ControlList sensorControls(uint32_t exposure, double gain, uint32_t vblank) const;
+	void setControls(const IPAFrameContext &frameContext);
+
+	std::map<unsigned int, MappedFrameBuffer> buffers_;
+
+	/* Local parameter storage */
+	struct IPAContext context_;
+};
+
+IPAQcomIfe::IPAQcomIfe()
+	: context_(kMaxFrameContexts)
+{
+}
+
+std::string IPAQcomIfe::logPrefix() const
+{
+	return "qcom-ife";
+}
+
+int IPAQcomIfe::init(const IPASettings &settings, const IPAConfigInfo &ipaConfig,
+		     ControlInfoMap *ipaControls)
+{
+	context_.sensorInfo = ipaConfig.sensorInfo;
+
+	context_.camHelper = CameraSensorHelperFactoryBase::create(settings.sensorModel);
+	if (!context_.camHelper) {
+		LOG(IPAQcomIfe, Error)
+			<< "Failed to create camera sensor helper for "
+			<< settings.sensorModel;
+		return -ENODEV;
+	}
+
+	File file(settings.configurationFile);
+	if (!file.open(File::OpenModeFlag::ReadOnly)) {
+		int ret = file.error();
+		LOG(IPAQcomIfe, Error)
+			<< "Failed to open configuration file "
+			<< settings.configurationFile << ": " << strerror(-ret);
+		return ret;
+	}
+
+	std::unique_ptr<ValueNode> data = YamlParser::parse(file);
+	if (!data)
+		return -EINVAL;
+
+	if (!data->contains("algorithms")) {
+		LOG(IPAQcomIfe, Error)
+			<< "Tuning file doesn't contain any algorithm";
+		return -EINVAL;
+	}
+
+	context_.sensorControls = ipaConfig.sensorControls;
+
+	int ret = createAlgorithms(context_, (*data)["algorithms"]);
+	if (ret)
+		return ret;
+
+	updateControls(ipaControls);
+
+	return 0;
+}
+
+ControlList IPAQcomIfe::sensorControls(uint32_t exposure, double gain,
+				       uint32_t vblank) const
+{
+	ControlList ctrls(context_.sensorControls);
+	agc::prepareControls(ctrls, context_.camHelper.get(), exposure, gain);
+
+	/*
+	 * The frame length too, so that FrameDurationLimits takes effect:
+	 * the AGC computed it for the exposure time written here.
+	 */
+	const auto vblankInfo = context_.sensorControls.find(V4L2_CID_VBLANK);
+	if (vblankInfo != context_.sensorControls.end())
+		ctrls.set(V4L2_CID_VBLANK,
+			  std::clamp(static_cast<int32_t>(vblank),
+				     vblankInfo->second.min().get<int32_t>(),
+				     vblankInfo->second.max().get<int32_t>()));
+
+	return ctrls;
+}
+
+void IPAQcomIfe::setControls(const IPAFrameContext &frameContext)
+{
+	setSensorControls.emit(sensorControls(frameContext.agc.exposure,
+					      frameContext.agc.gain,
+					      frameContext.agc.vblank));
+}
+
+void IPAQcomIfe::start([[maybe_unused]] const ControlList &controls,
+		       StartResult *result)
+{
+	/* The hardware is reset when streaming starts. */
+	context_.activeState.initialParams = true;
+
+	/*
+	 * The sensor keeps the controls of its last session. The first frames
+	 * get theirs only after the sensor delays, so the pipeline writes the
+	 * AGC's initial values before streaming starts. The frame length is
+	 * the one AgcAlgorithm::processFrameLength() computes.
+	 */
+	const agc::Session &session = context_.configuration.agc;
+	const agc::ActiveState &state = context_.activeState.agc;
+	const uint32_t exposure = state.autoExposureEnabled ? state.automatic.exposure
+							    : state.manual.exposure;
+	const double gain = state.autoGainEnabled ? state.automatic.gain
+						  : state.manual.gain;
+	const double minLines = state.minFrameDuration / session.lineDuration;
+	const uint32_t frameLength =
+		std::max(static_cast<uint32_t>(std::ceil(minLines - 1e-3)),
+			 exposure + session.exposureMargin);
+
+	result->sensorControls = sensorControls(exposure, gain,
+						frameLength - session.sensor.outputSize.height);
+	result->ret = 0;
+}
+
+void IPAQcomIfe::resetParams()
+{
+	/* As at start: the streams restarted, the hardware was reset. */
+	context_.activeState.initialParams = true;
+}
+
+void IPAQcomIfe::stop()
+{
+	context_.frameContexts.clear();
+}
+
+void IPAQcomIfe::updateControls(ControlInfoMap *ipaControls)
+{
+	ControlInfoMap::Map ctrlMap;
+
+	ctrlMap.insert(context_.ctrlMap.begin(), context_.ctrlMap.end());
+	*ipaControls = ControlInfoMap(std::move(ctrlMap), controls::controls);
+}
+
+int IPAQcomIfe::configure(const IPAConfigInfo &ipaConfig, uint8_t bayerOrder,
+			  ControlInfoMap *ipaControls)
+{
+	context_.sensorControls = ipaConfig.sensorControls;
+	context_.sensorInfo = ipaConfig.sensorInfo;
+
+	/* Clear the IPA context before the streaming session. */
+	context_.configuration = {};
+	context_.configuration.pd.period = ipaConfig.pdPeriod;
+	context_.configuration.pd.pixels = ipaConfig.pdPixels;
+	context_.configuration.dualIfe = ipaConfig.dualIfe;
+	context_.configuration.dualSplit = ipaConfig.dualSplit;
+	context_.configuration.dualPad = ipaConfig.dualPad;
+	context_.activeState = {};
+	context_.frameContexts.clear();
+
+	const IPACameraSensorInfo &info = ipaConfig.sensorInfo;
+
+	context_.configuration.sensor.bayerOrder = static_cast<BayerFormat::Order>(bayerOrder);
+
+	/* The black level from CameraSensorHelper is a 16-bit value. */
+	if (auto bl = context_.camHelper->blackLevel())
+		context_.configuration.sensor.blackLevel = *bl;
+
+	for (const auto &a : algorithms()) {
+		Algorithm *algo = static_cast<Algorithm *>(a.get());
+
+		int ret = algo->configure(context_, info);
+		if (ret)
+			return ret;
+	}
+
+	context_.activeState.initialParams = true;
+
+	updateControls(ipaControls);
+
+	return 0;
+}
+
+void IPAQcomIfe::mapBuffers(const std::vector<IPABuffer> &buffers, bool readOnly)
+{
+	for (const IPABuffer &buffer : buffers) {
+		const FrameBuffer fb(buffer.planes);
+		buffers_.emplace(
+			buffer.id,
+			MappedFrameBuffer(
+				&fb,
+				readOnly ? MappedFrameBuffer::MapFlag::Read
+					 : MappedFrameBuffer::MapFlag::ReadWrite));
+	}
+}
+
+void IPAQcomIfe::unmapBuffers(const std::vector<IPABuffer> &buffers)
+{
+	for (const IPABuffer &buffer : buffers) {
+		auto it = buffers_.find(buffer.id);
+		if (it == buffers_.end())
+			continue;
+
+		buffers_.erase(buffer.id);
+	}
+}
+
+void IPAQcomIfe::queueRequest(const uint32_t request, const ControlList &controls)
+{
+	IPAFrameContext &frameContext = context_.frameContexts.alloc(request);
+
+	for (const auto &a : algorithms()) {
+		Algorithm *algo = static_cast<Algorithm *>(a.get());
+
+		algo->queueRequest(context_, request, frameContext, controls);
+	}
+}
+
+void IPAQcomIfe::fillParams(unsigned int request, uint32_t bufferId)
+{
+	IPAFrameContext &frameContext = context_.frameContexts.get(request);
+	QcomIfeParams params(buffers_.at(bufferId).planes()[0]);
+
+	for (const auto &algo : algorithms())
+		algo->prepare(context_, request, frameContext, &params);
+
+	context_.activeState.initialParams = false;
+
+	paramsComputed.emit(request, params.bytesused());
+}
+
+void IPAQcomIfe::processStats(unsigned int request, unsigned int bufferId,
+			      const ControlList &sensorControls)
+{
+	IPAFrameContext &frameContext = context_.frameContexts.get(request);
+	const ife17x_stats_buffer *stats = nullptr;
+
+	stats = reinterpret_cast<ife17x_stats_buffer *>(
+		buffers_.at(bufferId).planes()[0].data());
+
+	std::tie(frameContext.sensor.exposure, frameContext.sensor.gain) =
+		agc::extractControls(sensorControls, context_.camHelper.get());
+
+	ControlList metadata(controls::controls);
+
+	for (const auto &a : algorithms()) {
+		Algorithm *algo = static_cast<Algorithm *>(a.get());
+
+		algo->process(context_, request, frameContext, stats, metadata);
+	}
+
+	/*
+	 * Report the exposure the sensor applied to this frame. The AGC's
+	 * values for a request go to the sensor once its statistics are in
+	 * (setControls() below) and take effect frames later, so they do not
+	 * describe the frame of the request.
+	 */
+	const agc::Session &session = context_.configuration.agc;
+	metadata.set(controls::ExposureTime,
+		     static_cast<int32_t>(utils::Duration(session.lineDuration *
+							  frameContext.sensor.exposure)
+						  .get<std::micro>()));
+	metadata.set(controls::AnalogueGain, static_cast<float>(frameContext.sensor.gain));
+	const ControlValue &vblank = sensorControls.get(V4L2_CID_VBLANK);
+	if (!vblank.isNone())
+		metadata.set(controls::FrameDuration,
+			     static_cast<int64_t>(utils::Duration(session.lineDuration *
+								  (session.sensor.outputSize.height +
+								   vblank.get<int32_t>()))
+							  .get<std::micro>()));
+
+	setControls(frameContext);
+
+	statsProcessed.emit(request, metadata);
+}
+
+} /* namespace ipa::qcom_ife */
+
+/*
+ * External IPA module interface
+ */
+extern "C" {
+const struct IPAModuleInfo ipaModuleInfo = {
+	IPA_MODULE_API_VERSION,
+	1,
+	"qcom-ife",
+};
+
+IPAInterface *ipaCreate()
+{
+	return new ipa::qcom_ife::IPAQcomIfe();
+}
+
+} /* extern "C" */
+
+} /* namespace libcamera */
diff --git a/src/ipa/qcom-ife/stats.cpp b/src/ipa/qcom-ife/stats.cpp
new file mode 100644
index 00000000..8d34d08c
--- /dev/null
+++ b/src/ipa/qcom-ife/stats.cpp
@@ -0,0 +1,190 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Akisaira
+ *
+ * Qualcomm IFE (Titan 17x) AWB Bayer grid statistics
+ */
+
+#include "stats.h"
+
+#include <algorithm>
+
+/**
+ * \file stats.h
+ * \brief Configuration and parsing of the AWB Bayer grid statistics
+ */
+
+namespace libcamera {
+
+namespace ipa::qcom_ife {
+
+/**
+ * \var kGridWidth
+ * \brief Number of regions per row of the AWB Bayer grid
+ */
+
+/**
+ * \var kGridHeight
+ * \brief Number of region rows of the AWB Bayer grid
+ */
+
+/**
+ * \var kPixelMax
+ * \brief Full scale of the 14 bit pipeline the statistics are expressed in
+ */
+
+/**
+ * \brief Write the AWB Bayer grid configuration to a parameters buffer
+ * \param[in] params The parameters buffer
+ *
+ * The grid is the only source of statistics: the hardware produces none
+ * without it. Both the Agc and the Awb algorithms call this function for the
+ * first parameters buffer, so that the grid does not depend on either of them
+ * being listed in the tuning file. The parameters buffer hands out the same
+ * block to both.
+ */
+void fillGridConfig(QcomIfeParams *params)
+{
+	auto block = params->block<QcomIfeBlocks::AwbBg>();
+	block.setEnabled(true);
+
+	block->h_num = kGridWidth;
+	block->v_num = kGridHeight;
+
+	for (uint16_t &threshold : block->threshold)
+		threshold = kGridThreshold;
+}
+
+/*
+ * Compute the centre of each grid region in pixels of the IFE input, in the
+ * order of the statistics buffer. The driver lays the regions out from the
+ * frame size: with one IFE, kGridWidth columns of even width from the left
+ * edge; with two, half of them over the left stripe and the other half over
+ * the right one from \a dualSplit, each stripe's grid after the other.
+ */
+std::vector<Point> gridCentres(const Size &input, unsigned int dualSplit)
+{
+	const auto size = [](unsigned int length, unsigned int n, unsigned int lo,
+			     unsigned int hi) {
+		return std::clamp((length / n) & ~1U, lo, hi);
+	};
+	const unsigned int rh = size(input.height, kGridHeight, 2, 512);
+	std::vector<Point> centres;
+
+	centres.reserve(kGridWidth * kGridHeight);
+
+	const auto add = [&](unsigned int x0, unsigned int width, unsigned int columns) {
+		const unsigned int rw = size(width, columns, 6, 390);
+
+		for (unsigned int r = 0; r < kGridHeight; r++)
+			for (unsigned int c = 0; c < columns; c++)
+				centres.emplace_back(static_cast<int>(x0 + c * rw + rw / 2),
+						     static_cast<int>(r * rh + rh / 2));
+	};
+
+	if (dualSplit) {
+		add(0, dualSplit, kGridWidth / 2);
+		add(dualSplit, input.width - dualSplit, kGridWidth / 2);
+	} else {
+		add(0, input.width, kGridWidth);
+	}
+
+	return centres;
+}
+
+/**
+ * \class GridStatistics
+ * \brief Accessor for the AWB Bayer grid of a statistics buffer
+ *
+ * Each region of the grid holds, for each Bayer channel, the sum and the
+ * number of the pixels at or below the channel threshold. The values are
+ * taken after the black level subtraction and before the white balance gains.
+ *
+ * The regions of a grid have the same size, so each channel has the same
+ * number of pixels in every region. The class finds that number as the
+ * largest count of the channel over the grid: it is exact as soon as one
+ * region holds no pixel above the threshold in that channel. A channel above
+ * the threshold over the whole grid takes the largest count of the other
+ * channels. With two IFEs each stripe has its own grid, the first half of the
+ * records then the second, with regions of their own width: the counts are
+ * found per stripe.
+ */
+
+/**
+ * \enum GridStatistics::Channel
+ * \brief Bayer channels of a grid region, in the order of the hardware
+ * \var GridStatistics::Red
+ * \brief Red pixels
+ * \var GridStatistics::Blue
+ * \brief Blue pixels
+ * \var GridStatistics::GreenRed
+ * \brief Green pixels on the red rows
+ * \var GridStatistics::GreenBlue
+ * \brief Green pixels on the blue rows
+ * \var GridStatistics::NumChannels
+ * \brief Number of channels
+ */
+
+/**
+ * \brief Parse the AWB Bayer grid of a statistics buffer
+ * \param[in] stats The statistics buffer
+ */
+GridStatistics::GridStatistics(const ife17x_stats_buffer *stats, bool dualIfe)
+	: regions_(stats->awb_bg, kGridWidth * kGridHeight), dualIfe_(dualIfe), pixels_{}
+{
+	/*
+	 * A full region's count, per stripe with two IFEs: the halves of the
+	 * records are the two stripes' grids, whose regions differ in width (a
+	 * 4208 pixel frame splits into 2112 and 2096 columns).
+	 */
+	unsigned int maxPixels = 0;
+
+	for (const ife17x_awb_bg_region &region : regions_) {
+		auto &pixels = pixels_[half(region)];
+
+		for (unsigned int c = 0; c < NumChannels; c++) {
+			pixels[c] = std::max<unsigned int>(pixels[c], region.count[c]);
+			maxPixels = std::max<unsigned int>(maxPixels, region.count[c]);
+		}
+	}
+
+	for (auto &half : pixels_) {
+		const unsigned int halfMax = *std::max_element(half.begin(), half.end());
+
+		for (unsigned int &pixels : half) {
+			if (!pixels)
+				pixels = halfMax ? halfMax : maxPixels;
+		}
+	}
+
+	empty_ = !maxPixels;
+}
+
+/**
+ * \fn GridStatistics::regions()
+ * \brief Retrieve the regions of the grid, in row order
+ * \return The regions of the grid
+ */
+
+/**
+ * \fn GridStatistics::pixels()
+ * \brief Retrieve the number of pixels of a channel in a full region
+ * \param[in] region A region of the grid
+ * \param[in] channel The channel
+ * \return The number of pixels of \a channel in \a region when none is above
+ * the thresholds, or 0 if the grid is empty
+ */
+
+/**
+ * \fn GridStatistics::empty()
+ * \brief Tell whether the grid counted no pixel at all
+ *
+ * The grid write master has nothing to write before the grid runs, so an
+ * empty grid is taken for a frame with every pixel above the thresholds.
+ *
+ * \return True if no region counted any pixel
+ */
+
+} /* namespace ipa::qcom_ife */
+
+} /* namespace libcamera */
