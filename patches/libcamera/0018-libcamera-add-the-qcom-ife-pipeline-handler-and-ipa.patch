+struct IPASessionConfiguration {
+	agc::Session agc;
+
+	struct {
+		BayerFormat::Order bayerOrder;
+		std::optional<uint32_t> blackLevel;
+	} sensor;
+
+	/* Black level the IFE subtracts, in 16 bit units, if known */
+	struct {
+		std::optional<uint16_t> level;
+	} blc;
+
+	/* Phase detection pixels of the sensor mode, if any */
+	struct {
+		Size period;
+		std::vector<Point> pixels;
+	} pd;
+
+	/* Two IFEs process the frame in stripes */
+	bool dualIfe;
+	/* With two IFEs: where the right stripe starts, and the padding */
+	unsigned int dualSplit;
+	unsigned int dualPad;
+};
+
+struct IPAActiveState {
+	agc::ActiveState agc;
+	ipa::awb::ActiveState awb;
+	ipa::ccm::ActiveState ccm;
+
+	struct {
+		double gamma;
+	} gamma;
+
+	bool initialParams;
+};
+
+struct IPAFrameContext : public FrameContext {
+	agc::FrameContext agc;
+
+	struct {
+		uint32_t exposure;
+		double gain;
+	} sensor;
+
+	ipa::awb::FrameContext awb;
+	ipa::ccm::FrameContext ccm;
+
+	struct {
+		double gamma;
+	} gamma;
+
+	/* Focus statistics window, in pixels of the IFE input */
+	struct {
+		Rectangle window;
+	} bf;
+
+	/* Exposure metering window, in pixels of the IFE input */
+	struct {
+		Rectangle window;
+	} metering;
+};
+
+struct IPAContext {
+	IPAContext(unsigned int frameContextSize)
+		: frameContexts(frameContextSize)
+	{
+	}
+
+	IPACameraSensorInfo sensorInfo;
+	IPASessionConfiguration configuration;
+	IPAActiveState activeState;
+
+	FCQueue<IPAFrameContext> frameContexts;
+
+	ControlInfoMap sensorControls;
+
+	std::unique_ptr<CameraSensorHelper> camHelper;
+
+	ControlInfoMap::Map ctrlMap;
+};
+
+} /* namespace ipa::qcom_ife */
+
+} /* namespace libcamera */
