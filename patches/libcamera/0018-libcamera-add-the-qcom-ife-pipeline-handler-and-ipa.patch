+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Pipeline handler for the pixel pipeline of the Qualcomm CAMSS IFE (Titan 17x)
+ *
+ * The sensor feeds CSID 0, whose IPP output goes to the pixel path of VFE 0:
+ * demosaic, colour correction, gamma, colour space conversion and scaling in
+ * hardware, NV12 out. The IPA programs the pipeline through the parameters
+ * node and reads the AWB grid from the statistics node.
+ *
+ * Besides the full output path, the pixel path has a display output path with
+ * a scaler of its own: a second, smaller NV12 image of the same frame and the
+ * same field of view (a viewfinder next to a still capture).
+ */
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <map>
+#include <memory>
+#include <queue>
+#include <set>
+#include <sstream>
+#include <string>
+#include <stddef.h>
+#include <string.h>
+#include <unordered_map>
+#include <vector>
+
+#include <linux/media-bus-format.h>
+#include <linux/media.h>
+#include <linux/media/qcom/ife17x-config.h>
+#include <linux/videodev2.h>
+
+#include <libcamera/base/log.h>
+#include <libcamera/base/utils.h>
+
+#include <libcamera/camera.h>
+#include <libcamera/color_space.h>
+#include <libcamera/control_ids.h>
+#include <libcamera/formats.h>
+#include <libcamera/geometry.h>
+#include <libcamera/property_ids.h>
+#include <libcamera/request.h>
+#include <libcamera/stream.h>
+
+#include <libcamera/ipa/core_ipa_interface.h>
+#include <libcamera/ipa/qcom-ife_ipa_interface.h>
+#include <libcamera/ipa/qcom-ife_ipa_proxy.h>
+
+#include "libcamera/internal/bayer_format.h"
+#include "libcamera/internal/camera.h"
+#include "libcamera/internal/camera_sensor.h"
+#include "libcamera/internal/camera_sensor_properties.h"
+#include "libcamera/internal/delayed_controls.h"
+#include "libcamera/internal/device_enumerator.h"
+#include "libcamera/internal/framebuffer.h"
+#include "libcamera/internal/mapped_framebuffer.h"
+#include "libcamera/internal/media_device.h"
+#include "libcamera/internal/pipeline_handler.h"
+#include "libcamera/internal/request.h"
+#include "libcamera/internal/v4l2_subdevice.h"
+#include "libcamera/internal/v4l2_videodevice.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(QcomIfe)
+
+namespace {
+
+/* Requests in flight, and the parameters and statistics buffers for them */
+constexpr unsigned int kBufferCount = 4;
+
+/* Line width limit of one IFE pixel pipeline: wider modes take two (dual IFE) */
+/*
+ * Modes at least this wide (percent of the pixel array) see its whole width:
+ * the binned ones (the ov13b10's 16:9 2080x1170 is 49%), not the windows.
+ */
+constexpr unsigned int kMinModeWidthPercent = 45;
+constexpr unsigned int kMaxInputWidth = 3840;
+
+/* Output alignment: the write master stores multiples of 16 pixels */
+constexpr unsigned int kWidthAlign = 16;
+constexpr unsigned int kHeightAlign = 2;
+constexpr Size kMinSize = { 64, 64 };
+
+/* The scaler downscales by up to 16 in each direction */
+constexpr unsigned int kMaxDownscale = 16;
+
+/* One instance: CSID 0 IPP feeds the pixel path of VFE 0 */
+const char *const kCsidName = "msm_csid0";
+/* Dual IFE: CSID 1 IPP feeds the pixel path of VFE 1 for the right stripe */
+const char *const kCsid1Name = "msm_csid1";
+const char *const kPix1Name = "msm_vfe1_pix";
+/* Padding of each stripe beyond the split, and the alignment of the split */
+constexpr unsigned int kDualPad = 64;
+constexpr unsigned int kDualAlign = 64;
+
+/* Dual IFE: the column where the right stripe starts, near the middle */
+constexpr unsigned int dualSplit(unsigned int width)
+{
+	return (width / 2 + kDualAlign / 2) / kDualAlign * kDualAlign;
+}
+
+/* How far the split may move from the middle for the display output */
+constexpr unsigned int kDualSplitRange = 768;
+
+/*
+ * The lens shading grid the IPA programs for a frame (Lsc::configure(), keep
+ * in step), in Bayer quads: block width, subgrid width and the grid's start
+ * before the frame. False when no grid fits.
+ */
+bool lscGrid(const Size &frame, unsigned int *blockWidth, unsigned int *subWidth,
+	     unsigned int *startX)
+{
+	const unsigned int w2 = frame.width / 2;
+	const unsigned int h2 = frame.height / 2;
+	unsigned int nh = 16, nv = 12, f = 4;
+
+	while (true) {
+		if (f == 0) {
+			if (nh <= 8 || nv <= 6)
+				return false;
+			nh -= 4;
+			nv -= 3;
+			f = 3;
+		} else {
+			f--;
+		}
+
+		const unsigned int subW = ((w2 + nh - 1) / nh + (1 << f) - 1) >> f;
+		const unsigned int subH = ((h2 + nv - 1) / nv + (1 << f) - 1) >> f;
+		const unsigned int bw = subW << f;
+		const unsigned int bh = subH << f;
+		const unsigned int exW = bw * nh - w2;
+		const unsigned int exH = bh * nv - h2;
+
+		if (bw < 18 || bh < 9 || subW < 9 || subH < 9 || exW >= bw || exH >= bh)
+			continue;
+		const unsigned int padX = (exW + 1) / 2;
+		if (bw - padX < 18 || subW - padX % subW < 9)
+			continue;
+		if (bw > 2048 || bh > 1024)
+			return false;
+
+		*blockWidth = bw;
+		*subWidth = subW;
+		*startX = padX;
+		return true;
+	}
+}
+
+/*
+ * Dual IFE with the display output: both stripes scale from their first
+ * column with the same step, so the right stripe's output columns lie
+ * (split - kDualPad) / step columns into the frame's, a fraction off the
+ * whole columns the driver crops at. Pick the split, among the multiples of
+ * kDualAlign near the middle, that brings that offset closest to an even
+ * column (the chroma has half the columns), the nearest to the middle on a
+ * tie. @scaledWidth: the width the display output scales the frame to.
+ */
+unsigned int dualSplitForDisplay(const Size &frame, unsigned int scaledWidth,
+				 double *residual)
+{
+	const unsigned int width = frame.width;
+	unsigned int best = dualSplit(width);
+	double bestErr = 2.0;
+
+	/*
+	 * The right stripe's lens shading starts inside the grid: the driver
+	 * takes it at least a block's 18 quads and a subgrid's 9 quads before
+	 * their ends, as the IPA keeps the frame's own start.
+	 */
+	unsigned int bw, subW, startX;
+	const bool lsc = lscGrid(frame, &bw, &subW, &startX);
+	const auto lscOk = [&](unsigned int split) {
+		const unsigned int x = startX + (split - kDualPad) / 2;
+		return !lsc || (bw - x % bw >= 18 && subW - x % subW >= 9);
+	};
+
+	for (unsigned int split = kDualAlign; split < width; split += kDualAlign) {
+		const unsigned int dist = split > width / 2 ? split - width / 2
+							    : width / 2 - split;
+		if (dist > kDualSplitRange || split + kDualPad > kMaxInputWidth ||
+		    width - split + kDualPad > kMaxInputWidth || !lscOk(split))
+			continue;
+
+		const double v = static_cast<double>(split - kDualPad) * scaledWidth / width;
+		const double err = std::abs(v - 2 * std::round(v / 2));
+		const unsigned int bestDist = best > width / 2 ? best - width / 2
+							       : width / 2 - best;
+		if (err < bestErr - 1e-9 || (std::abs(err - bestErr) < 1e-9 && dist < bestDist)) {
+			best = split;
+			bestErr = err;
+		}
+	}
+
+	*residual = bestErr;
+	return best;
+}
+constexpr unsigned int kCsidSinkPad = 0;
+constexpr unsigned int kCsidIppPad = 4;
+const char *const kPixName = "msm_vfe0_pix";
+const char *const kVideoName = "msm_vfe0_video3";
+const char *const kParamsName = "msm_vfe0_pix_params";
+/* RDI 0 of the same CSID and VFE: the sensor frame as is, next to the IPP */
+constexpr unsigned int kCsidRdiPad = 1;
+const char *const kRdiName = "msm_vfe0_rdi0";
+const char *const kRawVideoName = "msm_vfe0_video0";
+const char *const kStatsName = "msm_vfe0_pix_stats";
+/* The display output of the VFE 0 pixel path and its node, if present */
+const char *const kDispName = "msm_vfe0_pix_disp";
+const char *const kDispVideoName = "msm_vfe0_video_disp";
+
+constexpr unsigned int kCsiphySinkPad = 0;
+constexpr unsigned int kCsiphySourcePad = 1;
+constexpr unsigned int kPixSinkPad = 0;
+constexpr unsigned int kPixSourcePad = 1;
+constexpr unsigned int kDispSinkPad = 0;
+constexpr unsigned int kDispSourcePad = 1;
+
+/*
+ * The full output path scales the frame to the smallest size that keeps its
+ * aspect ratio and covers the output, then crops the output from the centre.
+ * Returns that crop, in the scaled frame of size @scaled.
+ */
+Rectangle fullPathCrop(const Size &input, const Size &output, Size *scaled)
+{
+	double scale = std::max(static_cast<double>(output.width) / input.width,
+				static_cast<double>(output.height) / input.height);
+	Size s{
+		static_cast<unsigned int>(std::ceil(input.width * scale)),
+		static_cast<unsigned int>(std::ceil(input.height * scale)),
+	};
+	s = s.alignedUpTo(2, 2).expandedTo(output).boundedTo(input);
+	*scaled = s;
+
+	return Rectangle{
+		static_cast<int>((s.width - output.width) / 2) & ~1,
+		static_cast<int>((s.height - output.height) / 2) & ~1,
+		output
+	};
+}
+
+/*
+ * The display output path takes the frame the full output path scales, and
+ * covers the field of view @fov (input pixels) of the full output: its scaler
+ * maps @fov onto @output, each axis on its own, and its crop keeps that part
+ * of the scaled frame.
+ */
+void dispPathGeometry(const Size &input, const Rectangle &fov, const Size &output,
+		      Size *compose, Rectangle *crop)
+{
+	auto even = [](double v) {
+		return static_cast<unsigned int>(std::lround(v / 2)) * 2;
+	};
+
+	Size c{ even(static_cast<double>(input.width) * output.width / fov.width),
+		even(static_cast<double>(input.height) * output.height / fov.height) };
+	c = c.expandedTo(output).boundedTo(input);
+
+	unsigned int x = even(static_cast<double>(fov.x) * c.width / input.width);
+	unsigned int y = even(static_cast<double>(fov.y) * c.height / input.height);
+	x = std::min(x, c.width - output.width);
+	y = std::min(y, c.height - output.height);
+
+	*compose = c;
+	*crop = Rectangle{ static_cast<int>(x), static_cast<int>(y), output };
+}
+
+} /* namespace */
+
+struct QcomIfeFrameInfo {
+	Request *request;
+	FrameBuffer *paramBuffer;
+	FrameBuffer *statBuffer;
+	/* IFE17X_OUTPUT_* of the request's buffers */
+	uint32_t outputs;
+	/* The frame of the request, from its parameters buffer (setFrame()) */
+	uint32_t frame;
+	bool frameKnown;
+	/* The display output's window of the frame (ScalerCrop), if any */
+	bool dispWindow;
+	Size dispCompose;
+	Rectangle dispCrop;
+	Rectangle dispShown;
+
+	bool paramsQueued;
+	bool paramsDone;
+	bool statsDone;
+};
+
+class QcomIfeCameraData : public Camera::Private
+{
+public:
+	QcomIfeCameraData(PipelineHandler *pipe, MediaEntity *csiphy)
+		: Camera::Private(pipe), csiphyEntity_(csiphy)
+	{
+	}
+
+	int init(MediaEntity *sensor, unsigned int maxInputWidth);
+	int loadIPA();
+
+	V4L2SubdeviceFormat sensorFormat(const Size &size) const;
+	Size maxOutputSize() const { return maxOutputSize_; }
+
+	void setSensorControls(const ControlList &sensorControls);
+	void updateControls(const ControlInfoMap &ipaControls, const Rectangle &zoomMin,
+			    const Rectangle &zoomMax);
+
+	std::unique_ptr<CameraSensor> sensor_;
+	MediaEntity *csiphyEntity_;
+	std::unique_ptr<V4L2Subdevice> csiphy_;
+
+	/* The full output path */
+	Stream stream_;
+	/* Optional second image stream, through the display output path */
+	Stream dispStream_;
+	bool hasDisplay_ = false;
+	/* Optional RAW stream of the sensor frame, through the RDI */
+	Stream rawStream_;
+	V4L2VideoDevice *raw_ = nullptr;
+
+	std::unique_ptr<ipa::qcom_ife::IPAProxyQcomIfe> ipa_;
+	std::unique_ptr<DelayedControls> delayedCtrls_;
+
+private:
+	std::vector<unsigned int> bayerCodes_;
+	Size maxSensorSize_;
+	Size maxOutputSize_;
+};
+
+int QcomIfeCameraData::init(MediaEntity *sensor, unsigned int maxInputWidth)
+{
+	sensor_ = CameraSensorFactoryBase::create(sensor);
+	if (!sensor_)
+		return -ENODEV;
+
+	csiphy_ = std::make_unique<V4L2Subdevice>(csiphyEntity_);
+	int ret = csiphy_->open();
+	if (ret)
+		return ret;
+
+	/* Raw Bayer formats only; the pixel path demosaics them */
+	for (unsigned int code : sensor_->mbusCodes()) {
+		const BayerFormat &bayer = BayerFormat::fromMbusCode(code);
+		if (!bayer.isValid() ||
+		    bayer.packing != BayerFormat::Packing::None ||
+		    bayer.order > BayerFormat::Order::RGGB)
+			continue;
+		if (bayer.bitDepth != 8 && bayer.bitDepth != 10 &&
+		    bayer.bitDepth != 12)
+			continue;
+		bayerCodes_.push_back(code);
+	}
+	if (bayerCodes_.empty()) {
+		LOG(QcomIfe, Error) << "Sensor " << sensor_->model()
+				    << " has no Bayer formats";
+		return -EINVAL;
+	}
+
+	/* Largest sensor mode that fits in the line width limit */
+	for (unsigned int code : bayerCodes_) {
+		for (const Size &size : sensor_->sizes(code)) {
+			if (size.width > maxInputWidth)
+				continue;
+			if (size.width * size.height >
+			    maxSensorSize_.width * maxSensorSize_.height)
+				maxSensorSize_ = size;
+		}
+	}
+	if (maxSensorSize_.isNull()) {
+		LOG(QcomIfe, Error) << "No sensor mode of " << sensor_->model()
+				    << " fits the IFE line width";
+		return -EINVAL;
+	}
+	maxOutputSize_ = maxSensorSize_.alignedDownTo(kWidthAlign, kHeightAlign);
+
+	properties_ = sensor_->properties();
+
+	const CameraSensorProperties::SensorDelays &delays = sensor_->sensorDelays();
+	std::unordered_map<uint32_t, DelayedControls::ControlParams> params = {
+		{ V4L2_CID_ANALOGUE_GAIN, { delays.gainDelay, false } },
+		{ V4L2_CID_EXPOSURE, { delays.exposureDelay, false } },
+		{ V4L2_CID_VBLANK, { delays.vblankDelay, true } },
+	};
+	delayedCtrls_ = std::make_unique<DelayedControls>(sensor_->device(), params);
+
+	return 0;
+}
+
+/*
+ * Pick the sensor mode for an output size, among the modes that cover it and
+ * fit in the line width limit (or the largest one):
+ * - a mode at least kMinModeWidthPercent of the array wide, one that sees its
+ *   whole width (binned or full), before a narrower one, which reads only a
+ *   window of it (the hi846's 640x480 mode: about 78% of the field of view);
+ * - then the largest field of view of the output: such a mode is taken to see
+ *   the array's width and, when it is wider in aspect than the array, a band
+ *   of its height; the output's aspect ratio is cropped from that;
+ * - then the smallest mode, which the IFE scales down at no cost.
+ * libcamera's aspect-ratio-first choice would take the 4:3 4160x3120 mode of
+ * the ov13b10, read by two IFEs, for a 640x480 output rather than the binned
+ * 2104x1560 one, whose aspect ratio differs by about 1%.
+ */
+V4L2SubdeviceFormat QcomIfeCameraData::sensorFormat(const Size &size) const
+{
+	const Size &array = sensor_->resolution();
+	Size best;
+	bool bestWide = false;
+	double bestFov = 0.0;
+
+	if (!size.width || !size.height || array.isNull())
+		return sensor_->getFormat(bayerCodes_, size, maxSensorSize_);
+
+	const double outRatio = static_cast<double>(size.width) / size.height;
+
+	for (unsigned int code : bayerCodes_) {
+		for (const Size &mode : sensor_->sizes(code)) {
+			if (mode.width < size.width || mode.height < size.height ||
+			    mode.width > maxSensorSize_.width || mode.height > maxSensorSize_.height)
+				continue;
+
+			const bool wide = mode.width * 100 >= array.width * kMinModeWidthPercent;
+			double winW = mode.width, winH = mode.height;
+			if (wide) {
+				winW = array.width;
+				winH = std::min<double>(array.height,
+							static_cast<double>(array.width) * mode.height / mode.width);
+			}
+			const double fovW = std::min(winW, winH * outRatio);
+			const double fov = fovW * fovW / outRatio;
+
+			bool better;
+			if (best.isNull() || wide != bestWide)
+				better = best.isNull() || wide;
+			else if (fov > bestFov * 1.01 || fov * 1.01 < bestFov)
+				better = fov > bestFov;
+			else
+				better = static_cast<uint64_t>(mode.width) * mode.height <
+					 static_cast<uint64_t>(best.width) * best.height;
+
+			if (better) {
+				best = mode;
+				bestWide = wide;
+				bestFov = fov;
+			}
+		}
+	}
+
+	/* Nothing covers the output: libcamera's choice, the largest mode */
+	if (best.isNull())
+		return sensor_->getFormat(bayerCodes_, size, maxSensorSize_);
+
+	return sensor_->getFormat(bayerCodes_, best, maxSensorSize_);
+}
+
+void QcomIfeCameraData::setSensorControls(const ControlList &sensorControls)
+{
+	delayedCtrls_->push(sensorControls);
+}
+
+/*
+ * The IPA's controls and the pipeline handler's. @zoomMax: the field of view
+ * the display output zooms in, null without one; @zoomMin: its smallest
+ * window.
+ */
+void QcomIfeCameraData::updateControls(const ControlInfoMap &ipaControls,
+				       const Rectangle &zoomMin, const Rectangle &zoomMax)
+{
+	ControlInfoMap::Map controls;
+
+	for (const auto &c : ipaControls)
+		controls.emplace(c.first, c.second);
+
+	if (!zoomMax.isNull())
+		controls[&controls::ScalerCrop] = ControlInfo(zoomMin, zoomMax, zoomMax);
+
+	/* Test patterns come from the sensor, the pipeline handler sets them */
+	const std::vector<controls::draft::TestPatternModeEnum> &patterns =
+		sensor_->testPatternModes();
+	if (!patterns.empty()) {
+		std::vector<ControlValue> values;
+		for (auto pattern : patterns)
+			values.emplace_back(static_cast<int32_t>(pattern));
+		controls[&controls::draft::TestPatternMode] = ControlInfo(values);
+	}
+
+	controlInfo_ = ControlInfoMap(std::move(controls), controls::controls);
+}
+
+int QcomIfeCameraData::loadIPA()
+{
+	ipa_ = pipe()->createIPA<ipa::qcom_ife::IPAProxyQcomIfe>(1, 1);
+	if (!ipa_)
+		return -ENOENT;
+
+	ipa_->setSensorControls.connect(this, &QcomIfeCameraData::setSensorControls);
+
+	std::string tuningFile = ipa_->configurationFile(sensor_->model() + ".yaml",
+							 "uncalibrated.yaml");
+
+	ipa::qcom_ife::IPAConfigInfo ipaConfig{};
+	int ret = sensor_->sensorInfo(&ipaConfig.sensorInfo);
+	if (ret)
+		return ret;
+	ipaConfig.sensorControls = sensor_->controls();
+
+	ControlInfoMap ipaControls;
+	ret = ipa_->init({ tuningFile, sensor_->model() }, ipaConfig, &ipaControls);
+	if (ret) {
+		LOG(QcomIfe, Error) << "Failed to initialise the IPA";
+		return ret;
+	}
+
+	updateControls(ipaControls, Rectangle(), Rectangle());
+
+	return 0;
+}
