From: Akisaira <akisaira@outlook.com>
Subject: [PATCH] wifi: ath11k: cover a restart that fails and a suspend that
 fails after it

Fault injection and review of the previous patches found more ways for a
crash during a restart to end badly.

A suspend can fail after ath11k's callbacks have run, for instance on an
alarm that is due in under 2 s. With the rings freed by crash recovery,
ath11k_core_resume_default() then started the monitor reap timer on them,
which oopses, because a suspend that didn't power the device down reloads
nothing. Check for the rings first. ath11k_core_suspend() has to complete
restart_completed in that branch too, or the resume waits 20 s for it.

The radio that such a suspend stopped comes back in the resume on firmware
that is still dead, this time from state ON, and mac80211 closes the
interfaces like in the restart case. Treat it the same way. A start from user
space still fails, and user space is frozen for nearly all of that time.

If ath11k_core_reconfigure_on_crash() fails, nothing woke op_start or a
resume waiting for restart_completed. Do that, and unless the device is
going away, schedule a reset if no crash report brought one, because then
none would follow. CRASH_FLUSH doesn't say that: since the previous patch it
can still be set from the crash that this restart recovers.

A restart that fails in ath11k_core_pdev_create() unregistered the hw,
which a restart didn't register and which stays in use.

ath11k_wow_rings_ready() runs with the rtnl lock held. A recovery in progress
means that the rings aren't ready, so don't wait for core_lock there.

mac80211 holds the rtnl lock during op_start, so bring its wait down to
40 s, which still covers a device that takes the slow way to power down.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/net/wireless/ath/ath11k/core.c | 44 ++++++++++++++++++++++++--
 drivers/net/wireless/ath/ath11k/core.h |  3 +-
 drivers/net/wireless/ath/ath11k/mac.c  | 14 ++++++--
 drivers/net/wireless/ath/ath11k/wow.c  |  9 ++++--
 4 files changed, 62 insertions(+), 8 deletions(-)

diff --git a/drivers/net/wireless/ath/ath11k/core.c b/drivers/net/wireless/ath/ath11k/core.c
index 0ab40343b..2c46a1292 100644
--- a/drivers/net/wireless/ath/ath11k/core.c
+++ b/drivers/net/wireless/ath/ath11k/core.c
@@ -1258,13 +1258,14 @@ int ath11k_core_suspend(struct ath11k_base *ab)
 	/*
 	 * Crash recovery frees and rebuilds the rings that the suspend below
 	 * reaps, so wait for one in flight. If one failed, the rings are gone
-	 * and there is nothing to stop. Don't complete restart_completed then
-	 * either: ath11k_core_resume() would restart the reap timer on them.
+	 * and there is nothing to stop.
 	 */
 	mutex_lock(&ab->core_lock);
 
 	if (!ath11k_dp_rx_mon_status_allocated(ab)) {
 		ath11k_warn(ab, "rings freed by crash recovery, skipping datapath suspend\n");
+		/* See ath11k_core_suspend_default() */
+		complete(&ab->restart_completed);
 		ret = 0;
 	} else if (ab->actual_pm_policy == ATH11K_PM_WOW) {
 		ret = ath11k_core_suspend_wow(ab);
@@ -1324,6 +1325,7 @@ static int ath11k_core_resume_default(struct ath11k_base *ab)
 {
 	struct ath11k *ar;
 	long time_left;
+	bool allocated;
 	int ret;
 
 	time_left = wait_for_completion_timeout(&ab->restart_completed,
@@ -1333,6 +1335,16 @@ static int ath11k_core_resume_default(struct ath11k_base *ab)
 		return -ETIMEDOUT;
 	}
 
+	/*
+	 * A suspend that failed before the power down reloads nothing, so rings
+	 * freed by crash recovery are still gone. Don't reap them.
+	 */
+	mutex_lock(&ab->core_lock);
+	allocated = ath11k_dp_rx_mon_status_allocated(ab);
+	mutex_unlock(&ab->core_lock);
+	if (!allocated)
+		return 0;
+
 	/* So far only single_pdev_only devices can reach here,
 	 * so it is valid to handle the first, and the only, pdev.
 	 */
@@ -2099,7 +2111,9 @@ static int ath11k_core_pdev_create(struct ath11k_base *ab)
 err_thermal_unregister:
 	ath11k_thermal_unregister(ab);
 err_mac_unregister:
-	ath11k_mac_unregister(ab);
+	/* A restart didn't register it, and it stays in use. */
+	if (!test_bit(ATH11K_FLAG_REGISTERED, &ab->dev_flags))
+		ath11k_mac_unregister(ab);
 err_dp_pdev_free:
 	ath11k_dp_pdev_free(ab);
 err_pdev_debug:
@@ -2560,6 +2574,15 @@ static void ath11k_core_end_reset_without_restart(struct ath11k_base *ab)
 	complete(&ab->reset_complete);
 }
 
+/* A reset is queued, waiting out a back-off, deferred by a suspend or running. */
+static bool ath11k_core_reset_follows(struct ath11k_base *ab)
+{
+	return work_pending(&ab->reset_work) ||
+	       delayed_work_pending(&ab->reset_retry_work) ||
+	       test_bit(ATH11K_FLAG_CRASH_PENDING, &ab->dev_flags) ||
+	       atomic_read(&ab->reset_count) > 1;
+}
+
 static void ath11k_core_restart(struct work_struct *work)
 {
 	struct ath11k_base *ab = container_of(work, struct ath11k_base, restart_work);
@@ -2571,6 +2594,21 @@ static void ath11k_core_restart(struct work_struct *work)
 	ret = ath11k_core_reconfigure_on_crash(ab);
 	if (ret) {
 		ath11k_err(ab, "failed to reconfigure driver on crash recovery\n");
+		/*
+		 * A crash reported since the firmware came up brings its own
+		 * reset. Otherwise none follows, so start one, unless the device
+		 * is going away. CRASH_FLUSH can't tell: it may still be the flag
+		 * of the crash that this restart recovers. A report racing with
+		 * this can at worst queue a second reset, which takes over.
+		 * Either way op_start and a resume have nothing left to wait for.
+		 */
+		spin_lock_bh(&ab->base_lock);
+		if (!ath11k_core_reset_follows(ab) &&
+		    !test_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags))
+			ath11k_core_schedule_reset(ab);
+		spin_unlock_bh(&ab->base_lock);
+		complete_all(&ab->reconfigure_complete);
+		complete(&ab->restart_completed);
 		return;
 	}
 
diff --git a/drivers/net/wireless/ath/ath11k/core.h b/drivers/net/wireless/ath/ath11k/core.h
index 6355ea0be..3dca739ce 100644
--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -76,8 +76,9 @@ extern bool ath11k_ftm_mode;
 /*
  * A device that doesn't clear the MHI reset takes the 20 s of the MHI timeout,
  * more with the polling, to power down, before the firmware can come back.
+ * mac80211 holds the rtnl lock meanwhile.
  */
-#define ATH11K_RECONFIGURE_TIMEOUT_HZ (60 * HZ)
+#define ATH11K_RECONFIGURE_TIMEOUT_HZ (40 * HZ)
 #define ATH11K_RECOVER_START_TIMEOUT_HZ (20 * HZ)
 #define ATH11K_RECOVERY_WAKEUP_MS (60 * MSEC_PER_SEC)
 #define ATH11K_RECOVERY_SETTLE_MS (10 * MSEC_PER_SEC)
diff --git a/drivers/net/wireless/ath/ath11k/mac.c b/drivers/net/wireless/ath/ath11k/mac.c
index 8516bcacf..76591a45d 100644
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -6647,11 +6647,21 @@ static void ath11k_mac_wait_reconfigure(struct ath11k_base *ab)
  * when that happens. So if the firmware is down, let the restart run to its
  * end. The radio is ON then, with nothing behind it until the next reset or a
  * suspend that powers the device down.
+ *
+ * The same goes for the resume after a suspend that failed once it had stopped
+ * the radio: nothing reloaded the firmware then. A start from user space, which
+ * is frozen for as long as the flag is set, still fails.
  */
 static bool ath11k_mac_crashed_in_restart(struct ath11k *ar)
 {
-	return ar->state == ATH11K_STATE_RESTARTED &&
-	       test_bit(ATH11K_FLAG_CRASH_FLUSH, &ar->ab->dev_flags);
+	struct ath11k_base *ab = ar->ab;
+
+	if (!test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags))
+		return false;
+
+	return ar->state == ATH11K_STATE_RESTARTED ||
+	       (ar->state == ATH11K_STATE_ON &&
+		test_bit(ATH11K_FLAG_SYSTEM_SUSPEND, &ab->dev_flags));
 }
 
 static int ath11k_mac_op_start(struct ieee80211_hw *hw)
diff --git a/drivers/net/wireless/ath/ath11k/wow.c b/drivers/net/wireless/ath/ath11k/wow.c
index bfd76c302..cf4b2c129 100644
--- a/drivers/net/wireless/ath/ath11k/wow.c
+++ b/drivers/net/wireless/ath/ath11k/wow.c
@@ -726,11 +726,17 @@ static void ath11k_wow_undo_setup(struct ath11k *ar)
 	ath11k_dp_rx_pktlog_start(ar->ab);
 }
 
+/*
+ * Crash recovery rebuilds the rings under core_lock. Don't wait for that with
+ * the rtnl lock held: a recovery in progress means they aren't ready.
+ */
 static bool ath11k_wow_rings_ready(struct ath11k_base *ab)
 {
 	bool ready;
 
-	mutex_lock(&ab->core_lock);
+	if (!mutex_trylock(&ab->core_lock))
+		return false;
+
 	ready = !test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags) &&
 		ath11k_dp_rx_mon_status_allocated(ab);
 	mutex_unlock(&ab->core_lock);
@@ -752,7 +758,6 @@ int ath11k_wow_op_suspend(struct ieee80211_hw *hw,
 		return ret;
 	}
 
-	/* core_lock nests outside conf_mutex in crash recovery */
 	rings_ready = ath11k_wow_rings_ready(ar->ab);
 
 	mutex_lock(&ar->conf_mutex);
