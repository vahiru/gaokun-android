From: Vahiru <nekovahiru@gmail.com>
Subject: [PATCH] clk: qcom: camcc-sc8280xp: Use the hardware GDSC wait values

The sc8280xp camcc GDSCs specify no en_rest/en_few/clk_dis wait values,
so gdsc_init() overwrites the hardware reset values with the MSM8974
defaults (2/8/2). Reading GDSCR before gdsc_init() touches it on a
Huawei MateBook E Go shows 0x0022f001 for all eight camera GDSCs, i.e.
en_rest 2, en_few 2, clk_dis 15 -- the same values camcc-sm8150,
camcc-sc8180x, camcc-sc7280 and camcc-x1e80100 already program.

Restore them explicitly.

Signed-off-by: Vahiru <nekovahiru@gmail.com>
---
diff --git a/drivers/clk/qcom/camcc-sc8280xp.c b/drivers/clk/qcom/camcc-sc8280xp.c
index 660d865..e4ec7e3 100644
--- a/drivers/clk/qcom/camcc-sc8280xp.c
+++ b/drivers/clk/qcom/camcc-sc8280xp.c
@@ -2711,6 +2711,9 @@ static struct gdsc titan_top_gdsc;
 
 static struct gdsc bps_gdsc = {
 	.gdscr = 0x7004,
+	.en_rest_wait_val = 0x2,
+	.en_few_wait_val = 0x2,
+	.clk_dis_wait_val = 0xf,
 	.pd = {
 		.name = "bps_gdsc",
 	},
@@ -2721,6 +2724,9 @@ static struct gdsc bps_gdsc = {
 
 static struct gdsc ife_0_gdsc = {
 	.gdscr = 0xa004,
+	.en_rest_wait_val = 0x2,
+	.en_few_wait_val = 0x2,
+	.clk_dis_wait_val = 0xf,
 	.pd = {
 		.name = "ife_0_gdsc",
 	},
@@ -2731,6 +2737,9 @@ static struct gdsc ife_0_gdsc = {
 
 static struct gdsc ife_1_gdsc = {
 	.gdscr = 0xb004,
+	.en_rest_wait_val = 0x2,
+	.en_few_wait_val = 0x2,
+	.clk_dis_wait_val = 0xf,
 	.pd = {
 		.name = "ife_1_gdsc",
 	},
@@ -2741,6 +2750,9 @@ static struct gdsc ife_1_gdsc = {
 
 static struct gdsc ife_2_gdsc = {
